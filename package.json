{
  "name": "slovakgo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "ios:devices": "cap run ios --list",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "qa:lessons": "tsx scripts/qa-lessons.ts",
    "backup:lessons": "tsx scripts/backup-lessons.ts",
    "migrate": "tsx scripts/migrate.ts",
    "sitemap": "node generate-sitemap.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@libsql/client": "^0.14.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "firebase": "^12.14.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "stripe": "^17.7.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@vercel/node": {
      "undici": "^6.28.1",
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
