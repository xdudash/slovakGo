---
import Base from '../layouts/Base.astro';
import '../styles/survival-pack.css';
---

<Base
  title="Slovak Survival Pack — SlovakGO"
  description="Бесплатный набор практических словацких фраз для первых недель в Словакии."
  bodyClass="survival-pack-page"
  lang="ru"
>
  <main class="pack-page">
    <header class="pack-header">
      <a href="/" aria-label="SlovakGO"><img src="/slovakgo-logo.svg" width="148" height="33" alt="SlovakGO" /></a>
      <nav aria-label="Language">
        <button type="button" data-lang="sk">SK</button>
        <button type="button" data-lang="uk">UA</button>
        <button type="button" data-lang="ru">RU</button>
        <button type="button" data-lang="en">EN</button>
      </nav>
    </header>

    <section class="pack-hero">
      <p class="pack-kicker" data-i18n="kicker">Бесплатный набор</p>
      <h1>Slovak Survival Pack</h1>
      <p data-i18n="lead">16 фраз, которые пригодятся в первые недели в Словакии. Сохрани страницу и открой её перед нужным разговором.</p>
      <a href="https://app.slovakgo.sk/demo" rel="noopener" data-i18n="practice">Потренировать эти фразы в SlovakGO →</a>
    </section>

    <section class="pack-list">
      <h2 data-i18n="basics">База</h2>
      <article><strong>Dobrý deň.</strong><span data-t="p1">Здравствуйте.</span></article>
      <article><strong>Prosím, hovorte pomalšie.</strong><span data-t="p2">Пожалуйста, говорите медленнее.</span></article>
      <article><strong>Nerozumiem.</strong><span data-t="p3">Я не понимаю.</span></article>
      <article><strong>Môžete mi pomôcť?</strong><span data-t="p4">Можете мне помочь?</span></article>

      <h2 data-i18n="doctor">У врача</h2>
      <article><strong>Chcel by som sa objednať k lekárovi.</strong><span data-t="p5">Я хотел бы записаться к врачу.</span></article>
      <article><strong>Bolí ma hrdlo.</strong><span data-t="p6">У меня болит горло.</span></article>
      <article><strong>Mám teplotu.</strong><span data-t="p7">У меня температура.</span></article>
      <article><strong>Kde je najbližšia lekáreň?</strong><span data-t="p8">Где ближайшая аптека?</span></article>

      <h2 data-i18n="work">Работа</h2>
      <article><strong>Kedy môžem začať?</strong><span data-t="p9">Когда я могу начать?</span></article>
      <article><strong>Aký je pracovný čas?</strong><span data-t="p10">Какой рабочий график?</span></article>
      <article><strong>Môžete mi to poslať e-mailom?</strong><span data-t="p11">Можете отправить это мне по электронной почте?</span></article>
      <article><strong>Potrebujem si to ešte premyslieť.</strong><span data-t="p12">Мне нужно ещё это обдумать.</span></article>

      <h2 data-i18n="housing">Жильё и документы</h2>
      <article><strong>Koľko to stojí mesačne?</strong><span data-t="p13">Сколько это стоит в месяц?</span></article>
      <article><strong>Sú energie zahrnuté v cene?</strong><span data-t="p14">Коммунальные услуги включены в цену?</span></article>
      <article><strong>Kde to mám podpísať?</strong><span data-t="p15">Где мне это подписать?</span></article>
      <article><strong>Aké doklady potrebujem?</strong><span data-t="p16">Какие документы мне нужны?</span></article>
    </section>

    <section class="pack-bottom">
      <p data-i18n="bottom">Знание фразы — это начало. В SlovakGO ты услышишь её, ответишь и потренируешь в контексте.</p>
      <a href="https://app.slovakgo.sk/demo" rel="noopener" data-i18n="cta">Попробовать реальный урок →</a>
    </section>
  </main>

  <script is:inline>
    const ui = {
      ru:{kicker:"Бесплатный набор",lead:"16 фраз, которые пригодятся в первые недели в Словакии. Сохрани страницу и открой её перед нужным разговором.",practice:"Потренировать эти фразы в SlovakGO →",basics:"База",doctor:"У врача",work:"Работа",housing:"Жильё и документы",bottom:"Знание фразы — это начало. В SlovakGO ты услышишь её, ответишь и потренируешь в контексте.",cta:"Попробовать реальный урок →"},
      uk:{kicker:"Безкоштовний набір",lead:"16 фраз, які стануть у пригоді в перші тижні у Словаччині. Збережи сторінку й відкрий її перед потрібною розмовою.",practice:"Потренувати ці фрази в SlovakGO →",basics:"База",doctor:"У лікаря",work:"Робота",housing:"Житло й документи",bottom:"Знати фразу — це лише початок. У SlovakGO ти почуєш її, відповіси й потренуєш у контексті.",cta:"Спробувати реальний урок →"},
      sk:{kicker:"Bezplatný balíček",lead:"16 fráz, ktoré sa vám zídu počas prvých týždňov na Slovensku. Uložte si stránku a otvorte ju pred dôležitým rozhovorom.",practice:"Precvičiť si frázy v SlovakGO →",basics:"Základ",doctor:"U lekára",work:"Práca",housing:"Bývanie a dokumenty",bottom:"Poznať frázu je len začiatok. V SlovakGO ju budete počuť, odpovedať a precvičovať v kontexte.",cta:"Vyskúšať reálnu lekciu →"},
      en:{kicker:"Free starter pack",lead:"16 phrases you can use during your first weeks in Slovakia. Save this page and open it before the conversation you need.",practice:"Practice these phrases in SlovakGO →",basics:"Basics",doctor:"At the doctor",work:"Work",housing:"Housing & documents",bottom:"Knowing the phrase is only the start. In SlovakGO you hear it, answer and practice it in context.",cta:"Try a real lesson →"}
    };
    const tr={
      ru:["Здравствуйте.","Пожалуйста, говорите медленнее.","Я не понимаю.","Можете мне помочь?","Я хотел бы записаться к врачу.","У меня болит горло.","У меня температура.","Где ближайшая аптека?","Когда я могу начать?","Какой рабочий график?","Можете отправить это мне по электронной почте?","Мне нужно ещё это обдумать.","Сколько это стоит в месяц?","Коммунальные услуги включены в цену?","Где мне это подписать?","Какие документы мне нужны?"],
      uk:["Добрий день.","Будь ласка, говоріть повільніше.","Я не розумію.","Можете мені допомогти?","Я хотів би записатися до лікаря.","У мене болить горло.","У мене температура.","Де найближча аптека?","Коли я можу почати?","Який робочий графік?","Можете надіслати це мені електронною поштою?","Мені треба ще це обдумати.","Скільки це коштує на місяць?","Комунальні послуги включені у вартість?","Де мені це підписати?","Які документи мені потрібні?"],
      sk:["Dobrý deň.","Prosím, hovorte pomalšie.","Nerozumiem.","Môžete mi pomôcť?","Chcel by som sa objednať k lekárovi.","Bolí ma hrdlo.","Mám teplotu.","Kde je najbližšia lekáreň?","Kedy môžem začať?","Aký je pracovný čas?","Môžete mi to poslať e-mailom?","Potrebujem si to ešte premyslieť.","Koľko to stojí mesačne?","Sú energie zahrnuté v cene?","Kde to mám podpísať?","Aké doklady potrebujem?"],
      en:["Good day.","Please speak more slowly.","I don’t understand.","Can you help me?","I would like to make a doctor’s appointment.","My throat hurts.","I have a fever.","Where is the nearest pharmacy?","When can I start?","What are the working hours?","Can you send it to me by email?","I need to think about it some more.","How much is it per month?","Are utilities included in the price?","Where should I sign this?","Which documents do I need?"]
    };
    const supported=["sk","uk","ru","en"];
    const qs=new URLSearchParams(location.search).get("lang");
    const saved=localStorage.getItem("slovakgo-site-lang");
    const browser=(navigator.languages?.[0]||navigator.language||"").toLowerCase();
    const device=browser.startsWith("sk")?"sk":browser.startsWith("uk")?"uk":browser.startsWith("ru")?"ru":browser.startsWith("en")?"en":"ru";
    const initial=supported.includes(qs)?qs:supported.includes(saved)?saved:device;
    function setLang(lang){
      if(!supported.includes(lang))lang="ru";
      document.documentElement.lang=lang;
      localStorage.setItem("slovakgo-site-lang",lang);
      document.querySelectorAll("[data-i18n]").forEach(el=>{const k=el.getAttribute("data-i18n");if(k&&ui[lang][k])el.textContent=ui[lang][k]});
      document.querySelectorAll("[data-t]").forEach((el,i)=>{el.textContent=tr[lang][i]});
      document.querySelectorAll("[data-lang]").forEach(btn=>btn.classList.toggle("is-active",btn.getAttribute("data-lang")===lang));
      const url=new URL(location.href);url.searchParams.set("lang",lang);history.replaceState({},"",url);
    }
    document.querySelectorAll("[data-lang]").forEach(btn=>btn.addEventListener("click",()=>setLang(btn.getAttribute("data-lang")||"ru")));
    setLang(initial);
  </script>
</Base>
