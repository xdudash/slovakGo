---
import Base from '../layouts/Base.astro';
import CheckIcon from '../components/CheckIcon.astro';
import '../styles/home-v6.css';

const schema = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "SlovakGO",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": ["Android", "iOS", "Web"],
  "url": "https://app.slovakgo.sk",
  "offers": [
    { "@type": "Offer", "price": "3.00", "priceCurrency": "EUR" },
    { "@type": "Offer", "price": "20.00", "priceCurrency": "EUR" }
  ]
};
---

<Base
  title="SlovakGO — словацкий, который пригодится в жизни"
  description="Практический словацкий для работы, врача, жилья, документов и повседневных разговоров в Словакии."
  schema={schema}
  bodyClass="home-v6"
  lang="ru"
>
  <main class="go">
    <header class="go-header">
      <div class="go-shell go-header-inner">
        <a href="/" class="go-logo" aria-label="SlovakGO">
          <img src="/slovakgo-logo.svg" alt="SlovakGO" width="154" height="34" />
        </a>

        <div class="go-header-right">
          <a class="go-signin" href="https://app.slovakgo.sk/login" rel="noopener" data-i18n="signin">Войти</a>
          <details class="go-language">
            <summary><span id="go-current-lang">RU</span><b>⌄</b></summary>
            <div class="go-language-menu">
              <button type="button" data-lang="sk">SK</button>
              <button type="button" data-lang="uk">UA</button>
              <button type="button" data-lang="ru">RU</button>
              <button type="button" data-lang="en">EN</button>
            </div>
          </details>
        </div>
      </div>
    </header>

    <section class="go-hero">
      <div class="go-shell">
        <div class="go-hero-copy">
          <p class="go-overline" data-i18n="heroOverline">Словацкий для жизни в Словакии</p>
          <h1 data-i18n="heroTitle">Словацкий, который ты действительно будешь использовать.</h1>
          <p class="go-hero-lead" data-i18n="heroLead">Практикуй разговоры до того, как они понадобятся — на работе, у врача, с арендодателем или в учреждении.</p>

          <div class="go-hero-actions">
            <a class="go-primary" href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">
              <span data-i18n="heroCta">Начать 3 дня бесплатно</span><b>→</b>
            </a>
            <a class="go-text-link" href="/survival-pack">
              <span data-i18n="leadMagnetCta">Забрать 16 полезных фраз</span><b>↗</b>
            </a>
          </div>

          <p class="go-meta">
            <span data-i18n="metaTrial">3 дня полного доступа</span>
            <i>·</i>
            <span data-i18n="metaPrice">затем €3/месяц</span>
            <i>·</i>
            <span data-i18n="metaCancel">отмена в любой момент</span>
          </p>
        </div>
      </div>

      <div class="go-phrase-rail" aria-label="Useful Slovak phrases">
        <div class="go-phrase-track">
          <span>Prosím, hovorte pomalšie.</span><i>•</i>
          <span>Kedy môžem začať?</span><i>•</i>
          <span>Čo vás bolí?</span><i>•</i>
          <span>Kde to mám podpísať?</span><i>•</i>
          <span>Koľko to stojí mesačne?</span><i>•</i>
          <span>Môžete mi pomôcť?</span>
        </div>
      </div>
    </section>

    <section class="go-section go-usecases" id="topics">
      <div class="go-shell">
        <div class="go-section-head">
          <p class="go-overline" data-i18n="useOverline">Начни с того, что нужно сейчас</p>
          <h2 data-i18n="useTitle">Какой разговор ждёт тебя следующим?</h2>
          <p data-i18n="useLead">Не проходи абстрактные темы. Выбери ситуацию и выучи именно те фразы, которые пригодятся.</p>
        </div>

        <div class="go-usecase-list">
          <a href="https://app.slovakgo.sk/demo?topic=doctor" rel="noopener">
            <span class="go-index">01</span>
            <div><strong data-i18n="doctor">Врач</strong><small>Čo vás bolí?</small></div>
            <span data-i18n="doctorSub">Симптомы, запись, аптека</span>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=work" rel="noopener">
            <span class="go-index">02</span>
            <div><strong data-i18n="work">Работа</strong><small>Kedy môžem začať?</small></div>
            <span data-i18n="workSub">Коллеги, условия, собеседование</span>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=housing" rel="noopener">
            <span class="go-index">03</span>
            <div><strong data-i18n="housing">Жильё</strong><small>Koľko to stojí mesačne?</small></div>
            <span data-i18n="housingSub">Аренда, договор, хозяин</span>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=documents" rel="noopener">
            <span class="go-index">04</span>
            <div><strong data-i18n="documents">Документы</strong><small>Kde to mám podpísať?</small></div>
            <span data-i18n="documentsSub">Учреждения, формы, разрешения</span>
            <b>→</b>
          </a>
        </div>
      </div>
    </section>

    <section class="go-product">
      <div class="go-shell go-product-grid">
        <div class="go-product-copy">
          <p class="go-overline" data-i18n="productOverline">Как это работает</p>
          <h2 data-i18n="productTitle">Сначала нужная фраза. Потом практика. Потом реальная жизнь.</h2>
          <p data-i18n="productLead">Короткий урок занимает 10–15 минут. Ты слушаешь, отвечаешь, повторяешь — и возвращаешься к словам тогда, когда их пора повторить.</p>

          <ol class="go-process">
            <li><span>01</span><strong data-i18n="step1">Выбери ситуацию</strong></li>
            <li><span>02</span><strong data-i18n="step2">Пройди короткий урок</strong></li>
            <li><span>03</span><strong data-i18n="step3">Используй в разговоре</strong></li>
          </ol>
        </div>

        <div class="go-product-shot">
          <img src="/app-exercise.png" alt="Real SlovakGO exercise screen" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="go-pack" id="survival-pack">
      <div class="go-shell go-pack-grid">
        <div>
          <p class="go-overline" data-i18n="packOverline">Бесплатный набор</p>
          <h2 data-i18n="packTitle">16 фраз, которые стоит сохранить в телефон.</h2>
          <p data-i18n="packLead">Для первых недель в Словакии: врач, работа, жильё, документы и обычные бытовые ситуации.</p>
          <a class="go-pack-link" href="/survival-pack">
            <span data-i18n="packCta">Открыть Slovak Survival Pack</span><b>→</b>
          </a>
        </div>

        <div class="go-pack-lines">
          <p><strong>Prosím, hovorte pomalšie.</strong><span data-i18n="pack1">Пожалуйста, говорите медленнее.</span></p>
          <p><strong>Nerozumiem.</strong><span data-i18n="pack2">Я не понимаю.</span></p>
          <p><strong>Môžete mi pomôcť?</strong><span data-i18n="pack3">Можете мне помочь?</span></p>
        </div>
      </div>
    </section>

    <section class="go-section go-sprint">
      <div class="go-shell">
        <div class="go-section-head go-sprint-head">
          <p class="go-overline">3-Day Slovak Sprint</p>
          <h2 data-i18n="sprintTitle">Три дня. Три полезные темы. Один понятный старт.</h2>
          <p data-i18n="sprintLead">Sprint начинается только после активации — никакого искусственного таймера. За три дня ты проходишь базовые ситуации и понимаешь, подходит ли тебе формат.</p>
        </div>

        <div class="go-days">
          <div><span>Day 1</span><strong data-i18n="day1">Работа и знакомства</strong></div>
          <div><span>Day 2</span><strong data-i18n="day2">Врач и документы</strong></div>
          <div><span>Day 3</span><strong data-i18n="day3">Жильё и повседневная жизнь</strong></div>
        </div>
      </div>
    </section>

    <section class="go-section go-pricing" id="pricing">
      <div class="go-shell go-pricing-grid">
        <div class="go-section-head">
          <p class="go-overline" data-i18n="priceOverline">Простая подписка</p>
          <h2 data-i18n="priceTitle">€3 в месяц.</h2>
          <p data-i18n="priceLead">Полный доступ ко всем урокам, аудио, практике и повторениям. Сначала — 3 дня полного доступа.</p>
        </div>

        <div class="go-price-box">
          <div class="go-price-top">
            <div>
              <span data-i18n="monthly">Месячная</span>
              <strong>€3 <small data-i18n="perMonth">/ месяц</small></strong>
            </div>
            <em data-i18n="mainPlan">Основной план</em>
          </div>

          <ul>
            <li><CheckIcon /><span data-i18n="allLessons">Все уроки</span></li>
            <li><CheckIcon /><span data-i18n="audio">Аудио и разговорная практика</span></li>
            <li><CheckIcon /><span data-i18n="review">Умные повторения</span></li>
            <li><CheckIcon /><span data-i18n="cancelAnytime">Отмена в любой момент</span></li>
          </ul>

          <a class="go-primary" href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">
            <span data-i18n="priceCta">Начать 3 дня бесплатно</span><b>→</b>
          </a>

          <p class="go-price-note" data-i18n="priceNote">После пробного периода — €3/месяц. Для активации нужна карта.</p>

          <div class="go-yearly">
            <span><b data-i18n="yearly">Годовая</b> · €20 <small data-i18n="perYear">/ год</small></span>
            <a href="https://app.slovakgo.sk/demo?plan=yearly" rel="noopener" data-i18n="yearCta">Сэкономить €16 →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="go-section go-faq" id="faq">
      <div class="go-shell go-faq-grid">
        <div class="go-section-head">
          <p class="go-overline">FAQ</p>
          <h2 data-i18n="faqTitle">Перед стартом.</h2>
        </div>

        <div class="go-faq-list">
          <details>
            <summary data-i18n="faq1q">Что входит в 3 бесплатных дня?</summary>
            <p data-i18n="faq1a">Полный доступ к урокам и функциям SlovakGO. После пробного периода действует выбранная подписка.</p>
          </details>
          <details>
            <summary data-i18n="faq2q">Нужна ли банковская карта?</summary>
            <p data-i18n="faq2a">Да, для активации пробного периода. Подписку можно отменить в любой момент.</p>
          </details>
          <details>
            <summary data-i18n="faq3q">Подойдёт ли новичку?</summary>
            <p data-i18n="faq3a">Да. Можно начать с базовых фраз и простых жизненных ситуаций.</p>
          </details>
          <details>
            <summary data-i18n="faq4q">Как выбирается язык сайта?</summary>
            <p data-i18n="faq4a">По языку устройства, если он поддерживается. Иначе открывается русский. Язык всегда можно переключить вручную.</p>
          </details>
        </div>
      </div>
    </section>

    <footer class="go-footer">
      <div class="go-shell">
        <div class="go-footer-top">
          <div>
            <p class="go-overline" data-i18n="footerOverline">Следующий разговор не будет ждать</p>
            <h2 data-i18n="footerTitle">Подготовься к нему сейчас.</h2>
          </div>
          <a class="go-primary" href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">
            <span data-i18n="heroCta">Начать 3 дня бесплатно</span><b>→</b>
          </a>
        </div>

        <div class="go-footer-bottom">
          <img src="/slovakgo-logo.svg" alt="SlovakGO" width="145" height="32" />
          <span>© 2026 SlovakGO</span>
          <a href="mailto:support@slovakgo.sk">support@slovakgo.sk</a>
        </div>
      </div>
    </footer>

    <div class="go-sticky">
      <a href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">
        <span><b data-i18n="stickyTitle">Начать бесплатно</b><small data-i18n="stickySub">3 дня · затем €3/месяц</small></span>
        <strong>→</strong>
      </a>
    </div>
  </main>

  <script is:inline>
