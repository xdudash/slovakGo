---
import Base from '../layouts/Base.astro';
import CheckIcon from '../components/CheckIcon.astro';
import '../styles/home-v4.css';

const schema = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "SlovakGO",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": ["Android", "iOS", "Web"],
  "url": "https://app.slovakgo.sk",
  "offers": [
    { "@type": "Offer", "price": "3.00", "priceCurrency": "EUR" },
    { "@type": "Offer", "price": "20.00", "priceCurrency": "EUR" }
  ]
};
---

<Base
  title="SlovakGO — практический словацкий для жизни в Словакии"
  description="Практический словацкий для реальных разговоров: работа, врач, жильё, документы и повседневная жизнь."
  schema={schema}
  bodyClass="home-mobile-v4"
  lang="ru"
>
  <main class="v4">
    <header class="v4-header">
      <div class="v4-wrap v4-header-inner">
        <a class="v4-logo" href="/" aria-label="SlovakGO">
          <img src="/slovakgo-logo.svg" alt="SlovakGO" width="150" height="33" />
        </a>
        <nav class="v4-langs" aria-label="Language">
          <button type="button" data-lang="sk">SK</button>
          <button type="button" data-lang="uk">UA</button>
          <button type="button" data-lang="ru">RU</button>
          <button type="button" data-lang="en">EN</button>
        </nav>
      </div>
    </header>

    <section class="v4-hero">
      <div class="v4-wrap v4-hero-grid">
        <div class="v4-hero-copy">
          <p class="v4-kicker" data-i18n="kicker">Реальный словацкий. Реальная жизнь.</p>
          <h1>
            <span data-i18n="hero1">Тебе не нужен идеальный словацкий.</span>
            <em data-i18n="hero2">Тебе нужно знать, что сказать дальше.</em>
          </h1>
          <p class="v4-lead" data-i18n="heroLead">Подготовься к разговорам, которые действительно ждут тебя в Словакии — на работе, у врача, с арендодателем или в учреждении.</p>
          <div class="v4-cta-stack">
            <a class="v4-primary" href="https://app.slovakgo.sk/demo" rel="noopener">
              <span data-i18n="tryLesson">Попробовать реальный урок</span><b>→</b>
            </a>
            <a class="v4-secondary" href="#survival-pack" data-i18n="getPack">Получить бесплатный Survival Pack</a>
          </div>
          <p class="v4-trust"><span data-i18n="trial">3 дня полного доступа</span><i>•</i><span data-i18n="cancel">Отмена в любой момент</span></p>
        </div>

        <div class="v4-product-proof" aria-label="SlovakGO product preview">
          <div class="v4-real-shot">
            <img src="/slovakgo-preview.png" alt="Real SlovakGO lesson screen" width="270" height="560" loading="eager" fetchpriority="high" />
          </div>
          <div class="v4-proof-copy">
            <span>Slovak</span>
            <strong>Kde je autobusová stanica?</strong>
            <small data-i18n="phraseBus">Где находится автовокзал?</small>
          </div>
        </div>
      </div>
    </section>

    <section class="v4-section v4-scenarios" id="topics">
      <div class="v4-wrap">
        <p class="v4-kicker" data-i18n="scenarioKicker">Выбери ближайшую ситуацию</p>
        <h2 data-i18n="scenarioTitle">Для чего тебе нужен словацкий на этой неделе?</h2>
        <div class="v4-scenario-list">
          <a href="https://app.slovakgo.sk/demo?topic=doctor" rel="noopener">
            <span class="v4-scenario-name" data-i18n="doctor">Врач</span>
            <strong>Čo vás bolí?</strong>
            <small data-i18n="doctorPhrase">Что у вас болит?</small>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=work" rel="noopener">
            <span class="v4-scenario-name" data-i18n="work">Работа</span>
            <strong>Kedy môžem začať?</strong>
            <small data-i18n="workPhrase">Когда я могу начать?</small>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=housing" rel="noopener">
            <span class="v4-scenario-name" data-i18n="housing">Жильё</span>
            <strong>Koľko to stojí mesačne?</strong>
            <small data-i18n="housingPhrase">Сколько это стоит в месяц?</small>
            <b>→</b>
          </a>
          <a href="https://app.slovakgo.sk/demo?topic=documents" rel="noopener">
            <span class="v4-scenario-name" data-i18n="documents">Документы</span>
            <strong>Kde to mám podpísať?</strong>
            <small data-i18n="documentsPhrase">Где мне это подписать?</small>
            <b>→</b>
          </a>
        </div>
      </div>
    </section>

    <section class="v4-pack" id="survival-pack">
      <div class="v4-wrap v4-pack-inner">
        <div>
          <p class="v4-kicker" data-i18n="packKicker">Бесплатный лидмагнит</p>
          <h2 data-i18n="packTitle">Slovak Survival Pack</h2>
          <p data-i18n="packLead">Быстрый набор фраз для первых недель в Словакии: врач, транспорт, работа, жильё и документы.</p>
        </div>
        <div class="v4-pack-preview" aria-label="Slovak Survival Pack preview">
          <p><strong>Dobrý deň.</strong><span data-i18n="packHello">Здравствуйте.</span></p>
          <p><strong>Prosím, hovorte pomalšie.</strong><span data-i18n="packSlow">Пожалуйста, говорите медленнее.</span></p>
          <p><strong>Nerozumiem.</strong><span data-i18n="packUnderstand">Я не понимаю.</span></p>
          <p><strong>Môžete mi pomôcť?</strong><span data-i18n="packHelp">Можете мне помочь?</span></p>
        </div>
        <a class="v4-pack-cta" href="/survival-pack" rel="noopener">
          <span data-i18n="openPack">Открыть бесплатный набор</span><b>→</b>
        </a>
        <small class="v4-pack-note" data-i18n="packNote">Без оплаты. Сразу можно попробовать фразы в уроке.</small>
      </div>
    </section>

    <section class="v4-section v4-how" id="how">
      <div class="v4-wrap">
        <p class="v4-kicker" data-i18n="howKicker">Как это работает</p>
        <h2 data-i18n="howTitle">Выучи сегодня. Используй завтра.</h2>
        <ol class="v4-steps">
          <li><b>1</b><div><h3 data-i18n="step1">Выбери реальную ситуацию</h3><p data-i18n="step1Text">Начни с того разговора, который тебе нужен прямо сейчас.</p></div></li>
          <li><b>2</b><div><h3 data-i18n="step2">Пройди короткий урок</h3><p data-i18n="step2Text">Слушай, отвечай и повторяй полезные фразы.</p></div></li>
          <li><b>3</b><div><h3 data-i18n="step3">Используй в жизни</h3><p data-i18n="step3Text">Приди в реальную ситуацию уже подготовленным.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="v4-sprint">
      <div class="v4-wrap">
        <p class="v4-kicker" data-i18n="sprintKicker">Начни сейчас</p>
        <h2 data-i18n="sprintTitle">3-Day Slovak Sprint</h2>
        <p class="v4-sprint-lead" data-i18n="sprintLead">Три дня полного доступа, чтобы пройти три самые полезные темы и почувствовать разницу в реальных разговорах.</p>
        <div class="v4-days">
          <div><span>Day 1</span><strong data-i18n="day1">Работа и знакомства</strong></div>
          <div><span>Day 2</span><strong data-i18n="day2">Врач и документы</strong></div>
          <div><span>Day 3</span><strong data-i18n="day3">Жильё и повседневная жизнь</strong></div>
        </div>
        <p class="v4-sprint-note" data-i18n="sprintNote">Твой Sprint начинается только после активации.</p>
        <a class="v4-primary" href="https://app.slovakgo.sk/demo" rel="noopener"><span data-i18n="startSprint">Начать 3-дневный Sprint</span><b>→</b></a>
      </div>
    </section>

    <section class="v4-section v4-pricing" id="pricing">
      <div class="v4-wrap">
        <p class="v4-kicker" data-i18n="pricingKicker">Простая цена</p>
        <h2 data-i18n="pricingTitle">Начни с месячной подписки.</h2>
        <p class="v4-pricing-lead" data-i18n="pricingLead">Полный доступ без долгих обязательств. Годовой план остаётся вариантом для тех, кто хочет сэкономить.</p>

        <div class="v4-price-main">
          <div class="v4-price-top">
            <div>
              <span class="v4-plan" data-i18n="monthly">Месячная</span>
              <div class="v4-price">€3 <small data-i18n="perMonth">/ месяц</small></div>
            </div>
            <span class="v4-main-badge" data-i18n="recommended">Начни здесь</span>
          </div>
          <ul>
            <li><CheckIcon /><span data-i18n="allLessons">Все уроки</span></li>
            <li><CheckIcon /><span data-i18n="audioPractice">Аудио и разговорная практика</span></li>
            <li><CheckIcon /><span data-i18n="review">Умные повторения</span></li>
            <li><CheckIcon /><span data-i18n="cancelAnytime">Отмена в любой момент</span></li>
          </ul>
          <a class="v4-primary" href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener"><span data-i18n="startMonthly">Начать за €3/месяц</span><b>→</b></a>
          <small data-i18n="trialIncluded">Сначала 3 дня полного доступа.</small>
        </div>

        <div class="v4-price-alt">
          <div>
            <span class="v4-plan" data-i18n="yearly">Годовая</span>
            <strong>€20 <small data-i18n="perYear">/ год</small></strong>
            <span data-i18n="saveYear">Экономия €16 в год</span>
          </div>
          <a href="https://app.slovakgo.sk/demo?plan=yearly" rel="noopener" data-i18n="chooseYearly">Выбрать годовую</a>
        </div>
      </div>
    </section>

    <section class="v4-section v4-faq" id="faq">
      <div class="v4-wrap">
        <p class="v4-kicker">FAQ</p>
        <h2 data-i18n="faqTitle">Частые вопросы.</h2>
        <div class="v4-faq-list">
          <details><summary data-i18n="faq1q">Что входит в 3 бесплатных дня?</summary><p data-i18n="faq1a">Полный доступ к урокам и функциям SlovakGO. После пробного периода действует выбранная подписка.</p></details>
          <details><summary data-i18n="faq2q">Нужна ли банковская карта?</summary><p data-i18n="faq2a">Для активации пробного периода карта нужна. Подписку можно отменить в любой момент.</p></details>
          <details><summary data-i18n="faq3q">Подойдёт ли это с нуля?</summary><p data-i18n="faq3a">Да. Можно начать с базовых фраз и реальных бытовых ситуаций.</p></details>
          <details><summary data-i18n="faq4q">Язык сайта выбирается автоматически?</summary><p data-i18n="faq4a">Да. SlovakGO использует язык устройства, если он поддерживается. Иначе сайт открывается на русском. Язык всегда можно переключить вручную.</p></details>
        </div>
      </div>
    </section>

    <section class="v4-final">
      <div class="v4-wrap">
        <p class="v4-kicker" data-i18n="finalKicker">Следующий разговор не будет ждать</p>
        <h2 data-i18n="finalTitle">Подготовься к нему сейчас.</h2>
        <p data-i18n="finalLead">Не учи язык “когда-нибудь”. Выбери ситуацию, которая нужна тебе в ближайшие дни.</p>
        <a class="v4-primary" href="https://app.slovakgo.sk/demo" rel="noopener"><span data-i18n="tryLesson">Попробовать реальный урок</span><b>→</b></a>
      </div>
    </section>

    <div class="v4-sticky">
      <a href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">
        <span><b data-i18n="stickyCta">Начать бесплатно</b><small>€3 / <span data-i18n="monthWord">месяц</span></small></span>
        <strong>→</strong>
      </a>
    </div>
  </main>

  <script is:inline>
    const I18N = {
      ru: {
        kicker:"Реальный словацкий. Реальная жизнь.",hero1:"Тебе не нужен идеальный словацкий.",hero2:"Тебе нужно знать, что сказать дальше.",heroLead:"Подготовься к разговорам, которые действительно ждут тебя в Словакии — на работе, у врача, с арендодателем или в учреждении.",tryLesson:"Попробовать реальный урок",getPack:"Получить бесплатный Survival Pack",trial:"3 дня полного доступа",cancel:"Отмена в любой момент",phraseBus:"Где находится автовокзал?",
