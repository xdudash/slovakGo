---
import Base from '../layouts/Base.astro';
import CheckIcon from '../components/CheckIcon.astro';
import faqs from '../data/faq.json';
import '../styles/home.css';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.slovakgo.sk/#website",
      "url": "https://www.slovakgo.sk/",
      "name": "SlovakGO",
      "inLanguage": "uk",
    },
    {
      "@type": "MobileApplication",
      "@id": "https://www.slovakgo.sk/#app",
      "name": "SlovakGO",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": ["Android", "iOS", "Web"],
      "inLanguage": ["uk", "ru", "sk", "en"],
      "description": "Практична словацька для життя в Словаччині: короткі уроки, реальні ситуації, повторення та видимий прогрес.",
      "url": "https://app.slovakgo.sk",
      "offers": {
        "@type": "Offer",
        "price": "3.00",
        "priceCurrency": "EUR",
      },
      "provider": { "@id": "https://www.slovakgo.sk/#organization" },
    },
    {
      "@type": "Organization",
      "@id": "https://www.slovakgo.sk/#organization",
      "name": "SlovakGO",
      "url": "https://www.slovakgo.sk/",
      "logo": "https://www.slovakgo.sk/logo-mark.svg",
      "areaServed": { "@type": "Country", "name": "Slovakia" },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@slovakgo.sk",
        "contactType": "customer support",
        "availableLanguage": ["Ukrainian", "Russian", "Slovak", "English"],
      },
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.slice(0, 5).map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer.replace(/<[^>]+>/g, ''),
        },
      })),
    },
  ],
};
---

<Base
  title="SlovakGO — словацька для життя в Словаччині"
  description="Короткі практичні уроки словацької для роботи, побуту, документів і реальних розмов. Перші уроки безкоштовно, далі 3 дні повного доступу."
  schema={schema}
  bodyClass="home-mobile-v2"
>
  <main class="homev2">
    <section class="homev2-hero">
      <div class="homev2-wrap">
        <p class="homev2-overline">Практична словацька для життя в Словаччині</p>
        <h1>Говори по-словацьки <span>з перших днів.</span></h1>
        <p class="homev2-lead">Короткі уроки, живі діалоги та фрази для роботи, житла, лікаря, документів і звичайного дня.</p>

        <a class="homev2-cta" href="https://app.slovakgo.sk/demo" rel="noopener">
          Почати безкоштовно <span>→</span>
        </a>
        <div class="homev2-meta">
          <span>Перші уроки без оплати</span>
          <span>3 дні повного доступу</span>
        </div>

        <div class="homev2-product">
          <div class="homev2-product-label">Твій урок — прямо в телефоні</div>
          <img src="/slovakgo-preview.png" width="270" height="560" alt="Урок SlovakGO на телефоні" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="homev2-strip">
      <div class="homev2-wrap homev2-strip-inner">
        <div><strong>10–15 хв</strong><span>на один урок</span></div>
        <div><strong>A0 → B2</strong><span>послідовний шлях</span></div>
        <div><strong>SRS</strong><span>повторення слів</span></div>
      </div>
    </section>

    <section class="homev2-section" id="how">
      <div class="homev2-wrap">
        <p class="homev2-overline">Як це працює</p>
        <h2>Ніякої магії. Просто правильний порядок.</h2>

        <div class="homev2-timeline">
          <article>
            <div class="homev2-num">01</div>
            <div>
              <h3>Обираєш ціль</h3>
              <p>Робота, переїзд, навчання, документи або повсякденне спілкування.</p>
            </div>
          </article>
          <article>
            <div class="homev2-num">02</div>
            <div>
              <h3>Проходиш короткий урок</h3>
              <p>Діалог, слова, слухання та вправи без довгої теорії.</p>
            </div>
          </article>
          <article>
            <div class="homev2-num">03</div>
            <div>
              <h3>Повторюєш у потрібний момент</h3>
              <p>Складні слова повертаються автоматично, поки не закріпляться.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="homev2-section homev2-real">
      <div class="homev2-wrap">
        <p class="homev2-overline">Реальні теми</p>
        <h2>Вчиш те, що реально знадобиться.</h2>
        <p class="homev2-copy">Не “урок 7: абстрактна граматика”, а ситуації, в яких треба щось сказати вже сьогодні.</p>

        <div class="homev2-topics">
          <article><span>01</span><h3>У кафе</h3><p>Замовити, уточнити, оплатити.</p></article>
          <article><span>02</span><h3>На роботі</h3><p>Колеги, задачі, короткі діалоги.</p></article>
          <article><span>03</span><h3>Житло</h3><p>Оренда, власник, побутові питання.</p></article>
          <article><span>04</span><h3>Документи</h3><p>Установи, анкети, офіційні фрази.</p></article>
          <article><span>05</span><h3>Лікар</h3><p>Симптоми, запис, аптека.</p></article>
        </div>
      </div>
    </section>

    <section class="homev2-section homev2-app">
      <div class="homev2-wrap">
        <p class="homev2-overline">Всередині SlovakGO</p>
        <h2>Менше екранів. Більше навчання.</h2>

        <div class="homev2-shots" aria-label="Екрани SlovakGO">
          <figure><img src="/app-onboarding.png" alt="Онбординг SlovakGO" loading="lazy" /></figure>
          <figure><img src="/app-exercise.png" alt="Вправа SlovakGO" loading="lazy" /></figure>
          <figure><img src="/app-demo.png" alt="Демо SlovakGO" loading="lazy" /></figure>
        </div>

        <div class="homev2-features">
          <div><strong>Практика</strong><span>миттєва перевірка вправ</span></div>
          <div><strong>Словник</strong><span>персональні повторення</span></div>
          <div><strong>Прогрес</strong><span>XP, серії та рівні</span></div>
        </div>
      </div>
    </section>

    <section class="homev2-section homev2-pricing" id="pricing">
      <div class="homev2-wrap">
        <p class="homev2-overline">Тарифи</p>
        <h2>Спочатку спробуй. Потім вирішуй.</h2>
        <p class="homev2-copy">Новий користувач отримує 3 дні повного доступу. Скасувати можна будь-коли.</p>

        <div class="homev2-price-list">
          <article>
            <div>
              <span class="homev2-plan">Щомісячний</span>
              <strong>€3 <small>/ місяць</small></strong>
            </div>
            <ul>
              <li><CheckIcon /> усі рівні та уроки</li>
              <li><CheckIcon /> практика і SRS</li>
              <li><CheckIcon /> словник і прогрес</li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener">Почати безкоштовно →</a>
          </article>

          <article class="homev2-price-best">
            <div class="homev2-price-head">
              <div>
                <span class="homev2-plan">Річний</span>
                <strong>€20 <small>/ рік</small></strong>
              </div>
              <span class="homev2-save">вигідніше</span>
            </div>
            <p>≈ €1,67 на місяць</p>
            <ul>
              <li><CheckIcon /> усі рівні та уроки</li>
              <li><CheckIcon /> практика і SRS</li>
              <li><CheckIcon /> словник і прогрес</li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=yearly" rel="noopener">Почати безкоштовно →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="homev2-section homev2-faq">
      <div class="homev2-wrap">
        <p class="homev2-overline">FAQ</p>
        <h2>Коротко про головне.</h2>
        <div class="homev2-faq-list">
          {faqs.slice(0, 5).map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <div class="homev2-answer" set:html={faq.answer} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="homev2-bottom">
      <div class="homev2-wrap">
        <p>SlovakGO</p>
        <h2>Почни з одного короткого уроку.</h2>
        <a href="https://app.slovakgo.sk/demo" rel="noopener">Почати безкоштовно →</a>
      </div>
    </section>

    <div class="homev2-sticky">
      <a href="https://app.slovakgo.sk/demo" rel="noopener">Почати безкоштовно <span>→</span></a>
    </div>
  </main>
</Base>
