---
import Base from '../layouts/Base.astro';
import CheckIcon from '../components/CheckIcon.astro';
import '../styles/home-v3.css';

const schema = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "name": "SlovakGO",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": ["Android", "iOS", "Web"],
  "url": "https://app.slovakgo.sk",
  "offers": [
    { "@type": "Offer", "price": "3.00", "priceCurrency": "EUR" },
    { "@type": "Offer", "price": "20.00", "priceCurrency": "EUR" }
  ]
};
---

<Base
  title="SlovakGO — практична словацька для життя в Словаччині"
  description="Короткі практичні уроки словацької для роботи, житла, лікаря, документів і щоденних розмов."
  schema={schema}
  bodyClass="home-mobile-v3"
>
  <main class="v3">
    <header class="v3-header">
      <div class="v3-wrap v3-header-inner">
        <a href="/" class="v3-logo" aria-label="SlovakGO">
          <img src="/slovakgo-logo.svg" width="156" height="34" alt="SlovakGO" />
        </a>
        <div class="v3-header-actions">
          <label class="v3-lang">
            <span class="sr-only">Language</span>
            <select id="language-select" aria-label="Language">
              <option value="sk">SK</option>
              <option value="uk">UA</option>
              <option value="ru">RU</option>
              <option value="en">EN</option>
            </select>
          </label>
          <details class="v3-menu">
            <summary aria-label="Menu">☰</summary>
            <nav>
              <a href="#how" data-i18n="navHow">Як це працює</a>
              <a href="#topics" data-i18n="navTopics">Теми</a>
              <a href="#pricing" data-i18n="navPricing">Тарифи</a>
              <a href="#faq" data-i18n="navFaq">FAQ</a>
              <a href="https://app.slovakgo.sk/login" data-i18n="navLogin">Увійти</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <section class="v3-hero">
      <div class="v3-wrap">
        <div class="v3-hero-copy">
          <p class="v3-eyebrow" data-i18n="eyebrow">Практична словацька для реального життя</p>
          <h1>
            <span data-i18n="heroLine1">Вивчай словацьку</span>
            <em data-i18n="heroLine2">для життя в Словаччині</em>
          </h1>
          <p class="v3-lead" data-i18n="heroLead">Короткі практичні уроки, реальні ситуації та корисні фрази, які знадобляться на роботі, вдома, у лікаря й у щоденному житті.</p>
          <a class="v3-primary" href="https://app.slovakgo.sk/demo" rel="noopener">
            <span data-i18n="startFree">Почати безкоштовно</span><b>→</b>
          </a>
          <p class="v3-subnote"><span data-i18n="trial3">3 дні безкоштовно</span> · <span data-i18n="cancelAnytime">Скасувати можна будь-коли</span></p>
        </div>

        <div class="v3-hero-product">
          <div class="v3-phone">
            <img src="/slovakgo-preview.png" width="270" height="560" alt="SlovakGO lesson screen" loading="eager" fetchpriority="high" />
          </div>
          <div class="v3-phone-note v3-note-a"><strong>Dobrý deň!</strong><span data-i18n="helloTranslation">Добрий день!</span></div>
          <div class="v3-phone-note v3-note-b"><strong>Koľko to stojí?</strong><span data-i18n="costTranslation">Скільки це коштує?</span></div>
        </div>
      </div>
    </section>

    <section class="v3-value">
      <div class="v3-wrap v3-value-grid">
        <article><span>01</span><h2 data-i18n="value1Title">Реальні ситуації</h2><p data-i18n="value1Text">Фрази, які справді потрібні в Словаччині.</p></article>
        <article><span>02</span><h2 data-i18n="value2Title">Короткі уроки</h2><p data-i18n="value2Text">10–15 хвилин, щоб не випадати з ритму.</p></article>
        <article><span>03</span><h2 data-i18n="value3Title">Розумні повторення</h2><p data-i18n="value3Text">Слова повертаються тоді, коли їх час повторити.</p></article>
      </div>
    </section>

    <section class="v3-section" id="topics">
      <div class="v3-wrap">
        <div class="v3-section-head">
          <p class="v3-eyebrow" data-i18n="topicsEyebrow">Практичні теми</p>
          <h2 data-i18n="topicsTitle">Те, що потрібно щодня.</h2>
          <p data-i18n="topicsLead">Без абстрактних тем заради тем. Тільки ситуації, в яких треба зрозуміти й відповісти.</p>
        </div>
        <div class="v3-topics">
          <article><div class="v3-topic-icon">💼</div><div><h3 data-i18n="topicWork">Робота</h3><p data-i18n="topicWorkText">Співбесіда, колеги, умови.</p></div></article>
          <article><div class="v3-topic-icon">⌂</div><div><h3 data-i18n="topicHome">Житло</h3><p data-i18n="topicHomeText">Оренда, договір, власник.</p></div></article>
          <article><div class="v3-topic-icon">＋</div><div><h3 data-i18n="topicDoctor">Лікар</h3><p data-i18n="topicDoctorText">Запис, симптоми, аптека.</p></div></article>
          <article><div class="v3-topic-icon">▤</div><div><h3 data-i18n="topicDocs">Документи</h3><p data-i18n="topicDocsText">Установи, анкети, дозволи.</p></div></article>
          <article><div class="v3-topic-icon">☕</div><div><h3 data-i18n="topicCafe">Кафе</h3><p data-i18n="topicCafeText">Замовлення й короткі розмови.</p></div></article>
          <article><div class="v3-topic-icon">▣</div><div><h3 data-i18n="topicTransport">Транспорт</h3><p data-i18n="topicTransportText">Квитки, маршрути, орієнтація.</p></div></article>
        </div>
      </div>
    </section>

    <section class="v3-section v3-how" id="how">
      <div class="v3-wrap">
        <div class="v3-section-head">
          <p class="v3-eyebrow" data-i18n="howEyebrow">Як це працює</p>
          <h2 data-i18n="howTitle">Три зрозумілі кроки.</h2>
        </div>
        <div class="v3-steps">
          <article><b>1</b><div><h3 data-i18n="step1Title">Обираєш тему</h3><p data-i18n="step1Text">Короткий урок із реальною ситуацією.</p></div></article>
          <article><b>2</b><div><h3 data-i18n="step2Title">Вчишся інтерактивно</h3><p data-i18n="step2Text">Слухаєш, відповідаєш і повторюєш.</p></div></article>
          <article><b>3</b><div><h3 data-i18n="step3Title">Використовуєш у житті</h3><p data-i18n="step3Text">Говориш упевненіше в реальних ситуаціях.</p></div></article>
        </div>
      </div>
    </section>

    <section class="v3-section v3-product-section">
      <div class="v3-wrap">
        <div class="v3-section-head">
          <p class="v3-eyebrow" data-i18n="productEyebrow">Всередині застосунку</p>
          <h2 data-i18n="productTitle">Все навчання — в одному місці.</h2>
        </div>
        <div class="v3-screens">
          <figure><img src="/app-onboarding.png" alt="SlovakGO onboarding" loading="lazy" /></figure>
          <figure><img src="/app-exercise.png" alt="SlovakGO exercise" loading="lazy" /></figure>
          <figure><img src="/app-demo.png" alt="SlovakGO demo" loading="lazy" /></figure>
        </div>
      </div>
    </section>

    <section class="v3-section v3-pricing" id="pricing">
      <div class="v3-wrap">
        <div class="v3-section-head">
          <p class="v3-eyebrow" data-i18n="pricingEyebrow">Прості ціни</p>
          <h2 data-i18n="pricingTitle">Без складних планів.</h2>
          <p data-i18n="pricingLead">Спробуй 3 дні безкоштовно. Потім обери зручний формат.</p>
        </div>

        <div class="v3-prices">
          <article>
            <p class="v3-plan" data-i18n="monthly">Щомісячний</p>
            <div class="v3-price">€3 <small data-i18n="perMonth">/ місяць</small></div>
            <ul>
              <li><CheckIcon /><span data-i18n="allLessons">Усі уроки</span></li>
              <li><CheckIcon /><span data-i18n="srs">SRS-повторення</span></li>
              <li><CheckIcon /><span data-i18n="progress">Прогрес і словник</span></li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=monthly" rel="noopener" data-i18n="choose">Обрати</a>
          </article>
          <article class="v3-best">
            <div class="v3-best-row"><p class="v3-plan" data-i18n="yearly">Річний</p><span data-i18n="bestValue">Найвигідніше</span></div>
            <div class="v3-price">€20 <small data-i18n="perYear">/ рік</small></div>
            <p class="v3-equivalent">≈ €1,67 / <span data-i18n="monthWord">місяць</span></p>
            <ul>
              <li><CheckIcon /><span data-i18n="allLessons">Усі уроки</span></li>
              <li><CheckIcon /><span data-i18n="srs">SRS-повторення</span></li>
              <li><CheckIcon /><span data-i18n="progress">Прогрес і словник</span></li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=yearly" rel="noopener" data-i18n="choose">Обрати</a>
          </article>
        </div>
      </div>
    </section>

    <section class="v3-section v3-faq" id="faq">
      <div class="v3-wrap">
        <div class="v3-section-head">
          <p class="v3-eyebrow">FAQ</p>
          <h2 data-i18n="faqTitle">Поширені запитання.</h2>
        </div>
        <div class="v3-faq-list">
          <details><summary data-i18n="faq1q">Чи справді є 3 безкоштовні дні?</summary><p data-i18n="faq1a">Так. Новий користувач отримує 3 дні повного доступу.</p></details>
          <details><summary data-i18n="faq2q">Чи потрібна банківська картка?</summary><p data-i18n="faq2a">Для активації пробного періоду картка потрібна. Скасувати підписку можна будь-коли.</p></details>
          <details><summary data-i18n="faq3q">Чи підійде початківцю?</summary><p data-i18n="faq3a">Так. Навчання починається з базового рівня і рухається крок за кроком.</p></details>
          <details><summary data-i18n="faq4q">На яких пристроях працює?</summary><p data-i18n="faq4a">На телефоні, планшеті та комп’ютері через браузер.</p></details>
        </div>
      </div>
    </section>

    <section class="v3-final">
      <div class="v3-wrap">
        <img src="/slovakgo-logo.svg" width="150" height="32" alt="SlovakGO" />
        <h2 data-i18n="finalTitle">Почни говорити словацькою вже сьогодні.</h2>
        <a class="v3-primary" href="https://app.slovakgo.sk/demo" rel="noopener"><span data-i18n="startFree">Почати безкоштовно</span><b>→</b></a>
      </div>
    </section>

    <div class="v3-sticky">
      <a href="https://app.slovakgo.sk/demo" rel="noopener"><span data-i18n="startFree">Почати безкоштовно</span><b>→</b></a>
    </div>
  </main>

