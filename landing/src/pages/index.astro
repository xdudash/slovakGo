    const supported = ["sk","uk","ru","en"];
    const qs = new URLSearchParams(location.search).get("lang");
    const saved = localStorage.getItem("slovakgo-site-lang");
    const browser = (navigator.languages?.[0] || navigator.language || "").toLowerCase();
    const deviceLang = browser.startsWith("sk") ? "sk"
      : browser.startsWith("uk") ? "uk"
      : browser.startsWith("ru") ? "ru"
      : browser.startsWith("en") ? "en"
      : "ru";
    const initial = supported.includes(qs) ? qs : supported.includes(saved) ? saved : deviceLang;

    function setLanguage(lang, persist = true) {
      if (!supported.includes(lang)) lang = "ru";
      const dict = I18N[lang];
      document.documentElement.lang = lang;
      if (persist) localStorage.setItem("slovakgo-site-lang", lang);
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (key && dict[key]) el.textContent = dict[key];
      });
      document.querySelectorAll("[data-lang]").forEach((button) => {
        const active = button.getAttribute("data-lang") === lang;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });
      const url = new URL(location.href);
      url.searchParams.set("lang", lang);
      history.replaceState({}, "", url);
    }

    document.querySelectorAll("[data-lang]").forEach((button) => {
      button.addEventListener("click", () => setLanguage(button.getAttribute("data-lang") || "ru"));
    });
    setLanguage(initial, false);
  </script>
