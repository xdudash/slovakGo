---
import Base from '../layouts/Base.astro';
import CheckIcon from '../components/CheckIcon.astro';
import faqs from '../data/faq.json';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.slovakgo.sk/#website",
      "url": "https://www.slovakgo.sk/",
      "name": "SlovakGO",
      "inLanguage": "uk",
    },
    {
      "@type": "MobileApplication",
      "@id": "https://www.slovakgo.sk/#app",
      "name": "SlovakGO",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": ["Android", "iOS", "Web"],
      "inLanguage": ["uk", "ru", "sk", "en"],
      "description": "Практична словацька для життя в Словаччині: короткі уроки, реальні ситуації, повторення та видимий прогрес.",
      "url": "https://app.slovakgo.sk",
      "offers": {
        "@type": "Offer",
        "price": "9.99",
        "priceCurrency": "EUR",
      },
      "provider": { "@id": "https://www.slovakgo.sk/#organization" },
    },
    {
      "@type": "Organization",
      "@id": "https://www.slovakgo.sk/#organization",
      "name": "SlovakGO",
      "url": "https://www.slovakgo.sk/",
      "logo": "https://www.slovakgo.sk/apple-icon.png",
      "areaServed": { "@type": "Country", "name": "Slovakia" },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "support@slovakgo.sk",
        "contactType": "customer support",
        "availableLanguage": ["Ukrainian", "Russian", "Slovak", "English"],
      },
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.slice(0, 6).map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer.replace(/<[^>]+>/g, ''),
        },
      })),
    },
  ],
};
---

<Base
  title="SlovakGO — словацька для життя в Словаччині"
  description="Короткі практичні уроки словацької для роботи, побуту, документів і реальних розмов. Перші уроки безкоштовно, далі 3 дні повного доступу."
  schema={schema}
  bodyClass="home-page mobile-rebrand"
>
  <main class="mkt">
    <section class="mkt-hero">
      <div class="mkt-shell mkt-hero-grid">
        <div class="mkt-hero-copy">
          <div class="mkt-kicker">🇺🇦 Словацька для життя в Словаччині</div>
          <h1>Словацька, яка потрібна <span>щодня</span></h1>
          <p class="mkt-lead">
            Короткі уроки на 10–15 хвилин: робота, житло, лікар, документи та розмови,
            які трапляються у реальному житті.
          </p>
          <div class="mkt-hero-actions">
            <a href="https://app.slovakgo.sk/demo" class="mkt-btn mkt-btn-primary" rel="noopener">
              Почати безкоштовно
              <span aria-hidden="true">→</span>
            </a>
            <a href="#how" class="mkt-text-link">Як це працює</a>
          </div>
          <div class="mkt-trustline">
            <span>✓ Перші уроки без оплати</span>
            <span>✓ 3 дні повного доступу</span>
            <span>✓ Скасування будь-коли</span>
          </div>
        </div>

        <div class="mkt-device-stage" aria-label="Приклад застосунку SlovakGO">
          <div class="mkt-orbit mkt-orbit-a"></div>
          <div class="mkt-orbit mkt-orbit-b"></div>
          <div class="mkt-bubble mkt-bubble-one"><strong>Dobrý deň!</strong><small>Добрий день!</small></div>
          <div class="mkt-bubble mkt-bubble-two"><strong>Kde je autobus?</strong><small>Де автобус?</small></div>
          <div class="mkt-phone">
            <div class="mkt-phone-notch"></div>
            <img src="/slovakgo-preview.png" alt="Екран уроку SlovakGO" width="270" height="560" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <section class="mkt-proof">
      <div class="mkt-shell mkt-proof-grid">
        <article>
          <div class="mkt-icon">💬</div>
          <h2>Реальні ситуації</h2>
          <p>Фрази для магазину, роботи, оренди, лікаря та установ.</p>
        </article>
        <article>
          <div class="mkt-icon">🧠</div>
          <h2>Розумні повторення</h2>
          <p>SRS повертає слова саме тоді, коли їх час повторити.</p>
        </article>
        <article>
          <div class="mkt-icon">⚡</div>
          <h2>Короткі уроки</h2>
          <p>10–15 хвилин на день без перевантаження теорією.</p>
        </article>
        <article>
          <div class="mkt-icon">📈</div>
          <h2>Видимий прогрес</h2>
          <p>XP, серії, рівні та статистика тримають темп навчання.</p>
        </article>
      </div>
    </section>

    <section class="mkt-section" id="how">
      <div class="mkt-shell">
        <div class="mkt-section-head">
          <span>Як це працює</span>
          <h2>Простий шлях до впевненої мови</h2>
          <p>Без довгих лекцій. Ти одразу вчиш те, що можна використати сьогодні.</p>
        </div>

        <div class="mkt-steps">
          <article class="mkt-step">
            <div class="mkt-step-num">1</div>
            <div>
              <h3>Обираєш свою ціль</h3>
              <p>Робота, навчання, переїзд, документи або повсякденне спілкування.</p>
            </div>
          </article>
          <article class="mkt-step">
            <div class="mkt-step-num">2</div>
            <div>
              <h3>Проходиш короткі уроки</h3>
              <p>Слова, діалоги, слухання та інтерактивні вправи в одному сценарії.</p>
            </div>
          </article>
          <article class="mkt-step">
            <div class="mkt-step-num">3</div>
            <div>
              <h3>Повторюєш і говориш</h3>
              <p>Система повертає складне, поки потрібні слова не стають автоматичними.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="mkt-showcase">
      <div class="mkt-shell mkt-showcase-grid">
        <div class="mkt-showcase-copy">
          <span class="mkt-eyebrow">Продукт, а не підручник</span>
          <h2>Навчання, яке відчувається як застосунок</h2>
          <p>
            Уроки, словник, практика та прогрес зібрані в одному місці.
            Відкрив — зробив кілька вправ — закрив із відчутним результатом.
          </p>
          <ul>
            <li><CheckIcon /> вправи з миттєвим фідбеком</li>
            <li><CheckIcon /> словник із персональними повтореннями</li>
            <li><CheckIcon /> статистика рівня, XP та серії</li>
            <li><CheckIcon /> адаптація під телефон</li>
          </ul>
        </div>
        <div class="mkt-screens">
          <figure class="mkt-screen mkt-screen-left">
            <img src="/app-onboarding.png" alt="Онбординг SlovakGO" loading="lazy" />
          </figure>
          <figure class="mkt-screen mkt-screen-main">
            <img src="/app-exercise.png" alt="Вправа SlovakGO" loading="lazy" />
          </figure>
          <figure class="mkt-screen mkt-screen-right">
            <img src="/app-demo.png" alt="Демо SlovakGO" loading="lazy" />
          </figure>
        </div>
      </div>
    </section>

    <section class="mkt-section mkt-section-soft">
      <div class="mkt-shell">
        <div class="mkt-section-head">
          <span>Що ти отримуєш</span>
          <h2>Не просто “вивчав”. А реально можеш сказати.</h2>
        </div>
        <div class="mkt-benefits">
          <article>
            <strong>01</strong>
            <h3>Менше страху говорити</h3>
            <p>Ти бачиш і повторюєш готові фрази в контексті, а не складаєш їх з нуля під стресом.</p>
          </article>
          <article>
            <strong>02</strong>
            <h3>Слова залишаються в пам’яті</h3>
            <p>Повторення плануються автоматично — без ручних списків і хаотичних карток.</p>
          </article>
          <article>
            <strong>03</strong>
            <h3>Зрозуміло, що робити далі</h3>
            <p>Шлях від A0 до B2 розбитий на маленькі кроки, тому не треба самому будувати програму.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="mkt-section mkt-testimonials">
      <div class="mkt-shell">
        <div class="mkt-section-head">
          <span>Для життя в Словаччині</span>
          <h2>Теми, які потрібні не “колись”, а зараз</h2>
        </div>
        <div class="mkt-topic-row" role="list">
          <div role="listitem">🏠 Оренда житла</div>
          <div role="listitem">💼 Робота</div>
          <div role="listitem">🏥 Лікар та аптека</div>
          <div role="listitem">🧾 Документи</div>
          <div role="listitem">🚌 Транспорт</div>
          <div role="listitem">🛒 Покупки</div>
        </div>
      </div>
    </section>

    <section class="mkt-section" id="pricing">
      <div class="mkt-shell">
        <div class="mkt-section-head">
          <span>Тарифи</span>
          <h2>Спочатку спробуй. Потім вирішуй.</h2>
          <p>Перші уроки доступні без оплати. Для нового користувача — 3 дні повного доступу.</p>
        </div>
        <div class="mkt-pricing">
          <article class="mkt-price-card">
            <div class="mkt-price-label">Гнучкий</div>
            <h3>Щомісячний</h3>
            <div class="mkt-price">€9,99 <small>/ міс</small></div>
            <ul>
              <li><CheckIcon /> усі рівні та уроки</li>
              <li><CheckIcon /> практика та SRS</li>
              <li><CheckIcon /> словник і прогрес</li>
              <li><CheckIcon /> скасування будь-коли</li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=monthly" class="mkt-btn mkt-btn-ghost" rel="noopener">Спробувати</a>
          </article>
          <article class="mkt-price-card mkt-price-card-featured">
            <div class="mkt-price-topline">
              <div class="mkt-price-label">Найвигідніший</div>
              <div class="mkt-save">−50%</div>
            </div>
            <h3>Річний</h3>
            <div class="mkt-price">€59,88 <small>/ рік</small></div>
            <p class="mkt-price-note">≈ €4,99 на місяць</p>
            <ul>
              <li><CheckIcon /> усі рівні та уроки</li>
              <li><CheckIcon /> практика та SRS</li>
              <li><CheckIcon /> словник і прогрес</li>
              <li><CheckIcon /> 3 дні пробного доступу</li>
            </ul>
            <a href="https://app.slovakgo.sk/demo?plan=yearly" class="mkt-btn mkt-btn-primary" rel="noopener">Почати безкоштовно</a>
          </article>
        </div>
        <p class="mkt-billing-note">Картка потрібна для пробного періоду. Скасувати можна в будь-який момент через Stripe.</p>
      </div>
    </section>

    <section class="mkt-section mkt-faq">
      <div class="mkt-shell">
        <div class="mkt-section-head">
          <span>FAQ</span>
          <h2>Перед стартом</h2>
        </div>
        <div class="mkt-faq-list">
          {faqs.slice(0, 5).map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <div class="mkt-faq-answer" set:html={faq.answer} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mkt-final" id="about">
      <div class="mkt-shell mkt-final-inner">
        <div>
          <span>SlovakGO</span>
          <h2>Почни говорити словацькою впевненіше вже сьогодні.</h2>
          <p>Один короткий урок — і ти вже знаєш більше, ніж 15 хвилин тому.</p>
        </div>
        <a href="https://app.slovakgo.sk/demo" class="mkt-btn mkt-btn-light" rel="noopener">Почати безкоштовно →</a>
      </div>
    </section>
  </main>
</Base>
