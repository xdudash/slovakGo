    const supported = ["sk","uk","ru","en"];
    const qs = new URLSearchParams(location.search).get("lang");
    const saved = localStorage.getItem("slovakgo-site-lang");
    const browser = (navigator.language || "").toLowerCase();
    const browserLang = browser.startsWith("sk") ? "sk" : browser.startsWith("uk") ? "uk" : browser.startsWith("ru") ? "ru" : browser.startsWith("en") ? "en" : "uk";
    const initial = supported.includes(qs) ? qs : supported.includes(saved) ? saved : browserLang;
    const select = document.getElementById("language-select");

    function setLanguage(lang) {
      if (!supported.includes(lang)) return;
      const dict = I18N[lang];
      document.documentElement.lang = lang === "uk" ? "uk" : lang;
      localStorage.setItem("slovakgo-site-lang", lang);
      if (select) select.value = lang;
      document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (dict[key]) el.textContent = dict[key];
      });
      const url = new URL(location.href);
      url.searchParams.set("lang", lang);
      history.replaceState({}, "", url);
    }
    select?.addEventListener("change", e => setLanguage(e.target.value));
    setLanguage(initial);
  </script>
