---
import copy from "../data/home.json";
import Icon from "./LineIcon.astro";
import "../styles/home-premium.css";
const { lang = "uk" } = Astro.props;
const strings = copy[lang as keyof typeof copy] || copy.uk;
const t = (key: string): string =>
  (strings as unknown as Record<string, string>)[key] || "";
const arr = (key: string): string[] =>
  (strings as unknown as Record<string, string[]>)[key] || [];
const app = `https://app.slovakgo.sk/register?lang=${lang}`;
const icons = [
  "work",
  "home",
  "health",
  "docs",
  "coffee",
  "people",
  "school",
  "bus",
];
const phrases = [
  "Hľadám si prácu.",
  "Je byt ešte voľný?",
  "Čo vás bolí?",
  "Aké doklady potrebujem?",
  "Prosím si kávu.",
  "Dobrý deň, som váš nový sused.",
  "Kedy sa začína prednáška?",
  "Kde je zastávka?",
];
const faqs = [
  ["faqQ0", "faqA0"],
  ["faqLanguageQ", "faqLanguageA"],
  ["faqQ7", "faqA7"],
  ["faqQ1", "faqA1"],
  ["faqQ5", "faqA5"],
  ["faqCardQ", "faqCardA"],
  ["faqQ6", "faqA6"],
  ["faqQ3", "faqA3"],
  ["faqLevelQ", "faqLevelA"],
];
const canonical = new URL(Astro.url.pathname, "https://www.slovakgo.sk");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f4f7ff" />
    <title>SlovakGO — {t('eyebrow')}</title>
    <meta name="description" content={t("lead")} />
    <link rel="canonical" href={canonical} />
    {["uk", "ru", "en", "sk"].map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={`https://www.slovakgo.sk/${locale}/`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://www.slovakgo.sk/"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon-32-v1.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-icon.png?v=mascot-1" sizes="180x180" />
    <meta property="og:title" content={`SlovakGO — ${t("eyebrow")}`} />
    <meta property="og:description" content={t("lead")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://www.slovakgo.sk/slovakgo-preview.png"
    />
    <meta
      name="google-site-verification"
      content="wBZHPUxYu-Q_LV0xj7pKp3HmUNIwB2J38CFUxphUx_s"
    />
  </head>
  <body>
    <a class="skip" href="#content" data-t="skip">
      {t("skip")}
    </a>
    <header class="nav shell">
      <a class="brand" href={`/${lang}/`} aria-label="SlovakGO">
        <img class="brand-avatar" src="/brand-avatar-v1.webp" alt="" width="40" height="40" />
        <span>
          Slovak<span class="brand-go">GO</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="SlovakGO">
        <a href="#how" data-t="navHow">
          {t("navHow")}
        </a>
        <a href="#levels" data-t="navLevels">
          {t("navLevels")}
        </a>
        <a href="#pricing" data-t="navPrice">
          {t("navPrice")}
        </a>
      </nav>
      <div class="nav-actions">
        <label class="language">
          <span aria-hidden="true">◎</span>
          <select id="language" aria-label="Language">
            <option value="uk" selected={lang === "uk"}>
              UA
            </option>
            <option value="ru" selected={lang === "ru"}>
              RU
            </option>
            <option value="en" selected={lang === "en"}>
              EN
            </option>
            <option value="sk" selected={lang === "sk"}>
              SK
            </option>
          </select>
        </label>
        <a
          class="login"
          href={`https://app.slovakgo.sk/login?lang=${lang}`}
          data-t="login"
        >
          {t("login")}
        </a>
      </div>
    </header>
    <main id="content">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow">
            <span aria-hidden="true">🇸🇰</span>
            <span data-t="eyebrow">{t("eyebrow")}</span>
          </div>
          <h1 id="hero-title" data-t="title" set:html={t("title")} />
          <div class="mobile-conversation">
            <svg
              class="hero-friend"
              viewBox="0 0 80 86"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M17 58L9 72M55 60l9 13"
                stroke="#ffd21f"
                stroke-width="6"
                stroke-linecap="round"
              />
              <path
                d="M11 34L3 27M65 30l11-10"
                stroke="#ffd21f"
                stroke-width="5"
                stroke-linecap="round"
              />
              <path
                d="M11 17q0-10 10-10h35q10 0 10 10v34q0 10-10 10H41L27 73V61h-6q-10 0-10-10z"
                fill="#ffd21f"
              />
              <path
                d="M29 29v5M49 29v5"
                stroke="#211946"
                stroke-width="4"
                stroke-linecap="round"
              />
              <path
                d="M31 44q8 9 16 0"
                stroke="#211946"
                stroke-width="4"
                stroke-linecap="round"
              />
            </svg>
            <div class="greeting-bubbles">
              <span lang="sk">
                Dobrý deň! <span aria-hidden="true">✦</span>
              </span>
              <span data-t="greetingMeaning">{t("greetingMeaning")}</span>
            </div>
          </div>
          <p class="lead desktop-lead" data-t="lead">
            {t("lead")}
          </p>
          <p class="lead mobile-lead" data-t="mobileLead">
            {t("mobileLead")}
          </p>
          <div class="hero-actions">
            <a class="button yellow" href="#exercise" data-start>
              <span data-t="try">{t("try")}</span>
              <Icon name="arrow" size={20} />
            </a>
            <a class="text-link" href="#how" data-t="heroSecondary">
              {t("heroSecondary")}
            </a>
          </div>
          <p class="helper">
            <Icon name="check" size={16} />
            <span data-t="trial">{t("trial")}</span>
          </p>
          <div class="hero-bottom">
            <span>
              <Icon name="book" size={18} />
              <span data-t="benefitTime">{t("benefitTime")}</span>
            </span>
            <span>
              <Icon name="spark" size={18} />
              <span data-t="benefitPhone">{t("benefitPhone")}</span>
            </span>
          </div>
        </div>
        <div class="demo-stage">
          <div class="orbit" aria-hidden="true"></div>
          <span class="hello-note" lang="sk">
            Dobrý deň! <span>✦</span>
          </span>
          <section
            class="demo"
            id="exercise"
            aria-labelledby="exercise-title"
            tabindex="-1"
          >
            <div class="demo-chrome">
              <span class="mini-brand">
                Slovak<span>GO</span>
              </span>
              <span class="level-pill">
                A1 <span aria-hidden="true">·</span>{" "}
                <span data-t="lessonTopic">{t("lessonTopic")}</span>
              </span>
            </div>
            <div class="progress-row">
              <div
                class="progress-track"
                role="progressbar"
                aria-label={t("previewLive")}
                aria-valuemin="0"
                aria-valuemax="2"
                aria-valuenow="0"
              >
                <span></span>
              </div>
              <span class="progress-count">1 / 2</span>
            </div>
            <div class="demo-body">
              <p class="demo-label" data-t="demoLabel">
                {t("demoLabel")}
              </p>
              <div class="phrase-row">
                <h2 id="exercise-title" lang="sk">
                  Čo vás bolí?
                </h2>
                <button
                  class="audio"
                  type="button"
                  aria-label={t("listen")}
                  title={t("listen")}
                >
                  <Icon name="sound" size={22} />
                </button>
              </div>
              <p class="lesson-meaning" data-t="lessonMeaning">
                {t("lessonMeaning")}
              </p>
              <p class="audio-status" role="status"></p>
              <h3 class="lesson-prompt" data-t="lessonPrompt">
                {t("lessonPrompt")}
              </h3>
              <div
                class="lesson-options"
                role="group"
                aria-label={t("questionLabel")}
              >
                <button
                  class="lesson-option"
                  type="button"
                  data-answer="0"
                  aria-pressed="false"
                >
                  <span class="option-key">1</span>
                  <span class="option-text" lang="sk">
                    Som hladný.
                  </span>
                  <span class="option-mark" aria-hidden="true"></span>
                </button>
                <button
                  class="lesson-option"
                  type="button"
                  data-answer="1"
                  aria-pressed="false"
                >
                  <span class="option-key">2</span>
                  <span class="option-text" lang="sk">
                    Bolí ma hlava.
                  </span>
                  <span class="option-mark" aria-hidden="true"></span>
                </button>
              </div>
              <p class="lesson-feedback" role="status"></p>
              <details class="lesson-explanation" hidden>
                <summary data-t="explain">{t("explain")}</summary>
                <p data-t="explanation">{t("explanation")}</p>
              </details>
              <button type="button" class="button purple lesson-next" hidden>
                <span data-t="next">{t("next")}</span>
                <Icon name="arrow" size={18} />
              </button>
            </div>
            <div class="demo-complete" hidden>
              <span class="complete-check" aria-hidden="true">
                ✓
              </span>
              <h2 tabindex="-1" data-t="completeTitle">
                {t("completeTitle")}
              </h2>
              <p data-t="completeText">{t("completeText")}</p>
              <a class="button yellow" href={app} data-register>
                <span data-t="footerCta">{t("footerCta")}</span>
                <Icon name="arrow" size={18} />
              </a>
              <button class="text-link restart" type="button" data-t="restart">
                {t("restart")}
              </button>
            </div>
            <div class="demo-foot">
              <span aria-hidden="true">✦</span>
              <span data-t="trial">{t("trial")}</span>
            </div>
          </section>
          <div class="little-note">
            <span aria-hidden="true">✓</span>
            <span data-t="sceneCaption2">{t("sceneCaption2")}</span>
          </div>
        </div>
      </section>
      <div class="life-strip">
        <div class="shell">
          <span lang="sk">Doma.</span>
          <span lang="sk">V práci.</span>
          <span lang="sk">V kaviarni.</span>
          <span class="strip-caption" data-t="footerBrand">
            {t("footerBrand")}
          </span>
        </div>
      </div>
      <section class="section shell situations" id="situations">
        <div class="section-heading">
          <h2 data-t="situationsTitle">{t("situationsTitle")}</h2>
          <p data-t="situationsLead">{t("situationsLead")}</p>
        </div>
        <div class="topic-grid">
          {icons.map((icon, i) => (
            <button
              type="button"
              class:list={["topic", { active: i === 2 }]}
              data-topic={i}
              aria-pressed={i === 2}
            >
              <Icon name={icon} size={27} />
              <span>
                <strong data-list="topics" data-index={i}>
                  {arr("topics")[i]}
                </strong>
                <small data-list="topicDesc" data-index={i}>
                  {arr("topicDesc")[i]}
                </small>
              </span>
              <span class="topic-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>
        <div class="daily-phrase" aria-live="polite">
          <span data-t="phraseLabel">{t("phraseLabel")}</span>
          <strong class="daily-slovak" lang="sk">
            {phrases[2]}
          </strong>
          <span class="daily-translation">{arr("translations")[2]}</span>
        </div>
      </section>
      <section class="understand" id="how">
        <div class="shell understand-grid">
          <div>
            <h2 data-t="understandTitle" set:html={t("understandTitle")} />
            <p class="section-lead" data-t="understandLead">
              {t("understandLead")}
            </p>
            <div class="feature-list">
              {["book", "people", "repeat", "sound"].map((icon, i) => (
                <article>
                  <Icon name={icon} size={24} />
                  <div>
                    <h3 data-list="features" data-index={i}>
                      {arr("features")[i]}
                    </h3>
                    <p data-list="featureTexts" data-index={i}>
                      {arr("featureTexts")[i]}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="grammar-scene">
            <div class="grammar-card">
              <span class="grammar-tag">
                SlovakGO <Icon name="spark" size={17} />
              </span>
              <p data-t="grammarLabel">{t("grammarLabel")}</p>
              <div class="grammar-phrase" lang="sk">
                Prosím si <mark>kávu.</mark>
              </div>
              <p data-t="grammarTranslation">{t("grammarTranslation")}</p>
              <div class="word-change" aria-hidden="true">
                <span>káva</span>
                <Icon name="arrow" />
                <strong>kávu</strong>
              </div>
              <details open>
                <summary data-t="grammarTitle">{t("grammarTitle")}</summary>
                <p data-t="grammarText">{t("grammarText")}</p>
              </details>
            </div>
            <span class="grammar-sticker" aria-hidden="true">
              Aha!
            </span>
          </div>
        </div>
      </section>
      <section class="section shell journey" id="levels">
        <div class="journey-heading">
          <h2 data-t="pathTitle" set:html={t("pathTitle")} />
          <div>
            <p data-t="pathLead">{t("pathLead")}</p>
            <a
              class="text-link"
              href="https://app.slovakgo.sk/placement-test"
              data-placement
            >
              <span data-t="placementQ">{t("placementQ")}</span>
              <Icon name="arrow" size={19} />
            </a>
          </div>
        </div>
        <div class="journey-track" role="group" aria-label={t("navLevels")}>
          {["A1 — A2", "B1 — B2", "C1 — C2"].map((code, i) => (
            <button
              type="button"
              class:list={["journey-step", { active: i === 0 }]}
              data-level={i}
              aria-pressed={i === 0}
            >
              <span class="journey-dot" aria-hidden="true">
                {i === 0 ? "✓" : i + 1}
              </span>
              <strong>{code}</strong>
              <span
                data-t={["levelBasic", "levelIndependent", "levelAdvanced"][i]}
              >
                {t(["levelBasic", "levelIndependent", "levelAdvanced"][i])}
              </span>
            </button>
          ))}
        </div>
        <div class="level-detail" aria-live="polite">
          <span class="level-detail-code">A1 — A2</span>
          <p>{t("levelBasicText")}</p>
        </div>
        <p class="level-availability" hidden data-t="advancedNote">
          {t("advancedNote")}
        </p>
      </section>
      <section class="experience">
        <div class="shell">
          <div class="experience-heading">
            <div>
              <h2 data-t="showcaseTitle" set:html={t("showcaseTitle")} />
              <p data-t="showcaseLead">{t("showcaseLead")}</p>
            </div>
            <a class="text-link" href={app} data-register>
              <span data-t="footerCta">{t("footerCta")}</span>
              <Icon name="arrow" size={19} />
            </a>
          </div>
          <div class="screens">
            {["app-demo.png", "app-exercise.png", "app-onboarding.png"].map(
              (file, i) => (
                <figure>
                  <div class="screen-frame">
                    <img
                      src={`/${file}`}
                      alt={arr("screens")[i]}
                      data-screen={i}
                      width="390"
                      height="844"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption>
                    <span aria-hidden="true">0{i + 1}</span>
                    <span data-list="screens" data-index={i}>
                      {arr("screens")[i]}
                    </span>
                  </figcaption>
                </figure>
              ),
            )}
          </div>
        </div>
      </section>
      <section class="section shell pricing" id="pricing">
        <div class="section-heading centered">
          <h2 data-t="priceTitle" set:html={t("priceTitle")} />
          <p data-t="priceLead">{t("priceLead")}</p>
        </div>
        <div class="price-grid">
          <article class="price-card free">
            <span class="price-type" data-t="freeTitle">
              {t("freeTitle")}
            </span>
            <h3 data-t="free">{t("free")}</h3>
            <p data-t="freeText">{t("freeText")}</p>
            <a class="button outline" href="#exercise" data-start>
              <span data-t="try">{t("try")}</span>
              <Icon name="arrow" size={18} />
            </a>
          </article>
          <article class="price-card">
            <span class="price-type" data-t="monthTitle">
              {t("monthTitle")}
            </span>
            <h3>
              €3 <small data-t="monthly">{t("monthly")}</small>
            </h3>
            <ul>
              <li>
                <Icon name="check" size={18} />
                <span data-t="all">{t("all")}</span>
              </li>
              <li>
                <Icon name="check" size={18} />
                <span data-t="audio">{t("audio")}</span>
              </li>
              <li>
                <Icon name="check" size={18} />
                <span data-t="cancel">{t("cancel")}</span>
              </li>
            </ul>
            <a
              class="button purple"
              href={app}
              data-register
              data-plan="monthly"
            >
              <span data-t="trialCta">{t("trialCta")}</span>
              <Icon name="arrow" size={18} />
            </a>
          </article>
          <article class="price-card annual">
            <span class="price-badge" data-t="yearBadge">
              {t("yearBadge")}
            </span>
            <span class="price-type" data-t="yearTitle">
              {t("yearTitle")}
            </span>
            <h3>
              €20 <small data-t="yearPeriod">{t("yearPeriod")}</small>
            </h3>
            <p class="year-note" data-t="yearNote">
              {t("yearNote")}
            </p>
            <ul>
              <li>
                <Icon name="check" size={18} />
                <span data-t="all">{t("all")}</span>
              </li>
              <li>
                <Icon name="check" size={18} />
                <span data-t="cancel">{t("cancel")}</span>
              </li>
            </ul>
            <a
              class="button yellow"
              href={app}
              data-register
              data-plan="yearly"
            >
              <span data-t="trialCta">{t("trialCta")}</span>
              <Icon name="arrow" size={18} />
            </a>
          </article>
        </div>
        <aside class="billing">
          <Icon name="docs" size={24} />
          <div>
            <h3 data-t="trialNotice">{t("trialNotice")}</h3>
            <p data-t="trialNoticeText">{t("trialNoticeText")}</p>
            <p data-t="cancelLine">{t("cancelLine")}</p>
          </div>
        </aside>
      </section>
      <section class="section shell faq" id="faq">
        <div>
          <h2 data-t="faqTitle">{t("faqTitle")}</h2>
          <p data-t="supportText">{t("supportText")}</p>
          <a class="text-link" href="mailto:support@slovakgo.sk">
            <span data-t="supportCta">{t("supportCta")}</span>
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="faq-list">
          {faqs.map(([q, a]) => (
            <details>
              <summary data-t={q}>{t(q)}</summary>
              <p data-t={a}>{t(a)}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="final shell">
        <div>
          <h2 data-t="finalTitle">{t("finalTitle")}</h2>
          <p data-t="finalText">{t("finalText")}</p>
          <a class="button yellow" href="#exercise" data-start>
            <span data-t="try">{t("try")}</span>
            <Icon name="arrow" size={20} />
          </a>
          <p class="final-helper" data-t="trial">
            {t("trial")}
          </p>
        </div>
        <svg
          class="mascot"
          viewBox="0 0 240 240"
          fill="none"
          aria-hidden="true"
        >
          <ellipse cx="120" cy="215" rx="75" ry="10" fill="#d2c9f5" />
          <path
            d="M63 161l-17 31M165 164l20 27"
            stroke="#211946"
            stroke-width="12"
            stroke-linecap="round"
          />
          <path
            d="M48 99l-24-14M187 91l27-24"
            stroke="#211946"
            stroke-width="10"
            stroke-linecap="round"
          />
          <path
            d="M49 62q0-30 30-30h83q30 0 30 30v75q0 30-30 30h-35l-33 27v-27H79q-30 0-30-30z"
            fill="#6f57e8"
          />
          <rect x="87" y="79" width="10" height="20" rx="5" fill="white" />
          <rect x="143" y="79" width="10" height="20" rx="5" fill="white" />
          <path
            d="M104 115q16 18 32 0"
            stroke="white"
            stroke-width="7"
            stroke-linecap="round"
          />
          <path
            d="M195 22l5 12 12 5-12 5-5 12-5-12-12-5 12-5z"
            fill="#ffd21f"
          />
        </svg>
      </section>
    </main>
    <footer class="footer shell">
      <a class="brand" href={`/${lang}/`}>
        <img class="brand-avatar" src="/brand-avatar-v1.webp" alt="" width="40" height="40" />
        <span>Slovak<span class="brand-go">GO</span></span>
      </a>
      <span>© {new Date().getFullYear()} SlovakGO</span>
      <a href="/blog" data-t="blogLabel">
        {t("blogLabel")}
      </a>
      <a href="mailto:support@slovakgo.sk">support@slovakgo.sk</a>
    </footer>
    <script>
      import "../scripts/landing.js";
    </script>
  </body>
</html>
