---
import copy from '../data/home.json';
import '../styles/home-v6.css';
const { lang = 'uk' } = Astro.props;
const strings = copy[lang as keyof typeof copy] || copy.uk;
const t = (key: string) => (strings as Record<string, unknown>)[key] as string || '';
const title = `SlovakGO — ${t('eyebrow')}`;
const canonical = `https://www.slovakgo.sk/${lang}/`;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<title>{title}</title>
<meta name="description" content={t('lead')} />
<link rel="canonical" href={canonical} />
{['uk','ru','en','sk'].map(locale => <link rel="alternate" hreflang={locale} href={`https://www.slovakgo.sk/${locale}/`} />)}
<link rel="alternate" hreflang="x-default" href="https://www.slovakgo.sk/" />
<link rel="icon" href="/apple-icon.png" />
<meta property="og:title" content={title} />
<meta property="og:description" content={t('lead')} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content="https://www.slovakgo.sk/slovakgo-preview.png" />
<meta name="google-site-verification" content="wBZHPUxYu-Q_LV0xj7pKp3HmUNIwB2J38CFUxphUx_s" />
</head>
<body>
<div class="stage"><a class="skip" href="#content" data-t="skip" set:html={t("skip")}></a><main class="site" id="content"><header class="nav"><img class="brand-logo" src="/slovakgo-logo.svg" alt="SlovakGO" width="142" height="31"><nav class="desktop-nav"><a href="#levels" data-t="navLevels" set:html={t("navLevels")}></a><a href="#pricing" data-t="navPrice" set:html={t("navPrice")}></a><a href="#faq" data-t="navFaq" set:html={t("navFaq")}></a></nav><div class="nav-right"><a class="login" href={`https://app.slovakgo.sk/login?lang=${lang}`} data-t="login" set:html={t("login")}></a><div class="langs" aria-label="Language"><a class:list={{active: lang === "uk"}} data-lang="uk" href="/uk/" aria-current={lang === "uk" ? "page" : undefined}>UA</a><a class:list={{active: lang === "ru"}} data-lang="ru" href="/ru/" aria-current={lang === "ru" ? "page" : undefined}>RU</a><a class:list={{active: lang === "en"}} data-lang="en" href="/en/" aria-current={lang === "en" ? "page" : undefined}>EN</a><a class:list={{active: lang === "sk"}} data-lang="sk" href="/sk/" aria-current={lang === "sk" ? "page" : undefined}>SK</a></div></div></header>
<div class="hero-wrap"><section class="hero"><div class="eyebrow" data-t="eyebrow" set:html={t("eyebrow")}></div><h1 data-t="title" set:html={t("title")}></h1><p class="lead" data-t="lead" set:html={t("lead")}></p><a class="cta" href={`https://app.slovakgo.sk/register?lang=${lang}`}><span data-t="try" set:html={t("try")}></span><span>↗</span></a><a class="hero-secondary" href="#exercise" data-t="heroSecondary" set:html={t("heroSecondary")}></a><p class="fine" data-t="trial" set:html={t("trial")}></p></section>
<section class="preview" id="exercise" aria-labelledby="exercise-title"><div class="preview-head"><span class="preview-live">● <span data-t="previewLive" set:html={t("previewLive")}></span></span></div><div class="preview-copy"><h2 id="exercise-title" data-t="preview" set:html={t("preview")}></h2><p data-t="previewSub" set:html={t("previewSub")}></p></div><div class="lesson-card"><div class="lesson-top"><span>SL / 01</span><span data-t="lessonTopic" set:html={t("lessonTopic")}></span></div><div class="lesson-question">Čo vás bolí?</div><div class="lesson-meaning" data-t="lessonMeaning" set:html={t("lessonMeaning")}></div><div class="lesson-prompt" data-t="lessonPrompt" set:html={t("lessonPrompt")}></div><button type="button" class="lesson-option" data-correct="true">Bolí ma hlava.</button><button type="button" class="lesson-option">Som hladný.</button><p class="lesson-feedback" aria-live="polite"></p><a class="lesson-next" hidden href={`https://app.slovakgo.sk/register?lang=${lang}`} data-t="continueCta" set:html={t("continueCta")}></a></div></section></div>
<section class="section fit"><div class="story-heading"><div><div class="kicker" data-t="fitKicker" set:html={t("fitKicker")}></div><h2 data-t="fitTitle" set:html={t("fitTitle")}></h2></div><img class="story-image" src="/images/slovak-everyday.webp" srcset="/images/slovak-everyday-480.webp 480w, /images/slovak-everyday.webp 960w" sizes="(max-width: 700px) calc(100vw - 48px), 440px" width="960" height="640" loading="lazy" decoding="async" data-alt="everydayAlt" alt={t("everydayAlt")} /></div><div class="fit-grid"><article><span class="fit-number">01</span><h3 data-t="fit1Title" set:html={t("fit1Title")}></h3><p data-t="fit1Text" set:html={t("fit1Text")}></p></article><article><span class="fit-number">02</span><h3 data-t="fit2Title" set:html={t("fit2Title")}></h3><p data-t="fit2Text" set:html={t("fit2Text")}></p></article><article><span class="fit-number">03</span><h3 data-t="fit3Title" set:html={t("fit3Title")}></h3><p data-t="fit3Text" set:html={t("fit3Text")}></p></article></div></section>
<section class="section levels" id="levels"><div class="kicker" data-t="levelKicker" set:html={t("levelKicker")}></div><h2 data-t="levelTitle" set:html={t("levelTitle")}></h2><p class="level-lead" data-t="levelLead" set:html={t("levelLead")}></p><div class="level-grid"><article class="level-stage"><span class="level-code">A1 / A2</span><h3 data-t="levelBasic" set:html={t("levelBasic")}></h3><p data-t="levelBasicText" set:html={t("levelBasicText")}></p></article><article class="level-stage"><span class="level-code">B1 / B2</span><h3 data-t="levelIndependent" set:html={t("levelIndependent")}></h3><p data-t="levelIndependentText" set:html={t("levelIndependentText")}></p></article><article class="level-stage"><span class="level-code">C1 / C2</span><h3 data-t="levelAdvanced" set:html={t("levelAdvanced")}></h3><p data-t="levelAdvancedText" set:html={t("levelAdvancedText")}></p></article></div><a class="cta level-cta" href={`https://app.slovakgo.sk/register?lang=${lang}`}><span data-t="levelCta" set:html={t("levelCta")}></span><span>↗</span></a><details class="placement"><summary data-t="placementQ" set:html={t("placementQ")}></summary><p data-t="placementA" set:html={t("placementA")}></p><a href={`https://app.slovakgo.sk/register?lang=${lang}`} data-t="placementCta" set:html={t("placementCta")}></a></details><aside class="effort"><h3 data-t="effortTitle" set:html={t("effortTitle")}></h3><p data-t="effortText" set:html={t("effortText")}></p></aside></section>
<section class="section days"><div class="study-layout"><div><div class="kicker" data-t="sprint" set:html={t("sprint")}></div><h2 data-t="three" set:html={t("three")}></h2><div class="day"><span>01</span><span data-t="day1" set:html={t("day1")}></span></div><div class="day"><span>02</span><span data-t="day2" set:html={t("day2")}></span></div><div class="day"><span>03</span><span data-t="day3" set:html={t("day3")}></span></div></div><img class="story-image" src="/images/slovak-study.webp" srcset="/images/slovak-study-480.webp 480w, /images/slovak-study.webp 960w" sizes="(max-width: 700px) calc(100vw - 48px), 440px" width="960" height="640" loading="lazy" decoding="async" data-alt="studyAlt" alt={t("studyAlt")} /></div></section>
<section class="section price" id="pricing"><div class="kicker" data-t="pricing" set:html={t("pricing")}></div><h2 data-t="start" set:html={t("start")}></h2><p class="pricing-lead" data-t="pricingLead" set:html={t("pricingLead")}></p><div class="pricing-grid"><div class="pricing-explanation"><div><span>01</span><h3 data-t="priceFreeTitle" set:html={t("priceFreeTitle")}></h3><p data-t="priceFreeText" set:html={t("priceFreeText")}></p></div><div><span>02</span><h3 data-t="priceTrialTitle" set:html={t("priceTrialTitle")}></h3><p data-t="priceTrialText" set:html={t("priceTrialText")}></p></div></div><div class="price-offer"><div class="card"><div class="tag" data-t="main" set:html={t("main")}></div><div class="amount">€3 <small data-t="monthly" set:html={t("monthly")}></small></div><ul><li data-t="all" set:html={t("all")}></li><li data-t="audio" set:html={t("audio")}></li><li data-t="cancel" set:html={t("cancel")}></li></ul><a class="cta" href={`https://app.slovakgo.sk/register?lang=${lang}`}><span data-t="trialCta" set:html={t("trialCta")}></span><span>↗</span></a><p class="fine" data-t="card" set:html={t("card")}></p></div><details class="annual"><summary data-t="annual" set:html={t("annual")}></summary><p data-t="annualDetails" set:html={t("annualDetails")}></p></details><p class="cancel-line" data-t="cancelLine" set:html={t("cancelLine")}></p></div></div></section>
<section class="section faq" id="faq"><div class="faq-heading"><div class="kicker" data-t="faqKicker" set:html={t("faqKicker")}></div><h2 data-t="faqTitle" set:html={t("faqTitle")}></h2></div><div class="faq-list"><details><summary data-t="faqQ0" set:html={t("faqQ0")}></summary><p data-t="faqA0" set:html={t("faqA0")}></p></details><details><summary data-t="faqQ1" set:html={t("faqQ1")}></summary><p data-t="faqA1" set:html={t("faqA1")}></p></details><details><summary data-t="faqQ2" set:html={t("faqQ2")}></summary><p data-t="faqA2" set:html={t("faqA2")}></p></details><details><summary data-t="faqQ3" set:html={t("faqQ3")}></summary><p data-t="faqA3" set:html={t("faqA3")}></p></details><details><summary data-t="faqQ4" set:html={t("faqQ4")}></summary><p data-t="faqA4" set:html={t("faqA4")}></p></details><details><summary data-t="faqQ5" set:html={t("faqQ5")}></summary><p data-t="faqA5" set:html={t("faqA5")}></p></details><details><summary data-t="faqQ6" set:html={t("faqQ6")}></summary><p data-t="faqA6" set:html={t("faqA6")}></p></details><details><summary data-t="faqQ7" set:html={t("faqQ7")}></summary><p data-t="faqA7" set:html={t("faqA7")}></p></details></div></section><section class="section support"><div><h2 data-t="supportTitle" set:html={t("supportTitle")}></h2><p data-t="supportText" set:html={t("supportText")}></p></div><a href="mailto:support@slovakgo.sk" data-t="supportCta" set:html={t("supportCta")}></a></section><footer class="footer"><div class="footer-inner"><h2 data-t="footer" set:html={t("footer")}></h2><p class="footer-note" data-t="footerNote" set:html={t("footerNote")}></p><a class="cta" href={`https://app.slovakgo.sk/register?lang=${lang}`}><span data-t="footerCta" set:html={t("footerCta")}></span><span>↗</span></a><div class="footer-bottom"><span>© 2026 SlovakGO</span><span data-t="footerBrand" set:html={t("footerBrand")}></span><a href="mailto:support@slovakgo.sk">support@slovakgo.sk</a></div></div></footer><div class="sticky"><a class="cta" href={`https://app.slovakgo.sk/register?lang=${lang}`}><span><span data-t="sticky" set:html={t("sticky")}></span><small data-t="stickySmall" set:html={t("stickySmall")}></small></span><span>↗</span></a></div></main></div>

<script>import "../scripts/landing.js";</script>
</body></html>