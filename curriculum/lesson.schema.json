{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slovakgo.local/schema/lesson.schema.json",
  "title": "SlovakGO Universal Lesson",
  "description": "Mandatory import contract for SlovakGO lessons A1-C2. This schema validates the data shape consumed by the application; pedagogical rules live in LESSON_JSON_CONTRACT.md.",
  "type": "object",
  "required": ["lessons"],
  "additionalProperties": false,
  "properties": {
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lesson" }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/localized" }
      ]
    },
    "lesson": {
      "type": "object",
      "required": [
        "id", "sectionId", "level", "title", "topic", "description", "order",
        "xpReward", "estimatedMinutes", "isPublished", "intro", "completionMessage",
        "startScreen", "theoryScreens", "wordsScreen", "words", "exercises",
        "finalSituation", "resultScreen"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "topic": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "order": { "type": "integer", "minimum": 1 },
        "xpReward": { "type": "number", "minimum": 0 },
        "estimatedMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "isPublished": { "type": "boolean" },
        "intro": { "$ref": "#/$defs/localizedText" },
        "completionMessage": { "$ref": "#/$defs/localizedText" },
        "updatedAt": { "type": "string", "minLength": 1 },
        "localization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uiLanguages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "targetLanguage": { "type": "string", "minLength": 1 },
            "fallbackUiLanguage": { "type": "string", "minLength": 1 }
          }
        },
        "assets": { "$ref": "#/$defs/assets" },
        "startScreen": { "$ref": "#/$defs/startScreen" },
        "theoryScreens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/theory" }
        },
        "wordsScreen": { "$ref": "#/$defs/wordsScreen" },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/word" }
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        },
        "finalSituation": { "$ref": "#/$defs/finalSituation" },
        "resultScreen": { "$ref": "#/$defs/resultScreen" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "images": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/imageAsset" }
        },
        "audio": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/audioAsset" }
        }
      }
    },
    "imageAsset": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": true,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "$ref": "#/$defs/localizedText" }
      }
    },
    "audioAsset": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": true,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string" }
      }
    },
    "startScreen": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "screenType": { "type": "string" },
        "imageRef": { "type": "string" },
        "eyebrow": { "$ref": "#/$defs/localizedText" },
        "title": { "$ref": "#/$defs/localizedText" },
        "shortDescription": { "$ref": "#/$defs/localizedText" },
        "subtitle": { "$ref": "#/$defs/localizedText" },
        "goal": { "$ref": "#/$defs/localizedText" },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/localizedText" } },
        "newWords": { "type": "array", "items": { "type": "string" } },
        "exercisesCount": { "type": "integer", "minimum": 0 },
        "reward": { "type": ["string", "number"] },
        "estimatedMinutes": { "type": "number", "minimum": 0 },
        "button": { "type": "string" }
      }
    },
    "theory": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "screenType": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "text": { "$ref": "#/$defs/localizedText" },
        "body": { "$ref": "#/$defs/localizedText" },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "sk": { "type": "string" },
              "uk": { "type": "string" },
              "translation": { "$ref": "#/$defs/localizedText" }
            }
          }
        },
        "exampleSk": { "type": "string" },
        "exampleUk": { "type": "string" },
        "shortRule": { "$ref": "#/$defs/localizedText" },
        "button": { "type": "string" }
      }
    },
    "word": {
      "type": "object",
      "required": ["id", "sk", "uk"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sk": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 },
        "partOfSpeech": { "type": "string" },
        "translation": { "$ref": "#/$defs/localizedText" },
        "pronunciationUk": { "type": "string" },
        "exampleSk": { "type": "string" },
        "exampleUk": { "type": "string" },
        "example": {
          "type": "object",
          "required": ["sk"],
          "additionalProperties": true,
          "properties": {
            "sk": { "type": "string", "minLength": 1 },
            "translation": { "$ref": "#/$defs/localizedText" }
          }
        },
        "level": { "type": "string" },
        "topic": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "wordsScreenItem": {
      "type": "object",
      "required": ["sk", "uk"],
      "additionalProperties": true,
      "properties": {
        "wordId": { "type": "string", "minLength": 1 },
        "sk": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 },
        "pronunciationUk": { "type": "string" },
        "exampleSk": { "type": "string" },
        "exampleUk": { "type": "string" }
      }
    },
    "wordsScreen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenType": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "subtitle": { "$ref": "#/$defs/localizedText" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/wordsScreenItem" }
        },
        "button": { "type": "string" }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "correct"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sk": { "type": "string" },
        "text": { "$ref": "#/$defs/localizedText" },
        "correct": { "type": "boolean" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["id", "lessonId", "type", "order"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lessonId": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "single_choice", "multiple_select", "true_false", "true_false_list",
            "fill_blank", "dropdown_blank", "cloze_text", "word_bank", "drag_to_blank",
            "drag_to_category", "matching", "image_match", "sentence_builder", "sentence_order",
            "dialogue_order", "dialogue_choose_reply", "branching_dialogue", "find_error",
            "correct_error", "transformation", "listen_choice", "listen_true_false", "listen_fill",
            "dictation", "reading_comprehension", "meaning_in_context", "natural_phrase", "tone",
            "register", "hidden_meaning", "collocation", "real_document", "real_message",
            "real_menu", "real_schedule", "multiple_choice_translation", "reverse_translation",
            "match_pairs"
          ]
        },
        "skill": { "type": "array", "items": { "type": "string" } },
        "instruction": { "$ref": "#/$defs/localizedText" },
        "question": { "$ref": "#/$defs/localizedText" },
        "prompt": { "$ref": "#/$defs/localizedText" },
        "options": {
          "type": "array",
          "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/option" }] }
        },
        "correctAnswer": {},
        "acceptedAnswers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "explanation": { "$ref": "#/$defs/localizedText" },
        "hint": { "$ref": "#/$defs/localizedText" },
        "wordIds": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "integer", "minimum": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "button": { "type": "string" },
        "fullSentence": { "type": "string" },
        "text": { "$ref": "#/$defs/localizedText" },
        "statement": { "$ref": "#/$defs/localizedText" },
        "statements": {
          "type": "array",
          "items": { "type": "object", "required": ["sk", "correct"], "additionalProperties": true, "properties": { "sk": { "type": "string" }, "correct": { "type": "boolean" } } }
        },
        "sentence": { "$ref": "#/$defs/localizedText" },
        "sentenceParts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "textParts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "wordBank": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "extraWords": { "type": "array", "items": { "type": "string" } },
        "draggable": { "type": "array", "items": { "type": "string" } },
        "correct": {},
        "categories": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "pairs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "correctSentence": { "type": "string" },
        "correctOrder": { "type": "array", "items": { "type": "string" } },
        "lines": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "dialogue": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "startNode": { "type": "string" },
        "nodes": { "type": "object" },
        "successMessage": { "$ref": "#/$defs/localizedText" },
        "source": { "$ref": "#/$defs/localizedText" },
        "audioRef": { "type": "string" },
        "audioUrl": { "type": "string" },
        "displaySentence": { "$ref": "#/$defs/localizedText" },
        "ignoreCase": { "type": "boolean" },
        "ignoreTerminalPunctuation": { "type": "boolean" },
        "questions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "context": { "$ref": "#/$defs/localizedText" },
        "target": { "$ref": "#/$defs/localizedText" },
        "situation": { "$ref": "#/$defs/localizedText" },
        "phrase": { "$ref": "#/$defs/localizedText" },
        "document": { "type": "object", "additionalProperties": true },
        "message": { "type": "object", "additionalProperties": true },
        "imageRef": { "type": "string" },
        "imageUrl": { "type": "string" },
        "menuData": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "schedule": { "type": "object", "additionalProperties": true },
        "errorToken": { "type": "string" },
        "correctToken": { "type": "string" }
      }
    },
    "finalSituation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["screenType", "scenario", "question", "options", "correctAnswer"],
          "additionalProperties": true,
          "properties": {
            "screenType": { "const": "final_life_situation" },
            "scenario": { "type": "string" },
            "question": { "type": "string" },
            "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
            "correctAnswer": { "type": "string" },
            "translation": { "type": "string" },
            "explanation": { "type": "string" },
            "button": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "steps"],
          "additionalProperties": true,
          "properties": {
            "type": { "const": "interactive_scenario" },
            "title": { "$ref": "#/$defs/localizedText" },
            "description": { "$ref": "#/$defs/localizedText" },
            "imageRef": { "type": "string" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "prompt", "options"],
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string" },
                  "prompt": { "$ref": "#/$defs/localizedText" },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "object", "required": ["correct"], "additionalProperties": true, "properties": { "sk": { "type": "string" }, "text": { "$ref": "#/$defs/localizedText" }, "correct": { "type": "boolean" } } }
                  }
                }
              }
            },
            "passRequirement": { "type": "string" },
            "successMessage": { "$ref": "#/$defs/localizedText" }
          }
        }
      ]
    },
    "resultScreen": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "screenType": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedText" },
        "subtitle": { "$ref": "#/$defs/localizedText" },
        "text": { "$ref": "#/$defs/localizedText" },
        "result": { "type": "string" },
        "newWordsCount": { "type": "integer", "minimum": 0 },
        "exercisesCompleted": { "type": "integer", "minimum": 0 },
        "nowYouKnow": { "type": "array", "items": { "type": "string" } },
        "mistakesMessage": { "$ref": "#/$defs/localizedText" },
        "buttons": { "type": "array", "items": { "type": "string" } },
        "nextLesson": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["id"], "additionalProperties": true }] },
        "xpReward": { "type": "number" },
        "skills": { "type": "array", "items": { "type": "object", "required": ["id", "label", "weight"], "additionalProperties": true, "properties": { "id": { "type": "string" }, "label": { "$ref": "#/$defs/localizedText" }, "weight": { "type": "number", "minimum": 0 } } } }
      }
    }
  }
}