      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Префікси — повторення",
          "text": "Ті самі префікси працюють з усіма дієсловами руху: pri- (до мети), od- (геть), v- (усередину), vy- (назовні, нагору), pre- (через), ob- / o- (довкола), z- (униз), do- (до кінця), za- (кудись). Так само з «bežať»: «vbehnúť, vybehnúť, zbehnúť, prebehnúť, dobehnúť». Минулий час: «vybehol, zbehla, dobehli».",
          "examples": [
            {
              "sk": "Deti vybehli von na sneh.",
              "uk": "Діти вибігли надвір на сніг."
            },
            {
              "sk": "Dobehli sme autobus na poslednú chvíľu.",
              "uk": "Ми встигли на автобус в останню мить."
            }
          ],
          "shortRule": "pri- od- v- vy- pre- ob- z- do- za-",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вид і пари — повторення",
          "text": "Одна дія — доконаний вид («prídem, prinesiem, odveziem»), регулярна — недоконаний («prichádzam, prinášam, odvážam»). Конкретний рух зараз — «ísť, niesť, viezť, bežať»; звично, загалом — «chodiť, nosiť, voziť, behať». Майбутнє: «pôjdem, ponesiem, poveziem», але «budem chodiť». Заборона — недоконаний вид: «Neprechádzajte na červenú!»",
          "examples": [
            {
              "sk": "Neprechádzajte cez koľajnice!",
              "uk": "Не переходьте через колії!"
            },
            {
              "sk": "Každý deň nosím obed z domu.",
              "uk": "Щодня ношу обід з дому."
            }
          ],
          "shortRule": "один раз — доконаний · регулярно — недоконаний",
          "commonMistakes": [
            {
              "mistake": "Zajtra budem ísť k lekárovi.",
              "correct": "Zajtra pôjdem k lekárovi."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Напрямок, місце й розповідь — повторення",
          "text": "«Kam?» — do / na / k; «Kde?» — v / na / u; «Odkiaľ?» — z / od. «domov – doma, von – vonku». Маршрут: «cez most, popri rieke, okolo jazera, pozdĺž cesty, smerom na Košice». У розповіді події передаємо доконаним видом, тло — недоконаним: «Keď som bežal na vlak, zazvonil mi telefón.»",
          "examples": [
            {
              "sk": "Keď som bežal na vlak, zazvonil mi telefón.",
              "uk": "Коли я біг на поїзд, задзвонив мій телефон."
            },
            {
              "sk": "Zbehol som dole po schodoch.",
              "uk": "Я збіг униз сходами."
            }
          ],
          "shortRule": "kam – kde – odkiaľ",
          "button": "Далі →"
        }
      ],
