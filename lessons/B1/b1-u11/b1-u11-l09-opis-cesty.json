      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Розповідь про подорож",
          "text": "Події, що йдуть одна за одною, передаємо доконаними дієсловами: «Vyšli sme z domu, prešli sme cez park a o desiatej sme prišli na stanicu.» Тло, на якому щось сталося, — недоконаними: «Keď sme išli cez most, začalo pršať.» Зв’язки: «najprv» (спершу), «potom», «keď» (коли), «cestou» (дорогою), «nakoniec» (нарешті, врешті).",
          "examples": [
            {
              "sk": "Najprv sme išli vlakom do Žiliny a potom autobusom do Terchovej.",
              "uk": "Спершу ми їхали поїздом до Жиліни, а потім автобусом до Терхової."
            },
            {
              "sk": "Keď sme išli cez les, stretli sme srnku.",
              "uk": "Коли ми йшли лісом, ми зустріли сарну."
            }
          ],
          "shortRule": "подія: prišli sme · тло: keď sme išli",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як пояснити дорогу письмово",
          "text": "У листі гостям пишемо формою на «vy»: «Z diaľnice D1 zíďte na výjazde Liptovský Mikuláš.» «Na kruhovom objazde použite druhý výjazd.» «Po dvoch kilometroch odbočte doprava, odbočka je hneď za mostom.» «Posledný úsek je nespevnený, choďte pomaly.» «Auto nechajte na parkovisku a k chate prejdite pešo.»",
          "examples": [
            {
              "sk": "Z diaľnice zíďte na výjazde Liptovský Mikuláš.",
              "uk": "З автомагістралі з’їдьте на виїзді Ліптовський Мікулаш."
            },
            {
              "sk": "Odbočka na chatu je hneď za mostom.",
              "uk": "Поворот до хати одразу за мостом."
            }
          ],
          "shortRule": "zíďte z diaľnice · odbočte · pokračujte",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Час, відстань і проблеми в дорозі",
          "text": "«Cesta trvá asi hodinu.» — Дорога триває приблизно годину (знахідний відмінок!). «Je to desať minút pešo / autom.» «Je to dvadsať kilometrov od Popradu.» Якщо щось пішло не так: «Navigácia nás poslala na poľnú cestu.» «Minuli sme odbočku a museli sme sa vrátiť.» «Šípka ukazovala doľava.»",
          "examples": [
            {
              "sk": "Minuli sme odbočku a museli sme sa vrátiť.",
              "uk": "Ми проминули поворот і мусили повернутися."
            },
            {
              "sk": "Je to asi desať minút pešo od stanice.",
              "uk": "Це приблизно десять хвилин пішки від вокзалу."
            }
          ],
          "shortRule": "trvá + знахідний: hodinu, polhodinu",
          "commonMistakes": [
            {
              "mistake": "Cesta trvá hodina.",
              "correct": "Cesta trvá hodinu."
            }
          ],
          "button": "Далі →"
