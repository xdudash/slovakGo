      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kam? Kde? Odkiaľ?",
          "text": "Дієслова руху відповідають на «kam?» (куди?) і «odkiaľ?» (звідки?), а «byť, bývať, čakať» — на «kde?» (де?). Тому «Kam ideš?», а не «Kde ideš?». Трійки прийменників: «do mesta – v meste – z mesta»; «na poštu – na pošte – z pošty»; «k lekárovi – u lekára – od lekára» — для людей.",
          "examples": [
            {
              "sk": "Kam ideš? – Na poštu.",
              "uk": "Куди йдеш? — На пошту."
            },
            {
              "sk": "Práve idem od lekára.",
              "uk": "Саме йду від лікаря."
            }
          ],
          "shortRule": "do – v – z · na – na – z · k – u – od",
          "commonMistakes": [
            {
              "mistake": "Kde ideš?",
              "correct": "Kam ideš?"
            },
            {
              "mistake": "Idem u lekára.",
              "correct": "Idem k lekárovi."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Прислівники напрямку й місця",
          "text": "Деякі прислівники мають окремі форми для «куди» і «де»: «domov» (додому) – «doma» (удома) – «z domu» (з дому); «von» (надвір) – «vonku» (надворі) – «zvonku» (ззовні); «dnu» (усередину) – «vnútri» (усередині) – «zvnútra» (зсередини). «hore» і «dole» в розмовній мові означають і напрямок, і місце: «Idem hore.» / «Som hore.»",
          "examples": [
            {
              "sk": "Deti sú vonku, choď aj ty von.",
              "uk": "Діти надворі, іди й ти надвір."
            },
            {
              "sk": "Poď dnu, vnútri je teplo.",
              "uk": "Заходь, усередині тепло."
            }
          ],
          "shortRule": "domov – doma · von – vonku · dnu – vnútri",
          "commonMistakes": [
            {
              "mistake": "Idem doma.",
              "correct": "Idem domov."
            },
            {
              "mistake": "Poďme vonku.",
              "correct": "Poďme von."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Якою дорогою?",
          "text": "Шлях описують так: «cez + знахідний» — через: «cez most, cez les»; «popri + місцевий» — повз, уздовж: «popri rieke»; «okolo + родовий» — довкола або повз: «okolo jazera»; «pozdĺž + родовий» — уздовж: «pozdĺž potoka»; «smerom na + знахідний» або «smerom k + давальний» — у напрямку: «smerom na Žilinu», «smerom k stanici». Повернення: «naspäť» або «späť» — назад.",
          "examples": [
            {
              "sk": "Išli sme popri Dunaji až k mostu.",
              "uk": "Ми йшли вздовж Дунаю аж до мосту."
            },
            {
              "sk": "Choďte smerom k stanici.",
              "uk": "Ідіть у напрямку вокзалу."
            }
          ],
          "shortRule": "cez + знахідний · popri + місцевий · okolo, pozdĺž + родовий",
          "button": "Далі →"
        }
      ],
