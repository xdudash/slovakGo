      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Viezť чи voziť?",
          "text": "«viezť» — везти транспортом зараз, в одному напрямку: «Veziem deti do školy.» Форми: «veziem, vezieš, vezie, vezieme, veziete, vezú»; минулий «viezol, viezla»; майбутній «poveziem». «voziť» — возити регулярно: «Každé ráno vozím deti do školy.» Із «sa» — їхати як пасажир: «Veziem sa električkou.» Порівняй: niesť — у руках, viezť — транспортом.",
          "examples": [
            {
              "sk": "Práve vezieme babku k lekárovi.",
              "uk": "Саме веземо бабусю до лікаря."
            },
            {
              "sk": "Otec vozí zeleninu na trh každú sobotu.",
              "uk": "Тато возить овочі на ринок щосуботи."
            }
          ],
          "shortRule": "viezť — зараз · voziť — регулярно",
          "commonMistakes": [
            {
              "mistake": "Každý deň veziem deti do škôlky.",
              "correct": "Každý deň vozím deti do škôlky."
            },
            {
              "mistake": "Vezol ma domov.",
              "correct": "Viezol ma domov."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Префікси з viezť",
          "text": "«priviezť» — привезти: «Kuriér priviezol balík.» «odviezť» — відвезти, забрати геть: «Odvezieš ma na stanicu?» «doviezť» — довезти, доставити: «Tovar vám dovezieme do troch dní.» «zaviezť» — завезти, підвезти кудись: «Zavezieš ma k lekárovi?» «vyviezť» — вивезти або підняти нагору: «Lanovka nás vyviezla na Chopok.» Форми: «priveziem – priviezol», «doveziem – doviezol».",
          "examples": [
            {
              "sk": "Odvezieš ma ráno na stanicu?",
              "uk": "Відвезеш мене вранці на вокзал?"
            },
            {
              "sk": "Tovar vám dovezieme do troch dní.",
              "uk": "Товар ми доставимо вам протягом трьох днів."
            }
          ],
          "shortRule": "pri- — до мети · od- — геть · do- — доставка · za- — кудись · vy- — нагору / назовні",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Priviezť чи priviesť?",
          "text": "Звучать майже однаково, але це різні дієслова. «priviezť» (із «z») — привезти транспортом: «privezie, priviezol». «priviesť» (із «s») — привести пішки, за руку: «privedie, priviedol»: «Priviedol na večierok kamaráta.» Так само «odviezť / odviesť». Недоконані пари для повторюваних дій: «privážať, odvážať, dovážať, vyvážať»: «Firma nám dováža obedy do kancelárie.»",
          "examples": [
            {
              "sk": "Mama priviedla dieťa do škôlky.",
              "uk": "Мама привела дитину до садочка."
            },
            {
              "sk": "Kamión priviezol nový tovar.",
              "uk": "Вантажівка привезла новий товар."
            }
          ],
          "shortRule": "priviezť — привезти · priviesť — привести",
          "commonMistakes": [
            {
              "mistake": "Kamión priviedol tovar.",
              "correct": "Kamión priviezol tovar."
            }
          ],
          "button": "Далі →"
        }
      ],
