      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Нагору й униз",
          "text": "«vyjsť na + знахідний» — піднятися на вершину: «vyjsť na Kriváň, na hrebeň, na chatu». «zísť do + родовий» або «zísť z + родовий» — спуститися: «zísť do doliny, zísť z hrebeňa». Про стежку кажуть «chodník stúpa» (піднімається) і «chodník klesá» (спускається). Іменники: «výstup» — підйом, «zostup» — спуск.",
          "examples": [
            {
              "sk": "Na Kriváň sme vyšli za štyri hodiny.",
              "uk": "На Кривань ми піднялися за чотири години."
            },
            {
              "sk": "Zostup do doliny trvá asi dve hodiny.",
              "uk": "Спуск у долину триває приблизно дві години."
            }
          ],
          "shortRule": "vyjsť na · zísť do / z · stúpať – klesať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Значки й вказівники",
          "text": "Словацькі туристичні стежки позначені кольоровими значками: červená, modrá, zelená, žltá. Кажуть «ísť po červenej značke» — іти за червоним маркуванням. На вказівниках зазвичай пишуть не кілометри, а час ходьби: «Chata pod Rysmi 2:30 h». «Rázcestie» — роздоріжжя, де стежки розходяться. «Sedlo» — перевал між двома вершинами, «hrebeň» — гірський хребет.",
          "examples": [
            {
              "sk": "Na rázcestí pod sedlom odbočíme na modrú značku.",
              "uk": "На роздоріжжі під перевалом звернемо на синє маркування."
            },
            {
              "sk": "Po hrebeni pôjdeme ešte hodinu.",
              "uk": "Хребтом ітимемо ще годину."
            }
          ],
          "shortRule": "ísť po + місцевий: po značke, po hrebeni",
          "commonMistakes": [
            {
              "mistake": "ísť po červená značka",
              "correct": "ísť po červenej značke"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Безпека в горах",
          "text": "Заборони з дієсловами руху — у недоконаному виді: «Neschádzajte z vyznačeného chodníka!» — Не сходьте з маркованої стежки! «Nevychádzajte na hrebeň za búrky!» Порада: «Ak sa zhorší počasie, vráťte sa alebo zíďte do doliny.» Якщо щось пішло не так: «Zišli sme zo značky a zablúdili sme.» Номер Гірської рятувальної служби — 18 300.",
          "examples": [
            {
              "sk": "Neschádzajte z vyznačeného chodníka.",
              "uk": "Не сходьте з маркованої стежки."
            },
            {
              "sk": "Ak sa zhorší počasie, zíďte do doliny.",
              "uk": "Якщо погода погіршиться, спустіться в долину."
            }
          ],
          "shortRule": "заборона: ne- + недоконаний вид: neschádzajte, nevychádzajte",
          "commonMistakes": [
            {
              "mistake": "Nezíďte z chodníka!",
              "correct": "Neschádzajte z chodníka!"
            }
          ],
          "button": "Далі →"
        }
