      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Префікс задає напрямок",
          "text": "Без префікса «ísť» означає «йти» або «їхати» в певному напрямку (недоконаний вид). Префікс додає напрямок і робить дієслово доконаним: «prísť» — прийти, приїхати до мети; «odísť» — піти, поїхати звідкись; «vojsť» — увійти всередину; «vyjsť» — вийти назовні або піднятися нагору. У словацькій ці дієслова вживаються і для ходьби, і для транспорту: «Prišiel autom» — він приїхав автом. Теперішня форма доконаного дієслова означає майбутнє: «prídem» — я прийду.",
          "examples": [
            {
              "sk": "Prídem o piatej.",
              "uk": "Я прийду о п’ятій."
            },
            {
              "sk": "Odišla z práce skôr.",
              "uk": "Вона пішла з роботи раніше."
            }
          ],
          "shortRule": "pri- — до мети · od- — геть · v- — всередину · vy- — назовні / нагору",
          "commonMistakes": [
            {
              "mistake": "Prišol som domov.",
              "correct": "Prišiel som domov."
            },
            {
              "mistake": "Vyjšla z domu.",
              "correct": "Vyšla z domu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Форми, які треба знати",
          "text": "Майбутній час: «prídem, prídeš, príde», «odídem», «vojdem, vojdeš, vojde», «vyjdem, vyjdeš, vyjde». Минулий: «prišiel / prišla», «odišiel / odišla», «vošiel / vošla», «vyšiel / vyšla». Наказовий: «príďte», «odíďte», «vojdite», «vyjdite». Зверни увагу: в інфінітиві «vojsť, vyjsť», а в минулому — «vošiel, vyšiel» без «j».",
          "examples": [
            {
              "sk": "Vošiel som do kancelárie a pozdravil som kolegov.",
              "uk": "Я увійшов до кабінету й привітався з колегами."
            },
            {
              "sk": "Vyjdite na tretie poschodie.",
              "uk": "Підніміться на третій поверх."
            }
          ],
          "shortRule": "vojsť: vojdem – vošiel · vyjsť: vyjdem – vyšiel",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменники й недоконані пари",
          "text": "«vojsť do + родовий»: vojsť do budovy. «vyjsť z + родовий»: vyjsť z domu; «vyjsť na + знахідний» — піднятися: vyjsť na vrchol, na poschodie; «vyjsť von» — вийти надвір. «prísť do / na / k», «odísť z / zo / od». Для повторюваних, звичних дій беремо недоконаний вид: «prichádzať», «odchádzať», «vchádzať», «vychádzať».",
          "examples": [
            {
              "sk": "Do budovy vchádzajte bočným vchodom.",
              "uk": "До будівлі заходьте бічним входом."
            },
            {
              "sk": "Každé ráno vychádzam z domu o šiestej.",
              "uk": "Щоранку я виходжу з дому о шостій."
            }
          ],
          "shortRule": "один раз: prísť · регулярно: prichádzať",
          "button": "Далі →"
        }
      ],
