      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prejsť — через і повз",
          "text": "«prejsť cez + знахідний» — перейти через: «prejsť cez cestu, cez most». Можна й без прийменника: «prejsť most», або з орудним, що позначає шлях: «Prešli sme parkom» — ми пройшли парком. «prejsť okolo / popri» — пройти повз. «prejsť» також означає подолати відстань: «Prešli sme dvadsať kilometrov.» Форми: «prejdem, prešiel, prejdite». Недоконана пара: «prechádzať».",
          "examples": [
            {
              "sk": "Cestu prejdite na priechode pre chodcov.",
              "uk": "Дорогу переходьте по пішохідному переходу."
            },
            {
              "sk": "Cez park prechádzam každý deň.",
              "uk": "Через парк я проходжу щодня."
            }
          ],
          "shortRule": "prejsť cez + знахідний · prejsť + орудний (шлях)",
          "commonMistakes": [
            {
              "mistake": "prejsť cez cesta",
              "correct": "prejsť cez cestu"
            },
            {
              "mistake": "Prejšli sme most.",
              "correct": "Prešli sme most."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Obísť — довкола або в обхід",
          "text": "«obísť + знахідний» без прийменника: обійти довкола («obísť jazero») або обминути перешкоду («obísť stavenisko», «obísť zápchu»). У переносному значенні: «obísť pravidlá» — обійти правила. Форми: «obídem, obišiel, obíďte». Недоконана пара: «obchádzať»; іменник — «obchádzka» (об’їзд).",
          "examples": [
            {
              "sk": "Stavenisko obíďte zľava.",
              "uk": "Будмайданчик обійдіть зліва."
            },
            {
              "sk": "Vodiči obchádzajú zápchu cez dedinu.",
              "uk": "Водії об’їжджають затор через село."
            }
          ],
          "shortRule": "obísť + знахідний (без прийменника)",
          "commonMistakes": [
            {
              "mistake": "obísť okolo jazera",
              "correct": "obísť jazero"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zísť — униз",
          "text": "«zísť» — зійти, спуститися: «zísť z kopca», «zísť dole do pivnice», «zísť do doliny». «zísť z cesty / zo značky» — збитися з дороги, зійти з маркованої стежки. Водії кажуть «zísť z diaľnice» — з’їхати з автомагістралі. Форми: «zídem, zišiel, zíďte». Недоконана пара: «schádzať». Не плутай із «zísť sa» — зустрітися: «Zišli sme sa pred kinom.»",
          "examples": [
            {
              "sk": "Zíďte dole do pivnice.",
              "uk": "Спустіться вниз до підвалу."
            },
            {
              "sk": "Z diaľnice zídeme v Trnave.",
              "uk": "З автомагістралі з’їдемо в Трнаві."
            }
          ],
          "shortRule": "zísť z + родовий · zísť do + родовий",
          "button": "Далі →"
        }
      ],
