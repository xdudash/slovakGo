      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Niesť чи nosiť?",
          "text": "«niesť» — нести зараз, в одному напрямку: «Nesiem kamarátke darček.» Форми: «nesiem, nesieš, nesie, nesieme, nesiete, nesú»; минулий «niesol, niesla, niesli»; майбутній «ponesiem». «nosiť» — носити регулярно або туди-сюди: «Do práce nosím obed z domu.» Також «nosiť» — носити одяг, окуляри: «Nosí okuliare.»",
          "examples": [
            {
              "sk": "Nesiem ti tie knihy, ktoré si chcel.",
              "uk": "Несу тобі ті книжки, які ти хотів."
            },
            {
              "sk": "V lete nosím klobúk.",
              "uk": "Улітку я ношу капелюх."
            }
          ],
          "shortRule": "niesť — зараз, в одному напрямку · nosiť — регулярно, одяг",
          "commonMistakes": [
            {
              "mistake": "Každý deň nesiem obed do práce.",
              "correct": "Každý deň nosím obed do práce."
            },
            {
              "mistake": "Nesol som tašku.",
              "correct": "Niesol som tašku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Префікси з niesť",
          "text": "«priniesť» — принести (до мовця): «Prines mi vodu.» «odniesť» — віднести, забрати геть: «Odnes tie taniere do kuchyne.» «doniesť» — донести; у розмові часто те саме, що «priniesť». «vyniesť» — винести назовні або занести нагору: «vyniesť smeti», «vyniesť kufor na tretie poschodie». «zaniesť» — віднести кудись, до когось: «Zanes ten balík na poštu.» Форми: «prinesiem – priniesol», «odnesiem – odniesol», «vynesiem – vyniesol». Наказовий: «prines, odnes, vynes, zanes».",
          "examples": [
            {
              "sk": "Prines mi, prosím, pohár vody.",
              "uk": "Принеси мені, будь ласка, склянку води."
            },
            {
              "sk": "Kto vynesie smeti?",
              "uk": "Хто винесе сміття?"
            }
          ],
          "shortRule": "pri- — до нас · od- — геть · vy- — назовні / нагору · za- — кудись",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Недоконані пари",
          "text": "Для повторюваних дій беремо форми на «-nášať»: «priniesť → prinášať», «odniesť → odnášať», «vyniesť → vynášať», «zaniesť → zanášať». Заперечний наказ теж зазвичай недоконаний: «Nevynášajte nábytok na chodbu!» — Не виносьте меблі в коридор!",
          "examples": [
            {
              "sk": "U nás smeti vynáša syn.",
              "uk": "У нас сміття виносить син."
            },
            {
              "sk": "Kuriér nám prináša balíky skoro každý deň.",
              "uk": "Кур’єр приносить нам посилки майже щодня."
            }
          ],
          "shortRule": "один раз: vyniesť · регулярно: vynášať",
