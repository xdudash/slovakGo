      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Один рух чи регулярний?",
          "text": "У словацькій, як і в українській, є пари: «ísť – chodiť», «bežať – behať», «letieť – lietať», «niesť – nosiť», «viezť – voziť», «viesť – vodiť». Перше дієслово — конкретний рух в одному напрямку, зараз чи в певний момент: «Práve idem do obchodu.» Друге — повторювано, звично, загалом або туди й назад: «Do posilňovne chodím dvakrát do týždňa.»",
          "examples": [
            {
              "sk": "Práve bežím na autobus.",
              "uk": "Саме біжу на автобус."
            },
            {
              "sk": "Každé ráno behám v parku.",
              "uk": "Щоранку бігаю в парку."
            }
          ],
          "shortRule": "ísť — один конкретний рух · chodiť — регулярно, загалом",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Минулий і майбутній час",
          "text": "Майбутній час визначених дієслів утворюють префіксом «po-»: «pôjdem», «poletím», «pobežím», «ponesiem», «poveziem». Ніколи не кажи «budem ísť»! Невизначені — з «budem»: «budem chodiť», «budem lietať». У минулому «išiel som» — я йшов або їхав (одна дорога, часто як тло): «Keď som išiel domov, stretol som suseda.» «chodil som» — ходив регулярно: «Chodil som do školy v Kyjeve.» Щоб сказати «я сходив кудись і повернувся», вживають «byť»: «Včera som bol v kine.»",
          "examples": [
            {
              "sk": "Zajtra pôjdem do Viedne vlakom.",
              "uk": "Завтра я поїду до Відня поїздом."
            },
            {
              "sk": "Od septembra budem chodiť na kurz.",
              "uk": "З вересня я ходитиму на курс."
            }
          ],
          "shortRule": "pôjdem (не budem ísť) · budem chodiť",
          "commonMistakes": [
            {
              "mistake": "Zajtra budem ísť do mesta.",
              "correct": "Zajtra pôjdem do mesta."
            },
            {
              "mistake": "Včera som išiel v kine.",
              "correct": "Včera som bol v kine."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Особливі значення",
          "text": "«chodiť» — також «уміти ходити»: «Malý už chodí.» «nosiť» — носити одяг: «nosí okuliare». «vodiť» — водити регулярно: «Syna vodím do škôlky.» «viesť» про дорогу — вести: «Tento chodník vedie k jazeru.» «lietať» — літати регулярно або взагалі: «Nerád lietam.» «letieť» — конкретний рейс: «Zajtra letím do Londýna.» «chodievať» — ходити час від часу, бувало: «Ako deti sme chodievali k babke.»",
          "examples": [
            {
              "sk": "Tento chodník vedie k jazeru.",
              "uk": "Ця стежка веде до озера."
            },
            {
              "sk": "Nerád lietam, radšej pôjdem vlakom.",
              "uk": "Не люблю літати, краще поїду поїздом."
            }
          ],
          "shortRule": "chodník vedie · dieťa chodí · nerád lietam",
          "button": "Далі →"
        }
      ],
