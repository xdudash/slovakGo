      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як спитати дорогу",
          "text": "«Prepáčte, ako sa dostanem na stanicu?» — Вибачте, як мені дістатися до вокзалу? Після «dostať sa» — «na / do / k». Також: «Je to ďaleko?», «Ako dlho to trvá pešo?», «Idem dobre na…?» — Чи правильно я йду до…? Відповідь може бути «Je to kúsok.» — Це зовсім близько.",
          "examples": [
            {
              "sk": "Prepáčte, ako sa dostanem k hlavnej stanici?",
              "uk": "Вибачте, як мені дістатися до головного вокзалу?"
            },
            {
              "sk": "Je to odtiaľto ďaleko pešo?",
              "uk": "Це звідси далеко пішки?"
            }
          ],
          "shortRule": "ako sa dostanem na / do / k…?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Наказовий спосіб для пояснення",
          "text": "Дорогу незнайомим пояснюють формою на «vy»: «choďte» (ідіть), «prejdite» (перейдіть), «odbočte» (поверніть), «obíďte» (обійдіть), «zíďte» (спустіться), «vyjdite» (підніміться, вийдіть), «pokračujte» (продовжуйте). Для «ty»: «choď, prejdi, odboč, obíď, zíď, vyjdi».",
          "examples": [
            {
              "sk": "Choďte rovno a na druhej križovatke odbočte doľava.",
              "uk": "Ідіть прямо й на другому перехресті поверніть ліворуч."
            },
            {
              "sk": "Zíďte do podchodu a vyjdite na druhej strane.",
              "uk": "Спустіться в підземний перехід і вийдіть на іншому боці."
            }
          ],
          "shortRule": "choďte · prejdite · obíďte · zíďte · vyjdite",
          "commonMistakes": [
            {
              "mistake": "Idite rovno.",
              "correct": "Choďte rovno."
            },
            {
              "mistake": "Prejďte cez cestu.",
              "correct": "Prejdite cez cestu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Орієнтири та транспорт",
          "text": "Орієнтири: «hneď za rohom» (одразу за рогом), «oproti pošte» (навпроти пошти), «vedľa lekárne», «na konci ulice», «na druhej križovatke». Транспорт: «Choďte električkou číslo štyri a vystúpte na tretej zastávke.» Біля ремонту можна побачити табличку: «Chodci, použite podchod.» — Пішоходи, користуйтеся підземним переходом.",
          "examples": [
            {
              "sk": "Lekáreň je hneď za rohom, oproti pošte.",
              "uk": "Аптека одразу за рогом, навпроти пошти."
            },
            {
              "sk": "Vystúpte na tretej zastávke.",
              "uk": "Вийдіть на третій зупинці."
            }
          ],
          "shortRule": "za rohom · oproti + давальний · vedľa + родовий",
          "button": "Далі →"
        }
