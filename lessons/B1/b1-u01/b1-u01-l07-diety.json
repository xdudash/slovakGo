      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто що не їсть",
          "text": "«Vegetarián / vegetariánka» не їсть м’яса й риби. «Vegán / vegánka» не їсть нічого тваринного: ні молока, ні яєць, ні меду. У меню шукай розділ «bezmäsité jedlá» (страви без м’яса) або позначку «vegánske». Заперечення: «nejem mäso ani ryby».",
          "examples": [
            {
              "sk": "Som vegetariánka, nejem mäso ani ryby.",
              "uk": "Я вегетаріанка, не їм ні м’яса, ні риби."
            },
            {
              "sk": "Brat je vegán, nepije ani kravské mlieko.",
              "uk": "Брат веган, не п’є навіть коров’ячого молока."
            }
          ],
          "shortRule": "vegetarián / vegetariánka · vegán / vegánka",
          "commonMistakes": [
            {
              "mistake": "(жінка) Som vegetarián.",
              "correct": "Som vegetariánka."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дієта і здоров’я",
          "text": "«Držím diétu» — тримаю дієту. «Nesmiem…» — мені не можна: «Nesmiem sladké, mám cukrovku.» «Postím sa» — пощуся (зворотне дієслово, із «sa»!). «Nejem bravčové» — не їм свинини. «Rastlinný» — рослинний, «živočíšny» — тваринного походження: rastlinné mlieko, živočíšny tuk.",
          "examples": [
            {
              "sk": "Lekár mi povedal, že nesmiem jesť slané.",
              "uk": "Лікар сказав, що мені не можна солоного."
            },
            {
              "sk": "Cez pôst nejem mäso.",
              "uk": "Під час посту я не їм м’яса."
            }
          ],
          "shortRule": "nesmiem + інфінітив / знахідний · postiť sa",
          "commonMistakes": [
            {
              "mistake": "Postím.",
              "correct": "Postím sa."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що спитати",
          "text": "Пастка для вегетаріанців — суп: «Je tá polievka varená na mäsovom vývare?» — Чи суп зварений на м’ясному бульйоні? Також: «Je to pripravené na masle, alebo na oleji?», «Máte rastlinné mlieko?», «Dá sa to urobiť bez syra?», «Je v tom živočíšny tuk?»",
          "examples": [
            {
              "sk": "Je v tej omáčke živočíšny tuk?",
              "uk": "Чи є в цьому соусі тваринний жир?"
            },
            {
              "sk": "Máte ovsené alebo sójové mlieko?",
              "uk": "У вас є вівсяне чи соєве молоко?"
            }
          ],
          "shortRule": "na masle × na oleji · rastlinný × živočíšny",
          "button": "Далі →"
        }
      ],
