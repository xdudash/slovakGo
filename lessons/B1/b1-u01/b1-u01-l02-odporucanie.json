      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як попросити пораду",
          "text": "«Čo by ste nám odporučili?» — Що б ви нам порадили? «Čo je vaša špecialita?» — Яка ваша фірмова страва? «Čo je dnes čerstvé?» Якщо вагаєшся: «Neviem sa rozhodnúť medzi… a…» — не можу вибрати між… і… Після «medzi» — орудний відмінок: medzi kačicou a pstruhom.",
          "examples": [
            {
              "sk": "Čo by ste nám odporučili z rýb?",
              "uk": "Що б ви нам порадили з риби?"
            },
            {
              "sk": "Neviem sa rozhodnúť medzi kačicou a pstruhom.",
              "uk": "Не можу вибрати між качкою і фореллю."
            }
          ],
          "shortRule": "Čo by ste odporučili? · medzi + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як порадити",
          "text": "«Určite vyskúšajte…» / «Určite skúste…» — обов’язково спробуйте. Умова: «Ak máte radi pikantné, odporúčam gulášovú polievku.» Думка: «Podľa mňa…», «Myslím si, že…». Тактовне застереження: «Ten rezeň by som vám dnes neodporúčal.» — Цей шніцель я б вам сьогодні не радив.",
          "examples": [
            {
              "sk": "Určite vyskúšajte našu kačicu.",
              "uk": "Обов’язково скуштуйте нашу качку."
            },
            {
              "sk": "Podľa mňa je tu najlepší guláš v meste.",
              "uk": "Як на мене, тут найкращий гуляш у місті."
            }
          ],
          "shortRule": "vyskúšať + знахідний · podľa mňa",
          "commonMistakes": [
            {
              "mistake": "Odporúčam vám kačica.",
              "correct": "Odporúčam vám kačicu."
            },
            {
              "mistake": "medzi kačica a pstruh",
              "correct": "medzi kačicou a pstruhom"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Смак і текстура",
          "text": "Щоб описати страву, мало сказати «dobré». Корисні прикметники: «šťavnatý» (соковитий), «chrumkavý» (хрусткий), «výrazný» (насичений, яскравий смак), «jemný» (ніжний, м’який), «sýty» (ситний), «mastný» (жирний), «suchý» (сухий). Узгоджуй їх з родом іменника: šťavnaté mäso, chrumkavá kôrka, výrazný syr.",
          "examples": [
            {
              "sk": "Mäso je šťavnaté a kôrka chrumkavá.",
              "uk": "М’ясо соковите, а скоринка хрустка."
            },
            {
              "sk": "Fazuľová polievka je veľmi sýta.",
              "uk": "Квасолевий суп дуже ситний."
            }
          ],
          "shortRule": "šťavnatý / šťavnatá / šťavnaté",
          "commonMistakes": [
            {
              "mistake": "šťavnatý mäso",
              "correct": "šťavnaté mäso"
            }
          ],
          "button": "Далі →"
        }
      ],
