      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як забронювати",
          "text": "«Chcel by som si rezervovať stôl na sobotu.» Кількість: «stôl pre + знахідний»: «pre dve osoby», «pre štyri osoby», з п’яти — родовий множини: «pre šesť osôb». День — «na + знахідний»: «na sobotu», час — «o + місцевий»: «o siedmej». Ім’я: «Na aké meno?» — «Na meno Kovalenko.»",
          "examples": [
            {
              "sk": "Chcela by som si rezervovať stôl pre štyri osoby na piatok o siedmej.",
              "uk": "Я хотіла б забронювати столик на чотирьох на п’ятницю на сьому."
            },
            {
              "sk": "Na aké meno to bude?",
              "uk": "На яке ім’я записати?"
            }
          ],
          "shortRule": "stôl pre + число · na + день · o + година",
          "commonMistakes": [
            {
              "mistake": "pre šesť osoby",
              "correct": "pre šesť osôb"
            },
            {
              "mistake": "na sobota",
              "correct": "na sobotu"
            },
            {
              "mistake": "o sedem",
              "correct": "o siedmej"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Де сісти",
          "text": "«Máte voľný stôl na terase?» — на терасі. «Pri okne» — біля вікна. «Salónik» — окрема зала для групи: святкування, корпоративна вечеря. «Počet osôb» — кількість осіб, це поле є в кожній онлайн-формі. За salónik часто просять передоплату — «zálohu».",
          "examples": [
            {
              "sk": "Na oslavu potrebujeme salónik pre dvadsať osôb.",
              "uk": "Для святкування нам потрібна окрема зала на двадцять осіб."
            },
            {
              "sk": "Sedeli by sme radšej pri okne.",
              "uk": "Ми б краще сіли біля вікна."
            }
          ],
          "shortRule": "na terase · v salóniku · pri okne",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Зміни й скасування",
          "text": "«Mohli by sme rezerváciu presunúť na ôsmu?» — перенести на восьму. «Potrebujem zrušiť rezerváciu.» Запізнення: «Budeme asi o dvadsať minút meškať.» Заклад може написати: «Stôl vám podržíme 15 minút» — триматимемо столик 15 хвилин, після цього бронювання скасовують.",
          "examples": [
            {
              "sk": "Prepáčte, budeme asi o dvadsať minút meškať.",
              "uk": "Вибачте, ми, мабуть, запізнимося на двадцять хвилин."
            },
            {
              "sk": "Chcel by som zmeniť počet osôb zo štyroch na šesť.",
              "uk": "Я хотів би змінити кількість осіб з чотирьох на шість."
            }
          ],
          "shortRule": "presunúť na · zrušiť · budeme meškať",
          "button": "Далі →"
        }
      ],
