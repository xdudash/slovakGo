      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Рахунок",
          "text": "Офіціант зазвичай не приносить рахунок сам — треба попросити: «Zaplatím, prosím», «Môžem vás poprosiť o účet?». Він спитає: «Spolu, alebo zvlášť?» — разом чи окремо. «Každý zvlášť» — кожен окремо. «Ja platím za oboch» — я плачу за двох.",
          "examples": [
            {
              "sk": "Zaplatíme, prosím.",
              "uk": "Ми розрахуємося, будь ласка."
            },
            {
              "sk": "Platíme zvlášť, každý za seba.",
              "uk": "Платимо окремо, кожен за себе."
            }
          ],
          "shortRule": "spolu × zvlášť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чайові",
          "text": "«Sprepitné» у Словаччині не обов’язкове, але звичне: у ресторані 5–10 %, у кафе часто просто «zaokrúhlime» — округлюємо. Чайові не кладуть на стіл, а називають офіціантові загальну суму під час оплати: рахунок 27,40 €, даєш 50 € і кажеш «Zoberte si tridsať» — офіціант поверне 20 €, а 2,60 € — чайові. Або: «Zvyšok si nechajte» — решту залиште собі. Карткою: «Zaplatím kartou tridsať aj so sprepitným.»",
          "examples": [
            {
              "sk": "Účet je 18,60 €. Zoberte si dvadsať.",
              "uk": "Рахунок 18,60 €. Візьміть двадцять."
            },
            {
              "sk": "Zvyšok si nechajte, ďakujem.",
              "uk": "Решту залиште собі, дякую."
            }
          ],
          "shortRule": "назви загальну суму разом із чайовими",
          "commonMistakes": [
            {
              "mistake": "Dajte mi výdavok. (коли хочеш лишити чайові)",
              "correct": "Zvyšok si nechajte."
            },
            {
              "mistake": "Vydajte tridsať. (коли хочеш, щоб узяли 30)",
              "correct": "Zoberte si tridsať."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Стравенки й термінал",
          "text": "Багато працівників у Словаччині отримують «stravenky» — талони на харчування, паперові або на стравенковій картці. Запитай: «Beriete stravenky?» Решту зі стравенки зазвичай не повертають, тож різницю доплачують: «Doplatím kartou.» Для картки офіціант приносить «platobný terminál». На чеку бачиш «DPH» — ПДВ.",
          "examples": [
            {
              "sk": "Beriete aj stravenkové karty?",
              "uk": "Ви приймаєте й стравенкові картки?"
            },
            {
              "sk": "Zvyšok doplatím kartou.",
              "uk": "Решту доплачу карткою."
            }
          ],
          "shortRule": "Beriete stravenky? · platiť stravenkou / kartou",
          "button": "Далі →"
        }
      ],
