      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "М’який вступ",
          "text": "Словаки скаржаться стримано. Почни з «Prepáčte, ale…» або «Obávam sa, že…» (Боюся, що…). Далі — факт без емоцій: «Objednal som si pstruha, ale priniesli ste mi lososa.» Уникай вигуків на кшталт «To je hnus!» (Це гидота!) — так звучиш грубо, і тобі менш охоче підуть назустріч.",
          "examples": [
            {
              "sk": "Prepáčte, ale polievka je vlažná.",
              "uk": "Вибачте, але суп ледь теплий."
            },
            {
              "sk": "Obávam sa, že ste nám zabudli priniesť prílohu.",
              "uk": "Боюся, що ви забули принести нам гарнір."
            }
          ],
          "shortRule": "Prepáčte, ale… · Obávam sa, že…",
          "commonMistakes": [
            {
              "mistake": "To je hnus!",
              "correct": "Prepáčte, ale jedlo nie je v poriadku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що може бути не так",
          "text": "«Vlažný» — ледь теплий (суп має бути гарячим), «pripálený» — пригорілий, «nedopečený» — недопечений (м’ясо, тісто), «presolený» — пересолений, «tvrdý» — жорсткий, «Je v tom vlas» — там волосина. Очікування: «Čakáme už štyridsať minút.» Прикметник узгоджуємо з іменником: vlažná polievka, nedopečené mäso.",
          "examples": [
            {
              "sk": "Mäso je nedopečené, vnútri je ešte surové.",
              "uk": "М’ясо недопечене, усередині ще сире."
            },
            {
              "sk": "V šaláte je vlas.",
              "uk": "У салаті волосина."
            }
          ],
          "shortRule": "vlažný · pripálený · nedopečený · presolený",
          "commonMistakes": [
            {
              "mistake": "Polievka je vlažný.",
              "correct": "Polievka je vlažná."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Рішення",
          "text": "Попроси конкретно: «Mohli by ste mi to vymeniť?» (замінити), «Mohli by ste to zohriať?» (підігріти), «Chcel by som hovoriť s vedúcim.» Помилка в рахунку: «Myslím, že je tu chyba, mohli by ste to prepočítať?» Заклад часто вибачається так: «Dezert máte na účet podniku» — десерт за рахунок закладу, тобто безкоштовно.",
          "examples": [
            {
              "sk": "Ospravedlňujeme sa, kávu máte na účet podniku.",
              "uk": "Перепрошуємо, кава за рахунок закладу."
            },
            {
              "sk": "Mohli by ste mi ten rezeň vymeniť?",
              "uk": "Чи могли б ви замінити мені цей шніцель?"
            }
          ],
          "shortRule": "vymeniť · zohriať · na účet podniku",
          "commonMistakes": [
            {
