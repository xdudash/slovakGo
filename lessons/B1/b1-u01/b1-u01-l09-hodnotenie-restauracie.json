      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура відгуку",
          "text": "Хороший відгук відповідає на чотири питання: jedlo (їжа), obsluha (обслуговування), prostredie (обстановка, атмосфера) і cena (ціна). Починають загальним враженням — «celkový dojem» — і закінчують висновком: «Určite sa vrátime», «Vrelo odporúčam» або «Neodporúčam».",
          "examples": [
            {
              "sk": "Celkový dojem je veľmi pozitívny.",
              "uk": "Загальне враження дуже позитивне."
            },
            {
              "sk": "Prostredie je príjemné, ale trochu hlučné.",
              "uk": "Обстановка приємна, але трохи гамірна."
            }
          ],
          "shortRule": "jedlo · obsluha · prostredie · cena",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Оцінні слова",
          "text": "Позитивні: «vynikajúci», «vrelo odporúčam» (щиро раджу), «stojí to za to» (воно того варте). Негативні: «predražený» (з завищеною ціною), «sklamanie» (розчарування), «nepríjemná obsluha», «nič zvláštne» (нічого особливого). Зважай на силу слова: «sklamanie» звучить значно різкіше, ніж «nič zvláštne».",
          "examples": [
            {
              "sk": "Ceny sú na takú kvalitu predražené.",
              "uk": "Як на таку якість, ціни завищені."
            },
            {
              "sk": "Dezert bol veľké sklamanie.",
              "uk": "Десерт був великим розчаруванням."
            }
          ],
          "shortRule": "vrelo odporúčam ↔ neodporúčam",
          "commonMistakes": [
            {
              "mistake": "Ceny sú predražený.",
              "correct": "Ceny sú predražené."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Контраст і баланс",
          "text": "Чесний відгук поєднує плюси й мінуси: «síce…, ale…» (хоч…, але…), «na druhej strane» (з іншого боку), «napriek tomu» (попри це). «Síce» не стоїть на початку речення — воно йде після першого слова чи групи: «Jedlo bolo síce chutné, ale…». Формальна критика м’якша з умовним способом: «Obsluha by mohla byť pozornejšia.»",
          "examples": [
            {
              "sk": "Jedlo bolo síce chutné, ale porcie boli malé.",
              "uk": "Їжа хоч і була смачна, але порції були малі."
            },
            {
              "sk": "Čakali sme dlho, napriek tomu sa vrátime.",
              "uk": "Ми довго чекали, попри це повернемося."
            }
          ],
          "shortRule": "X je síce…, ale… · napriek tomu",
          "commonMistakes": [
            {
              "mistake": "Síce jedlo bolo chutné, ale…",
              "correct": "Jedlo bolo síce chutné, ale…"
            }
          ],
          "button": "Далі →"
        }
