      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від бронювання до замовлення",
          "text": "Бронювання: «stôl pre štyri osoby na sobotu o siedmej, na meno…». Замовлення: «Ako predjedlo si dám…», «namiesto hranoliek ryžu». Порада: «Čo by ste nám odporučili?» Алергени: «Som alergický na orechy. Obsahuje to lepok?» Дієта: «Som vegetariánka, je tá polievka varená na mäsovom vývare?»",
          "examples": [
            {
              "sk": "Chcel by som si rezervovať stôl pre šesť osôb na piatok o siedmej.",
              "uk": "Я хотів би забронювати столик на шістьох на п’ятницю на сьому."
            },
            {
              "sk": "Obsahuje ten dezert orechy?",
              "uk": "Чи містить цей десерт горіхи?"
            }
          ],
          "shortRule": "pre + знахідний · alergický na · namiesto + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Скарга й рахунок",
          "text": "Скарга: «Prepáčte, ale…», «Obávam sa, že mäso je nedopečené. Mohli by ste ho vymeniť?» Рахунок: «Zaplatíme, prosím.» — «Spolu, alebo zvlášť?» Чайові: назви загальну суму («Zoberte si tridsať») або «Zvyšok si nechajte». Стравенки: «Beriete stravenky?»",
          "examples": [
            {
              "sk": "Prepáčte, ale polievka je vlažná.",
              "uk": "Вибачте, але суп ледь теплий."
            },
            {
              "sk": "Zoberte si dvadsaťpäť, zvyšok si nechajte.",
              "uk": "Візьміть двадцять п’ять, решту залиште собі."
            }
          ],
          "shortRule": "Prepáčte, ale… · spolu × zvlášť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Колеги й відгук",
          "text": "З колегами: «Nezájdeme po práci na pivo?», «Dnes vás pozývam» (плачу я), «Pripime si na…!». Відгук: jedlo, obsluha, prostredie, cena; «síce…, ale…», «napriek tomu», «Vrelo odporúčam». Постійного гостя закладу називають «štamgast».",
          "examples": [
            {
              "sk": "Pripime si na úspešnú spoluprácu!",
              "uk": "Вип’ємо за успішну співпрацю!"
            },
            {
              "sk": "Jedlo bolo síce výborné, ale obsluha pomalá.",
              "uk": "Їжа хоч і була чудова, але обслуговування повільне."
            }
          ],
          "shortRule": "pripiť si na · síce…, ale…",
          "button": "Далі →"
        }
      ],
