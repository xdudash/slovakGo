      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Алергени в меню",
          "text": "У Словаччині заклади зобов’язані позначати 14 алергенів ЄС. Біля страви зазвичай стоять числа: «Alergény: 1, 3, 7», а список — унизу меню. Найчастіші: 1 — obilniny obsahujúce lepok (злаки з глютеном), 3 — vajcia, 4 — ryby, 5 — arašidy, 7 — mlieko (і laktóza), 8 — orechy, 9 — zeler (селера), 11 — sezam.",
          "examples": [
            {
              "sk": "Vyprážaný syr – alergény 1, 3, 7.",
              "uk": "Смажений сир — алергени 1, 3, 7."
            },
            {
              "sk": "Zoznam alergénov nájdete na konci jedálneho lístka.",
              "uk": "Список алергенів знайдете в кінці меню."
            }
          ],
          "shortRule": "1 lepok · 3 vajcia · 4 ryby · 7 mlieko · 8 orechy",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як сказати про алергію",
          "text": "«Som alergický / alergická na + знахідний»: «na orechy», «na mlieko». Також: «Mám alergiu na arašidy». Непереносимість: «Mám intoleranciu laktózy». Целіакія: «Mám celiakiu». Обережно з «Neznášam lepok»: дієслово neznášať означає і «не переношу», і «ненавиджу», тож у ресторані краще сказати точно. Про дитину: «Syn je alergický na arašidy.»",
          "examples": [
            {
              "sk": "Som alergická na orechy.",
              "uk": "У мене (ж.) алергія на горіхи."
            },
            {
              "sk": "Dcéra nesmie jesť nič s lepkom.",
              "uk": "Доньці не можна їсти нічого з глютеном."
            }
          ],
          "shortRule": "alergický na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Som alergický pre orechy.",
              "correct": "Som alergický na orechy."
            },
            {
              "mistake": "Dcéra je alergický.",
              "correct": "Dcéra je alergická."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Питання до офіціанта",
          "text": "«Obsahuje to orechy?» — Чи містить це горіхи? «Je to bez lepku?» «Dá sa to pripraviť bez mlieka?» На упаковці чи в меню: «Môže obsahovať stopy orechov» — може містити сліди горіхів (для алергіка це важливо!). «Bezlepkový», «bezlaktózový» — без глютену, без лактози.",
          "examples": [
            {
              "sk": "Obsahuje tá omáčka mlieko?",
              "uk": "Чи є в цьому соусі молоко?"
            },
            {
              "sk": "Máte aj bezlepkové cestoviny?",
              "uk": "У вас є й безглютенові макарони?"
            }
