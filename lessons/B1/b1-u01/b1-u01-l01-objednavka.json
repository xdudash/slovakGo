      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура меню",
          "text": "Меню (jedálny lístok) у словацькому ресторані зазвичай поділене на розділи: «predjedlá» (закуски), «polievky», «hlavné jedlá» або «hlavné chody», «prílohy» (гарніри — їх часто замовляють і оплачують окремо!), «dezerty». Напої — в окремій карті: «nápojový lístok». Замовляючи, кажемо «Dám si…» або ввічливіше «Prosil by som…» / «Prosila by som…». Після «dám si» — знахідний відмінок; losos, pstruh — істоти, тому «lososa», «pstruha».",
          "examples": [
            {
              "sk": "Ako predjedlo si dám paradajkový šalát.",
              "uk": "На закуску я візьму салат із помідорів."
            },
            {
              "sk": "Ako hlavný chod by som si dala lososa so zeleninou.",
              "uk": "Як основну страву я взяла б лосося з овочами."
            }
          ],
          "shortRule": "ako predjedlo / ako hlavný chod si dám + знахідний",
          "commonMistakes": [
            {
              "mistake": "Dám si losos.",
              "correct": "Dám si lososa."
            },
            {
              "mistake": "Ako predjedlo si dám polievka.",
              "correct": "Ako predjedlo si dám polievku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Зміни в страві",
          "text": "На рівні B1 важливо вміти змінити страву під себе. «Namiesto» + родовий — замість: «namiesto hranoliek» (замість картоплі фрі), «namiesto ryže». «Bez» + родовий: «bez cibule», «bez omáčky». Ввічливе питання: «Môžem dostať…?» — Чи можу я отримати…? Офіціант спитає: «Akú prílohu si dáte?» — Який гарнір візьмете?",
          "examples": [
            {
              "sk": "Môžem dostať namiesto hranoliek ryžu?",
              "uk": "Можна мені замість картоплі фрі рис?"
            },
            {
              "sk": "Prosím bez omáčky.",
              "uk": "Будь ласка, без соусу."
            }
          ],
          "shortRule": "namiesto / bez + родовий",
          "commonMistakes": [
            {
              "mistake": "namiesto hranolky",
              "correct": "namiesto hranoliek"
            },
            {
              "mistake": "bez cibuľa",
              "correct": "bez cibule"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Стейк і напої",
          "text": "Офіціант спитає про ступінь просмаження: «Aké prepečenie si želáte?» Варіанти: «krvavý» (з кров’ю), «stredne prepečený» (середній), «dobre prepečený» (добре просмажений). Напої зазвичай замовляють першими: «Čo si dáte na pitie?» — «Zatiaľ len vodu, prosím.» Офіціант питає «Máte už vybrané?» — Ви вже вибрали? Наприкінці: «To je všetko, ďakujem.»",
          "examples": [
            {
              "sk": "Steak stredne prepečený, prosím.",
              "uk": "Стейк середнього просмаження, будь ласка."
            },
            {
              "sk": "Zatiaľ si dáme len minerálku.",
              "uk": "Поки що ми візьмемо лише мінералку."
            }
          ],
          "shortRule": "krvavý → stredne prepečený → dobre prepečený",
          "button": "Далі →"
        }
      ],
