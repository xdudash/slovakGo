      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура відгуку",
          "text": "Корисний відгук починається з досвіду: «Používam ho pol roka.» Далі — «Plusy:», «Mínusy:» і «Záver:» (висновок: кому радиш). Позначка «overený nákup» означає, що автор справді купив товар у цьому магазині. «Kladné hodnotenie» — позитивне, «záporné» — негативне. «Hodnotím kladne» — оцінюю позитивно (прислівник!).",
          "examples": [
            {
              "sk": "Používam ich denne už tri mesiace.",
              "uk": "Я користуюся ними щодня вже три місяці."
            },
            {
              "sk": "Celkovo hodnotím kladne, štyri hviezdičky z piatich.",
              "uk": "Загалом оцінюю позитивно, чотири зірочки з п’яти."
            }
          ],
          "shortRule": "plusy · mínusy · záver",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Опис якості",
          "text": "«Spracovanie» — якість виготовлення: «kvalitné / lacné spracovanie». «Výdrž batérie» — скільки працює батарея: «výdrž až dva dni». Для порівняння — вищий ступінь: tichý → tichší, ľahký → ľahší, dobrý → lepší, zlý → horší. Підсилення: «oveľa» (набагато), а не «viac»: oveľa tichší. Порівняння: «lepší ako» / «lepší než».",
          "examples": [
            {
              "sk": "Spracovanie je kvalitné, nič nevŕzga.",
              "uk": "Якість виготовлення висока, нічого не скрипить."
            },
            {
              "sk": "Výdrž batérie je oveľa lepšia ako pri starom modeli.",
              "uk": "Батарея тримає набагато краще, ніж у старої моделі."
            }
          ],
          "shortRule": "oveľa + вищий ступінь",
          "commonMistakes": [
            {
              "mistake": "oveľa viac tichý",
              "correct": "oveľa tichší"
            },
            {
              "mistake": "Výdrž je lepší.",
              "correct": "Výdrž je lepšia."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перебільшені й фальшиві відгуки",
          "text": "«Prehnaný» — перебільшений. Підозріло, коли всюди лише п’ять зірок, загальні фрази на кшталт «Super produkt, odporúčam všetkým!!!», багато відгуків за один день і немає позначки «overený nákup». Чесний відгук конкретний і згадує й мінуси. Сам пиши без образ — критикуй товар, а не людей.",
          "examples": [
            {
              "sk": "Tá recenzia mi pripadá prehnaná, nič konkrétne v nej nie je.",
              "uk": "Цей відгук здається мені перебільшеним, у ньому нічого конкретного."
            },
            {
              "sk": "Jediné mínus je hlučnosť.",
              "uk": "Єдиний мінус — гучність."
            }
          ],
          "shortRule": "konkrétne = dôveryhodné",
          "button": "Далі →"
        }
      ],
