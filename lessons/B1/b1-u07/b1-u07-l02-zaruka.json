      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Скільки триває гарантія",
          "text": "Для нового товару, який купує споживач, «záručná doba» зазвичай становить 24 місяці від покупки; для вживаних речей її часто можна скоротити до 12 місяців. У новішій редакції закону юридично йдеться про «zodpovednosť za vady» (відповідальність за вади), але в побуті всі кажуть «záruka». Закони змінюються, тому в спірних випадках перевір чинні правила. Запам’ятай прийменники: «záruka na + знахідний» і «byť v záruke».",
          "examples": [
            {
              "sk": "Na práčku máte záruku dvadsaťštyri mesiacov.",
              "uk": "На пральну машину у вас гарантія двадцять чотири місяці."
            },
            {
              "sk": "Telefón je ešte v záruke.",
              "uk": "Телефон ще на гарантії."
            }
          ],
          "shortRule": "záruka na + знахідний · byť v záruke",
          "commonMistakes": [
            {
              "mistake": "záruka pre práčku",
              "correct": "záruka na práčku"
            },
            {
              "mistake": "Je ešte na záruke.",
              "correct": "Je ešte v záruke."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що потрібно мати",
          "text": "«Doklad o kúpe» — будь-який доказ покупки: bloček, faktúra, часто й виписка з рахунку. «Záručný list» (гарантійний талон) зазвичай не обов’язковий, якщо є доказ покупки, але допомагає. Для техніки важливе «sériové číslo» — серійний номер. Порада: фотографуй bločky, бо термопапір із часом вицвітає.",
          "examples": [
            {
              "sk": "Stačí aj výpis z účtu ako doklad o kúpe?",
              "uk": "Чи вистачить і виписки з рахунку як доказу покупки?"
            },
            {
              "sk": "Sériové číslo nájdete na zadnej strane.",
              "uk": "Серійний номер знайдете на задньому боці."
            }
          ],
          "shortRule": "doklad o kúpe (o + місцевий)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що гарантія не покриває",
          "text": "Гарантія стосується «výrobnej vady» (заводського дефекту), а не шкоди, яку завдав сам покупець: «mechanické poškodenie» (удар, падіння), «poškodenie vodou», «neodborná manipulácia» (неправильне поводження), «bežné opotrebenie» (звичайне зношення). «Predĺžená záruka» — додаткова, зазвичай платна гарантія від продавця; перед покупкою уважно читай її умови. Конструкція: «záruka sa (ne)vzťahuje na + знахідний».",
          "examples": [
            {
              "sk": "Záruka sa nevzťahuje na mechanické poškodenie.",
              "uk": "Гарантія не поширюється на механічні пошкодження."
            },
            {
              "sk": "Vada vznikla neodbornou manipuláciou.",
              "uk": "Вада виникла через неправильне поводження."
            }
          ],
          "shortRule": "vzťahovať sa na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Záruka sa nevzťahuje pre poškodenie.",
              "correct": "Záruka sa nevzťahuje na poškodenie."
            }
          ],
          "button": "Далі →"
        }
