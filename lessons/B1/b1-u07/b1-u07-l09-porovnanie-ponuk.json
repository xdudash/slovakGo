      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Параметри й комплектація",
          "text": "«Porovnávač cien» — сайт, що порівнює ціни в різних магазинах. «Parametre» — технічні характеристики: «výkon», «kapacita», «hmotnosť», «rozmery». «Výbava» — комплектація: «Základná výbava neobsahuje nabíjačku.» Порівнюй однакові параметри й однакову комплектацію, інакше «дешевший» товар може виявитися дорожчим.",
          "examples": [
            {
              "sk": "Oba modely majú podobné parametre.",
              "uk": "Обидві моделі мають схожі параметри."
            },
            {
              "sk": "Vo výbave je aj druhá batéria.",
              "uk": "У комплектації є й друга батарея."
            }
          ],
          "shortRule": "parametre · výbava · porovnávač cien",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ціна, що може ввести в оману",
          "text": "«Akciová cena» — акційна ціна; поруч перекреслена «pôvodná cena». Перевір, чи pôvodná cena справді колись була такою. Рахуй загальну ціну: товар + доставка + аксесуари. «Na splátky» — у розстрочку: дивись на «celkovú splatnú sumu» (загальну суму всіх платежів), а не лише на місячний платіж. «Cenovo dostupný» — за доступною ціною. Різниця: «o + знахідний»: o 60 eur viac.",
          "examples": [
            {
              "sk": "Akciová cena platí len do nedele.",
              "uk": "Акційна ціна діє лише до неділі."
            },
            {
              "sk": "Na splátky zaplatíte celkovo o 60 eur viac.",
              "uk": "У розстрочку ви заплатите загалом на 60 євро більше."
            }
          ],
          "shortRule": "o + знахідний: o 60 eur viac / menej",
          "commonMistakes": [
            {
              "mistake": "zaplatíte na 60 eur viac",
              "correct": "zaplatíte o 60 eur viac"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Аргументуємо вибір",
          "text": "«Síce je drahší, ale má dlhšiu záruku.» — Хоч він і дорожчий, але має довшу гарантію. «Oplatí sa viac, pretože…» — вигідніше, тому що… «V porovnaní s + орудний» — у порівнянні з: v porovnaní s druhou ponukou. Найвищий ступінь: výhodný → najvýhodnejší.",
          "examples": [
            {
              "sk": "V porovnaní s druhou ponukou je táto o 30 eur lacnejšia.",
              "uk": "Порівняно з другою пропозицією ця на 30 євро дешевша."
            },
            {
              "sk": "Najviac sa mi oplatí model B.",
              "uk": "Найвигідніша для мене модель B."
            }
          ],
          "shortRule": "v porovnaní s + орудний · síce…, ale…",
          "commonMistakes": [
            {
              "mistake": "v porovnaní s druhá ponuka",
              "correct": "v porovnaní s druhou ponukou"
            }
          ],
          "button": "Далі →"
        }
      ],
