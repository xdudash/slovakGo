      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від вибору до замовлення",
          "text": "Вибір: «porovnávač cien», «parametre», «výbava», «akciová cena», «síce je drahší, ale…». Безпека: «dôveryhodný predajca», а «falošný e-shop» — príliš lacno, iba platba vopred. Замовлення: «skladom», «dodacia lehota», «zľavový kód», «súhlasím s obchodnými podmienkami». Доставка: «oneskorené dodanie», «poškodená zásielka — nepreberiem».",
          "examples": [
            {
              "sk": "Síce je drahší, ale má lepšiu výbavu.",
              "uk": "Хоч він і дорожчий, але має кращу комплектацію."
            },
            {
              "sk": "Objednávka mala prísť v piatok, ale je stále nedoručená.",
              "uk": "Замовлення мало прийти в п’ятницю, але досі не доставлене."
            }
          ],
          "shortRule": "síce…, ale… · súhlasiť s + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Рекламація й гроші",
          "text": "«Chcel(a) by som reklamovať…», опис вади, «reklamačný protokol». Гарантія: «byť v záruke», «doklad o kúpe», «záruka sa nevzťahuje na mechanické poškodenie». Гроші: «Žiadam o vrátenie kúpnej ceny», «primeraná zľava», «dobropis». Права: «predávajúci», «kupujúci», «oprávnená reklamácia», «podnet na inšpekciu».",
          "examples": [
            {
              "sk": "Telefón je ešte v záruke.",
              "uk": "Телефон ще на гарантії."
            },
            {
              "sk": "Keďže sa vada opakuje, žiadam o vrátenie kúpnej ceny.",
              "uk": "Оскільки вада повторюється, я вимагаю повернення вартості покупки."
            }
          ],
          "shortRule": "reklamovať + знахідний · vrátenie + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відгук і чесність",
          "text": "Відгук: досвід, «plusy», «mínusy», «záver», «hodnotím kladne». «Oveľa tichší», «výdrž je lepšia». Якщо магазин поводився «nepoctivo» (нечесно), опиши факти без образ. Імпульсивні покупки («impulzívny nákup») — головна причина повернень, тож перед покупкою зупинись і порівняй.",
          "examples": [
            {
              "sk": "Celkovo hodnotím kladne, ale zákaznícka podpora odpovedá pomaly.",
              "uk": "Загалом оцінюю позитивно, але служба підтримки відповідає повільно."
            },
            {
              "sk": "Bol to impulzívny nákup, dnes by som ho neurobila.",
              "uk": "Це була імпульсивна покупка, сьогодні я б її не зробила."
            }
          ],
          "shortRule": "fakty, nie urážky",
          "button": "Далі →"
        }
