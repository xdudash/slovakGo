      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Способи доставки",
          "text": "«Doprava zdarma» — безкоштовна доставка, часто від певної суми: «pri nákupe nad 50 €». «Osobný odber» — самовивіз із магазину чи складу. «Dodanie» — доставка як результат: «dodanie do troch dní». Магазин «dodá» товар, кур’єр його «doručí».",
          "examples": [
            {
              "sk": "Pri nákupe nad 50 eur je doprava zdarma.",
              "uk": "При покупці понад 50 євро доставка безкоштовна."
            },
            {
              "sk": "Zvolil som osobný odber na predajni.",
              "uk": "Я вибрав самовивіз у магазині."
            }
          ],
          "shortRule": "doprava zdarma · osobný odber",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Запізнення й «доставлено», але немає",
          "text": "«Oneskorené dodanie» — запізніла доставка. Пиши конкретно: «Objednávku som mal(a) dostať do piatku, ale zatiaľ neprišla.» Якщо у відстеженні статус «doručené», а посилки немає: «Zásielka je v systéme ako doručená, ale ja som ju neprevzal(a).» Зазвичай до моменту передачі товару тобі за нього відповідає продавець, тож пиши насамперед магазину, а не лише кур’єрові (деталі — в умовах магазину).",
          "examples": [
            {
              "sk": "Zásielka je stále nedoručená.",
              "uk": "Посилку досі не доставлено."
            },
            {
              "sk": "Podľa sledovania je balík doručený, ale neprevzala som ho.",
              "uk": "За відстеженням посилку доставлено, але я її не отримувала."
            }
          ],
          "shortRule": "mal(a) som dostať · neprevzal(a) som",
          "commonMistakes": [
            {
              "mistake": "Objednávka mal prísť v piatok.",
              "correct": "Objednávka mala prísť v piatok."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перевірка при отриманні",
          "text": "При отриманні огляни коробку. Якщо вона пошкоджена — сфотографуй її, спиши з кур’єром запис про пошкодження або відмовся її прийняти: «Zásielku nepreberiem, je poškodená.» Удома одразу «rozbaľ» посилку й перевір вміст. Не той товар: «Namiesto modrej bundy mi prišla čierna.» Бракує чогось: «chýba nabíjačka» — після chýba стоїть називний відмінок.",
          "examples": [
            {
              "sk": "Krabica bola rozbitá, tak som zásielku neprevzal.",
              "uk": "Коробка була розбита, тож я не прийняв посилку."
            },
            {
              "sk": "Po rozbalení som zistila, že chýba nabíjačka.",
              "uk": "Після розпакування я виявила, що бракує зарядки."
            }
          ],
          "shortRule": "chýba + називний · namiesto + родовий",
