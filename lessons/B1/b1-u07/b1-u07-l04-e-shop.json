      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сторінка товару",
          "text": "«Dostupnosť» показує, чи можна товар швидко отримати: «skladom» — є на складі, відправлять швидко; «skladom u dodávateľa» — у постачальника, чекати довше; «na objednávku» — під замовлення; «vypredané» — розпродано. «Dodacia lehota» — строк доставки: «Dodacia lehota 3 – 5 pracovných dní.»",
          "examples": [
            {
              "sk": "Tovar je skladom, odosielame ešte dnes.",
              "uk": "Товар є на складі, відправляємо ще сьогодні."
            },
            {
              "sk": "Dodacia lehota je dva týždne.",
              "uk": "Строк доставки — два тижні."
            }
          ],
          "shortRule": "skladom · na objednávku · vypredané",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Оформлення замовлення",
          "text": "Звичайні кроки: «vložiť do košíka» → «zadať zľavový kód» → «zvoliť spôsob dopravy a platby» → «súhlasím s obchodnými podmienkami» → кнопка «Objednať s povinnosťou platby» (натискаючи її, ти зобов’язуєшся заплатити). Потім приходить «potvrdenie objednávky» e-mailom — перевір у ньому суму, адресу й кількість. «Súhlasiť s + орудний»: súhlasím s podmienkami.",
          "examples": [
            {
              "sk": "Zľavový kód zadajte v košíku.",
              "uk": "Код знижки введіть у кошику."
            },
            {
              "sk": "Potvrdenie objednávky sme vám poslali e-mailom.",
              "uk": "Підтвердження замовлення ми надіслали вам електронною поштою."
            }
          ],
          "shortRule": "vložiť do košíka · zadať kód · súhlasiť s + орудний",
          "commonMistakes": [
