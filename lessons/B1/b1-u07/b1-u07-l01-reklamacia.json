      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Рекламація чи скарга?",
          "text": "«Reklamácia» — це вимога через ваду (vada) товару: річ зламалася, не працює, має дефект. Це твоє право, а не прохання. «Sťažnosť» — скарга на обслуговування чи поведінку персоналу, це інше. Дієслово «reklamovať» поєднується прямо зі знахідним відмінком, без прийменника: reklamovať kanvicu, reklamovať slúchadlá.",
          "examples": [
            {
              "sk": "Chcel by som reklamovať túto kanvicu.",
              "uk": "Я хотів би подати рекламацію на цей чайник."
            },
            {
              "sk": "Výrobok má vadu, nedá sa zapnúť.",
              "uk": "Виріб має ваду, його не можна ввімкнути."
            }
          ],
          "shortRule": "reklamovať + знахідний (без прийменника)",
          "commonMistakes": [
            {
              "mistake": "Chcem reklamáciu slúchadlá.",
              "correct": "Chcem reklamovať slúchadlá."
            },
            {
              "mistake": "reklamovať na kanvicu",
              "correct": "reklamovať kanvicu"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як описати ваду",
          "text": "Опиши факт і коли він з’явився — без емоцій і перебільшень. Корисні фрази: «nefunguje», «nezapne sa», «nenabíja sa», «praskol displej», «odlepila sa podrážka», «párajú sa švy». «Prestať + інфінітив» — перестати щось робити: prestal sa zapínať. Прикметник «nefunkčný» — непрацюючий, несправний.",
          "examples": [
            {
              "sk": "Mixér sa po mesiaci prestal zapínať.",
              "uk": "Блендер через місяць перестав вмикатися."
            },
            {
              "sk": "Na topánkach sa odlepila podrážka.",
              "uk": "На черевиках відклеїлася підошва."
            }
          ],
          "shortRule": "prestať + інфінітив · коли + що сталося",
          "commonMistakes": [
            {
              "mistake": "prestal zapína",
              "correct": "prestal zapínať"
            },
            {
              "mistake": "Telefón sa nenabíjať.",
              "correct": "Telefón sa nenabíja."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Протокол і що далі",
          "text": "Коли ти «uplatníš reklamáciu» (подаєш рекламацію), продавець має видати підтвердження — «reklamačný protokol». Збережи його! Там є дата, опис вади й твоя вимога. Часто товар відправляють «do servisu na posúdenie» (у сервіс на оцінку). Рекламацію зазвичай мають vybaviť без зволікань, найпізніше протягом 30 днів — точні строки перевір у чинних правилах. Можливий результат: oprava, výmena, zľava або vrátenie peňazí.",
          "examples": [
            {
              "sk": "Tovar pošleme do servisu na posúdenie.",
              "uk": "Товар відправимо в сервіс на оцінку."
            },
            {
              "sk": "Reklamačný protokol si dobre uschovajte.",
              "uk": "Добре збережіть протокол рекламації."
            }
          ],
          "shortRule": "uplatniť reklamáciu → protokol → servis → vybavenie",
          "button": "Далі →"
        }
      ],
