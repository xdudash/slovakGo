      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ознаки фальшивого магазину",
          "text": "«Falošný e-shop» часто має підозріло низькі ціни, лише оплату наперед на рахунок, жодних контактів, IČO чи адреси, помилки в словацькій і назву, схожу на відомий магазин. Перевір, чи продавець «dôveryhodný» (надійний): відгуки на незалежних сайтах, реєстр фірм, реальна адреса. «Príliš» — надто: príliš lacné, príliš dobré na to, aby to bola pravda.",
          "examples": [
            {
              "sk": "Ceny boli podozrivo nízke.",
              "uk": "Ціни були підозріло низькі."
            },
            {
              "sk": "Na stránke chýbalo IČO aj adresa.",
              "uk": "На сторінці не було ні IČO, ні адреси."
            }
          ],
          "shortRule": "príliš lacné = varovanie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "SMS і «покупці»",
          "text": "Шахрай часто «sa vydáva za» (видає себе за) кур’єра, банк чи покупця. Типові схеми: SMS нібито від кур’єра з посиланням «doplaťte 1,50 € za doručenie»; «покупець» з онлайн-базару надсилає посилання, щоб ти «отримав(ла) гроші», а там просять дані картки. Мета — «vylákať» (виманити) «prihlasovacie údaje» до інтернет-банкінгу або дані картки. Банк, пошта й кур’єр не просять PIN чи код з SMS. Зверни увагу: у словацькій «nikdy» вимагає заперечення в дієслові: nikdy neposielajte.",
          "examples": [
            {
              "sk": "Podvodník sa mi snažil vylákať údaje z karty.",
              "uk": "Шахрай намагався виманити в мене дані картки."
            },
            {
              "sk": "Nikdy nikomu neposielajte kód z SMS.",
              "uk": "Ніколи нікому не надсилайте код із SMS."
            }
          ],
          "shortRule": "nikdy + заперечене дієслово",
          "commonMistakes": [
            {
              "mistake": "Nikdy nikomu posielajte kód.",
              "correct": "Nikdy nikomu neposielajte kód."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Якщо вже трапилося",
          "text": "Дій швидко: заблокуй картку (у застосунку банку або телефоном), зателефонуй у банк на офіційний номер, зміни heslo, повідом про шахрайство поліцію. Опиши факти: «Klikol som na odkaz v SMS a zadal som údaje z karty. Potom mi z účtu odišlo 200 eur.» Банки часто розсилають «varovanie pred podvodmi» — попередження про шахрайство. «Varovanie pred + орудний».",
          "examples": [
            {
              "sk": "Okamžite som si zablokovala kartu.",
              "uk": "Я негайно заблокувала свою картку."
            },
            {
              "sk": "Banka posiela varovanie pred novým typom podvodu.",
              "uk": "Банк розсилає попередження про новий вид шахрайства."
            }
          ],
          "shortRule": "varovanie pred + орудний",
          "commonMistakes": [
            {
              "mistake": "varovanie pred podvody",
              "correct": "varovanie pred podvodmi"
            }
          ],
          "button": "Далі →"
        }
      ],
