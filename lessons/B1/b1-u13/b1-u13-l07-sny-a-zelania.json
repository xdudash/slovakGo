      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Keby tak…! Kiežby…!",
          "text": "Бажання, яке зараз не здійснюється: «Keby som tak mal viac času!» — Ех, якби я мав більше часу! «Keby aspoň nepršalo!» — Якби хоч не йшов дощ! «Kiežby» — якби ж то: «Kiežby to vyšlo!» Після цих слів — l-форма, а клітики стоять одразу за ними: «Kiežby som mal pravdu.»",
          "examples": [
            {
              "sk": "Keby tak bolo leto!",
              "uk": "Ех, якби було літо!"
            },
            {
              "sk": "Kiežby sme sa čoskoro videli!",
              "uk": "Якби ж то ми скоро побачилися!"
            }
          ],
          "shortRule": "keby tak / keby aspoň / kiežby + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Bol by som rád, keby…",
          "text": "Бажання щодо іншої людини: «Bol by som rád, keby ste prišli.» — Я був би радий, якби ви прийшли. Жінка: «Bola by som rada, keby…». Це й дуже ввічливе прохання: «Bola by som rada, keby ste mi poslali odpoveď do piatka.»",
          "examples": [
            {
              "sk": "Bol by som rád, keby si prišiel aj ty.",
              "uk": "Я був би радий, якби й ти прийшов."
            },
            {
              "sk": "Boli by sme radi, keby ste nás navštívili.",
              "uk": "Ми були б раді, якби ви нас відвідали."
            }
          ],
          "shortRule": "bol by som rád, keby + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Chcel by som, aby…",
          "text": "Коли бажання стосується іншої особи — «aby» + l-форма: «Chcem, aby si prišiel.» — Хочу, щоб ти прийшов. Клітики приєднуються до aby: aby som, aby si, aby sme, aby ste. Якщо людина та сама — інфінітив: «Chcem prísť» (не «Chcem, aby som prišiel»). «Mojím snom je…» — моя мрія — це…; «sen sa mi splnil» — моя мрія здійснилася.",
          "examples": [
            {
              "sk": "Chcela by som, aby deti hovorili plynule po slovensky.",
              "uk": "Я хотіла б, щоб діти вільно говорили словацькою."
            },
            {
              "sk": "Môj sen sa konečne splnil.",
              "uk": "Моя мрія нарешті здійснилася."
            }
          ],
          "shortRule": "chcieť, aby + l-форма (інша особа)",
          "commonMistakes": [
            {
              "mistake": "Chcem, aby si prídeš.",
              "correct": "Chcem, aby si prišiel."
            },
            {
              "mistake": "Chcem, aby som prišiel.",
              "correct": "Chcem prísť."
            }
          ],
          "button": "Далі →"
        }
      ],
