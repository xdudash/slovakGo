      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Keď, ak, keby",
          "text": "«Keď» — коли (напевно), «ak» — якщо (можливо), «ak by» — якщо раптом (малоймовірно, офіційно), «keby» — якби (уявно). Після ak і keď про майбутнє — майбутній час: «Ak budeš mať čas…», «Len čo prídem…». Після keby — l-форма в обох частинах: «Keby som mal čas, išiel by som.»",
          "examples": [
            {
              "sk": "Keď prídem domov, zavolám ti.",
              "uk": "Коли прийду додому, зателефоную тобі."
            },
            {
              "sk": "Keby som mal čas, išiel by som s vami.",
              "uk": "Якби я мав час, я пішов би з вами."
            }
          ],
          "shortRule": "keď → ak → ak by → keby",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kondicionál: тепер і тоді",
          "text": "Теперішній: «keby som mal…, kúpil by som si…». Минулий: «keby som bol vedel…, bol by som prišiel». Порядок клітик: by → som → sa/si → mi → to: «Keby si mi to bol povedal, bol by som ti pomohol.» Змішаний: «Keby som sa vtedy neučil, dnes by som nemal túto prácu.»",
          "examples": [
            {
              "sk": "Keby si mi to bol povedal, bol by som ti pomohol.",
              "uk": "Якби ти мені це сказав, я б тобі допоміг."
            },
            {
              "sk": "Keby som sa vtedy neučil, dnes by som nemal túto prácu.",
              "uk": "Якби я тоді не вчився, сьогодні я не мав би цієї роботи."
            }
          ],
          "shortRule": "bol by som + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Поради, мрії, договори",
          "text": "Поради: «Na tvojom mieste by som…», «Bolo by lepšie, keby…», «Čo keby sme…?». Мрії: «Keby tak…!», «Kiežby…», «Bol by som rád, keby…», «Chcel by som, aby…». Договори: «v prípade, že», «za predpokladu, že», «v opačnom prípade». Гіпотези: «Čo by sa stalo, keby…?», «nebyť + родовий».",
          "examples": [
            {
              "sk": "Bola by som rada, keby ste prišli.",
              "uk": "Я була б рада, якби ви прийшли."
            },
            {
              "sk": "V opačnom prípade vám budeme účtovať poplatok.",
              "uk": "В іншому разі ми нарахуємо вам збір."
            }
          ],
          "shortRule": "aby / keby + l-форма",
          "button": "Далі →"
        }
      ],
