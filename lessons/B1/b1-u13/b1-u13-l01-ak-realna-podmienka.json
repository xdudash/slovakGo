      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ak + майбутнє",
          "text": "«Ak» — якщо: умова реальна, вона може справдитися. Як і в українській, в умові вживаємо майбутній час: «Ak budem mať čas, prídem.» Доконані дієслова в теперішній формі вже означають майбутнє: «Ak to stihnem, zavolám ti.» Тому «budem stihnúť» чи «budem prísť» — помилка. Для звичок і загальних правил — теперішній час: «Ak prší, chodím do práce autobusom.»",
          "examples": [
            {
              "sk": "Ak budeš mať otázky, napíš mi.",
              "uk": "Якщо матимеш запитання, напиши мені."
            },
            {
              "sk": "Ak to dnes nestihnem, dokončím to zajtra.",
              "uk": "Якщо я не встигну цього сьогодні, закінчу завтра."
            }
          ],
          "shortRule": "ak + budem + недоконаний · ak + доконаний вид (stihnem, prídem)",
          "commonMistakes": [
            {
              "mistake": "Ak budem prísť, zavolám.",
              "correct": "Ak prídem, zavolám."
            },
            {
              "mistake": "Ak budem stihnúť…",
              "correct": "Ak stihnem…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Головна частина",
          "text": "Після умови кажемо, що станеться або що треба зробити: майбутній час («…, prídem»), наказовий спосіб («…, zavolaj mi»), модальні дієслова («…, môžeš odísť skôr»). Частини можна поміняти місцями: «Zavolaj mi, ak budeš meškať.» Кома між частинами ставиться завжди. Коротка заперечна умова — «ak nie»: «Prídeš? Ak nie, daj mi vedieť.»",
          "examples": [
            {
              "sk": "Ak budeš meškať, zavolaj mi.",
              "uk": "Якщо запізнюватимешся, зателефонуй мені."
            },
            {
              "sk": "Môžeš odísť skôr, ak máš všetko hotové.",
              "uk": "Можеш піти раніше, якщо в тебе все готово."
            }
          ],
          "shortRule": "ak…, + наказовий / майбутній · кома завжди",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pokiaľ, v prípade, že",
          "text": "Синоніми до «ak»: «pokiaľ» — трохи офіційніше: «Pokiaľ máte záujem, ozvite sa.» (Але «pokiaľ viem» — наскільки я знаю.) «V prípade, že…» — у разі, якщо: типово для листів, інструкцій, правил. Короткі формули: «ak sa dá» — якщо можна, якщо вийде; «ak treba» — якщо треба; «prípadne» — або ж, за потреби.",
          "examples": [
            {
              "sk": "V prípade, že sa nemôžete zúčastniť, oznámte nám to.",
              "uk": "У разі, якщо не можете взяти участь, повідомте нам."
            },
            {
              "sk": "Príďte v utorok, prípadne v stredu.",
              "uk": "Приходьте у вівторок або ж у середу."
            }
          ],
          "shortRule": "pokiaľ · v prípade, že · prípadne",
          "button": "Далі →"
        }
      ],
