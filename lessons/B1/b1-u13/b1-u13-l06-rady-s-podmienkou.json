      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Тактовна порада",
          "text": "Найм’якша порада — через уявну ситуацію: «Keby som bol na tvojom mieste, zavolal by som tam.» Коротше: «Na tvojom mieste by som…». Безособово: «Bolo by lepšie, keby si…» + l-форма; «Bolo by rozumné…» + інфінітив. «Rozhodne» — однозначно: «Rozhodne by som to skúsil.»",
          "examples": [
            {
              "sk": "Bolo by lepšie, keby si išiel k lekárovi.",
              "uk": "Було б краще, якби ти пішов до лікаря."
            },
            {
              "sk": "Na vašom mieste by som si zmluvu najprv dal skontrolovať.",
              "uk": "На вашому місці я б спершу дав перевірити договір."
            }
          ],
          "shortRule": "bolo by lepšie, keby + l-форма",
          "commonMistakes": [
            {
              "mistake": "Keby som bol ty…",
              "correct": "Keby som bol na tvojom mieste…"
            },
            {
              "mistake": "Čo keby sme ideme…?",
              "correct": "Čo keby sme išli…?"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пропозиції",
          "text": "«Čo keby…?» + l-форма — а що, якби…? Це дружня пропозиція: «Čo keby sme išli autom?» «Nebolo by od veci…» + інфінітив — було б непогано (розмовне): «Nebolo by od veci zavolať im vopred.» «Pre istotu» — про всяк випадок: «Pre istotu si zober aj dáždnik.»",
          "examples": [
            {
              "sk": "Čo keby si sa opýtal kolegu?",
              "uk": "А що, якби ти спитав колегу?"
            },
            {
              "sk": "Pre istotu si urob kópiu zmluvy.",
              "uk": "Про всяк випадок зроби копію договору."
            }
          ],
          "shortRule": "Čo keby sme…? · Nebolo by od veci + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли вже пізно",
          "text": "Коли вже пізно, кажемо «mal si» + інфінітив — тобі слід було: «Mal si mi to povedať.» «Mohol si zavolať» — ти міг зателефонувати. Порівняй: «Mal by si zavolať» — тобі варто зателефонувати (ще не пізно). «Uvážiť» — обдумати, зважити: «Dobre si to uváž.»",
          "examples": [
            {
              "sk": "Mal si si to uvážiť skôr.",
              "uk": "Тобі слід було обдумати це раніше."
            },
            {
              "sk": "Mohla si mi zavolať, prišla by som po teba.",
              "uk": "Ти могла мені зателефонувати, я б по тебе приїхала."
            }
          ],
          "shortRule": "mal by si (ще можна) × mal si (уже пізно)",
          "button": "Далі →"
        }
      ],
