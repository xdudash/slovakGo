      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Keď чи ak?",
          "text": "«Keď» — коли: подія напевно станеться, питання лише в часі: «Keď prídem domov, zavolám ti.» «Ak» — якщо: подія може й не статися: «Ak prídem skôr, zavolám ti.» У розмовній мові «keď» часто вживають і в значенні «якщо»: «Keď nechceš, nemusíš ísť.» У листах і на роботі для умови краще брати «ak».",
          "examples": [
            {
              "sk": "Keď skončím prácu, pôjdem nakúpiť.",
              "uk": "Коли закінчу роботу, піду по покупки."
            },
            {
              "sk": "Ak skončím skôr, pôjdem nakúpiť.",
              "uk": "Якщо закінчу раніше, піду по покупки."
            }
          ],
          "shortRule": "keď — напевно · ak — можливо",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Звички й минуле",
          "text": "Для повторюваних ситуацій — «keď» + теперішній час: «Keď prší, chodím do práce autobusom.» Підсилення: «vždy, keď…», «zakaždým, keď…» — щоразу, коли. У розповіді про минуле «keď» означає лише «коли», ніколи не «якщо»: «Keď sme prišli na Slovensko, nevedeli sme ani slovo.»",
          "examples": [
            {
              "sk": "Zakaždým, keď idem okolo, kúpim si kávu.",
              "uk": "Щоразу, коли проходжу повз, купую собі каву."
            },
            {
              "sk": "Keď som bol malý, býval som u babky.",
              "uk": "Коли я був малим, я жив у бабусі."
            }
          ],
          "shortRule": "zakaždým, keď + теперішній — звичка",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Až, len čo, keď už",
          "text": "«Až» у розмові — коли (в майбутньому, після того як): «Až prídeš, všetko ti vysvetlím.» «Len čo» і «akonáhle» — як тільки: «Len čo dostanem výplatu, zaplatím nájom.» «Keď už» — раз уже: «Keď už si tu, pomôž mi.» Для майбутнього після keď, až, len čo — доконаний вид у теперішній формі або budem + недоконаний.",
          "examples": [
            {
              "sk": "Akonáhle dostanem odpoveď, dám vám vedieť.",
              "uk": "Як тільки отримаю відповідь, дам вам знати."
            },
            {
              "sk": "Keď už ideš do mesta, kúp chlieb.",
              "uk": "Раз уже йдеш у місто, купи хліба."
            }
          ],
          "shortRule": "len čo / akonáhle — як тільки · keď už — раз уже",
          "commonMistakes": [
            {
              "mistake": "Ako iba prídem, zavolám.",
              "correct": "Len čo prídem, zavolám."
            },
            {
              "mistake": "Keď budem prísť…",
              "correct": "Keď prídem…"
            }
          ],
          "button": "Далі →"
        }
      ],
