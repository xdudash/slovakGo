      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Змішані часи",
          "text": "Умова в минулому, наслідок тепер: «Keby som vtedy prijal tú ponuku, dnes by som býval v Prahe.» Умова — постійна риса, наслідок у минулому: «Keby som nebol taký opatrný, bol by som ten byt už kúpil.» Слова «vtedy» (тоді) і «dnes» (сьогодні) допомагають слухачеві зрозуміти, про який час ідеться.",
          "examples": [
            {
              "sk": "Keby som sa vtedy neučil po slovensky, dnes by som nemal túto prácu.",
              "uk": "Якби я тоді не вчив словацьку, сьогодні я не мав би цієї роботи."
            },
            {
              "sk": "Keby som nebol taký opatrný, bol by som ten byt už kúpil.",
              "uk": "Якби я не був такий обережний, я б уже купив ту квартиру."
            }
          ],
          "shortRule": "vtedy (минуле) + dnes (теперішнє)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Обговорення гіпотез",
          "text": "Питання: «Čo by sa stalo, keby…?», «Ako by to dopadlo, keby…?» — чим би це закінчилося? Припущення: «Asi by…», «Pravdepodobne by…», «Kto vie, či by…» — хтозна, чи… «Hypotéza» — припущення, яке ще треба перевірити; «dôsledok» — наслідок.",
          "examples": [
            {
              "sk": "Ako by to dopadlo, keby sme neprišli?",
              "uk": "Чим би це закінчилося, якби ми не приїхали?"
            },
            {
              "sk": "Kto vie, či by sme sa vôbec stretli.",
              "uk": "Хтозна, чи ми б узагалі зустрілися."
            }
          ],
          "shortRule": "Čo by sa stalo, keby…? · kto vie, či by…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nebyť…",
          "text": "Книжне й дуже словацьке «nebyť» + родовий означає те саме, що «keby nebolo» + родовий: «Nebyť teba, nezvládol by som to.» = «Keby nebolo teba, nezvládol by som to.» Про випадковість і долю: «Asi to bol osud.» — Мабуть, це була доля.",
          "examples": [
            {
              "sk": "Nebyť susedov, nenašli by sme prácu.",
              "uk": "Якби не сусіди, ми б не знайшли роботу."
            },
            {
              "sk": "Nebyť toho autobusu, nikdy by sme sa nestretli.",
              "uk": "Якби не той автобус, ми б ніколи не зустрілися."
            }
          ],
          "shortRule": "nebyť + родовий — якби не…",
          "commonMistakes": [
            {
              "mistake": "Nebyť susedia…",
              "correct": "Nebyť susedov…"
            },
            {
              "mistake": "Keby som vtedy prijal ponuku, dnes bývam v Prahe.",
              "correct": "…, dnes by som býval v Prahe."
            }
          ],
          "button": "Далі →"
        }
