      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як почати розмову",
          "text": "Із сусідом говори спокійно й без звинувачень. Почни з вибачення: «Prepáčte, že vás ruším, ale…», «Nechcem robiť problémy, ale…». Описуй факт, а не людину: не «Ste hluční», а «Včera do polnoci bolo počuť hudbu». Закінчи пошуком рішення: «Možno by sme sa mohli nejako dohodnúť.»",
          "examples": [
            {
              "sk": "Prepáčte, že vás ruším, ale včera do polnoci bolo počuť hudbu.",
              "uk": "Вибачте, що турбую, але вчора до півночі було чути музику."
            },
            {
              "sk": "Nechcem robiť problémy, ale váš pes šteká celý deň.",
              "uk": "Не хочу створювати проблем, але ваш пес гавкає цілий день."
            }
          ],
          "shortRule": "факт замість звинувачення",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Прохання з «keby»",
          "text": "Найделікатніше прохання — «Bol by som rád / Bola by som rada, keby ste…» + форма на -li: «keby ste stíšili hudbu», «keby ste v nedeľu nevŕtali». Так само: «Bolo by fajn, keby…». Після «keby ste» завжди стоїть форма на -li, навіть коли звертаєшся до однієї людини на «ви».",
          "examples": [
            {
              "sk": "Bol by som rád, keby ste po desiatej stíšili hudbu.",
              "uk": "Я був би радий, якби ви після десятої зробили музику тихіше."
            },
            {
              "sk": "Bola by som rada, keby ste v nedeľu nevŕtali.",
              "uk": "Я була б рада, якби ви в неділю не свердлили."
            }
          ],
          "shortRule": "keby ste + -li",
          "commonMistakes": [
            {
              "mistake": "keby ste stíšite hudbu",
              "correct": "keby ste stíšili hudbu"
            },
            {
              "mistake": "Bol by som rád, keď ste stíšili hudbu.",
              "correct": "Bol by som rád, keby ste stíšili hudbu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Якщо розмова не допомогла",
          "text": "Правила будинку — «domový poriadok» — зазвичай визначають нічний спокій з 22:00 до 6:00, а гучні роботи (vŕtanie, búchanie) дозволяють лише у визначені години. Якщо сусід не реагує, напиши скаргу управителю: «Obraciam sa na Vás so sťažnosťou na opakované rušenie nočného pokoja.» Управитель може сусідові «dohovoriť» — зробити зауваження. Крайній крок — mestská polícia.",
          "examples": [
            {
              "sk": "Obraciam sa na Vás so sťažnosťou na suseda z bytu č. 12.",
              "uk": "Звертаюся до Вас зі скаргою на сусіда з квартири № 12."
            },
            {
              "sk": "Hluk pokračuje aj po desiatej večer.",
              "uk": "Шум триває й після десятої вечора."
            }
          ],
          "shortRule": "rozhovor → sťažnosť správcovi → mestská polícia",
          "button": "Далі →"
        }
      ],
