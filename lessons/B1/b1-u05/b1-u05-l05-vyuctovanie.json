      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як влаштований розрахунок",
          "text": "Протягом року ти щомісяця платиш «zálohové platby» (аванси) — за тепло, воду, ліфт, прибирання. Раз на рік управитель робить «vyúčtovanie»: порівнює аванси зі «skutočnými nákladmi» (фактичними витратами). Якщо ти заплатив(ла) більше — маєш preplatok, і його повернуть; якщо менше — nedoplatok, і його треба доплатити. Орендар отримує розрахунок від власника квартири.",
          "examples": [
            {
              "sk": "Zálohové platby boli vyššie ako skutočné náklady.",
              "uk": "Аванси були вищі за фактичні витрати."
            },
            {
              "sk": "Preplatok vám vrátime do 31. mája.",
              "uk": "Переплату ми вам повернемо до 31 травня."
            }
          ],
          "shortRule": "zálohy − skutočné náklady = preplatok / nedoplatok",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Споживання й показники",
          "text": "«Spotreba» — споживання: «spotreba teplej vody», «spotreba tepla». Показники лічильників знімають під час «odpočtu»: «Odpočet vodomerov bude 15. januára.» Плату за воду в розрахунку часто називають «vodné a stočné» — за подану воду й за каналізацію. Тепло в будинку розподіляють між квартирами за лічильниками на радіаторах — це «rozúčtovanie» (розподіл витрат).",
          "examples": [
            {
              "sk": "Spotreba teplej vody bola 28 m³.",
              "uk": "Споживання гарячої води становило 28 м³."
            },
            {
              "sk": "Odpočet vodomerov bude v piatok ráno.",
              "uk": "Зняття показників водомірів буде в п’ятницю вранці."
            }
          ],
          "shortRule": "spotreba · odpočet · vodné a stočné · rozúčtovanie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Заперечення проти розрахунку",
          "text": "Якщо сума здається неправильною, подай письмове заперечення — «námietku». Формули: «Podávam námietku proti vyúčtovaniu za rok 2025.», «Spotreba teplej vody sa mi zdá neprimerane vysoká.» (несумірно висока), «Žiadam o kontrolu odpočtu.», «Žiadam o predloženie podkladov.» (про надання підтвердних документів). Строк для заперечення зазвичай указано в самому розрахунку.",
          "examples": [
            {
              "sk": "Podávam námietku proti vyúčtovaniu za rok 2025.",
              "uk": "Подаю заперечення проти розрахунку за 2025 рік."
            },
            {
              "sk": "Žiadam o predloženie podkladov k rozúčtovaniu tepla.",
              "uk": "Прошу надати документи щодо розподілу витрат на тепло."
            }
          ],
