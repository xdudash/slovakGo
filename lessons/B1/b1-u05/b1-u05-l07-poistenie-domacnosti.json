      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що страхують",
          "text": "«Poistenie nehnuteľnosti» — страхування самої квартири: стін, підлоги, вікон; його укладає власник. «Poistenie domácnosti» — страхування речей у квартирі: меблів, техніки, одягу; його може укласти й орендар. «Poistenie zodpovednosti» — якщо ти випадково завдав(ла) шкоди іншим, наприклад затопив(ла) сусідів, страхова заплатить за тебе. Часто їх поєднують в одному полісі — «poistke».",
          "examples": [
            {
              "sk": "Ako nájomca si môžem uzavrieť poistenie domácnosti.",
              "uk": "Як орендар я можу укласти страхування домашнього майна."
            },
            {
              "sk": "Poistenie zodpovednosti kryje škody, ktoré spôsobíte susedom.",
              "uk": "Страхування відповідальності покриває шкоду, яку ви заподієте сусідам."
            }
          ],
          "shortRule": "nehnuteľnosť × domácnosť × zodpovednosť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Умови поліса",
          "text": "«Poistná suma» — максимальна сума, яку страхова може виплатити. «Spoluúčasť» — частина шкоди, яку ти платиш сам (франшиза): при spoluúčasti 50 € і шкоді 400 € страхова заплатить 350 €. «Poistné» — скільки платиш ТИ за страхування (щомісяця або раз на рік). «Poistná udalosť» — страховий випадок: пожежа, крадіжка, затоплення. Те, що страхова виплачує ТОБІ, — «poistné plnenie».",
          "examples": [
            {
              "sk": "Spoluúčasť je 50 eur.",
              "uk": "Франшиза становить 50 євро."
            },
            {
              "sk": "Poistné platím raz ročne.",
              "uk": "Страховий внесок я плачу раз на рік."
            }
          ],
          "shortRule": "poistné (платиш ти) × poistné plnenie (платять тобі)",
          "commonMistakes": [
            {
              "mistake": "Poistné plnenie platím každý mesiac.",
              "correct": "Poistné platím každý mesiac."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Питання агентові",
          "text": "«Chcel(a) by som si uzavrieť poistenie domácnosti.» «Na akú sumu by ste mi odporučili poistiť domácnosť?» Корисна конструкція — «vzťahovať sa na» + знахідний (поширюватися на): «Vzťahuje sa poistenie aj na bicykel v pivnici?» А також: «Čo poistenie nekryje?» — Чого страхування не покриває? Нижча spoluúčasť означає вище poistné, і навпаки.",
          "examples": [
