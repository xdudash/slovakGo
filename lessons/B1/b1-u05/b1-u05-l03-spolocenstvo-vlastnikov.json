      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто керує будинком",
          "text": "Квартири в багатоквартирному будинку мають різних власників (vlastníci bytov). Спільне майно — дах, ліфт, під’їзд — утримують або через управительську фірму «správca», або через «spoločenstvo vlastníkov bytov» (SVB) — щось подібне до українського ОСББ. Щомісяця власник платить внесок до «fondu opráv» (повна назва — fond prevádzky, údržby a opráv). Якщо ти орендуєш, цей внесок зазвичай уже враховано в сумі, яку ти платиш власникові.",
          "examples": [
            {
              "sk": "Náš dom spravuje spoločenstvo vlastníkov.",
              "uk": "Нашим будинком управляє спільнота власників."
            },
            {
              "sk": "Z fondu opráv zaplatíme nový výťah.",
              "uk": "З ремонтного фонду ми оплатимо новий ліфт."
            }
          ],
          "shortRule": "správca × spoločenstvo vlastníkov",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Збори й голосування",
          "text": "Важливі рішення ухвалюють на «schôdzi vlastníkov». Голосують «za» (за), «proti» (проти) або «zdržia sa hlasovania» (утримуються). Ухвалене рішення — «uznesenie»: «Uznesenie bolo schválené.» Голосує лише власник квартири, не орендар. Відмінки: «hlasovať za návrh» (за + знахідний), «hlasovať proti návrhu» (proti + давальний).",
          "examples": [
            {
              "sk": "Väčšina vlastníkov hlasovala za zateplenie.",
              "uk": "Більшість власників проголосувала за утеплення."
            },
            {
              "sk": "Dvaja sa zdržali hlasovania.",
              "uk": "Двоє утрималися від голосування."
            }
          ],
          "shortRule": "za + знахідний · proti + давальний",
          "commonMistakes": [
            {
              "mistake": "hlasovať proti návrh",
              "correct": "hlasovať proti návrhu"
            },
            {
              "mistake": "na schôdza",
              "correct": "na schôdzi"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Офіційний запит управителю",
          "text": "До управителя пишуть формально: «Vážený pán Kováč,» / «Vážená pani Kováčová,». Вступ: «Obraciam sa na Vás so žiadosťou o…» (з проханням про…) або «Chcel(a) by som Vás informovať, že…». У листі займенники Vy, Vás, Vám пишуть з великої літери. Закінчення: «Vopred ďakujem za odpoveď. S pozdravom».",
          "examples": [
            {
              "sk": "Obraciam sa na Vás so žiadosťou o výmenu zámku na vchodových dverách.",
              "uk": "Звертаюся до Вас із проханням про заміну замка на вхідних дверях."
            },
            {
              "sk": "Vopred ďakujem za odpoveď.",
              "uk": "Заздалегідь дякую за відповідь."
            }
          ],
          "shortRule": "so žiadosťou o + знахідний",
          "button": "Далі →"
        }
