            {
              "sk": "Výpovedná lehota začína plynúť prvým dňom nasledujúceho mesiaca.",
              "uk": "Строк попередження починає спливати з першого дня наступного місяця."
            }
          ],
          "shortRule": "Žiadam o… · námietka proti + давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
