      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як розповісти, що сталося",
          "text": "Розповідь про шкоду — у минулому часі, чітко по черзі: «Keď som bol v práci, praskla hadica od práčky.» — «Keď som prišiel domov, voda bola všade.» — «Hneď som zavrel hlavný uzáver.» Дієслово «vytopiť» — затопити когось: «vytopil som suseda» (я затопив сусіда), «vytopili nás» (нас затопили). Пасив: «Náš byt bol vytopený.»",
          "examples": [
            {
              "sk": "Keď sme boli na dovolenke, vytopil nás sused zhora.",
              "uk": "Коли ми були у відпустці, нас затопив сусід згори."
            },
            {
              "sk": "Praskla hadica a voda zatiekla do bytu pod nami.",
              "uk": "Лопнув шланг, і вода затекла до квартири під нами."
            }
          ],
          "shortRule": "keď + минулий час · vytopiť niekoho",
          "commonMistakes": [
            {
              "mistake": "Vytopil som sa suseda.",
              "correct": "Vytopil som suseda."
            },
            {
              "mistake": "Praskol hadica.",
              "correct": "Praskla hadica."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вина й відповідальність",
          "text": "Хто відповідає: «Škodu spôsobil…» (шкоду спричинив), «Za škodu zodpovedá vlastník bytu.» Якщо винен не ти: «Škoda vznikla bez môjho zavinenia.» (не з моєї вини). Потерпілий може вимагати «náhradu škody» — відшкодування збитків. Якщо маєш poistenie zodpovednosti, не плати сам готівкою — передай справу страховій.",
          "examples": [
            {
              "sk": "Škoda vznikla bez môjho zavinenia.",
              "uk": "Шкода виникла не з моєї вини."
            },
            {
              "sk": "Sused žiada náhradu škody 800 eur.",
              "uk": "Сусід вимагає відшкодування збитків у розмірі 800 євро."
            }
          ],
          "shortRule": "bez môjho zavinenia · žiadať náhradu škody",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Заява до страхової",
          "text": "Повідом про «poistnú udalosť» якомога швидше — телефоном, онлайн або в застосунку. Тебе спитають: «Kedy a kde udalosť vznikla?», «Ako ku škode došlo?», «Aký je rozsah škody?» (обсяг). Сфотографуй усе й нічого не викидай до «obhliadky» — огляду на місці. Огляд проводить «likvidátor» — працівник страхової, який оцінює шкоду. При крадіжці потрібен ще й протокол поліції.",
          "examples": [
            {
              "sk": "Škodu som nahlásila hneď na druhý deň.",
              "uk": "Про шкоду я повідомила одразу наступного дня."
            },
            {
              "sk": "Likvidátor príde na obhliadku v pondelok.",
              "uk": "Оцінювач прийде на огляд у понеділок."
            }
          ],
          "shortRule": "fotografie → nahlásenie → obhliadka → plnenie",
          "button": "Далі →"
        }
      ],
