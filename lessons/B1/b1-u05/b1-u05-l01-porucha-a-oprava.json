      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Точний опис несправності",
          "text": "На рівні A2 ти казав(ла) просто «nefunguje». Тепер описуй точно, що сталося. Зворотне дієслово «pokaziť sa» — зламатися, і минулий час узгоджується з родом: «pokazil sa bojler», «pokazila sa práčka», «pokazilo sa svetlo». Корисні дієслова: «nehreje» (не гріє), «netesní» (протікає з’єднання), «tečie» (тече), «iskrí» (іскрить). Під час аварії (praskla rúra) спершу закрий «hlavný uzáver vody» і викликай «havarijnú službu».",
          "examples": [
            {
              "sk": "Pokazil sa bojler, nemáme teplú vodu.",
              "uk": "Зламався бойлер, у нас немає гарячої води."
            },
            {
              "sk": "Radiátor v spálni vôbec nehreje.",
              "uk": "Радіатор у спальні зовсім не гріє."
            }
          ],
          "shortRule": "pokazil sa (ч.) · pokazila sa (ж.) · pokazilo sa (с.)",
          "commonMistakes": [
            {
              "mistake": "Pokazil sa práčka.",
              "correct": "Pokazila sa práčka."
            },
            {
              "mistake": "Radiátor nehrie.",
              "correct": "Radiátor nehreje."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Хто платить за ремонт",
          "text": "За словацьким законом орендар (nájomca) зазвичай сам оплачує «drobné opravy» (дрібні ремонти) й «bežnú údržbu» (звичайне утримання): заміну лампочки, прокладки в крані, прочищення сифона. Більші ремонти — бойлера, радіатора, електропроводки — оплачує власник (prenajímateľ), якщо договір не каже інакше. Якщо поломку спричинив сам орендар, платить він. Про поломку треба повідомити без зайвої затримки.",
          "examples": [
            {
              "sk": "Drobné opravy platí nájomca.",
              "uk": "Дрібні ремонти оплачує орендар."
            },
            {
              "sk": "Výmenu bojlera musí zaplatiť prenajímateľ.",
              "uk": "Заміну бойлера має оплатити власник."
            }
          ],
          "shortRule": "drobné opravy → nájomca · veľké opravy → prenajímateľ",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Формальне повідомлення",
          "text": "Власникові чи управителю краще написати e-mail — так залишиться доказ, коли ти повідомив(ла). Структура: звертання «Dobrý deň, pán Horváth,»; що й коли сталося; прохання «Prosím Vás o bezodkladné odstránenie poruchy.»; коли ти вдома: «Doma som každý deň po 17:00.»; закінчення «Ďakujem a s pozdravom». Ввічливе прохання — з умовним способом: «Mohli by ste poslať technika ešte tento týždeň?»",
          "examples": [
            {
              "sk": "Prosím Vás o bezodkladné odstránenie poruchy.",
