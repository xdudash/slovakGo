      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Пропозиція",
          "text": "Пропонуй м’яко: «Čo keby sme…?» (А що, якби ми…?), «Bolo by možné…?» (Чи можна було б…?), «Navrhujem, aby ste…» — після «aby» стоїть форма на -l / -li: «Navrhujem, aby ste mi znížili nájomné.» Якщо твою пропозицію відхилили, висунь «protinávrh» — зустрічну пропозицію.",
          "examples": [
            {
              "sk": "Navrhujem, aby sme nedoplatok rozdelili na tri splátky.",
              "uk": "Пропоную розділити недоплату на три платежі."
            },
            {
              "sk": "Čo keby sme to rozdelili napoly?",
              "uk": "А що, якби ми розділили це навпіл?"
            }
          ],
          "shortRule": "aby + -l / -li",
          "commonMistakes": [
            {
              "mistake": "Navrhujem, aby ste znížite nájomné.",
              "correct": "Navrhujem, aby ste znížili nájomné."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Умови й поступки",
          "text": "«Súhlasím, ale pod podmienkou, že…» — погоджуюся, але за умови, що… «Môžem vám vyjsť v ústrety, ak…» — можу піти вам назустріч, якщо… Ввічлива, але тверда відмова: «To je pre mňa, žiaľ, neprijateľné.» Людину, яка охоче йде на поступки, називають «ústretový»: «Majiteľ bol veľmi ústretový.»",
          "examples": [
            {
              "sk": "Súhlasím, ale pod podmienkou, že nájomné zaplatíte do pätnásteho.",
              "uk": "Погоджуюся, але за умови, що ви сплатите оренду до п’ятнадцятого."
            },
            {
              "sk": "Môžem vám vyjsť v ústrety, ak podpíšete zmluvu na dva roky.",
              "uk": "Можу піти вам назустріч, якщо підпишете договір на два роки."
            }
          ],
          "shortRule": "pod podmienkou, že… · vyjsť v ústrety",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Закріпи домовленість",
          "text": "Усні домовленості — «ústne dohody» — важко довести. Тому кажи: «Dajme si to písomne.» Борг можна розкласти за «splátkovým kalendárom» — графіком платежів. Зміну орендної плати оформлюють як dodatok k zmluve. Після розмови підсумуй домовленість e-mailом: «Ako sme sa dohodli, …» — Як ми домовилися, …",
          "examples": [
            {
              "sk": "Dajme si to písomne, aby nevznikli nedorozumenia.",
              "uk": "Зафіксуймо це письмово, щоб не виникло непорозумінь."
            },
            {
              "sk": "Ako sme sa dohodli, nedoplatok zaplatím v troch splátkach.",
              "uk": "Як ми домовилися, недоплату я сплачу трьома платежами."
            }
          ],
          "shortRule": "ústne → písomne",
          "button": "Далі →"
        }
      ],
