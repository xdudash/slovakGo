      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Згода",
          "text": "«Súhlasím s tebou» — після «s» стоїть орудний відмінок: «s tebou», «s vami», «s ním», «s vedúcim», «s tým návrhom». Інші формули: «Úplne súhlasím», «Máš pravdu», «Presne tak», «Rovnako to vidím aj ja». Заперечення пишемо разом: «nesúhlasím».",
          "examples": [
            {
              "sk": "Úplne súhlasím s vami.",
              "uk": "Я повністю з вами згоден."
            },
            {
              "sk": "Máš pravdu, mýlil som sa.",
              "uk": "Ти маєш рацію, я помилявся."
            }
          ],
          "shortRule": "súhlasiť s + орудний · máš pravdu",
          "commonMistakes": [
            {
              "mistake": "Súhlasím tebou.",
              "correct": "Súhlasím s tebou."
            },
            {
              "mistake": "Súhlasím ti.",
              "correct": "Súhlasím s tebou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Незгода — чемно",
          "text": "Прямо й різко: «To nie je pravda», «Mýliš sa». Чемніше: «Nesúhlasím s tým, že…», «Bohužiaľ, s tým nemôžem súhlasiť», «Ja to vidím inak». Найкраща схема: визнати чуже й додати власне: «Rozumiem, ale ja to vidím inak.» «Chápem tvoj argument, ale…». Фраза «Mám výhrady» означає «маю застереження» — не відкидаєш усе, а вказуєш на проблему.",
          "examples": [
            {
              "sk": "Rozumiem, ale ja to vidím inak.",
              "uk": "Розумію, але я бачу це інакше."
            },
            {
              "sk": "Mám výhrady k tomuto plánu.",
              "uk": "Я маю застереження до цього плану."
            }
          ],
          "shortRule": "rozumiem, ale… · mám výhrady",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Згода з застереженням",
          "text": "Часто ми погоджуємося лише в чомусь: «Čiastočne súhlasím» — частково погоджуюся, «Do istej miery máš pravdu» — певною мірою ти маєш рацію, «V jednom máš pravdu, ale…». Формула «Pripúšťam, že…» — допускаю, що: «Pripúšťam, že je to drahé, ale oplatí sa to.» Після «pripúšťam» — сполучник «že».",
          "examples": [
            {
              "sk": "Čiastočne s tebou súhlasím, ale mám výhrady.",
              "uk": "Частково я з тобою згоден, але маю застереження."
            },
            {
              "sk": "Pripúšťam, že je to drahé, ale oplatí sa to.",
              "uk": "Допускаю, що це дорого, але воно того варте."
            }
          ],
          "shortRule": "čiastočne · pripúšťam, že…",
          "button": "Далі →"
        }
      ],
