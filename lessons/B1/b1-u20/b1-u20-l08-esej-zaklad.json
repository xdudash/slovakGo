      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура есе",
          "text": "Есе має три частини: «úvod» — вступ (представляємо тему й формулюємо «tézu» — головну думку), основна частина — «jadro» (кожен аргумент — в окремому «odstavci» — абзаці) і «záver» — висновок. Перед написанням складаємо «osnovu» — план. Теза формулюється одним реченням: «V tejto eseji tvrdím, že školné treba zrušiť.»",
          "examples": [
            {
              "sk": "V tejto eseji tvrdím, že školné treba zrušiť.",
              "uk": "У цьому есе я стверджую, що плату за навчання треба скасувати."
            },
            {
              "sk": "Esej sa začína úvodom.",
              "uk": "Есе починається зі вступу."
            }
          ],
          "shortRule": "úvod → téza → odstavce → záver",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Абзаци й зв’язки",
          "text": "Кожен абзац містить одну думку: твердження, причину й приклад. Порядкові слова: «Po prvé…», «Po druhé…», «Po tretie…», додатково: «Okrem toho…», «Navyše…», для завершення: «Napokon…», «Na záver…». Контраст: «Na druhej strane…». Не змінюй послідовність: «Na záver» не вживаємо для першого аргументу.",
          "examples": [
            {
              "sk": "Po prvé, štúdium má byť dostupné pre všetkých.",
              "uk": "По-перше, навчання має бути доступним для всіх."
            },
            {
              "sk": "Okrem toho by sa zlepšila kvalita škôl.",
              "uk": "Крім того, покращилася б якість шкіл."
            }
          ],
          "shortRule": "po prvé · po druhé · okrem toho · napokon",
          "commonMistakes": [
            {
              "mistake": "Po prvý, štúdium má byť dostupné.",
              "correct": "Po prvé, štúdium má byť dostupné."
            },
            {
              "mistake": "V tejto eseji tvrdiť, že…",
              "correct": "V tejto eseji tvrdím, že…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Стиль письма",
          "text": "В есе вживаємо нейтральні й акуратні формули: «Domnievam sa, že…» — вважаю, що…, «Podľa môjho názoru…», «Treba pripomenúť, že…», «V neposlednom rade…» — і не менш важливо. Уникаємо розмовних слів і сленгу. Речення будуємо повністю, без розмовних «no», «fakt», «proste».",
          "examples": [
            {
              "sk": "Domnievam sa, že tento návrh je vhodný.",
              "uk": "Вважаю, що ця пропозиція слушна."
            },
            {
              "sk": "Treba pripomenúť, že náklady sú vysoké.",
              "uk": "Треба нагадати, що витрати високі."
            }
          ],
          "shortRule": "domnievam sa · podľa môjho názoru",
          "button": "Далі →"
        }
      ],
