      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Із чого складається аргумент",
          "text": "Аргумент — це твердження плюс причина: «Som za zavedenie poplatku, pretože sa tým zníži hluk.» Позиція: «Som za» + знахідний («za návrh»), «Som proti» + давальний («proti návrhu», «proti tomu»). «Argument» — це причина, «protiargument» — відповідь на неї. Головний: «Hlavný argument je…», додатковий: «Ďalším argumentom je…».",
          "examples": [
            {
              "sk": "Som proti zavedeniu poplatku, lebo je príliš vysoký.",
              "uk": "Я проти запровадження плати, бо вона надто висока."
            },
            {
              "sk": "Som za tento návrh, lebo je spravodlivý.",
              "uk": "Я за цю пропозицію, бо вона справедлива."
            }
          ],
          "shortRule": "za + знахідний · proti + давальний",
          "commonMistakes": [
            {
              "mistake": "Som proti tento návrh.",
              "correct": "Som proti tomuto návrhu."
            },
            {
              "mistake": "Som proti zavedenie.",
              "correct": "Som proti zavedeniu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дві сторони",
          "text": "Щоб зважити ситуацію, говоримо: «Na jednej strane… na druhej strane…» — з одного боку… з іншого боку: «Na jednej strane je auto pohodlné, na druhej strane je drahé.» Додатковий аргумент у тому ж напрямку: «navyše» — до того ж, «zároveň» — водночас. Контраст: «však» — проте.",
          "examples": [
            {
              "sk": "Na jednej strane je byt lacný, na druhej strane je ďaleko od centra.",
              "uk": "З одного боку квартира дешева, з іншого боку — далеко від центру."
            },
            {
              "sk": "Je to lacné a zároveň kvalitné.",
              "uk": "Це дешево й водночас якісно."
            }
          ],
          "shortRule": "na jednej strane… na druhej strane… · navyše · zároveň",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відповісти на аргумент",
          "text": "На чужий аргумент відповідаємо протиаргументом: «Proti tomu možno namietať, že…» — проти цього можна заперечити, що…; «Treba však dodať, že…» — слід, проте, додати, що…; «Dôležitejšie je, že…» — важливіше те, що… Зважуємо: яка сторона сильніша? Хороший аргумент — не лише думка, а й причина.",
          "examples": [
            {
              "sk": "Proti tomu možno namietať, že je to drahé.",
              "uk": "Проти цього можна заперечити, що це дорого."
            },
            {
              "sk": "Dôležitejšie je, že to šetrí čas.",
              "uk": "Важливіше те, що це заощаджує час."
            }
          ],
          "shortRule": "namietať · treba však dodať",
          "button": "Далі →"
        }
      ],
