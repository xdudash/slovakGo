      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Думка, згода, незгода",
          "text": "Думка: «Podľa mňa…», «Myslím si, že…», «Zdá sa mi, že…». Згода: «Súhlasím s tebou», «Máš pravdu». Часткова: «Čiastočne súhlasím, ale mám výhrady.» Незгода: «Rozumiem, ale ja to vidím inak.» Позиція: «Som za» + знахідний, «Som proti» + давальний. Для письмового й офіційного стилю: «Domnievam sa, že…».",
          "examples": [
            {
              "sk": "Čiastočne s vami súhlasím, ale mám výhrady.",
              "uk": "Частково я з вами згоден, але маю застереження."
            },
            {
              "sk": "Som proti tomuto návrhu.",
              "uk": "Я проти цієї пропозиції."
            }
          ],
          "shortRule": "podľa mňa · súhlasím s + орудний · proti + давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Аргумент: причина, приклад, висновок",
          "text": "Аргумент = твердження + причина + приклад. Причина: «pretože», «keďže». Наслідок: «preto», «teda». Поступка: «hoci», «napriek tomu». Додатково: «navyše», «zároveň», «totiž». Приклад: «napríklad», «z vlastnej skúsenosti», «podľa prieskumu». Висновок: «z toho vyplýva», «celkovo».",
          "examples": [
            {
              "sk": "Hoci je to drahé, oplatí sa to, pretože to šetrí čas.",
              "uk": "Хоча це дорого, воно того варте, бо це заощаджує час."
            },
            {
              "sk": "Z toho vyplýva, že treba konať.",
              "uk": "З цього випливає, що треба діяти."
            }
          ],
          "shortRule": "pretože / preto · hoci / napriek tomu · napríklad",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Рівень B1 загалом",
          "text": "На рівні B1 ти навчився(лася): будувати умови (ak, keby), переказувати чужі слова, розуміти пасив й офіційні тексти, розповідати про минуле й теперішнє, писати листи й будувати складні речення з «ktorý». Умови: «Keby som mal čas, išiel by som.» Компроміс: «Ak ustúpite v termíne, ustúpim aj ja v cene.» Дискусія: «Môžem sa k tomu vyjadriť?» Есе: úvod, téza, argumenty, záver.",
          "examples": [
            {
              "sk": "Keby som mal viac času, napísal by som dlhšiu esej.",
              "uk": "Якби в мене було більше часу, я написав би довше есе."
            },
            {
              "sk": "Dovoľte mi dokončiť myšlienku.",
              "uk": "Дозвольте мені закінчити думку."
            }
          ],
          "shortRule": "B1: думка · аргумент · компроміс · дискусія · есе",
