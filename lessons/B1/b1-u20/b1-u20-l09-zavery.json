      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як починати підсумок",
          "text": "«Na záver by som chcel povedať…» — насамкінець хотів би сказати; «Celkovo možno povedať, že…» — загалом можна сказати, що…; «Dá sa povedať, že…» — можна сказати, що… (м’яко); «Záverom» — на завершення; «Zhrňme to» — підсумуймо. Усе це ставимо в кінці, коли аргументи вже названі.",
          "examples": [
            {
              "sk": "Celkovo možno povedať, že projekt bol úspešný.",
              "uk": "Загалом можна сказати, що проєкт був успішним."
            },
            {
              "sk": "Na záver by som chcel poďakovať kolegom.",
              "uk": "Насамкінець хотів би подякувати колегам."
            }
          ],
          "shortRule": "na záver · celkovo · dá sa povedať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Висновок із аргументів",
          "text": "«Z toho vyplýva, že…» — з цього випливає, що…; «Teda» — отже; «Preto» — тому; «Z týchto dôvodov odporúčam…» — з цих причин рекомендую…; «Odporúčam, aby sme…» + l-форма. Сильніше: «Je zrejmé, že…» — очевидно, що… М’якше: «Dá sa povedať, že…».",
          "examples": [
            {
              "sk": "Z toho vyplýva, že treba konať.",
              "uk": "З цього випливає, що треба діяти."
            },
            {
              "sk": "Z týchto dôvodov odporúčam schváliť návrh.",
              "uk": "З цих причин рекомендую схвалити пропозицію."
            }
          ],
          "shortRule": "z toho vyplýva · odporúčam",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що можна й чого не можна",
          "text": "Хороший висновок: 1) повторює тезу іншими словами, 2) коротко підсумовує аргументи, 3) дає рекомендацію чи завершальну думку. Не додаємо нового аргументу, нового прикладу чи нової теми — це сплутає читача. Висновок короткий: кілька речень.",
          "examples": [
            {
              "sk": "Na záver zhrniem tri hlavné argumenty.",
              "uk": "Насамкінець підсумую три головні аргументи."
            },
            {
              "sk": "Záver je krátky a jasný.",
              "uk": "Висновок короткий і чіткий."
            }
          ],
          "shortRule": "теза іншими словами · підсумок · рекомендація",
