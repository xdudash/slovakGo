      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Слово й черга",
          "text": "Попросити слово: «Môžem sa k tomu vyjadriť?» Додати: «Dovoľte mi doplniť jednu poznámku.» Закінчити думку: «Dovoľte mi dokončiť myšlienku.» «Skočiť do reči» — перебити: «Prepáčte, že vám skáčem do reči.» Після «Dovoľte mi» стоїть інфінітив: «Dovoľte mi doplniť…». Нечемне: «Ticho!», «Nepočúvam ťa.»",
          "examples": [
            {
              "sk": "Môžem sa k tomu vyjadriť?",
              "uk": "Чи можу я висловитися з цього приводу?"
            },
            {
              "sk": "Prepáčte, že vám skáčem do reči.",
              "uk": "Перепрошую, що перебиваю вас."
            }
          ],
          "shortRule": "môžem sa vyjadriť? · dovoľte mi + інфінітив",
          "commonMistakes": [
            {
              "mistake": "Dovoľte mi doplnil.",
              "correct": "Dovoľte mi doplniť."
            },
            {
              "mistake": "Môžem k tomu sa vyjadriť?",
              "correct": "Môžem sa k tomu vyjadriť?"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Реакція на аргумент",
          "text": "«Chápem vašu námietku, ale…» — розумію ваше заперечення, але… «Dobrý postreh.» — слушне спостереження. «Súhlasím s kolegom v tom, že…» — погоджуюся з колегою в тому, що… «K tomu by som dodal…» — до цього я додав би… «Vrátim sa k otázke…» — повернуся до питання… Хто виступає проти — «oponent»: він не ворог, а співрозмовник з іншою думкою.",
          "examples": [
            {
              "sk": "Chápem vašu námietku, ale mám iný názor.",
              "uk": "Розумію ваше заперечення, але в мене інша думка."
            },
            {
              "sk": "Vrátim sa k otázke, ktorú ste položili.",
              "uk": "Повернуся до запитання, яке ви поставили."
            }
          ],
          "shortRule": "chápem námietku, ale… · k tomu by som dodal…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ведучий і суть",
          "text": "Ведучий — «moderátor»: «Dávam slovo pánovi Kováčovi.», «Ďakujem za slovo.», «Máme čas už len na jednu otázku.» Щоб дискусія була «vecná» — по суті, кажемо: «Pokúsme sa zostať pri veci.» Не переходимо на особисте: «Nehádajme sa o slovíčka.» Відповідь «reagovať» — реагувати: «Chcem reagovať na predošlú poznámku.»",
          "examples": [
            {
              "sk": "Pokúsme sa zostať pri veci.",
              "uk": "Спробуймо триматися теми."
            },
            {
              "sk": "Chcem reagovať na predošlú poznámku.",
              "uk": "Хочу відреагувати на попереднє зауваження."
            }
          ],
          "shortRule": "moderátor dáva slovo · vecná diskusia",
          "button": "Далі →"
        }
