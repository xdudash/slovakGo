      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке компроміс",
          "text": "Компроміс — це рішення, у якому кожна сторона трохи поступається: «ústupok» — поступка, «ustúpiť» — поступитися. «Vyjsť v ústrety» — піти назустріч: «Ste ochotní vyjsť nám v ústrety?» «Stretnúť sa v polovici» — зустрітися посередині: кожен робить половину кроку. Таке рішення — «zlatá stredná cesta», золота середина. Прикметник «obojstranný» — обопільний: «obojstranná dohoda».",
          "examples": [
            {
              "sk": "Čo keby sme sa stretli v polovici?",
              "uk": "А що, якби ми зустрілися посередині?"
            },
            {
              "sk": "Som ochotný ustúpiť v termíne.",
              "uk": "Я готовий поступитися в терміні."
            }
          ],
          "shortRule": "ustúpiť · vyjsť v ústrety · stretnúť sa v polovici",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пропонуємо варіанти",
          "text": "«Navrhujem, aby sme…» + l-форма: «Navrhujem, aby sme sa stretli v piatok.» «Čo keby sme…» + l-форма. «Mohli by sme…» + інфінітив. «Dohodnúť sa na» + місцевий відмінок: «dohodnúť sa na cene», «na termíne», «na tom». Загальне: «Dohodnime sa na tom.» — Домовмося про це.",
          "examples": [
            {
              "sk": "Navrhujem, aby sme sa stretli v piatok.",
              "uk": "Пропоную, щоб ми зустрілися в п’ятницю."
            },
            {
              "sk": "Dohodli sme sa na cene.",
              "uk": "Ми домовилися про ціну."
            }
          ],
          "shortRule": "navrhujem, aby sme… · dohodnúť sa na + місцевий",
          "commonMistakes": [
            {
              "mistake": "Dohodli sme sa na cenu.",
              "correct": "Dohodli sme sa na cene."
            },
            {
              "mistake": "Navrhujem, že sme sa stretli.",
              "correct": "Navrhujem, aby sme sa stretli."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Поступка в обмін на поступку",
          "text": "Хороший компроміс — це «ty mne, ja tebe»: «Ak ustúpite v termíne, ustúpim aj ja v cene.» Умова: «Pod podmienkou, že…» — за умови, що…; «Ak aj vy…, tak aj ja…». Тверда позиція: «Nie som ochotný ustúpiť» — не готовий поступитися. Якщо компромісу немає, можна сказати: «Bohužiaľ, tu sa nedohodneme.»",
          "examples": [
            {
              "sk": "Ak ustúpite v termíne, ustúpim aj ja v cene.",
              "uk": "Якщо ви поступитеся в терміні, поступлюся й я в ціні."
            },
            {
              "sk": "Môžem prísť, pod podmienkou, že dostanem voľno v pondelok.",
              "uk": "Можу прийти за умови, що отримаю вихідний у понеділок."
            }
          ],
          "shortRule": "ak vy…, aj ja… · pod podmienkou, že…",
          "button": "Далі →"
        }
