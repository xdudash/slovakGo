      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як ввести приклад",
          "text": "Найчастіше: «napríklad» — може стояти на початку або в середині: «Napríklad v Trnave hľadajú pracovníkov.» Також: «Ako príklad uvediem…» — як приклад наведу, «Zoberme si…» — візьмімо, «Typickým príkladom je…» — типовий приклад — це. Перед прикладом, що йде після речення, часто ставимо двокрапку або кому. У письмі скорочено: «napr.».",
          "examples": [
            {
              "sk": "Mnohé mestá, napríklad Košice, majú problém s parkovaním.",
              "uk": "Багато міст, наприклад Кошіце, мають проблему з паркуванням."
            },
            {
              "sk": "Zoberme si napríklad nočné zmeny.",
              "uk": "Візьмімо, наприклад, нічні зміни."
            }
          ],
          "shortRule": "napríklad · ako príklad uvediem · zoberme si",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Конкретно й з досвіду",
          "text": "«Konkrétne» — конкретно: «Konkrétne mám na mysli nočné zmeny.» «Z vlastnej skúsenosti» — з власного досвіду: «Z vlastnej skúsenosti viem, že ranné zmeny sú náročné.» «Ilustrovať» — проілюструвати: «Ilustrujem to na príklade.» Конкретний приклад зі свого життя робить думку живою, але його не слід вважати доказом для всіх.",
          "examples": [
            {
              "sk": "Z vlastnej skúsenosti viem, že na sklade je dôležitá presnosť.",
              "uk": "З власного досвіду знаю, що на складі важлива точність."
            },
            {
              "sk": "Ilustrujem to na príklade.",
              "uk": "Проілюструю це на прикладі."
            }
          ],
          "shortRule": "konkrétne · z vlastnej skúsenosti",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Приклад чи доказ",
          "text": "Приклад ілюструє думку, доказ її підтверджує. Докази — це дані: «Podľa prieskumu…», «Podľa štatistiky…», «Podľa údajov úradu…», «Faktom je, že…». Один приклад — це ще не доказ: «Môj sused mal šťastie» не означає, що всім пощастить. Сильний аргумент поєднує дані й приклад.",
          "examples": [
            {
              "sk": "Podľa prieskumu chodí do práce autom 45 % zamestnancov.",
              "uk": "За даними опитування, на роботу їздить автомобілем 45 % працівників."
            },
            {
              "sk": "Dôkazom je, že počet žiadostí vzrástol.",
              "uk": "Доказ у тому, що кількість заяв зросла."
            }
          ],
          "shortRule": "prieskum, štatistika = dôkaz · príklad = ilustrácia",
