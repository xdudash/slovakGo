      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Причина і наслідок",
          "text": "«Pretože» — тому що, відповідає на «чому?»: «Zostal som doma, pretože som bol chorý.» У розмові часто «lebo». «Keďže» — оскільки, причина відома й стоїть на початку: «Keďže je sobota, úrad je zatvorený.» «Preto» — тому, вводить наслідок: «Bol som chorý, preto som zostal doma.» «Takže» — отже, тому, розмовніше. Увага: «pretože» і «preto» — не взаємозамінні.",
          "examples": [
            {
              "sk": "Nemôžem prísť, pretože mám zmenu.",
              "uk": "Не можу прийти, бо маю зміну."
            },
            {
              "sk": "Mám zmenu, preto nemôžem prísť.",
              "uk": "Маю зміну, тому не можу прийти."
            }
          ],
          "shortRule": "pretože, keďže = причина · preto, takže = наслідок",
          "commonMistakes": [
            {
              "mistake": "Bol som chorý, pretože som zostal doma.",
              "correct": "Bol som chorý, preto som zostal doma."
            },
            {
              "mistake": "Preto som chorý, zostal som doma.",
              "correct": "Zostal som doma, pretože som bol chorý."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Поступка",
          "text": "«Hoci» (також «aj keď») — хоча: підрядне речення, головна розповідає про несподіваний результат: «Hoci prší, ideme na výlet.» «Napriek tomu» — незважаючи на це, все ж: «Pršalo. Napriek tomu sme išli na výlet.» Окремо «napriek» вимагає давального відмінка: «napriek dažďu», «napriek tomu». «Hoci» не можна поєднувати з «preto».",
          "examples": [
            {
              "sk": "Hoci je unavený, pracuje ďalej.",
              "uk": "Хоча він утомлений, він працює далі."
            },
            {
              "sk": "Bolo draho. Napriek tomu sme to kúpili.",
              "uk": "Було дорого. Попри це ми це купили."
            }
          ],
          "shortRule": "hoci, aj keď · napriek tomu",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Totiž, teda",
          "text": "«Totiž» — адже, річ у тім, що: пояснює попереднє речення й стоїть після першого слова: «Nemôžem prísť. Mám totiž zmenu.» «Teda» — отже: «Je piatok, teda zajtra je voľno.» «Totiž» пояснює причину, «teda» вводить висновок. Кому ставимо перед «pretože», «hoci», «keďže», якщо вони вводять підрядне речення після головного.",
          "examples": [
            {
              "sk": "Nemôžem prísť. Mám totiž zmenu.",
              "uk": "Не можу прийти. Адже в мене зміна."
            },
            {
              "sk": "Je piatok, teda zajtra je voľno.",
              "uk": "Сьогодні п’ятниця, отже завтра вихідний."
            }
          ],
          "shortRule": "totiž — після першого слова · teda — висновок",
          "button": "Далі →"
        }
      ],
