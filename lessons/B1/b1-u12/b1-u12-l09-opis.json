      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Опис людини",
          "text": "Щоб показати, про кого мова, поєднуй прикметники, прийменникові звороти й відносне речення: «ten vysoký plešatý pán s fúzami, ktorý stojí pri okne». Зовнішність: «má pehy, fúzy, okuliare», «je plešatý, zavalitý, štíhly». Одяг: «má na sebe…» (на ньому…) + знахідний: «Má na sebe kockovanú košeľu.»",
          "examples": [
            {
              "sk": "Ten plešatý pán, ktorý stojí pri bare, je náš riaditeľ.",
              "uk": "Той лисий пан, який стоїть біля бару, — наш директор."
            },
            {
              "sk": "Žena s pehami, ktorá má na sebe pruhované šaty, je Lucia.",
              "uk": "Жінка з ластовинням, на якій смугаста сукня, — Луція."
            }
          ],
          "shortRule": "ten + прикметник + s… + , ktorý…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Опис речі",
          "text": "Річ описуємо за кольором, візерунком, розміром і особливими прикметами — часто через відносне речення з прийменником: «taška, na ktorej je nálepka», «peňaženka, v ktorej sú doklady», «kufor, ktorý má pokazené koliesko». Прикметники узгоджуй з іменником: pruhovaný sveter, pruhovaná taška, pruhované tričko.",
          "examples": [
            {
              "sk": "Stratil som čiernu tašku, na ktorej je červená nálepka.",
              "uk": "Я загубив чорну сумку, на якій червона наліпка."
            },
            {
              "sk": "V taške bola peňaženka, v ktorej mám doklady.",
              "uk": "У сумці був гаманець, у якому мої документи."
            }
          ],
          "shortRule": ", na ktorej je… · , v ktorej sú…",
          "commonMistakes": [
            {
              "mistake": "taška, na ktorom",
              "correct": "taška, na ktorej"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Котрий саме?",
          "text": "Коли питають «Ktorý? Ktorá?», відповідай «Ten / Tá / To, ktorý / ktorá / ktoré…» або коротко «Ten v…», «Tá s…»: «Ktorý je tvoj brat? — Ten zavalitý v pruhovanom svetri.» «Ktorá je Ivana? — Tá v kockovaných šatách.» Після «v» — місцевий відмінок, після «s» — орудний: v kockovanej košeli, s okuliarmi, s pehami.",
          "examples": [
            {
              "sk": "Ktorý je tvoj brat? — Ten, ktorý má na sebe pruhovaný sveter.",
              "uk": "Котрий твій брат? — Той, на якому смугастий светр."
            },
            {
              "sk": "Tá v nápadnej žltej bunde je moja sestra.",
              "uk": "Та, що в яскравій жовтій куртці, — моя сестра."
            }
          ],
          "shortRule": "ten / tá / to + v (М.) / s (О.)",
          "commonMistakes": [
