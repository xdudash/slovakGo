      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kto після займенників",
          "text": "«Kto» як відносне слово стоїть після займенників «ten», «každý», «nikto», «niekto», «ktokoľvek» або на початку речення: «Kto chce, môže ísť.» Після іменника (človek, účastník, kolega) — завжди «ktorý»: «človek, ktorý…». Це типова мова правил і оголошень.",
          "examples": [
            {
              "sk": "Každý, kto má otázku, môže zostať.",
              "uk": "Кожен, хто має запитання, може залишитися."
            },
            {
              "sk": "Kto chce kávu, nech sa ozve.",
              "uk": "Хто хоче кави, хай скаже."
            }
          ],
          "shortRule": "ten / každý / nikto + , kto · іменник + , ktorý",
          "commonMistakes": [
            {
              "mistake": "človek, kto prišiel",
              "correct": "človek, ktorý prišiel"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Узгодження: kto + однина",
          "text": "Після «kto» дієслово стоїть в однині чоловічого роду, навіть якщо мова про жінок чи групу: «Kto prišiel neskoro, nedostal kávu.» Якщо хочеш множину, кажи «tí, ktorí»: «Tí, ktorí prišli neskoro, nedostali kávu.» Поєднання «tí, kto» — помилка.",
          "examples": [
            {
              "sk": "Kto vymešká viac ako dve lekcie, nedostane certifikát.",
              "uk": "Хто пропустить більше двох занять, не отримає сертифіката."
            },
            {
              "sk": "Tí, ktorí sa prihlásili, dostanú e-mail.",
              "uk": "Ті, хто зареєструвався, отримають e-mail."
            }
          ],
          "shortRule": "kto + однина · tí, ktorí + множина",
          "commonMistakes": [
            {
              "mistake": "Kto prišli…",
              "correct": "Kto prišiel…"
            },
            {
              "mistake": "tí, kto",
              "correct": "tí, ktorí"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відмінки kto й прислів’я",
          "text": "Kto – koho – komu – o kom – s kým: «ten, komu patrí kľúč», «každý, koho som pozval», «nikto, s kým som hovoril». Часто головне речення має відповідник: «Kto…, ten…», «Kto…, tomu…». Так побудовано багато прислів’їв: «Kto hľadá, nájde.» «Kto skoro ráno vstáva, tomu Pán Boh dáva.»",
          "examples": [
            {
              "sk": "Ten, komu patrí tento kľúč, nech si ho vezme.",
              "uk": "Той, чий це ключ, хай його забере."
            },
            {
              "sk": "Kto inému jamu kope, sám do nej padá.",
              "uk": "Хто іншому яму копає, той сам у неї впаде."
            }
          ],
          "shortRule": "kto – koho – komu – o kom – s kým",
          "button": "Далі →"
        }
      ],
