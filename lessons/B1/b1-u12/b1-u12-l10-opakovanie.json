      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ktorý і «чий»",
          "text": "Рід і число ktorý — від іменника, відмінок — від ролі в підрядному: «ruksak, ktorý som stratil», «sprievodca, ktorému som volal», «vlak, v ktorom som cestoval». «Чий»: «pán, ktorého auto…», «žena, ktorej syn…». Підрядне стоїть одразу після свого слова.",
          "examples": [
            {
              "sk": "Sprievodca, ktorý našiel môj ruksak, mi zavolal.",
              "uk": "Провідник, який знайшов мій рюкзак, мені подзвонив."
            },
            {
              "sk": "Mám kolegyňu, ktorej brat býva v Nitre.",
              "uk": "Маю колегу, чий брат живе в Нітрі."
            }
          ],
          "shortRule": "ktorý · ktorého / ktorej + іменник",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Čo, kto, aký, kde, kam, odkiaľ",
          "text": "Після to / všetko / nič / niečo — čo: «všetko, čo som mal». Після ten / každý / nikto — kto з дієсловом в однині: «Každý, kto niečo stratil…». Taký…, aký — тип: «taký istý ruksak, aký mám». Місця: kde (де), kam (куди), odkiaľ (звідки): «stanica, kde je kancelária», «mesto, odkiaľ pochádzam».",
          "examples": [
            {
              "sk": "Všetko, čo som v ňom mal, tam bolo.",
              "uk": "Усе, що в ньому було, лишилося на місці."
            },
            {
              "sk": "Kto ruksak stratil, si ho môže vyzdvihnúť.",
              "uk": "Хто загубив рюкзак, може його забрати."
            }
          ],
          "shortRule": "to, čo · ten, kto · taký, aký · kde / kam / odkiaľ",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коми, визначення, опис",
          "text": "Кома завжди перед відносним словом, а якщо є прийменник — перед прийменником: «ruksak, v ktorom…». Вставлене речення — дві коми. Визначення: «Nájomník je človek, ktorý…», «Otvárač je vec, ktorou sa…». Опис: «sivý ruksak, na ktorom je nášivka», «ten plešatý pán v kockovanej košeli».",
          "examples": [
            {
              "sk": "Ruksak, v ktorom mám notebook, je sivý.",
              "uk": "Рюкзак, у якому мій ноутбук, сірий."
            },
            {
              "sk": "Je to vec, ktorou sa otvárajú konzervy.",
              "uk": "Це річ, якою відкривають консерви."
            }
          ],
          "shortRule": ", v ktorom … , · X je Y, ktorý…",
          "button": "Далі →"
        }
