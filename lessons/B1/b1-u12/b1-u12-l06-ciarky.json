      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Кома перед підрядним",
          "text": "Як і в українській, підрядне речення в словацькій завжди відокремлюється комою. Кома стоїть перед відносним словом чи сполучником: ktorý, čo, kde, kam, kto, aký, že, aby, keď, lebo, pretože. Складне речення — «súvetie», воно має головне речення (hlavná veta) й підрядне (vedľajšia veta).",
          "examples": [
            {
              "sk": "Neviem, čo mám robiť.",
              "uk": "Не знаю, що мені робити."
            },
            {
              "sk": "Mám kolegu, ktorý hovorí po ukrajinsky.",
              "uk": "Маю колегу, який говорить українською."
            }
          ],
          "shortRule": ", ktorý · , čo · , kde · , že",
          "commonMistakes": [
            {
              "mistake": "Neviem čo mám robiť.",
              "correct": "Neviem, čo mám robiť."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вставлене речення — дві коми",
          "text": "Якщо підрядне речення стоїть усередині головного, воно відокремлюється комами з обох боків: «Muž, ktorý tu býval, sa odsťahoval.» Найчастіша помилка — забути другу кому перед продовженням головного речення. Так само «To, čo hovoríš, je pravda.», «Každý, kto prišiel, dostal kávu.»",
          "examples": [
            {
              "sk": "Kolega, ktorý sedí pri okne, je z Prešova.",
              "uk": "Колега, який сидить біля вікна, з Пряшева."
            },
            {
              "sk": "To, čo hovoríš, je zaujímavé.",
              "uk": "Те, що ти кажеш, цікаве."
            }
          ],
          "shortRule": ", ktorý … , — дві коми",
          "commonMistakes": [
            {
              "mistake": "Muž, ktorý tu býval sa odsťahoval.",
              "correct": "Muž, ktorý tu býval, sa odsťahoval."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменник і місця без коми",
          "text": "Прийменник належить до підрядного речення, тому кома стоїть перед ним: «byt, v ktorom bývam», «ľudia, s ktorými pracujem», «výlet, o ktorom sme hovorili». Коми не ставимо перед простим «a», що поєднує два речення («Prišiel domov a ľahol si.»), і в порівнянні без дієслова: «taký istý ako ty».",
          "examples": [
            {
              "sk": "Toto je kniha, o ktorej som ti hovoril.",
              "uk": "Це книжка, про яку я тобі розповідав."
            },
            {
              "sk": "Prišiel domov a ľahol si.",
              "uk": "Він прийшов додому й ліг."
            }
          ],
          "shortRule": ", v ktorom (не v, ktorom) · без коми перед простим a",
          "commonMistakes": [
            {
              "mistake": "byt v, ktorom bývam",
              "correct": "byt, v ktorom bývam"
            },
            {
              "mistake": "Prišiel domov, a ľahol si.",
              "correct": "Prišiel domov a ľahol si."
            }
          ],
          "button": "Далі →"
        }
