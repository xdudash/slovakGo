      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Формула визначення",
          "text": "Класичне визначення: «X je + загальне поняття + ktorý…». Спершу називаємо ширшу групу (človek, miesto, vec, prístroj, pomôcka), потім відносним реченням — те, що відрізняє: «Lekáreň je obchod, v ktorom sa predávajú lieky.» «Krajan je človek, ktorý pochádza z tej istej krajiny.» Рід ktorý — від загального слова: človek → ktorý, vec → ktorá, miesto → ktoré.",
          "examples": [
            {
              "sk": "Rodák je človek, ktorý sa narodil na danom mieste.",
              "uk": "Уродженець — це людина, яка народилася в цьому місці."
            },
            {
              "sk": "Recepcia je miesto, kde vítajú hostí.",
              "uk": "Рецепція — це місце, де зустрічають гостей."
            }
          ],
          "shortRule": "X je človek / miesto / vec, ktorý / kde / ktorou…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Коли бракує слова",
          "text": "Не знаєш назви — опиши: «Je to vec, ktorou sa…» (річ, якою…), «Je to niečo, čo…» (щось, що…), «Je to človek, ktorý…», «Je to miesto, kde…». Зверни увагу на орудний: «vec, ktorou sa otvárajú konzervy», «pomôcka, ktorou sa šúpe zelenina». Почни з «Neviem, ako sa to volá, ale…» — і тебе зрозуміють.",
          "examples": [
            {
              "sk": "Neviem, ako sa to volá, ale je to vec, ktorou sa otvárajú konzervy.",
              "uk": "Не знаю, як це називається, але це річ, якою відкривають консерви."
            },
            {
              "sk": "Je to niečo, čo sa používa v kuchyni.",
              "uk": "Це щось, що використовують на кухні."
            }
          ],
          "shortRule": "vec, ktorou sa… · niečo, čo…",
          "commonMistakes": [
            {
              "mistake": "vec, ktorá sa otvárajú konzervy",
              "correct": "vec, ktorou sa otvárajú konzervy"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Призначення й значення",
          "text": "Для чого річ: «slúži na + знахідний» або «používa sa na»: «Vysávač slúži na čistenie podláh.» Значення слова: «Slovo X označuje…» / «X znamená…»: «Pojem „brigáda“ označuje krátkodobú prácu.» Зверни увагу: slúžiť na (не pre): «na čistenie», «na otváranie».",
          "examples": [
            {
              "sk": "Vysávač je prístroj, ktorý slúži na čistenie podláh.",
              "uk": "Пилосос — це прилад, який служить для чищення підлоги."
            },
            {
              "sk": "Slovo «krajan» označuje človeka z tej istej krajiny.",
              "uk": "Слово «krajan» означає людину з тієї самої країни."
            }
          ],
          "shortRule": "slúžiť na + знахідний · označovať + знахідний",
          "button": "Далі →"
        }
      ],
