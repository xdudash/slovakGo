      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "To, čo · všetko, čo",
          "text": "Після займенників «to», «všetko», «niečo», «nič» у словацькій стоїть «čo», а не ktoré: «to, čo hovoríš», «všetko, čo potrebuješ», «niečo, čo neviem», «nič, čo by pomohlo». Українською теж кажемо «те, що», «усе, що». Між «to» і «čo» завжди кома.",
          "examples": [
            {
              "sk": "To, čo hovoríš, nie je pravda.",
              "uk": "Те, що ти кажеш, неправда."
            },
            {
              "sk": "Urobím všetko, čo bude treba.",
              "uk": "Я зроблю все, що буде потрібно."
            }
          ],
          "shortRule": "to / všetko / niečo / nič + , čo",
          "commonMistakes": [
            {
              "mistake": "Všetko, ktoré potrebujem…",
              "correct": "Všetko, čo potrebujem…"
            },
            {
              "mistake": "To, ktoré si povedal…",
              "correct": "To, čo si povedal…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відмінки čo",
          "text": "«Čo» змінюється за відмінками так само, як питальне слово: čo (Н., З.) – čoho (Р.) – čomu (Д.) – o čom (М.) – čím (О.). Відмінок, як і в ktorý, визначає дієслово підрядного речення: «to, čoho sa bojím» (báť sa čoho), «to, čomu nerozumiem» (rozumieť čomu), «to, na čo sa teším» (tešiť sa na čo), «to, čím sa zaoberám» (zaoberať sa čím).",
          "examples": [
            {
              "sk": "To, čoho sa najviac bojím, je skúška.",
              "uk": "Те, чого я найбільше боюся, — іспит."
            },
            {
              "sk": "Zapíšem si všetko, čomu nerozumiem.",
              "uk": "Я запишу все, чого не розумію."
            }
          ],
          "shortRule": "čo · čoho · čomu · o čom · čím",
          "commonMistakes": [
            {
              "mistake": "To, čo sa bojím…",
              "correct": "To, čoho sa bojím…"
            },
            {
              "mistake": "všetko, čo nerozumiem",
              "correct": "všetko, čomu nerozumiem"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čo про ціле речення",
          "text": "«Čo» може стосуватися не одного слова, а всієї попередньої думки: «Prišiel včas, čo ma prekvapilo.» — Він прийшов вчасно, що мене здивувало. Так зручно коментувати події й емоції: «čo ma potešilo», «čo ma sklamalo», «čo ma rozčuľuje». Ще одна часта конструкція: «To, čo ma najviac prekvapilo, bolo…»",
          "examples": [
            {
              "sk": "Dostala som tú prácu, čo ma veľmi potešilo.",
              "uk": "Я отримала ту роботу, що мене дуже потішило."
            },
            {
              "sk": "To, čo ma najviac sklamalo, bola cena.",
              "uk": "Те, що мене найбільше розчарувало, — ціна."
            }
          ],
          "shortRule": "…, čo ma prekvapilo / potešilo",
          "button": "Далі →"
        }
      ],
