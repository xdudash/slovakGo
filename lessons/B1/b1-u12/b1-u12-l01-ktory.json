      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Рід і число — від іменника",
          "text": "«Ktorý» відповідає українському «який / котрий» у підрядному реченні. Рід і число ktorý бере від іменника, який пояснює: «kolega, ktorý…», «zmluva, ktorá…», «auto, ktoré…». У множині: «kolegovia, ktorí…» (чоловіки-особи), але «zmluvy, ktoré…», «autá, ktoré…», «kolegyne, ktoré…». Підрядне речення завжди відокремлюємо комою.",
          "examples": [
            {
              "sk": "Mám kolegu, ktorý hovorí po ukrajinsky.",
              "uk": "У мене є колега, який розмовляє українською."
            },
            {
              "sk": "Toto sú zmluvy, ktoré musíte podpísať.",
              "uk": "Це договори, які ви маєте підписати."
            }
          ],
          "shortRule": "ktorý (ч.) · ktorá (ж.) · ktoré (с., мн.) · ktorí (мн., чоловіки-особи)",
          "commonMistakes": [
            {
              "mistake": "zmluva, ktorý",
              "correct": "zmluva, ktorá"
            },
            {
              "mistake": "kolegovia, ktoré",
              "correct": "kolegovia, ktorí"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відмінок — від ролі в підрядному реченні",
          "text": "Відмінок ktorý залежить не від головного речення, а від того, яку роль це слово виконує в підрядному. «Nájomník, ktorý tu býva» (хто? — називний), «nájomník, ktorého poznáš» (кого? — знахідний), «nájomník, ktorému som dal kľúč» (кому? — давальний), «nájomník, bez ktorého…» (родовий). Жіночий рід: ktorá – ktorej – ktorú – ktorou. Множина: ktorí/ktoré – ktorých – ktorým – ktorými.",
          "examples": [
            {
              "sk": "To je zmluva, ktorú som včera podpísal.",
              "uk": "Це договір, який я вчора підписав."
            },
            {
              "sk": "Pán Kováč je kolega, ktorému môžete poslať pripomienky.",
              "uk": "Пан Ковач — колега, якому можна надіслати зауваження."
            }
          ],
          "shortRule": "ktorého (Р., З. чол. ос.) · ktorému (Д.) · ktorú (З. ж.)",
          "commonMistakes": [
            {
              "mistake": "zmluva, ktorá som podpísal",
              "correct": "zmluva, ktorú som podpísal"
            },
            {
              "mistake": "kolega, ktorý som videl",
              "correct": "kolega, ktorého som videl"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменник + ktorý",
          "text": "Прийменник стоїть безпосередньо перед ktorý, а кома — перед прийменником: «byt, v ktorom bývam», «kolegyňa, s ktorou pracujem», «firma, pre ktorú robím», «projekt, o ktorom sme hovorili». Місцевий: v / o ktorom (ч., с.), v / o ktorej (ж.), v / o ktorých (мн.). Орудний: s ktorým, s ktorou, s ktorými.",
          "examples": [
            {
              "sk": "Byt, v ktorom bývame, je malý.",
              "uk": "Квартира, у якій ми живемо, маленька."
            },
            {
              "sk": "Kolegovia, s ktorými pracujem, sú zo Žiliny.",
              "uk": "Колеги, з якими я працюю, із Жиліни."
            }
          ],
          "shortRule": ", v ktorom · , s ktorou · , o ktorých",
          "commonMistakes": [
