      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde = v ktorom",
          "text": "Після іменника, що означає місце, замість «v ktorom / na ktorom» часто кажемо просто «kde»: «mesto, kde žijem» = «mesto, v ktorom žijem». Так само «tam, kde…» — там, де. Дієслова стану й місця (bývať, pracovať, žiť, usadiť sa, narodiť sa) — з kde.",
          "examples": [
            {
              "sk": "Toto je obchod, kde kupujem ukrajinské potraviny.",
              "uk": "Це магазин, де я купую українські продукти."
            },
            {
              "sk": "Usadili sme sa v Trnave, kde pracuje aj môj brat.",
              "uk": "Ми оселилися в Трнаві, де працює й мій брат."
            }
          ],
          "shortRule": "kde = v / na ktorom (ktorej)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kam і odkiaľ",
          "text": "«Kam» — напрямок (куди?): «kaviareň, kam chodíme po práci» = «do ktorej chodíme». «Odkiaľ» — походження (звідки?): «krajina, odkiaľ pochádzam» = «z ktorej pochádzam». Пари з «tam / odtiaľ»: «Choď tam, kam chceš.» «Vrátil sa tam, odkiaľ prišiel.»",
          "examples": [
            {
              "sk": "Lviv je mesto, odkiaľ pochádzam.",
              "uk": "Львів — місто, звідки я родом."
            },
            {
              "sk": "Je to park, kam chodím behať.",
              "uk": "Це парк, куди я ходжу бігати."
            }
          ],
          "shortRule": "kam = do / na ktorý · odkiaľ = z ktorého",
          "commonMistakes": [
            {
              "mistake": "mesto, kde sme sa presťahovali",
              "correct": "mesto, kam sme sa presťahovali"
            },
            {
              "mistake": "krajina, kde pochádzam",
              "correct": "krajina, odkiaľ pochádzam"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Вибір за дієсловом",
          "text": "Питай себе, на яке питання відповідає дієслово в підрядному: bývam, pracujem, som sa narodil — kde?; idem, chodím, cestujem, sťahujem sa — kam?; pochádzam, som rodák, vraciam sa (z) — odkiaľ? Для часу словацька має «keď»: «deň, keď som prišiel» — день, коли я приїхав.",
          "examples": [
            {
              "sk": "Dedina, kde som vyrastal, je pri Užhorode.",
              "uk": "Село, де я виріс, біля Ужгорода."
            },
            {
              "sk": "Krajina, kam sa chcú presťahovať, je ďaleko.",
              "uk": "Країна, куди вони хочуть переїхати, далеко."
            }
          ],
          "shortRule": "kde? · kam? · odkiaľ?",
          "button": "Далі →"
        }
      ],
