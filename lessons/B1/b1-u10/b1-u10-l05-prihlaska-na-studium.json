      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prijímacie konanie",
          "text": "Вступ до університету — «prijímacie konanie». Подаєш «prihlášku», найчастіше електронно через портал університету, і платиш «poplatok za prijímacie konanie». Кожен факультет сам визначає термін, часто це кінець лютого, березня чи квітня — перевір на сайті. Деякі «študijné programy» мають «prijímaciu skúšku», інші приймають без іспиту, за оцінками. Наприкінці отримуєш «rozhodnutie o prijatí» (або «o neprijatí»).",
          "examples": [
            {
              "sk": "Prihlášky na študijný program Psychológia sa podávajú do 31. marca.",
              "uk": "Заявки на програму «Психологія» подають до 31 березня."
            },
            {
              "sk": "Rozhodnutie o prijatí vám pošleme poštou.",
              "uk": "Рішення про зарахування ми надішлемо вам поштою."
            }
          ],
          "shortRule": "prihláška → prijímacia skúška → rozhodnutie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Документи",
          "text": "До заявки зазвичай додають: «životopis», «overenú kópiu maturitného vysvedčenia» (засвідчену копію атестата), документ про визнання іноземної освіти й «potvrdenie o zaplatení poplatku». Засвідчену копію зазвичай робить нотаріус або matrika на obecnom úrade. Якщо документ іноземний, потрібен «úradný preklad». У формулярах і листах: «Prílohy:» — додатки.",
          "examples": [
            {
              "sk": "K prihláške priložte overenú kópiu maturitného vysvedčenia.",
              "uk": "До заявки додайте засвідчену копію атестата зрілості."
            },
            {
              "sk": "V prílohe posielam potvrdenie o zaplatení poplatku.",
              "uk": "У додатку надсилаю підтвердження оплати збору."
            }
          ],
          "shortRule": "priložiť + знахідний · v prílohe posielam…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Офіційний e-mail і непрямі питання",
          "text": "Структура: «Vážená pani…» / «Vážený pán…» або «Dobrý deň,» → коротко, хто ти → прохання → «Ďakujem za odpoveď. S pozdravom» + ім’я. У листі «Vás, Vám» зазвичай пишемо з великої літери (з ввічливості). Непряме питання: «Chcel(a) by som sa informovať, či…» (чи…), «…kedy bude prijímacia skúška». Перед či/kedy ставимо кому; «ak» означає «якщо», не «чи».",
          "examples": [
            {
              "sk": "Chcela by som sa informovať, či môžem poslať prihlášku aj po termíne.",
              "uk": "Я хотіла б дізнатися, чи можу надіслати заявку й після терміну."
