      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Мета й причини",
          "text": "«Mojím cieľom je…» + інфінітив: Mojím cieľom je zložiť skúšku B1. «Učím sa slovenčinu, aby som…» — мета: aby + l-форма. «Motivuje ma to, že…» — мене мотивує те, що… «Chcem sa zlepšiť v…» + місцевий: v gramatike, v rozprávaní.",
          "examples": [
            {
              "sk": "Mojím cieľom je pracovať v škole ako asistentka.",
              "uk": "Моя мета — працювати в школі асистенткою."
            },
            {
              "sk": "Motivuje ma to, že deti hovoria po slovensky lepšie ako ja.",
              "uk": "Мене мотивує те, що діти говорять словацькою краще за мене."
            }
          ],
          "shortRule": "Mojím cieľom je + інфінітив · aby + l-форма",
          "commonMistakes": [
            {
              "mistake": "Učím sa, aby som hovorím lepšie.",
              "correct": "Učím sa, aby som hovoril lepšie."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Труднощі",
          "text": "«Odkladať» — відкладати: Stále to odkladám na zajtra. «Ťažko sa sústredím» — мені важко зосередитися. «Nechce sa mi» + інфінітив — мені не хочеться. «Mám chuť sa vzdať» — хочеться здатися. «Vzdať sa» — здатися; «vzdať sa niečoho» — відмовитися від чогось (+ родовий). «Prekonať» — подолати: prekonať strach, prekonať krízu.",
          "examples": [
            {
              "sk": "Po práci sa mi už nechce učiť.",
              "uk": "Після роботи мені вже не хочеться вчитися."
            },
            {
              "sk": "Musím prekonať strach z rozprávania.",
              "uk": "Мені треба подолати страх перед розмовою."
            }
          ],
          "shortRule": "nechce sa mi + інфінітив · vzdať sa + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порада й підтримка",
          "text": "Порада з умовним способом: «Keby som bol(a) na tvojom mieste, učil(a) by som sa každý deň trochu.» Інші способи: «Skús…», «Pomôže ti, ak…», «Netráp sa» (не переймайся). Підтримка: «Nevzdávaj sa!», «Vydrž!» (тримайся), «Už si urobil(a) veľký pokrok!» Важливі якості: «vytrvalosť» (наполегливість) і «trpezlivosť» (терпіння).",
          "examples": [
            {
              "sk": "Keby som bola na tvojom mieste, pozerala by som slovenské seriály.",
              "uk": "Якби я була на твоєму місці, я дивилася б словацькі серіали."
            },
            {
              "sk": "Nevzdávaj sa, už si urobil veľký pokrok!",
              "uk": "Не здавайся, ти вже зробив великий прогрес!"
            }
          ],
          "shortRule": "keby som bol(a)…, + by + l-форма",
          "commonMistakes": [
            {
              "mistake": "Keby som bol na tvojom mieste, učím sa viac.",
              "correct": "Keby som bol na tvojom mieste, učil by som sa viac."
            }
          ],
          "button": "Далі →"
        }
      ],
