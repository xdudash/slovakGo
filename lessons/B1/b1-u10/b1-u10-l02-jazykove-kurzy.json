      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Який курс вибрати",
          "text": "Мовні школи пропонують «kurz slovenčiny pre cudzincov» за рівнями: «pre začiatočníkov» (для початківців), «pre mierne pokročilých» (для середнього рівня), «pre pokročilých» (для просунутих). «Intenzívny kurz» — багато годин щотижня, часто щодня. Бувають групові заняття й «individuálne hodiny» (індивідуальні). «Konverzácia» — заняття, де головне — розмовляти. Курс веде «lektor» або «lektorka».",
          "examples": [
            {
              "sk": "Hľadám intenzívny kurz slovenčiny pre začiatočníkov.",
              "uk": "Шукаю інтенсивний курс словацької для початківців."
            },
            {
              "sk": "Kurz vedie skúsená lektorka.",
              "uk": "Курс веде досвідчена викладачка."
            }
          ],
          "shortRule": "pre + знахідний: pre začiatočníkov, pre pokročilých",
          "commonMistakes": [
            {
              "mistake": "kurz pre začiatočníci",
              "correct": "kurz pre začiatočníkov"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Запис на курс",
          "text": "«Chcel(a) by som sa prihlásiť na kurz…» Питання: «Koľko stojí kurz?», «Je v cene aj učebnica?», «Kedy a ako často sú hodiny?» Школа часто вимагає «vstupný test» (вступний тест), щоб вас «zaradiť do skupiny» (зарахувати в групу) за рівнем. Частота: «dvakrát do týždňa» (двічі на тиждень), «každý deň».",
          "examples": [
            {
              "sk": "Na základe vstupného testu vás zaradíme do skupiny A2.",
              "uk": "За результатами вступного тесту ми зарахуємо вас у групу A2."
            },
            {
              "sk": "Chcela by som sa prihlásiť na večerný kurz.",
              "uk": "Я хотіла б записатися на вечірній курс."
            }
          ],
          "shortRule": "prihlásiť sa na kurz · dvakrát do týždňa",
          "commonMistakes": [
            {
              "mistake": "dvakrát v týždeň",
              "correct": "dvakrát do týždňa"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як говорити про свій рівень",
          "text": "«Rozumiem skoro všetko, ale ťažko sa mi rozpráva.» — Розумію майже все, але мені важко говорити. «Hovorím plynule / dobre / trochu.» «Stále robím chyby v pádoch.» — Досі роблю помилки у відмінках. Мову вивчаємо двома способами: «učiť sa slovenčinu» (знахідний) — так найкраще; а говоримо «hovoriť po slovensky» (прислівник).",
          "examples": [
            {
              "sk": "Rozumiem dobre, ale pri rozprávaní robím chyby.",
              "uk": "Розумію добре, але коли говорю, роблю помилки."
            },
            {
              "sk": "Slovenčinu sa učím od minulého roka.",
              "uk": "Словацьку я вчу з минулого року."
            }
          ],
          "shortRule": "učiť sa slovenčinu · hovoriť po slovensky",
          "commonMistakes": [
