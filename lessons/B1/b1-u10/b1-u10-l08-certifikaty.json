      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Які бувають документи",
          "text": "«Vysvedčenie» — шкільний табель або атестат («maturitné vysvedčenie»). «Diplom» — диплом університету. «Certifikát» — сертифікат, наприклад «jazykový certifikát» (мовний, із рівнем B1, B2…). «Osvedčenie» — свідоцтво, напр. «osvedčenie o absolvovaní kurzu».",
          "examples": [
            {
              "sk": "Mám jazykový certifikát z nemčiny na úrovni B2.",
              "uk": "У мене є мовний сертифікат з німецької рівня B2."
            },
            {
              "sk": "Po kurze dostanete osvedčenie o absolvovaní.",
              "uk": "Після курсу ви отримаєте свідоцтво про проходження."
            }
          ],
          "shortRule": "vysvedčenie · diplom · certifikát · osvedčenie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nostrifikácia й uznanie",
          "text": "Щоб український документ мав силу у Словаччині, його треба визнати. Шкільні документи (свідоцтво, атестат) проходять «nostrifikáciu» — її зазвичай робить okresný úrad v sídle kraja, odbor školstva. Для диплома університету кажуть «uznanie dokladu o vzdelaní»: для регульованих професій (лікар, учитель…) його робить відповідне міністерство, для продовження навчання — університет. Правила часом змінюються, тож актуальні умови перевір на сайті установи. Зазвичай потрібні «apostila» й «úradný preklad» — переклад судового перекладача (súdny prekladateľ).",
          "examples": [
            {
              "sk": "Vysvedčenie musíte dať nostrifikovať na okresnom úrade.",
              "uk": "Атестат вам треба нострифікувати в окружному управлінні."
            },
            {
              "sk": "Bez uznania diplomu nemôžem pracovať ako lekárka.",
              "uk": "Без визнання диплома я не можу працювати лікаркою."
            }
          ],
          "shortRule": "ZŠ, SŠ → nostrifikácia · VŠ → uznanie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Пасив у документах",
          "text": "В установах часто кажуть пасивом: «byť» + дієприкметник. preložiť → «preložený», overiť → «overený», uznať → «uznaný», vydať → «vydaný». Узгоджуй із родом і числом: diplom je uznaný, kópia je overená, vysvedčenie je preložené, doklady sú preložené.",
          "examples": [
            {
              "sk": "Diplom musí byť úradne preložený.",
              "uk": "Диплом має бути офіційно перекладений."
            },
            {
              "sk": "Moje vysvedčenie už je nostrifikované.",
              "uk": "Мій атестат уже нострифікований."
            }
          ],
          "shortRule": "byť + preložený / overený / uznaný",
          "commonMistakes": [
