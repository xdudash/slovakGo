      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Формати онлайн-навчання",
          "text": "«Webinár» — онлайн-лекція чи семінар у реальному часі. «Online kurz» часто проходить на «platforme» (платформі), де є відео, тести й «zadania» (завдання). Якщо пропустиш заняття, буде «nahrávka» (запис). «Samoštúdium» — самостійне навчання без викладача. «Interaktívny» — такий, де можна відповідати, клікати й працювати з іншими.",
          "examples": [
            {
              "sk": "Nahrávka z webinára bude k dispozícii do piatka.",
              "uk": "Запис вебінару буде доступний до п’ятниці."
            },
            {
              "sk": "Zadanie odovzdajte cez platformu do nedele.",
              "uk": "Здайте завдання через платформу до неділі."
            }
          ],
          "shortRule": "pripojiť sa na webinár · odovzdať zadanie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Технічні проблеми",
          "text": "«Nepočujeme vás, máte vypnutý mikrofón.» — Ми вас не чуємо, у вас вимкнений мікрофон. «Zamrzol mi obraz.» — У мене зависло зображення. «Vypadlo mi pripojenie.» — У мене зник зв’язок. «Môžete zdieľať obrazovku?» — Можете показати (поширити) екран? «Zapnite si kameru, prosím.» Давальний «mi» показує, з ким це сталося: vypadol mi internet.",
          "examples": [
            {
              "sk": "Prepáčte, vypadlo mi pripojenie, môžete to zopakovať?",
              "uk": "Вибачте, у мене зник зв’язок, можете повторити?"
            },
            {
              "sk": "Nevidíme vašu obrazovku.",
              "uk": "Ми не бачимо вашого екрана."
            }
          ],
          "shortRule": "vypadlo mi… · zamrzol mi… · zapnúť × vypnúť",
          "commonMistakes": [
            {
              "mistake": "Ja som vypadol internet.",
              "correct": "Vypadol mi internet."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Переваги й недоліки",
          "text": "Думка з аргументами: «Výhodou online kurzu je, že…» (перевага), «Nevýhodou je, že…» (недолік), «Na jednej strane…, na druhej strane…» (з одного боку…, з іншого…), «Podľa mňa…», «Okrem toho…» (крім того).",
          "examples": [
            {
              "sk": "Výhodou je, že sa môžem učiť kedykoľvek.",
              "uk": "Перевага в тому, що я можу вчитися будь-коли."
            },
            {
              "sk": "Na druhej strane mi chýba kontakt so spolužiakmi.",
              "uk": "З іншого боку, мені бракує контакту з одногрупниками."
            }
          ],
          "shortRule": "výhodou / nevýhodou je, že… · na jednej strane…, na druhej strane…",
          "commonMistakes": [
            {
              "mistake": "na druhú stranu",
              "correct": "na druhej strane"
            }
          ],
          "button": "Далі →"
        }
      ],
