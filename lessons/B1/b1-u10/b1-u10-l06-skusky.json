      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Robiť чи urobiť",
          "text": "Вид дієслова змінює зміст! «Robiť skúšku» — складати (процес, результат ще невідомий): Zajtra robím skúšku z chémie. «Urobiť skúšku» або «zložiť skúšku» — успішно скласти: Skúšku som urobil na prvý pokus. Так само «pripravovať sa na skúšku» (готуватися, процес) × «pripraviť sa» (підготуватися). Предмет іспиту — «z» + родовий: skúška z matematiky.",
          "examples": [
            {
              "sk": "Zajtra robím skúšku zo štatistiky.",
              "uk": "Завтра я складаю іспит зі статистики."
            },
            {
              "sk": "Konečne som zložila skúšku z angličtiny!",
              "uk": "Нарешті я склала іспит з англійської!"
            }
          ],
          "shortRule": "robiť (процес) × urobiť / zložiť (результат)",
          "commonMistakes": [
            {
              "mistake": "skúška z matematika",
              "correct": "skúška z matematiky"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Коли не вдалося",
          "text": "«Prepadnúť» — не скласти: prepadol som zo štatistiky / na skúške. Тоді йдеш на «opravný termín» (перескладання). В університетах шкала: A (výborne), B, C, D, E (dostatočne) — склав; FX (nedostatočne) — не склав. Оцінки в розмові: «Áčko, Béčko, Céčko». Перед іспитом: «Držím ti palce!» (тримаю за тебе кулаки), «To zvládneš!» Після: «Ako dopadla skúška?» — Як пройшов іспит?",
          "examples": [
            {
              "sk": "Zo štatistiky som prepadol, idem na opravný termín.",
              "uk": "Я не склав статистику, іду на перескладання."
            },
            {
              "sk": "Ako ti dopadla skúška? — Mám Céčko.",
              "uk": "Як пройшов іспит? — У мене C."
            }
          ],
          "shortRule": "prepadnúť z/zo + родовий · opravný termín · A–FX",
          "commonMistakes": [
            {
              "mistake": "prepadol som skúšku",
              "correct": "prepadol som na skúške"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Písomná і ústna skúška",
          "text": "«Písomná skúška» — письмова (тест, есе), «ústna skúška» — усна: витягуєш питання («ťaháš si otázku»), трохи готуєшся й відповідаєш перед «skúšajúcim» (екзаменатором). «Skúškové obdobie» (сесія) — період іспитів, у розмові просто «skúškové». «Ťahák» (шпаргалка) на іспиті заборонений — через нього можуть вигнати з іспиту.",
          "examples": [
            {
              "sk": "Ústna skúška trvá asi dvadsať minút.",
              "uk": "Усний іспит триває приблизно двадцять хвилин."
            },
            {
              "sk": "Počas skúškového mám päť skúšok.",
              "uk": "Під час сесії в мене п’ять іспитів."
            }
          ],
          "shortRule": "písomná × ústna skúška",
          "button": "Далі →"
