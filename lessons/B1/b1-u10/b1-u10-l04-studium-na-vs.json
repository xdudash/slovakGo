      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ступені й форми",
          "text": "Вища освіта має три ступені: «bakalársky» (зазвичай 3 роки, титул Bc.), «magisterský» або «inžiniersky» (зазвичай ще 2 роки, Mgr. чи Ing.) і «doktorandský» (PhD.). Навчатися можна «denne» (денна форма, заняття щодня) або «externe» (заочна форма, найчастіше в п’ятницю й суботу, поряд із роботою). Денне навчання словацькою мовою в публічних (verejných) вишах зазвичай безкоштовне (у межах стандартної тривалості), заочне часто платне.",
          "examples": [
            {
              "sk": "Študujem externe, lebo cez týždeň pracujem.",
              "uk": "Я навчаюся заочно, бо протягом тижня працюю."
            },
            {
              "sk": "Po bakalárskom štúdiu pokračujem na magisterskom.",
              "uk": "Після бакалаврату я продовжую навчання в магістратурі."
            }
          ],
          "shortRule": "Bc. → Mgr. / Ing. → PhD.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Навчальний процес",
          "text": "Університет ділиться на «fakulty»; навчальний рік — на «zimný» і «letný semester». На «prednáške» (лекції) говорить викладач, на «seminári» чи «cvičení» студенти працюють активно. За кожен предмет отримуєш «kredity»; щоб закрити предмет, потрібен «zápočet» (залік) або «skúška». Предмети на семестр собі записуєш: «zapísať si predmet».",
          "examples": [
            {
              "sk": "Na prednášky chodím, ale na semináre je dochádzka povinná.",
              "uk": "На лекції я ходжу, але на семінари відвідування обов’язкове."
            },
            {
              "sk": "Tento semester som si zapísal šesť predmetov.",
              "uk": "Цього семестру я записався на шість предметів."
            }
          ],
          "shortRule": "prednáška · seminár · zápočet · kredity",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли й де",
          "text": "Час: «v zimnom semestri», «v prvom ročníku», «počas semestra» (протягом семестру). Місце: «na fakulte», «na prednáške», «na seminári» (місцевий); куди: «na prednášku», «na fakultu» (знахідний). Курс навчання — «ročník»: «Som v druhom ročníku.» Слово «kurz» тут не вживають.",
          "examples": [
            {
              "sk": "V letnom semestri mám prednášky aj v piatok.",
              "uk": "У літньому семестрі в мене лекції й у п’ятницю."
            },
            {
              "sk": "Som v treťom ročníku na Filozofickej fakulte.",
              "uk": "Я на третьому курсі філософського факультету."
            }
          ],
          "shortRule": "v + місцевий (час) · na + місцевий × na + знахідний",
          "commonMistakes": [
            {
              "mistake": "v zimný semester",
              "correct": "v zimnom semestri"
            },
            {
              "mistake": "Som na druhom kurze.",
              "correct": "Som v druhom ročníku."
            }
          ],
          "button": "Далі →"
        }
