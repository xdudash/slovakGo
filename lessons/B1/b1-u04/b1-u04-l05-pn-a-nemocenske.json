      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ти захворів",
          "text": "Спершу повідом роботодавця: «Dnes neprídem, som chorý, idem k lekárovi.» «Ošetrujúci lekár» (лікуючий лікар) визнає тебе тимчасово непрацездатним — «dočasná pracovná neschopnosť», розмовно «PN», «byť na PN-ke». Сьогодні лікар здебільшого оформлює лікарняний електронно — «ePN», і дані йдуть до Sociálnej poisťovne. Роботодавець зазвичай дізнається про нього, але повідомити самому однаково варто.",
          "examples": [
            {
              "sk": "Ošetrujúci lekár mi vystavil PN.",
              "uk": "Лікуючий лікар виписав мені лікарняний."
            },
            {
              "sk": "Som na PN-ke od pondelka.",
              "uk": "Я на лікарняному з понеділка."
            }
          ],
          "shortRule": "byť na PN-ke · vystaviť PN",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Хто платить",
          "text": "За перші дні лікарняного зазвичай платить zamestnávateľ — це «náhrada príjmu» (компенсація доходу). Далі, якщо ти застрахований, «nemocenské» (допомогу по хворобі) виплачує «Sociálna poisťovňa». Обидві суми — лише частина твого заробітку, тому на лікарняному ти отримуєш менше, ніж зазвичай.",
          "examples": [
            {
              "sk": "Prvé dni PN mi platí zamestnávateľ.",
              "uk": "Перші дні лікарняного мені оплачує роботодавець."
            },
            {
              "sk": "Potom dostávam nemocenské zo Sociálnej poisťovne.",
              "uk": "Потім я отримую допомогу по хворобі від Соціальної страхової установи."
            }
          ],
          "shortRule": "náhrada príjmu → nemocenské",
          "commonMistakes": [
            {
              "mistake": "od Sociálna poisťovňa",
              "correct": "od Sociálnej poisťovne"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Режим і виходи",
          "text": "На PN ти маєш дотримуватися «liečebného režimu» — лікувального режиму: бути за адресою, яку вказав, і лікуватися. Лікар може дозволити «vychádzky» — виходи з дому в певні години. Sociálna poisťovňa може це перевірити, і за порушення режиму можуть забрати nemocenské.",
          "examples": [
            {
              "sk": "Lekár mi povolil vychádzky od desiatej do dvanástej.",
              "uk": "Лікар дозволив мені виходити з десятої до дванадцятої."
