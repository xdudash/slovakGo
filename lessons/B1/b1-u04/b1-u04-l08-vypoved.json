      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три шляхи",
          "text": "Трудові відносини можна закінчити «dohodou» — за згодою обох сторін до погодженої дати; «výpoveďou» — односторонньою письмовою заявою з výpovednou lehotou; або «okamžitým skončením» — негайно, але лише у виняткових випадках, які визначає закон (наприклад, тяжке порушення дисципліни; працівник теж може, якщо йому, скажімо, не виплатили зарплату). Під час skúšobnej doby закінчити відносини простіше. Усе — письмово.",
          "examples": [
            {
              "sk": "Pracovný pomer sme skončili dohodou k tridsiatemu júnu.",
              "uk": "Ми закінчили трудові відносини за домовленістю до тридцятого червня."
            },
            {
              "sk": "Okamžité skončenie je možné len výnimočne.",
              "uk": "Негайне припинення можливе лише у виняткових випадках."
            }
          ],
          "shortRule": "dohoda · výpoveď · okamžité skončenie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Підстава для звільнення",
          "text": "Працівник може дати výpoveď з будь-якої причини або й без пояснення. Роботодавець — лише з «výpovedného dôvodu», який визначає Zákonník práce: наприклад, «nadbytočnosť» (посада стала непотрібна через організаційні зміни), закриття фірми, порушення дисципліни. За деяких причин, як-от nadbytočnosť, зазвичай належить «odstupné» — вихідна допомога.",
          "examples": [
            {
              "sk": "Zamestnávateľ mi dal výpoveď pre nadbytočnosť.",
              "uk": "Роботодавець звільнив мене через скорочення."
            },
            {
              "sk": "Pri organizačných dôvodoch mám zvyčajne nárok na odstupné.",
              "uk": "За організаційних причин я зазвичай маю право на вихідну допомогу."
            }
          ],
          "shortRule": "výpoveď pre + знахідний · nárok na odstupné",
          "commonMistakes": [
            {
              "mistake": "výpoveď pre nadbytočnosti",
              "correct": "výpoveď pre nadbytočnosť"
            },
            {
              "mistake": "nárok na odstupného",
              "correct": "nárok na odstupné"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Документи при звільненні",
          "text": "Наприкінці роботодавець видає тобі «potvrdenie o zamestnaní» — документ про те, скільки ти працював(ла), про утримання тощо; він потрібен новому роботодавцю чи úradu práce. Розмовно його досі називають «zápočtový list». На твоє прохання тобі мають видати й «pracovný posudok» — характеристику з роботи. Výpoveď пишуть коротко: «Týmto Vám dávam výpoveď z pracovného pomeru…».",
          "examples": [
            {
              "sk": "Týmto Vám dávam výpoveď z pracovného pomeru.",
              "uk": "Цим я заявляю про звільнення з роботи."
            },
            {
              "sk": "Pri odchode som dostal potvrdenie o zamestnaní.",
              "uk": "Під час звільнення я отримав довідку про працевлаштування."
            }
          ],
          "shortRule": "Týmto Vám dávam výpoveď… · potvrdenie o zamestnaní",
          "button": "Далі →"
        }
