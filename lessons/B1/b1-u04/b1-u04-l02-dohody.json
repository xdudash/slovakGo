      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке dohoda",
          "text": "Окрім pracovnej zmluvy, Zákonník práce знає угоди про роботу поза трудовими відносинами — «dohody o prácach vykonávaných mimo pracovného pomeru». Найчастіші: «dohoda o vykonaní práce» (скорочено DoVP) — для конкретного разового завдання, наприклад перекладу чи ремонту, і «dohoda o brigádnickej práci študentov» — для учнів і студентів. Третя — «dohoda o pracovnej činnosti». Усі угоди укладають письмово, і всі мають законне обмеження кількості годин. Розмовно: «robiť na dohodu».",
          "examples": [
            {
              "sk": "Preklad zmluvy robím na dohodu o vykonaní práce.",
              "uk": "Переклад договору я роблю за угодою про виконання роботи."
            },
            {
              "sk": "Cez leto pracujem na brigádnickú dohodu.",
              "uk": "Улітку я працюю за студентською угодою."
            }
          ],
          "shortRule": "pracovať na dohodu · na + знахідний",
          "commonMistakes": [
            {
              "mistake": "pracovať na dohoda",
              "correct": "pracovať na dohodu"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Бригада для студентів",
          "text": "«Dohoda o brigádnickej práci študentov» — для учнів середніх шкіл і студентів денної форми до певного віку. Роботодавець зазвичай просить «potvrdenie o štúdiu» — довідку про навчання. Кількість годин на тиждень у середньому обмежена законом. Людину на такій роботі називають «brigádnik» / «brigádnička», а саму роботу — «brigáda». На угоду не належить skúšobná doba, а оплачувана dovolenka зазвичай теж ні.",
          "examples": [
            {
              "sk": "Na dohodu potrebujem potvrdenie o štúdiu.",
              "uk": "Для угоди мені потрібна довідка про навчання."
            },
            {
              "sk": "V sklade cez leto pracuje päť brigádnikov.",
              "uk": "Улітку на складі працює п’ятеро студентів на підробітку."
            }
          ],
          "shortRule": "brigádnik · potvrdenie o štúdiu",
          "commonMistakes": [
            {
              "mistake": "päť brigádnici",
              "correct": "päť brigádnikov"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Обсяг і винагорода",
          "text": "В угоді вказують «rozsah práce» (обсяг роботи, зазвичай у годинах) і «odmenu» — винагороду. За угодою отримуєш саме odmenu, не mzdu. У DoVP ще описують результат — що саме треба зробити й до якого строку. Звороти: «v rozsahu desať hodín týždenne», «dohodnúť sa na rozsahu», «odmena za prácu».",
          "examples": [
            {
              "sk": "Dohodli sme sa na rozsahu dvadsať hodín mesačne.",
              "uk": "Ми домовилися про обсяг двадцять годин на місяць."
            },
            {
              "sk": "Odmena je splatná po odovzdaní práce.",
              "uk": "Винагороду виплачують після здачі роботи."
            }
          ],
          "shortRule": "v rozsahu… · odmena za + знахідний",
          "button": "Далі →"
        }
