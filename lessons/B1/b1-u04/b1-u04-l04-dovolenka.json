      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Право на відпустку",
          "text": "Працівник за pracovnou zmluvou має «nárok na dovolenku» — право на оплачувану відпустку. Її тривалість визначає Zákonník práce (вона залежить, наприклад, від віку чи догляду за дитиною), а роботодавець може дати й більше. За дні відпустки ти отримуєш «náhradu mzdy» — компенсацію заробітку. Про використання відпустки кажуть «čerpať dovolenku».",
          "examples": [
            {
              "sk": "Tento rok mám ešte nárok na desať dní dovolenky.",
              "uk": "Цього року я ще маю право на десять днів відпустки."
            },
            {
              "sk": "Za dni dovolenky dostanem náhradu mzdy.",
              "uk": "За дні відпустки я отримаю компенсацію заробітку."
            }
          ],
          "shortRule": "nárok na dovolenku · čerpať dovolenku",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як попросити відпустку",
          "text": "Відпустку зазвичай погоджує керівник — «schváli». Багато фірм на початку року складають «plán dovoleniek». Ти подаєш «žiadosť o dovolenku» — у системі або на бланку. Фрази: «Chcel/Chcela by som si zobrať dovolenku od… do…», «Mohli by ste mi schváliť dovolenku na budúci týždeň?» Дати: «od + родовий do + родовий»: od tretieho do štrnásteho augusta.",
          "examples": [
            {
              "sk": "Chcela by som si zobrať dovolenku od prvého do desiateho júla.",
              "uk": "Я хотіла б узяти відпустку з першого по десяте липня."
            },
            {
              "sk": "Dovolenku mi vedúci už schválil.",
              "uk": "Керівник мені вже погодив відпустку."
            }
          ],
          "shortRule": "zobrať si dovolenku od… do… + родовий",
          "commonMistakes": [
            {
              "mistake": "od prvý do desiaty",
              "correct": "od prvého do desiateho"
            },
            {
              "mistake": "zobrať dovolenka",
              "correct": "zobrať si dovolenku"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Загальна й невикористана відпустка",
          "text": "Роботодавець може визначити «celozávodnú dovolenku» — спільну відпустку для всіх, наприклад улітку чи між святами, коли виробництво не працює; про це він зазвичай повідомляє заздалегідь. «Nevyčerpaná dovolenka» — невикористана відпустка — зазвичай переходить на наступний рік. Грошима її «preplatia» (компенсують) зазвичай лише тоді, коли трудові відносини закінчуються.",
          "examples": [
            {
              "sk": "Nevyčerpanú dovolenku mi preplatia pri skončení pracovného pomeru.",
              "uk": "Невикористану відпустку мені компенсують грошима при звільненні."
            },
            {
              "sk": "Medzi sviatkami máme celozávodnú dovolenku.",
              "uk": "Між святами в нас загальна відпустка на підприємстві."
            }
          ],
          "shortRule": "preplatiť — zvyčajne len pri skončení pracovného pomeru",
          "button": "Далі →"
        }
