      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке nadčas",
          "text": "«Práca nadčas» — робота «nad rámec» (понад межі) встановленого тижневого робочого часу, яку працівник виконує за наказом або за згодою роботодавця. Скільки годин на тиждень у тебе встановлено, дивись у договорі. «Nadčas» — це іменник («mám dva nadčasy»), а в «pracovať nadčas» — прислівник. Пишемо разом!",
          "examples": [
            {
              "sk": "Tento týždeň som pracoval šesť hodín nadčas.",
              "uk": "Цього тижня я працював шість годин понаднормово."
            },
            {
              "sk": "Robíme nad rámec pracovného času.",
              "uk": "Ми працюємо понад робочий час."
            }
          ],
          "shortRule": "pracovať nadčas · nad rámec + родовий",
          "commonMistakes": [
            {
              "mistake": "pracovať nad čas",
              "correct": "pracovať nadčas"
            },
            {
              "mistake": "nad rámec pracovný čas",
              "correct": "nad rámec pracovného času"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Наказати чи домовитися",
          "text": "Zamestnávateľ може «nariadiť» (наказати) понаднормову роботу лише «výnimočne» — у виняткових випадках, наприклад за тимчасової й термінової потреби, — і лише в обмеженому обсязі на рік, як визначає Zákonník práce. Понад цей обсяг — тільки за твоєю згодою. Між змінами та на вихідних тобі належить «odpočinok» — відпочинок.",
          "examples": [
            {
              "sk": "Šéf nám nariadil nadčasy na sobotu.",
              "uk": "Шеф наказав нам працювати понаднормово в суботу."
            },
            {
              "sk": "Nad tento rozsah môžem robiť nadčasy len so svojím súhlasom.",
              "uk": "Понад цей обсяг я можу працювати понаднормово лише за своєю згодою."
            }
          ],
          "shortRule": "nariadiť × dohodnúť · so súhlasom",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що тобі належить",
          "text": "За nadčas ти отримуєш звичайну зарплату плюс «príplatok» — доплату. Замість доплати можна домовитися про «náhradné voľno» — відгул. Кожну годину записують у «dochádzku» — облік робочого часу; перевіряй її щомісяця. Окрема річ — «pracovná pohotovosť»: ти чекаєш на можливий виклик, наприклад удома, і за це теж зазвичай належить оплата.",
          "examples": [
            {
              "sk": "Za sobotu si zoberiem náhradné voľno.",
              "uk": "За суботу я візьму відгул."
            },
            {
              "sk": "V dochádzke mi chýbajú dve hodiny nadčasu.",
              "uk": "В обліку робочого часу мені бракує двох годин понаднормових."
            }
          ],
          "shortRule": "príplatok alebo náhradné voľno · dochádzka",
          "button": "Далі →"
        }
      ],
