      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що робить інспекція",
          "text": "«Inšpektorát práce» перевіряє, чи роботодавці дотримуються трудового законодавства: договори, зарплата, робочий час, відпочинок, BOZP (безпека праці) і нелегальна праця. У кожному краї є свій inšpektorát, а керує ними Národný inšpektorát práce. Інспекція також зазвичай безкоштовно консультує працівників і роботодавців.",
          "examples": [
            {
              "sk": "Inšpektorát práce kontroluje dodržiavanie Zákonníka práce.",
              "uk": "Інспекція праці контролює дотримання Трудового кодексу."
            },
            {
              "sk": "Na inšpektoráte mi bezplatne poradili.",
              "uk": "В інспекції мені безкоштовно порадили."
            }
          ],
          "shortRule": "kontrolovať dodržiavanie + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Нелегальна праця й порушення",
          "text": "«Nelegálna práca» — це, наприклад, робота без письмового договору чи угоди або коли роботодавець не зареєстрував працівника в Sociálnej poisťovni; для іноземця — ще й робота без потрібного дозволу. Ризикує не лише роботодавець: без реєстрації ти не маєш страхування. Коли роботодавець не платить nadčasy чи не дає відпочити, він «porušuje» закон (porušiť — порушити).",
          "examples": [
            {
              "sk": "Pracovať bez zmluvy je nelegálna práca.",
              "uk": "Працювати без договору — це нелегальна праця."
            },
            {
              "sk": "Zamestnávateľ porušil Zákonník práce.",
              "uk": "Роботодавець порушив Трудовий кодекс."
            }
          ],
          "shortRule": "porušiť + знахідний",
          "commonMistakes": [
            {
              "mistake": "porušil Zákonníka práce",
              "correct": "porušil Zákonník práce"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як подати звернення",
          "text": "«Podnet» — звернення (скарга) до інспекції. Його можна подати písomne, elektronicky або osobne. Опиши факти — хто, що, коли — і додай докази: dochádzku, výplatné pásky, повідомлення. Можна попросити не розголошувати твоє ім’я або подати podnet «anonymne», але тоді інспекція не зможе тобі відповісти. Права працівників колективно захищають «odbory» — профспілки.",
          "examples": [
            {
              "sk": "Podal som podnet na inšpektorát práce.",
              "uk": "Я подав звернення до інспекції праці."
            },
            {
              "sk": "Podnet môžete podať aj anonymne.",
              "uk": "Звернення можна подати й анонімно."
            }
          ],
          "shortRule": "podať podnet na inšpektorát práce",
          "commonMistakes": [
