      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Договір і робочий час",
          "text": "Pracovná zmluva: druh práce, miesto výkonu práce, deň nástupu, mzda — písomne; зміни — dodatkom. Dohody: DoVP — на разове завдання, brigádnicka — для студентів із potvrdením o štúdiu. Nadčas — лише výnimočne, з príplatkom або náhradným voľnom. Dovolenka: žiadosť o dovolenku, plán dovoleniek, náhrada mzdy.",
          "examples": [
            {
              "sk": "Zmluvu mám na dobu neurčitú a nadčasy mi platia s príplatkom.",
              "uk": "У мене безстроковий договір, і понаднормові мені оплачують із доплатою."
            },
            {
              "sk": "Dovolenku mi vedúca schválila od tretieho do štrnásteho augusta.",
              "uk": "Керівниця погодила мені відпустку з третього по чотирнадцяте серпня."
            }
          ],
          "shortRule": "písomne · nad rámec · od… do… + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Хвороба й гроші",
          "text": "PN: ošetrujúci lekár, ePN; перші дні — náhrada príjmu від роботодавця, далі — nemocenské від Sociálnej poisťovne; дотримуйся liečebného režimu й vychádzok. Mzda: hrubá → odvody a preddavok na daň → čistá; daňový bonus на дітей; ročné zúčtovanie на початку року.",
          "examples": [
            {
              "sk": "Prvé dni PN mi platí firma, potom Sociálna poisťovňa.",
              "uk": "Перші дні лікарняного мені оплачує фірма, потім Соціальна страхова."
            },
            {
              "sk": "Z ročného zúčtovania mi vrátili preplatok.",
              "uk": "За річним перерахунком мені повернули переплату."
            }
          ],
          "shortRule": "náhrada príjmu → nemocenské · hrubá → čistá mzda",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Кінець роботи й захист прав",
          "text": "Výpoveď — písomne; výpovedná lehota зазвичай plynie з першого дня наступного місяця. Роботодавцю потрібен výpovedný dôvod; при nadbytočnosti зазвичай належить odstupné. Наприкінці — potvrdenie o zamestnaní. Порушення — podnet na inšpektorát práce, можна й anonymne. Усе це регулює «Zákonník práce» (Трудовий кодекс). Порада — у «právnej poradni» чи в odboroch.",
          "examples": [
            {
              "sk": "Podľa Zákonníka práce mi patrí odstupné.",
              "uk": "Відповідно до Трудового кодексу мені належить вихідна допомога."
            },
            {
              "sk": "Ak zamestnávateľ porušuje vaše práva, obráťte sa na inšpektorát práce.",
              "uk": "Якщо роботодавець порушує ваші права, зверніться до інспекції праці."
            }
          ],
          "shortRule": "podľa Zákonníka práce · obrátiť sa na + знахідний",
          "button": "Далі →"
        }
      ],
