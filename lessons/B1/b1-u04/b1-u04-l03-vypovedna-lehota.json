      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Коли строк починається",
          "text": "За Zákonníkom práce výpovedná lehota зазвичай починає «plynúť» (спливати, тривати) з першого дня місяця, що настає після вручення výpovede, і закінчується останнім днем відповідного місяця. Тобто: výpoveď вручено 10 березня → строк починається 1 квітня. Про кінець строку кажемо «lehota uplynie» — строк спливе.",
          "examples": [
            {
              "sk": "Výpoveď som odovzdal pätnásteho mája, lehota začne plynúť prvého júna.",
              "uk": "Я подав заяву про звільнення п’ятнадцятого травня, строк почне спливати першого червня."
            },
            {
              "sk": "Výpovedná lehota uplynie tridsiateho júna.",
              "uk": "Строк попередження спливе тридцятого червня."
            }
          ],
          "shortRule": "plynie od prvého dňa nasledujúceho mesiaca",
          "commonMistakes": [
            {
              "mistake": "od prvý deň",
              "correct": "od prvého dňa"
            },
            {
              "mistake": "do koniec mesiaca",
              "correct": "do konca mesiaca"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Скільки він триває",
          "text": "Тривалість залежить від того, хто дає výpoveď і як довго ти працюєш у цього роботодавця: зазвичай від одного до кількох місяців, при довшому стажі — довше. Точну тривалість дивись у Zákonníku práce і своєму договорі; довший строк можна домовитися в договорі. Строк рахують у «kalendárnych mesiacoch» — календарних місяцях.",
          "examples": [
            {
              "sk": "Pri dlhšom zamestnaní je výpovedná lehota dlhšia.",
              "uk": "За довшого стажу строк попередження довший."
            },
            {
              "sk": "Výpovedná lehota je dva kalendárne mesiace.",
              "uk": "Строк попередження — два календарні місяці."
            }
          ],
          "shortRule": "dĺžka lehoty závisí od odpracovaných rokov",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відпрацювання",
          "text": "Під час строку ти зазвичай працюєш як звичайно — «odpracuješ výpovednú lehotu» — і отримуєш зарплату. Якщо хочеш піти раніше, можна домовитися з роботодавцем закінчити роботу «dohodou» до погодженої дати. «Posledný pracovný deň» — останній робочий день.",
          "examples": [
            {
              "sk": "Výpovednú lehotu si odpracujem do konca júla.",
              "uk": "Строк попередження я відпрацюю до кінця липня."
            },
            {
              "sk": "Môj posledný pracovný deň bude tridsiateho septembra.",
              "uk": "Мій останній робочий день буде тридцятого вересня."
            }
          ],
          "shortRule": "odpracovať lehotu · posledný pracovný deň",
          "button": "Далі →"
        }
      ],
