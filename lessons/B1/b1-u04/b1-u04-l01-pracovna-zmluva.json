      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що обов’язково є в договорі",
          "text": "«Pracovná zmluva» — трудовий договір між zamestnávateľom і zamestnancom. Згідно із Zákonníkom práce її укладають «písomne» (письмово), і кожна сторона отримує свій примірник — «vyhotovenie». Обов’язкові пункти — «náležitosti»: «druh práce» (вид роботи, посада), «miesto výkonu práce» (місце, де ти фактично працюєш), «deň nástupu do práce» (день початку роботи) і «mzdové podmienky» (умови оплати), якщо їх не визначає колективний договір.",
          "examples": [
            {
              "sk": "Pracovná zmluva sa uzatvára písomne.",
              "uk": "Трудовий договір укладають письмово."
            },
            {
              "sk": "Deň nástupu do práce je prvého marca.",
              "uk": "День початку роботи — перше березня."
            }
          ],
          "shortRule": "druh práce · miesto výkonu práce · deň nástupu · mzda",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Строковий чи безстроковий",
          "text": "Договір буває «na dobu neurčitú» (безстроковий) або «na dobu určitú» (строковий, до певної дати). Якщо строк у договорі не вказано, трудові відносини зазвичай вважаються безстроковими. У договорі часто є й «skúšobná doba» — випробувальний термін; її треба домовити письмово, і закон обмежує її тривалість. Після «na» — знахідний відмінок: «na dobu určitú do konca roka».",
          "examples": [
            {
              "sk": "Zmluvu mám na dobu určitú do konca roka.",
              "uk": "Договір у мене строковий до кінця року."
            },
            {
              "sk": "Ak doba nie je v zmluve uvedená, ide o pracovný pomer na dobu neurčitú.",
              "uk": "Якщо строк у договорі не вказано, ідеться про безстрокові трудові відносини."
            }
          ],
          "shortRule": "na dobu určitú × na dobu neurčitú",
          "commonMistakes": [
            {
              "mistake": "Zmluvu mám na dobu určitá.",
              "correct": "Zmluvu mám na dobu určitú."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перед підписом",
          "text": "Перш ніж підписати, спитай: «Aký je presne druh práce?», «Kde je miesto výkonu práce?», «Je mzda uvedená v hrubom?» Зміни в договорі можливі лише за згодою обох сторін і письмово — через «dodatok k pracovnej zmluve» (додаток, додаткову угоду). Корисні звороти: «podpísať zmluvu» (знахідний), «v zmluve je uvedené…» (у договорі зазначено…).",
          "examples": [
            {
              "sk": "Mzda je v zmluve uvedená v hrubom.",
              "uk": "Зарплата в договорі вказана брутто."
            },
            {
              "sk": "Zmenu pracovného času sme dohodli dodatkom k zmluve.",
              "uk": "Зміну робочого часу ми погодили додатком до договору."
            }
          ],
          "shortRule": "dodatok k zmluve · v zmluve je uvedené",
