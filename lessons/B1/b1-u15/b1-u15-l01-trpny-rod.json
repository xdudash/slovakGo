      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке trpný rod",
          "text": "Пасив (trpný rod) показує, що з предметом щось зроблено; важливий результат, а не той, хто це зробив. Будуємо його так: byť + пасивний дієприкметник: «Obchod je otvorený.» «Most bol postavený v roku 1972.» «Výsledky budú zverejnené v piatok.» Час показує лише дієслово byť: je / bol / bude.",
          "examples": [
            {
              "sk": "Kancelária je otvorená do 16:00.",
              "uk": "Офіс відчинений до 16:00."
            },
            {
              "sk": "Dom bol postavený pred sto rokmi.",
              "uk": "Будинок збудували сто років тому."
            }
          ],
          "shortRule": "byť + -ný / -tý · час — у byť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як утворити дієприкметник",
          "text": "Від інфінітива: -ať → -aný (napísať → napísaný, poslať → poslaný), -iť → -ený (postaviť → postavený, otvoriť → otvorený, kúpiť → kúpený), -núť → -nutý (zabudnúť → zabudnutý). Закінчення -tý мають і короткі дієслова та дієслова на -jať: umyť → umytý, zavrieť → zavretý, prijať → prijatý, začať → začatý.",
          "examples": [
            {
              "sk": "Žiadosť bola prijatá.",
              "uk": "Заяву прийнято."
            },
            {
              "sk": "Okno je rozbité.",
              "uk": "Вікно розбите."
            }
          ],
          "shortRule": "-aný · -ený · -nutý · -tý",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Узгодження і виконавець",
          "text": "Дієприкметник узгоджується з підметом як прикметник: «obchod je otvorený», «kancelária je otvorená», «okno je otvorené», «obchody sú otvorené». Чоловічий рід, істоти, множина — на -í: «Zamestnanci boli informovaní.» Byť теж узгоджується: bol / bola / bolo / boli. Виконавця (якщо він важливий) ставимо в орудний відмінок без прийменника: «Most bol postavený firmou zo Žiliny.»",
          "examples": [
            {
              "sk": "Zamestnanci boli informovaní e-mailom.",
              "uk": "Працівників поінформували е-мейлом."
            },
            {
              "sk": "Hrad bol obnovený štátom.",
              "uk": "Замок відновила держава."
            }
          ],
          "shortRule": "otvorený / otvorená / otvorené / informovaní",
          "commonMistakes": [
            {
              "mistake": "Kancelária je otvorený.",
              "correct": "Kancelária je otvorená."
            },
            {
              "mistake": "Zamestnanci boli informované.",
              "correct": "Zamestnanci boli informovaní."
            },
            {
              "mistake": "Most bol postavený od firmy.",
              "correct": "Most bol postavený firmou."
            }
          ],
          "button": "Далі →"
        }
      ],
