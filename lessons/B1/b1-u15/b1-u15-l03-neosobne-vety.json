      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hovorí sa, pracuje sa",
          "text": "Дієслово в 3-й особі однини + sa без підмета означає, що «люди так роблять» загалом: «Hovorí sa, že…» — кажуть, що… «V lete sa dlho pracuje.» «Tu sa nefajčí.» — тут не курять. У минулому — середній рід: «hovorilo sa», «pracovalo sa».",
          "examples": [
            {
              "sk": "Hovorí sa, že zima bude tuhá.",
              "uk": "Кажуть, що зима буде сувора."
            },
            {
              "sk": "V našej firme sa pracuje aj v sobotu.",
              "uk": "У нашій фірмі працюють і в суботу."
            }
          ],
          "shortRule": "3 ос. одн. + sa · минуле: -lo sa",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Treba, netreba",
          "text": "«Treba» + інфінітив — треба: «Treba vyplniť tlačivo.» У теперішньому часі без «je»; у минулому — «bolo treba», у майбутньому — «bude treba». Заперечення — «netreba»: не треба. Кому треба — давальний відмінок: «Treba ti niečo?» Офіційно замість «treba» пишуть «je potrebné» + інфінітив, а «nemožno» — неможливо, не можна.",
          "examples": [
            {
              "sk": "Bolo treba čakať dve hodiny.",
              "uk": "Треба було чекати дві години."
            },
            {
              "sk": "Netreba sa báť.",
              "uk": "Не треба боятися."
            }
          ],
          "shortRule": "treba · bolo treba · bude treba · netreba",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dá sa, nesmie sa, vraj",
          "text": "«Dá sa» — можна, є можливість: «Dá sa tu zaparkovať?» «Nedá sa nič robiť.» — нічого не вдієш. «Nesmie sa» — заборонено: «V lese sa nesmie zakladať oheň.» «Musí sa» — обов’язково треба. «Vraj» — нібито, кажуть (передаємо чужі слова): «Vraj bude pršať.»",
          "examples": [
            {
              "sk": "Dá sa tu platiť kartou?",
              "uk": "Тут можна платити карткою?"
            },
            {
              "sk": "Vraj zdražie benzín.",
              "uk": "Кажуть, бензин подорожчає."
            }
          ],
          "shortRule": "dá sa (можливо) · nesmie sa (заборонено) · vraj (кажуть)",
          "commonMistakes": [
            {
              "mistake": "Bol treba čakať.",
              "correct": "Bolo treba čakať."
