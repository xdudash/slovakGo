      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Інфінітив в інструкціях",
          "text": "На упаковках і в інструкціях часто пишуть інфінітив замість наказового способу: «Pred použitím pretrepať.» «Uchovávať mimo dosahu detí.» «Skladovať v suchu.» Так коротше й безособово. Коли звертаються до людини напряму — наказовий спосіб: «Pred použitím pretrepte.»",
          "examples": [
            {
              "sk": "Pred použitím pretrepať.",
              "uk": "Перед використанням збовтати."
            },
            {
              "sk": "Uchovávať pri teplote do 25 °C.",
              "uk": "Зберігати за температури до 25 °C."
            }
          ],
          "shortRule": "інфінітив = наказ в інструкції",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Кроки процесу",
          "text": "Етапи роботи в рецептах і описах описуємо зворотним пасивом: «Rúra sa predhreje na 180 °C.» «Múka sa zmieša s cukrom.» «Cesto sa nechá odpočívať.» Порядок: «najprv» (спершу), «potom» (потім), «nakoniec» (наостанок). Дієслово узгоджується з підметом: «Vajcia sa zmiešajú s cukrom.»",
          "examples": [
            {
              "sk": "Prášok sa rozpustí v pohári vody.",
              "uk": "Порошок розчиняють у склянці води."
            },
            {
              "sk": "Zmes sa nechá 10 minút postáť.",
              "uk": "Суміш залишають на 10 хвилин."
            }
          ],
          "shortRule": "sa + 3 ос. — крок процесу",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odporúča sa, je určený",
          "text": "«Odporúča sa» — рекомендується: «Odporúča sa užívať po jedle.» Заперечення: «Neodporúča sa…». «Výrobok je určený pre deti od 3 rokov.» — призначений для… «Postup» — порядок дій.",
          "examples": [
            {
              "sk": "Liek je určený pre dospelých.",
              "uk": "Ліки призначені для дорослих."
            },
            {
              "sk": "Neodporúča sa prať pri vysokej teplote.",
              "uk": "Не рекомендується прати за високої температури."
            }
          ],
          "shortRule": "odporúča sa · je určený pre…",
          "commonMistakes": [
