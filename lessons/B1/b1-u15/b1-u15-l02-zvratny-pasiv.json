      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Найчастіший пасив",
          "text": "У живій мові словаки рідко кажуть «byt je predávaný». Природніше: «Byt sa predáva.» Це зворотний пасив: дієслово в 3-й особі + sa. Українською — «продається», «продають», «шукаємо». Саме так пишуть оголошення: «Predáva sa…», «Hľadá sa…», «Ponúka sa…».",
          "examples": [
            {
              "sk": "Predáva sa byt v centre.",
              "uk": "Продається квартира в центрі."
            },
            {
              "sk": "Lístky sa kupujú v automate.",
              "uk": "Квитки купують в автоматі."
            }
          ],
          "shortRule": "дієслово (3 ос.) + sa",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Однина чи множина",
          "text": "Дієслово узгоджується з тим, що продається чи шукається: «Hľadá sa vodič.» — «Hľadajú sa vodiči.» «Predáva sa auto.» — «Predávajú sa autá.» У минулому — l-форма за родом і числом: «Byt sa predal za týždeň.» «Lístky sa predali za hodinu.» «Most sa staval tri roky.»",
          "examples": [
            {
              "sk": "Hľadajú sa brigádnici na leto.",
              "uk": "Шукаємо тимчасових працівників на літо."
            },
            {
              "sk": "Výsledky sa zverejnili v piatok.",
              "uk": "Результати оприлюднили в п’ятницю."
            }
          ],
          "shortRule": "hľadá sa vodič · hľadajú sa vodiči",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Процес чи результат",
          "text": "Зворотний пасив описує процес, звичку, правило: «Tu sa platí pri pokladni.» Trpný rod з byť частіше описує результат, стан: «Byt je predaný.» — квартиру вже продано. Виконавця у зворотному пасиві не називаємо. Sa стоїть на другому місці в реченні: «V tejto predajni sa predáva aj chlieb.»",
          "examples": [
            {
              "sk": "Byt sa predáva.",
              "uk": "Квартира продається (процес)."
            },
            {
              "sk": "Byt je predaný.",
              "uk": "Квартиру продано (результат)."
            }
          ],
          "shortRule": "proces: sa predáva · výsledok: je predaný",
