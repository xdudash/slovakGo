      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Пасив у новинах",
          "text": "Новини часто повідомляють про подію, не називаючи виконавця: «Za starostu bol zvolený Ján Kováč.» «V okrese bola vyhlásená mimoriadna situácia.» «Diaľnica bola po nehode uzavretá.» Виконавець, якщо він важливий, — в орудному відмінку: «schválený parlamentom».",
          "examples": [
            {
              "sk": "Nový zákon bol schválený parlamentom.",
              "uk": "Новий закон ухвалив парламент."
            },
            {
              "sk": "Obyvatelia boli evakuovaní.",
              "uk": "Мешканців евакуювали."
            }
          ],
          "shortRule": "bol zvolený · bola vyhlásená · boli evakuovaní",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Неособові формули",
          "text": "«Odhaduje sa, že…» — за оцінками… «Očakáva sa…» — очікується. «Uvádza sa…» — повідомляється. «Predpokladá sa…» — передбачається. «Škoda sa odhaduje na dva milióny eur.» — збитки оцінюють у…",
          "examples": [
            {
              "sk": "Očakáva sa, že ceny energií klesnú.",
              "uk": "Очікується, що ціни на енергію знизяться."
            },
            {
              "sk": "Škoda sa odhaduje na pol milióna eur.",
              "uk": "Збитки оцінюють у пів мільйона євро."
            }
          ],
          "shortRule": "odhaduje sa · očakáva sa · uvádza sa",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Údajne, podľa…",
          "text": "Журналіст не завжди певен: «údajne» — нібито, за неперевіреними даними; «podľa polície» — за даними поліції; «podľa svedkov» — за словами свідків. У розмові замість «údajne» кажуть «vraj».",
          "examples": [
            {
              "sk": "Požiar údajne spôsobila cigareta.",
              "uk": "Пожежу нібито спричинила цигарка."
            },
            {
              "sk": "Podľa hasičov nebol nikto zranený.",
              "uk": "За даними пожежників, ніхто не постраждав."
            }
          ],
          "shortRule": "údajne (новини) = vraj (розмова)",
          "commonMistakes": [
