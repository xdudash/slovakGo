      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три способи сказати одне",
          "text": "Активно: «Firma postavila most.» Trpný rod: «Most bol postavený (firmou).» Зворотний пасив: «Most sa postavil za dva roky.» (без виконавця). У живій мові часто просто міняють порядок слів: «Most postavila firma zo Žiliny.» — це актив, але в центрі уваги міст.",
          "examples": [
            {
              "sk": "Mesto opravilo cestu.",
              "uk": "Місто відремонтувало дорогу."
            },
            {
              "sk": "Cesta bola opravená.",
              "uk": "Дорогу відремонтовано."
            }
          ],
          "shortRule": "činný rod → trpný rod → zvratný pasív",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як перетворити",
          "text": "1) Знахідний відмінок стає підметом: «most» → «Most…». 2) Дієслово → byť у тому самому часі + дієприкметник, узгоджений з новим підметом: «postavila» → «bol postavený», «postaví» → «bude postavený». 3) Виконавець → орудний відмінок без прийменника або зникає: «firmou».",
          "examples": [
            {
              "sk": "Povolenie bolo vydané úradom.",
              "uk": "Дозвіл видала установа."
            },
            {
              "sk": "Pes bol zachránený hasičmi.",
              "uk": "Собаку врятували пожежники."
            }
          ],
          "shortRule": "akuzatív → podmet · byť + -ný · inštrumentál",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що звучить природно",
          "text": "Trpný rod із виконавцем звучить книжно; у розмові кращий актив: «Psa zachránili hasiči.» Без виконавця — зворотний пасив або неозначено-особове речення (3 ос. множини): «Cesta sa opravuje.» = «Cestu opravujú.» Пасив обирай, коли виконавець невідомий, неважливий або очевидний.",
          "examples": [
            {
              "sk": "Cestu opravujú už mesiac.",
              "uk": "Дорогу ремонтують уже місяць."
            },
            {
              "sk": "Cesta sa opravuje už mesiac.",
              "uk": "Дорога ремонтується вже місяць."
            }
          ],
          "shortRule": "розмова: актив · офіційно: пасив",
