      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Trpný rod",
          "text": "byť + -ný / -tý, узгодження з підметом: «obchod je otvorený», «žiadosť bola schválená», «okno je zavreté», «zamestnanci boli informovaní». Утворення: -ať → -aný, -iť → -ený, -núť → -nutý, umyť → umytý, prijať → prijatý. Виконавець — орудний відмінок: «schválený parlamentom».",
          "examples": [
            {
              "sk": "Žiadosť bola schválená.",
              "uk": "Заяву схвалено."
            },
            {
              "sk": "Zamestnanci boli informovaní.",
              "uk": "Працівників поінформовано."
            }
          ],
          "shortRule": "byť + -ný / -tý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Zvratný pasív a neosobné vety",
          "text": "«Predáva sa byt.» — «Predávajú sa byty.» — «Byt sa predal.» Неособові речення: «hovorí sa», «pracuje sa», «treba / bolo treba / netreba», «dá sa», «nesmie sa»; офіційно — «je potrebné», «nemožno».",
          "examples": [
            {
              "sk": "Hľadajú sa vodiči.",
              "uk": "Шукаємо водіїв."
            },
            {
              "sk": "Bolo treba čakať.",
              "uk": "Треба було чекати."
            }
          ],
          "shortRule": "sa + 3 ос. · treba + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де що вживати",
          "text": "Установи й новини: «bola zamietnutá», «bol zvolený», «odhaduje sa». Оголошення: «mimo prevádzky», «bol presunutý». Інструкції: інфінітив і «sa zmieša». Розмова: актив і «vraj»: «Psa zachránili hasiči.»",
          "examples": [
            {
              "sk": "Koncert bol presunutý na máj.",
              "uk": "Концерт перенесено на травень."
            },
            {
              "sk": "Najprv sa múka zmieša s cukrom.",
              "uk": "Спершу борошно змішують із цукром."
            }
          ],
          "shortRule": "úrad, správy → trpný rod · návod → sa · rozhovor → aktív",
          "button": "Далі →"
        }
