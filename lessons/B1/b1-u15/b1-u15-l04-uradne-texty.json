      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Мова установ",
          "text": "В офіційних листах і рішеннях пасив — норма: важливий результат, а не конкретний чиновник. «Vaša žiadosť bola schválená.» «Povolenie bude vydané do 30 dní.» «Rozhodnutie vám bude doručené poštou.» Виконавця зазвичай не називають — це «úrad».",
          "examples": [
            {
              "sk": "Vaša žiadosť bola schválená.",
              "uk": "Вашу заяву схвалено."
            },
            {
              "sk": "Rozhodnutie vám bude doručené poštou.",
              "uk": "Рішення вам надішлють поштою."
            }
          ],
          "shortRule": "bola schválená · bude doručené",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Добрі й погані новини",
          "text": "Добрі: «schválená» (схвалена), «vybavená» (вирішена), «vydané» (видано). Погані: «zamietnutá» (відхилена), «neúplná» (неповна), «chýbajú doklady» (бракує документів). Стеж за родом: žiadosť (ж. р.) — schválená, povolenie (с. р.) — vydané, preukaz (ч. р.) — vydaný.",
          "examples": [
            {
              "sk": "Žiadosť bola zamietnutá pre chýbajúce doklady.",
              "uk": "Заяву відхилено через відсутні документи."
            },
            {
              "sk": "Váš preukaz je vydaný a môžete si ho prevziať.",
              "uk": "Ваше посвідчення видано, можете його забрати."
            }
          ],
          "shortRule": "schválená × zamietnutá",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Je potrebné, sa podáva",
          "text": "Замість «treba» установи пишуть «je potrebné» або «je nutné»: «Je potrebné predložiť doklad totožnosti.» Правила для громадян — зворотний пасив: «Žiadosť sa podáva osobne.» «Poplatok sa platí vopred.» «Nemožno» — не можна, неможливо: «Bez podpisu nemožno žiadosť prijať.»",
          "examples": [
            {
              "sk": "Je potrebné doložiť potvrdenie o ubytovaní.",
              "uk": "Необхідно додати підтвердження про проживання."
            },
            {
              "sk": "Poplatok sa platí pri podaní žiadosti.",
              "uk": "Збір сплачується під час подання заяви."
            }
          ],
          "shortRule": "je potrebné + інфінітив · sa podáva · nemožno",
