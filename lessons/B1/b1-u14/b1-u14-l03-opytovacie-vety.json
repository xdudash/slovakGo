      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Питальне слово замість «či»",
          "text": "Якщо в запитанні є питальне слово, воно саме стає сполучником: „Kde bývaš?“ → «Spýtal sa, kde bývam.» „Kedy prídete?“ → «Spýtala sa, kedy prídeme.» «Či» тут не додаємо. Знака питання в кінці немає.",
          "examples": [
            {
              "sk": "Spýtal sa ma, kde pracujem.",
              "uk": "Він запитав мене, де я працюю."
            },
            {
              "sk": "Chceli vedieť, koľko zarábame.",
              "uk": "Вони хотіли знати, скільки ми заробляємо."
            }
          ],
          "shortRule": "kde, kedy, prečo, ako, koľko, kto, čo + речення",
          "commonMistakes": [
            {
              "mistake": "Spýtal sa, či kde bývam.",
              "correct": "Spýtal sa, kde bývam."
            },
            {
              "mistake": "Spýtal sa, kde bývam?",
              "correct": "Spýtal sa, kde bývam."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Короткі слова після питального слова",
          "text": "Короткі слова (sa, si, mi, ti, ho, som, sme…) стоять одразу після питального слова: „Ako sa voláš?“ → «Spýtala sa, ako sa volám.» „Prečo si mi nezavolal?“ → «Spýtal sa, prečo som mu nezavolal.» У минулому часі som / si змінюється разом з особою й стоїть перед sa: «prečo som sa presťahoval».",
          "examples": [
            {
              "sk": "Spýtala sa ma, prečo som sa presťahoval.",
              "uk": "Вона запитала мене, чому я переїхав."
            },
            {
              "sk": "Zaujímalo ho, ako sa mi tu páči.",
              "uk": "Його цікавило, як мені тут подобається."
            }
          ],
          "shortRule": "питальне слово + som/sa/mi + дієслово",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменник лишається",
          "text": "Прийменник іде разом із питальним словом: „S kým bývaš?“ → «Spýtal sa, s kým bývam.» „Odkiaľ si?“ → «Spýtali sa, odkiaľ som.» Корисні слова: «dokedy» — до коли, «odkedy» — відколи, «akým spôsobom» — яким чином, «koľkokrát» — скільки разів.",
          "examples": [
            {
              "sk": "Spýtali sa ma, odkiaľ som a odkedy žijem na Slovensku.",
              "uk": "Мене запитали, звідки я і відколи живу в Словаччині."
            },
            {
              "sk": "Úradníčka chcela vedieť, dokedy mám nájomnú zmluvu.",
              "uk": "Службовиця хотіла знати, до коли в мене договір оренди."
            }
          ],
          "shortRule": "s kým · odkiaľ · dokedy · akým spôsobom",
          "button": "Далі →"
        }
      ],
