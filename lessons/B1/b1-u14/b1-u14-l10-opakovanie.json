      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чотири типи переказу",
          "text": "Твердження → «že»: „Som hotový.“ → Povedal, že je hotový. Запитання «так/ні» → «či»: „Máš čas?“ → Spýtal sa, či mám čas. Запитання з питальним словом → те саме слово: „Kde bývaš?“ → Spýtal sa, kde bývam. Наказ або прохання → «aby» + l-форма або «nech» + теперішній: „Zavolaj mi!“ → Povedal, aby som mu zavolal / nech mu zavolám.",
          "examples": [
            {
              "sk": "Spýtala sa, či viem, kde je pošta.",
              "uk": "Вона запитала, чи я знаю, де пошта."
            },
            {
              "sk": "Povedal, aby som mu zavolal, keď prídem.",
              "uk": "Він сказав, щоб я йому зателефонував, коли прийду."
            }
          ],
          "shortRule": "že · či · kde / kedy… · aby / nech",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Час, особи, слова часу",
          "text": "Час не зсувається, як в англійській: „Pracujem.“ → Povedal, že pracuje. Змінюються особи й займенники (ja → on, ti → mi) і, якщо переказуємо пізніше, слова часу й місця: zajtra → na druhý deň, včera → deň predtým, tu → tam. Умовний спосіб лишається: povedal, že by rád…",
          "examples": [
            {
              "sk": "V utorok povedala, že na druhý deň nepríde.",
              "uk": "У вівторок вона сказала, що наступного дня не прийде."
            },
            {
              "sk": "Sused povedal, že by nám rád pomohol.",
              "uk": "Сусід сказав, що охоче нам допоміг би."
            }
          ],
          "shortRule": "час лишається · особи й слова часу змінюються",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Чутки, повідомлення, цитати",
          "text": "Розмовне: vraj, počul som, že…, povráva sa, že… Офіційне: údajne, podľa + родовий, hovorca uviedol, že… Повідомлення: Chcete mu niečo odkázať? Vyriaďte mu, že… Povedzte jej, nech mi zavolá. Цитата: Povedal: „…“ / „…,“ povedal.",
          "examples": [
            {
              "sk": "Vraj bude od januára nový rozpis zmien.",
