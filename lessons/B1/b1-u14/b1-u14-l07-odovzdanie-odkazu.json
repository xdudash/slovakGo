      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Прийняти повідомлення",
          "text": "Коли людини немає на місці: «Nie je tu. Chcete mu niečo odkázať?» — Хочете йому щось передати? Або: «Môžete mu nechať odkaz.» — Можете залишити йому повідомлення. Записуємо три речі: kto volal, čo chce, kam zavolať späť.",
          "examples": [
            {
              "sk": "Pán Horák je na porade. Chcete mu niečo odkázať?",
              "uk": "Пан Горак на нараді. Хочете йому щось передати?"
            },
            {
              "sk": "Môžem mu nechať odkaz?",
              "uk": "Можу залишити йому повідомлення?"
            }
          ],
          "shortRule": "odkázať · nechať odkaz",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Передати слова: nech, vyriadiť, tlmočiť",
          "text": "«Povedzte mu, nech mi zavolá.» — Скажіть йому, хай мені зателефонує. «Vyriaďte jej, že prídem neskôr.» — Перекажіть їй, що я прийду пізніше. «Vyriaď pozdrav manželke.» — Передай привіт дружині. «Tlmočiť» — офіційно передати чиїсь слова: «Tlmočím vám poďakovanie riaditeľa.»",
          "examples": [
            {
              "sk": "Vyriaďte mu, prosím, že zmluva je pripravená.",
              "uk": "Перекажіть йому, будь ласка, що договір готовий."
            },
            {
              "sk": "Povedz mame, nech nečaká s večerou.",
              "uk": "Скажи мамі, хай не чекає з вечерею."
            }
          ],
          "shortRule": "vyriadiť komu, že… · povedz mu, nech…",
          "commonMistakes": [
            {
              "mistake": "Vyriaďte ho, že…",
              "correct": "Vyriaďte mu, že…"
            },
            {
              "mistake": "Volal vás pán Novák.",
              "correct": "Volal vám pán Novák."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Передаємо повідомлення",
          "text": "Коли передаємо: «Volal vám pán Kubík. Povedal, že…», «Máte odkaz od pani…», «Prosil, aby ste mu zavolali späť.» На автовідповідачі (odkazovač) називаємо себе, мету й номер: «Dobrý deň, tu je Olena Ivanenko. Volám kvôli objednávke. Zavolajte mi, prosím, na číslo…»",
          "examples": [
            {
              "sk": "Volala vám pani Benková. Prosila, aby ste jej zavolali späť.",
              "uk": "Вам телефонувала пані Бенкова. Просила, щоб ви їй передзвонили."
            },
            {
              "sk": "Je to naliehavé, zavolajte mi čo najskôr.",
              "uk": "Це терміново, зателефонуйте мені якнайшвидше."
            }
          ],
          "shortRule": "Volal vám… · Povedal, že… · Prosil, aby…",
          "button": "Далі →"
        }
      ],
