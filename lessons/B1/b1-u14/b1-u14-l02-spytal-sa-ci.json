      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Či — «чи»",
          "text": "Запитання без питального слова („Máš čas?“) переказуємо через «či»: «Spýtal sa, či mám čas.» Порядок слів — як у звичайному реченні, знака питання в кінці немає, кома перед «či» обов’язкова. «Spýtať sa koho?» — родовий відмінок: spýtal sa ma, spýtal sa jej, spýtal sa šéfa.",
          "examples": [
            {
              "sk": "Spýtala sa ma, či hovorím po slovensky.",
              "uk": "Вона запитала мене, чи я розмовляю словацькою."
            },
            {
              "sk": "Šéf sa spýtal, či sme hotoví.",
              "uk": "Начальник запитав, чи ми готові."
            }
          ],
          "shortRule": "„Máš…?“ → spýtal sa, či mám…",
          "commonMistakes": [
            {
              "mistake": "Spýtal sa mi, či…",
              "correct": "Spýtal sa ma, či…"
            },
            {
              "mistake": "Spýtal sa, ak mám čas.",
              "correct": "Spýtal sa, či mám čas."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Či, а не ak",
          "text": "Англійське «if» перекладається двома способами, і їх легко сплутати. Після запитання, сумніву чи незнання — тільки «či»: «Neviem, či príde.» «Nie som si istý, či…» «Pochybujem, či…» «Ak» — лише умова «якщо»: «Ak príde, zavolám ti.» Українське «чи» тут — надійна підказка.",
          "examples": [
            {
              "sk": "Neviem, či to stihnem.",
              "uk": "Не знаю, чи встигну."
            },
            {
              "sk": "Ak to stihnem, zavolám ti.",
              "uk": "Якщо встигну, зателефоную тобі."
            }
          ],
          "shortRule": "neviem / pochybujem / zaujíma ma + či",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Інші вступні фрази",
          "text": "«Zaujímalo ho, či…» — його цікавило, чи…; «Chcela vedieť, či…» — вона хотіла знати, чи…; «Zisťujem, či…» — з’ясовую, чи…; «Informovala sa, či…» — поцікавилася, чи… Вибір: «či… alebo…». Заперечне запитання: „Nemáš čas?“ → «Spýtal sa, či nemám čas.»",
          "examples": [
            {
              "sk": "Zaujímalo ich, či máme vodičský preukaz.",
              "uk": "Їх цікавило, чи маємо ми водійські посвідчення."
            },
            {
              "sk": "Chcela vedieť, či chcem kávu alebo čaj.",
