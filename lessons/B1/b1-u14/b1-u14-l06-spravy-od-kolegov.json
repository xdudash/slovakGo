      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Vraj — «кажуть, нібито»",
          "text": "«Vraj» — дуже часте розмовне слово, яке показує, що інформація чужа: «Vraj bude prepúšťanie.» — Кажуть, будуть звільнення. Може стояти після підмета: «Peter vraj odchádza.» Інші вступи: «Počul som, že…», «Hovorí sa, že…», «Povráva sa, že…» — ходять чутки, що…",
          "examples": [
            {
              "sk": "Šéf je vraj na dovolenke.",
              "uk": "Начальник, кажуть, у відпустці."
            },
            {
              "sk": "Počula som, že v piatok bude večierok.",
              "uk": "Я чула, що в п’ятницю буде вечірка."
            }
          ],
          "shortRule": "vraj · počul som, že · povráva sa, že",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Офіційніше: údajne, podľa",
          "text": "«Údajne» — нібито, за повідомленнями (новини, листи, звіти). «Podľa» + родовий — за словами, на думку: «podľa šéfa», «podľa neho», «podľa jeho slov». «Ako povedal…» — як сказав…",
          "examples": [
            {
              "sk": "Firma údajne plánuje novú halu.",
              "uk": "Фірма нібито планує новий цех."
            },
            {
              "sk": "Podľa šéfa budú mzdy od januára vyššie.",
              "uk": "За словами начальника, з січня зарплати будуть вищими."
            }
          ],
          "shortRule": "údajne (офіційно) · podľa + родовий",
          "commonMistakes": [
            {
              "mistake": "Podľa šéf…",
              "correct": "Podľa šéfa…"
            },
            {
              "mistake": "Podľa neho mňa…",
              "correct": "Podľa neho…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Чутки й обережність",
          "text": "«Klebeta» — плітка, «fáma» — неперевірена чутка. Щоб дистанціюватися: «Neviem, či je to pravda, ale…», «Nie je to isté, ale…». Щоб перевірити: «Kto ti to povedal?», «Odkiaľ to máš?» — звідки ти це знаєш?",
          "examples": [
            {
              "sk": "Neviem, či je to pravda, ale vraj nás presunú do inej haly.",
              "uk": "Не знаю, чи це правда, але кажуть, нас переведуть в інший цех."
            },
            {
              "sk": "Odkiaľ to máš? To je len fáma.",
              "uk": "Звідки ти це знаєш? Це лише чутка."
            }
          ],
          "shortRule": "klebeta · fáma · Odkiaľ to máš?",
          "button": "Далі →"
        }
      ],
