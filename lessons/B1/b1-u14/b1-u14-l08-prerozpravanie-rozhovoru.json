      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від діалогу до розповіді",
          "text": "Кожну репліку переказуємо за її типом: твердження — «že», запитання — «či» або питальне слово, прохання — «aby». Діалог „Ivan: Máš čas? Eva: Nie, idem k lekárovi.“ → «Ivan sa spýtal Evy, či má čas. Eva odpovedala, že nemá, lebo ide k lekárovi.» Коротку відповідь переказуємо так: «odpovedal, že áno / že nie».",
          "examples": [
            {
              "sk": "Spýtal som sa, či je to drahé, a predavač povedal, že nie.",
              "uk": "Я запитав, чи це дорого, і продавець сказав, що ні."
            },
            {
              "sk": "Eva odpovedala, že nemá čas.",
              "uk": "Єва відповіла, що не має часу."
            }
          ],
          "shortRule": "že · či · kde… · aby · že áno / že nie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дієслова реакції",
          "text": "«odpovedať» — відповісти, «súhlasiť» — погодитися, «namietnuť» (namietol) — заперечити, «trvať na tom, že / aby» — наполягати, «navrhnúť, aby» — запропонувати, «ohradiť sa» — заперечити, захищаючись від закиду. Послідовність: najprv — спочатку, potom — потім, nato — на це, після цього, napokon — зрештою.",
          "examples": [
            {
              "sk": "Kolega navrhol, aby sme išli autom. Šéf namietol, že je to drahé.",
              "uk": "Колега запропонував, щоб ми їхали машиною. Начальник заперечив, що це дорого."
            },
            {
              "sk": "Nato sa sused ospravedlnil.",
              "uk": "Після цього сусід вибачився."
            }
          ],
          "shortRule": "namietol, že · trval na tom, aby · nato",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як передати тон",
          "text": "Замість «povedal» — точніше дієслово: «zašepkal» — прошепотів, «zakričal» — крикнув, «zasmial sa» — засміявся, «povzdychol si» — зітхнув. Так переказ стає живим: «Zašepkala mi, že film je nudný.» «Povzdychol si, že sa to už nedá zmeniť.»",
          "examples": [
            {
              "sk": "Šéf trval na tom, aby sme to dokončili ešte dnes.",
              "uk": "Начальник наполіг, щоб ми закінчили це ще сьогодні."
            },
            {
              "sk": "Ohradila sa, že to nie je jej chyba.",
              "uk": "Вона заперечила, що це не її провина."
            }
          ],
          "shortRule": "zašepkal · zakričal · povzdychol si",
          "commonMistakes": [
            {
              "mistake": "Trval na to, aby…",
              "correct": "Trval na tom, aby…"
            },
            {
              "mistake": "Spýtal sa Eva…",
              "correct": "Spýtal sa Evy…"
            }
          ],
          "button": "Далі →"
        }
