      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сильна сторона + доказ",
          "text": "На A2 вистачало сказати «Som spoľahlivý». На B1 роботодавець чекає доказу: властивість + приклад. «Viem pracovať pod tlakom. Napríklad v sezóne sme mali dvojnásobok objednávok a všetko sme stihli.» Корисні слова: «precízny» (ретельний), «mám iniciatívu» (проявляю ініціативу), «ambiciózny» (амбітний).",
          "examples": [
            {
              "sk": "Som precízna, napríklad pri inventúre som nikdy nemala rozdiely.",
              "uk": "Я ретельна: наприклад, під час інвентаризації в мене ніколи не було розбіжностей."
            },
            {
              "sk": "Viem pracovať pod tlakom, keď sa blíži termín.",
              "uk": "Я вмію працювати під тиском, коли наближається кінцевий термін."
            }
          ],
          "shortRule": "vlastnosť + napríklad / keď…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Слабка сторона чесно",
          "text": "Назви справжню слабку сторону, яка не є ключовою для посади, і покажи, що з нею робиш: «Pracujem na tom, aby…» (працюю над тим, щоб…). Після «aby» йде l-форма: «aby som lepšie plánoval». «Mám tendenciu + інфінітив» — я схильний: «Mám tendenciu robiť všetko sám.» Уникай кліше «Som perfekcionista» без пояснення.",
          "examples": [
            {
              "sk": "Mám tendenciu robiť všetko sám, preto sa učím delegovať.",
              "uk": "Я схильний робити все сам, тому вчуся доручати завдання іншим."
            },
            {
              "sk": "Pracujem na tom, aby som hovoril plynulejšie.",
              "uk": "Я працюю над тим, щоб говорити вільніше."
            }
          ],
          "shortRule": "pracujem na tom, aby som + l-форма",
          "commonMistakes": [
            {
              "mistake": "Pracujem na tom, aby som hovorím plynulejšie.",
              "correct": "Pracujem na tom, aby som hovoril plynulejšie."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прогрес у часі",
          "text": "Покажи розвиток: «Kedysi som…, ale teraz…» (колись…, а тепер…). «Čoraz» + вищий ступінь — дедалі: «čoraz lepšie», «čoraz menej». «Oveľa» + вищий ступінь — набагато: «oveľa ľahšie».",
          "examples": [
            {
              "sk": "Kedysi som mala trému z telefonovania, ale teraz telefonujem čoraz istejšie.",
              "uk": "Колись я боялася телефонувати, а тепер телефоную дедалі впевненіше."
            },
            {
              "sk": "Po slovensky hovorím oveľa lepšie ako pred rokom.",
              "uk": "Словацькою я розмовляю набагато краще, ніж рік тому."
            }
          ],
          "shortRule": "čoraz / oveľa + вищий ступінь",
          "button": "Далі →"
        }
