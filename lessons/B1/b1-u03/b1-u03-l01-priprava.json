            {
              "sk": "V tejto firme je firemná kultúra dosť neformálna.",
              "uk": "У цій фірмі корпоративна культура досить неформальна."
            }
          ],
          "shortRule": "prísť vopred · byť dochvíľny",
          "button": "Далі →"
        }
