      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Вивчи фірму заздалегідь",
          "text": "Роботодавець очікує, що ти знаєш, куди прийшов(ла). Дієслово «preštudovať si» означає уважно вивчити: «preštudovať si inzerát», «preštudovať si webovú stránku firmy». Корисне запитання: «Čím sa firma zaoberá?» — Чим займається фірма? Дієслово «zaoberať sa» вимагає орудного відмінка: «zaoberá sa výrobou», «zaoberáme sa dopravou». Вимоги до кандидата в оголошеннях часто називають «predpoklady»: «Predpoklady: prax v odbore, vodičský preukaz».",
          "examples": [
            {
              "sk": "Firma sa zaoberá výrobou autosedačiek.",
              "uk": "Фірма займається виробництвом автомобільних сидінь."
            },
            {
              "sk": "Pred pohovorom si preštudujte inzerát.",
              "uk": "Перед співбесідою уважно прочитайте оголошення."
            }
          ],
          "shortRule": "zaoberať sa + орудний (čím?)",
          "commonMistakes": [
            {
              "mistake": "Firma sa zaoberá výroba.",
              "correct": "Firma sa zaoberá výrobou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Порада: mal by si…",
          "text": "Щоб порадити, кажемо «mal by si» / «mala by si» / «mali by ste» + інфінітив — тобі слід, варто. Про себе: «Mal by som…», «Mala by som…». Короткі слова «by», «si», «sa» стоять разом одразу після першого слова речення: «Mal by si si preštudovať…» — два «si» поспіль тут правильні: перше означає «ти», друге належить до дієслова «preštudovať si».",
          "examples": [
            {
              "sk": "Mali by ste si pripraviť otázky pre zamestnávateľa.",
              "uk": "Вам варто підготувати запитання для роботодавця."
            },
            {
              "sk": "Mala by som si zistiť, ako sa tam dostanem.",
              "uk": "Мені слід з’ясувати, як я туди доберуся."
            }
          ],
          "shortRule": "mal(a) by som / mal(a) by si / mali by ste + інфінітив",
          "commonMistakes": [
            {
              "mistake": "Mali by ste preštudovať si inzerát.",
              "correct": "Mali by ste si preštudovať inzerát."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "У день співбесіди",
          "text": "Будь «dochvíľny» / «dochvíľna» — пунктуальним: прийди на 10 хвилин раніше («desať minút vopred»), але не за пів години. Візьми те, що просили в запрошенні: «občiansky preukaz», «kópiu diplomu», «certifikáty». «Nervozita» перед співбесідою — це нормально: «Trochu nervozity je normálne.» Допомагає підготовка: проговори відповіді вголос і вдягнися відповідно до стилю фірми — її «firemná kultúra».",
          "examples": [
            {
              "sk": "Na pohovor príďte desať minút vopred.",
              "uk": "На співбесіду прийдіть на десять хвилин раніше."
