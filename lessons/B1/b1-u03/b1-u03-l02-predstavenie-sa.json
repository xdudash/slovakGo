      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три частини самопрезентації",
          "text": "На A2 ти казав(ла) лише «Volám sa… a pracoval som ako…». На B1 побудуй коротку історію з трьох частин. Теперішнє: «V súčasnosti pracujem ako…». Минуле: «Predtým som pôsobil(a) v…». Майбутнє: «Teraz by som sa rád posunul ďalej» / «Teraz by som sa rada posunula ďalej». Говори «stručne» — коротко, 1–2 хвилини, без історії всього життя.",
          "examples": [
            {
              "sk": "V súčasnosti pracujem ako skladník v Seredi.",
              "uk": "Зараз я працюю комірником у Середі."
            },
            {
              "sk": "Predtým som osem rokov pôsobila ako účtovníčka v Charkove.",
              "uk": "До того я вісім років працювала бухгалтеркою в Харкові."
            }
          ],
          "shortRule": "v súčasnosti → predtým → teraz by som rád/rada…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Освіта й спеціальність",
          "text": "«Vyštudoval(a) som…» — я закінчив(ла) навчання за спеціальністю: «Vyštudoval som strojárstvo.» Спеціальність — «odbor»: «Mám vysokoškolské vzdelanie v odbore stavebníctvo» (v + місцевий). Спеціалізацію передає «so zameraním na» + знахідний: «so zameraním na účtovníctvo». Якщо диплом визнаний у Словаччині: «Diplom mám uznaný na Slovensku.»",
          "examples": [
            {
              "sk": "Vyštudovala som pedagogiku so zameraním na prácu s deťmi.",
              "uk": "Я закінчила педагогіку зі спеціалізацією на роботі з дітьми."
            },
            {
              "sk": "Mám kvalifikáciu v odbore elektrikár.",
              "uk": "Маю кваліфікацію за спеціальністю електрик."
            }
          ],
          "shortRule": "v odbore + місцевий · so zameraním na + знахідний",
          "commonMistakes": [
            {
              "mistake": "v odbor stavebníctvo",
              "correct": "v odbore stavebníctvo"
            },
            {
              "mistake": "so zameraním na účtovníctvom",
              "correct": "so zameraním na účtovníctvo"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як пов’язати думки",
          "text": "Самопрезентація має звучати як зв’язний текст, а не як список. Допоможуть: «okrem toho» (крім того), «preto» (тому), «najmä» (особливо), «zároveň» (водночас). Дієслово «pôsobiť» має два значення: «pôsobiť ako / v» — працювати на посаді чи в установі (формальніше за pracovať), і «pôsobiť + прислівник» — справляти враження: «Pôsobíte veľmi pokojne.»",
          "examples": [
            {
              "sk": "Okrem toho hovorím po anglicky, najmä v technickej oblasti.",
              "uk": "Крім того, я розмовляю англійською, особливо в технічній сфері."
            },
            {
              "sk": "Šesť rokov som pôsobil ako vedúci zmeny.",
              "uk": "Шість років я працював начальником зміни."
            }
          ],
          "shortRule": "pôsobiť ako + називний · pôsobiť v + місцевий",
          "button": "Далі →"
        }
      ],
