      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Діапазон і «v hrubom»",
          "text": "На A2 ти казав(ла): «Predstavujem si okolo 1 300 eur brutto.» На B1 краще назвати діапазон: «Predstavujem si mzdu v rozmedzí 1 500 až 1 700 eur v hrubom.» «V hrubom» = брутто, «v čistom» = нетто, тобто на руки. Початкова зарплата — «nástupný plat».",
          "examples": [
            {
              "sk": "Moje platové očakávania sú v rozmedzí 1 400 až 1 600 eur v hrubom.",
              "uk": "Мої очікування щодо зарплати — від 1 400 до 1 600 євро брутто."
            },
            {
              "sk": "Aký je nástupný plat na tejto pozícii?",
              "uk": "Яка початкова зарплата на цій посаді?"
            }
          ],
          "shortRule": "v rozmedzí … až … · v hrubom × v čistom",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ввічливо торгуватися",
          "text": "«Vyjednávať» — вести переговори. Не вимагай, а пропонуй: «Bolo by možné…?» (Чи можна було б…?), «Bol by som rád, keby…» (Я був би радий, якби…). Після «keby» йде l-форма: «keby mzda bola…». Аргумент: «vzhľadom na» + знахідний — з огляду на: «vzhľadom na moje skúsenosti».",
          "examples": [
            {
              "sk": "Vzhľadom na moje skúsenosti by som si predstavovala viac.",
              "uk": "З огляду на мій досвід я розраховувала б на більше."
            },
            {
              "sk": "Bol by som rád, keby nástupný plat bol aspoň 1 500 eur.",
              "uk": "Я був би радий, якби початкова зарплата становила хоча б 1 500 євро."
            }
          ],
          "shortRule": "keby + l-форма · vzhľadom na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Bol by som rád, keby mzda je vyššia.",
              "correct": "Bol by som rád, keby mzda bola vyššia."
            },
            {
              "mistake": "vzhľadom na mojich skúseností",
              "correct": "vzhľadom na moje skúsenosti"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Окрім зарплати",
          "text": "Спитай про все «finančné ohodnotenie»: «Je súčasťou mzdy aj trinásty plat?», «Aké sú prémie?», «Je možné zvýšenie mzdy po skúšobnej dobe?» Якщо ставку підняти не можуть, запропонуй компроміс: «Bolo by možné dohodnúť sa na zvýšení po troch mesiacoch?» («dohodnúť sa na» + місцевий). Зверни увагу: «zvýšiť o 100 €» — на 100 € більше, «zvýšiť na 1 600 €» — до суми 1 600 €.",
          "examples": [
            {
              "sk": "Je možné zvýšenie po skúšobnej dobe?",
              "uk": "Чи можливе підвищення після випробувального терміну?"
            },
            {
              "sk": "Dostávajú zamestnanci aj trinásty plat?",
              "uk": "Чи отримують працівники також тринадцяту зарплату?"
            }
          ],
          "shortRule": "dohodnúť sa na + місцевий · zvýšiť o × na",
          "button": "Далі →"
        }
      ],
