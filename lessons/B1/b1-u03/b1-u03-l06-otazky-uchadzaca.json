      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Непрямі запитання",
          "text": "Наприкінці співбесіди звучить: «Máte nejaké otázky?» Ввічливіше питати непрямо: «Zaujímalo by ma, ako dlho trvá zaškolenie.», «Mohli by ste mi povedať, koľko ľudí je v tíme?» Запитання без питального слова вводимо через «či» (чи): «Zaujímalo by ma, či je možný home office.» Після «či» чи питального слова — звичайний порядок слів.",
          "examples": [
            {
              "sk": "Zaujímalo by ma, či je možný kariérny postup.",
              "uk": "Мені було б цікаво, чи можливе кар’єрне зростання."
            },
            {
              "sk": "Mohli by ste mi povedať, ako vyzerá bežný pracovný deň?",
              "uk": "Могли б ви сказати, який вигляд має звичайний робочий день?"
            }
          ],
          "shortRule": "Zaujímalo by ma, či / ako / koľko…",
          "commonMistakes": [
            {
              "mistake": "Zaujímalo by ma, ak je možný home office.",
              "correct": "Zaujímalo by ma, či je možný home office."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Про що питати",
          "text": "Добрі запитання показують інтерес до самої роботи: «Ako vyzerá zaškolenie?» (як відбувається навчання новачка), «S kým budem spolupracovať?», «Aké sú možnosti kariérneho postupu?», «Podporujete ďalšie vzdelávanie?» «Benefity» — бонуси від роботодавця: «stravné lístky» (талони на харчування), «príspevok na dopravu», «multisport karta», «doplnkové dôchodkové sporenie» (додаткове пенсійне накопичення).",
          "examples": [
            {
              "sk": "Aké benefity ponúkate zamestnancom?",
              "uk": "Які бонуси ви пропонуєте працівникам?"
            },
            {
              "sk": "Ako dlho trvá zaškolenie?",
              "uk": "Скільки триває навчання новачка?"
            }
          ],
          "shortRule": "zaškolenie · kariérny postup · vzdelávanie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що питати наприкінці",
          "text": "Не починай із відпустки й зарплати — спершу про роботу. Наприкінці доречно спитати про наступні кроки: «Aký je ďalší postup vo výberovom konaní?», «Kedy môžem očakávať odpoveď?» Зверни увагу: «postup» тут — порядок дій, процедура, а в «kariérny postup» — просування по службі.",
          "examples": [
            {
              "sk": "Aký je ďalší postup vo výberovom konaní?",
              "uk": "Який наступний етап відбору?"
            },
            {
              "sk": "Kedy môžem očakávať odpoveď?",
              "uk": "Коли я можу очікувати відповіді?"
            }
          ],
          "shortRule": "ďalší postup = наступні кроки",
          "button": "Далі →"
        }
      ],
