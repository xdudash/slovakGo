      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Типові запитання",
          "text": "«Prečo sa uchádzate práve o túto pozíciu?» — Чому саме ця посада? «Prečo by sme mali prijať práve vás?» — Чому ми маємо взяти саме вас? «Kde sa vidíte o päť rokov?» — Де ви бачите себе через п’ять років? «Prečo chcete odísť zo súčasnej práce?» — Чому хочете піти з теперішньої роботи? Слово «práve» означає «саме»: «práve vás», «práve túto».",
          "examples": [
            {
              "sk": "Prečo by sme mali prijať práve vás?",
              "uk": "Чому ми маємо взяти саме вас?"
            },
            {
              "sk": "Kde sa vidíte o päť rokov?",
              "uk": "Де ви бачите себе через п’ять років?"
            }
          ],
          "shortRule": "práve = саме",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Мотивація й внесок",
          "text": "Про мотивацію: «Zaujala ma vaša firma, pretože…», «Láka ma práca s ľuďmi». Дієслова «zaujať» і «lákať» узгоджуються з тим, що приваблює (це підмет): «zaujala ma ponuka», «lákajú ma nové technológie». Про внесок — умовний спосіб, бо ти ще не працюєш у фірмі: «Mojím prínosom pre firmu by bolo…», «Mohol by som využiť…». Про плани: «Hľadám dlhodobé, stabilné zamestnanie.»",
          "examples": [
            {
              "sk": "Láka ma práca v medzinárodnom tíme.",
              "uk": "Мене приваблює робота в міжнародній команді."
            },
            {
              "sk": "Mojím prínosom by boli skúsenosti z výroby.",
              "uk": "Моїм внеском був би досвід із виробництва."
            }
          ],
          "shortRule": "zaujala ma (ponuka) · lákajú ma (technológie)",
          "commonMistakes": [
            {
              "mistake": "Zaujal ma vaša ponuka.",
              "correct": "Zaujala ma vaša ponuka."
            },
            {
              "mistake": "Láka ma nové technológie.",
              "correct": "Lákajú ma nové technológie."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Делікатні запитання",
          "text": "Про причину зміни роботи говори позитивно й не критикуй колишнього роботодавця. Замість «Šéf bol hrozný» скажи «Chcel by som sa ďalej rozvíjať» або «V súčasnej firme už nemám možnosť rásť». Запитання про сім’ю, вагітність чи віру не стосуються роботи; можна ввічливо відповісти: «Nemyslím si, že to ovplyvní moju prácu.»",
          "examples": [
            {
              "sk": "Hľadám prácu, kde sa môžem ďalej rozvíjať.",
              "uk": "Шукаю роботу, де можу розвиватися далі."
            },
            {
              "sk": "V súčasnej firme už nemám možnosť rásť.",
              "uk": "У теперішній фірмі я вже не маю можливості рости."
            }
          ],
          "shortRule": "hovoriť pozitívne · nekritizovať bývalého šéfa",
          "button": "Далі →"
        }
      ],
