      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Подячний лист",
          "text": "Наступного дня після співбесіди доречно надіслати короткий «ďakovný e-mail»: «Vážená pani Kováčová, ďakujem za príjemný rozhovor a za čas, ktorý ste mi venovali. Pozícia ma ešte viac zaujala.» У листі ввічливе «Ви» пишемо з великої літери: «Vám», «Vašu odpoveď».",
          "examples": [
            {
              "sk": "Ďakujem za príjemný rozhovor a čas, ktorý ste mi venovali.",
              "uk": "Дякую за приємну розмову й час, який Ви мені приділили."
            },
            {
              "sk": "Teším sa na Vašu odpoveď.",
              "uk": "Чекаю на Вашу відповідь."
            }
          ],
          "shortRule": "ďakujem za + знахідний · Vy, Vám, Vaša з великої",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пропозиція: «так» або «дайте подумати»",
          "text": "Прийняти: «S radosťou prijímam Vašu ponuku.» І підтвердити «termín nástupu»: «Potvrdzujem nástup od 1. novembra.» Якщо потрібен час: «Mohol by som sa vyjadriť do piatka?» — «vyjadriť sa» тут означає дати відповідь. «Do» + родовий: do piatka, do pondelka, do konca týždňa.",
          "examples": [
            {
              "sk": "S radosťou prijímam Vašu ponuku.",
              "uk": "Із радістю приймаю Вашу пропозицію."
            },
            {
              "sk": "Mohla by som sa vyjadriť do pondelka?",
              "uk": "Чи могла б я дати відповідь до понеділка?"
            }
          ],
          "shortRule": "vyjadriť sa do + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відмова",
          "text": "«Zamietavá odpoveď» — відмова: «S ľútosťou Vám oznamujeme, že sme sa rozhodli pre iného kandidáta.» Відповідай ввічливо: подякуй і попроси «spätnú väzbu» — відгук про те, що можна покращити: «Mohli by ste mi poskytnúť krátku spätnú väzbu?» Часто фірма додає: «Vaše údaje si s Vaším súhlasom ponecháme v databáze.»",
          "examples": [
            {
              "sk": "Ďakujem za informáciu, aj keď ma mrzí, že to nevyšlo.",
              "uk": "Дякую за інформацію, хоч мені й шкода, що не вийшло."
            },
            {
              "sk": "Mohli by ste mi poskytnúť spätnú väzbu?",
              "uk": "Чи могли б ви дати мені зворотний зв’язок?"
            }
          ],
          "shortRule": "rozhodnúť sa pre + знахідний",
          "button": "Далі →"
        }
      ],
