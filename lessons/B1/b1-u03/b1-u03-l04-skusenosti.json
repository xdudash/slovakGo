      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Метод STAR",
          "text": "На прохання «Opíšte situáciu, keď…» (Опишіть ситуацію, коли…) відповідай історією з чотирьох кроків. «Situácia» — де й коли: «Keď som pracoval v hoteli…». «Úloha» — що треба було зробити: «Mojou úlohou bolo…». «Postup» — що зробив саме ти: «Rozhodol som sa…». «Výsledok» — чим закінчилося: «Výsledkom bolo, že…».",
          "examples": [
            {
              "sk": "Mojou úlohou bolo zaškoliť troch nových kolegov.",
              "uk": "Моїм завданням було навчити трьох нових колег."
            },
            {
              "sk": "Výsledkom bolo, že sme stihli všetky objednávky.",
              "uk": "У результаті ми встигли виконати всі замовлення."
            }
          ],
          "shortRule": "situácia → úloha → postup → výsledok",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вид дієслова в історії",
          "text": "Дія з результатом — доконаний вид: «zaviedol som nový systém» (запровадив), «vyriešil som problém» (розв’язав). Тривалий процес чи повторювана дія — недоконаний: «každý deň som kontroloval», «nový systém sme zavádzali pol roka». У кроках «postup» і «výsledok» зазвичай потрібен доконаний вид.",
          "examples": [
            {
              "sk": "Za pol roka sme zaviedli nový skladový systém.",
              "uk": "За пів року ми запровадили нову складську систему."
            },
            {
              "sk": "Každé ráno som kontrolovala dodávky.",
              "uk": "Щоранку я перевіряла поставки."
            }
          ],
          "shortRule": "результат — доконаний · процес — недоконаний",
          "commonMistakes": [
            {
              "mistake": "Nakoniec som ten problém riešil.",
              "correct": "Nakoniec som ten problém vyriešil."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відповідальність і цифри",
          "text": "«Zodpovedať za» + знахідний — відповідати за: «zodpovedal som za tím piatich ľudí». Результат із цифрами переконує: «znížili sme počet reklamácií o tretinu», «zvýšili sme predaj o 15 percent» — «o» + знахідний показує різницю. «Konkrétny» — конкретний: «Uveďte konkrétny príklad.»",
          "examples": [
            {
              "sk": "Zodpovedala som za objednávky pre celý obchod.",
              "uk": "Я відповідала за замовлення для всього магазину."
            },
            {
              "sk": "Znížili sme náklady o desať percent.",
              "uk": "Ми знизили витрати на десять відсотків."
            }
          ],
          "shortRule": "zodpovedať za + знахідний · o + знахідний (різниця)",
          "commonMistakes": [
            {
              "mistake": "zodpovedal som za tímom",
              "correct": "zodpovedal som za tím"
            }
          ],
          "button": "Далі →"
        }
