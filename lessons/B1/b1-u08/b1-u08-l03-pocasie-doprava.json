        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Попередження",
          "text": "Метеорологи видають «výstrahu» — офіційне попередження. Буває трьох ступенів: «výstraha prvého stupňa» (будь уважний), «druhého stupňa» (небезпечно), «tretieho stupňa» (дуже небезпечно). «Výstraha pred + орудний»: pred silným vetrom, pred búrkami, pred poľadovicou. «Platí od… do…» — діє з… до…",
          "examples": [
            {
              "sk": "Meteorológovia vydali výstrahu pred silným vetrom.",
              "uk": "Метеорологи оголосили попередження про сильний вітер."
            },
            {
              "sk": "Výstraha platí do utorka do 20:00.",
              "uk": "Попередження діє до вівторка до 20:00."
            }
          ],
          "shortRule": "výstraha pred + орудний",
          "commonMistakes": [
            {
              "mistake": "výstraha pred silný vietor",
              "correct": "výstraha pred silným vetrom"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ситуація на дорогах",
          "text": "Дорожні новини: «Na ceste medzi Žilinou a Martinom sa tvorí kolóna dlhá tri kilometre» (утворився затор завдовжки три кілометри). «Počítajte so zdržaním 20 minút» — розраховуйте на затримку. «Uzávierka» — перекриття: «Most je pre uzávierku neprejazdný.» «Odporúčame obchádzku cez…» — радимо об’їзд через… Розмовно затор — «zápcha».",
          "examples": [
            {
              "sk": "Pred Žilinou stojí kolóna, zdržanie je asi pol hodiny.",
              "uk": "Перед Жиліною затор, затримка близько пів години."
            },
            {
              "sk": "Pre uzávierku mosta odporúčame obchádzku cez centrum.",
              "uk": "Через перекриття мосту радимо об’їзд через центр."
            }
          ],
          "shortRule": "kolóna · uzávierka · zdržanie · obchádzka cez…",
          "button": "Далі →"
        }
