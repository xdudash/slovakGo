      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Профіль і підписники",
          "text": "«Sociálne siete» — завжди множина в загальному значенні: «na sociálnych sieťach» (на + місцевий). У кожного є «profil». Хто тебе читає — «sledovateľ, sledovateľka»: «Má desaťtisíc sledovateľov» (родовий множини після числа). Дієслово «sledovať niekoho» + знахідний: «Sledujem ju už roky.» Допис — «príspevok».",
          "examples": [
            {
              "sk": "Na sociálnych sieťach trávim večer asi hodinu.",
              "uk": "У соцмережах я проводжу ввечері приблизно годину."
            },
            {
              "sk": "Ten kuchár má na profile vyše tisíc sledovateľov.",
              "uk": "Цей кухар має в профілі понад тисячу підписників."
            }
          ],
          "shortRule": "na sociálnych sieťach · sledovať + знахідний",
          "commonMistakes": [
            {
              "mistake": "Sledujem jej.",
              "correct": "Sledujem ju."
            },
            {
              "mistake": "na sociálne siete",
              "correct": "na sociálnych sieťach"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що ми робимо в мережах",
          "text": "«Zverejniť príspevok / fotku» — опублікувати. «Zdieľať» — поширити («zdieľať článok») або поділитися з кимось («zdieľať s niekým»). «Označiť niekoho na fotke» — позначити. «Dať like / lajknúť» — розмовне «вподобати». «Komentovať» — коментувати. Заперечний наказ — від недоконаного виду: «Nezverejňuj to!», «Nezdieľajte neoverené správy.»",
          "examples": [
            {
              "sk": "Fotku z výletu som zverejnila na profile.",
              "uk": "Фото з поїздки я опублікувала в профілі."
            },
            {
              "sk": "Nezdieľajte správy, ktoré ste si neoverili.",
              "uk": "Не поширюйте повідомлень, які ви не перевірили."
            }
          ],
          "shortRule": "zverejniť → nezverejňuj · zdieľať",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Приватність і безпека",
          "text": "«Súkromie» — приватність: «nastavenia súkromia» (налаштування приватності), «súkromný profil» (закритий профіль) × «verejný profil» (відкритий). Поради: «Nezverejňujte adresu ani fotky dokladov.» «Používajte silné heslo.» Неприємного користувача можна «zablokovať» і «nahlásiť».",
          "examples": [
            {
              "sk": "Mám súkromný profil, vidia ho len priatelia.",
              "uk": "У мене закритий профіль, його бачать лише друзі."
            },
            {
              "sk": "Toho používateľa som zablokovala.",
              "uk": "Цього користувача я заблокувала."
            }
          ],
          "shortRule": "súkromný × verejný profil",
          "button": "Далі →"
        }
