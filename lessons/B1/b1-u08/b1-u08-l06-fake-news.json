      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Фейк і дезінформація",
          "text": "«Hoax» — неправдиве повідомлення, яке люди пересилають далі (ланцюжкові повідомлення, «залякування»). «Dezinformácia» — свідомо неправдива інформація, яку хтось поширює з певною метою. «Zavádzajúci titulok» — оманливий заголовок. Типові ознаки: емоції й великі літери, немає джерела, «Zdieľajte, kým to nezmažú!», «Lekári vám to tají!».",
          "examples": [
            {
              "sk": "Tá správa o otrávenej vode je hoax.",
              "uk": "Те повідомлення про отруєну воду — фейк."
            },
            {
              "sk": "Zdieľajte, kým to nezmažú!",
              "uk": "Поширюйте, поки це не видалили!"
            }
          ],
          "shortRule": "hoax · dezinformácia · zavádzajúci",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Перевір джерело",
          "text": "«Zdroj» — джерело: «Aký je zdroj tej správy?», «Odkiaľ to máš?» «Dôveryhodný zdroj» — надійне джерело, якому можна довіряти. «Overiť si informáciu v inom zdroji» — перевірити в іншому джерелі. Питай: хто це написав? коли? чи пишуть про це інші медіа? Коли повідомлення вже визнали неправдивим, кажуть: «Túto správu už vyvrátili.»",
          "examples": [
            {
              "sk": "Overte si informáciu aspoň v dvoch dôveryhodných zdrojoch.",
              "uk": "Перевірте інформацію щонайменше у двох надійних джерелах."
            },
            {
              "sk": "Polícia tú správu už vyvrátila.",
              "uk": "Поліція це повідомлення вже спростувала."
            }
          ],
          "shortRule": "Aký je zdroj? · overiť si · vyvrátiť",
          "commonMistakes": [
            {
              "mistake": "Polícia to vyvrátil.",
              "correct": "Polícia to vyvrátila."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як відповісти тактовно",
          "text": "Родичам і знайомим краще не казати «Si hlupák», а м’яко: «Si si istý, že je to pravda?», «Pozri, o tom nepíše žiadne iné médium.», «Počkaj, overme si to najprv.», «Myslím, že je to hoax, tu je vysvetlenie.» Так людина не захищається, а замислюється.",
          "examples": [
            {
              "sk": "Si si istá, že je to pravda? Nevidím tam žiadny zdroj.",
              "uk": "Ти впевнена, що це правда? Я не бачу там жодного джерела."
            },
            {
              "sk": "Počkaj, overme si to najprv.",
              "uk": "Зачекай, давай спершу це перевіримо."
            }
          ],
          "shortRule": "Si si istý / istá, že…?",
          "button": "Далі →"
        }
      ],
