      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура новини",
          "text": "Перше речення новини відповідає на головні запитання: «Čo sa stalo? Kde? Kedy?» Далі — «Ako?» і «Prečo?», потім наслідки й джерела. Приклад: «V utorok popoludní vypukol požiar v sklade na Priemyselnej ulici v Martine.» Час: «v utorok popoludní», «vo štvrtok ráno», «krátko po polnoci».",
          "examples": [
            {
              "sk": "V pondelok ráno sa na ceste pri Nitre zrazili dve autá.",
              "uk": "У понеділок зранку на дорозі біля Нітри зіткнулися два автомобілі."
            },
            {
              "sk": "Krátko po polnoci vypukol požiar v garáži.",
              "uk": "Невдовзі після опівночі в гаражі спалахнула пожежа."
            }
          ],
          "shortRule": "čo? kde? kedy? → ako? prečo?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дієслова й пасив",
          "text": "Типові вислови: «vypukol požiar» (спалахнула пожежа; požiar — чоловічий рід!), «hasiči zasahovali» (пожежники працювали на місці), «evakuovali obyvateľov», «nikto sa nezranil» (ніхто не постраждав), «polícia vyšetruje príčinu» (поліція розслідує причину), «škodu odhadli na…» (збитки оцінили в…). Пасив: «Dvaja ľudia boli zranení.», «Tridsať ľudí bolo evakuovaných.» (після числа 5+ — середній рід однини: bolo).",
          "examples": [
            {
              "sk": "Na mieste zasahovali tri jednotky hasičov.",
              "uk": "На місці працювали три підрозділи пожежників."
            },
            {
              "sk": "Škodu odhadli na 50 000 eur.",
              "uk": "Збитки оцінили в 50 000 євро."
            }
          ],
          "shortRule": "vypukol požiar · nikto sa nezranil · bolo evakuovaných",
