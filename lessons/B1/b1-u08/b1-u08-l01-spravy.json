      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура випуску",
          "text": "Ведучий («moderátor», «moderátorka») відкриває випуск: «Dobrý večer, vítam vás pri hlavných správach.» Далі йдуть рубрики: «domáce správy» (новини з країни), «zo zahraničia» (з-за кордону), «ekonomika», «šport», «počasie». Зверни увагу: «správy» — множина, тому «Správy sú o siedmej». В однині «správa» — одна новина, повідомлення або звіт. Випуск завершує фраза «To je z našich správ všetko».",
          "examples": [
            {
              "sk": "Hlavné správy sa začínajú o siedmej.",
              "uk": "Головний випуск новин починається о сьомій."
            },
            {
              "sk": "A teraz správy zo zahraničia.",
              "uk": "А тепер новини з-за кордону."
            }
          ],
          "shortRule": "správy sú · zo zahraničia",
          "commonMistakes": [
            {
              "mistake": "Správy je o siedmej.",
              "correct": "Správy sú o siedmej."
            },
            {
              "mistake": "správy z zahraničia",
              "correct": "správy zo zahraničia"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Хто це сказав?",
          "text": "Новини постійно посилаються на джерело. «Podľa + родовий»: «podľa hovorcu polície» (за словами речника поліції), «podľa polície». «Ako uviedol / oznámil / potvrdil + хто»: «Ako uviedol primátor mesta, …». Дієслова в новинах — переважно в минулому часі, а безособове «otvorili, uzavreli» означає «відкрили, перекрили» (без уточнення, хто саме).",
          "examples": [
            {
              "sk": "Podľa hovorcu polície nikto nebol zranený.",
              "uk": "За словами речника поліції, ніхто не постраждав."
            },
            {
              "sk": "Ako uviedla riaditeľka školy, vyučovanie bude pokračovať v pondelok.",
              "uk": "Як повідомила директорка школи, навчання продовжиться в понеділок."
            }
          ],
          "shortRule": "podľa + родовий · ako uviedol…",
          "commonMistakes": [
            {
              "mistake": "podľa hovorca",
              "correct": "podľa hovorcu"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Наживо зі студії",
          "text": "«Vysielať naživo» — транслювати в прямому ефірі. Ведучий передає слово репортерові: «Prepájame sa naživo s naším redaktorom v Košiciach.» Репортер починає: «Hlásim sa z námestia v Prešove.» Повернення: «Vraciame sa do štúdia.» «Priamy prenos» — пряма трансляція (матчу, концерту). Слово «naživo» — прислівник, не змінюється.",
          "examples": [
            {
              "sk": "Zápas budeme vysielať naživo.",
              "uk": "Матч ми транслюватимемо наживо."
            },
            {
              "sk": "Ďakujem, vraciame sa do štúdia.",
              "uk": "Дякую, повертаємося до студії."
            }
          ],
          "shortRule": "vysielať naživo · priamy prenos",
          "button": "Далі →"
        }
