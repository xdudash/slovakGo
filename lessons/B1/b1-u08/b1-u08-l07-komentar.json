      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Новина чи коментар?",
          "text": "Новина подає факти: «Mesto minulo na opravu mosta dva milióny eur.» Коментар («komentár», у газеті часто «úvodník» — редакційна стаття) подає думку автора: «Bolo to plytvanie peniazmi.» Думку видають слова «podľa môjho názoru», «myslím si», «domnievam sa», «som presvedčený / presvedčená», а також оцінні прикметники: zbytočný, skvelý, nezodpovedný.",
          "examples": [
            {
              "sk": "Podľa môjho názoru je nový most zbytočne drahý.",
              "uk": "На мою думку, новий міст невиправдано дорогий."
            },
            {
              "sk": "Domnievam sa, že mesto konalo príliš rýchlo.",
              "uk": "Я вважаю, що місто діяло надто поспішно."
            }
          ],
          "shortRule": "fakt × názor · podľa môjho názoru",
          "commonMistakes": [
            {
              "mistake": "podľa mňa názoru",
              "correct": "podľa môjho názoru"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Аргументи",
          "text": "Структура аргументації: «Na jednej strane…, na druhej strane…» — з одного боку…, з іншого боку… «Okrem toho / Navyše» — крім того. «Preto si myslím, že…» — тому я вважаю… «Hlavným argumentom je…» Позиція — «postoj»: «Aký je váš postoj k…?» (k + давальний).",
          "examples": [
            {
              "sk": "Na jednej strane je projekt drahý, na druhej strane pomôže tisícom ľudí.",
              "uk": "З одного боку, проєкт дорогий, з іншого — допоможе тисячам людей."
            },
            {
              "sk": "Navyše nevyrieši problém s parkovaním.",
              "uk": "Крім того, він не розв’яже проблему з паркуванням."
            }
          ],
          "shortRule": "na jednej strane… na druhej strane · okrem toho · preto",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Згода й критика",
          "text": "«Súhlasím s autorom, že…» (s + орудний). «Nesúhlasím s tým, že…», «S týmto tvrdením nemôžem súhlasiť.» «Tvrdenie» — твердження. «Kritizovať niekoho za niečo» — критикувати когось за щось (za + знахідний): «Autor kritizuje mesto za pomalú výstavbu.» Перед словами на s-/z- прийменник «so»: so starostom, ale s autorom.",
          "examples": [
            {
              "sk": "Súhlasím s autorkou, že mesto potrebuje viac zelene.",
              "uk": "Я погоджуюся з авторкою, що місту потрібно більше зелені."
            },
            {
              "sk": "Autor kritizuje vedenie mesta za drahé parkovanie.",
              "uk": "Автор критикує керівництво міста за дороге паркування."
            }
          ],
          "shortRule": "súhlasiť s + орудний · kritizovať za + знахідний",
          "commonMistakes": [
