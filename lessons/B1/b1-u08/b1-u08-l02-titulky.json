      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Газета й стаття",
          "text": "«Titulok» — заголовок статті; увага: «titulky» у кіно — це субтитри («film so slovenskými titulkami»). Під заголовком часто стоїть короткий вступний абзац — «perex». «Denník» — щоденне видання, «týždenník» — щотижневе. Найважливіше стоїть «na titulnej strane» — на першій сторінці. Видання «vychádza» — виходить: «Denník vychádza každý deň okrem nedele.»",
          "examples": [
            {
              "sk": "Článok vyšiel na titulnej strane.",
              "uk": "Стаття вийшла на першій сторінці."
            },
            {
              "sk": "Tento denník čítam každé ráno.",
              "uk": "Цю щоденну газету я читаю щоранку."
            }
          ],
          "shortRule": "titulok = заголовок · titulky = субтитри",
          "commonMistakes": [
            {
              "mistake": "na titulná strana",
              "correct": "na titulnej strane"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Граматика заголовків",
          "text": "Заголовки економлять слова: пропускають «je / sú / bol», часто стоять у теперішньому часі навіть про минуле. «Most v Žiline opäť otvorený» = «Most v Žiline je (bol) opäť otvorený». «Ceny bytov klesajú» = ціни на квартири знижуються. Двокрапка відділяє тему: «Nehoda pri Poprade: dvaja zranení». Щоб зрозуміти заголовок, подумки додай пропущене дієслово.",
          "examples": [
            {
              "sk": "Škola v Martine opäť otvorená",
              "uk": "Школа в Мартіні знову відкрита"
            },
            {
              "sk": "Nehoda pri Poprade: dvaja zranení",
              "uk": "Аварія біля Попрада: двоє поранених"
            }
          ],
          "shortRule": "додай je / sú / bol",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Серйозна й бульварна преса",
          "text": "«Bulvár» — бульварна (жовта) преса: великі літери, «ŠOK!», «Neuveríte, čo…», «Toto musíte vidieť!» Мета — щоб ти клікнув (такі заголовки називають «clickbait»). Серйозний заголовок називає факт: хто, що, де. «Novinár / novinárka» — журналіст, журналістка. Коли переказуєш: «Čítal som v novinách, že…», «Na internete písali, že…».",
          "examples": [
            {
              "sk": "Čítala som v novinách, že v meste otvoria novú škôlku.",
              "uk": "Я читала в газеті, що в місті відкриють новий дитсадок."
            },
            {
              "sk": "O tom písali všetky denníky.",
              "uk": "Про це писали всі щоденні газети."
            }
          ],
          "shortRule": "čítal som v novinách, že… · písali, že…",
          "button": "Далі →"
        }
      ],
