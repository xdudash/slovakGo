      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Інтерв’ю й опитування",
          "text": "«Rozhovor» у медіа — інтерв’ю: «rozhovor s riaditeľkou školy». Журналіст («redaktor, redaktorka») починає: «Môžem vám položiť pár otázok?» Вуличне опитування — «anketa», велике соціологічне — «prieskum». Людина, що відповідає, — «respondent». Наприкінці: «Ďakujem za rozhovor.» (za + знахідний).",
          "examples": [
            {
              "sk": "Môžem vám položiť pár otázok do ankety?",
              "uk": "Можу поставити вам кілька запитань для опитування?"
            },
            {
              "sk": "Ďakujem vám za rozhovor.",
              "uk": "Дякую вам за інтерв’ю."
            }
          ],
          "shortRule": "položiť otázku · ďakujem za rozhovor",
          "commonMistakes": [
            {
              "mistake": "Ďakujem na rozhovor.",
              "correct": "Ďakujem za rozhovor."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як відповідати й ухилятися",
          "text": "Щоб виграти час: «To je dobrá otázka.», «Ťažko povedať.», «Ako by som to povedal…». Щоб не відповідати: «K tomu sa nebudem vyjadrovať.» (від vyjadriť sa — висловитися), «Bez komentára.» Офіційний коментар установи — «vyjadrenie»: «Firma do uzávierky nezaslala vyjadrenie.»",
          "examples": [
            {
              "sk": "Ťažko povedať, ale myslím, že ľudia sú spokojní.",
              "uk": "Важко сказати, але думаю, що люди задоволені."
            },
            {
              "sk": "K tomu sa nebudem vyjadrovať.",
              "uk": "Я не коментуватиму це."
            }
          ],
          "shortRule": "Ťažko povedať · K tomu sa nebudem vyjadrovať",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Непряма мова",
          "text": "У словацькій при переказі час НЕ змінюється: «Povedala: „Pracujem v pekárni.“» → «Povedala, že pracuje v pekárni.» Змінюються лише особа й займенники. Запитання без питального слова — через «či»: «Spýtal sa: „Ste spokojná?“» → «Spýtal sa, či je spokojná.» З питальним словом: «Spýtal sa, kde býva.» Ще: «Podľa jej slov…», «Citujem: …»",
          "examples": [
            {
              "sk": "Olena povedala, že na Slovensku žije päť rokov.",
              "uk": "Олена сказала, що живе в Словаччині п’ять років."
            },
            {
              "sk": "Redaktor sa spýtal, či mám deti.",
              "uk": "Журналіст запитав, чи є в мене діти."
            }
          ],
          "shortRule": "povedal(a), že… · spýtal(a) sa, či…",
          "commonMistakes": [
            {
              "mistake": "Spýtal sa, že mám deti.",
              "correct": "Spýtal sa, či mám deti."
            }
          ],
          "button": "Далі →"
        }
