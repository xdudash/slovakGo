      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Радіо й станції",
          "text": "«Rozhlas» — радіомовлення як установа й медіа (наприклад, «verejnoprávny rozhlas» — суспільне радіо). «Rádio» — і приймач, і розмовна назва станції. Кажемо «počúvať rádio», «v rádiu hlásili / hovorili» (по радіо повідомили). Станцію «naladíme na frekvencii 98,4 MHz» — налаштуємо на частоті. У місцевому відмінку: v rádiu.",
          "examples": [
            {
              "sk": "Včera hlásili v rádiu, že bude snežiť.",
              "uk": "Учора по радіо повідомили, що буде сніг."
            },
            {
              "sk": "Stanicu nájdete na frekvencii 101,2 MHz.",
              "uk": "Станцію знайдете на частоті 101,2 МГц."
            }
          ],
          "shortRule": "v rádiu · na frekvencii",
          "commonMistakes": [
            {
              "mistake": "na rádiu",
              "correct": "v rádiu"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Передачі й ефір",
          "text": "«Relácia» — передача (на радіо й телебаченні): «ranná relácia», «hudobná relácia», «diskusná relácia». «Vysielanie» — ефір, мовлення: «Ste vo vysielaní!» — Ви в ефірі! «Moderovať reláciu» — вести передачу. Хто слухає — «poslucháč, poslucháčka»; хто дивиться телевізор — «divák, diváčka».",
          "examples": [
            {
              "sk": "Martina moderuje rannú reláciu už päť rokov.",
              "uk": "Мартіна веде ранкову передачу вже п’ять років."
            },
            {
              "sk": "Milí poslucháči, ste s nami?",
              "uk": "Дорогі слухачі, ви з нами?"
            }
          ],
          "shortRule": "relácia (ж. р.) · vo vysielaní",
          "commonMistakes": [
            {
              "mistake": "ranný relácia",
              "correct": "ranná relácia"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Дзвінок в ефір",
          "text": "Почни ввічливо: «Dobrý deň, volám sa Ivan a volám zo Zvolena.» (дієслово volať — і «називатися», і «телефонувати»: «volám sa» = мене звати, «volám z» = телефоную з). Привітання: «Chcela by som pozdraviť mamu a kolegov z Martina.» Запитання: «Chcel by som sa opýtať…». Ведучий дякує: «Ďakujeme, že ste nám zavolali.»",
          "examples": [
            {
              "sk": "Volám z Prešova a chcel by som pozdraviť svoju rodinu.",
              "uk": "Телефоную з Пряшева й хотів би привітати свою родину."
            },
            {
              "sk": "Ďakujeme, že ste nám zavolali.",
              "uk": "Дякуємо, що ви нам зателефонували."
            }
          ],
          "shortRule": "volám sa… · volám z… · chcel(a) by som pozdraviť…",
          "button": "Далі →"
        }
      ],
