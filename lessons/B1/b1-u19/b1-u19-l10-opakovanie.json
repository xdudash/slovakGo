      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Гроші, податки, кредит",
          "text": "Бюджет: «na + знахідний» (na nájom), «z/zo + родовий» (zo mzdy), «dovoliť si», «vyjsť s peniazmi». Податки: «podliehať dani», «byť oslobodený od dane», «vyplniť tlačivo → podať priznanie»; «preplatok» повертають, «nedoplatok» доплачують. Кредит: «požičať si od banky», «splácať» (процес) × «splatiť» (завершити), «ručiť za úver». Sporenie: «sporiť si na…», «čím vyšší výnos, tým vyššie riziko».",
          "examples": [
            {
              "sk": "Zo mzdy najprv platím nájom, na jedlo míňam 400 eur.",
              "uk": "З зарплати спершу плачу оренду, на їжу витрачаю 400 євро."
            },
            {
              "sk": "Úver budem splácať päť rokov.",
              "uk": "Кредит я виплачуватиму п’ять років."
            }
          ],
          "shortRule": "na + знахідний · z + родовий · požičať si od + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Poistenie, dôchodok, faktúry",
          "text": "Страхування: «poistiť proti + давальний», «sa vzťahuje / nevzťahuje na + знахідний», «nahlásiť škodu poisťovni» (давальний). Пенсія: «byť na dôchodku», «odísť do dôchodku», «mať nárok na + знахідний», «po dosiahnutí dôchodkového veku». Фактури: «faktúra za + знахідний», «do dátumu splatnosti», «prosím o opravu», «faktúra obsahuje chybu».",
          "examples": [
            {
              "sk": "Auto som poistil proti odcudzeniu a škodu nahlásim poisťovni.",
              "uk": "Я застрахував авто від викрадення й повідомлю шкоду страховій."
            },
            {
              "sk": "Prosím Vás o opravu faktúry.",
              "uk": "Прошу Вас виправити рахунок."
            }
          ],
          "shortRule": "proti + давальний · po + місцевий · za + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Podvody a ochrana",
          "text": "«Vydávať sa za + знахідний», «naletieť + давальний», «oklamať + знахідний», «ochrániť sa pred + орудний». Тривожні ознаки: тиск, прохання про PIN, záloha vopred, zaručený zisk. Що робити: не поспішати, самому зателефонувати в банк на номер із картки, «zablokovať kartu», «nahlásiť podvod». У всіх фінансових питаннях перевіряй актуальні умови в офіційних джерелах.",
          "examples": [
            {
              "sk": "Chránim sa pred podvodmi: nikomu nehovorím PIN.",
