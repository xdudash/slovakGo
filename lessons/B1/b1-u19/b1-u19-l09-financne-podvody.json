      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Типові шахрайства",
          "text": "«Podvodník» намагається тебе «oklamať» (обдурити). Кілька схем: дзвінок від «працівника банку чи поліції» (він «vydáva sa za» когось — вживається зі знахідним); SMS чи лист із посиланням («phishing»); «falošná výhra» — «Vyhrali ste!», але спершу треба заплатити збір; «pyramídová hra» — старим учасникам платять із грошей нових; «rýchly zárobok» із «zaručeným ziskom». Хто попався, той «naletel» і вживає давальний: «naletieť podvodníkovi».",
          "examples": [
            {
              "sk": "Podvodník sa vydával za pracovníka banky.",
              "uk": "Шахрай видавав себе за працівника банку."
            },
            {
              "sk": "Naletel som podvodníkovi a poslal som mu peniaze.",
              "uk": "Я повівся на шахрая й надіслав йому гроші."
            }
          ],
          "shortRule": "vydávať sa za + знахідний · naletieť + давальний · oklamať + знахідний",
          "commonMistakes": [
            {
              "mistake": "Naletel som podvodníka.",
              "correct": "Naletel som podvodníkovi."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Varovné signály",
          "text": "«Varovný signál» — ознака, що щось не так. Найтиповіші: «nátlak» («hneď», «poslednú šancu»); прохання назвати PIN чи код із SMS — справжній банк по телефону чи в SMS його не просить; «záloha» чи збір наперед від незнайомця; обіцянка дуже високого прибутку без ризику; відсутність договору; контакт лише через месенджер. Правило: «Čím vyšší sľubovaný zisk, tým väčšie riziko podvodu.» Ця порада — загальна, перевіряй кожен випадок окремо.",
          "examples": [
            {
              "sk": "Podvodníci vyvíjajú nátlak: chcú, aby si zaplatil hneď.",
              "uk": "Шахраї тиснуть: хочуть, щоб ти заплатив негайно."
            },
            {
              "sk": "Čím vyšší sľubovaný zisk, tým väčšie riziko podvodu.",
              "uk": "Чим вищий обіцяний прибуток, тим більший ризик шахрайства."
            }
          ],
          "shortRule": "nátlak · PIN · záloha vopred · zaručený zisk",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ako sa chrániť",
          "text": "«Ochrániť sa pred + орудний»: «ochrániť sa pred podvodmi», «chrániť sa pred phishingom». Кроки: (1) не відповідай на тиск, поклади слухавку; (2) сам зателефонуй у банк на номер із картки чи з офіційного сайту; (3) не клікай посилання із SMS; (4) якщо вже попався — негайно «zablokovať kartu» та «nahlásiť podvod» банку й поліції. Гроші, які ти вже відправив(ла), вдається повернути не завжди, але чим швидше дієш, тим більше шансів.",
          "examples": [
            {
              "sk": "Chránim sa pred podvodmi: nikomu nehovorím svoj PIN.",
              "uk": "Я захищаюся від шахраїв: нікому не кажу свій PIN."
            },
            {
              "sk": "Ak si naletel, ihneď zavolaj do banky a zablokuj kartu.",
              "uk": "Якщо ти попався, негайно зателефонуй у банк і заблокуй картку."
            }
          ],
          "shortRule": "ochrániť sa pred + орудний",
          "commonMistakes": [
            {
              "mistake": "Chránim sa pre podvodmi.",
              "correct": "Chránim sa pred podvodmi."
            }
          ],
          "button": "Далі →"
        }
