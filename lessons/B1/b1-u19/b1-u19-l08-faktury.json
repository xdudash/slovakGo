      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що на faktúre",
          "text": "«Faktúra» — рахунок-фактура. «Dodávateľ» — той, хто постачає й виставляє її (ти, якщо ти živnostník); «odberateľ» — той, хто купує й платить. На faktúre є: IČO та DIČ сторін, číslo faktúry, dátum vystavenia, dátum splatnosti, suma, IBAN і variabilný symbol. Прийменник «za» + знахідний — за що: «faktúra za opravu», «faktúra za služby». «Fakturovať» — виставляти рахунок: «Klientovi fakturujem 400 eur mesačne.»",
          "examples": [
            {
              "sk": "Vystavil som faktúru za opravu auta.",
              "uk": "Я виставив рахунок за ремонт авто."
            },
            {
              "sk": "Odberateľ musí uhradiť faktúru do dátumu splatnosti.",
              "uk": "Покупець мусить оплатити рахунок до дати сплати."
            }
          ],
          "shortRule": "faktúra za + знахідний · dodávateľ × odberateľ",
          "commonMistakes": [
            {
              "mistake": "Vystavil som faktúru pre opravu.",
              "correct": "Vystavil som faktúru za opravu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Zálohová a konečná faktúra, platba",
          "text": "«Zálohová faktúra» — рахунок на передоплату (аванс), зазвичай не є податковим документом. Після виконання робіт виставляють остаточну: «daňový doklad». Платимо «do dátumu splatnosti» (до + родовий) і вказуємо правильний «variabilný symbol», інакше платіж важко зіставити: «Faktúra je uhradená / neuhradená.» Прострочена оплата може означати «upomienku» й «úroky z omeškania». Умови завжди дивись у договорі.",
          "examples": [
            {
              "sk": "Najprv zaplatím zálohovú faktúru, potom dostanem daňový doklad.",
              "uk": "Спершу я сплачу рахунок на передоплату, потім отримаю податковий документ."
            },
            {
              "sk": "Faktúra je splatná do štrnástich dní.",
              "uk": "Рахунок підлягає оплаті протягом чотирнадцяти днів."
            }
          ],
          "shortRule": "zálohová → konečná · do dátumu splatnosti",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Chyba na faktúre",
          "text": "Якщо у faktúre помилка, ввічливо проси про виправлення: «Faktúra obsahuje nesprávnu sumu. Prosím Vás o vystavenie opravnej faktúry.» Після «prosím o» — знахідний відмінок, часто віддієслівний іменник на -ie: «prosím o opravu», «o vystavenie». Дієслово «obsahovať» — однина при faktúra: «Faktúra obsahuje chybu». На нагадування відповідай конкретно: «Faktúru som uhradil dňa…» Формальне «Vy» пиши з великої літери в листі.",
          "examples": [
            {
              "sk": "Faktúra obsahuje nesprávnu sumu, prosím Vás o opravu.",
              "uk": "У рахунку неправильна сума, прошу Вас виправити."
            },
            {
              "sk": "Faktúru som uhradila minulý piatok.",
              "uk": "Рахунок я оплатила минулої п’ятниці."
            }
          ],
          "shortRule": "prosím o + знахідний · faktúra obsahuje",
          "commonMistakes": [
            {
              "mistake": "Faktúra obsahujú chybu.",
              "correct": "Faktúra obsahuje chybu."
            }
          ],
          "button": "Далі →"
        }
