      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Які бувають страхування",
          "text": "«Povinné zmluvné poistenie» (PZP) — обов’язкове страхування цивільної відповідальності для власників авто: покриває шкоду, яку ти заподіяв іншому. «Havarijné poistenie» — добровільне, для шкоди на твоєму авто. Для житла: «poistenie bytu», «poistenie domácnosti». Для людини: «životné», «úrazové», «cestovné poistenie». «Poistiť proti + давальний»: «poistiť auto proti odcudzeniu» (від викрадення), «proti požiaru» (від пожежі). Що саме обов’язкове, залежить від закону.",
          "examples": [
            {
              "sk": "Auto som poistil proti odcudzeniu.",
              "uk": "Я застрахував авто від викрадення."
            },
            {
              "sk": "Povinné zmluvné poistenie kryje škody spôsobené inému.",
              "uk": "Обов’язкове страхування цивільної відповідальності покриває шкоду, заподіяну іншому."
            }
          ],
          "shortRule": "poistiť proti + давальний",
          "commonMistakes": [
            {
              "mistake": "Poistil som auto proti odcudzenie.",
              "correct": "Poistil som auto proti odcudzeniu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Poistná zmluva",
          "text": "«Poistná zmluva» — договір страхування. Ти — «poistník», коли укладаєш його: «uzatvoriť poistnú zmluvu» (не «otvoriť»). «Poistná suma» — максимальна сума, яку страховик може виплатити. «Krytie» — що страховка покриває. «Výluky» — чого вона не покриває, наприклад умисно заподіяну шкоду. Кажемо: «Poistenie sa vzťahuje na požiar.» і «Poistenie sa nevzťahuje na úmyselné škody.» Прийменник — «na» + знахідний. «Spoluúčasť» — твоя частка в кожній шкоді.",
          "examples": [
            {
              "sk": "Poistná zmluva určuje krytie a výluky.",
              "uk": "Договір страхування визначає покриття й виключення."
            },
            {
              "sk": "Poistenie sa nevzťahuje na úmyselne spôsobené škody.",
              "uk": "Страхування не поширюється на навмисно заподіяну шкоду."
            }
          ],
          "shortRule": "sa vzťahuje / nevzťahuje na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Poistenie sa nevzťahujú na škody.",
              "correct": "Poistenie sa nevzťahuje na škody."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли сталася шкода",
          "text": "«Poistná udalosť» — подія, за якою настає виплата. Що робити: (1) «nahlásiť škodu poisťovni» (давальний!), (2) «odfotiť škodu» і зібрати документи, (3) почекати рішення і «poistné plnenie» (виплату). Говоримо: «V prípade poistnej udalosti kontaktujte poisťovňu.» Строки й документи бувають різні, тому прочитай умови договору. Обов’язково повідом якомога скоріше: «čo najskôr».",
          "examples": [
            {
              "sk": "Škodu treba čo najskôr nahlásiť poisťovni.",
              "uk": "Шкоду треба якомога скоріше повідомити страховій."
            },
            {
              "sk": "Poisťovňa rozhodne o poistnom plnení.",
              "uk": "Страхова вирішить щодо страхової виплати."
            }
          ],
          "shortRule": "nahlásiť + знахідний + давальний · čo najskôr",
          "commonMistakes": [
            {
              "mistake": "Nahlásil som škodu poisťovňu.",
              "correct": "Nahlásil som škodu poisťovni."
            }
          ],
          "button": "Далі →"
        }
