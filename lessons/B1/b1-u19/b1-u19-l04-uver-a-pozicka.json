      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Úver, pôžička, požičať si",
          "text": "«Úver» дає банк за договором, «pôžičku» — також небанківська компанія чи знайомий. «Požičať» — дати в борг (комусь), «požičať si» — взяти в борг (від когось): «Požičal som kamarátovi 100 eur.» × «Požičal som si od banky 5 000 eur.» Після «od» — родовий: od banky, od kamaráta. Банк «poskytuje úver», а клієнт «berie» або «vyberá si» úver: «Vzal som si úver.» Іпотечний кредит на житло — «hypotéka».",
          "examples": [
            {
              "sk": "Požičal som si od banky peniaze na auto.",
              "uk": "Я позичив у банку гроші на авто."
            },
            {
              "sk": "Banka mi poskytla úver na rekonštrukciu.",
              "uk": "Банк надав мені кредит на ремонт."
            }
          ],
          "shortRule": "požičať + давальний · požičať si od + родовий",
          "commonMistakes": [
            {
              "mistake": "Požičal som od banky peniaze.",
              "correct": "Požičal som si od banky peniaze."
            },
            {
              "mistake": "požičať si od banka",
              "correct": "požičať si od banky"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Úrok a RPMN",
          "text": "«Úroková sadzba» — відсоток за користування кредитом (зазвичай на рік). Але це не вся вартість: до неї додаються «poplatky». Тому порівнюй «RPMN» — річну процентну ставку витрат, у якій враховано всі платежі. Вона показує повну вартість кредиту. Кажемо: «Aká je RPMN tohto úveru?» (RPMN — жіночого роду, бо «miera»). Перевір також, скільки заплатиш разом: «Koľko zaplatím celkovo?» Точні цифри в кожного банку інші — порівнюй пропозиції.",
          "examples": [
            {
              "sk": "Pri úvere sa pozeraj nielen na úrok, ale aj na RPMN.",
              "uk": "При кредиті дивись не лише на відсоток, а й на RPMN."
            },
            {
              "sk": "Aká je úroková sadzba a aká je RPMN?",
              "uk": "Яка відсоткова ставка й яка RPMN?"
            }
          ],
          "shortRule": "úroková sadzba + poplatky = RPMN",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Splácanie a zabezpečenie",
          "text": "Кредит «splácame» (недок.: регулярно) — «Úver splácam každý mesiac.»; «splatiť» (док.) — виплатити повністю: «Úver splatím do dvoch rokov.» Після «budem» — недоконаний вид: «budem splácať», не «budem splatiť». «Ručiteľ» — особа, яка «ručí za» (+ знахідний) твій кредит: «Ručí za úver.» «Hypotéka» зазвичай забезпечена нерухомістю. Якщо не платити, можливі санкції. Тому перед підписом уважно читай договір і запитай про «predčasné splatenie» — дострокове погашення.",
          "examples": [
            {
              "sk": "Úver budem splácať päť rokov.",
              "uk": "Кредит я виплачуватиму п’ять років."
            },
            {
              "sk": "Môj brat ručí za môj úver.",
              "uk": "Мій брат ручається за мій кредит."
            }
          ],
          "shortRule": "splácať (процес) · splatiť (завершити) · ručiť za + знахідний",
          "commonMistakes": [
            {
              "mistake": "Budem splatiť úver.",
              "correct": "Budem splácať úver."
            },
            {
              "mistake": "Ručí pre úver.",
              "correct": "Ručí za úver."
            }
          ],
          "button": "Далі →"
        }
