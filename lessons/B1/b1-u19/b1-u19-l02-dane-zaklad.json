      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hrubá a čistá mzda",
          "text": "«Hrubá mzda» — сума в договорі до відрахувань. З неї відраховують «odvody» (соціальне й медичне страхування) і «preddavok na daň» (авансовий внесок податку). Те, що залишається, — «čistá mzda», тобто сума, яка приходить на рахунок. Кажемо: «Z hrubej mzdy sa odvádzajú odvody.» Дієслово «odvádzať» (недок.) і «odviesť» (док.) — відраховувати й перераховувати державі. Точні ставки з часом змінюються, тому перевіряй їх на сайті фінансової адміністрації або в бухгалтера.",
          "examples": [
            {
              "sk": "Z hrubej mzdy sa odvádzajú odvody a preddavok na daň.",
              "uk": "З брутто-зарплати відраховують внески й авансовий внесок податку."
            },
            {
              "sk": "Čistá mzda je mzda po odpočítaní odvodov a dane.",
              "uk": "Чиста зарплата — це зарплата після вирахування внесків і податку."
            }
          ],
          "shortRule": "hrubá mzda − odvody − preddavok na daň = čistá mzda",
          "commonMistakes": [
            {
              "mistake": "Zo mzdy sa odvádza odvody.",
              "correct": "Zo mzdy sa odvádzajú odvody."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Які бувають податки",
          "text": "«Daň z príjmu» — податок із доходу: із зарплати, підробітку, оренди. «DPH» (daň z pridanej hodnoty) уже закладена в ціну товару в магазині. «Daň z nehnuteľností» платять власники квартир, будинків і ділянок місту чи селу. «Daň z motorových vozidiel» стосується власників авто, але умови залежать від закону. Після «daň z» ставимо родовий відмінок: «daň z príjmu», «daň z nehnuteľností». Усе, що стосується ставок і виключень, перевіряй на офіційних сторінках.",
          "examples": [
            {
              "sk": "Daň z nehnuteľností platia majitelia bytov a domov.",
              "uk": "Податок на нерухомість платять власники квартир і будинків."
            },
            {
              "sk": "DPH je už zahrnutá v cene tovaru.",
              "uk": "ПДВ уже включений у ціну товару."
            }
          ],
          "shortRule": "daň z + родовий · DPH — у ціні",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Podliehať dani",
          "text": "«Podliehať» + давальний: «Príjem podlieha dani.» — Дохід підлягає оподаткуванню. «Byť oslobodený od dane» + родовий — не оподатковуватися: «Táto suma je oslobodená od dane.» «Nezdaniteľná časť» — частина доходу, з якої податок не нараховують; працівник може попросити роботодавця врахувати її на підставі підписаної заяви. Чи й коли це можливо, залежить від закону й твоєї ситуації. Тому питай: «Je tento príjem oslobodený od dane?»",
          "examples": [
            {
              "sk": "Príjem zo zamestnania podlieha dani z príjmu.",
              "uk": "Дохід із роботи підлягає податку на доходи."
            },
            {
              "sk": "Je tento príjem oslobodený od dane?",
              "uk": "Цей дохід звільнений від податку?"
            }
          ],
          "shortRule": "podliehať + давальний · oslobodený od + родовий",
          "commonMistakes": [
            {
              "mistake": "Príjem podlieha daň.",
              "correct": "Príjem podlieha dani."
            },
            {
              "mistake": "oslobodený z dane",
              "correct": "oslobodený od dane"
            }
          ],
          "button": "Далі →"
        }
