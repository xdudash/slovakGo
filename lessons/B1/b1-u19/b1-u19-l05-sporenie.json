      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Sporiť si na…",
          "text": "«Sporiť» — регулярно відкладати гроші на рахунок на певну мету, «šetriť» — витрачати менше. На мету вказуємо прийменником «na» + знахідний: «Sporím si na nové auto.» «Šetrím na dovolenku.» Добре мати чітку ціль і суму: «Chcem ušetriť 3 000 eur na rezervu.» Найлегше — відкладати автоматично: «Mesačne mi odchádza 100 eur na sporiaci účet.» Про мету питаємо: «Na čo si sporíš?»",
          "examples": [
            {
              "sk": "Sporím si na nové auto.",
              "uk": "Я збираю на нове авто."
            },
            {
              "sk": "Na čo si sporíš?",
              "uk": "На що ти збираєш?"
            }
          ],
          "shortRule": "sporiť si na + знахідний · šetriť na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Sporím si pre auto.",
              "correct": "Sporím si na auto."
            },
            {
              "mistake": "Šetrím sa na dovolenku.",
              "correct": "Šetrím na dovolenku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Де тримати гроші",
          "text": "«Sporiaci účet» — гроші доступні в будь-який час, відсоток зазвичай нижчий. «Termínovaný vklad» — гроші лежать на домовлений строк, відсоток, як правило, вищий, але достроково їх зняти не можна або можна лише з умовами. «Podielový fond» — гроші вкладаються в цінні папери: можливий більший «výnos», але і більше «riziko». Правило: «Čím vyšší výnos, tým vyššie riziko.» Це лише мова, а не інвестиційна порада.",
          "examples": [
            {
              "sk": "Čím vyšší výnos, tým vyššie riziko.",
              "uk": "Чим вищий прибуток, тим вищий ризик."
            },
            {
              "sk": "Na termínovanom vklade sú peniaze viazané na určitý čas.",
              "uk": "На строковому вкладі гроші прив’язані на певний час."
            }
          ],
          "shortRule": "čím + вищий ступінь, tým + вищий ступінь",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Інфляція",
          "text": "«Inflácia» — зростання цін: за ту саму суму купиш менше, тому гроші «strácajú hodnotu». Тому гроші, які просто лежать удома, з часом втрачають вартість. Кажемо: «Výnos z investície nie je zaručený.» (z + родовий). «Investovať do + родовий»: «investovať do fondov». Перед вкладанням порівняй умови й дізнайся, чи можна зняти гроші раніше. Для першого кроку часто починають із резерву на ощадному рахунку.",
          "examples": [
            {
              "sk": "Ceny rastú, preto peniaze strácajú hodnotu.",
              "uk": "Ціни ростуть, тому гроші втрачають вартість."
            },
            {
              "sk": "Výnos z fondu nie je zaručený.",
              "uk": "Прибуток із фонду не гарантований."
            }
          ],
          "shortRule": "výnos z + родовий · investovať do + родовий",
          "commonMistakes": [
            {
              "mistake": "Investujem do fondy.",
              "correct": "Investujem do fondov."
            }
          ],
          "button": "Далі →"
        }
