      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Dôchodok: слова й прийменники",
          "text": "«Byť na dôchodku» (місцевий) — бути на пенсії: «Môj otec je už na dôchodku.» «Odísť do dôchodku» (родовий) — піти на пенсію: «Odišiel do dôchodku minulý rok.» «Poberať dôchodok» — отримувати пенсію. Пенсійний вік — «dôchodkový vek», пенсія за віком — «starobný dôchodok». Окремо існує «predčasný dôchodok» — дострокова пенсія за певних умов. Точні вік і умови визначає закон і вони можуть залежати від року народження, тому питай у Sociálnej poisťovni.",
          "examples": [
            {
              "sk": "Môj otec je na dôchodku a poberá starobný dôchodok.",
              "uk": "Мій тато на пенсії й отримує пенсію за віком."
            },
            {
              "sk": "Chcem odísť do dôchodku skôr.",
              "uk": "Я хочу піти на пенсію раніше."
            }
          ],
          "shortRule": "byť na dôchodku · odísť do dôchodku",
          "commonMistakes": [
            {
              "mistake": "Otec je do dôchodku.",
              "correct": "Otec je na dôchodku."
            },
            {
              "mistake": "Odišiel do dôchodok.",
              "correct": "Odišiel do dôchodku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nárok a doba poistenia",
          "text": "Розмір пенсії залежить насамперед від «doby poistenia» (скільки років платили внески) та від розміру внесків. «Mať nárok na + знахідний» — мати право на: «Mám nárok na starobný dôchodok.» «Nárok vzniká po splnení podmienok» — право виникає після виконання умов; «po» + місцевий: «po dosiahnutí dôchodkového veku». Роки роботи за кордоном іноді можуть враховуватися, тож про це теж запитуй. Це не точна інструкція, а мова теми.",
          "examples": [
            {
              "sk": "Nárok na dôchodok vzniká po dosiahnutí dôchodkového veku.",
              "uk": "Право на пенсію виникає після досягнення пенсійного віку."
            },
            {
              "sk": "Pri výpočte dôchodku sa berie do úvahy doba poistenia.",
              "uk": "При розрахунку пенсії враховується строк страхування."
            }
          ],
          "shortRule": "mať nárok na + знахідний · po + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Sporenie na starobu",
          "text": "Державна пенсія — це лише одне джерело. Крім неї існує «dôchodkové sporenie» (накопичення через пенсійну компанію, якщо людина до нього приєдналася) і «doplnkové dôchodkové sporenie» — додаткові накопичення. Туди може вносити гроші й роботодавець. Кажемо: «Do doplnkového sporenia mi prispieva zamestnávateľ.» Як порадити: «Mal by si si pozrieť výpis z poistenia.» Усі деталі — в офіційних джерелах.",
          "examples": [
            {
              "sk": "Do doplnkového dôchodkového sporenia mi prispieva zamestnávateľ.",
              "uk": "До додаткового пенсійного накопичення мені вносить роботодавець."
            },
            {
              "sk": "Mal by si sa informovať, koľko rokov poistenia máš.",
              "uk": "Тобі варто дізнатися, скільки років страхування ти маєш."
            }
          ],
          "shortRule": "štátny dôchodok + vlastné sporenie",
          "button": "Далі →"
        }
