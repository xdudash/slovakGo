      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Куди йдуть гроші",
          "text": "Коли йдеться про витрати, питаємо «na čo?» і кажемо «na» + знахідний відмінок: «na nájom», «na jedlo», «na deti». Гроші «míňame» (витрачаємо щодня) або «vydávame» (регулярно віддаємо), а коли вони «зникають» із зарплати — «odchádzajú»: «Na nájom nám odchádza polovica platu.» З чого платимо — «z» + родовий: «z čistej mzdy», «zo sporiaceho účtu». Суму додаємо без прийменника: «600 eur mesačne».",
          "examples": [
            {
              "sk": "Na jedlo míňame asi 400 eur mesačne.",
              "uk": "На їжу ми витрачаємо приблизно 400 євро на місяць."
            },
            {
              "sk": "Z čistej mzdy najprv platíme nájom.",
              "uk": "З чистої зарплати ми спершу платимо оренду."
            }
          ],
          "shortRule": "na + знахідний (на що) · z + родовий (з чого)",
          "commonMistakes": [
            {
              "mistake": "Míňame peniaze pre jedlo.",
              "correct": "Míňame peniaze na jedlo."
            },
            {
              "mistake": "Platíme to na mzdy.",
              "correct": "Platíme to zo mzdy."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Фіксовані й змінні витрати",
          "text": "Фіксовані витрати щомісяця однакові: nájom, internet, poistenie, splátka. Змінні залежать від нас: potraviny, oblečenie, kino, darčeky. Окремо ведемо «rezervu» на несподіване, наприклад на ремонт. Залишок описуємо так: «Keď zaplatíme účty, zostane nám 150 eur.» — тут «nám» стоїть одразу після дієслова. Якщо грошей не вистачає, кажемо: «Nevychádzame s peniazmi.»",
          "examples": [
            {
              "sk": "Fixné výdavky platíme každý mesiac rovnako.",
              "uk": "Фіксовані витрати ми платимо щомісяця однаково."
            },
            {
              "sk": "Keď zaplatíme účty, zostane nám 150 eur.",
              "uk": "Коли заплатимо рахунки, нам залишиться 150 євро."
            }
          ],
          "shortRule": "fixné = щомісяця те саме · variabilné = залежать від нас",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що собі можна дозволити",
          "text": "«Dovoliť si» — дозволити собі, але лише про гроші: «Nové auto si zatiaľ nemôžeme dovoliť.» Зворотне «si» стоїть перед дієсловом: «Dovolenku si nemôžeme dovoliť», а не «nemôžeme dovoliť si». «Vyjsť s peniazmi» означає, що грошей вистачає до кінця місяця: «Z jedného platu s peniazmi nevyjdeme.» «Odkladať» — відкладати: «Každý mesiac si odkladáme 100 eur.» Домовляючись із партнером, пропонуй: «Čo keby sme…?»",
          "examples": [
            {
              "sk": "Tento rok si dovolenku nemôžeme dovoliť.",
              "uk": "Цього року ми не можемо собі дозволити відпустку."
            },
            {
              "sk": "Každý mesiac si odkladáme 100 eur na rezervu.",
              "uk": "Щомісяця ми відкладаємо 100 євро в резерв."
            }
          ],
          "shortRule": "si dovoliť · vyjsť s peniazmi · odkladať",
          "button": "Далі →"
        }
      ],
