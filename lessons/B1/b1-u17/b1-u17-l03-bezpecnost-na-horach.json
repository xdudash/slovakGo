      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Výstroj",
          "text": "«Výstroj» (жін. рід, лише однина) — спорядження: pevná obuv (міцне взуття), nepremokavá bunda (непромокальна куртка), teplé oblečenie aj v lete, čelovka (налобний ліхтарик), lekárnička, voda, nabitý mobil, mapa. На вершинах навіть улітку буває лише кілька градусів, а погода змінюється за годину.",
          "examples": [
            {
              "sk": "Do hôr si vždy zober nepremokavú bundu.",
              "uk": "У гори завжди бери непромокальну куртку."
            },
            {
              "sk": "Čelovka sa hodí, keď sa túra predĺži.",
              "uk": "Налобний ліхтарик знадобиться, якщо похід затягнеться."
            }
          ],
          "shortRule": "dobrá výstroj · pevná obuv · nepremokavá bunda",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Rady a varovania",
          "text": "Поради: «Mali by ste…», «Odporúčame…», «Je lepšie…», «Radšej…». Застереження — заперечний наказовий спосіб, майже завжди недоконаного виду: «Nechoďte sami», «Nepodceňujte počasie», «Nevychádzajte neskoro». Нагадування: «Nezabudnite si zobrať…». «Preceniť sily» — переоцінити сили, «podceniť» — недооцінити.",
          "examples": [
            {
              "sk": "Nechoďte do hôr sami.",
              "uk": "Не ходіть у гори самі."
            },
            {
              "sk": "Ak sa počasie zhorší, radšej sa vráťte.",
              "uk": "Якщо погода погіршиться, краще поверніться."
            }
          ],
          "shortRule": "заборона: ne- + недоконаний вид (nechoďte, nepodceňujte)",
          "commonMistakes": [
            {
              "mistake": "Nezoberte si ťažký batoh.",
              "correct": "Neberte si ťažký batoh."
            },
            {
              "mistake": "Podcenil som svoje sily a nestihol som zísť pred tmou.",
              "correct": "Precenil som svoje sily a nestihol som zísť pred tmou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Sezónna uzávera",
          "text": "У Татранському національному парку діє «sezónna uzávera»: з 1 листопада до 15 червня стежки вище гірських притулків закриті — через сніг, лавини й для спокою тварин. Порушникові загрожує штраф. Навесні й восени каміння буває «šmykľavé» — слизьке, на ньому сніг або лід.",
          "examples": [
            {
              "sk": "Od 1. novembra do 15. júna platí sezónna uzávera.",
              "uk": "З 1 листопада до 15 червня діє сезонне закриття."
            },
            {
              "sk": "Kamene sú po daždi šmykľavé.",
              "uk": "Каміння після дощу слизьке."
            }
          ],
          "shortRule": "sezónna uzávera: 1. 11. – 15. 6., nad horskými chatami",
          "button": "Далі →"
