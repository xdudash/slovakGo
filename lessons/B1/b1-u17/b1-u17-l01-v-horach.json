      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Do hôr, v horách, z hôr",
          "text": "«Hory» — множина з незвичними формами: родовий «hôr» (ísť do hôr, vrátiť sa z hôr), місцевий «v horách». Пасмо гір — «pohorie», окрема гора — «hora» або «vrch», гострий пік — «štít». Із назвами: «do Tatier — v Tatrách», «do Nízkych Tatier — v Nízkych Tatrách», «do Malej Fatry — v Malej Fatre».",
          "examples": [
            {
              "sk": "Cez víkend ideme do hôr.",
              "uk": "На вихідних ідемо в гори."
            },
            {
              "sk": "Celé leto sme boli v Tatrách.",
              "uk": "Усе літо ми були в Татрах."
            }
          ],
          "shortRule": "куди: do hôr, do Tatier · де: v horách, v Tatrách",
          "commonMistakes": [
            {
              "mistake": "Ideme do horách.",
              "correct": "Ideme do hôr."
            },
            {
              "mistake": "Boli sme v Tatroch.",
              "correct": "Boli sme v Tatrách."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як описати рельєф",
          "text": "«Chodník stúpa» — стежка йде вгору, «klesá» — униз. «Stúpanie» — підйом, «strmý svah» — крутий схил. «Hrebeň» — хребет, «sedlo» — сідловина між вершинами, «dolina» — долина. Над межею лісу росте «kosodrevina» — низька гірська сосна. На маршрутах стоять «horské chaty» — гірські притулки, де можна поїсти чи переночувати. «Hrebeňovka» — довгий маршрут уздовж хребта.",
          "examples": [
            {
              "sk": "Za chatou chodník prudko stúpa.",
              "uk": "За притулком стежка круто йде вгору."
            },
            {
              "sk": "Nad kosodrevinou sú už len kamene.",
              "uk": "Над гірською сосною вже тільки каміння."
            }
          ],
          "shortRule": "stúpať — вгору · klesať — униз · strmý svah",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Vystúpiť, zísť, prejsť",
          "text": "Для розповіді про похід потрібні дієслова з префіксами: «vystúpiť (vyjsť) na vrchol» — піднятися на вершину; «zísť (zostúpiť) do doliny» — спуститися в долину; «prejsť hrebeň» — пройти хребет; «obísť pleso» — обійти озеро. На вершину — «na» + знахідний, у долину — «do» + родовий. Минулий час від zísť — «zišiel, zišla, zišli».",
          "examples": [
            {
              "sk": "Na Kriváň sme vystúpili za štyri hodiny.",
              "uk": "На Кривань ми піднялися за чотири години."
            },
            {
              "sk": "Potom sme zišli do doliny k chate.",
              "uk": "Потім ми спустилися в долину до притулку."
            }
          ],
          "shortRule": "vystúpiť na + знахідний · zísť do + родовий",
          "button": "Далі →"
        }
      ],
