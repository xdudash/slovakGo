      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Zákazy",
          "text": "Заборони мають кілька форм: «Je zakázané» + інфінітив — «Je zakázané trhať kvety»; «Zákaz» + родовий — «Zákaz vstupu so psom», «Zákaz zakladania ohňa»; «nesmie sa» + інфінітив — «Tu sa nesmie fajčiť». Дозвіл: «je povolené», «smie sa».",
          "examples": [
            {
              "sk": "Je zakázané trhať chránené rastliny.",
              "uk": "Заборонено зривати охоронювані рослини."
            },
            {
              "sk": "Zákaz zakladania ohňa.",
              "uk": "Заборонено розпалювати вогонь."
            }
          ],
          "shortRule": "je zakázané + інфінітив · zákaz + родовий",
          "commonMistakes": [
            {
              "mistake": "Zákaz vstup.",
              "correct": "Zákaz vstupu."
            },
            {
              "mistake": "Je zakázaný trhať kvety.",
              "correct": "Je zakázané trhať kvety."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Medveď",
          "text": "У Словаччині живе понад тисячу бурих ведмедів. Якщо бачиш ведмедя: не тікай, не наближайся, говори спокійно й повільно відходь. На стежці розмовляй, щоб ведмідь почув тебе заздалегідь. Не залишай їжі й «odpadkov» — сміття приваблює ведмедів до стежок і сіл.",
          "examples": [
            {
              "sk": "Ak stretnete medveďa, neutekajte.",
              "uk": "Якщо зустрінете ведмедя, не тікайте."
            },
            {
              "sk": "Odpadky si odneste so sebou.",
              "uk": "Сміття заберіть із собою."
            }
          ],
          "shortRule": "medveď — stretnúť medveďa (знахідний = родовий)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Názor",
          "text": "Про охорону природи часто сперечаються. Думка: «Podľa mňa…», «Myslím si, že…», «Som za to, aby…», «Som proti tomu, aby…». Згода й незгода: «Súhlasím s tebou», «S tým nesúhlasím, pretože…». Після «aby» — l-форма: «Som za to, aby sa vstup spoplatnil.»",
          "examples": [
            {
              "sk": "Podľa mňa by sa v národných parkoch nemalo stavať.",
              "uk": "На мою думку, в національних парках не слід будувати."
            },
            {
              "sk": "Som proti tomu, aby ľudia kŕmili medvede.",
              "uk": "Я проти того, щоб люди годували ведмедів."
            }
          ],
          "shortRule": "som za to / som proti tomu, aby + l-форма",
          "button": "Далі →"
        }
      ],
