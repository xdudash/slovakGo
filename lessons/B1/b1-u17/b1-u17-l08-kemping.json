      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kemp a vybavenie",
          "text": "«Kemp» (також «kemping», «autokemping») — місце для наметів, автобудинків і будиночків. Знадобиться: «stan» (намет), «spacák» (спальник), «karimatka» (каремат), ліхтарик, пальник. «Postaviť stan» — поставити намет, «zbaliť stan» — скласти намет.",
          "examples": [
            {
              "sk": "Stan sme postavili pri jazere.",
              "uk": "Намет ми поставили біля озера."
            },
            {
              "sk": "V noci bola zima, ale spacák bol teplý.",
              "uk": "Уночі було холодно, але спальник був теплий."
            }
          ],
          "shortRule": "postaviť stan — zbaliť stan",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na recepcii kempu",
          "text": "Ціну в кемпінгу зазвичай рахують окремо: «za osobu a noc», «za stan», «za auto», плюс «miestny poplatok». Корисні фрази: «Máte voľné miesto pre stan?», «Koľko stojí jedna noc pre dvoch?», «Je sprcha v cene?», «Odkedy platí nočný pokoj?».",
          "examples": [
            {
              "sk": "Máte voľné miesto pre jeden stan na dve noci?",
              "uk": "У вас є вільне місце для одного намету на дві ночі?"
            },
            {
              "sk": "Je sprcha v cene?",
              "uk": "Душ входить у ціну?"
            }
          ],
          "shortRule": "za osobu · za noc · za stan · za auto",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Kde sa smie stanovať",
          "text": "«Stanovať» — ставити намет і жити в ньому. У національних парках і заповідниках «stanovať» поза визначеними місцями заборонено. На чужій землі потрібен дозвіл власника. «Táborák» — багаття — розпалюють лише там, де дозволено, і ніколи в посуху.",
          "examples": [
            {
              "sk": "V národnom parku je zakázané stanovať mimo vyhradených miest.",
              "uk": "У національному парку заборонено ставити намет поза визначеними місцями."
            },
            {
              "sk": "Večer sme sedeli pri táboráku.",
              "uk": "Увечері ми сиділи біля багаття."
            }
          ],
          "shortRule": "stanovať: v kempe alebo s povolením",
          "button": "Далі →"
        }
      ],
