      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Jazyk predpovede",
          "text": "Прогнози мають свої формули: «očakáva sa» — очікується; «môže sa vyskytnúť» — може бути; «ojedinele» — подекуди; «hrozí» + називний — є загроза: «hrozí námraza», у множині «hrozia búrky». У горах погода змінюється швидко: зранку ясно, а по обіді — «prehánky» (короткочасні зливи) і грози.",
          "examples": [
            {
              "sk": "Popoludní hrozia búrky s bleskami.",
              "uk": "По обіді загрожують грози з блискавками."
            },
            {
              "sk": "Na hrebeňoch sa očakáva nárazový vietor.",
              "uk": "На хребтах очікується поривчастий вітер."
            }
          ],
          "shortRule": "hrozí + називний однини · hrozia + називний множини",
          "commonMistakes": [
            {
              "mistake": "Hrozí búrok.",
              "correct": "Hrozia búrky."
            },
            {
              "mistake": "Hrozí búrkami.",
              "correct": "Hrozia búrky."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Búrka, vietor, hmla",
          "text": "«Blesk» — блискавка, «hrom» — грім. Під час грози не стій на вершині чи хребті, не тримайся за металеві ланцюги, спускайся нижче. «Nárazový vietor» — поривчастий вітер, на хребті може збити з ніг. «Viditeľnosť» — видимість: у тумані — лише кілька метрів, і легко загубити позначки. «Námraza» — паморозь, обледеніння на камінні й ланцюгах.",
          "examples": [
            {
              "sk": "V hmle je viditeľnosť len desať metrov.",
              "uk": "У тумані видимість лише десять метрів."
            },
            {
              "sk": "Na reťaziach je námraza.",
              "uk": "На ланцюгах обледеніння."
            }
          ],
          "shortRule": "počas búrky: preč z hrebeňa",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Lavíny a dôvody",
          "text": "Узимку важливий лавинний прогноз. Лавинна небезпека має 5 ступенів: 1 — низька, 2 — помірна, 3 — значна, 4 — велика, 5 — дуже велика. Найбільше нещасних випадків стається вже при 2-му і 3-му ступені. Причину рішення пояснюємо так: «keďže» (оскільки) + речення, «preto» (тому) + речення, «kvôli» (через) + давальний.",
          "examples": [
            {
              "sk": "Keďže platí tretí stupeň, na hrebeň nejdeme.",
              "uk": "Оскільки діє третій ступінь, на хребет не йдемо."
            },
            {
              "sk": "Kvôli hmle sme sa vrátili.",
              "uk": "Через туман ми повернулися."
            }
          ],
          "shortRule": "kvôli + давальний: kvôli hmle, kvôli vetru, kvôli búrke",
          "button": "Далі →"
        }
      ],
