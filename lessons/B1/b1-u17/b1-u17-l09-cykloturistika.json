      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Trasa",
          "text": "Опис траси: «dĺžka 40 km», «prevýšenie 600 m» (набір висоти), «povrch: asfalt / šotolina» (асфальт / гравій), «náročnosť: ľahká, stredne náročná, náročná». «Cyklochodník» — окрема доріжка для велосипедистів без машин, наприклад уздовж Вагу чи Дунаю. Дієслова: «trasa vedie popri rieke» (веде вздовж річки), «stúpa», «klesá»; «zjazd» — спуск.",
          "examples": [
            {
              "sk": "Cyklochodník vedie popri Váhu.",
              "uk": "Велодоріжка веде вздовж Вагу."
            },
            {
              "sk": "Trasa má prevýšenie 800 metrov.",
              "uk": "Траса має набір висоти 800 метрів."
            }
          ],
          "shortRule": "popri + місцевий: popri rieke, popri Váhu",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Požičovňa",
          "text": "«Požičovňa bicyklov» — прокат велосипедів. «Požičať si bicykel na celý deň» — узяти велосипед напрокат на весь день; «elektrobicykel» — електровелосипед; «záloha» — застава. Питання: «Koľko stojí požičanie na pol dňa?», «Je prilba v cene?». Зверни увагу: «požičať si» — узяти, «požičať niekomu» — дати.",
          "examples": [
            {
              "sk": "Chcel by som si požičať elektrobicykel na celý deň.",
              "uk": "Я хотів би взяти напрокат електровелосипед на весь день."
            },
            {
              "sk": "Za bicykel sa platí záloha 100 eur.",
              "uk": "За велосипед платять заставу 100 євро."
            }
          ],
          "shortRule": "požičať si (узяти) — požičať niekomu (дати)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pravidlá a poruchy",
          "text": "Правила в Словаччині: поза населеним пунктом «prilba» (шолом) обов’язкова для всіх велосипедистів, у населеному пункті — для дітей до 15 років; поза населеним пунктом при поганій видимості потрібен світловідбивний жилет. Поломки описуємо зворотним дієсловом і «mi»: «prepichla sa mi duša» (пробилася камера), «spadla mi reťaz» (злетів ланцюг), «nefungujú mi brzdy», «vybila sa mi batéria».",
          "examples": [
            {
              "sk": "Prepichla sa mi duša.",
              "uk": "У мене пробилася камера."
            },
            {
              "sk": "Na elektrobicykli sa mi vybila batéria.",
              "uk": "На електровелосипеді в мене розрядився акумулятор."
            }
          ],
          "shortRule": "sa mi / mi + дієслово: prepichla sa mi, spadla mi",
          "button": "Далі →"
        }
      ],
