      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Farby značiek",
          "text": "Словацька туристична позначка — смужка кольору між двома білими. Кольори: «červená, modrá, zelená, žltá». Червона зазвичай веде головними хребтами, наприклад «Cesta hrdinov SNP». Кажемо коротко, без слова značka: «ísť po červenej» — іти червоною, «odbočiť na modrú» — звернути на синю, «pokračovať po žltej», «zísť po zelenej».",
          "examples": [
            {
              "sk": "Z chaty pokračujte po červenej.",
              "uk": "Від притулку йдіть далі червоною."
            },
            {
              "sk": "Pri potoku odbočte na zelenú.",
              "uk": "Біля струмка зверніть на зелену."
            }
          ],
          "shortRule": "ísť po + місцевий (po červenej) · odbočiť na + знахідний (na modrú)",
          "commonMistakes": [
            {
              "mistake": "Choďte po červenú.",
              "correct": "Choďte po červenej."
            },
            {
              "mistake": "Odbočte na modrej.",
              "correct": "Odbočte na modrú."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Rázcestník",
          "text": "На роздоріжжях стоїть «rázcestník» — жовта табличка з назвою місця, висотою над рівнем моря й напрямками. Біля кожного напрямку — «čas chôdze», час ходьби, а не кілометри: «Chata pod Rysmi 2 h 15 min». Час розраховано на середнього туриста з рюкзаком, без перерв.",
          "examples": [
            {
              "sk": "Na rázcestníku je napísané: Zbojnícka chata 1 h 40 min.",
              "uk": "На дороговказі написано: Збойницька хата 1 год 40 хв."
            },
            {
              "sk": "Čas chôdze je bez prestávok.",
              "uk": "Час ходьби вказано без перерв."
            }
          ],
          "shortRule": "rázcestník: miesto, výška, smer, čas chôdze",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Náučný chodník a orientácia",
          "text": "«Náučný chodník» — пізнавальна стежка з інформаційними табличками про природу чи історію; її позначка — білий квадрат із зеленою косою смугою. «Značkovaný chodník» — промаркована стежка; у Татранському національному парку ходити можна лише нею. «Orientovať sa» — орієнтуватися: podľa mapy, podľa značiek. Якщо довго не бачиш позначки, найкраще повернутися до останньої.",
          "examples": [
            {
              "sk": "V Tatranskom národnom parku sa smie chodiť len po značkovaných chodníkoch.",
              "uk": "У Татранському національному парку можна ходити лише промаркованими стежками."
            },
            {
              "sk": "Ak nevidíš značku, vráť sa k poslednej.",
              "uk": "Якщо не бачиш позначки, повернися до останньої."
            }
          ],
          "shortRule": "orientovať sa podľa + родовий",
          "button": "Далі →"
        }
      ],
