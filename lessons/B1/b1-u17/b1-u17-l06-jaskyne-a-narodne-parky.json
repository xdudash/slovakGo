      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Národné parky",
          "text": "У Словаччині дев’ять «národných parkov»: TANAP (Високі Татри), NAPANT (Низькі Татри), Pieniny, Malá Fatra, Veľká Fatra, Slovenský raj, Muránska planina, Slovenský kras і Poloniny. У Словацькому раю — «rokliny» (ущелини) з водоспадами, металеві «rebríky» (драбини) й ланцюги; деякі ущелини «jednosmerné» — ними йдуть лише вгору.",
          "examples": [
            {
              "sk": "V Slovenskom raji sú rokliny s rebríkmi.",
              "uk": "У Словацькому раю є ущелини з драбинами."
            },
            {
              "sk": "Prielom Hornádu je v národnom parku Slovenský raj.",
              "uk": "Прорив Горнаду — у національному парку Словацький рай."
            }
          ],
          "shortRule": "v národnom parku · do národného parku · deväť národných parkov",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Jaskyne",
          "text": "У Словаччині тисячі печер, для відвідувачів «sprístupnených» — близько двох десятків. До списку ЮНЕСКО входять, зокрема, Dobšinská ľadová jaskyňa і Domica. У «kvapľových» печерах ростуть «kvaple» — сталактити й сталагміти. У більшості печер цілий рік 6–7 °C, у льодових — навіть нижче нуля, тож візьми светр. Ходять лише з гідом, «prehliadkový okruh» — екскурсійний маршрут.",
          "examples": [
            {
              "sk": "Prehliadka trvá 45 minút.",
              "uk": "Екскурсія триває 45 хвилин."
            },
            {
              "sk": "V jaskyni je stále okolo 7 °C.",
              "uk": "У печері постійно близько 7 °C."
            }
          ],
          "shortRule": "kvapeľ — kvaple · prehliadka so sprievodcom",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pasívum v informáciách",
          "text": "В інформаційних текстах часто пасив: «byť» + пасивний дієприкметник — «Jaskyňa bola objavená v roku 1921», «Vstup je povolený len so sprievodcom», «Fotografovanie je zakázané». Або дієслово з «sa»: «Vstupenky sa predávajú pri pokladnici», «Prehliadka sa začína každú hodinu». Дієприкметник узгоджується з підметом: jaskyňa — objavená, vstup — povolený.",
          "examples": [
            {
              "sk": "Demänovská jaskyňa slobody bola objavená v roku 1921.",
              "uk": "Деменівську печеру Свободи відкрили 1921 року."
            },
            {
              "sk": "Vstupenky sa predávajú len na mieste.",
              "uk": "Квитки продаються лише на місці."
            }
          ],
          "shortRule": "byť + -ný/-tý · дієслово + sa",
          "button": "Далі →"
        }
