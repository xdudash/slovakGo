      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від адвенту до Štedrého dňa",
          "text": "Свята починаються з адвенту — чотирьох тижнів перед Різдвом. У багатьох домівках на столі стоїть адвентний вінок із чотирма свічками, а в містах працюють vianočné trhy — різдвяні ярмарки. Увечері 5 грудня діти чистять чобітки й ставлять їх на вікно, а вранці 6 грудня знаходять там солодощі від Mikuláša. Головний день — 24 грудня, «Štedrý deň» (Святвечір).",
          "examples": [
            {
              "sk": "Na Mikuláša nachádzajú deti v čižmách sladkosti.",
              "uk": "На Миколая діти знаходять у чобітках солодощі."
            },
            {
              "sk": "Štedrý deň je dvadsiateho štvrtého decembra.",
              "uk": "Святвечір — двадцять четвертого грудня."
            }
          ],
          "shortRule": "advent → Mikuláš (6. 12.) → Štedrý deň (24. 12.)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Štedrá večera",
          "text": "Увечері 24 грудня родина сідає до святкової вечері — «štedrá večera». Часто починають з облатки (тонкого вафельного коржа) з медом, іноді й з часником — на здоров’я. Далі — kapustnica (капусняк, часто з грибами й ковбасою) і kapor (короп) з картопляним салатом. Багато хто кладе луску коропа під тарілку або в гаманець — щоб були гроші. Страви й звичаї відрізняються від регіону до регіону й від родини до родини.",
          "examples": [
            {
              "sk": "Na štedrú večeru máme kapustnicu a kapra so zemiakovým šalátom.",
              "uk": "На святвечірню вечерю в нас капусняк і короп з картопляним салатом."
            },
            {
              "sk": "Šupina z kapra sa dáva do peňaženky.",
              "uk": "Луску з коропа кладуть у гаманець."
            }
          ],
          "shortRule": "oblátky → kapustnica → kapor so šalátom",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ježiško й безособові форми",
          "text": "Подарунки в Словаччині приносить Ježiško (Ісусик), їх кладуть під ялинку й розгортають після вечері. Опівночі віряни йдуть на «polnočnú omšu» — опівнічну месу. Для опису звичаїв зручні безособові форми: «Je zvykom…» + інфінітив і зворотний пасив: «spievajú sa koledy», «pečú sa medovníky» — коли неважливо, хто саме це робить. Дієслово узгоджуємо з підметом: одна річ — «pečie sa koláč», багато — «pečú sa medovníky».",
          "examples": [
            {
              "sk": "Je zvykom prestrieť jeden tanier navyše.",
              "uk": "Є звичай накривати одну тарілку додатково."
            },
            {
              "sk": "Večer sa spievajú koledy.",
              "uk": "Увечері співають колядки."
            }
          ],
          "shortRule": "je zvykom + інфінітив · pečie sa / pečú sa",
