      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Свята року",
          "text": "Різдво: advent, Mikuláš, Štedrý deň, štedrá večera з облатками, капусняком і коропом; подарунки приносить Ježiško. Fašiangy — від Трьох королів до Попільної середи, із масками й «похороном баси». Великдень: kraslice, šibačka, oblievačka. Вихідні: štátny sviatok × deň pracovného pokoja × pamätný deň; список неробочих днів змінюється — перевіряй календар.",
          "examples": [
            {
              "sk": "Na Štedrý deň sa spievajú koledy.",
              "uk": "На Святвечір співають колядки."
            },
            {
              "sk": "Fašiangy sa končia pochovávaním basy.",
              "uk": "Фашанги закінчуються «похороном баси»."
            }
          ],
          "shortRule": "Vianoce → fašiangy → Veľká noc",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Граматика розділу",
          "text": "Безособово про звичаї: «je zvykom» + інфінітив, «pečú sa medovníky». Повторювані дії в минулому: «chodievali, robievali». Опис: «ktorý / ktorá / ktoré», «je zapísaný». Біографія: «narodil sa, stal sa, je známy tým, že…». Порівняння: «podobne ako, na rozdiel od» + родовий, «kým / zatiaľ čo».",
          "examples": [
            {
              "sk": "Kedysi sa na fašiangy robievala zabíjačka.",
              "uk": "Колись на фашанги, бувало, робили заколювання."
            },
            {
              "sk": "Na rozdiel od Slovenska máme dvanásť jedál.",
              "uk": "На відміну від Словаччини, у нас дванадцять страв."
            }
          ],
          "shortRule": "je zvykom · chodievali · ktorý · na rozdiel od",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Тактовно про культуру",
          "text": "Про чужі звичаї говоримо нейтрально й з повагою: «Je to starý zvyk…», «Niekto ho má rád, iný nie.», «Mne osobne sa to (ne)páči, ale rešpektujem to.» У гостях: «Mám sa prezuť?», «Je tu zvykom…?», «Na zdravie!». Про свою культуру — з прикладами: «U nás je zvykom…».",
          "examples": [
            {
              "sk": "Je tu zvykom nosiť na meniny koláč?",
              "uk": "Чи тут заведено приносити на іменини тістечка?"
            },
            {
              "sk": "U nás je zvykom svätiť na Veľkú noc košíky.",
              "uk": "У нас заведено святити на Великдень кошики."
            }
          ],
          "shortRule": "повага · нейтральні слова · приклади",
          "button": "Далі →"
        }
      ],
