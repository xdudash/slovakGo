      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Із салашу",
          "text": "«Salaš» — гірське пасовище з кошарою, де з овечого молока роблять сир. Звідти — «bryndza» (м’який солоний овечий сир), «oštiepok» (копчений сир у формі яйця з візерунками), «parenica» (сир, скручений равликом) і «žinčica» — овеча сироватка, яку п’ють. На багатьох салашах є ресторанчики.",
          "examples": [
            {
              "sk": "Na salaši sme si dali bryndzové halušky a žinčicu.",
              "uk": "На салаші ми взяли бринзові галушки й жинчицю."
            },
            {
              "sk": "Oštiepok je údený ovčí syr.",
              "uk": "Оштєпок — копчений овечий сир."
            }
          ],
          "shortRule": "salaš → bryndza, oštiepok, parenica, žinčica",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Страви",
          "text": "«Bryndzové halušky» — галушки з бринзою і шкварками, національна страва. «Strapačky» — галушки з тушкованою квашеною капустою. «Kapustnica» — капусняк. «Cesnaková polievka» — часниковий суп, часто подають просто в хлібі. «Lokše» — тонкі картопляні коржі, солодкі або з начинкою, наприклад із гусячою печінкою.",
          "examples": [
            {
              "sk": "Strapačky sú halušky s kyslou kapustou.",
              "uk": "Страпачки — це галушки з квашеною капустою."
            },
            {
              "sk": "Cesnakovú polievku podávajú v chlebe.",
              "uk": "Часниковий суп подають у хлібі."
            }
          ],
          "shortRule": "bryndzové halušky · strapačky · lokše",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Смак і поради",
          "text": "Смак: «Chutí ako…» — смакує як…; «Podobá sa na…» + знахідний — схоже на…; «slaný» — солоний, «kyslastý» — кислуватий, «údený» — копчений, «mastný» — жирний. Поради: «Určite ochutnaj…», «Odporúčam vám…», «Ak máš rád syr, musíš skúsiť…».",
          "examples": [
            {
              "sk": "Kapustnica sa podobá na ukrajinský kapusňak.",
              "uk": "Капустніца схожа на український капусняк."
            },
            {
              "sk": "Oštiepok chutí trochu ako údený syr z Karpát.",
              "uk": "Оштєпок на смак трохи як копчений сир із Карпат."
            }
          ],
          "shortRule": "chutí ako… · podobá sa na + знахідний · určite ochutnaj",
          "commonMistakes": [
            {
              "mistake": "Podobá sa ako…",
              "correct": "Podobá sa na…"
            },
            {
              "mistake": "Chutí sa mi.",
              "correct": "Chutí mi."
            }
          ],
          "button": "Далі →"
        }
