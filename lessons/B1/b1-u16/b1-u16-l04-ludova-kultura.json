      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kroj і výšivka",
          "text": "«Kroj» — народний стрій. Кожен регіон, а часто й кожне село має свій стрій: різні кольори, візерунки, головні убори. Сьогодні народний стрій вдягають на свята, весілля й фестивалі. «Výšivka» — вишивка — як і в Україні, важлива частина строю. Народну музику грають на «fujare», «gajdách», «cimbale», а народні пісні — «ľudové piesne» — співають досі.",
          "examples": [
            {
              "sk": "Na festivale tancovali dievčatá v krojoch.",
              "uk": "На фестивалі танцювали дівчата в народних строях."
            },
            {
              "sk": "Táto výšivka je z Detvy.",
              "uk": "Ця вишивка з Детви."
            }
          ],
          "shortRule": "kroj — v kroji, v krojoch",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ktorý, ktorá, ktoré",
          "text": "Щоб описати предмет, уживаємо відносне речення з «ktorý / ktorá / ktoré» (який, яка, яке). Рід і число — як у слова, до якого воно відноситься, а відмінок — за роллю в підрядному реченні: «fujara, ktorá je dlhá» (називний), «kroj, ktorý ušila babka» (знахідний), «dedina, v ktorej sa narodil» (місцевий). Перед ktorý ставимо кому.",
          "examples": [
            {
              "sk": "Fujara je pastierska píšťala, ktorá môže byť dlhá takmer dva metre.",
              "uk": "Фуяра — пастуша сопілка, яка може мати майже два метри завдовжки."
            },
            {
              "sk": "To je dedina, v ktorej sa narodil Jánošík.",
              "uk": "Це село, в якому народився Яношик."
            }
          ],
          "shortRule": ", ktorý / ktorá / ktoré — рід як у слова, відмінок за роллю",
          "commonMistakes": [
            {
              "mistake": "kroj, ktorá…",
              "correct": "kroj, ktorý…"
            },
            {
              "mistake": "dedina, v ktorá…",
              "correct": "dedina, v ktorej…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Пасив і UNESCO",
          "text": "Про пам’ятки часто говорять пасивом: «je zapísaný» — внесений до списку, «bol postavený» — був збудований. «Fujara a jej hudba sú zapísané v zozname UNESCO.» Відомі місця: Čičmany з дерев’яними хатами, розмальованими білими візерунками, Vlkolínec, Terchová — батьківщина легендарного «zbojníka» Яношика, який, за легендою, брав у багатих і давав бідним. Щоліта в селі Východná відбувається великий фольклорний фестиваль.",
          "examples": [
            {
              "sk": "Vlkolínec je zapísaný v zozname UNESCO.",
              "uk": "Влколінец внесено до списку ЮНЕСКО."
            },
            {
              "sk": "Jánošík bral bohatým a dával chudobným.",
              "uk": "Яношик брав у багатих і давав бідним."
            }
          ],
          "shortRule": "je zapísaný · bol postavený",
          "button": "Далі →"
        }
