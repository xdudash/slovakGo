      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сусіди",
          "text": "Словаччина й Україна — сусідні країни зі спільним кордоном на сході Словаччини. На північному сході країни здавна живуть русини й українці — національні меншини. У Свиднику є Музей української культури, а щоліта там проходить фестиваль культури русинів-українців. У цьому краї стоять дерев’яні церкви — «drevené cerkvi», схожі на ті, що в українських Карпатах.",
          "examples": [
            {
              "sk": "Na severovýchode Slovenska žije rusínska a ukrajinská menšina.",
              "uk": "На північному сході Словаччини живуть русинська й українська меншини."
            },
            {
              "sk": "Drevené cerkvi sa podobajú na tie v ukrajinských Karpatoch.",
              "uk": "Дерев’яні церкви схожі на ті, що в українських Карпатах."
            }
          ],
          "shortRule": "susedné krajiny · menšina · cerkev",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Порівняння",
          "text": "Схожість: «podobne ako» — подібно як; «rovnako ako» — так само як; «aj u nás…» — і в нас. Відмінність: «na rozdiel od + родовий» — на відміну від: «na rozdiel od Slovenska». Протиставлення двох частин: «kým» або «zatiaľ čo» — тоді як.",
          "examples": [
            {
              "sk": "Podobne ako Slováci, aj my maľujeme vajíčka.",
              "uk": "Як і словаки, ми теж розписуємо яйця."
            },
            {
              "sk": "Na rozdiel od Slovenska u nás často oslavujeme Veľkú noc neskôr.",
              "uk": "На відміну від Словаччини, у нас Великдень часто пізніше."
            }
          ],
          "shortRule": "podobne ako · na rozdiel od + родовий · kým / zatiaľ čo",
          "commonMistakes": [
            {
              "mistake": "Na rozdiel od Slovensko…",
              "correct": "Na rozdiel od Slovenska…"
            },
            {
              "mistake": "podobne než…",
              "correct": "podobne ako…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Календарі й мова",
          "text": "Великдень в Україні здебільшого рахують за юліанським календарем, тому він часто припадає на інший день, ніж у Словаччині. Різдво з 2023 року в Україні офіційно відзначають 25 грудня, хоча деякі родини тримаються 7 січня. Мови близькі, але є фальшиві друзі перекладача: «čerstvý» — свіжий (а не черствий), «zápach» — сморід (а не запах), «voňať» — гарно пахнути (а не «воняти»).",
          "examples": [
            {
              "sk": "Tento chlieb je čerstvý.",
              "uk": "Цей хліб свіжий."
            },
            {
              "sk": "V kuchyni krásne vonia.",
              "uk": "На кухні гарно пахне."
            }
