      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто що лікує",
          "text": "«Kardiológ» лікує серце й тиск, «neurológ» — нерви, головний біль, оніміння, біль у спині, «ortopéd» — суглоби й кістки, «kožný lekár» (dermatológ) — шкіру, «očný lekár» (oftalmológ) — очі, «gynekológ» — жіноче здоров’я, «ORL» (ušný, nosný, krčný lekár) — вухо, ніс і горло. Розмовно часто називають кабінет: «Idem na kožné», «na očné», «na ORL». Хто чим займається: «zaoberať sa» + орудний.",
          "examples": [
            {
              "sk": "Kardiológ sa zaoberá ochoreniami srdca.",
              "uk": "Кардіолог займається хворобами серця."
            },
            {
              "sk": "Zajtra idem na očné.",
              "uk": "Завтра йду до окуліста."
            }
          ],
          "shortRule": "zaoberať sa + орудний · ísť na očné / kožné",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Де? Куди? Від кого?",
          "text": "З A2 ти знаєш «k ortopédovi» (куди?). Тепер — уся система. Де? — «u + родовий»: «Bol som u neurológa.» Від кого? — «od + родовий»: «správa od ortopéda». Лікарка: «kardiologička», «neurologička», «gynekologička», «očná lekárka», «kožná lekárka». Відділення в лікарні: «kardiológia», «neurológia», «ortopédia» → «na kardiológii» (місцевий).",
          "examples": [
            {
              "sk": "Som objednaný u neurologičky na budúci týždeň.",
              "uk": "Я записаний до неврологині на наступний тиждень."
            },
            {
              "sk": "Nález od ortopéda som poslal obvodnej lekárke.",
              "uk": "Висновок від ортопеда я надіслав дільничній лікарці."
            }
          ],
          "shortRule": "u + родовий · k + давальний · od + родовий",
          "commonMistakes": [
            {
              "mistake": "Bol som u kardiológ.",
              "correct": "Bol som u kardiológa."
            },
            {
              "mistake": "na kardiológie",
              "correct": "na kardiológii"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Твоя історія хвороби",
          "text": "Спеціаліст попросить коротко розповісти, чим ти хворів і як лікуєшся. «Liečim sa na tlak» — я лікуюся від тиску (liečiť sa na + знахідний). «Užívam lieky na štítnu žľazu» — приймаю ліки для щитоподібної залози. «Pred dvoma rokmi som mal operáciu kolena» — два роки тому мав операцію на коліні (pred + орудний). «V rodine máme cukrovku» — у родині є діабет. Приноси «výmenný lístok» і попередні висновки.",
          "examples": [
            {
              "sk": "Liečim sa na vysoký tlak už päť rokov.",
              "uk": "Я лікуюся від високого тиску вже п’ять років."
            },
            {
              "sk": "Otec mal infarkt, preto chodím pravidelne na kontroly.",
              "uk": "Батько мав інфаркт, тому я регулярно ходжу на контролі."
            }
          ],
          "shortRule": "liečiť sa na + знахідний · pred + орудний",
