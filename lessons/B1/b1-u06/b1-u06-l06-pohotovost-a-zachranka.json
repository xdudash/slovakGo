      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Виклик",
          "text": "Номери ти знаєш з A2: 155 — záchranná služba, 112 — єдиний номер. Тепер — як говорити. Диспетчер («operátor», «operátorka») питає: «Čo sa stalo? Kde presne ste? Koľko ľudí je zranených?» Відповідай за схемою: що сталося → де (місто, вулиця, номер, орієнтир: «pri benzínke», «vchod z dvora») → хто і в якому стані. Не клади слухавку, поки тобі не дозволять: «Nezavesujte.»",
          "examples": [
            {
              "sk": "Kolega spadol z rebríka a nehýbe sa.",
              "uk": "Колега впав із драбини й не рухається."
            },
            {
              "sk": "Sme v sklade na Priemyselnej ulici 12, vchod z dvora.",
              "uk": "Ми на складі на вулиці Промисловій, 12, вхід із двору."
            }
          ],
          "shortRule": "čo → kde → kto · nezavesujte",
          "commonMistakes": [
            {
              "mistake": "Sme na ulici Priemyselná.",
              "correct": "Sme na Priemyselnej ulici."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Стан людини",
          "text": "Ключові питання: «Je pri vedomí?» (при тямі?), «Dýcha?», «Krváca?». «Bezvedomie» — непритомність: «Je v bezvedomí.» Ознаки «infarktu»: сильний тиск у грудях, біль віддає в ліву руку чи щелепу, холодний піт, нудота. «Mozgová príhoda» (інсульт, розмовно «porážka»): опущений куточок рота («ovisnutý kútik úst»), слабкість однієї руки, незрозуміла мова. Тут важлива кожна хвилина.",
          "examples": [
            {
              "sk": "Je v bezvedomí, ale dýcha.",
              "uk": "Він непритомний, але дихає."
            },
            {
              "sk": "Má silnú bolesť na hrudi a je celý spotený.",
              "uk": "У нього сильний біль у грудях, і він увесь спітнілий."
            }
          ],
          "shortRule": "v bezvedomí × pri vedomí",
          "commonMistakes": [
            {
              "mistake": "Je bezvedomie.",
              "correct": "Je v bezvedomí."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перша допомога",
          "text": "«Prvá pomoc» — перша допомога; курс першої допомоги проходить кожен майбутній водій. Диспетчер дає вказівки в наказовому способі: «Uložte ho do stabilizovanej polohy» (у стабільне бокове положення), «Tlačte silno na ranu», «Popáleninu chlaďte vodou aspoň desať minút», «Nehýbte s ním, môže mať zlomeninu», «Ak nedýcha, začnite masáž srdca.»",
          "examples": [
            {
              "sk": "Popáleninu chlaďte studenou vodou.",
              "uk": "Опік охолоджуйте холодною водою."
            },
            {
              "sk": "Nehýbte s ním, môže mať zlomeninu.",
              "uk": "Не рухайте його, у нього може бути перелом."
            }
          ],
          "shortRule": "uložte · tlačte · chlaďte · nehýbte",
          "button": "Далі →"
        }
