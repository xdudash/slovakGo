      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Профілактичні огляди",
          "text": "«Prevencia» — профілактика. Профілактичні огляди («preventívne prehliadky») оплачує страхова: у сімейного лікаря дорослі мають право на огляд раз на два роки, у стоматолога — раз на рік, у гінеколога — раз на рік. На огляді міряють тиск, беруть кров і сечу, з певного віку роблять ЕКГ. «Oplatí sa ísť, aj keď nič nebolí.»",
          "examples": [
            {
              "sk": "Na preventívnu prehliadku k obvodnej lekárke chodím raz za dva roky.",
              "uk": "На профілактичний огляд до дільничної лікарки я ходжу раз на два роки."
            },
            {
              "sk": "Prevencia je lacnejšia ako liečba.",
              "uk": "Профілактика дешевша за лікування."
            }
          ],
          "shortRule": "raz za dva roky · raz ročne",
          "commonMistakes": [
            {
              "mistake": "raz za dva rok",
              "correct": "raz za dva roky"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Щеплення й скринінги",
          "text": "«Očkovanie» — щеплення: «povinné očkovanie detí», «očkovanie proti chrípke» (proti + давальний), «preočkovanie proti tetanu» (ревакцинація від правця). Зробити щеплення — «dať sa zaočkovať». «Skríning» — обстеження людей без симптомів, щоб рано виявити хворобу, наприклад «skríning rakoviny hrubého čreva»: страхова надсилає «pozvánku» — запрошення.",
          "examples": [
            {
              "sk": "Dala som sa zaočkovať proti chrípke.",
              "uk": "Я зробила щеплення від грипу."
            },
            {
              "sk": "Poisťovňa mi poslala pozvánku na skríning.",
              "uk": "Страхова надіслала мені запрошення на скринінг."
            }
          ],
          "shortRule": "očkovanie proti + давальний · dať sa zaočkovať",
          "commonMistakes": [
            {
              "mistake": "očkovanie od chrípky",
              "correct": "očkovanie proti chrípke"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порада й переконання",
          "text": "Радити: «Mal by si ísť na prehliadku» (тобі варто), «Oplatí sa to», «Je lepšie predchádzať chorobám, ako ich liečiť» (predchádzať + давальний — запобігати). Умовний спосіб пом’якшує пораду: «Na tvojom mieste by som si dal skontrolovať cholesterol.» Аргумент: «Čím skôr sa choroba zistí, tým lepšie sa lieči.» — Чим раніше виявлять хворобу, тим краще її лікувати.",
          "examples": [
            {
              "sk": "Na tvojom mieste by som išla na prehliadku čo najskôr.",
              "uk": "На твоєму місці я пішла б на огляд якнайшвидше."
            },
            {
              "sk": "Čím skôr, tým lepšie.",
              "uk": "Чим раніше, тим краще."
            }
          ],
          "shortRule": "mal by si… · na tvojom mieste by som… · čím…, tým…",
