      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Який це біль?",
          "text": "На рівні A1–A2 вистачало «Bolí ma hlava». На B1 лікар спитає більше: «Aká je to bolesť?» Біль буває «tupá» (тупий, ниючий), «ostrá» (гострий), «pálivá» (пекучий), «bodavá» (колючий), «pulzujúca» (пульсуючий). Зверни увагу: «bolesť» у словацькій — жіночого роду, тож прикметники мають закінчення -á. Силу болю часто оцінюють за шкалою: «Na stupnici od jedna do desať je to tak sedem.»",
          "examples": [
            {
              "sk": "Je to tupá bolesť v krížoch.",
              "uk": "Це тупий біль у попереку."
            },
            {
              "sk": "Bolesť je ostrá a pálivá.",
              "uk": "Біль гострий і пекучий."
            }
          ],
          "shortRule": "bolesť (ж. р.) → tupá, ostrá, pálivá, bodavá",
          "commonMistakes": [
            {
              "mistake": "tupý bolesť",
              "correct": "tupá bolesť"
            },
            {
              "mistake": "Mám ostrý bolesť.",
              "correct": "Mám ostrú bolesť."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Куди віддає і як я почуваюся",
          "text": "Важливо сказати, де біль починається і куди віддає: «vystreľuje (mi) do ruky / do nohy / do chrbta». Стан часто описують конструкціями з давальним відмінком: «Je mi zle» (мені погано), «Je mi na vracanie» (мене нудить), «Točí sa mi hlava» (паморочиться голова), «Tŕpnu mi prsty» (терпнуть пальці). «Kŕč» — судома: «Mám kŕče v lýtkach» (у литках).",
          "examples": [
            {
              "sk": "Bolesť mi vystreľuje z krížov do ľavej nohy.",
              "uk": "Біль віддає мені з попереку в ліву ногу."
            },
            {
              "sk": "V noci mi tŕpne pravá ruka.",
              "uk": "Уночі в мене терпне права рука."
            }
          ],
          "shortRule": "vystreľuje do + родовий · je mi zle / na vracanie",
          "commonMistakes": [
            {
              "mistake": "Som zle.",
              "correct": "Je mi zle."
            },
            {
              "mistake": "Tŕpnem prsty.",
              "correct": "Tŕpnu mi prsty."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відколи і як змінюється",
          "text": "Лікар спитає: «Odkedy to máte?» — Відколи це у вас? Відповідь: «od včera», «od pondelka» (od + родовий), «už tri dni», «asi týždeň». Як змінюється: «zhoršuje sa» (погіршується), «zlepšuje sa», «prichádza a odchádza» (то з’являється, то зникає), «je to horšie v noci / po jedle / pri chôdzi». Супутні симптоми: «nevoľnosť» (нудота), «zvracanie» (блювання), «hnačka» (діарея).",
          "examples": [
            {
              "sk": "Bolí ma to už tri dni a v noci je to horšie.",
              "uk": "Болить уже три дні, а вночі гірше."
            },
            {
              "sk": "Od rána mám hnačku a nevoľnosť.",
              "uk": "З ранку в мене діарея й нудота."
            }
          ],
          "shortRule": "od + родовий · už + тривалість · horšie po / pri",
          "commonMistakes": [
            {
              "mistake": "od pondelok",
              "correct": "od pondelka"
            },
            {
              "mistake": "Bolesť zhoršuje.",
              "correct": "Bolesť sa zhoršuje."
            }
          ],
          "button": "Далі →"
        }
