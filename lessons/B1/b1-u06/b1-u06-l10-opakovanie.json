      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від симптому до діагнозу",
          "text": "Симптоми: «tupá / ostrá bolesť», «vystreľuje mi do…», «je mi na vracanie», «od pondelka», «zhoršuje sa». Спеціаліст: «u neurológa», «ku kardiologičke», «liečim sa na…». Обстеження: «ísť na ultrazvuk», «príďte nalačno», «krvný obraz je v norme». Спершу лікар збирає «anamnézu» — історію хвороби, зокрема сімейну.",
          "examples": [
            {
              "sk": "Bolesť mi vystreľuje do ľavej ruky a pri námahe sa zhoršuje.",
              "uk": "Біль віддає мені в ліву руку й посилюється при навантаженні."
            },
            {
              "sk": "Výsledky sú v norme, ale pošlem vás ešte na EKG.",
              "uk": "Результати в нормі, але я направлю вас іще на ЕКГ."
            }
          ],
          "shortRule": "vystreľuje do · u + родовий · ísť na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Лікарня, операція, екстрена допомога",
          "text": "Лікарня: «hospitalizovať», «vizita», «návštevné hodiny», «prepustiť» (не vypísať!), «prepúšťacia správa». Операція: «informovaný súhlas», «v celkovej narkóze», «vybrať stehy», «jazva» (шрам), «rekonvalescencia». Екстрено: 155 / 112, «čo → kde → kto», «je v bezvedomí, ale dýcha», «uložte ho do stabilizovanej polohy». Тривала хвороба — «chronické ochorenie».",
          "examples": [
            {
              "sk": "Otca prepustili po operácii, stehy mu vyberú o týždeň.",
              "uk": "Батька виписали після операції, шви йому знімуть через тиждень."
            },
            {
              "sk": "Sused je v bezvedomí, ale dýcha.",
              "uk": "Сусід непритомний, але дихає."
            }
          ],
          "shortRule": "prepustiť · v narkóze · v bezvedomí",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Психіка, профілактика, спосіб життя",
          "text": "Психічне здоров’я: «cítim sa vyčerpaný», «som v strese z práce», «Nie si v tom sám». Профілактика: «raz za dva roky», «dať sa zaočkovať proti…», «skríning». Спосіб життя: «vyvážená strava», «pitný režim», «Odkedy…, …», «na jednej strane… na druhej strane». Одужати, відновитися — «zotaviť sa»: «Rýchlo sa zotavil.»",
          "examples": [
            {
              "sk": "Po chrípke som sa zotavovala dva týždne.",
              "uk": "Після грипу я відновлювалася два тижні."
            },
            {
              "sk": "Na tvojom mieste by som sa dal zaočkovať.",
              "uk": "На твоєму місці я зробив би щеплення."
            }
          ],
          "shortRule": "zotaviť sa · dať sa zaočkovať · mal by si…",
          "button": "Далі →"
        }
      ],
