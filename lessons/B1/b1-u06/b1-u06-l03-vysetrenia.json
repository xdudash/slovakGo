      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Види обстежень",
          "text": "«Röntgen» (RTG) — рентген, «ultrazvuk» (USG, sonografia) — УЗД, «CT» — комп’ютерна томографія, «magnetická rezonancia» — МРТ, «EKG» — електрокардіограма, «krvný obraz» — загальний аналіз крові, «vzorka moču» — зразок сечі. Дієслова: «urobiť vyšetrenie», «ísť na röntgen» (na + знахідний), «dať si urobiť krvné testy».",
          "examples": [
            {
              "sk": "Lekár ma poslal na ultrazvuk brucha.",
              "uk": "Лікар направив мене на УЗД черевної порожнини."
            },
            {
              "sk": "Na magnetickú rezonanciu sa čaká tri mesiace.",
              "uk": "На МРТ чекають три місяці."
            }
          ],
          "shortRule": "ísť na + знахідний · urobiť vyšetrenie",
          "commonMistakes": [
            {
              "mistake": "ísť na röntgene",
              "correct": "ísť na röntgen"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Підготовка й вказівки",
          "text": "Інструкції — у наказовому способі або з «nesmiete / treba»: «Príďte nalačno», «Šesť hodín pred vyšetrením nejedzte» (pred + орудний), «Ráno nefajčite», «Prineste si vzorku ranného moču», «Hodinu pred vyšetrením vypite liter vody». Під час огляду: «Vyzlečte sa do pol pása» (роздягніться до пояса), «Ľahnite si na chrbát», «Zhlboka sa nadýchnite a nedýchajte», «Môžete sa obliecť.»",
          "examples": [
            {
              "sk": "Šesť hodín pred vyšetrením nesmiete jesť ani piť.",
              "uk": "За шість годин до обстеження не можна їсти й пити."
            },
            {
              "sk": "Zhlboka sa nadýchnite a zadržte dych.",
              "uk": "Глибоко вдихніть і затримайте дихання."
            }
          ],
          "shortRule": "pred + орудний · nesmiete + інфінітив",
          "commonMistakes": [
            {
              "mistake": "pred vyšetrenie",
              "correct": "pred vyšetrením"
            },
            {
              "mistake": "Ľahnite sa.",
              "correct": "Ľahnite si."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Результати",
          "text": "«Výsledky budú do troch dní», «Výsledky pošleme vašej lekárke». Оцінки: «v norme» (у нормі), «negatívny» (негативний — для тесту це зазвичай добре!), «pozitívny», «zvýšený / znížený» (підвищений / знижений): «Máte zvýšený cholesterol.» «Nález je bez patologických zmien» — без патологічних змін, тобто все гаразд. «Treba to doplniť ďalším vyšetrením» — потрібне ще одне обстеження.",
          "examples": [
            {
              "sk": "Krvný obraz je v norme.",
              "uk": "Аналіз крові в нормі."
