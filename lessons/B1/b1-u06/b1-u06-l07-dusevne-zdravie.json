      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як я почуваюся",
          "text": "«Duševné zdravie» — психічне здоров’я; це така сама частина здоров’я, як серце чи спина. Стан описують через «cítim sa + прикметник»: «cítim sa vyčerpaný / vyčerpaná» (виснажений), «napätý» (напружений), «smutný». Також: «Nič ma neteší» (ніщо не тішить), «Nemôžem sa sústrediť», «V noci nemôžem zaspať» — це «nespavosť» (безсоння). Переїзд, нова мова, робота й тривога за рідних — часті причини стресу, і про це нормально говорити.",
          "examples": [
            {
              "sk": "Posledné týždne sa cítim stále unavená a napätá.",
              "uk": "Останні тижні я весь час почуваюся втомленою й напруженою."
            },
            {
              "sk": "Nemôžem sa sústrediť a v noci sa budím.",
              "uk": "Не можу зосередитися й уночі прокидаюся."
            }
          ],
          "shortRule": "cítim sa + прикметник · nemôžem sa sústrediť",
          "commonMistakes": [
            {
              "mistake": "Cítim vyčerpaný.",
              "correct": "Cítim sa vyčerpaný."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Стрес, вигорання, тривога",
          "text": "«Stres» — стрес: «Som v strese z práce» (z + родовий). «Vyhorenie» — вигорання: довга виснаженість від роботи, коли нічого не хочеться: «je vo vyhorení». «Úzkosť» — тривога: «Trápi ma úzkosť». Це стани, а не слабкість характеру. Про людину не кажуть зневажливо «je blázon» — це образливо. Нейтрально: «prechádza ťažkým obdobím» (переживає важкий період).",
          "examples": [
            {
              "sk": "Kolega je vo vyhorení, je doma na PN.",
              "uk": "Колега у вигоранні, він удома на лікарняному."
            },
            {
              "sk": "Prechádza teraz ťažkým obdobím.",
              "uk": "Він зараз переживає важкий період."
            }
          ],
          "shortRule": "som v strese z + родовий · prechádzať ťažkým obdobím",
          "commonMistakes": [
            {
              "mistake": "Som v strese od práce.",
              "correct": "Som v strese z práce."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де шукати допомогу",
          "text": "«Psychológ» — психолог: розмова, консультація; часто платно, але є й безкоштовні «poradne» (консультаційні центри), зокрема для людей з України. «Psychiater» — лікар-психіатр: ставить діагноз і може виписати ліки. «Psychoterapia» — тривала терапія розмовою. Почати можна із сімейного лікаря: «Mám dlhodobo problémy so spánkom. Kam sa môžem obrátiť?» Підтримка: «Nie si v tom sám / sama», «Som tu pre teba», «Ako ti môžem pomôcť?»",
          "examples": [
            {
              "sk": "Kam sa môžem obrátiť, ak potrebujem psychologickú pomoc?",
              "uk": "Куди мені звернутися, якщо потрібна психологічна допомога?"
            },
            {
              "sk": "Nie si v tom sama, som tu pre teba.",
              "uk": "Ти не сама в цьому, я поруч."
            }
          ],
          "shortRule": "obrátiť sa na + знахідний · Nie si v tom sám.",
          "button": "Далі →"
        }
      ],
