      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Перед операцією",
          "text": "Операція буває «plánovaná» (планова, з датою наперед) або «akútna» (екстрена). Менша процедура — «zákrok»: «malý chirurgický zákrok». Перед плановою операцією потрібне «predoperačné vyšetrenie» — аналізи, ЕКГ, іноді рентген легень. Ти підписуєш «informovaný súhlas» — інформовану згоду: лікар мусить пояснити, що робитимуть і які ризики. Не соромся питати: «Aké sú riziká?», «Ako dlho budem v nemocnici?»",
          "examples": [
            {
              "sk": "Pred operáciou podpíšete informovaný súhlas.",
              "uk": "Перед операцією ви підпишете інформовану згоду."
            },
            {
              "sk": "Na predoperačné vyšetrenie choďte k obvodnej lekárke.",
              "uk": "На передопераційне обстеження ідіть до дільничної лікарки."
            }
          ],
          "shortRule": "plánovaná × akútna · informovaný súhlas",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Наркоз",
          "text": "«Celková narkóza» (celková anestézia) — загальний наркоз: ти спиш. «Lokálne umŕtvenie» — місцеве знеболення: «Umŕtvime vám len prst.» Анестезіолог («anesteziológ») спитає про алергії, ліки й попередні наркози. Стан — з прийменником v + місцевий: «v celkovej narkóze». Перед наркозом: «Šesť hodín pred operáciou nejedzte a nepite.»",
          "examples": [
            {
              "sk": "Operácia bude v celkovej narkóze.",
              "uk": "Операція буде під загальним наркозом."
            },
            {
              "sk": "Mali ste niekedy problém s narkózou?",
              "uk": "У вас колись були проблеми з наркозом?"
            }
          ],
          "shortRule": "v celkovej narkóze · lokálne umŕtvenie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Після операції",
          "text": "«Stehy» — шви: «Stehy vám vyberieme o desať dní» (знімемо шви). «Jazva» — шрам. Обережно: «jazva» звучить як «язва», але означає саме шрам; виразка словацькою — «vred». «Rekonvalescencia» — відновлення після хвороби чи операції. Типові вказівки: «Dva týždne nedvíhajte nič ťažké», «Ranu udržiavajte v suchu», «Ak sa rana zapáli alebo dostanete horúčku, okamžite príďte.»",
          "examples": [
            {
              "sk": "Jazva sa hojí dobre.",
              "uk": "Шрам добре гоїться."
            },
            {
              "sk": "Rekonvalescencia potrvá asi šesť týždňov.",
              "uk": "Відновлення триватиме приблизно шість тижнів."
            }
          ],
          "shortRule": "jazva = шрам · vybrať stehy · nedvíhajte",
          "button": "Далі →"
        }
      ],
