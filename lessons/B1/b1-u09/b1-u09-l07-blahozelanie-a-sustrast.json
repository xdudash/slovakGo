      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Привітання",
          "text": "«Blahoželať / gratulovať + давальний + k + давальний»: «Blahoželám ti k narodeninám», «k meninám», «k svadbe», «k narodeniu dcérky». Побажання: «Všetko najlepšie!», «Veľa zdravia, šťastia a lásky!», «Prajem ti…» + знахідний. «Blahoželanie» — привітання (листівка, лист).",
          "examples": [
            {
              "sk": "Srdečne blahoželáme k narodeniu syna!",
              "uk": "Щиро вітаємо з народженням сина!"
            },
            {
              "sk": "Všetko najlepšie k meninám!",
              "uk": "Усього найкращого з іменинами!"
            }
          ],
          "shortRule": "blahoželať + давальний + k + давальний",
          "commonMistakes": [
            {
              "mistake": "Blahoželám ťa s narodeninami.",
              "correct": "Blahoželám ti k narodeninám."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Співчуття",
          "text": "Коли хтось помер, кажуть коротко: «Úprimnú sústrasť» (щире співчуття), «Je mi to veľmi ľúto», «Myslím na vás v tejto ťažkej chvíli.» Письмово: «Prijmite moju úprimnú sústrasť.» Евфемізм для смерті: «navždy nás opustil» — назавжди залишив нас. «Zosnulý» — покійний, «pohreb» — похорон, «rozlúčka» — прощання, «smútočné oznámenie» — жалобне оголошення.",
          "examples": [
            {
              "sk": "Prijmite moju úprimnú sústrasť.",
              "uk": "Прийміть моє щире співчуття."
            },
            {
              "sk": "Myslím na vás v tejto ťažkej chvíli.",
              "uk": "Думаю про вас у цю важку хвилину."
            }
          ],
          "shortRule": "Úprimnú sústrasť · zosnulý · pohreb",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Формально й неформально",
          "text": "Другові: «Gratulujem! Si šikovná!», «Všetko najlepšie, užite si to!» Керівникові чи партнерові: «Dovoľte mi zablahoželať Vám k…» — «Vám» з великої літери. «Jubileum» — ювілей, кругла дата: 50, 60 років; «životné jubileum» — ювілей людини.",
          "examples": [
            {
              "sk": "Dovoľte mi zablahoželať Vám k životnému jubileu.",
              "uk": "Дозвольте привітати Вас із ювілеєм."
            },
            {
              "sk": "Gratulujem k promócii, si šikovná!",
              "uk": "Вітаю з випуском, ти молодець!"
            }
          ],
          "shortRule": "formálne: Dovoľte mi zablahoželať Vám… · neformálne: Gratulujem!",
          "button": "Далі →"
        }
      ],
