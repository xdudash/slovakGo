      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сказати «ні»",
          "text": "«Nie, ďakujem» — цього достатньо, довго пояснювати не обов’язково. М’якше: «Ďakujem za ponuku, ale tentoraz nie.» «Tento víkend nemôžem.» «Potrebujem čas pre seba» — мені потрібен час для себе. На роботі: «Tento týždeň to nestihnem. Môžeme sa dohodnúť na inom termíne?»",
          "examples": [
            {
              "sk": "Ďakujem za ponuku, ale tentoraz nie.",
              "uk": "Дякую за пропозицію, але цього разу ні."
            },
            {
              "sk": "Tento víkend potrebujem čas pre seba.",
              "uk": "Цих вихідних мені потрібен час для себе."
            }
          ],
          "shortRule": "Ďakujem, ale tentoraz nie · čas pre seba",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Приватність",
          "text": "«Súkromie» — приватність, особисте життя. На незручне питання про зарплату, дітей чи стосунки: «To by som si radšej nechal(a) pre seba.» — Це я волів би залишити при собі. «O tom by som radšej nehovoril(a).» Пряма відповідь «To je moja vec» (Це моя справа) звучить різко — бережи її для крайніх випадків.",
          "examples": [
            {
              "sk": "O tom by som radšej nehovorila.",
              "uk": "Про це я б краще не говорила."
            },
            {
              "sk": "To si nechám pre seba.",
              "uk": "Це я залишу при собі."
            }
          ],
          "shortRule": "nechať si pre seba",
          "commonMistakes": [
            {
              "mistake": "To si nechám pre sebe.",
              "correct": "To si nechám pre seba."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Тиск і повага",
          "text": "«Nátlak» — тиск, «naliehať (na niekoho)» — наполягати. «Zasahovať do + родовий» або розмовне «miešať sa do + родовий» — втручатися в щось: «Nezasahuj mi do súkromia», «Nemiešaj sa do toho.» Кожному потрібен «osobný priestor» — особистий простір. «Rešpektovať + знахідний» — поважати: «Prosím, rešpektuj moje rozhodnutie.» Межа — це не грубість, а ясність. Почни з визнання: «Viem, že to myslíš dobre, ale…»",
          "examples": [
            {
              "sk": "Viem, že to myslíš dobre, ale rozhodla som sa inak.",
              "uk": "Знаю, що ти хочеш як краще, але я вирішила інакше."
            },
            {
              "sk": "Po šiestej večer neodpovedám na pracovné maily.",
              "uk": "Після шостої вечора я не відповідаю на робочі листи."
            }
          ],
          "shortRule": "zasahovať / miešať sa do + родовий · rešpektovať + знахідний",
          "commonMistakes": [
            {
              "mistake": "Nezasahuj mi v život.",
              "correct": "Nezasahuj mi do života."
            }
          ],
          "button": "Далі →"
        }
