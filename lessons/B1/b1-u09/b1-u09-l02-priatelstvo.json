      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kamarát, priateľ, známy",
          "text": "«Kamarát / kamarátka» — друг, подруга, найуживаніше слово. «Priateľ / priateľka» — близький друг, але в розмові це дуже часто хлопець / дівчина, тобто партнер! «Moja priateľka» найчастіше означає «моя дівчина». «Známy / známa» — знайомий. «Najlepší kamarát» — найкращий друг, «blízky» — близький.",
          "examples": [
            {
              "sk": "Toto je Peter, môj kamarát z práce.",
              "uk": "Це Петер, мій друг з роботи."
            },
            {
              "sk": "Je to skôr známa ako kamarátka.",
              "uk": "Це радше знайома, ніж подруга."
            }
          ],
          "shortRule": "kamarát (друг) · priateľ (часто партнер) · známy",
          "commonMistakes": [
            {
              "mistake": "(про подругу) Toto je moja priateľka Oľga, chodíme spolu na jogu.",
              "correct": "Toto je moja kamarátka Oľga, chodíme spolu na jogu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Порозуміння й довіра",
          "text": "«Rozumieme si» — ми порозумілися, нам добре разом (зворотне «si» + s + орудний: «Rozumiem si s Janou»). «Spoľahnúť sa na + знахідний» — покластися на когось. «Dôverovať + давальний» — довіряти комусь: «Dôverujem jej.» «Zveriť sa + давальний» — звіритися, розповісти щось особисте: «Zverila sa mi so svojím problémom.»",
          "examples": [
            {
              "sk": "S Oksanou si rozumieme od prvého dňa.",
              "uk": "З Оксаною ми порозумілися з першого дня."
            },
            {
              "sk": "Vždy sa môžem na teba spoľahnúť.",
              "uk": "Я завжди можу на тебе покластися."
            }
          ],
          "shortRule": "rozumieť si s + орудний · dôverovať + давальний",
          "commonMistakes": [
            {
              "mistake": "Dôverujem ho.",
              "correct": "Dôverujem mu."
            },
            {
              "mistake": "Rozumiem si s Jana.",
              "correct": "Rozumiem si s Janou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Контакт",
          "text": "«Byť v kontakte» — бути на зв’язку. «Ozvať sa» — дати про себе знати: «Ozvi sa, keď prídeš.» «Stratiť kontakt» — втратити зв’язок. «Stretávať sa» — регулярно бачитися. Якщо дружба згасла: «Vzdialili sme sa» — ми віддалилися одне від одного.",
          "examples": [
            {
              "sk": "Po presťahovaní sme stratili kontakt.",
              "uk": "Після переїзду ми втратили зв’язок."
            },
            {
              "sk": "Ozvi sa mi, keď budeš mať čas.",
              "uk": "Дай про себе знати, коли матимеш час."
            }
          ],
          "shortRule": "byť v kontakte · ozvať sa · stratiť kontakt",
          "button": "Далі →"
        }
      ],
