      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Родинні свята",
          "text": "«Svadba» — весілля, «krstiny» — хрестини (тільки множина: na krstinách!), «promócia» — урочисте вручення дипломів в університеті, «rodinná oslava». Куди? — «ísť na + знахідний»: «na svadbu», «na krstiny». Де? — «byť na + місцевий»: «na svadbe», «na krstinách». «Krstná mama / krstný otec» — хрещена / хрещений.",
          "examples": [
            {
              "sk": "V sobotu ideme na krstiny k sestre.",
              "uk": "У суботу ми йдемо на хрестини до сестри."
            },
            {
              "sk": "Na promócii bola celá rodina.",
              "uk": "На врученні дипломів була вся родина."
            }
          ],
          "shortRule": "ísť na + знахідний · byť na + місцевий",
          "commonMistakes": [
            {
              "mistake": "Ideme na krstinách.",
              "correct": "Ideme na krstiny."
            },
            {
              "mistake": "Bola som na svadbu.",
              "correct": "Bola som na svadbe."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Весілля",
          "text": "«Nevesta» — наречена, «ženích» — наречений, «sobáš» — шлюбна церемонія: у костелі або на «matrike» (у РАЦСі). «Svedok / svedkyňa» — свідок. Після церемонії — «hostina» (весільний банкет). Традиції: молодята їдять суп з однієї тарілки, а опівночі буває «čepčenie» — наречена знімає фату й отримує чепець. Подарунок — часто гроші в конверті.",
          "examples": [
            {
              "sk": "Sobáš bude v kostole o druhej, potom hostina v reštaurácii.",
              "uk": "Вінчання буде в костелі о другій, потім банкет у ресторані."
            },
            {
              "sk": "Ako svadobný dar dávame obálku.",
              "uk": "Як весільний подарунок ми даємо конверт."
            }
          ],
          "shortRule": "nevesta · ženích · sobáš · hostina",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Нова родина й запрошення",
          "text": "«Svokra / svokor» — мати й батько чоловіка або дружини (свекруха, теща / свекор, тесть). «Zať» — зять, а «nevesta» — це і наречена, і невістка! «Švagor / švagriná» — шурин, дівер / зовиця, своячка. Запрошення: «Pozývame vás na…», «Prosíme o potvrdenie účasti do…» — просимо підтвердити участь до…",
          "examples": [
            {
              "sk": "Svokra nás pozvala na nedeľný obed.",
              "uk": "Свекруха запросила нас на недільний обід."
            },
            {
              "sk": "Prosíme o potvrdenie účasti do 15. mája.",
              "uk": "Просимо підтвердити участь до 15 травня."
            }
          ],
          "shortRule": "svokra · svokor · zať · švagor",
          "button": "Далі →"
