      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сварка",
          "text": "«Hádať sa s + орудний kvôli + давальний» — сваритися з кимось через щось. «Pohádať sa» — посваритися (доконаний вид). «Hádka» — сварка. «Vyčítať niekomu niečo» — дорікати комусь чимось, «výčitka» — докір. «Urazený / urazená» — ображений.",
          "examples": [
            {
              "sk": "Pohádali sme sa kvôli peniazom.",
              "uk": "Ми посварилися через гроші."
            },
            {
              "sk": "Prečo mi stále vyčítaš, že meškám?",
              "uk": "Чому ти мені постійно дорікаєш, що я запізнююся?"
            }
          ],
          "shortRule": "hádať sa s + орудний kvôli + давальний",
          "commonMistakes": [
            {
              "mistake": "kvôli peniaze",
              "correct": "kvôli peniazom"
            },
            {
              "mistake": "Pohádal som sa so sestra.",
              "correct": "Pohádal som sa so sestrou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Я-висловлювання",
          "text": "Замість звинувачення «Ty nikdy nepočúvaš!» говори про себе: «Cítim sa…, keď…», «Mrzí ma, keď…», «Potreboval(a) by som, aby…». Уникай узагальнень «vždy» і «nikdy». Тоді співрозмовник не захищається, а слухає.",
          "examples": [
            {
              "sk": "Cítim sa ignorovaná, keď pri rozhovore pozeráš do mobilu.",
              "uk": "Я почуваюся проігнорованою, коли під час розмови ти дивишся в мобільний."
            },
            {
              "sk": "Potreboval by som, aby si mi dal vedieť vopred.",
              "uk": "Мені потрібно, щоб ти попереджав мене заздалегідь."
            }
          ],
          "shortRule": "Cítim sa…, keď… · Potreboval(a) by som, aby…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як вийти з конфлікту",
          "text": "«Vyjasniť si to» — з’ясувати, прояснити. «V tomto máš pravdu, ale…» — тут ти маєш рацію, але… «Nájsť kompromis», «dohodnúť sa». «Zmieriť sa» — помиритися. Пропозиція: «Poďme si to v pokoji vyjasniť.»",
          "examples": [
            {
              "sk": "Poďme si to v pokoji vyjasniť.",
              "uk": "Давай спокійно це з’ясуємо."
            },
            {
              "sk": "Nakoniec sme sa zmierili.",
              "uk": "Зрештою ми помирилися."
            }
          ],
          "shortRule": "vyjasniť si · nájsť kompromis · zmieriť sa",
          "button": "Далі →"
        }
      ],
