      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Закохатися",
          "text": "«Zaľúbiť sa do + родовий» — закохатися в когось: «Zaľúbil sa do kolegyne.» Стан: «byť zaľúbený / zaľúbená». Синонім: «zamilovať sa do…». «Ľúbim ťa» — кохаю тебе. «Mám ťa rád / rada» — ти мені дорогий, люблю тебе (м’якше, і для друзів чи родини).",
          "examples": [
            {
              "sk": "Zaľúbila sa do neho na prvý pohľad.",
              "uk": "Вона закохалася в нього з першого погляду."
            },
            {
              "sk": "Sú do seba zaľúbení.",
              "uk": "Вони закохані одне в одного."
            }
          ],
          "shortRule": "zaľúbiť sa do + родовий",
          "commonMistakes": [
            {
              "mistake": "Zaľúbil sa v kolegyňu.",
              "correct": "Zaľúbil sa do kolegyne."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Зустрічатися",
          "text": "«Chodiť s + орудний» — зустрічатися з кимось, бути парою: «Chodím s Martinom už rok.» Не плутай зі «stretnúť sa s» — зустрітися один раз. «Rande» — побачення (не змінюється: na rande). «Partner / partnerka», «priateľ / priateľka» — хлопець / дівчина. «Bývať spolu» — жити разом.",
          "examples": [
            {
              "sk": "Chodia spolu od leta.",
              "uk": "Вони зустрічаються з літа."
            },
            {
              "sk": "V sobotu idem na rande.",
              "uk": "У суботу я йду на побачення."
            }
          ],
          "shortRule": "chodiť s + орудний — бути парою",
          "commonMistakes": [
            {
              "mistake": "Chodím Martinom.",
              "correct": "Chodím s Martinom."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Етапи й розставання",
          "text": "«Zasnúbiť sa» — заручитися. «Vziať sa» — побратися: «Vzali sa minulý rok.» Хто вже в шлюбі: «ženatý» (одружений), «vydatá» (заміжня). Пара, що не в шлюбі, «sa rozíde» — розходиться, «rozchod» — розставання. Подружжя «sa rozvedie» — розлучається, «rozvod» — розлучення.",
          "examples": [
            {
              "sk": "Zasnúbili sa na Silvestra.",
              "uk": "Вони заручилися в новорічну ніч."
            },
            {
              "sk": "Po desiatich rokoch sa rozviedli.",
              "uk": "Після десяти років вони розлучилися."
            }
          ],
          "shortRule": "rozísť sa — rozchod · rozviesť sa — rozvod",
          "button": "Далі →"
        }
      ],
