      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як почуваєшся",
          "text": "«Ako sa cítiš?» — Як ти почуваєшся? Відповідь: «Cítim sa» + прикметник у НАЗИВНОМУ відмінку: «Cítim sa unavený», жінка — «unavená». В українській кажемо «почуваюся втомленим» (орудний), а в словацькій орудного тут немає. Корисні прикметники: «nahnevaný» (сердитий), «sklamaný» (розчарований), «osamelý» (самотній), «prekvapený» (здивований), «nervózny», «pokojný» (спокійний).",
          "examples": [
            {
              "sk": "Dnes sa cítim trochu osamelá.",
              "uk": "Сьогодні я (ж.) почуваюся трохи самотньою."
            },
            {
              "sk": "Po rozhovore so šéfom sa cítim pokojnejší.",
              "uk": "Після розмови з шефом я почуваюся спокійніше."
            }
          ],
          "shortRule": "cítiť sa + прикметник у називному",
          "commonMistakes": [
            {
              "mistake": "Cítim sa unaveným.",
              "correct": "Cítim sa unavený."
            },
            {
              "mistake": "(говорить жінка) Cítim sa osamelý.",
              "correct": "Cítim sa osamelá."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Безособові конструкції",
          "text": "Багато почуттів словацька передає безособово. З давальним відмінком: «Je mi smutno» (мені сумно), «Je mi ľúto» (мені шкода), «Je mi to jedno» (мені байдуже). Із «ma» (знахідний): «Teší ma, že…» (я радий, що…), «Hnevá ma, že…» (мене злить, що…), «Mrzí ma, že…» (мені прикро, що…), розмовне «Štve ma, že…» (мене бісить, що…).",
          "examples": [
            {
              "sk": "Teší ma, že si prišla.",
              "uk": "Я радий, що ти прийшла."
            },
            {
              "sk": "Hnevá ma, že mi nikto nepovedal pravdu.",
              "uk": "Мене злить, що мені ніхто не сказав правди."
            }
          ],
          "shortRule": "je mi smutno / ľúto · teší / hnevá / mrzí ma, že…",
          "commonMistakes": [
            {
              "mistake": "Som smutno.",
              "correct": "Je mi smutno."
            },
            {
              "mistake": "Mrzí mi to.",
              "correct": "Mrzí ma to."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Сила й причина почуття",
          "text": "Сила: «trochu» (трохи), «dosť» (досить), «veľmi», розмовне «strašne» (страшенно): «Som strašne nervózna.» Причина: «mať radosť z + родовий» (радіти чомусь), «báť sa + родовий» (боятися чогось), «hanbiť sa za + знахідний» (соромитися чогось), «byť nahnevaný na + знахідний» (сердитися на когось).",
          "examples": [
            {
              "sk": "Mám veľkú radosť z tvojho úspechu.",
              "uk": "Я дуже радію твоєму успіху."
            },
            {
              "sk": "Nebuď na mňa nahnevaný.",
              "uk": "Не сердься на мене."
            }
          ],
          "shortRule": "radosť z + родовий · nahnevaný na + знахідний · hanbiť sa za",
          "commonMistakes": [
            {
              "mistake": "nahnevaný na mne",
              "correct": "nahnevaný na mňa"
            },
            {
              "mistake": "radosť z tvoj úspech",
              "correct": "radosť z tvojho úspechu"
            }
          ],
          "button": "Далі →"
        }
