      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Почуття й стосунки",
          "text": "Почуття: «Cítim sa osamelá», «Je mi smutno», «Teší ma, že…», «Hnevá ma, že…». Дружба: «Rozumieme si», «Môžem sa na ňu spoľahnúť», «Dôverujem mu». Кохання: «zaľúbiť sa do + родовий», «chodiť s + орудний», «zasnúbiť sa», «vziať sa», «rozísť sa», «rozviesť sa». «Vzájomná dôvera» — взаємна довіра.",
          "examples": [
            {
              "sk": "Teší ma, že sme sa zmierili.",
              "uk": "Я радий, що ми помирилися."
            },
            {
              "sk": "Chodia spolu a minulý mesiac sa zasnúbili.",
              "uk": "Вони зустрічаються, а минулого місяця заручилися."
            }
          ],
          "shortRule": "cítiť sa + називний · zaľúbiť sa do · chodiť s",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Конфлікт, вибачення, підтримка",
          "text": "Конфлікт: «Pohádali sme sa kvôli…», я-висловлювання «Cítim sa…, keď…», «Poďme si to vyjasniť», «zmieriť sa». Вибачення: «Ospravedlňujem sa za…», «Bola to moja chyba», «Odpustíš mi?», «Ako to môžem napraviť?». Підтримка: «Som tu pre teba», «To zvládneš!», «Držím ti palce!». Важливу роль відіграє «empatia» — уміння співпереживати.",
          "examples": [
            {
              "sk": "Ospravedlňujem sa za to, čo som povedal.",
              "uk": "Перепрошую за те, що я сказав."
            },
            {
              "sk": "Ak sa chceš porozprávať, som tu pre teba.",
              "uk": "Якщо хочеш поговорити, я поруч."
            }
          ],
          "shortRule": "ospravedlniť sa za · odpustiť + давальний · držať palce",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Події й межі",
          "text": "Привітання: «Blahoželám ti k narodeninám», «Všetko najlepšie!». Співчуття: «Úprimnú sústrasť», «Myslím na vás». Події: «ísť na svadbu / krstiny», «nevesta, ženích, sobáš, hostina». Межі: «Ďakujem, ale tentoraz nie», «To by som si radšej nechal(a) pre seba», «Prosím, rešpektuj moje rozhodnutie». Про делікатну тему кажуть «citlivá téma».",
          "examples": [
            {
              "sk": "Rodina je pre ňu citlivá téma.",
              "uk": "Родина для неї — делікатна тема."
            },
            {
              "sk": "Prosím, rešpektuj moje rozhodnutie.",
              "uk": "Будь ласка, поважай моє рішення."
            }
          ],
          "shortRule": "blahoželať k · úprimnú sústrasť · nechať si pre seba",
          "button": "Далі →"
        }
      ],
