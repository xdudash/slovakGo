      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як перепросити",
          "text": "«Prepáč / Prepáčte» — для дрібниць. Серйозніше: «Ospravedlňujem sa za + знахідний»: «za meškanie», «za to, čo som povedal». «Je mi to ľúto», «Mrzí ma to» — мені шкода. Визнати провину: «Bola to moja chyba.» «Nemal som to povedať.» — Мені не слід було цього казати.",
          "examples": [
            {
              "sk": "Ospravedlňujem sa za včerajšie správanie.",
              "uk": "Перепрошую за свою вчорашню поведінку."
            },
            {
              "sk": "Nemala som na teba kričať.",
              "uk": "Мені не слід було на тебе кричати."
            }
          ],
          "shortRule": "ospravedlniť sa za + знахідний · nemal(a) som + інфінітив",
          "commonMistakes": [
            {
              "mistake": "Ospravedlňujem sa pre meškanie.",
              "correct": "Ospravedlňujem sa za meškanie."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Прийняти вибачення",
          "text": "«Odpustiť + давальний» — пробачити: «Odpustíš mi?» Відповіді: «To je v poriadku», «Nič sa nestalo», «Ospravedlnenie prijímam». Якщо ще боляче: «Potrebujem trochu času.» «Zabudnime na to» — забудьмо. Відмовка — «výhovorka»: «To nie je moja vina, ty si začal» — це не вибачення.",
          "examples": [
            {
              "sk": "Odpustíš mi to?",
              "uk": "Ти мені це пробачиш?"
            },
            {
              "sk": "Ospravedlnenie prijímam, ale potrebujem čas.",
              "uk": "Вибачення приймаю, але мені потрібен час."
            }
          ],
          "shortRule": "odpustiť + давальний",
          "commonMistakes": [
            {
              "mistake": "Odpusť ma.",
              "correct": "Odpusť mi."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як виправити",
          "text": "«Napraviť» — виправити: «Ako to môžem napraviť?» «Vynahradiť» — компенсувати, надолужити: «Vynahradím ti to.» Формальне вибачення в листі: «Dovoľte mi ospravedlniť sa za…», «Ospravedlňujeme sa za vzniknuté nepríjemnosti.» — Перепрошуємо за спричинені незручності.",
          "examples": [
            {
              "sk": "Ako to môžem napraviť?",
              "uk": "Як я можу це виправити?"
            },
            {
              "sk": "Ospravedlňujeme sa za vzniknuté nepríjemnosti.",
              "uk": "Перепрошуємо за спричинені незручності."
            }
          ],
          "shortRule": "napraviť · vynahradiť · Dovoľte mi ospravedlniť sa",
          "button": "Далі →"
        }
      ],
