      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Вислухати",
          "text": "«Čo sa deje?» — Що відбувається? «Chceš sa o tom porozprávať?» «Som tu pre teba.» — Я поруч. «Vypočuť niekoho» — вислухати когось. Не поспішай із порадами: інколи досить сказати «To muselo byť ťažké.» — Це, мабуть, було важко.",
          "examples": [
            {
              "sk": "Ak sa chceš porozprávať, som tu pre teba.",
              "uk": "Якщо хочеш поговорити, я поруч."
            },
            {
              "sk": "Ďakujem, že si ma vypočula.",
              "uk": "Дякую, що ти мене вислухала."
            }
          ],
          "shortRule": "Som tu pre teba · vypočuť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Утішити й підбадьорити",
          "text": "«Utešiť» — утішити, «povzbudiť» — підбадьорити. Фрази: «To zvládneš!», «Neboj sa, bude to dobré.», «Nevzdávaj sa!» — Не здавайся! Перед іспитом чи співбесідою: «Držím ti palce!» — дослівно «тримаю тобі великі пальці», тобто «тримаю за тебе кулаки». Не знецінюй: «To nič nie je», «Iní sú na tom horšie» — так людина почувається ще гірше.",
          "examples": [
            {
              "sk": "Zajtra máš skúšku? Držím ti palce!",
              "uk": "Завтра в тебе іспит? Тримаю за тебе кулаки!"
            },
            {
              "sk": "Nevzdávaj sa, si na dobrej ceste.",
              "uk": "Не здавайся, ти на правильному шляху."
            }
          ],
          "shortRule": "držať niekomu palce · nevzdávaj sa",
          "commonMistakes": [
            {
              "mistake": "Držím ťa palce.",
              "correct": "Držím ti palce."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Конкретна допомога",
          "text": "«Môžem ti nejako pomôcť?» — краще запропонувати щось конкретне: «Môžem ti v sobotu pomôcť so sťahovaním.», «Ak chceš, postrážim ti deti.» «Pokojne sa ozvi» — сміливо звертайся. «Podpora» — підтримка, «podporiť» — підтримати.",
          "examples": [
            {
              "sk": "Ďakujem za tvoju podporu.",
              "uk": "Дякую за твою підтримку."
            },
            {
              "sk": "Ak by si niečo potreboval, pokojne sa ozvi.",
              "uk": "Якщо тобі щось знадобиться, сміливо звертайся."
            }
          ],
          "shortRule": "podporiť + знахідний · podpora",
          "button": "Далі →"
        }
      ],
