      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Опис проблеми",
          "text": "Підтримка зазвичай починає словами «Popíšte problém» або «Čo sa stalo?». Коротко й по суті розкажи, що сталося: «Notebook zamrzol.» Повідомлення про помилку — «chybové hlásenie»: «Na obrazovke sa objavilo chybové hlásenie.» Слово «hlásenie» середнього роду, тому дієслово теж: «objavilo sa». Якщо проблема повертається, кажемо «opakovať sa»: «Problém sa opakuje.»",
          "examples": [
            {
              "sk": "Na obrazovke sa objavilo chybové hlásenie.",
              "uk": "На екрані з’явилося повідомлення про помилку."
            },
            {
              "sk": "Problém sa opakuje každý deň.",
              "uk": "Проблема повторюється щодня."
            }
          ],
          "shortRule": "hlásenie (ср. р.) → objavilo sa · problém sa opakuje",
          "commonMistakes": [
            {
              "mistake": "Objavil sa chybové hlásenie.",
              "correct": "Objavilo sa chybové hlásenie."
            },
            {
              "mistake": "Problém sa opakujú.",
              "correct": "Problém sa opakuje."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Тікет і ввічливе прохання",
          "text": "Коли ти звертаєшся до підтримки, часто створюють «tiket» — заявку з номером: «Uveďte číslo tiketu.» Просимо про допомогу ввічливо за допомогою умовного способу: «Mohli by ste mi pomôcť?» — Чи не могли б ви мені допомогти? Після «mohli by ste» стоїть інфінітив, а проблему називаємо з «s» + орудний: «pomôcť s problémom», «s prihlásením».",
          "examples": [
            {
              "sk": "Mohli by ste mi pomôcť s problémom?",
              "uk": "Чи не могли б ви мені допомогти з проблемою?"
            },
            {
              "sk": "Na vašu žiadosť sme založili tiket číslo 4821.",
              "uk": "За вашим зверненням ми створили тікет номер 4821."
            }
          ],
          "shortRule": "mohli by ste + інфінітив · pomôcť s + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Кроки від підтримки",
          "text": "Інструкції від підтримки йдуть по порядку: «najprv» — спершу, «potom» — потім, «nakoniec» — наприкінці. Звертання на «Ви» — наказовий спосіб на «-te»: «Najprv reštartujte zariadenie. Potom skúste znova.» Якщо проблема не зникла: «Ak problém pretrváva, napíšte nám.» Після «skúste» стоїть інфінітив: «skúste to zopakovať».",
          "examples": [
            {
              "sk": "Najprv reštartujte notebook a potom skúste znova.",
              "uk": "Спершу перезапустіть ноутбук, а потім спробуйте знову."
            },
            {
              "sk": "Ak problém pretrváva, odpíšte na tento e-mail.",
              "uk": "Якщо проблема не зникає, дайте відповідь на цей лист."
            }
          ],
          "shortRule": "najprv · potom · nakoniec · reštartujte / skúste",
          "button": "Далі →"
        }
