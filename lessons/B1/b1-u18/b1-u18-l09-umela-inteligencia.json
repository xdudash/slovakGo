      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що вміє ШІ",
          "text": "«Umelá inteligencia» (ШІ) — це програми, які можуть допомагати з текстами, перекладами чи пошуком. Спілкуємося з ними через «chatbot». Допомога — «pomáhať s» + орудний: «Pomáha mi s prekladom.» Що вміє: «dokáže» + інфінітив: «Dokáže zhrnúť dlhý text.» Також ШІ може «generovať» тексти чи зображення: «Chatbot vygeneroval návrh e-mailu.» Результат — лише чернетка, яку треба перевірити.",
          "examples": [
            {
              "sk": "Chatbot mi pomáha s prekladom a so zhrnutím.",
              "uk": "Чат-бот допомагає мені з перекладом і стислим викладом тексту."
            },
            {
              "sk": "Dokáže vygenerovať návrh e-mailu.",
              "uk": "Він може згенерувати чернетку листа."
            }
          ],
          "shortRule": "pomáhať s + орудний · dokáže + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Обережність",
          "text": "Відповідь ШІ може бути неточною («nepresná») або містити вигадані «fakty», тому важливі дані треба перевірити в надійних джерелах: «Fakty treba overiť.» Не вставляй у чат-бот чутливі дані, паролі чи робочі документи, якщо це не дозволяють правила: «Do chatbota nikdy nevkladaj osobné údaje.» Пам’ятай про подвійне заперечення: nikdy + ne-. Правила компанії можуть відрізнятися — їх треба читати.",
          "examples": [
            {
              "sk": "Odpoveď môže byť nepresná, preto fakty treba overiť.",
              "uk": "Відповідь може бути неточною, тому факти треба перевірити."
            },
            {
              "sk": "Do chatbota nikdy nevkladaj heslá.",
              "uk": "У чат-бот ніколи не вставляй паролі."
            }
          ],
          "shortRule": "nepresný — fakty treba overiť · nikdy + ne-",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Висловити думку",
          "text": "Для обережної, збалансованої думки на B1 є готові звороти: «Podľa môjho názoru…» — на мою думку; «Myslím si, že…» — я думаю, що; «Na jednej strane…, na druhej strane…» — з одного боку…, з іншого боку…. Перед «že» ставимо кому: «Myslím si, že je užitočný.»",
          "examples": [
            {
              "sk": "Na jednej strane šetrí čas, na druhej strane môže robiť chyby.",
              "uk": "З одного боку, він економить час, а з іншого — може помилятися."
            },
            {
              "sk": "Myslím si, že je to užitočný nástroj.",
              "uk": "Я думаю, що це корисний інструмент."
            }
          ],
          "shortRule": "podľa môjho názoru · na jednej strane… na druhej strane…",
          "button": "Далі →"
        }
      ],
