      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pozor na podvod",
          "text": "«Pozor na» + знахідний: «Pozor na podvodné e-maily!» Підозрілий лист зазвичай поспішає, просить пароль, має чужого відправника або помилки в тексті. Дії з посиланням: «kliknúť na odkaz» — клацнути на посилання (на + знахідний): «Nikdy neklikaj na podozrivý odkaz.» Особисті дані — «údaje»: «Banka nikdy nežiada prihlasovacie údaje e-mailom.»",
          "examples": [
            {
              "sk": "Pozor na podvodné SMS správy.",
              "uk": "Остерігайся шахрайських SMS."
            },
            {
              "sk": "Nesmieš kliknúť na odkaz od neznámeho odosielateľa.",
              "uk": "Не можна клацати на посилання від невідомого відправника."
            }
          ],
          "shortRule": "pozor na + знахідний · kliknúť na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Подвійне заперечення",
          "text": "У словацькій при слові «nikdy», «nikto», «nič» дієслово теж стоїть із «ne-»: «Nikdy nikomu nehovor heslo.» — Ніколи нікому не кажи пароль. «Nikto mi nič nepovedal.» — Ніхто мені нічого не сказав. Слово «nikomu» — давальний від «nikto». Без «ne-» біля дієслова речення неправильне.",
          "examples": [
            {
              "sk": "Nikdy nezadávaj údaje na neznámej stránke.",
              "uk": "Ніколи не вводь дані на невідомому сайті."
            },
            {
              "sk": "Nikto mi nič nepovedal.",
              "uk": "Ніхто мені нічого не сказав."
            }
          ],
          "shortRule": "nikdy / nikto / nič + ne- + дієслово",
          "commonMistakes": [
            {
              "mistake": "Nikdy nikomu hovor heslo.",
              "correct": "Nikdy nikomu nehovor heslo."
            },
            {
              "mistake": "Banka nikdy žiada heslo.",
              "correct": "Banka nikdy nežiada heslo."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Захист акаунта",
          "text": "«Dvojfaktorové overenie» — двофакторна автентифікація: окрім пароля, треба ще код з SMS чи застосунку. Порада: «Zapni si dvojfaktorové overenie.» Малоймовірна ситуація — «ak by»: «Ak by ti prišiel podozrivý e-mail, zmaž ho.» Безпечний пароль — довгий і для кожного сервісу інший: «Bezpečné heslo má aspoň dvanásť znakov.»",
          "examples": [
            {
              "sk": "Zapni si dvojfaktorové overenie v nastaveniach účtu.",
              "uk": "Увімкни двофакторну автентифікацію в налаштуваннях акаунта."
            },
            {
              "sk": "Ak by ti prišiel podozrivý e-mail, zmaž ho.",
              "uk": "Якщо раптом тобі прийде підозрілий лист, видали його."
            }
          ],
          "shortRule": "ak by + l-форма, потім наказовий спосіб",
          "button": "Далі →"
        }
      ],
