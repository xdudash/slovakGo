      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Підключення",
          "text": "«Pripojiť sa» — підключитися, і далі «k» + давальний відмінок: «pripojiť sa k wifi», «k sieti», «k routeru». Пароль — «heslo k wifi». Питання: «Máte tu wifi?», «Aké je heslo k wifi?» Слово «wifi» не відмінюється: «k wifi», «na wifi» — у тексті без змін.",
          "examples": [
            {
              "sk": "Chcem sa pripojiť k wifi v kaviarni.",
              "uk": "Я хочу підключитися до wifi в кав’ярні."
            },
            {
              "sk": "Aké je heslo k wifi?",
              "uk": "Який пароль до wifi?"
            }
          ],
          "shortRule": "pripojiť sa k + давальний · heslo k wifi",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Якість зв’язку",
          "text": "Скарги: «Internet je pomalý» — інтернет повільний; «Pripojenie vypadáva» — зв’язок обривається; «Signál je slabý» — сигнал слабкий. Залежність передаємо конструкцією «čím…, tým…» з порівняльним ступенем: «Čím ďalej od routera, tým slabší signál.» Корисні форми: slabší, silnejší, rýchlejší, lepší, horší.",
          "examples": [
            {
              "sk": "Čím bližšie k routeru, tým rýchlejší internet.",
              "uk": "Чим ближче до роутера, тим швидший інтернет."
            },
            {
              "sk": "Pripojenie nám večer často vypadáva.",
              "uk": "Зв’язок у нас увечері часто обривається."
            }
          ],
          "shortRule": "čím + порівняльний, tým + порівняльний",
          "commonMistakes": [
            {
              "mistake": "Čím ďalej od routera, tým slabý signál.",
              "correct": "Čím ďalej od routera, tým slabší signál."
            },
            {
              "mistake": "Pripojenie mi vypadávam.",
              "correct": "Pripojenie mi vypadáva."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Тариф і ліміт",
          "text": "Тариф — це умови оплати зв’язку: «Mám tarif s 20 GB dát mesačne.» Коли ліміт вичерпано, зазвичай падає швидкість: «Ak prekročím limit, rýchlosť sa zníži.» Питання оператору: «Koľko dát mi ešte zostáva?», «Má tento tarif neobmedzené dáta?» Після «ak» про майбутнє беремо доконаний вид у теперішній формі: prekročím.",
          "examples": [
            {
              "sk": "Ak prekročím limit, rýchlosť sa výrazne zníži.",
              "uk": "Якщо я перевищу ліміт, швидкість суттєво впаде."
            },
            {
              "sk": "Koľko dát mi ešte zostáva?",
              "uk": "Скільки даних мені ще залишилося?"
            }
          ],
          "shortRule": "ak + доконаний вид (prekročím) · sa zníži",
          "button": "Далі →"
        }
      ],
