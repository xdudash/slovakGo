      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Файли й папки",
          "text": "Файл — «súbor», папка — «priečinok». Куди зберігаємо? — «do» + родовий: «Súbor uložím do priečinka Dokumenty.» Де він лежить? — «v» + місцевий: «Súbor je v priečinku Dokumenty.» Документ — «dokument»: «Dokument je dlhý desať strán.» Назву файлу зручно дати з прізвищем і датою.",
          "examples": [
            {
              "sk": "Súbor som uložil do priečinka Dokumenty.",
              "uk": "Я зберіг файл у папці «Документи»."
            },
            {
              "sk": "Zmluva je uložená v priečinku Práca.",
              "uk": "Договір збережений у папці «Робота»."
            }
          ],
          "shortRule": "uložiť do + родовий · v priečinku",
          "commonMistakes": [
            {
              "mistake": "Súbor je v priečinka Dokumenty.",
              "correct": "Súbor je v priečinku Dokumenty."
            },
            {
              "mistake": "Uložil som ho do priečinku.",
              "correct": "Uložil som ho do priečinka."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Формат і вкладення",
          "text": "Формат файлу — «formát». Кажемо «vo formáte PDF» (місцевий відмінок; перед «f» — «vo»). Часто просять надіслати «PDF», бо його легше відкрити будь-де. Надіслати файл у листі — «poslať ako prílohu», тобто «як вкладення» (знахідний). Паперовий документ можна перетворити на файл: «skenovať» — сканувати, або «odfotiť» — сфотографувати.",
          "examples": [
            {
              "sk": "Pošlite dokument vo formáte PDF ako prílohu.",
              "uk": "Надішліть документ у форматі PDF як вкладення."
            },
            {
              "sk": "Doklad som naskenoval a uložil ako PDF.",
              "uk": "Я відсканував документ і зберіг як PDF."
            }
          ],
          "shortRule": "vo formáte + PDF · ako prílohu",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Копія й підпис",
          "text": "Резервна копія — «záloha», дія — «zálohovať»: «Dôležité súbory si zálohujem na externý disk.» Копію зазвичай зберігають у двох різних місцях. Електронний підпис у багатьох випадках може замінити підпис на папері, але чи його приймуть, залежить від виду документа й вимог установи, тому завжди читай умови. Перед надсиланням файл перевір: «Skontroluj, či je text čitateľný.»",
          "examples": [
            {
              "sk": "Dôležité súbory si zálohujem každý týždeň.",
              "uk": "Важливі файли я копіюю щотижня."
            },
            {
              "sk": "Skontroluj, či je text čitateľný.",
              "uk": "Перевір, чи текст читабельний."
            }
          ],
          "shortRule": "zálohovať · elektronický podpis — залежить від вимог",
          "button": "Далі →"
        }
