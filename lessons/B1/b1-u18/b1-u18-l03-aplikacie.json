      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Процес і результат",
          "text": "Дії із застосунками мають пари видів. Недоконаний — процес: «sťahovať», «inštalovať»; доконаний — результат: «stiahnuť», «nainštalovať». Поки йде завантаження: «Súbor sa sťahuje.» Коли готово: «Aplikácia sa stiahla.» З модальними дієсловами й після «chcem» ставимо інфінітив: «Môžeš si ju stiahnuť zadarmo.»",
          "examples": [
            {
              "sk": "Aplikáciu si môžeš stiahnuť zadarmo.",
              "uk": "Застосунок ти можеш завантажити безкоштовно."
            },
            {
              "sk": "Aplikácia sa ešte inštaluje.",
              "uk": "Застосунок ще встановлюється."
            }
          ],
          "shortRule": "sťahovať / inštalovať — процес · stiahnuť / nainštalovať — результат",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дозволи",
          "text": "«Povoliť» — дозволити. Конструкція: кому? — давальний, що? — знахідний: «povoliť aplikácii prístup». Доступ до чого? — «k» + давальний: «prístup ku kamere», «prístup k polohe», «k fotkám». Скасувати дозвіл — «zakázať»; застосунок «žiada o povolenie» — просить дозволу.",
          "examples": [
            {
              "sk": "Musíš aplikácii povoliť prístup ku kamere.",
              "uk": "Ти мусиш дозволити застосунку доступ до камери."
            },
            {
              "sk": "Aplikácia žiada o prístup k polohe.",
              "uk": "Застосунок просить доступ до місцезнаходження."
            }
          ],
          "shortRule": "povoliť + давальний + знахідний · prístup k + давальний",
