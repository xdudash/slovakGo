      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Пристрої: на чи в?",
          "text": "Коли працюємо за пристроєм або дивимося на екран, кажемо «na» + місцевий відмінок: «Pracujem na notebooku», «Vidím to na displeji». Коли щось зберігається всередині, кажемо «v» + місцевий: «Mám to v mobile», «Je to v úložisku». Назви пристроїв: «notebook», «počítač», «tablet», «mobil». Частини: «klávesnica», «displej», «batéria».",
          "examples": [
            {
              "sk": "Na notebooku mám všetky pracovné súbory.",
              "uk": "На ноутбуці в мене всі робочі файли."
            },
            {
              "sk": "V mobile mám plné úložisko.",
              "uk": "У телефоні в мене повна пам’ять."
            }
          ],
          "shortRule": "na + місцевий (працюю) · v + місцевий (зберігається)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що сталося?",
          "text": "Про поломку кажемо в минулому часі: «Notebook zamrzol» — ноутбук завис; «Telefón sa mi vybil» — мій телефон розрядився; «Displej sa rozbil» — дисплей розбився. Особа, якої стосується проблема, стоїть у давальному: «Nefunguje mi klávesnica» — у мене не працює клавіатура (дослівно: мені не працює). Рід дієслова збігається з родом предмета: telefón sa vybil, batéria sa vybila.",
          "examples": [
            {
              "sk": "Telefón sa mi vybil a nemám nabíjačku.",
              "uk": "Мій телефон розрядився, а зарядки в мене немає."
            },
            {
              "sk": "Nefunguje mi klávesnica.",
              "uk": "У мене не працює клавіатура."
            }
          ],
          "shortRule": "nefunguje mi + називний · sa vybil / vybila",
          "commonMistakes": [
            {
              "mistake": "Mám nefunguje klávesnica.",
              "correct": "Nefunguje mi klávesnica."
            },
            {
              "mistake": "Telefón sa vybila.",
              "correct": "Telefón sa vybil."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Treba, stačí, nezabudni",
          "text": "Після «treba» і «stačí» стоїть інфінітив: «Treba ho nabiť» — його треба зарядити; «Stačí ho reštartovať» — досить його перезапустити. «Nezabudni» + інфінітив доконаного виду: «Nezabudni ho vypnúť.» Для дії, що триває, беремо недоконаний вид: «nabíjať» — заряджати (процес), «nabiť» — зарядити (результат).",
          "examples": [
            {
              "sk": "Stačí notebook reštartovať.",
              "uk": "Досить перезапустити ноутбук."
            },
            {
              "sk": "Nezabudni mobil nabiť.",
              "uk": "Не забудь зарядити телефон."
            }
          ],
          "shortRule": "treba / stačí / nezabudni + інфінітив",
          "button": "Далі →"
        }
      ],
