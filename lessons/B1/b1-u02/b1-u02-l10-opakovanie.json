      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Письмові документи",
          "text": "Заява: «Týmto žiadam o + знахідний», «Dôvodom je…», «Vopred ďakujem za kladné vybavenie». Čestné vyhlásenie: «Dolupodpísaný/á…, čestne vyhlasujem, že…», «Som si vedomý/á právnych následkov…». Довіреність: «Splnomocňujem + знахідний na + знахідний», «Splnomocnenie prijímam». Усі документи подаєш як «podanie» — у «podateľni» úradu (на твоїй копії поставлять штамп про прийняття) або електронно.",
          "examples": [
            {
              "sk": "Týmto žiadam o vydanie potvrdenia.",
              "uk": "Цим прошу видати довідку."
            },
            {
              "sk": "Splnomocňujem sestru na prevzatie rozhodnutia.",
              "uk": "Уповноважую сестру отримати рішення."
            }
          ],
          "shortRule": "žiadam o · vyhlasujem, že · splnomocňujem + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Підпис, živnosť, податки",
          "text": "Підпис засвідчують на matrike або в нотаріуса: «Potrebujem si dať osvedčiť podpis.» Засвідчують лише підпис, не зміст. Živnosť: «ohlásiť voľnú živnosť», «predmet podnikania», «IČO». Податки: «daňové priznanie za zdaňovacie obdobie», «preddavok», «preplatok / nedoplatok». Офіційні листи часто приходять в «elektronickú schránku», а оголошення висять на «úradnej doske».",
          "examples": [
            {
              "sk": "Potrebujem si dať osvedčiť podpis na splnomocnení.",
              "uk": "Мені треба засвідчити підпис на довіреності."
            },
            {
              "sk": "Na preddavkoch som zaplatil viac, mám preplatok.",
              "uk": "Авансами я заплатив більше, маю переплату."
            }
          ],
          "shortRule": "dať si osvedčiť · ohlásiť živnosť · podať priznanie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Строки, оскарження, розмова",
          "text": "Строк плине з наступного дня після вручення; якщо останній день — вихідний чи свято, переходить на найближчий робочий день. Не встигаєш — «Žiadam o predĺženie lehoty» ще до її закінчення. Не згодна з рішенням — читай «Poučenie» й подавай «odvolanie proti rozhodnutiu». Зі службовцем: «Volám vo veci…», «spisová značka», «Mohli by ste mi to dať písomne?».",
          "examples": [
            {
              "sk": "Odvolávam sa proti rozhodnutiu, pretože úrad nezohľadnil moje doklady.",
              "uk": "Я оскаржую рішення, бо úrad не врахував моїх документів."
            },
            {
              "sk": "V akom štádiu je moje konanie?",
              "uk": "На якій стадії моє провадження?"
            }
          ],
          "shortRule": "lehota → predĺženie → odvolanie",
          "button": "Далі →"
        }
      ],
