      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що це за документ",
          "text": "«Čestné vyhlásenie» — письмова заява, у якій ти під особисту відповідальність підтверджуєш певний факт: що не маєш боргів перед громадою, що живеш за вказаною адресою, що дані правдиві. Úrad приймає її, коли закон це дозволяє — часто замість довідки, яку важко отримати. Підписуючи, ти береш на себе відповідальність: неправдиве čestné vyhlásenie може мати правові наслідки.",
          "examples": [
            {
              "sk": "Úrad akceptuje čestné vyhlásenie namiesto potvrdenia.",
              "uk": "Установа приймає заяву під особисту відповідальність замість довідки."
            },
            {
              "sk": "Za pravdivosť údajov zodpovedá ten, kto vyhlásenie podpísal.",
              "uk": "За правдивість даних відповідає той, хто підписав заяву."
            }
          ],
          "shortRule": "čestné vyhlásenie = твоє письмове слово, за яке ти відповідаєш",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Формула вступу",
          "text": "Типовий початок: «Dolupodpísaný (чоловік) / Dolupodpísaná (жінка) Meno Priezvisko, narodený/narodená…, bytom…, čestne vyhlasujem, že…». «Dolupodpísaný» — буквально «нижчепідписаний». «Bytom» — офіційне «що проживає за адресою». Після «vyhlasujem, že» стоїть звичайне речення в теперішньому чи минулому часі.",
          "examples": [
            {
              "sk": "Dolupodpísaná Olena Ivanenko čestne vyhlasujem, že nemám nedoplatky voči obci.",
              "uk": "Я, нижчепідписана Олена Іваненко, під особисту відповідальність заявляю, що не маю заборгованостей перед громадою."
            },
            {
              "sk": "Čestne vyhlasujem, že všetky uvedené údaje sú pravdivé.",
              "uk": "Під особисту відповідальність заявляю, що всі вказані дані правдиві."
            }
          ],
          "shortRule": "Dolupodpísaný / Dolupodpísaná…, čestne vyhlasujem, že…",
          "commonMistakes": [
            {
              "mistake": "Dolupodpísaný Olena…",
              "correct": "Dolupodpísaná Olena…"
            },
            {
              "mistake": "čestne vyhlasujem, čo…",
              "correct": "čestne vyhlasujem, že…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Правдиві й повні дані",
          "text": "Наприкінці часто стоїть: «Som si vedomý / vedomá právnych následkov nepravdivého vyhlásenia.» — Я усвідомлюю правові наслідки неправдивої заяви. Конструкція «byť si vedomý + родовий»: som si vedomá následkov. Ще одна формула: «Uvedené údaje sú pravdivé a úplné» — дані правдиві й повні. Далі — місце, дата й підпис. Іноді úrad вимагає, щоб підпис на такій заяві був засвідчений.",
          "examples": [
            {
              "sk": "Som si vedomý právnych následkov nepravdivého vyhlásenia.",
              "uk": "Я усвідомлюю правові наслідки неправдивої заяви."
            },
            {
              "sk": "Uvedené údaje sú pravdivé a úplné.",
              "uk": "Вказані дані правдиві й повні."
