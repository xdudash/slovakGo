      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Poučenie — інструкція в кінці рішення",
          "text": "Наприкінці рішення úradu є розділ «Poučenie» — роз’яснення, чи можна рішення оскаржити, у який строк і де подати odvolanie. Якщо ти не згодна з рішенням, читай його першим. За загальним правилом odvolanie подають до того «správneho orgánu», який рішення видав; якщо він сам рішення не змінить, передає справу вищому органу.",
          "examples": [
            {
              "sk": "Proti tomuto rozhodnutiu sa možno odvolať.",
              "uk": "Це рішення можна оскаржити."
            },
            {
              "sk": "Odvolanie sa podáva na správnom orgáne, ktorý rozhodnutie vydal.",
              "uk": "Скаргу подають до органу, який видав рішення."
            }
          ],
          "shortRule": "Poučenie: či, dokedy a kde sa odvolať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Odvolať sa proti…",
          "text": "«Odvolať sa proti rozhodnutiu» — оскаржити рішення (proti + давальний). Іменник — «odvolanie». В офіційних текстах також: «napadnúť rozhodnutie» — оскаржити, «napadnuté rozhodnutie» — оскаржене рішення. Обережно: «odvolať» без «sa» означає «відкликати»: «odvolať splnomocnenie», «odvolať žiadosť».",
          "examples": [
            {
              "sk": "Proti rozhodnutiu o zamietnutí žiadosti sa odvolávam.",
              "uk": "Я оскаржую рішення про відхилення заяви."
            },
            {
              "sk": "Splnomocnenie môžete kedykoľvek odvolať.",
              "uk": "Довіреність ви можете будь-коли відкликати."
            }
          ],
          "shortRule": "odvolať sa proti + давальний ≠ odvolať (відкликати)",
          "commonMistakes": [
            {
              "mistake": "odvolať sa proti rozhodnutie",
              "correct": "odvolať sa proti rozhodnutiu"
            },
            {
              "mistake": "Odvolávam rozhodnutie.",
              "correct": "Odvolávam sa proti rozhodnutiu."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що написати",
          "text": "Odvolanie має містити: хто його подає (ім’я, адреса), проти якого рішення (номер і дата), чому ти не згодна — «dôvody», чого просиш — «návrh» (змінити чи скасувати рішення), і підпис. Тон — спокійний і фактичний: «Nesúhlasím s rozhodnutím, pretože…», «Navrhujem, aby odvolací orgán rozhodnutie zmenil.» Нові докази долучи як додатки. Вищий орган рішення «preskúma» — перегляне.",
          "examples": [
            {
              "sk": "Nesúhlasím s rozhodnutím, pretože úrad nezohľadnil priložené potvrdenie.",
              "uk": "Я не згодна з рішенням, бо úrad не врахував доданої довідки."
            },
            {
              "sk": "Navrhujem, aby odvolací orgán napadnuté rozhodnutie zrušil.",
              "uk": "Прошу, щоб апеляційний орган скасував оскаржене рішення."
            }
          ],
          "shortRule": "kto → proti čomu → dôvody → návrh → podpis",
          "button": "Далі →"
        }
      ],
