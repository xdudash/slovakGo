      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що засвідчують",
          "text": "У розмові кажуть «overiť podpis» або «overenie podpisu», в офіційній мові — «osvedčenie podpisu». Засвідчують лише те, що документ підписала саме ти, — не зміст документа і не його правдивість. Тому зміст перевіряєш ти сама. Схожа послуга — «overená kópia» (засвідчена копія): підтверджують, що копія відповідає оригіналу.",
          "examples": [
            {
              "sk": "Osvedčenie podpisu nepotvrdzuje správnosť obsahu listiny.",
              "uk": "Засвідчення підпису не підтверджує правильності змісту документа."
            },
            {
              "sk": "Potrebujem si dať overiť podpis na splnomocnení.",
              "uk": "Мені треба засвідчити підпис на довіреності."
            }
          ],
          "shortRule": "overiť podpis (розм.) = osvedčiť podpis (офіц.)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Де і як",
          "text": "Підпис можна засвідчити на «matrike» — зазвичай на «obecnom» чи «mestskom úrade» — або в нотаріуса («u notára»). Візьми чинний документ, що посвідчує особу, і сам документ. Підписуєш перед службовцем (або підтверджуєш, що підпис твій). За послугу платять poplatok. Конструкція «dať si + інфінітив» означає «доручити комусь зробити»: «dať si osvedčiť podpis», «dať si preložiť dokument».",
          "examples": [
            {
              "sk": "Podpis vám osvedčíme, ak sa preukážete platným dokladom totožnosti.",
              "uk": "Ми засвідчимо ваш підпис, якщо ви пред’явите чинний документ, що посвідчує особу."
            },
            {
              "sk": "Listinu podpíšte až pred úradníčkou.",
              "uk": "Документ підпишіть лише перед службовицею."
            }
          ],
          "shortRule": "dať si + інфінітив: dať si osvedčiť, dať si preložiť",
          "commonMistakes": [
            {
              "mistake": "Chcem overiť môj podpis u notár.",
              "correct": "Chcem si dať overiť podpis u notára."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Документи для іншої країни",
          "text": "Якщо документ потрібен в іншій країні, може знадобитися «apostila» — спеціальне засвідчення, що підтверджує справжність («pravosť») підпису й печатки на офіційному документі. Чи потрібні апостиль і переклад, залежить від країни та установи — завжди уточнюй заздалегідь. «Listina» — офіційне слово для паперового документа.",
          "examples": [
            {
              "sk": "Na tejto listine je potrebná apostila.",
              "uk": "На цьому документі потрібен апостиль."
            },
            {
              "sk": "Apostila potvrdzuje pravosť podpisu a pečiatky.",
              "uk": "Апостиль підтверджує справжність підпису й печатки."
            }
          ],
          "shortRule": "apostila → pravosť podpisu a pečiatky",
          "button": "Далі →"
        }
      ],
