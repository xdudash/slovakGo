      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто збирає податки",
          "text": "Податками у Словаччині займається «Finančná správa», її місцеві установи — «daňové úrady». Людина чи фірма, що сплачує податок, — «daňovník». Живностенник реєструється для податку й отримує «DIČ» (daňové identifikačné číslo). Із фінансовою управою спілкуються особисто, поштою або електронно; підприємці часто зобов’язані робити це електронно.",
          "examples": [
            {
              "sk": "Na daňovom úrade som sa zaregistroval hneď po ohlásení živnosti.",
              "uk": "На податковому úrade я зареєструвався одразу після реєстрації živnosti."
            },
            {
              "sk": "Každý daňovník má svoje DIČ.",
              "uk": "Кожен платник податків має свій DIČ."
            }
          ],
          "shortRule": "finančná správa → daňový úrad → daňovník",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Податкова декларація",
          "text": "«Daňové priznanie» — податкова декларація. Її подають раз на рік за «zdaňovacie obdobie» — для людей це зазвичай календарний рік. Строк подання встановлює закон — перевір його на сайті фінансової управи. Працівникові за трудовим договором часто достатньо «ročného zúčtovania», яке робить роботодавець, а живностенник подає декларацію сам. Дієслова: «podať daňové priznanie», «vyplniť», «odoslať elektronicky».",
          "examples": [
            {
              "sk": "Daňové priznanie musím podať za celé zdaňovacie obdobie.",
              "uk": "Декларацію я мушу подати за весь податковий період."
            },
            {
              "sk": "Za minulý rok som podala daňové priznanie elektronicky.",
              "uk": "За минулий рік я подала декларацію електронно."
            }
          ],
          "shortRule": "podať daňové priznanie za + знахідний",
          "commonMistakes": [
            {
              "mistake": "podať daňový priznanie",
              "correct": "podať daňové priznanie"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Аванс, переплата, недоплата",
          "text": "«Preddavok na daň» — авансовий платіж податку протягом року. Після декларації виходить «preplatok» (ти заплатив більше — тобі повернуть) або «nedoplatok» (заплатив менше — треба доплатити). У листах úradu трапляється: «Vyzývame vás na úhradu nedoplatku» — закликаємо вас сплатити недоплату.",
          "examples": [
            {
              "sk": "Na preddavkoch som zaplatil viac, takže mám preplatok.",
              "uk": "Авансами я заплатив більше, тож маю переплату."
            },
            {
              "sk": "Nedoplatok treba uhradiť v stanovenej lehote.",
              "uk": "Недоплату треба сплатити у встановлений строк."
            }
          ],
          "shortRule": "preddavok → priznanie → preplatok / nedoplatok",
          "commonMistakes": [
            {
              "mistake": "platiť preddavky z daň",
              "correct": "platiť preddavky na daň"
            }
          ],
          "button": "Далі →"
        }
      ],
