      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як записують строки",
          "text": "Типові формули: «v lehote … dní odo dňa doručenia» (протягом … днів від дня вручення), «najneskôr do» + родовий (не пізніше ніж до…), «bezodkladne» (невідкладно). Про строк кажуть, що він «plynie» (спливає, триває) і «uplynie» (мине). Після «do» — родовий відмінок: «do piatka», «do konca mesiaca».",
          "examples": [
            {
              "sk": "Doklady doložte v lehote uvedenej vo výzve.",
              "uk": "Документи долучіть у строк, зазначений у вимозі."
            },
            {
              "sk": "Platbu uhraďte najneskôr do konca mesiaca.",
              "uk": "Сплатіть не пізніше кінця місяця."
            }
          ],
          "shortRule": "najneskôr do + родовий · lehota plynie / uplynie",
          "commonMistakes": [
            {
              "mistake": "najneskôr do piatok",
              "correct": "najneskôr do piatka"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як рахувати",
          "text": "Загальне правило в адміністративному провадженні: день, коли сталася подія (наприклад, тобі вручили лист), у строк не зараховують — строк починає плинути наступного дня. Якщо останній день припадає на суботу, неділю чи свято, останнім днем стає найближчий робочий день. Строк дотримано («lehota je zachovaná»), якщо в останній день ти подаєш документ на úrade або здаєш його на пошту. В окремих справах правила можуть відрізнятися — читай лист уважно.",
          "examples": [
            {
              "sk": "Lehota začína plynúť dňom nasledujúcim po doručení.",
              "uk": "Строк починає плинути з наступного дня після вручення."
            },
            {
              "sk": "Ak posledný deň lehoty pripadne na nedeľu, posledným dňom lehoty je najbližší pracovný deň.",
              "uk": "Якщо останній день строку припадає на неділю, останнім днем є найближчий робочий день."
            }
          ],
          "shortRule": "deň doručenia sa do lehoty nepočíta",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Якщо не встигаєш",
          "text": "Якщо знаєш, що не встигнеш, напиши заяву про продовження строку ще до того, як він мине: «Žiadam o predĺženie lehoty na doloženie dokladov, keďže…». Пропустити строк — «zmeškať lehotu»: тоді úrad може вирішити без твоїх документів або припинити розгляд. Тож дотримуватися строків — твоє головне завдання. «Dodatočne» — пізніше, згодом: «doklad doložím dodatočne».",
          "examples": [
            {
              "sk": "Žiadam o predĺženie lehoty, keďže čakám na doklad z Ukrajiny.",
              "uk": "Прошу продовжити строк, оскільки чекаю на документ з України."
            },
            {
              "sk": "Potvrdenie doložím dodatočne.",
              "uk": "Довідку долучу пізніше."
            }
          ],
          "shortRule": "o predĺženie žiadaj ešte pred uplynutím lehoty",
          "button": "Далі →"
        }
      ],
