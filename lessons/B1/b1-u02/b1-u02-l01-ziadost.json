      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Будова заяви",
          "text": "Офіційна заява (žiadosť) має сталу будову. Угорі зліва — «odosielateľ» (твоє ім’я й адреса), нижче — «adresát» (назва úradu та його адреса), праворуч — місце й дата. Далі рядок «Vec:» — коротко, про що заява: «Vec: Žiadosť o vydanie potvrdenia». Потім звертання, текст, підпис і «Prílohy:» — перелік додатків. Якщо бракує якогось із цих реквізитів (náležitostí), úrad може попросити заяву доповнити.",
          "examples": [
            {
              "sk": "Vec: Žiadosť o predĺženie lehoty",
              "uk": "Предмет: Заява про продовження строку"
            },
            {
              "sk": "Prílohy: kópia nájomnej zmluvy",
              "uk": "Додатки: копія договору оренди"
            }
          ],
          "shortRule": "odosielateľ → adresát → Vec → text → podpis → prílohy",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Týmto žiadam o…",
          "text": "Головна фраза заяви: «Týmto žiadam o + знахідний відмінок». «Týmto» тут означає «цим (листом)». Віддієслівні іменники на -nie/-tie середнього роду в знахідному не змінюються: «o vydanie», «o predĺženie». Іменники жіночого роду змінюються: «o zmenu», «o kópiu». Ще дві офіційні формули: «Obraciam sa na Vás so žiadosťou o…» і «Dovoľujem si Vás požiadať o…».",
          "examples": [
            {
              "sk": "Týmto žiadam o vydanie potvrdenia o pobyte.",
              "uk": "Цим прошу видати довідку про перебування."
            },
            {
              "sk": "Dovoľujem si Vás požiadať o zmenu termínu.",
              "uk": "Дозволю собі попросити Вас змінити термін."
            }
          ],
          "shortRule": "žiadam o + знахідний: o zmenu, o vydanie",
          "commonMistakes": [
            {
              "mistake": "Žiadam na vydanie potvrdenia.",
              "correct": "Žiadam o vydanie potvrdenia."
            },
            {
              "mistake": "Žiadam o zmena adresy.",
              "correct": "Žiadam o zmenu adresy."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Обґрунтування й завершення",
          "text": "Після прохання йде «odôvodnenie» — пояснення, чому ти просиш. Типові звороти: «Žiadosť odôvodňujem tým, že…», «Dôvodom je…», «keďže…» (оскільки). Документи, які підтверджують сказане, ти долучаєш до заяви — «doložíš» їх або «priložíš». Завершення: «Vopred ďakujem za kladné vybavenie mojej žiadosti.», далі «S pozdravom» і власноручний підпис. У листі до úradu займенники «Vás», «Vám» пишуть з великої літери.",
          "examples": [
            {
              "sk": "Žiadosť odôvodňujem tým, že som zmenil zamestnávateľa.",
              "uk": "Заяву обґрунтовую тим, що я змінив роботодавця."
            },
            {
              "sk": "Vopred ďakujem za kladné vybavenie.",
              "uk": "Заздалегідь дякую за позитивне вирішення."
            }
          ],
          "shortRule": "odôvodňujem tým, že… · keďže… · Vopred ďakujem…",
          "commonMistakes": [
            {
              "mistake": "Žiadosť odôvodňujem, že…",
              "correct": "Žiadosť odôvodňujem tým, že…"
            },
            {
              "mistake": "kladný vybavenie",
              "correct": "kladné vybavenie"
            }
          ],
          "button": "Далі →"
        }
