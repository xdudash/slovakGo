      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто кого уповноважує",
          "text": "«Splnomocnenie» (або «plná moc») — документ, яким ти доручаєш іншій людині діяти від твого імені. Той, хто дає довіреність, — «splnomocniteľ», той, хто її отримує, — «splnomocnenec». Дієслово «splnomocniť niekoho» вимагає знахідного відмінка (кого?). Підказка: суфікс -teľ означає того, хто робить дію (як učiteľ), а -nec — того, кому її доручили.",
          "examples": [
            {
              "sk": "Splnomocňujem svoju manželku, aby za mňa prevzala doklad.",
              "uk": "Уповноважую свою дружину отримати за мене документ."
            },
            {
              "sk": "Splnomocnenec koná v mene splnomocniteľa.",
              "uk": "Довірена особа діє від імені довірителя."
            }
          ],
          "shortRule": "splnomocniteľ (дає) → splnomocnenec (отримує)",
          "commonMistakes": [
            {
              "mistake": "Splnomocňujem manželke.",
              "correct": "Splnomocňujem manželku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Rozsah: на що саме",
          "text": "Довіреність має чітко сказати, на що вона дає право, — це «rozsah splnomocnenia». Формули: «na prevzatie rozhodnutia» (на отримання рішення), «na podanie žiadosti», «na všetky úkony v konaní o…» (на всі дії в провадженні щодо…). «Úkon» — окрема юридична дія: подати, отримати, підписати. Чим точніше вказано rozsah, тим менше проблем на úrade.",
          "examples": [
            {
              "sk": "Splnomocnenie sa vzťahuje len na prevzatie zásielky.",
              "uk": "Довіреність стосується лише отримання відправлення."
            },
            {
              "sk": "Splnomocnenec je oprávnený podať žiadosť v mojom mene.",
              "uk": "Довірена особа має право подати заяву від мого імені."
            }
          ],
          "shortRule": "na + знахідний: na prevzatie, na podanie",
          "commonMistakes": [
            {
              "mistake": "v môjho mene",
              "correct": "v mojom mene"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що ще має бути",
          "text": "У довіреності вказують дані обох осіб (ім’я, дату народження, адресу), rozsah, місце й дату та підпис довірителя. Часто підписується й довірена особа з фразою «Splnomocnenie prijímam» (довіреність приймаю). Для деяких дій úrad вимагає «úradne osvedčený podpis» — засвідчений підпис довірителя. Довіреність можна й «odvolať» — відкликати.",
          "examples": [
            {
              "sk": "Splnomocnenie prijímam.",
              "uk": "Довіреність приймаю."
            },
            {
              "sk": "Na tento úkon potrebujete splnomocnenie s osvedčeným podpisom.",
              "uk": "Для цієї дії вам потрібна довіреність із засвідченим підписом."
            }
          ],
          "shortRule": "údaje oboch strán + rozsah + dátum + podpis",
          "button": "Далі →"
        }
      ],
