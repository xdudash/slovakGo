      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Номер справи й стан провадження",
          "text": "Кожна справа на úrade має «spisovú značku» (номер справи) — вона є на кожному листі. Називай її на початку розмови: «Volám vo veci svojej žiadosti, spisová značka…». «Vo veci + родовий» — у справі, щодо. Про стан справи питай: «V akom štádiu je moje konanie?», «Kedy môžem čakať rozhodnutie?» Твою справу веде конкретний службовець — «referent / referentka».",
          "examples": [
            {
              "sk": "V akom štádiu je moje konanie?",
              "uk": "На якій стадії моє провадження?"
            },
            {
              "sk": "Kto je referentom v mojej veci?",
              "uk": "Хто веде мою справу?"
            }
          ],
          "shortRule": "vo veci + родовий · spisová značka",
          "commonMistakes": [
            {
              "mistake": "volám vo veci moja žiadosť",
              "correct": "volám vo veci mojej žiadosti"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Якщо не розумієш",
          "text": "Не соромся просити: «Mohli by ste to zopakovať pomalšie?», «Mohli by ste mi to vysvetliť jednoduchšie?» Перевір, чи правильно зрозуміла: «Ak tomu dobre rozumiem, mám doložiť…, je to tak?» Важливе проси письмово: «Mohli by ste mi to dať písomne?» Усно — «ústne», письмово — «písomne». Учасник провадження має право «nahliadnuť do spisu» — ознайомитися з матеріалами своєї справи.",
          "examples": [
            {
              "sk": "Ak tomu dobre rozumiem, mám doložiť ešte jedno potvrdenie.",
              "uk": "Якщо я правильно розумію, я маю долучити ще одну довідку."
            },
            {
              "sk": "Chcela by som nahliadnuť do spisu.",
              "uk": "Я хотіла б ознайомитися з матеріалами справи."
            }
          ],
          "shortRule": "Ak tomu dobre rozumiem… · nahliadnuť do + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Výzva й ввічлива наполегливість",
          "text": "«Výzva» — офіційна вимога úradu: «výzva na doplnenie podania» (доповнити подання), «výzva na zaplatenie». Відповідай вчасно й посилайся на неї: «Na základe vašej výzvy dokladám…». Якщо щось іде не так, будь ввічлива, але конкретна: «Rozumiem, ale podľa poučenia mám právo…», «Mohli by ste mi povedať, na koho sa môžem obrátiť?» Уникай емоцій — службовець працює з фактами й документами.",
          "examples": [
            {
              "sk": "Na základe vašej výzvy dokladám potvrdenie o príjme.",
              "uk": "На підставі вашої вимоги долучаю довідку про дохід."
            },
            {
              "sk": "Rozumiem, ale mohli by ste mi povedať, na koho sa môžem obrátiť?",
              "uk": "Розумію, але чи могли б ви сказати, до кого я можу звернутися?"
            }
          ],
          "shortRule": "na základe výzvy · zdvorilo, ale konkrétne",
          "button": "Далі →"
        }
      ],
