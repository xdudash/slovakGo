      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке živnosť",
          "text": "«Živnosť» — підприємницька діяльність (схоже на український ФОП), яку людина веде постійно, самостійно, від свого імені, на власну відповідальність і з метою отримати прибуток. Людину з živnosťou називають «živnostník». Дієслово «podnikať» — займатися підприємництвом; «podnikať v + місцевий» — у якійсь галузі. Усіх живностенників веде «živnostenský register», а реєстрацією займаються okresné úrady.",
          "examples": [
            {
              "sk": "Manžel podniká v stavebníctve.",
              "uk": "Чоловік займається підприємництвом у будівництві."
            },
            {
              "sk": "Živnosť sa vykonáva samostatne, vo vlastnom mene a na vlastnú zodpovednosť.",
              "uk": "Підприємницьку діяльність (živnosť) провадять самостійно, від власного імені й на власну відповідальність."
            }
          ],
          "shortRule": "podnikať ako živnostník · podnikať v + місцевий",
          "commonMistakes": [
            {
              "mistake": "Podnikám v stavebníctvo.",
              "correct": "Podnikám v stavebníctve."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Види živností",
          "text": "«Voľná živnosť» (вільна) не потребує спеціальної кваліфікації — це, наприклад, прибиральні чи адміністративні послуги. «Remeselná» (ремісна) і «viazaná» (зв’язана) živnosti вимагають «odbornú spôsobilosť» — підтвердженої освіти або практики: перукарня чи мулярство — ремісні živnosti. Те, чим саме ти займатимешся, вказуєш як «predmet podnikania».",
          "examples": [
            {
              "sk": "Upratovacie služby sú voľná živnosť.",
              "uk": "Прибиральні послуги — це вільна živnosť."
            },
            {
              "sk": "Na kaderníctvo potrebujete odbornú spôsobilosť.",
              "uk": "Для перукарні вам потрібна фахова кваліфікація."
            }
          ],
          "shortRule": "voľná × remeselná / viazaná (s odbornou spôsobilosťou)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Реєстрація й IČO",
          "text": "Živnosť реєструють на okresnom úrade — у «jednotnom kontaktnom mieste» (JKM) — або онлайн. Ти подаєш «ohlásenie živnosti» і вказуєш predmet podnikania та місце підприємництва. Після внесення до реєстру отримаєш «IČO» — ідентифікаційний номер — і витяг із реєстру (výpis). Через JKM можна водночас зареєструватися на податковому úrade й у медичній страховій.",
          "examples": [
            {
              "sk": "Chcela by som ohlásiť voľnú živnosť.",
              "uk": "Я хотіла б зареєструвати вільну živnosť."
            },
            {
              "sk": "IČO nájdete vo výpise zo živnostenského registra.",
              "uk": "IČO знайдете у витягу з живностенського реєстру."
            }
          ],
          "shortRule": "ohlásiť živnosť → výpis → IČO",
          "button": "Далі →"
        }
      ],
