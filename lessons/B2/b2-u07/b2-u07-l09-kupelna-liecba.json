      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Шлях до курорту",
          "text": "Словаччина славиться курортами з лікувальними джерелами: П’єштяни (опорно-руховий апарат), Тренчанське Тепліце, Бардейовські купелі, Сляч (серце й судини) та інші. Щоб лікування оплатила страхова, лікар — найчастіше спеціаліст — заповнює «návrh na kúpeľnú liečbu». Страхова передає його своєму лікареві-експерту — «revízny lekár», який оцінює (posúdi), чи лікування доречне, і схвалює (schváli) або відхиляє його. Пацієнт отримує письмове рішення з назвою курорту, терміном і категорією. Хто платить за себе сам, їде як samoplatca.",
          "examples": [
            {
              "sk": "Ortopéd mi vypísal návrh na kúpeľnú liečbu.",
              "uk": "Ортопед заповнив мені направлення на курортне лікування."
            },
            {
              "sk": "Návrh posúdi revízny lekár poisťovne.",
              "uk": "Направлення оцінить лікар-експерт страхової."
            }
          ],
          "shortRule": "návrh → posúdenie revíznym lekárom → schválenie → nástup do kúpeľov",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Категорії A і B",
          "text": "Страхова зазвичай схвалює лікування в одній із двох категорій. Категорія A — коли лікування є необхідною частиною лікування (наприклад, після деяких операцій чи важких станів): страхова, як правило, оплачує і процедури, і проживання з харчуванням. Категорія B — лікування корисне, але не таке нагальне: страхова оплачує процедури, а проживання й харчування пацієнт оплачує повністю чи частково сам. Точні умови й строки (наприклад, до коли треба розпочати лікування після операції) визначає закон і страхова, тож читай рішення уважно.",
          "examples": [
            {
              "sk": "Liečba bola schválená v kategórii A.",
              "uk": "Лікування схвалено в категорії A."
            },
            {
              "sk": "Pri kategórii B si ubytovanie a stravu platíte sami.",
              "uk": "У категорії B проживання й харчування ви оплачуєте самі."
            }
          ],
          "shortRule": "A — poisťovňa spravidla hradí všetko · B — procedúry hradí poisťovňa, ubytovanie a stravu pacient",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Мова рішення й курортного дня",
          "text": "Рішення страхової — мова пасиву: «Návrh bol schválený / zamietnutý.», «Liečba je hradená v rozsahu…», «Pacient je povinný nastúpiť v termíne…». Захворювання, з якими курорт доречний, — «indikácia» (показання); стани, коли не можна, — «kontraindikácia» (протипоказання). На курорті — процедури: vodoliečba (водолікування), bahenný zábal (грязьова аплікація), masáž, rehabilitácia (реабілітаційні вправи), kúpeľ v liečivom prameni. «Liečivý» — лікувальний: liečivá voda, liečivý prameň.",
          "examples": [
            {
              "sk": "Návrh bol schválený a nástup je 3. marca.",
              "uk": "Направлення схвалено, заїзд — 3 березня."
            },
            {
              "sk": "Pri tejto diagnóze je kúpeľná liečba indikovaná.",
              "uk": "При цьому діагнозі курортне лікування показане."
            }
          ],
          "shortRule": "bol schválený / zamietnutý · indikácia ≠ kontraindikácia · liečivý prameň",
