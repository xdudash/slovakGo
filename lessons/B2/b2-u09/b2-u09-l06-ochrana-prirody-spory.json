      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ступені охорони",
          "text": "Охорону природи у Словаччині регулює закон, який розрізняє п’ять ступенів охорони (stupne ochrany). Перший діє на всій території країни, п’ятий — найсуворіший: це, наприклад, природні заповідники (prírodné rezervácie), де часто не можна сходити зі стежки, збирати рослини чи гриби. Охоронювані території (chránené územia) — це національні парки, chránené krajinné oblasti (CHKO) й території мережі NATURA 2000. Мета — зберегти «biodiverzitu» (біорізноманіття), зокрема «ohrozené druhy» (зникаючі види). Небезпеку становлять і «invázne druhy» — занесені людиною види, що витісняють місцеві; наприклад, «boľševník obrovský» (борщівник Мантегацці), сік якого на сонці спричиняє опіки.",
          "examples": [
            {
              "sk": "V piatom stupni ochrany je vstup mimo chodníkov zakázaný.",
              "uk": "У п’ятому ступені охорони сходити зі стежок заборонено."
            },
            {
              "sk": "Invázne druhy vytláčajú pôvodné rastliny.",
              "uk": "Інвазивні види витісняють місцеві рослини."
            }
          ],
          "shortRule": "1. stupeň — уся країна · 5. stupeň — найсуворіший",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як нейтрально передати чужу позицію",
          "text": "У суперечках про природу медіа й офіційні тексти передають позиції сторін нейтрально. «Podľa» + родовий: «podľa lesníkov», «podľa ochranárov». Дієслова мовлення: «tvrdiť, že» (стверджувати), «namietať, že» (заперечувати, висувати заперечення), «upozorňovať na» + знахідний (звертати увагу на), «poukazovať na» (вказувати на), «zastávať názor, že» (дотримуватися думки). Оцінні слова — «ekoteroristi», «drancovanie lesov», «lesná mafia» — належать до полеміки, не до звіту.",
          "examples": [
            {
              "sk": "Lesníci upozorňujú na riziko šírenia kôrovca.",
              "uk": "Лісники звертають увагу на ризик поширення короїда."
            },
            {
              "sk": "Ochranári namietajú, že ťažba poškodzuje biotopy.",
              "uk": "Природоохоронці заперечують, що вирубка шкодить біотопам."
            }
          ],
          "shortRule": "podľa + род. · tvrdiť / namietať, že · upozorňovať na + знах.",
          "commonMistakes": [
            {
              "mistake": "Podľa ochranári…",
              "correct": "Podľa ochranárov…"
            },
            {
              "mistake": "Lesníci upozorňujú o riziku.",
              "correct": "Lesníci upozorňujú na riziko."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Суперечка про короїда",
          "text": "Після великого вітровалу в Татрах у 2004 році й посушливих років ліси масово атакує «kôrovec» (короїд). Лісники зазвичай обстоюють «sanáciu» — швидку вирубку й вивезення уражених дерев, щоб шкідник не поширювався, і нагадують, що заготівля деревини (ťažba dreva) дає роботу в регіоні. Природоохоронці натомість вимагають «bezzásahové územia» — зони, де природу залишають у спокої: мертва деревина, за їхніми словами, є домівкою для багатьох видів, і ліс оновлюється сам. Обидві сторони хочуть зберегти ліс — розходяться в тому, як.",
          "examples": [
            {
              "sk": "Okolo ťažby v národných parkoch prebieha dlhoročný spor.",
              "uk": "Навколо вирубки в національних парках триває багаторічна суперечка."
            },
            {
              "sk": "Obe strany sa zhodujú, že les treba chrániť.",
              "uk": "Обидві сторони згодні, що ліс треба захищати."
            }
          ],
          "shortRule": "sanácia ↔ bezzásahové územie · обидві сторони — спільна мета",
          "button": "Далі →"
        }
      ],
