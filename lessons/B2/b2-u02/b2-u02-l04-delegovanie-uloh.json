      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чітке доручення",
          "text": "Хороше доручення відповідає на чотири питання: що зробити, до коли, за яким стандартом і з якими повноваженнями. Дієслова: «poveriť niekoho niečím» — «Poverila som Mareka prípravou rozpisu» (знахідний + орудний); «prideliť niekomu niečo» — призначити, виділити: «Pridelil mi nový projekt»; «zveriť niekomu niečo» — довірити, наголос на довірі: «Zveril mi kľúče od skladu.» Ввічливе прохання: «Mohli by ste pripraviť…?» або «Prosím Vás, aby ste pripravili…» (після «aby» — форма на -l + ste). Слово «delegovať» ти вже знаєш — воно звучить нейтрально-офіційно.",
          "examples": [
            {
              "sk": "Poverila som kolegu prípravou správy.",
              "uk": "Я доручила колезі підготувати звіт."
            },
            {
              "sk": "Prosím Vás, aby ste pripravili prezentáciu do stredy.",
              "uk": "Прошу Вас підготувати презентацію до середи."
            }
          ],
          "shortRule": "poveriť + знахідний + орудний · aby ste + l-форма",
          "commonMistakes": [
            {
              "mistake": "poveriť niekoho prípravu",
              "correct": "poveriť niekoho prípravou"
            },
            {
              "mistake": "Prosím, aby ste pripravíte",
              "correct": "Prosím, aby ste pripravili"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Právomoc і zodpovednosť",
          "text": "«Zodpovednosť» — відповідальність, «právomoc» — повноваження: що людина може вирішувати без дозволу. Хороше делегування передає обидва: «Zodpovedáte za kvalitu a máte právomoc rozhodnúť o nákupoch do tisíc eur.» Зверни увагу: «zodpovedať za» + знахідний, «dohliadať na» + знахідний, «rozhodnúť o» + місцевий. Якщо завдань забагато — їх «prerozdeľujeme»: «prerozdeliť úlohy medzi kolegov» (medzi + знахідний).",
          "examples": [
            {
              "sk": "Zodpovedáte za kvalitu práce tímu.",
              "uk": "Ви відповідаєте за якість роботи команди."
            },
            {
              "sk": "Dohliadam na plnenie termínov.",
              "uk": "Я стежу за дотриманням термінів."
            }
          ],
          "shortRule": "zodpovedať za + знахідний · dohliadať na + знахідний · rozhodnúť o + місцевий",
          "commonMistakes": [
            {
              "mistake": "dohliadať o kvalitu",
              "correct": "dohliadať na kvalitu"
            },
            {
              "mistake": "zodpovedať na výsledok",
              "correct": "zodpovedať za výsledok"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Реакція на доручення",
          "text": "Є три прийнятні відповіді. Прийняття: «Rozumiem, zabezpečím to do piatka.» — повторення терміну показує, що ти зрозумів. Уточнення: «Mohli by ste upresniť, čo presne očakávate?» Мотивована відмова чи пропозиція: «Momentálne som preťažený, môžem to prevziať až od budúceho týždňa.» Мовчання або «uvidíme» — найгірший варіант. Коли завдання виконано — «dajte vedieť»: «Po dokončení Vám dám vedieť.»",
          "examples": [
            {
              "sk": "Rozumiem, zabezpečím to do piatka.",
              "uk": "Зрозуміло, забезпечу це до п’ятниці."
            },
            {
              "sk": "Môžem to prevziať až od budúceho týždňa.",
              "uk": "Можу це взяти на себе лише з наступного тижня."
            }
          ],
          "shortRule": "прийняти · уточнити · мотивовано відмовити",
          "commonMistakes": [
