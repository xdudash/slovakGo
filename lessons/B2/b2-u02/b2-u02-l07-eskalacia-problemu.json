      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Коли й кому ескалювати",
          "text": "Ескалація — це передача проблеми на вищий рівень, коли вона перевищує твої повноваження або час і загрожує результату. Спершу — спроба вирішити з колегою чи партнером; потім — керівник відділу; далі — директор. Вжиток: «eskalovať problém na vedúceho» (na + знахідний): «Problém sme eskalovali na vedúceho oddelenia.» Ескалація — не скарга й не покарання: це робочий інструмент, коли потрібне рішення, якого ти сам ухвалити не можеш. Ввічливий вступ: «Obraciam sa na Vás s prosbou o pomoc pri riešení…»",
          "examples": [
            {
              "sk": "Problém sme eskalovali na vedúceho oddelenia.",
              "uk": "Проблему ми передали вище, керівникові відділу."
            },
            {
              "sk": "Obraciam sa na Vás s prosbou o pomoc.",
              "uk": "Звертаюся до Вас із проханням про допомогу."
            }
          ],
          "shortRule": "eskalovať na + знахідний · s prosbou o + знахідний",
          "commonMistakes": [
            {
              "mistake": "eskalovať o vedúceho",
              "correct": "eskalovať na vedúceho"
            },
            {
              "mistake": "s prosbu o pomoc",
