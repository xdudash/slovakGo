      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура zápisnice",
          "text": "Протокол має сталу структуру: 1) заголовок — «Zápisnica z porady oddelenia predaja konanej dňa 20. 10. 2026» (dňa — родовий, офіційно); 2) «Prítomní» і «Neprítomní / Ospravedlnení»; присутність підтверджує «prezenčná listina» — список із підписами; 3) «Zapisovateľ» — хто пише, «Overovateľ» — хто перевіряє й засвідчує; 4) «Priebeh» — перебіг; 5) «Uznesenia» — рішення; 6) «Úlohy» — завдання. Протокол розсилають учасникам, зазвичай протягом кількох робочих днів.",
          "examples": [
            {
              "sk": "Zápisnica z porady konanej dňa 20. 10. 2026.",
              "uk": "Протокол наради, що відбулася 20.10.2026."
            },
            {
              "sk": "Zapisovateľ: Mgr. Tóth, overovateľ: M. Horváth.",
              "uk": "Протоколіст — Mgr. Tóth, перевіряє — M. Horváth."
            }
          ],
          "shortRule": "hlavička · prítomní · priebeh · uznesenia · úlohy",
          "commonMistakes": [
            {
              "mistake": "Zápisnica z porada",
              "correct": "Zápisnica z porady"
            },
            {
              "mistake": "konanej deň 20. 10.",
              "correct": "konanej dňa 20. 10."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Час і стиль",
          "text": "Перебіг наради записують у минулому часі, доконаний вид: «Predsedajúca otvorila poradu», «Riaditeľ informoval o výsledkoch», «Prítomní prerokovali návrh.» А рішення (uznesenie) — у теперішньому часі: «Porada schvaľuje plán brigád.», «Porada berie na vedomie správu.», «Porada ukladá Marekovi pripraviť podklady do piatka.» («ukladať» + давальний + інфінітив). Стиль — стислий, без розмовних слів, без оцінок: не «Šéf sa nahneval», а «Riaditeľ vyjadril nesúhlas.»",
          "examples": [
            {
              "sk": "Prítomní prerokovali návrh rozpočtu.",
              "uk": "Присутні обговорили проєкт бюджету."
            },
            {
              "sk": "Porada ukladá Marekovi pripraviť správu do piatka.",
              "uk": "Нарада доручає Маркові підготувати звіт до п’ятниці."
            }
          ],
          "shortRule": "перебіг — минулий · uznesenie — теперішній",
          "commonMistakes": [
            {
              "mistake": "Porada schválila by plán.",
              "correct": "Porada schvaľuje plán."
            },
            {
              "mistake": "Porada ukladá Mareka pripraviť.",
              "correct": "Porada ukladá Marekovi pripraviť."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Голосування і завдання",
          "text": "Голосування записуємо в трьох рубриках: «za — proti — zdržal sa»: «Hlasovanie: za 6, proti 0, zdržal sa 1.» Дієслова: «hlasovať za návrh», «hlasovať proti návrhu» (давальний!), «zdržať sa hlasovania» (родовий). Завдання записуємо як «Úloha — Z (zodpovedný) — T (termín)»: «Úloha: pripraviť zoznam brigádnikov. Z: Mgr. Tóth. T: 30. 10. 2026.» Чітка відповідальна особа і конкретна дата — головне: без них завдання не можна перевірити.",
          "examples": [
            {
              "sk": "Hlasovať proti návrhu, zdržať sa hlasovania.",
              "uk": "Голосувати проти пропозиції, утриматися від голосування."
            },
            {
              "sk": "Z: Mgr. Tóth, T: 30. 10. 2026.",
              "uk": "Відповідальний — Mgr. Tóth, термін — 30.10.2026."
