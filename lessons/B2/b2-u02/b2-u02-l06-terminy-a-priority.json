      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як називати строки",
          "text": "Крайній строк — «do» + родовий: «do piatka», «do konca týždňa», «do dvanástej». «Najneskôr» підкреслює межу: «najneskôr v utorok». Для запланованої дати — «na» + знахідний: «Termín je určený na piatok.» Зсув строку — «posunúť termín»: «o» + знахідний (на скільки): «o dva dni»; «na» + знахідний (на коли): «na pondelok». Іменник — «posunutie termínu» (родовий): «Žiadam o posunutie termínu.» «Termín odovzdania» — строк подання; «v priebehu týždňa» — протягом тижня.",
          "examples": [
            {
              "sk": "Správu odovzdám do konca týždňa.",
              "uk": "Звіт здам до кінця тижня."
            },
            {
              "sk": "Termín sme posunuli o dva dni na pondelok.",
              "uk": "Строк ми зсунули на два дні, на понеділок."
            }
          ],
          "shortRule": "do + родовий · na + знахідний · o + знахідний",
          "commonMistakes": [
            {
              "mistake": "do koniec týždňa",
              "correct": "do konca týždňa"
            },
            {
              "mistake": "posunúť termín do dva dni",
              "correct": "posunúť termín o dva dni"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пріоритети",
          "text": "«Priorita» — те, що має перевагу. Прості формули: «Najvyššiu prioritu má ponuka pre klienta.» «Táto úloha má prednosť pred ostatnými.» (mať prednosť pred + орудний). Не змішуй «dôležité» (важливе для мети) і «urgentné» (потрібне негайно): важливе не завжди термінове. Спершу роби термінове й важливе, важливе нетермінове — плануй, дрібне термінове — делегуй. Структуруй: «najprv… potom… nakoniec», «na prvom mieste je…».",
          "examples": [
            {
              "sk": "Táto úloha má prednosť pred ostatnými.",
              "uk": "Це завдання має перевагу над іншими."
            },
            {
              "sk": "Je to dôležité, ale nie urgentné.",
              "uk": "Це важливо, але не терміново."
            }
          ],
          "shortRule": "mať prednosť pred + орудний · urgentný ≠ dôležitý",
          "commonMistakes": [
            {
              "mistake": "prednosť od ostatných",
              "correct": "prednosť pred ostatnými"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Переговори про строки",
          "text": "Попросити про зсув — з причиною й пропозицією: «Požiadal by som o posunutie termínu o dva dni, pretože čakám na podklady od klienta.» Пояснити завантаженість: «Som momentálne vyťažený» (весь час розписаний) або «som zaťažený inými úlohami»; відразу додай альтернативу: «Do štvrtka stihnem prvú časť, zvyšok najneskôr v pondelok.» Відмова колеги: «Termín je pevný, bohužiaľ ho nemôžeme posunúť.» Без альтернативи «nestihnem» звучить як відмова від відповідальності.",
          "examples": [
            {
              "sk": "Som momentálne vyťažený, ale do štvrtka stihnem prvú časť.",
              "uk": "Я зараз дуже завантажений, але до четверга встигну першу частину."
            },
            {
              "sk": "Termín je pevný, nedá sa posunúť.",
              "uk": "Строк твердий, його не можна зсунути."
            }
          ],
          "shortRule": "причина + альтернатива",
          "commonMistakes": [
            {
              "mistake": "Nestihnem to.",
              "correct": "Do štvrtka stihnem prvú časť, zvyšok v pondelok."
            },
            {
              "mistake": "Som zaťažený na úlohy",
              "correct": "Som zaťažený úlohami"
            }
          ],
          "button": "Далі →"
        }
      ],
