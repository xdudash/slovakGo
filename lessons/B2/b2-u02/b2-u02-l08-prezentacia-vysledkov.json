      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура презентації",
          "text": "Коротка презентація має три частини. Вступ: тема, мета, план: «Dobrý deň, dovoľte, aby som Vám predstavil výsledky za tretí štvrťrok. Moja prezentácia má tri časti.» Основна частина: цифри, графік, пояснення: «V prvej časti sa zameriam na tržby.» «Ako vidíte na grafe, tržby rastú.» (на + місцевий: na grafe). Висновок: підсумок, рекомендація, запитання: «Na záver zhrniem hlavné čísla.» «Ďakujem za pozornosť, rád odpoviem na Vaše otázky.» Одне повідомлення на слайд — і тоді слухач запам’ятає більше.",
          "examples": [
            {
              "sk": "Moja prezentácia má tri časti.",
              "uk": "Моя презентація має три частини."
            },
            {
              "sk": "Ako vidíte na grafe, tržby rastú.",
              "uk": "Як ви бачите на графіку, виручка зростає."
            }
          ],
          "shortRule": "úvod · hlavná časť · záver",
          "commonMistakes": [
            {
              "mistake": "Ako vidíte na graf",
              "correct": "Ako vidíte na grafe"
            },
            {
              "mistake": "odpoviem otázky",
              "correct": "odpoviem na otázky"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Цифри й тренди",
          "text": "«Tržby» — виручка (множина!), «zisk» — прибуток, «ukazovateľ» — показник. Зростання: «nárast», «vzrásť / stúpnuť»; зменшення: «pokles», «klesnúť / poklesnúť». На скільки — «o» + знахідний: «Tržby vzrástli o osem percent.» Від чого до чого — «z» + родовий, «na» + знахідний: «Zisk klesol zo 140 na 120 tisíc eur.» «Medziročne» — порівняно з минулим роком: «medziročný nárast tržieb o 8 %». Дієслово узгоджується з множиною: «tržby vzrástli», але «zisk vzrástol».",
          "examples": [
            {
              "sk": "Tržby vzrástli o osem percent.",
              "uk": "Виручка зросла на вісім відсотків."
            },
            {
              "sk": "Zisk klesol zo 140 na 120 tisíc eur.",
              "uk": "Прибуток впав зі 140 до 120 тисяч євро."
            }
          ],
          "shortRule": "o + знахідний (на скільки) · z … na … (від … до …)",
          "commonMistakes": [
            {
              "mistake": "Tržby vzrástol",
              "correct": "Tržby vzrástli"
            },
            {
              "mistake": "vzrástli na osem percent (на скільки)",
              "correct": "vzrástli o osem percent"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Причини й запитання",
          "text": "Після цифр слухач запитає «чому?». Пояснення: «Nárast súvisí s novou ponukou.», «Je to spôsobené tým, že vzrástli ceny energií.», «Z grafu vyplýva, že…». Відповідаючи на запитання, дякуй: «Ďakujem za otázku.» Якщо не знаєш точної цифри — не вигадуй: «Presné číslo nemám, doplním ho e-mailom do zajtra.» Це професійніше за здогадку. Невдалий початок: «Tak… no… ja nejako neviem, čo vám tu mám povedať» — слухачі втрачають довіру.",
          "examples": [
            {
              "sk": "Je to spôsobené tým, že vzrástli ceny energií.",
              "uk": "Це спричинене тим, що зросли ціни на енергію."
            },
            {
              "sk": "Presné číslo nemám, doplním ho e-mailom.",
              "uk": "Точної цифри не маю, доповню її листом."
            }
          ],
          "shortRule": "súvisí s + орудний · je to spôsobené tým, že… · не вигадувати",
          "commonMistakes": [
            {
              "mistake": "súvisí s nové ceny",
              "correct": "súvisí s novými cenami"
            }
          ],
          "button": "Далі →"
        }
      ],
