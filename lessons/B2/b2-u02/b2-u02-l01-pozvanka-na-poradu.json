      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Структура pozvánky",
          "text": "Робоче запрошення на нараду складається з п’яти частин: 1) predmet — тема в рядку «Predmet»: «Pozvánka na poradu: rozpočet 2027»; 2) termín — день і година; 3) miesto konania — місце проведення; 4) program — зазвичай у вкладенні; 5) прохання про підтвердження. Типові формули: «Dovoľujem si Vás pozvať na…» (офіційно), «Pozývam Vás na…» (нейтрально-ділово), «Zvolávam poradu na…» (говорить той, хто керує). Прохання: «Prosím o potvrdenie účasti do utorka.» — після «o» іменник стоїть у знахідному: potvrdenie, і далі в родовому: účasti.",
          "examples": [
            {
              "sk": "Dovoľujem si Vás pozvať na poradu k rozpočtu.",
              "uk": "Дозвольте запросити Вас на нараду щодо бюджету."
            },
            {
              "sk": "Program porady nájdete v prílohe.",
              "uk": "Програму наради ви знайдете у вкладенні."
            }
          ],
          "shortRule": "predmet · termín · miesto konania · program · potvrdenie účasti",
          "commonMistakes": [
            {
              "mistake": "Prosím o potvrdenie účasť.",
              "correct": "Prosím o potvrdenie účasti."
            },
            {
              "mistake": "Program je v príloha.",
              "correct": "Program je v prílohe."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pozvať, zvolať, prizvať",
          "text": "«Pozvať» — запросити будь-кого куди-небудь: «Pozvem ťa na kávu.» «Zvolať» — скликати збори, нараду; це робить організатор: «Vedúci zvolal poradu na štvrtok.» (недоконаний вид — «zvolávať»). «Prizvať» — додатково залучити когось до наради, найчастіше експерта: «Na poradu prizveme aj právnika.» Нарада «sa koná» або «sa uskutoční» — відбувається: «Porada sa uskutoční v štvrtok o deviatej.» Дієслово «zúčastniť sa» найчастіше вживаємо з родовим відмінком: «zúčastniť sa porady» (можливо й «zúčastniť sa na porade»).",
          "examples": [
            {
              "sk": "Vedúci zvolal poradu a prizval aj právnika.",
              "uk": "Керівник скликав нараду й додатково залучив юриста."
            },
            {
              "sk": "Porada sa uskutoční v zasadacej miestnosti.",
              "uk": "Нарада відбудеться в залі засідань."
            }
          ],
          "shortRule": "zvolať — скликати · prizvať — залучити · zúčastniť sa + родовий",
          "commonMistakes": [
            {
              "mistake": "zúčastniť sa poradu",
              "correct": "zúčastniť sa porady"
            },
            {
              "mistake": "zvolať kolegu",
              "correct": "prizvať kolegu"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відповідь на запрошення",
          "text": "Відповідь має бути короткою й чіткою. Підтвердження: «Ďakujem za pozvanie, svoju účasť potvrdzujem.» Відмова: «Bohužiaľ sa porady nemôžem zúčastniť, ospravedlňujem sa.» Можна запропонувати заміну: «Zastúpi ma kolegyňa Nováková.» Якщо є пропозиція до програми, пишемо про неї одразу: «K programu mám jednu pripomienku.» Регістр: до керівника й зовнішніх партнерів — на «Vy» («Ďakujem Vám za pozvanie»); між колегами в команді часто достатньо «Ahoj, potvrdzujem, prídem.»",
          "examples": [
            {
              "sk": "Ďakujem za pozvanie, svoju účasť potvrdzujem.",
              "uk": "Дякую за запрошення, свою участь підтверджую."
            },
            {
              "sk": "Bohužiaľ sa porady nemôžem zúčastniť, zastúpi ma kolega.",
              "uk": "На жаль, не можу взяти участь у нараді, мене заступить колега."
            }
          ],
          "shortRule": "potvrdzujem účasť · nemôžem sa zúčastniť · zastúpi ma…",
          "button": "Далі →"
        }
