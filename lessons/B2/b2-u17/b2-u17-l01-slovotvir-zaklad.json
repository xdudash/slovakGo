      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Корінь і афікси",
          "text": "Слово складається з кореня (koreň), який несе основне значення, і афіксів: predpony (приставки на початку), prípony (суфікси після кореня) і koncovky (закінчення). Наприклад: «rob-» (корінь) + «-ota» (суфікс) → «robota» (робота).",
          "examples": [
            {
              "sk": "robiť → robota",
              "uk": "працювати → робота"
            },
            {
              "sk": "robota → robotník",
              "uk": "робота → робітник"
            }
          ],
          "shortRule": "koreň · prípona · predpona",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Від дієслова до іменника",
          "text": "Із дієслова часто утворюють іменник за допомогою суфікса: «učiť» → «učiteľ» (учитель), «čítať» → «čítanie» (читання). Закінчення іменника вказує на рід і відмінок, тому «učiteľ» — чоловічий рід.",
          "examples": [
            {
              "sk": "Učiteľ učí deti.",
              "uk": "Учитель навчає дітей."
            },
            {
              "sk": "Čítanie je moja obľúbená činnosť.",
              "uk": "Читання — моя улюблена діяльність."
            }
          ],
          "shortRule": "učiť → učiteľ · čítať → čítanie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Значення через частини",
          "text": "Знаючи частину слова, можна вгадати його значення: «domov» = «dom» + «-ov» (дім, домівка). Але будь обережний: не кожне слово з однаковим початком має однакове значення.",
          "examples": [
            {
              "sk": "Domov je miesto, kde bývame.",
              "uk": "Домівка — місце, де ми живемо."
            },
            {
              "sk": "Robotník pracuje v továrni.",
              "uk": "Робітник працює на фабриці."
            }
          ],
