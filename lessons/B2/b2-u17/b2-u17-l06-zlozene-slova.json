      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Складене слово",
          "text": "Словацька часто з’єднує два слова в одне: «autobusová zastávka» (автобусна зупинка) пишеться окремо, але «obchodný dom» — з дефісом або окремо, залежно від норми. Складені прикметники з числівником пишуться разом: «dvojročný» (дворічний), «trojposchodový» (триповерховий).",
          "examples": [
            {
              "sk": "Dvojročný chlapec už číta.",
              "uk": "Дворічний хлопчик уже читає."
            },
            {
              "sk": "Trojposchodový dom je starý.",
              "uk": "Триповерховий будинок старий."
            }
          ],
          "shortRule": "dvojročný · trojposchodový",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Розкладання складеного слова",
          "text": "Щоб зрозуміти складене слово, розклади його на частини: «autobusová zastávka» = «autobus» (автобус) + «zastávka» (зупинка). Значення складається з частин, але не завжди буквально: «hlavný vchod» — головний вхід.",
          "examples": [
            {
              "sk": "Autobusová zastávka je pri škole.",
              "uk": "Автобусна зупинка біля школи."
            },
            {
              "sk": "Hlavný vchod je otvorený.",
              "uk": "Головний вхід відкритий."
            }
          ],
          "shortRule": "autobus + zastávka",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Числівник у складеному прикметнику",
          "text": "Складені прикметники з числівниками: «dvojročný» (два + рік), «desaťročný» (десять + рік), «päťposchodový» (п’ять + поверх). Пишемо їх разом без пробілів.",
          "examples": [
            {
              "sk": "Desaťročný projekt skončil.",
              "uk": "Десятирічний проєкт завершився."
            },
            {
              "sk": "Päťposchodový dom je nový.",
              "uk": "П’ятиповерховий будинок новий."
            }
          ],
