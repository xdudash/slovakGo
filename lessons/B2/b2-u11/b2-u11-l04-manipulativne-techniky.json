      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Емоції замість аргументів",
          "text": "Маніпуляція («manipulácia») — спроба вплинути на тебе так, щоб ти не помітив, як саме. Найпростіше — грати на емоціях («apelovať na emócie»): страх, гнів, жалість. «Zastrašovanie» — залякування: «Vaše deti sú v ohrození!», «Zajtra môže byť neskoro!» «Nálepkovanie» — навішування ярликів: замість аргументу опонента називають «zradca», «extrémista», «neschopný». Ярлик не доводить нічого — він лише відбиває бажання слухати іншу сторону.",
          "examples": [
            {
              "sk": "Kto nesúhlasí, je vraj zradca – to je nálepkovanie.",
              "uk": "Хто не згоден, той нібито зрадник — це навішування ярликів."
            },
            {
              "sk": "Strach nie je argument.",
              "uk": "Страх — не аргумент."
            }
          ],
          "shortRule": "емоція + ярлик замість фактів = сигнал маніпуляції",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Правда, але не вся",
          "text": "«Polopravda» — напівправда: кожне речення правдиве, але бракує важливої частини, тож висновок хибний. «Vytrhnúť z kontextu» — вирвати з контексту: процитувати слова без умови чи обставин. Мер сказав: «Dane zvýšime iba vtedy, ak príde kríza.» Заголовок: «Primátor: Dane zvýšime». Подібно «zamlčať» — замовчати незручну інформацію. Пасивний дієприкметник узгоджується з іменником: «citát bol vytrhnutý», «veta bola vytrhnutá», «slová boli vytrhnuté z kontextu».",
          "examples": [
            {
              "sk": "Citát bol vytrhnutý z kontextu.",
              "uk": "Цитату вирвали з контексту."
            },
            {
              "sk": "Článok zamlčal, že išlo len o návrh.",
              "uk": "Стаття замовчала, що йшлося лише про пропозицію."
            }
          ],
          "shortRule": "vytrhnutý (ч.) · vytrhnutá (ж.) · vytrhnuté (сер., мн.)",
          "commonMistakes": [
            {
              "mistake": "Ten veta bola vytrhnutý z kontextu.",
              "correct": "Tá veta bola vytrhnutá z kontextu."
            },
            {
              "mistake": "Je to lož, lebo každá veta je pravdivá.",
              "correct": "Každá veta je pravdivá, a predsa je to polopravda."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Логічні пастки",
          "text": "«Falošná dilema» — хибна дилема: вдають, що є лише два варіанти («Nový tunel alebo večné zápchy»), хоча їх більше. «Prekrútiť» слова опонента (підмінити тезу): «Chcem menej áut v centre» → «Chce zakázať autá všetkým!». «Zovšeobecňovanie» — один випадок видають за правило. Нагадування з попередніх рівнів: «demagógia» — маніпулятивне, популістське мовлення. Як реагувати спокійно: «To je falošná dilema, existujú aj iné možnosti.», «To som nepovedal, prekrúcate moje slová.», «Jeden prípad ešte nie je pravidlo.»",
          "examples": [
            {
              "sk": "To je falošná dilema, možností je viac.",
              "uk": "Це хибна дилема, варіантів більше."
            },
            {
              "sk": "Prekrúcate moje slová.",
              "uk": "Ви перекручуєте мої слова."
            }
          ],
          "shortRule": "дві можливості? шукай третю · «ви кажете X» — чи справді він це сказав?",
          "button": "Далі →"
        }
      ],
