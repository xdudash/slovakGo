      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Волонтерство й громадянський сектор",
          "text": "«Dobrovoľníctvo» — добровільна праця на користь інших. Волонтери працюють у школах, лікарнях, притулках для тварин, допомагають біженцям чи літнім сусідам. Часто їх організовує «mimovládna organizácia» (неурядова організація, скорочено MVO) або «občianske združenie» (громадське об’єднання). Діяльність, корисну для суспільства, називають «verejnoprospešná činnosť». Гроші на добру справу збирає «verejná zbierka» — офіційно зареєстрована збірка. Розрізняй: «dobrovoľne» — з власної волі, «bezodplatne» — без оплати. Людина може працювати dobrovoľne, але отримувати невелику винагороду; тоді вона не працює bezodplatne.",
          "examples": [
            {
              "sk": "Pracuje bezodplatne v útulku pre zvieratá.",
              "uk": "Вона безоплатно працює в притулку для тварин."
            },
            {
              "sk": "Mimovládna organizácia zorganizovala verejnú zbierku.",
              "uk": "Неурядова організація провела публічну збірку."
            }
          ],
          "shortRule": "dobrovoľne — з власної волі · bezodplatne — без оплати",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як долучитися: angažovať sa, zapojiť sa",
          "text": "Участь описуємо дієсловами з різним керуванням: «angažovať sa v + місцевий» (angažuje sa v komunitnom centre), «zapojiť sa do + родовий» (zapojila sa do zbierky), «podieľať sa na + місцевий» (podieľa sa na projekte), «pomáhať + давальний» (pomáha seniorom). Плутати прийменники — типова помилка: «zapojiť sa na» чи «angažovať sa do» — неправильно. Про людину, яка вже долучилася, кажемо, що вона «aktívna v komunite».",
          "examples": [
            {
              "sk": "Zapojila sa do zbierky pre nemocnicu.",
              "uk": "Вона долучилася до збірки для лікарні."
            },
            {
              "sk": "Angažuje sa v miestnom občianskom združení.",
              "uk": "Він активний у місцевому громадському об’єднанні."
            }
          ],
          "shortRule": "angažovať sa v + місцевий · zapojiť sa do + родовий · podieľať sa na + місцевий",
          "commonMistakes": [
            {
              "mistake": "Zapojil sa na projekt.",
              "correct": "Zapojil sa do projektu."
            },
            {
              "mistake": "Angažuje sa do komunity.",
              "correct": "Angažuje sa v komunite."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Мета й заклик",
          "text": "Мету висловлюємо підрядним реченням з «aby» та l-формою: «Zbierame oblečenie, aby deti mali v zime teplé veci.» Якщо дієвець той самий, «aby» поєднується з особовою формою: «Prišla som, aby som pomohla.» Офіційніше звучить «s cieľom + інфінітив»: «Projekt vznikol s cieľom podporiť osamelých seniorov.» Заклик до волонтерства (výzva) містить: що робимо, для кого, коли й як долучитися. Він запрошує, а не тисне: «Pridajte sa k nám!», «Uvítame každú pomoc.» Чесний заклик не обіцяє більше, ніж може дати, і не соромить тих, хто не долучився.",
          "examples": [
            {
              "sk": "Zbierame oblečenie, aby deti mali v zime teplé veci.",
              "uk": "Ми збираємо одяг, щоб діти мали взимку теплі речі."
            },
            {
              "sk": "Projekt vznikol s cieľom podporiť osamelých seniorov.",
              "uk": "Проєкт виник, щоб підтримати самотніх літніх людей."
            }
          ],
          "shortRule": "aby + l-форма · s cieľom + інфінітив · výzva: що, для кого, коли, як",
          "commonMistakes": [
            {
              "mistake": "Prišla som, aby som pomôžem.",
              "correct": "Prišla som, aby som pomohla."
            }
          ],
          "button": "Далі →"
        }
