      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Конкуренти й ринок",
          "text": "«Konkurencia» — суперництво між фірмами, а також усі конкуренти разом: «V meste je veľká konkurencia.» Окрема фірма-суперник — «konkurent» (про фірму можна й «konkurenčná firma»). Частка ринку — «podiel na trhu»: «Náš podiel na trhu je malý, ale rastie.» «Konkurencieschopný» — здатний конкурувати: «Naše ceny sú konkurencieschopné.» Ділова мова не принижує конкурентів, а спокійно аналізує їх: що пропонують, за скільки, кому, де вони сильніші й де слабші.",
          "examples": [
            {
              "sk": "V našom meste je veľká konkurencia.",
              "uk": "У нашому місті велика конкуренція."
            },
            {
              "sk": "Náš podiel na trhu pomaly rastie.",
              "uk": "Наша частка ринку повільно зростає."
            }
          ],
          "shortRule": "konkurencia (усі разом) · konkurent (один) · podiel na trhu",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Перевага й як вирізнитися",
          "text": "«Konkurenčná výhoda» — те, що фірма робить краще за інших і що клієнт цінує: ціна, якість, швидкість, розташування, сервіс, мова спілкування. Вирізнитися — «odlíšiť sa od + родовий»: «Chceme sa odlíšiť od konkurencie rýchlosťou.» — а чим саме, кажемо орудним відмінком. Протиставлення: «Na rozdiel od konkurentov ponúkame…» (na rozdiel od + родовий), «Kým konkurenti…, my…». Перевага має бути конкретною: не «sme najlepší», а «opravu urobíme do 24 hodín».",
          "examples": [
            {
              "sk": "Na rozdiel od konkurencie ponúkame servis aj v ukrajinčine.",
              "uk": "На відміну від конкурентів ми пропонуємо обслуговування й українською."
            },
            {
              "sk": "Chceme sa odlíšiť kvalitou, nie cenou.",
              "uk": "Хочемо вирізнятися якістю, а не ціною."
            }
          ],
          "shortRule": "odlíšiť sa od + родовий · čím? — орудний · na rozdiel od + родовий",
          "commonMistakes": [
            {
              "mistake": "Na rozdiel od konkurenti ponúkame…",
              "correct": "Na rozdiel od konkurentov ponúkame…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порівняння й чесна конкуренція",
          "text": "Аргументуємо порівнянням: «lacnejší než / ako», «o 10 % lacnejší» (на скільки — «o»), «čím…, tým…» — чим…, тим…: «Čím väčšia konkurencia, tým nižšie ceny.» Цінова війна («cenová vojna») — коли фірми знижують ціни одна за одною, аж поки не страждають усі. Конкуренція має бути чесною: копіювання чужої марки, неправдиві твердження про конкурента чи таємна домовленість конкурентів про ціни закон обмежує або забороняє; за дотриманням правил стежить Protimonopolný úrad, а подробиці залежать від чинного законодавства.",
          "examples": [
            {
              "sk": "Čím väčšia konkurencia, tým nižšie ceny.",
              "uk": "Чим більша конкуренція, тим нижчі ціни."
            },
            {
              "sk": "Naša firma je o 10 % lacnejšia než konkurenti.",
              "uk": "Наша фірма на 10 % дешевша за конкурентів."
            }
          ],
          "shortRule": "čím…, tým… · o + число + вищий ступінь",
          "button": "Далі →"
        }
      ],
