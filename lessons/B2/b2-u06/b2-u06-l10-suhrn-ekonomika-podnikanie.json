      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Форма підприємства й гроші",
          "text": "Повторимо шлях підприємця. Почати можна як SZČO «na základe živnostenského oprávnenia», а коли бізнес росте чи потрібна обмежена відповідальність — заснувати s. r. o. (spoločníci, konateľ, základné imanie, запис в obchodnom registri). Перед стартом пишемо podnikateľský plán: cieľová skupina, analýza trhu, počiatočný kapitál, bod zvratu. Далі — щоденні гроші: «vystaviť faktúru», «základ dane + DPH», облік і документи для бухгалтера. Розрізняй «obrat» (усі надходження від продажу), «zisk» (що залишається після витрат) і «ziskovosť» (наскільки бізнес прибутковий щодо обігу чи вкладень): великий обіг ще не означає прибутку.",
          "examples": [
            {
              "sk": "Obrat rastie, ale ziskovosť klesá.",
              "uk": "Обіг росте, а прибутковість знижується."
            },
            {
              "sk": "Podnikám ako SZČO, no zvažujem založenie s. r. o.",
              "uk": "Я працюю як SZČO, але розглядаю заснування s. r. o."
            }
          ],
          "shortRule": "SZČO → s. r. o. · plán → faktúra → účtovníctvo · obrat × zisk × ziskovosť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ринок: клієнти, маркетинг, конкуренція, ціни",
          "text": "Фірма живе з клієнтів. Маркетинг: «cieliť na…», «osloviť…», «reklamná kampaň», мета з числом «zvýšiť o…». Клієнти: «udržať si stálych zákazníkov», «splniť očakávania», відповідь на скаргу «Mrzí nás, že… Ospravedlňujeme sa… Ako kompenzáciu…». Конкуренція: «odlíšiť sa od konkurencie», «na rozdiel od…», «konkurenčná výhoda», «čím…, tým…». Інфляція: «miera inflácie», «reálna mzda», ввічливе «Z dôvodu… sme nútení upraviť cenník». Про результати фірми загалом кажемо «hospodárenie» — господарювання, а про розвиток, який можна підтримувати довго, — «udržateľný rast».",
          "examples": [
            {
              "sk": "Na rozdiel od konkurencie si udržíme stálych zákazníkov kvalitou.",
              "uk": "На відміну від конкурентів ми втримаємо постійних клієнтів якістю."
            },
            {
              "sk": "Konateľ informoval spoločníkov o hospodárení firmy.",
              "uk": "Konateľ поінформував спільників про результати господарювання фірми."
            }
          ],
          "shortRule": "cieliť na · odlíšiť sa od · na rozdiel od · z dôvodu + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Аргументація в бізнесі",
          "text": "На рівні B2 ти не лише називаєш факти, а аргументуєш: теза — причина — доказ — висновок. «Navrhujeme…, pretože…», «Na základe analýzy trhu…», «Na jednej strane…, na druhej strane…», «Z toho vyplýva, že…». Прогнози — обережно: «predpokladáme», «podľa odhadu», умовний спосіб. Цифри — з джерелом і датою. Тон — діловий: без образ конкурентів і без обіцянок «garantovane». Найчастіші граматичні пастки блоку: «na základe + родовий», «v mene + родовий», «ručiť + орудний», «splatná do + родовий», «zvýšiť o (на скільки)», «z dôvodu + родовий».",
          "examples": [
            {
              "sk": "Z toho vyplýva, že sa nám oplatí investovať do marketingu.",
              "uk": "Із цього випливає, що нам варто інвестувати в маркетинг."
            },
            {
              "sk": "Na jednej strane rastú náklady, na druhej strane rastie aj dopyt.",
              "uk": "З одного боку, ростуть витрати, з іншого — зростає й попит."
            }
          ],
          "shortRule": "teza → dôvod → dôkaz → záver",
          "commonMistakes": [
