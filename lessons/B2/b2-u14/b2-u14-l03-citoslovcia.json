      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке citoslovce",
          "text": "«Citoslovce» — вигук: слово, яке не називає предмет чи дію, а прямо передає емоцію, звук або звернення. Воно не змінюється й стоїть здебільшого на початку речення, відокремлене комою: «Jaj, zabudol som doma kartu.» Словацькі вигуки діляться на три групи. Перша — емоційні: «au», «jaj», «fuj», «fíha», «ejha», «bŕ», «hm», «ach». Друга — вигуки звернення й наказу: «hej», «pst», «nože», «haló». Третя — звуконаслідувальні: «buch», «cvak», «šmik», «haf», «mňau». Вигук можна вимовити з різною довжиною й інтонацією, і від цього змінюється сила емоції: «Jaaaj!» сильніше за «Jaj».",
          "examples": [
            {
              "sk": "Jaj, to som nechcel.",
              "uk": "Ой, я цього не хотів."
            },
            {
              "sk": "Pst, dieťa už spí.",
              "uk": "Тсс, дитина вже спить."
            }
          ],
          "shortRule": "вигук не змінюється · стоїть на початку · після нього кома",
          "commonMistakes": [
            {
              "mistake": "Jaj to som nechcel.",
              "correct": "Jaj, to som nechcel."
            },
            {
              "mistake": "Fuj! Žiadam Vás o vydanie potvrdenia.",
              "correct": "Žiadam Vás o vydanie potvrdenia."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Найчастіші вигуки емоцій",
          "text": "«Au» — раптовий біль: «Au, to bolelo.» «Jaj» (або «joj») — ширше: біль, жаль, переляк, досада: «Jaj, zmeškal som bus.» «Fuj» — огида, здебільшого про запах, смак або вигляд: «Fuj, to mlieko je skysnuté.» «Fíha» й «ejha» — приємне або нейтральне здивування: «Fíha, to je rýchly stroj.» «Bŕ» — холод або неприємний дотик: «Bŕ, tá voda je ľadová.» «Hm» — вагання, роздуми, стримана незгода: коли на питання «Zvládneme tú normu?» чуєш «Hm…», відповідь радше ні, ніж так. «Ach» і «och» звучать книжніше й трохи театрально.",
          "examples": [
            {
              "sk": "Fíha, to ste stihli naozaj rýchlo.",
              "uk": "Ого, ви справилися справді швидко."
            },
            {
              "sk": "Bŕ, tá voda v sprche je ľadová.",
              "uk": "Бр, та вода в душі крижана."
            }
          ],
          "shortRule": "au — біль · jaj — жаль і досада · fuj — огида · fíha, ejha — здивування · bŕ — холод · hm — вагання",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де вигуки доречні",
          "text": "Вигуки — ознака живої розмови й неформального письма: чат, повідомлення друзям, розмова з колегами. В офіційному тексті (заява, скарга, трудовий договір, лист до установи) вигуків немає зовсім: такий текст має бути «vecný», тобто діловий і без емоцій. У робочому e-mailі всередині колективу поодинокий вигук можливий, якщо тон у фірмі невимушений, але в листі назовні — ні. Окремо тримайся подалі від вигуків, які походять від релігійних чи грубих слів: «Ježišmária» звучить сильно, а грубі вигуки на роботі сприймають як нечемність. Слово «no» формально теж вигук, але частіше працює як частка — про це наступний урок.",
          "examples": [
            {
              "sk": "V správe pre kamaráta napíšem Jaj, prepáč, zabudol som.",
              "uk": "У повідомленні другові напишу «Ой, вибач, я забув»."
            },
            {
              "sk": "V žiadosti napíšem Ospravedlňujem sa za svoju chybu.",
              "uk": "У заяві напишу «Прошу вибачення за свою помилку»."
            }
          ],
          "shortRule": "чат і розмова — так · заява й офіційний лист — ні",
          "button": "Далі →"
        }
      ],
