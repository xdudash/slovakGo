      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Швидке мовлення",
          "text": "У швидкій розмові частину слів опускають або скорочують, але зміст зрозумілий з контексту. «Dorobím to do večera.» = Доробляю до вечора. «Nebabri sa s tým.» = Не копайся з цим. Ці дієслова розмовні, в офіційному тексті їх замінюють нейтральними.",
          "examples": [
            {
              "sk": "Dorobím to do večera.",
              "uk": "Доробляю до вечора."
            },
            {
              "sk": "Nebabri sa s tým.",
              "uk": "Не копайся з цим."
            }
          ],
          "shortRule": "dorobiť · babrať sa",
          "commonMistakes": [
            {
              "mistake": "Dorobím to do večera, ale neviem kedy.",
              "correct": "Dorobím to do večera. (без зайвого)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Швидкі формули",
          "text": "«Šup!» означає «швидко, мерщій!»: «Šup na autobus!» = Швидко на автобус! «Nie je za čo» — «не варто подяки», відповідь на «ďakujem». Такі формули звучать природно в розмові, але не у звіті.",
          "examples": [
            {
              "sk": "Šup na autobus!",
              "uk": "Швидко на автобус!"
            },
            {
              "sk": "Nie je za čo.",
              "uk": "Не варто подяки."
            }
          ],
          "shortRule": "šup · nie je za čo",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коротко і зрозуміло",
          "text": "У розмові краще коротко й чітко. Якщо сумніваєшся, що співрозмовник зрозумів, скажи повніше. Швидкість не має бути на шкоду змісту.",
          "examples": [
            {
              "sk": "Môžeš to dorobiť do piatku?",
              "uk": "Можеш це доробити до п’ятниці?"
            }
          ],
          "shortRule": "коротко, але зрозуміло",
          "button": "Далі →"
        }
      ],
