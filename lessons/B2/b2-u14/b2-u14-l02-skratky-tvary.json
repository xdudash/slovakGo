      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Короткі привітання й прощання",
          "text": "«Ahoj» і «čau» працюють в обидві сторони: і при зустрічі, і при прощанні. «Nazdar» і «servus» — тільки привітання при зустрічі, радше між чоловіками й між добре знайомими; у магазині чи в лікаря вони звучать надто фамільярно. «Zdravím» — коротке привітання, яке можна сказати й людині, з якою ти на «Vy»: воно ввічливе, але неофіційне. Прощання: «dovi» — скорочення від «do videnia» (нормативно пишемо двома словами), «maj sa» — для одного знайомого, «majte sa» — для кількох або для «Vy», «pá» чи «papa» — дуже невимушено. «Zbohom» означає прощання назавжди, тому в побуті його не вживай.",
          "examples": [
            {
              "sk": "Zdravím, prišiel som na siedmu zmenu.",
              "uk": "Вітаю, я прийшов на сьому зміну."
            },
            {
              "sk": "Majte sa, pán Novák, dovidenia v piatok.",
              "uk": "Бувайте, пане Новак, до побачення в п’ятницю."
            }
          ],
          "shortRule": "ahoj, čau — туди й назад · nazdar, servus — лише при зустрічі · maj sa (ти) · majte sa (Vy)",
          "commonMistakes": [
            {
              "mistake": "Nazdar, pani doktorka.",
              "correct": "Dobrý deň, pani doktorka."
            },
            {
              "mistake": "Maj sa, pán riaditeľ.",
              "correct": "Majte sa, pán riaditeľ."
            },
            {
              "mistake": "Zbohom, zajtra sa vidíme.",
              "correct": "Dovi, zajtra sa vidíme."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Короткі подяки й ввічливість",
          "text": "Повна подяка — «ďakujem» або «ďakujem Vám». Розмовні короткі форми: «vďaka», «dík», жартівливе «dikec». «Dík» доречне серед знайомих і в чаті, але не в листі до установи. Відповідь на подяку: «nemáš za čo» (ти), «nemáte za čo» (Vy), розмовно просто «pohoda» або «v pohode». У чаті часто пишуть «nz» — скорочення від «nemáš za čo». Прохання: «prosím» нейтральне, а «poprosím» — м’яка розмовна форма, типова при замовленні: «Jedno kapučíno poprosím.» Вибачення: «prepáčte» нейтральне й офіційне, «pardon» розмовне й швидке, «sorry» — молодіжне й у роботі небажане.",
          "examples": [
            {
              "sk": "Dík, že si mi to podržal.",
              "uk": "Дяка, що ти мені це потримав."
            },
            {
              "sk": "Nemáte za čo, bola to maličkosť.",
              "uk": "Нема за що, то була дрібниця."
            }
          ],
          "shortRule": "ďakujem → vďaka → dík → dikec · nemáš za čo (ти) · nemáte za čo (Vy)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Скорочені слова",
          "text": "Розмовна словацька любить обрізати довгі слова: «informácia» → «info», «fotografia» → «foto», «mobilný telefón» → «mobil», «propagácia» → «promo», «autobus» → «bus», «profesor» → «profák» (студентське). Такі форми здебільшого незмінні: «poslal mi info», «dve foto». У писемному тексті вони доречні в чаті й у внутрішньому робочому повідомленні, але не в заяві. Окремо стоять письмові скорочення, які читають повністю: «atď.» читаємо «a tak ďalej», «napr.» — «napríklad», «tzv.» — «takzvaný», «č.» — «číslo». Їх можна писати й в офіційному тексті, але вимовляти скорочено не можна.",
          "examples": [
            {
              "sk": "Poslal mi info o zmene zmeny.",
              "uk": "Він надіслав мені інфо про зміну графіка."
            },
            {
              "sk": "V zmluve je napr. aj lehota výpovede.",
              "uk": "У договорі є, напр., і термін звільнення."
            }
          ],
          "shortRule": "info, foto, mobil — розмовні обрізані слова · atď., napr., tzv. — письмові скорочення, читаються повністю",
          "button": "Далі →"
        }
      ],
