      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сленг у розмові",
          "text": "Молодь у Словаччині часто вживає «chalan» — хлопець, пацан, «kámoš» — друг, кореш, «frajer» — хлопець або коханий, «apka» — застосунок (скорочення від aplikácia). Ці слова звучать природно в розмові з ровесниками.",
          "examples": [
            {
              "sk": "Ten chalan je v pohode.",
              "uk": "Цей хлопець нормальний."
            },
            {
              "sk": "Stiahol som si novú apku.",
              "uk": "Я завантажив новий застосунок."
            }
          ],
          "shortRule": "chalan · kámoš · frajer · apka",
          "commonMistakes": [
            {
              "mistake": "Stiahol som si novú aplikáciu, ale to je slang.",
              "correct": "Stiahol som si novú aplikáciu. (у тексті — повна форма)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Де сленг недоречний",
          "text": "Сленг не вживають у роботі, на співбесіді, в листах і звітах. «Moja frajerka je tu» у розмові з друзями звучить нормально, але на нараді це слово не годиться. Завжди орієнтуйся на адресата.",
          "examples": [
            {
              "sk": "Kámoš mi pomohol s prácou.",
              "uk": "Друг допоміг мені з роботою."
            },
            {
              "sk": "Stiahol som si apku, nech to už funguje.",
              "uk": "Я завантажив застосунок, нехай вже працює."
            }
          ],
          "shortRule": "розмова з друзями · не на роботі",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Один сленг — кілька значень",
          "text": "Слово «chalan» у розмові означає і хлопця, і просто людину: «Ten chalan je fajn» — цей хлопець добрий. Значення залежить від контексту, а не від самого слова.",
          "examples": [
            {
              "sk": "Ten chalan je fajn.",
              "uk": "Цей хлопець гарний."
            },
            {
              "sk": "Ten chalan pracuje v sklade.",
              "uk": "Цей хлопець працює на складі."
            }
          ],
          "shortRule": "контекст визначає значення",
          "button": "Далі →"
        }
      ],
