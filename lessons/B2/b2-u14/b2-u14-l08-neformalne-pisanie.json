      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Коротко і природно",
          "text": "У sms і чаті пишуть коротко: «Hej, si tam?» = Гей, ти там? «Frflať» — бурчати, скаржитися. «Kecy» — дурниці, пусті балачки: «Stále len kecy.» = Тільки дурниці. Розмовна форма без зайвих слів — норма.",
          "examples": [
            {
              "sk": "Hej, si tam?",
              "uk": "Гей, ти там?"
            },
            {
              "sk": "Stále len kecy.",
              "uk": "Тільки дурниці."
            }
          ],
          "shortRule": "hej · frflať · kecy",
          "commonMistakes": [
            {
              "mistake": "Hej, prosím ťa, pošli mi to.",
              "correct": "Prosím ťa, pošli mi to. (у листі «hej» не потрібен)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пунктуація й емоція",
          "text": "У чаті можна опустити частину знаків, але не змінювати слова. Емоцію передають самі слова: «Nefrflaj.» = Не бурчи. «Hej!» = Гей! Це різні ситуації: перша — прохання, друга — привернення уваги.",
          "examples": [
            {
              "sk": "Nefrflaj, je to fajn.",
              "uk": "Не бурчи, все добре."
            }
          ],
          "shortRule": "емоція в словах",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли неформальне недоречне",
          "text": "Sms-стиль не годиться в офіційних текстах, листах до державних установ, у звітах. Навіть з колегою на роботі краще писати повні речення, якщо це не швидке питання.",
          "examples": [
            {
              "sk": "Dobrý deň, posielam dokument, ďakujem.",
