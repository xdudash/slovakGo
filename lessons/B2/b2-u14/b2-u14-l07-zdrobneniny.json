      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Зменшення і ставлення",
          "text": "Zdrobnenina (зменшувально-пестливе слово) додає тепло або зменшує розмір: «kniha» — «knižka» (книжечка, книжка), «chlapec» — «chlapček» (хлопчик, хлопчинка), «káva» — «kávička» (кавичка, кава в затишній обстановці). Суфікси -ička, -ček, -ík часто вказують на ставлення мовця.",
          "examples": [
            {
              "sk": "Čítam knižku.",
              "uk": "Я читаю книжку."
            },
            {
              "sk": "Dám si kávičku?",
              "uk": "Може, випʼємо кави?"
            }
          ],
          "shortRule": "-ička · -ček · -ík → тепло",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Коли зменшення звучить природно",
          "text": "Пестливі слова вживають у розмові з дітьми, родиною, друзями. «Bytík» — маленька квартира, часто з гумором або любов’ю. У ділових текстах такі слова недоречні, бо вони здаються неофіційними.",
          "examples": [
            {
              "sk": "Kúpili sme si malý bytík.",
              "uk": "Ми купили маленьку квартиру."
            },
            {
              "sk": "Chlapček sa smial.",
              "uk": "Хлопчик сміявся."
            }
          ],
          "shortRule": "розмова · не офіційний текст",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ставлення і тон",
          "text": "Зменшення може звучати пестливо або знижено: «chlapček» може бути ніжним, а «chlapík» — у розмові звичайне «хлопець». Тон визначає ситуація.",
          "examples": [
            {
              "sk": "Chlapček to zvládne.",
              "uk": "Хлопчик з цим упорається."
            },
            {
              "sk": "Chlapík je v pohode.",
              "uk": "Хлопець нормальний."
            }
          ],
          "shortRule": "тон залежить від ситуації",
