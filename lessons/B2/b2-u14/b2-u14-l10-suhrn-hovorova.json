      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Рівні мови",
          "text": "Словацька має спільну мову (spisovná), розмовну (hovorová) і сленг. У документах і звітах — спільна, у розмові з друзями — розмовна, у чаті — неформальна. Вибір залежить від адресата й ситуації.",
          "examples": [
            {
              "sk": "Ďakujem za pomoc.",
              "uk": "Дякую за допомогу."
            },
            {
              "sk": "Dík, pomohol si.",
              "uk": "Дякую, ти допоміг."
            }
          ],
          "shortRule": "spisovná · hovorová · slang",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Частки, вигуки, скорочення",
          "text": "Частки «veď», «nó», «nejako» передають ставлення. Вигуки «jaj», «fuj», «ejha» виражають емоцію. Скорочення й швидкі форми — розмовні, але зрозумілі з контексту.",
          "examples": [
            {
              "sk": "Nó, skúsim to.",
              "uk": "Ну, спробую."
            },
            {
              "sk": "Jaj, to je super!",
              "uk": "Ой, це чудово!"
            }
          ],
          "shortRule": "частка · вигук · скорочення",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Сленг, пестливі слова, швидка мова",
          "text": "Сленг «chalan», «kámoš» і зменшувальні «knižka», «kávička» звучать тепло в розмові. Швидкі формули «dorobiť», «šup», «nie je za čo» — теж розмовні. У листах і звітах усе це замінюють нейтральними словами.",
          "examples": [
            {
              "sk": "Kámoš mi pomohol.",
              "uk": "Кореш мені допоміг."
            },
            {
              "sk": "Dám si kávičku.",
              "uk": "Вип’ю кавичку."
            }
          ],
          "shortRule": "розмова · не звіт",
          "button": "Далі →"
        }
