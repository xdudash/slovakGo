      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Частки й ставлення",
          "text": "Частки передають ставлення, а не зміст. «Veď si to vedel!» — Ти ж це знав! (нагадування, трохи докору). «Predsa to funguje!» — Все ж таки працює! (несподіванка). «Veď» і «predsa» часто стоять після першого слова або на початку речення.",
          "examples": [
            {
              "sk": "Veď si to vedel!",
              "uk": "Ти ж це знав!"
            },
            {
              "sk": "Predsa to funguje!",
              "uk": "Все ж таки працює!"
            }
          ],
          "shortRule": "veď → нагадування · predsa → несподіванка",
          "commonMistakes": [
            {
              "mistake": "Predsa je to dobre, ale to je všetko.",
              "correct": "(у звіті частки не потрібні: Je to dobré.)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відповіді",
          "text": "«Nó» — неохоча згода: «Nó, skúsim to.» = Ну, спробую. «Jasné» — звісно: «Jasné, pomôžem.» = Звісно, допоможу. «Nejako to zvládneme.» = Якось упораємося. Ці слова звучать у розмові природно.",
          "examples": [
            {
              "sk": "Nó, skúsim to.",
              "uk": "Ну, спробую."
            },
            {
              "sk": "Jasné, pomôžem.",
              "uk": "Звісно, допоможу."
            }
          ],
          "shortRule": "nó → неохоче · jasné → звісно",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Офіційний стиль",
          "text": "У листах і звітах частки «veď», «nó» не вживають. Для звіту пиши нейтрально: «Pomôžem.» замість «Nó, jasné, pomôžem.» Частки залишаємо для розмови з колегами або друзями.",
          "examples": [
            {
              "sk": "Pomôžem s prípravou.",
              "uk": "Допоможу з підготовкою."
            }
          ],
          "shortRule": "розмова · не лист",
          "button": "Далі →"
        }
      ],
