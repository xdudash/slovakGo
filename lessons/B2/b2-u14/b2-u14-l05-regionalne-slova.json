      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Нарічча і спільна мова",
          "text": "У Словаччині діалекти відрізняються від спісовної мови (spisovná slovenčina) у лексиці й вимові. Спільна мова — стандарт для документів і шкіл. Регіональні слова живуть у розмові, в селах, на полонинах, у кухні.",
          "examples": [
            {
              "sk": "Na salaši nás pohostil bača.",
              "uk": "На полонині нас пригостив бача."
            },
            {
              "sk": "Dal som si hrianku s paradajkami.",
              "uk": "Я з’їв грінку з помідорами."
            }
          ],
          "shortRule": "spisovná slovenčina → стандарт · regionálne → розмова",
          "commonMistakes": [
            {
              "mistake": "Podpíšte žiadosť, pán bača.",
              "correct": "Podpíšte žiadosť, pán riaditeľ. (бача — не для офіційного листа)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Страви й традиції",
          "text": "Слова «šúľance» (картопляні галушки з маком чи сиром) і «hrianka» (грінка з начинкою) — назви страв, які ми знаходимо в меню. Тут регіональне слово цінне, бо описує конкретну страву, яку інакше не назвеш.",
          "examples": [
            {
              "sk": "Dám si šúľance s makom.",
              "uk": "Замовлю галушки з маком."
            },
            {
              "sk": "Hrianka s bryndzou je dobrá.",
              "uk": "Грінка з бринзою смачна."
            }
          ],
          "shortRule": "страва · назва · контекст",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Гостинність",
          "text": "«Pohostinnosť» — гостинність, одна з рис словацької культури: гостей пригощають і не відпускають голодними. Це слово вживають у розмові й у текстах про культуру, тому воно нейтральне.",
          "examples": [
            {
              "sk": "Pohostinnosť je v našej rodine samozrejmosť.",
              "uk": "Гостинність у нашій родині — річ сама собою зрозуміла."
            }
          ],
          "shortRule": "pohostinnosť → гостинність",
          "button": "Далі →"
        }
