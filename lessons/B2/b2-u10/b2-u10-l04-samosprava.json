      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Два рівні самоврядування",
          "text": "Поряд із державою працює самоврядування (územná samospráva) — громади самі вирішують місцеві справи. Перший рівень — громада (obec) або місто (mesto). Громаду очолює староста (starosta, starostka), місто — примар (primátor, primátorka). Рішення ухвалюють депутатські збори: «obecné zastupiteľstvo» або «mestské zastupiteľstvo». Другий рівень — самоврядний край (samosprávny kraj, офіційно також «vyšší územný celok», VÚC). У Словаччині їх вісім. Край очолює голова (predseda samosprávneho kraja, у розмові — «župan»), рішення ухвалюють збори краю («zastupiteľstvo kraja»). Усіх обирають жителі на комунальних і регіональних виборах.",
          "examples": [
            {
              "sk": "Starostu obce volia obyvatelia v komunálnych voľbách.",
              "uk": "Старосту громади обирають жителі на комунальних виборах."
            },
            {
              "sk": "Slovensko má osem samosprávnych krajov.",
              "uk": "Словаччина має вісім самоврядних країв."
            }
          ],
          "shortRule": "obec → starosta · mesto → primátor · kraj → predseda (župan) · zastupiteľstvo = депутатські збори",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що вирішує громада й край",
          "text": "Громада дбає про те, що бачимо щодня: вивезення відходів, місцеві дороги й тротуари, освітлення, парки, дитячі садки й основні школи як засновник (zriaďovateľ). Свої правила громада ухвалює у формі «všeobecne záväzné nariadenie» (VZN) — загальнообов’язкова постанова, наприклад про місцевий податок, плату за відходи чи нічну тишу. Край відповідає за середні школи, регіональні дороги, приміські автобуси й частину соціальних послуг. Засідання (zasadnutie) зборів публічні: будь-хто може прийти, а жителі можуть і виступити. Багато міст мають партисипативний бюджет (participatívny rozpočet): жителі самі пропонують і обирають проєкти.",
          "examples": [
            {
              "sk": "Mestské zastupiteľstvo schválilo nové VZN o nočnom pokoji.",
              "uk": "Міські збори ухвалили нову постанову про нічну тишу."
            },
            {
              "sk": "Stredné školy patria do pôsobnosti kraja.",
              "uk": "Середні школи належать до компетенції краю."
            }
          ],
          "shortRule": "obec: odpad, chodníky, škôlky, VZN · kraj: stredné školy, regionálne cesty, autobusy",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Хто за що відповідає й як звертатися",
          "text": "Щоб сказати, хто відповідає за справу, використовуй: «patrí do pôsobnosti obce» (належить до компетенції громади, родовий), «má na starosti» (відповідає за), «o tom rozhoduje zastupiteľstvo». Звертаючись до представника самоврядування, використовуємо посаду: «Vážený pán starosta», «Vážená pani primátorka», «Vážená pani poslankyňa». Зверни увагу: у звертанні після «pán» і «pani» посада стоїть у називному: «pán starosta», а не «pane starosto». На засіданні просять слова формулою «Prosím o slovo». Якщо справа не належить громаді, тобі скажуть: «To nie je v našej kompetencii.»",
          "examples": [
            {
              "sk": "Oprava cesty druhej triedy patrí do pôsobnosti kraja.",
              "uk": "Ремонт дороги другого класу належить до компетенції краю."
            },
            {
              "sk": "Vážený pán starosta, obraciam sa na Vás vo veci osvetlenia.",
              "uk": "Шановний пане старосто, звертаюся до вас у справі освітлення."
            }
          ],
          "shortRule": "patrí do pôsobnosti + родовий · Vážený pán starosta (називний) · Prosím o slovo",
