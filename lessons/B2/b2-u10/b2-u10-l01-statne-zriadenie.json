      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Республіка й конституція",
          "text": "Словаччина — самостійна держава з 1. 1. 1993. Її основний закон — «Ústava Slovenskej republiky», яку парламент ухвалив 1. вересня 1992 року (тому 1. вересня — День Конституції). Перша стаття каже: «Slovenská republika je zvrchovaný, demokratický a právny štát.» — суверенна, демократична й правова держава. Друга стаття пояснює, звідки береться влада: «Štátna moc pochádza od občanov» — громадяни здійснюють її через обраних представників або безпосередньо (наприклад, на референдумі). Словаччина — парламентська республіка («parlamentná republika»): уряд відповідає перед парламентом, а президент як глава держави («hlava štátu») має насамперед представницькі й контрольні повноваження.",
          "examples": [
            {
              "sk": "Slovenská republika je zvrchovaný, demokratický a právny štát.",
              "uk": "Словацька Республіка — суверенна, демократична й правова держава."
            },
            {
              "sk": "Štátna moc pochádza od občanov.",
              "uk": "Державна влада походить від громадян."
            }
          ],
          "shortRule": "ústava = основний закон · parlamentná republika: vláda zodpovedá parlamentu · hlava štátu = prezident",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Поділ влади",
          "text": "Влада в демократичній державі поділена на три гілки, які контролюють одна одну — «deľba moci». Законодавча влада («zákonodarná moc») належить Národnej rade Slovenskej republiky: вона ухвалює закони й змінює конституцію. Виконавча влада («výkonná moc») — це уряд і президент: уряд керує державою щодня, міністерства виконують закони. Судова влада («súdna moc») — незалежні суди й Конституційний суд («Ústavný súd») у Кошицях, який перевіряє, чи відповідають закони конституції. Зверни увагу на рід: «moc» — жіночого роду: «zákonodarná moc», «moc je rozdelená».",
          "examples": [
            {
              "sk": "Moc v štáte je rozdelená na zákonodarnú, výkonnú a súdnu.",
              "uk": "Влада в державі поділена на законодавчу, виконавчу й судову."
            },
            {
              "sk": "Ústavný súd rozhoduje o súlade zákonov s ústavou.",
              "uk": "Конституційний суд вирішує, чи відповідають закони конституції."
            }
          ],
          "shortRule": "zákonodarná moc → NR SR · výkonná moc → vláda, prezident · súdna moc → súdy, Ústavný súd",
          "commonMistakes": [
            {
              "mistake": "Moc je rozdelený.",
              "correct": "Moc je rozdelená."
            },
            {
              "mistake": "Zákony prijímajú Národná rada.",
              "correct": "Zákony prijíma Národná rada."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як описувати інституції",
          "text": "Про державні органи говоримо нейтрально й безособово. Допомагають три конструкції. 1) Пасив «byť + дієприкметник»: «Prezident je volený občanmi» (ким? — орудний: občanmi). 2) Зворотний пасив із «sa»: «Zákony sa prijímajú v Národnej rade.» 3) Інверсія: присудок перед підметом, але дієслово узгоджується з підметом: «Zákony prijíma Národná rada» (ухвалює вона — однина). Корисні звороти: «na čele štátu stojí prezident» — на чолі держави стоїть президент; «X je zodpovedná Národnej rade» — підзвітна (давальний); «sídlo Ústavného súdu je v Košiciach».",
          "examples": [
            {
              "sk": "Prezident je volený občanmi na päť rokov.",
              "uk": "Президента обирають громадяни на п’ять років."
            },
            {
              "sk": "Zákony sa prijímajú v Národnej rade.",
              "uk": "Закони ухвалюються в Національній раді."
            }
          ],
          "shortRule": "byť + volený + орудний · sa prijímajú · prijíma Národná rada (однина)",
          "button": "Далі →"
        }
