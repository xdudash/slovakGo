      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Види виборів і право голосу",
          "text": "У Словаччині є кілька видів виборів: до Національної ради («voľby do Národnej rady», парламентські) — раз на чотири роки; президентські — раз на п’ять років; комунальні («komunálne voľby» — до органів громад і міст) і регіональні («voľby do orgánov samosprávnych krajov»). Право голосу (aktívne volebné právo) на парламентських і президентських виборах має громадянин Словаччини, якому в день виборів виповнилося 18 років. Важливо для іноземців: людина з постійним проживанням (trvalý pobyt) у громаді може голосувати на комунальних і регіональних виборах, навіть без словацького громадянства. Період між двома виборами — «volebné obdobie».",
          "examples": [
            {
              "sk": "Voľby do Národnej rady sa konajú každé štyri roky.",
              "uk": "Вибори до Національної ради проводяться кожні чотири роки."
            },
            {
              "sk": "Cudzinec s trvalým pobytom môže voliť v komunálnych voľbách.",
              "uk": "Іноземець із постійним проживанням може голосувати на комунальних виборах."
            }
          ],
          "shortRule": "voľby do + родовий · volebné obdobie · 18 rokov v deň volieb",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "На виборчій дільниці",
          "text": "Голосують у «volebná miestnosť» (виборча дільниця, приміщення для голосування). Виборець (volič) показує посвідчення особи комісії, отримує конверт (obálka) і бюлетені (hlasovacie lístky). Бюлетень заповнює в кабінці за ширмою (za plentou) — без цього кроку голос недійсний. На парламентських виборах виборець обирає бюлетень однієї партії і може обвести (zakrúžkovať) номери до чотирьох кандидатів — це «preferenčné hlasy»: вони можуть пересунути кандидата в списку вище. Бюлетень вкладає в конверт і вкидає в урну. Частку тих, хто проголосував, називають «volebná účasť».",
          "examples": [
            {
              "sk": "Volič zakrúžkoval na hlasovacom lístku dvoch kandidátov.",
              "uk": "Виборець обвів на бюлетені двох кандидатів."
            },
            {
              "sk": "Volebná účasť dosiahla šesťdesiat percent.",
              "uk": "Явка виборців досягла шістдесяти відсотків."
            }
          ],
          "shortRule": "občiansky preukaz → obálka → plenta → zakrúžkovať → urna",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Керування дієслів",
          "text": "Дієслово «voliť» має кілька конструкцій. Voliť (бути виборцем, голосувати) — без доповнення: «Idem voliť.» Voliť koho/čo — знахідний: «voliť stranu, kandidátku». Hlasovať za + знахідний / proti + давальний: «hlasovať za návrh», «hlasovať proti návrhu». Zvoliť koho za koho — обрати на посаду: «Zvolili ho za poslanca.» (за + знахідний). Voľby do čoho — родовий: «voľby do Národnej rady». Зверни увагу: «voľby» — лише множина: «voľby sa konajú», «po voľbách», «vo voľbách». Однина «voľba» означає «вибір» (slobodná voľba).",
          "examples": [
            {
              "sk": "Vo voľbách hlasovalo viac žien ako mužov.",
              "uk": "На виборах проголосувало більше жінок, ніж чоловіків."
            },
            {
              "sk": "Za poslankyňu ju zvolili prvýkrát.",
              "uk": "Депутаткою її обрали вперше."
            }
          ],
          "shortRule": "voliť stranu · hlasovať za + знах. / proti + дав. · zvoliť za + знах. · voľby — лише множина",
          "commonMistakes": [
