      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Формули звернення",
          "text": "Офіційне звернення починається з «Vážená pani» або «Vážený pán» з прізвищем, якщо відоме, потім кома і рядок. Далі йде мета листа: «Obraciam sa na Vás so žiadosťou o…». Завершення: «S pozdravom» і ім’я. Розмовні «Ahoj», «Čau», «Dúfam, že…» тут недоречні.",
          "examples": [
            {
              "sk": "Vážená pani Kováčová, obraciam sa na Vás so žiadosťou.",
              "uk": "Шановна пані Ковачова, звертаюся до Вас із проханням."
            },
            {
              "sk": "S pozdravom, Ihor Melnyk.",
              "uk": "З повагою, Ігор Мельник."
            }
          ],
          "shortRule": "Vážená pani / Vážený pán → S pozdravom",
          "commonMistakes": [
            {
              "mistake": "Ahoj, pani Kováčová, chcel by som niečo...",
              "correct": "Vážená pani Kováčová, obraciam sa na Vás so žiadosťou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Типові зворот",
          "text": "Офіційна мова будується на сталих зворотах: «v súlade s» (відповідно до), «na základe» (на підставі), «v lehote» (у строк), «zároveň» (водночас). Вони замінюють розмовні «podľa mňa» чи «hneď». Для прохання: «Žiadam o…», «Prosím o…». Для відповіді: «V odpovedi na Váš list…».",
          "examples": [
            {
              "sk": "V súlade so zákonom ju úrad posúdi.",
              "uk": "Відповідно до закону відомство її розгляне."
            },
            {
              "sk": "Na základe Vašej žiadosti vydávame rozhodnutie.",
              "uk": "На підставі Вашої заяви ми видаємо рішення."
            }
          ],
          "shortRule": "v súlade s + інстр. · na základe + род. · v lehote",
          "commonMistakes": [
            {
              "mistake": "Podľa zákona vám to posúdime.",
              "correct": "V súlade so zákonom to posúdime."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Структура заяви",
          "text": "Заява складається з: адресат, предмет («Vec: …»), виклад фактів, прохання, додатки, дата й підпис. Предмет пишуть коротко: «Vec: Žiadosť o predĺženie lehoty». Факти — хронологічно. Прохання формулюють чітко: «Žiadam o predĺženie lehoty o 30 dní.»",
          "examples": [
            {
              "sk": "Vec: Žiadosť o predĺženie lehoty.",
              "uk": "Предмет: Заява про продовження строку."
            }
          ],
          "shortRule": "Vec: → предмет · Žiadam o → прохання · Prílohy: → додатки",
          "button": "Далі →"
        }
      ],
