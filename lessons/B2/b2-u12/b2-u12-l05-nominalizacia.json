      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке номіналізація",
          "text": "Номіналізація — це коли дію виражає іменник: «rozhodnúť» → «rozhodnutie», «schváliť» → «schválenie», «zaviesť» → «zavedenie». Суфікси: -nie, -tie, -ie. Такі іменники дають безособовий, стислий стиль, типовий для законів і рішень.",
          "examples": [
            {
              "sk": "Schválenie zmluvy trvalo dlho.",
              "uk": "Затвердження договору тривало довго."
            },
            {
              "sk": "Zavedenie novej služby je plánované na jar.",
              "uk": "Запровадження нової послуги заплановане на весну."
            }
          ],
          "shortRule": "-nie / -tie / -ie → дія як предмет",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дія без суб’єкта",
          "text": "Номіналізація прибирає підмет: «Úrad schválil žiadosť» → «Schválenie žiadosti úradom bolo oznámené». Після іменника стоїть родовий відмінок: «podanie žiadosti», «vykonanie kontroly». Дієслово-присудок тоді «je», «bolo» або «prebehlo».",
          "examples": [
            {
              "sk": "Podanie žiadosti je bezplatné.",
              "uk": "Подання заяви безкоштовне."
            },
            {
              "sk": "Vykonanie kontroly bolo oznámené.",
              "uk": "Проведення перевірки було оголошено."
            }
          ],
          "shortRule": "podanie + род. · vykonanie + род. · bolo oznámené",
          "commonMistakes": [
            {
              "mistake": "Úrad vykonal kontrolu a oznámil výsledok.",
              "correct": "Vykonanie kontroly bolo oznámené s výsledkom. (тут не треба подвійної номіналізації)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли номіналізації забагато",
          "text": "Кілька іменників підряд роблять текст важким: «Vykonanie vyhodnotenia uskutočnenia zmien» важко читається. Правило: одне ключове номіналізоване слово на речення; решту виражай дієсловом. Таке речення краще: «Vyhodnotíme, ako sme zmeny zaviedli.»",
          "examples": [
            {
              "sk": "Zavedenie zmien je naplánované.",
              "uk": "Запровадження змін заплановане."
            },
            {
              "sk": "Vyhodnotíme zmeny.",
              "uk": "Ми оцінимо зміни."
            }
          ],
