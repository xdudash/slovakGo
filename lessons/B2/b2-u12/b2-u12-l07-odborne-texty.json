      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке фаховий текст",
          "text": "Фаховий текст (odborný text) має точні терміни, посилання на джерела, безособовий виклад і логічну структуру: úvod, metodika, výsledky, záver. Термін має одне значення: «metodika» — методика, «definícia» — визначення. Такі слова не замінюють синонімами, навіть якщо вони здаються простішими.",
          "examples": [
            {
              "sk": "Metodika výskumu bola schválená.",
              "uk": "Методику дослідження затвердили."
            },
            {
              "sk": "Definícia pojmu je v prvej kapitole.",
              "uk": "Визначення поняття подане в першому розділі."
            }
          ],
          "shortRule": "metodika → спосіб дослідження · definícia → визначення поняття",
          "commonMistakes": [
            {
              "mistake": "Metóda výskumu bola zlá.",
              "correct": "Metodika výskumu nebola vhodná pre túto skupinu (точна причина, а не оцінка)."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Безособовість і пасив",
          "text": "У фаховому тексті часто використовують безособовий стиль: «Bolo zistené, že…», «Údaje boli spracované», «Možno konštatovať…». Замість «ми встановили» пишуть «bolo zistené». Висновки формулюють через «zo získaných údajov vyplýva».",
          "examples": [
            {
              "sk": "Bolo zistené, že príjmy klesli.",
              "uk": "Було встановлено, що доходи знизилися."
            },
            {
              "sk": "Zo získaných údajov vyplýva, že záujem klesá.",
              "uk": "З отриманих даних випливає, що інтерес знижується."
            }
          ],
          "shortRule": "bolo zistené · boli spracované · zo získaných údajov vyplýva",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Точність і джерело",
          "text": "Цифри й твердження мають джерело: «podľa štatistického úradu» (за даними статистичного управління) і рік. Уникай «veľa», «asi», «takmer». Пиши «približne 30 %» або «v roku 2024».",
          "examples": [
            {
              "sk": "Podľa štatistického úradu klesla nezamestnanosť na 5 %.",
              "uk": "За даними статистичного управління безробіття знизилося до 5 %."
            },
            {
              "sk": "Pojem označuje výsledok merania.",
              "uk": "Поняття позначає результат вимірювання."
            }
          ],
          "shortRule": "podľa + род. · približne · v roku + місц.",
          "button": "Далі →"
        }
      ],
