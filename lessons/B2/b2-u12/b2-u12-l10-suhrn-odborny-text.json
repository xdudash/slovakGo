      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Стиснення й номіналізація",
          "text": "Дієприкметник стискає підрядне речення: «dokumenty, ktoré boli doručené» → «doručené dokumenty». Номіналізація перетворює дію на іменник: «rozhodnúť» → «rozhodnutie», «schváliť» → «schválenie». Одна ключова номіналізація на речення — норма, більше — важко читати.",
          "examples": [
            {
              "sk": "Doručené dokumenty budú prerokované.",
              "uk": "Доставлені документи розглянуть."
            },
            {
              "sk": "Schválenie zmluvy bolo oznámené.",
              "uk": "Затвердження договору оголосили."
            }
          ],
          "shortRule": "príčastie · -nie/-tie/-ie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Фаховий і офіційний текст",
          "text": "Фаховий текст — точні терміни, безособовий пасив і посилання на джерело: «Bolo zistené, že…», «Podľa štatistického úradu…». Офіційний лист починає «Vážená pani» і закінчує «S pozdravom», а предмет пишуть коротко після «Vec:».",
          "examples": [
            {
              "sk": "Bolo zistené, že príjmy klesli.",
              "uk": "Було встановлено, що доходи знизилися."
            },
            {
              "sk": "Vec: Žiadosť o predĺženie lehoty.",
              "uk": "Предмет: заява про продовження строку."
            }
          ],
          "shortRule": "odborný text · úradný štýl",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Пасив, актив і стиль",
          "text": "Переписуючи речення, зберігай суб’єкт і зміст: «Úrad spracoval údaje.» ↔ «Údaje boli spracované úradom.» Обирай стиль і слова для адресата: нейтральне «úrad», а не «fakt», і формальне «Vážená pani», а не «Ahoj».",
          "examples": [
            {
              "sk": "Údaje boli spracované úradom.",
              "uk": "Дані опрацювало відомство."
            },
            {
              "sk": "Došlo k pochybeniu.",
              "uk": "Сталася помилка."
            }
