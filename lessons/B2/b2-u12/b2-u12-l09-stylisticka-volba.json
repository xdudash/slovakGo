      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Нейтральне і експресивне",
          "text": "Один факт можна подати нейтрально або експресивно: «Došlo k pochybeniu» (сталася помилка) і «Úrad zlyhal na plnej čiare» (відомство повністю провалилося). Офіційний текст потребує нейтральності: «Došlo k pochybeniu.» Експресивні слова потрібні в художньому тексті, а в звіті їх не вживають.",
          "examples": [
            {
              "sk": "Došlo k pochybeniu.",
              "uk": "Сталася помилка."
            },
            {
              "sk": "Úrad zlyhal na plnej čiare.",
              "uk": "Відомство повністю провалилося."
            }
          ],
          "shortRule": "нейтральний → офіційний · експресивний → художній",
          "commonMistakes": [
            {
              "mistake": "Úrad zlyhal na plnej čiare, to je škandál.",
              "correct": "Došlo k pochybeniu, ktoré úrad vyšetruje."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Синоніми й повтор",
          "text": "Повтор слова в тексті — хиба, якщо його можна замінити. Замість «úrad... úrad... úrad» пиши «orgán», «inštitúcia», «odbor». Але терміни в законах не замінюють: «zamestnávateľ» не пишуть як «šéf». Синонім повинен мати той самий зміст.",
          "examples": [
            {
              "sk": "Úrad vydal rozhodnutie. Inštitúcia ho zverejnila.",
              "uk": "Відомство видало рішення. Установа його оприлюднила."
            }
          ],
          "shortRule": "повтор → синонім, якщо зміст той самий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Рівень формальності",
          "text": "Словацька має три рівні: formálny (Vážená pani), neutrálny (Dobrý deň, pani) і neformálny (Ahoj). Не змішуй їх в одному тексті: «Vážená pani, fakt je to otrava» — це помилка. Визначай рівень за адресатом: керівник, урядовець, колега.",
          "examples": [
            {
              "sk": "Vážená pani, úrad sa k podnetu nevyjadril včas.",
              "uk": "Шановна пані, відомство не відреагувало на звернення вчасно."
            }
          ],
          "shortRule": "formálny · neutrálny · neformálny",
          "commonMistakes": [
