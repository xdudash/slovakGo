      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від активу до пасиву",
          "text": "Активне «Úrad spracoval údaje.» (відомство опрацювало дані) стає пасивним: «Údaje boli spracované úradom.» Об’єкт «údaje» стає підметом, суб’єкт «úrad» — орудним відмінком з «úradom». Допоміжне «boli» відповідає за час, а дієприкметник має рід і число об’єкта.",
          "examples": [
            {
              "sk": "Úrad spracoval údaje.",
              "uk": "Відомство опрацювало дані."
            },
            {
              "sk": "Údaje boli spracované úradom.",
              "uk": "Дані опрацювало відомство."
            }
          ],
          "shortRule": "активна форма → пасивна · суб’єкт → úradom",
          "commonMistakes": [
            {
              "mistake": "Údaje spracoval úradom.",
              "correct": "Údaje boli spracované úradom."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Від пасиву до активу",
          "text": "Пасивне «Plán bol schválený úradom.» переписують назад: «Úrad schválil plán.» Важливо: суб’єкт має бути названий або очевидний. Якщо суб’єкта немає, безособовий пасив залишають: «Plán bol schválený.»",
          "examples": [
            {
              "sk": "Plán bol schválený úradom.",
              "uk": "План затвердило відомство."
            },
            {
              "sk": "Úrad schválil plán.",
              "uk": "Відомство затвердило план."
            }
          ],
          "shortRule": "bol schválený → schválil",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли зміст змінюється",
          "text": "Не всі перетворення рівнозначні. Якщо в активі суб’єкт важливий, а в пасиві зникає, зміст змінюється. «Úrad pochybil» і «Došlo k pochybeniu» різні за відповідальністю: друге не називає винного. Перед поданням переконайся, що після перетворення ніхто не «загубився».",
          "examples": [
            {
              "sk": "Došlo k pochybeniu.",
              "uk": "Сталася помилка (без вказівки винного)."
            },
            {
              "sk": "Úrad pochybil.",
              "uk": "Відомство припустилося помилки."
            }
          ],
          "shortRule": "перевір суб’єкт · без суб’єкта — інший зміст",
          "commonMistakes": [
            {
              "mistake": "Úrad pochybil.",
              "correct": "Došlo k pochybeniu. (це змінює відповідальність, тож тільки свідомо)."
            }
          ],
          "button": "Далі →"
        }
      ],
