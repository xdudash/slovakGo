      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Частини дебат",
          "text": "Дебата — це організована дискусія за правилами. Її учасники — «rečník» (промовець): він виголошує основний виступ («vystúpenie») із заздалегідь підготовленою тезою. Після виступу інші можуть зреагувати «replikou» — короткою відповіддю, зазвичай на одну думку. Слово дає ведучий, а хто хоче говорити, «prihlási sa o slovo» (просить слова). Репліка — не нова промова: вона відповідає на сказане. Інша форма — «polemizovať» (сперечатися, вести полеміку), коли двоє по черзі відповідають одне одному аргументами.",
          "examples": [
            {
              "sk": "Prvý rečník otvoril debatu krátkym vystúpením.",
              "uk": "Перший промовець відкрив дебати коротким виступом."
            },
            {
              "sk": "Dovoľte mi zareagovať krátkou replikou.",
              "uk": "Дозвольте мені відреагувати короткою реплікою."
            }
          ],
          "shortRule": "vystúpenie → replika · prihlásiť sa o slovo",
          "commonMistakes": [
            {
              "mistake": "Prihlásim slovo.",
              "correct": "Prihlásim sa o slovo."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Згода й незгода",
          "text": "«Súhlasiť» — погоджуватися — вживаємо з орудним: «súhlasiť s kým» і з «v tom, že»: «Súhlasím s kolegom v tom, že termín je krátky.» Незгода: «Nesúhlasím s tým, že…» (з «s tým») — «Nesúhlasím s tým, že parkovanie má byť zadarmo.» Часткова згода: «V jednom s vami súhlasím, v druhom nie.» Ввічливі способи: «Mám iný názor.», «Dovolím si mať iný názor.» «Zhodovať sa» (збігатися): «V tomto sa s vami úplne zhodujem.» Частку незгоди часто ховають за ввічливим визнанням — слухай, що йде після «ale».",
          "examples": [
            {
              "sk": "Súhlasím s vami v tom, že treba konať.",
              "uk": "Погоджуюся з вами в тому, що треба діяти."
            },
            {
              "sk": "Nesúhlasím s tým, že je to zbytočné.",
              "uk": "Не погоджуюся з тим, що це зайве."
            }
          ],
          "shortRule": "súhlasiť s kým v čom · nesúhlasiť s tým, že…",
          "commonMistakes": [
            {
              "mistake": "Súhlasím vás.",
              "correct": "Súhlasím s vami."
            },
            {
              "mistake": "Nesúhlasím s to, že…",
              "correct": "Nesúhlasím s tým, že…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Репліка, полеміка, формули",
          "text": "Щоб зреагувати, кажуть: «Dovoľte mi zareagovať.» або «Dovoľte, aby som zareagoval.» (говорить чоловік; жінка — zareagovala). Просьба про слово: «Dovoľte mi prihlásiť sa o slovo.» Після «polemizovať» — «s kým» (орудний) і «o čom» (місцевий): «polemizovať s kolegom o rozpočte». Гарна репліка: перша фраза називає, на що ти реагуєш, друга — твоя відповідь. Неприйнятно перебивати, переходити на особисте й відходити від теми — у наступному уроці це ведучий має право зупинити.",
          "examples": [
            {
              "sk": "Nechcem polemizovať s kolegom o osobných veciach.",
              "uk": "Не хочу сперечатися з колегою про особисте."
            },
            {
              "sk": "Dovoľte, aby som zareagoval na posledný argument.",
              "uk": "Дозвольте мені відреагувати на останній аргумент."
            }
          ],
          "shortRule": "polemizovať s kým o čom",
          "commonMistakes": [
            {
              "mistake": "Polemizujem kolegu o rozpočet.",
              "correct": "Polemizujem s kolegom o rozpočte."
            }
          ],
          "button": "Далі →"
        }
      ],
