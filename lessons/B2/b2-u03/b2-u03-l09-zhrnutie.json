      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Підсумок, а не переказ",
          "text": "Підсумок (zhrnutie) — це не стислий переказ усього, що було сказано, а виділена головна думка та два-три ключові пункти. Вибудовуй його так: головна думка → ключові пункти → висновок чи рекомендація. Головна думка — «hlavná myšlienka», суть — «podstata»: «Hlavná myšlienka je jednoduchá: treba konať včas.» «Podstatou problému je nedostatok času.» Цей другий варіант — з орудним відмінком — типовіший для писемної мови, але обидві форми існують. Не перераховуй усіх у порядку виступів.",
          "examples": [
            {
              "sk": "Hlavná myšlienka diskusie je jednoduchá: treba konať včas.",
              "uk": "Головна думка дискусії проста: треба діяти вчасно."
            },
            {
              "sk": "Podstatou problému je nedostatok času.",
              "uk": "Суть проблеми — брак часу."
            }
          ],
          "shortRule": "hlavná myšlienka → kľúčové body → záver",
          "commonMistakes": [
            {
              "mistake": "Najprv hovoril jeden, potom druhý, potom tretí…",
              "correct": "Hlavná myšlienka diskusie je…"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Сигнали підсумку",
          "text": "Слухач має почути, що починається підсумок. Формули: «V skratke:» (коротко), «Stručne povedané,…» (коротко кажучи; після нього — кома), «Inými slovami,…» (іншими словами — перефразовує вже сказане), «Dovoľte mi rekapitulovať:…» (дозвольте підсумувати; «rekapitulovať» — повторити головне). Наприкінці — «ponaučenie» (висновок, урок, з якого можна навчитися): «Ponaučenie je jasné: treba začať skôr.» Різниця: «inými slovami» не додає нового, а «stručne povedané» скорочує.",
          "examples": [
            {
              "sk": "Stručne povedané, projekt je potrebný, ale nemá financovanie.",
              "uk": "Коротко кажучи, проєкт потрібен, але не має фінансування."
            },
            {
              "sk": "Inými slovami, nestíhame.",
              "uk": "Іншими словами, ми не встигаємо."
            }
          ],
          "shortRule": "stručne povedané = скорочую · inými slovami = перефразовую",
          "commonMistakes": [
            {
              "mistake": "Stručne povedať, projekt je potrebný.",
              "correct": "Stručne povedané, projekt je potrebný."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Підсумок чужих позицій",
          "text": "Підсумовуючи дискусію, показуй, у чому учасники згодні, а в чому ні. «Zhodnúť sa» — дійти згоди: «Zhodli sa na tom, že treba konať.» (zhodnúť sa na čom — місцевий). «Líšiť sa» — відрізнятися: «Líšia sa v názoroch na financovanie.» (líšiť sa v čom — місцевий). Нейтральні дієслова для чужих позицій: «tvrdí», «zdôraznila», «navrhuje». Підсумок не оцінює й не додає власної думки, якщо ти не маєш такої ролі; для оцінки є окрема фраза: «Podľa môjho názoru…».",
          "examples": [
            {
              "sk": "Panelisti sa zhodli na tom, že treba viac bytov.",
              "uk": "Панелісти дійшли згоди, що потрібно більше квартир."
            },
            {
              "sk": "Líšia sa v názoroch na financovanie.",
              "uk": "Вони розходяться в поглядах на фінансування."
            }
          ],
          "shortRule": "zhodnúť sa na čom · líšiť sa v čom",
          "commonMistakes": [
            {
              "mistake": "Zhodli sa o tom, že treba konať.",
              "correct": "Zhodli sa na tom, že treba konať."
            },
            {
              "mistake": "Líšia sa na názoroch.",
              "correct": "Líšia sa v názoroch."
            }
          ],
          "button": "Далі →"
        }
      ],
