      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Причина",
          "text": "«Pretože» — бо, універсальний сполучник причини; «lebo» — розмовніша форма, добра у відповіді на «чому»: «Prečo nejdeš?» — «Lebo nemám čas.» Для письма й офіційного стилю кращі «pretože» і «keďže». Іменникова причина — «v dôsledku» + родовий (внаслідок): «V dôsledku choroby sa porada presúva.» «Kvôli» + родовий — через (зазвичай негативне): «Kvôli zápche som meškal.» «Vďaka» + давальний — завдяки (позитивне).",
          "examples": [
            {
              "sk": "V dôsledku opravy je ulica zatvorená.",
              "uk": "Унаслідок ремонту вулиця закрита."
            },
            {
              "sk": "Neprišiel, lebo bol chorý.",
              "uk": "Він не прийшов, бо хворів."
            }
          ],
          "shortRule": "v dôsledku + родовий · lebo — розмовне, pretože — універсальне",
          "commonMistakes": [
            {
              "mistake": "V dôsledku choroba sa porada presúva.",
              "correct": "V dôsledku choroby sa porada presúva."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Наслідок",
          "text": "«Preto» — тому: називає наслідок певної причини: «Prší, preto berieme dáždniky.» «Teda» — отже: логічний висновок з посилок: «Nikto neprišiel, teda porada sa nekoná.» «Takže» — отже, ну (розмовне). «Tým pádom» — відтак, тим самим (логічний ланцюжок): «Cena stúpla, tým pádom sa znížil dopyt.» Обережно: «následne» означає «потім, у подальшому», а не «тому»: «Podali sme žiadosť a následne sme čakali na odpoveď.» У середині речення «teda» стоїть на другому місці: «Máme teda dve možnosti.»",
          "examples": [
            {
              "sk": "Cena stúpla, tým pádom sa znížil dopyt.",
              "uk": "Ціна зросла, відтак попит знизився."
            },
            {
              "sk": "Podali sme žiadosť a následne sme čakali.",
              "uk": "Ми подали заяву й потім чекали."
            }
          ],
          "shortRule": "preto / teda / tým pádom = висновок · následne = потім",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čiže і pokiaľ ide o",
          "text": "«Čiže» — тобто, іншими словами: перефразовує сказане: «Pracujeme na dve zmeny, čiže ráno a poobede.» «Pokiaľ ide o» + знахідний — що стосується: «Pokiaľ ide o cenu, ponuka je výhodná.» Відмінок після «o» — знахідний: «o cenu», «o termín». Це формула, що вводить нову тему, тому після теми ставимо кому. Родовий із «čo sa týka» — теж можливий: «Čo sa týka ceny…», але після «pokiaľ ide o» — знахідний.",
          "examples": [
            {
              "sk": "Pokiaľ ide o termín, ešte nie je jasný.",
              "uk": "Що стосується терміну, він ще не ясний."
            },
            {
              "sk": "Zmena trvá osem hodín, čiže od šiestej do štrnástej.",
              "uk": "Зміна триває вісім годин, тобто з шостої до чотирнадцятої."
            }
          ],
          "shortRule": "pokiaľ ide o + знахідний · čiže = тобто",
          "commonMistakes": [
            {
              "mistake": "Pokiaľ ide ceny, ponuka je výhodná.",
              "correct": "Pokiaľ ide o cenu, ponuka je výhodná."
            }
          ],
          "button": "Далі →"
        }
      ],
