      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Шлях до визнання",
          "text": "Спершу збирають документи: диплом, výpis známok і overený preklad. Потім подають заяву: для університетського диплома — žiadosť o nostrifikáciu, для професійної кваліфікації — žiadosť o uznanie odbornej kvalifikácie. Після цього відомство оцінює документи й видає рішення. Важливо: засвідчений переклад (overený preklad) часто вимагають окремо, і без нього заява зупиняється.",
          "examples": [
            {
              "sk": "Žiadam o nostrifikáciu diplomu.",
              "uk": "Прошу про нострифікацію диплома."
            },
            {
              "sk": "Potrebujem overený preklad.",
              "uk": "Мені потрібен засвідчений переклад."
            }
          ],
          "shortRule": "žiadať o + знах. · overený preklad · rozhodnutie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Навчання й оцінювання",
          "text": "Вища школа присуджує ступені (bakalár, magister, PhD.), а навчальне навантаження рахує в кредитах: зазвичай 60 за рік. Оцінку ставлять за шкалою від A до FX, де FX означає неприйняття без кредитів. Стипендію й докторантуру отримують за документами й у встановлені строки. Скаргу формулюють спокійно й конкретно.",
          "examples": [
            {
              "sk": "Mám dva kredity navyše.",
              "uk": "У мене два зайвих кредити."
            },
            {
              "sk": "Podal som žiadosť o štipendium.",
              "uk": "Я подав заяву на стипендію."
            }
          ],
          "shortRule": "podať žiadosť o + знах. · kredit · FX (bez kreditov)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Академічна і кар’єрна мова",
          "text": "Говори про доброчесність і кар’єру конкретно. Визнаючи помилку, назви її й одразу запропонуй виправлення: «Priznávam chybu a hneď ju opravím.» Про відповідальність і посаду кажи точно: «Mám na starosti tím piatich ľudí.» «Uchádzam sa o vedúcu pozíciu.»",
          "examples": [
            {
              "sk": "Priznávam chybu a hneď ju opravím.",
              "uk": "Визнаю помилку і одразу її виправлю."
            },
            {
              "sk": "Mám na starosti tím piatich ľudí.",
              "uk": "Я відповідаю за команду з п’яти людей."
            }
          ],
          "shortRule": "priznať chybu · navrhnúť riešenie · mať na starosti + знах.",
          "button": "Далі →"
        }
