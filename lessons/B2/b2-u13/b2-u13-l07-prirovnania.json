      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Будова порівняння",
          "text": "Порівняння в словацькій мові будують через «ako»: «tichý ako myška» — тихий, як мишка; «hladný ako vlk» — голодний, як вовк; «chytrý ako líška» — хитрий і кмітливий, як лисиця. Прикметник узгоджується з іменником, а після «ako» стоїть той самий відмінок, що й перед ним: «je tichý ako myška», «je hladná ako vlčica».",
          "examples": [
            {
              "sk": "Je tichý ako myška.",
              "uk": "Він тихий, як мишка."
            },
            {
              "sk": "Je hladný ako vlk.",
              "uk": "Він голодний, як вовк."
            }
          ],
          "shortRule": "ako + назва образу · прикметник узгоджується",
          "commonMistakes": [
            {
              "mistake": "Je hladný ako vlka.",
              "correct": "Je hladný ako vlk."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чужий образ і український відповідник",
          "text": "Порівняння часто не збігаються з українськими. «Tvrdý ako kameň» — твердий, як камінь, і це однаково. «Chytrý ako líška» — у нас «хитрий, як лисиця». Але «hladný ako vlk» у нас «голодний, як вовк», тому тут образ збігається. Перевіряй, чи порівняння звучить природно саме словацькою.",
          "examples": [
            {
              "sk": "Je tvrdý ako kameň.",
              "uk": "Він твердий, як камінь."
            },
            {
              "sk": "Je chytrý ako líška.",
              "uk": "Він хитрий, як лисиця."
            }
          ],
          "shortRule": "образ збігається або ні",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ako keby — порівняння, що не є фактом",
          "text": "Конструкція «ako keby» означає «наче б, ніби». Вона передає уявне: «Tvári sa, ako keby nič nevedel.» — Він робить вигляд, ніби нічого не знає. Тут порівняння не про характер, а про поведінку.",
          "examples": [
            {
              "sk": "Tvári sa, ako keby nič nevedel.",
              "uk": "Він робить вигляд, ніби нічого не знає."
            },
            {
              "sk": "Hovorí ako keby bol šéf.",
              "uk": "Говорить так, ніби він начальник."
            }
          ],
          "shortRule": "ako keby → ніби",
          "button": "Далі →"
        }
      ],
