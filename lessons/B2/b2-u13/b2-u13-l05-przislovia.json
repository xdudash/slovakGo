      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке прислів’я",
          "text": "Прислів’я (príslovie) — це коротке речення з узагальненням: завжди має загальну думку, яку застосовують до конкретної ситуації. Словацькі прислів’я часто дуже схожі на українські за змістом: «Bez práce nie sú koláče» відповідає «без праці не виловиш і рибку з ставка». Найчастіше їх вживають, щоб підтримати або дати пораду.",
          "examples": [
            {
              "sk": "Bez práce nie sú koláče.",
              "uk": "Без праці не буде колачів (без праці нічого не вийде)."
            },
            {
              "sk": "Lepšie neskoro ako nikdy.",
              "uk": "Краще пізно, ніж ніколи."
            }
          ],
          "shortRule": "príslovie → загальна думка",
          "commonMistakes": [
            {
              "mistake": "Bez práce sú koláče.",
              "correct": "Bez práce nie sú koláče."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вибір і порівняння",
          "text": "«Lepší vrabec v hrsti ako holub na streche» — краще синиця в руках, ніж журавель у небі. Прислів’я порівнює два варіанти: «vrabec» (синиця) і «holub» (голуб). Так само «čo oči nevidia, to srdce nebolí» — «з очей — з серця»: якщо не бачиш проблеми, не переживаєш.",
          "examples": [
            {
              "sk": "Lepší vrabec v hrsti ako holub na streche.",
              "uk": "Краще синиця в руках, ніж журавель у небі."
            },
            {
              "sk": "Čo oči nevidia, to srdce nebolí.",
              "uk": "З очей — з серця."
            }
          ],
          "shortRule": "vrabec v hrsti · holub na streche",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Коли прислів’я доречне",
          "text": "Прислів’я звучить природно в розмові, в порадах і підтримці, але не в офіційному звіті. Не вживай його, якщо співрозмовник може його не розуміти або сприймати як поучення. Найкраще — коротка фраза: «Lepšie neskoro ako nikdy, skús to.»",
          "examples": [
            {
              "sk": "Lepšie neskoro ako nikdy, skús to.",
              "uk": "Краще пізно, ніж ніколи, спробуй."
            }
          ],
