      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Повний еквівалент",
          "text": "Іноді образ збігається: «ísť ako po masle» — іти як по маслу; «Bez práce nie sú koláče» — без праці не виловиш і рибку з ставка. Такий відповідник можна вживати без пояснень, бо і значення, і образ однакові.",
          "examples": [
            {
              "sk": "Ísť ako po masle.",
              "uk": "Іти як по маслу."
            },
            {
              "sk": "Bez práce nie sú koláče.",
              "uk": "Без праці не виловиш і рибку з ставка."
            }
          ],
          "shortRule": "повний еквівалент → той самий образ",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Частковий еквівалент",
          "text": "Частіше образ змінюється, а значення близьке: «zelený od závisti» — позеленіти від заздрості (близько), «čierna ovca» — паршива вівця (близько, але «чорна» тут не обов’язково). «Tvrdý oriešok» — твердий горішок, це збіг. Частковий відповідник годиться, якщо значення точне.",
          "examples": [
            {
              "sk": "Je zelený od závisti.",
              "uk": "Він позеленів від заздрості."
            },
            {
              "sk": "Je čierna ovca rodiny.",
              "uk": "Він паршива вівця родини."
            }
          ],
          "shortRule": "частковий → близьке значення",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Описовий переклад",
          "text": "Коли відповідника немає, пояснюємо: «navariť niekomu kašu» — «наробити комусь клопоту». «Medové týždne» — «перші тижні після весілля, медовий місяць». Описовий переклад довший, зате точний.",
          "examples": [
            {
              "sk": "Navarili nám kašu.",
              "uk": "Наробили нам клопоту."
            },
            {
              "sk": "Mali medové týždne.",
              "uk": "Вони провели медовий місяць."
            }
          ],
          "shortRule": "немає відповідника → опис",
          "button": "Далі →"
        }
      ],
