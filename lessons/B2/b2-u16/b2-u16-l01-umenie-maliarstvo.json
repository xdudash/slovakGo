      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Види мистецтва",
          "text": "Словацька має стійкі слова для видів мистецтва: «maľba» — живопис, «kresba» — малюнок, «socha» — скульптура, «fotografia» — фотографія. Людина, яка створює картини, — «maliar»; автор скульптури — «sochár». Саме слово «umenie» означає мистецтво загалом, а «umelec» — митець.",
          "examples": [
            {
              "sk": "Maľba je staršie umenie ako fotografia.",
              "uk": "Живопис старіший за фотографію."
            },
            {
              "sk": "Sochár pracuje s kameňom.",
              "uk": "Скульптор працює з каменем."
            }
          ],
          "shortRule": "maľba · kresba · socha",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Опис картини",
          "text": "Щоб описати картину, спершу називають сюжет, потім колір, композицію й враження: «Obraz zobrazuje more.» = На картині зображено море. «Farby sú tmavé a chladné.» = Кольори темні й холодні. Для опису місця на полотні використовують «v strede» (посередині), «vľavo» (ліворуч), «vpravo» (праворуч).",
          "examples": [
            {
              "sk": "Obraz zobrazuje more v noci.",
              "uk": "На картині зображено море вночі."
            },
            {
              "sk": "Vľavo je loď.",
              "uk": "Ліворуч човен."
            }
          ],
          "shortRule": "zobrazovať · v strede · vľavo",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Враження від твору",
          "text": "Щоб висловити враження, вживають «páči sa mi» (мені подобається) і «zaujal ma» (мене зацікавив). Щоб пояснити причину, додають «lebo» або «pretože»: «Páči sa mi, lebo je jemný.» = Мені подобається, бо він ніжний. Негативне враження — «nezaujal ma» (не зацікавив).",
          "examples": [
            {
              "sk": "Páči sa mi tá výstava.",
              "uk": "Мені подобається та виставка."
            },
            {
              "sk": "Zaujal ma detail v rohu.",
              "uk": "Мене зацікавила деталь у кутку."
            }
          ],
          "shortRule": "páči sa mi · zaujal ma",
