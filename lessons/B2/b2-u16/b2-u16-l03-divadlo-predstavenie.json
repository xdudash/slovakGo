      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто що робить у театрі",
          "text": "У театрі працюють herec (актор), režisér (режисер), scénograf (сценограф), kostýmy (костюми). «Premiéra» — перша вистава, «predstavenie» — будь-яка вистава. Глагол «hrať» означає «грати»: «Herec hrá hlavnú rolu.» = Актор грає головну роль.",
          "examples": [
            {
              "sk": "Premiéra bola v piatok.",
              "uk": "Прем’єра була в п’ятницю."
            },
            {
              "sk": "Režisér vybral herca.",
              "uk": "Режисер обрав актора."
            }
          ],
          "shortRule": "herec · režisér · premiéra",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Опис вистави",
          "text": "Щоб описати виставу, говорять про сцену, світло й дію: «Scéna je jednoduchá.» = Сцена проста. «Svetlo je veľmi silné.» = Світло дуже сильне. Оцінка гри: «Herec hral presvedčivo.» = Актор грав переконливо.",
          "examples": [
            {
              "sk": "Scéna bola jednoduchá, ale účinná.",
              "uk": "Сцена була простою, але ефективною."
            },
            {
              "sk": "Herec hral presvedčivo.",
              "uk": "Актор грав переконливо."
            }
          ],
          "shortRule": "scéna · svetlo · presvedčivo",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Враження й критика",
          "text": "Для позитивної оцінки кажуть «bolo to výborné» (було чудово), для критичної — «niečo mi chýbalo» (мені чогось бракувало). Таку думку варто подати м’яко: «Myslím, že…» (Я думаю, що…).",
          "examples": [
            {
              "sk": "Myslím, že režisér mal dobrý nápad.",
              "uk": "Я думаю, що режисер мав гарну ідею."
