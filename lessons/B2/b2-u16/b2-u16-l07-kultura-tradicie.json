      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Традиції й свята",
          "text": "«Tradícia» — традиція, «zvyk» — звичай, «slávnosť» — свято, «oslava» — святкування. «Ľudový» означає народний: «ľudová pieseň» — народна пісня, «ľudový kroj» — народний костюм.",
          "examples": [
            {
              "sk": "Fašiangy sú tradičná slávnosť.",
              "uk": "Фашанги — традиційне свято."
            },
            {
              "sk": "Ľudová hudba je veselá.",
              "uk": "Народна музика весела."
            }
          ],
          "shortRule": "tradícia · zvyk · ľudový",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Опис звичаю",
          "text": "Звичай пояснюють через «zvykne sa» (заведено): «Na Veľkú noc sa zvykne maľovať vajíčka.» = На Великдень заведено розмальовувати яйця. Порівняння виражають «rovnako ako» (так само як) і «na rozdiel od» (на відміну від).",
          "examples": [
            {
              "sk": "Na Veľkú noc sa zvykne maľovať vajíčka.",
              "uk": "На Великдень заведено розмальовувати яйця."
            },
            {
              "sk": "Na rozdiel od nás je to iné.",
              "uk": "На відміну від нас це інакше."
            }
          ],
          "shortRule": "zvykne sa · na rozdiel od",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порівняння культур",
          "text": "Щоб порівняти традиції, кажуть: «U nás je to…» (у нас це…) і «U vás…» (у вас…). Слово «podobný» означає схожий: «Sú si podobné.» = Вони схожі.",
          "examples": [
            {
              "sk": "U nás sa oslava začína ráno.",
              "uk": "У нас свято починається вранці."
            },
            {
              "sk": "Naše tradície sú si podobné.",
              "uk": "Наші традиції схожі."
            }
          ],
          "shortRule": "podobný · u nás",
          "commonMistakes": [
            {
              "mistake": "Na Veľkú noc sa maľuje vajíčka.",
