      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Symbol, motív, metafora",
          "text": "«Symbol» — символ, «motív» — мотив (повторюваний образ), «metafora» — метафора. Symbol має стале значення в культурі: голуб — мир. Motív повторюється в творі. Metafora переносить значення: «Srdce kameňa» — кам’яне серце.",
          "examples": [
            {
              "sk": "Biela farba je symbolom čistoty.",
              "uk": "Білий колір — символ чистоти."
            },
            {
              "sk": "Motív cesty sa opakuje v knihe.",
              "uk": "Мотив дороги повторюється в книжці."
            }
          ],
          "shortRule": "symbol · motív · metafora",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Інтерпретація й факт",
          "text": "Факт — те, що видно: «Obraz má modré pozadie.» = На картині синій фон. Інтерпретація — припущення про значення: «Modrá môže znamenať smútok.» = Синій може означати смуток. Обережні слова: «možno» (можливо), «pravdepodobne» (імовірно), «zdá sa, že» (здається, що).",
          "examples": [
            {
              "sk": "Modrá môže znamenať smútok.",
              "uk": "Синій може означати смуток."
            },
            {
              "sk": "Pravdepodobne ide o samotu.",
              "uk": "Імовірно, це про самотність."
            }
          ],
          "shortRule": "možno · pravdepodobne · zdá sa, že",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Пояснення значення",
          "text": "Щоб пояснити значення, використовують «znamená to» (це означає) і «zdá sa mi, že» (мені здається, що): «Zdá sa mi, že dom je symbolom domova.» = Мені здається, що дім — символ дому.",
          "examples": [
            {
              "sk": "Znamená to, že hrdina stratil nádej.",
              "uk": "Це означає, що герой втратив надію."
            },
            {
              "sk": "Zdá sa mi, že dážď je symbolom smútku.",
              "uk": "Мені здається, що дощ — символ смутку."
            }
          ],
          "shortRule": "znamená to · zdá sa mi, že",
          "commonMistakes": [
            {
              "mistake": "Modrá je smútok, to je isté.",
              "correct": "Modrá môže znamenať smútok."
            },
            {
              "mistake": "Symbol je to, čo je v knihe.",
              "correct": "Symbol je znak so stálym významom."
            }
          ],
          "button": "Далі →"
        }
