      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ніс і п’ята",
          "text": "Strčiť nos do cudzích vecí (сунути ніс у чужі справи) — втручатися без потреби. Byť na päte (бути на п’ятах) — бути дуже близько до когось або чогось. «Nestrkaj nos do cudzích vecí.» = Не суй ніс у чужі справи.",
          "examples": [
            {
              "sk": "Nestrkaj nos do cudzích vecí.",
              "uk": "Не суй ніс у чужі справи."
            },
            {
              "sk": "Je mi stále na päte.",
              "uk": "Він завжди на п’ятах у мене."
            }
          ],
          "shortRule": "nos · päta",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Палець і губи",
          "text": "Držať palce (тримати пальці) — побажати успіху. Mať niečo na perách (мати щось на губах) — пам’ятати і згадувати. «Držím ti palce.» = Тримаю за тебе пальці.",
          "examples": [
            {
              "sk": "Držím ti palce.",
              "uk": "Тримаю за тебе пальці."
            },
            {
              "sk": "Mám to na perách.",
              "uk": "Я це пам’ятаю і хочу сказати."
            }
          ],
          "shortRule": "palec · pery",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Значення і жест",
          "text": "Фразеологізм «držať palce» не означає буквально тримати пальці. Він передає підтримку. Тому такі вирази треба розуміти в переносному значенні.",
          "examples": [
            {
              "sk": "Držím ti palce, zvládneš to.",
              "uk": "Тримаю за тебе пальці, впораєшся."
            },
            {
              "sk": "Nestrkaj nos, nie je to tvoja vec.",
              "uk": "Не суй ніс, це не твоя справа."
            }
          ],
          "shortRule": "palec · nos",
