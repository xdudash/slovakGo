      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Кров і кістка",
          "text": "Krv nie je voda (кров не вода) — рідні люди не можуть бути байдужими одне до одного. Kosť sporu (кістка розбрату) — предмет суперечки. «Dedičstvo je kosť sporu.» = Спадщина — це кістка розбрату.",
          "examples": [
            {
              "sk": "Krv nie je voda.",
              "uk": "Кров не вода."
            },
            {
              "sk": "Dedičstvo je kosť sporu.",
              "uk": "Спадщина — кістка розбрату."
            }
          ],
          "shortRule": "krv · kosť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Уста і двері",
          "text": "Vziať slová z úst (вирвати слова з уст) — сказати те саме, що хотів сказати інший. Zavrieť dvere pred nosom (зачинити двері перед носом) — відмовити без пояснень. «Zavreli mi dvere pred nosom.» = Мені зачинили двері перед носом.",
          "examples": [
            {
              "sk": "Vzal mi slová z úst.",
              "uk": "Він сказав те, що я хотів."
            },
            {
              "sk": "Zavreli mi dvere pred nosom.",
              "uk": "Мені зачинили двері перед носом."
            }
          ],
          "shortRule": "ústa · dvere",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відкриті двері",
          "text": "Otvorené dvere (відкриті двері) — відкрите спілкування і готовність до діалогу. «Dvere sú pre vás otvorené.» = Двері для вас відкриті.",
          "examples": [
            {
              "sk": "Dvere sú pre vás otvorené.",
