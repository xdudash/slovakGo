      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що містить абстракт",
          "text": "Абстракт (abstrakt) передає зміст праці в кількох реченнях: мету, метод, результат, висновок. Його читають першим, тому він має бути самодостатнім.",
          "examples": [
            {
              "sk": "Cieľom diela je zistiť vplyv dopravy na kvalitu vzduchu.",
              "uk": "Метою дослідження є з’ясування впливу транспорту на якість повітря."
            },
            {
              "sk": "Výsledky ukazujú významný pokles.",
              "uk": "Результати показують суттєве зниження."
            }
          ],
          "shortRule": "abstrakt · cieľ",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Формули абстракта",
          "text": "Типові формули: «Cieľom práce je…» (Метою праці є…), «Metódou bola…» (Методом була…), «Výsledky ukazujú, že…» (Результати показують, що…). Вони задають стиль без зайвих слів.",
          "examples": [
            {
              "sk": "Metódou bola analýza dotazníkov.",
              "uk": "Методом був аналіз анкет."
            },
            {
              "sk": "Výsledky naznačujú možnú súvislosť.",
              "uk": "Результати вказують на можливий зв’язок."
            }
          ],
          "shortRule": "cieľ · metóda",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Уникати оцінок",
          "text": "В абстракті не пишуть «skvelý výsledok» (чудовий результат) чи «najlepšia metóda» (найкращий метод). Пишуть факти й межі: «Výsledky sú obmedzené na jednu oblasť.» = Результати обмежені однією областю.",
          "examples": [
            {
              "sk": "Výsledky sú obmedzené na jednu oblasť.",
              "uk": "Результати обмежені однією областю."
            },
            {
              "sk": "Skvelý výsledok potvrdil hypotézu.",
              "uk": "Чудовий результат підтвердив гіпотезу."
