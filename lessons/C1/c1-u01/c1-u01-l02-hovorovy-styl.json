      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Еліпса й неповні речення",
          "text": "У розмові часто пропускають слова, які зрозумілі з контексту: «Ideme? — Ideme.» = Ідемо? — Ідемо. Такий пропуск називають еліпсою. У писемному тексті його уникають, бо він залежить від ситуації.",
          "examples": [
            {
              "sk": "Kam ideš? — Do mesta.",
              "uk": "Куди йдеш? — До міста."
            },
            {
              "sk": "Zajtra? Možno.",
              "uk": "Завтра? Може."
            }
          ],
          "shortRule": "elipsa · kontext",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Частки й вигуки",
          "text": "Словацькі частки «veď», «však», «predsa», «hádam» передають ставлення мовця: «To je predsa jasné.» = Це ж очевидно. Вигуки «jaj», «no», «hm» виражають емоцію. Вони доречні в розмові, але не в офіційних документах.",
          "examples": [
            {
              "sk": "To je predsa jasné.",
              "uk": "Це ж очевидно."
            },
            {
              "sk": "Jaj, to je zlé.",
              "uk": "Ой, це погано."
            }
          ],
          "shortRule": "častica · citoslovcie",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Розмовні конструкції",
          "text": "Розмовні конструкції часто мають скорочену форму: «Nejako to zvládneme.» = Якось упораємось. «Idem len tak.» = Просто йду. Такі вислови звучать природно в розмові й недоречно в заяві.",
          "examples": [
            {
              "sk": "Nejako to zvládneme.",
              "uk": "Якось упораємось."
            },
            {
              "sk": "Idem len tak.",
              "uk": "Просто йду."
            }
          ],
          "shortRule": "dôraz · hovorové",
          "commonMistakes": [
            {
              "mistake": "Žiadosť: Jaj, prosím, dajte mi to.",
              "correct": "Žiadosť: Žiadam o vybavenie uvedenej veci."
            },
            {
              "mistake": "Veď je to jasné, však?",
              "correct": "Je to zrejmé."
            }
          ],
          "button": "Далі →"
        }
