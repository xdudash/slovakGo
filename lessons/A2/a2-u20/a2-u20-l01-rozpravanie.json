      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Začiatok príbehu",
          "text": "Розповідь зазвичай починають так: «Raz…» (одного разу), «Bolo to minulé leto.» (це було минулого літа), «Viete, čo sa mi stalo?» (знаєте, що зі мною сталося?). Співрозмовник підтримує: «Naozaj? A čo bolo potom?» Завершують словами «Nakoniec…» або «A tak…».",
          "examples": [
            {
              "sk": "Raz som v Bratislave stretla svoju učiteľku zo školy.",
              "uk": "Одного разу я зустріла в Братиславі свою шкільну вчительку."
            },
            {
              "sk": "Bolo to v zime, tesne pred Vianocami.",
              "uk": "Це було взимку, якраз перед Різдвом."
            }
          ],
          "shortRule": "Raz… · Bolo to… · A čo bolo potom?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Minulý čas: som, si — a bez nich",
          "text": "Минулий час: основа + -l, -la, -lo, -li. У 1-й і 2-й особі додаємо «som, si, sme, ste»: «išiel som», «bola si», «prišli sme». У 3-й особі допоміжного дієслова немає: «on prišiel», «ona zavolala», «oni odišli». Заперечення пишемо разом: «nebol som», «neprišla».",
          "examples": [
            {
              "sk": "Včera sme boli v kine.",
              "uk": "Учора ми були в кіно."
            },
            {
              "sk": "Brat prišiel neskoro.",
              "uk": "Брат прийшов пізно."
            }
          ],
          "shortRule": "1. a 2. osoba: som, si, sme, ste · 3. osoba: bez nich",
          "commonMistakes": [
            {
              "mistake": "Ona je prišla.",
              "correct": "Ona prišla."
            },
            {
              "mistake": "Oni sú odišli.",
              "correct": "Oni odišli."
            },
            {
              "mistake": "Ja išiel som.",
              "correct": "Ja som išiel."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pozadie a udalosti",
          "text": "В оповіді недоконаний вид описує фон і тривалі дії: «Pršalo, ľudia čakali na autobus.» Доконаний вид — події, що йдуть одна за одною: «Zrazu prišiel autobus, nastúpila som a sadla som si.» Так слухач розуміє, що відбувалося і що саме сталося.",
          "examples": [
            {
              "sk": "Sedel som v parku a čítal som.",
              "uk": "Я сидів у парку й читав."
            },
            {
              "sk": "Zrazu mi zazvonil telefón.",
              "uk": "Раптом у мене задзвонив телефон."
            }
          ],
          "shortRule": "nedokonavý — фон · dokonavý — подія",
          "button": "Далі →"
        }
      ],
