      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Už si niekedy…?",
          "text": "Про досвід питаємо: «Už si niekedy bol v Tatrách?» — Ти вже колись був у Татрах? Відповіді: «Áno, už som tam bol.» / «Áno, raz.» / «Áno, už niekoľkokrát.» (кілька разів) / «Nie, ešte nikdy.» / «Ešte nie, ale chcel by som.»",
          "examples": [
            {
              "sk": "Už ste niekedy jedli bryndzové halušky?",
              "uk": "Ви вже колись їли бринзові галушки?"
            },
            {
              "sk": "Áno, prvýkrát som ich jedla na Liptove.",
              "uk": "Так, уперше я їла їх на Ліптові."
            }
          ],
          "shortRule": "už niekedy? · áno, raz · ešte nikdy",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nikdy, nikto, nič + ne-",
          "text": "Як і в українській, «nikdy», «nikto», «nič» вимагають заперечного дієслова: «Nikdy som nebol na Bratislavskom hrade.» «Nikto mi to nepovedal.» Неправильно: «Nikdy som bol».",
          "examples": [
            {
              "sk": "Ešte nikdy som neletela lietadlom.",
              "uk": "Я ще ніколи не літала літаком."
            },
            {
              "sk": "Nikdy som nič také nevidel.",
              "uk": "Я ніколи нічого такого не бачив."
            }
          ],
          "shortRule": "nikdy / nikto / nič + ne-",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zážitok a dojem",
          "text": "«Zážitok» — пережите, враження від події: «nezabudnuteľný zážitok». «Dojem» — враження про когось чи щось: «Mám z neho dobrý dojem.» (z + родовий). Оцінки: «úžasný», «nezabudnuteľný». «Dobrodružstvo» — пригода з ризиком. «Vyskúšať» — спробувати щось нове.",
          "examples": [
            {
              "sk": "Splav Dunajca bol nezabudnuteľný zážitok.",
              "uk": "Сплав Дунайцем був незабутнім враженням."
            },
            {
              "sk": "Z nového šéfa mám dobrý dojem.",
              "uk": "Новий шеф справляє на мене добре враження."
            }
          ],
          "shortRule": "zážitok · dojem z + родовий",
          "commonMistakes": [
            {
