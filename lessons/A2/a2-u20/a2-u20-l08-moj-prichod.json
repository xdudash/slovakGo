      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kedy a prečo",
          "text": "«Na Slovensko som prišla v marci 2022.» — na + знахідний (Slovensko, як і Ukrajina, вживається з «na»). Звідки? — «z Ukrajiny, z Dnipra». Причини: «kvôli vojne» (через війну), «za prácou» (на роботу), «za rodinou» (до родини), «na štúdium».",
          "examples": [
            {
              "sk": "Prišli sme sem kvôli vojne.",
              "uk": "Ми приїхали сюди через війну."
            },
            {
              "sk": "Manžel tu už predtým pracoval, tak som prišla za ním.",
              "uk": "Чоловік уже раніше працював тут, тож я приїхала до нього."
            }
          ],
          "shortRule": "na Slovensko · z Ukrajiny · kvôli + давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Prvé dni",
          "text": "Перші дні: «Najprv sme bývali u známych.» «Nevedel som ani slovo po slovensky.» «Spočiatku bolo všetko cudzie.» Хто допоміг: «Pomohli nám susedia a dobrovoľníci.» «Začať od nuly» — почати з нуля.",
          "examples": [
            {
              "sk": "Spočiatku bolo všetko cudzie.",
              "uk": "Спочатку все було чужим."
            },
            {
              "sk": "Museli sme začať od nuly.",
              "uk": "Нам довелося почати з нуля."
            }
          ],
          "shortRule": "najprv · spočiatku · začať od nuly",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zvyknúť si",
          "text": "«Zvyknúť si na» + знахідний — звикнути до: «Zvykla som si na nový život.» «Ešte si neviem zvyknúť na…» — ніяк не можу звикнути до… «Domov» — дім, батьківщина: «Chýba mi domov.» Завершуємо: «Odvtedy…», «Dnes už…».",
          "examples": [
            {
              "sk": "Na slovenskú kuchyňu som si zvykol rýchlo.",
              "uk": "До словацької кухні я звик швидко."
            },
            {
              "sk": "Dnes už hovorím po slovensky dosť dobre.",
              "uk": "Сьогодні я вже говорю словацькою досить добре."
            }
          ],
          "shortRule": "zvyknúť si na + знахідний",
