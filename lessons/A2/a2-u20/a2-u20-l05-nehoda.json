      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo sa stalo?",
          "text": "Коротка розповідь про травму: «Pošmykol som sa na poľadovici a spadol som.» З частинами тіла словацька вживає «si»: «Zlomil som si ruku.» (зламав руку), «Udrela som si hlavu.» (ударилася головою). Лікар питає: «Ako sa to stalo?»",
          "examples": [
            {
              "sk": "Pošmykla som sa v kúpeľni a udrela som si koleno.",
              "uk": "Я посковзнулася у ванній і вдарила коліно."
            },
            {
              "sk": "Syn si zlomil nohu na tréningu.",
              "uk": "Син зламав ногу на тренуванні."
            }
          ],
          "shortRule": "zlomiť si / udrieť si + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dopravná nehoda",
          "text": "«Dopravná nehoda» — ДТП. «Zrážka» — зіткнення: «zrážka auta s autobusom». «Vodič» — водій, «chodec» — пішохід. Хто винен? — «Kto zavinil nehodu?» Номери: 112 (єдиний екстрений номер), 155 (záchranka — швидка допомога), 158 (polícia), 150 (hasiči). Машина швидкої — «sanitka».",
          "examples": [
            {
              "sk": "Vodič nezastavil na červenú a narazil do auta.",
              "uk": "Водій не зупинився на червоне й врізався в автомобіль."
            },
            {
              "sk": "Okamžite volajte 112!",
              "uk": "Негайно телефонуйте 112!"
            }
          ],
          "shortRule": "112 · 155 záchranka · 158 polícia",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Svedok a poisťovňa",
          "text": "«Svedok» — свідок: «Videli ste, čo sa stalo? Môžete byť svedkom?» Після аварії складають «záznam o nehode» і повідомляють «poisťovni» (страховій компанії): «nahlásiť poistnú udalosť» — повідомити про страховий випадок. Nahlásiť komu? — давальний: poisťovni.",
          "examples": [
            {
              "sk": "Nehodu som nahlásil poisťovni.",
              "uk": "Я повідомив про аварію страхову компанію."
            },
            {
              "sk": "Svedok videl, že auto išlo príliš rýchlo.",
              "uk": "Свідок бачив, що машина їхала надто швидко."
            }
          ],
          "shortRule": "svedok · nahlásiť poisťovni",
