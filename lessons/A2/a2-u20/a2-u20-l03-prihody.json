      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Stalo sa mi…",
          "text": "«Stať sa» — статися: «Stala sa mi zvláštna príhoda.» Кому? — давальний: mi, ti, mu, jej, nám. Дієслово узгоджуємо з тим, що сталося: «príhoda sa stala» (ж. р.), «čo sa stalo» (с. р.). «Príhoda» — випадок, коротка історія з життя.",
          "examples": [
            {
              "sk": "Včera sa mi stala vtipná príhoda.",
              "uk": "Учора зі мною стався кумедний випадок."
            },
            {
              "sk": "Čo sa ti stalo?",
              "uk": "Що з тобою сталося?"
            }
          ],
          "shortRule": "stalo sa mi / ti / mu / jej",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Šťastie a smola",
          "text": "«Mať šťastie» — пощастило: «Mal som šťastie.» «Mať smolu» — не пощастило: «Mala som smolu, autobus mi ušiel.» Реакції: «To je smola!» — Яка невдача! «To je ale náhoda!» — Оце так збіг! «Náhodou» — випадково: «Náhodou som stretol suseda z Charkova.»",
          "examples": [
            {
              "sk": "Mali sme smolu, pršalo celý týždeň.",
              "uk": "Нам не пощастило, дощ ішов цілий тиждень."
            },
            {
              "sk": "V obchode som náhodou stretla kamarátku.",
              "uk": "У магазині я випадково зустріла подругу."
            }
          ],
          "shortRule": "mať šťastie ↔ mať smolu · náhodou",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Trápne a zvláštne",
          "text": "Як оцінити пригоду: «trápny» — незручний, ніяковий: «Bola to trápna situácia.» «Zvláštny» — дивний: «Stalo sa mi niečo zvláštne.» «Vtipný» — кумедний. Співчутлива реакція: «To muselo byť trápne!» — Це, мабуть, було ніяково!",
          "examples": [
            {
              "sk": "Pomýlila som si dvere a vošla som do cudzieho bytu.",
              "uk": "Я переплутала двері й зайшла в чужу квартиру."
            },
            {
              "sk": "To je zvláštne!",
              "uk": "Це дивно!"
            }
          ],
