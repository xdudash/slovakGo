      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Svadba, deti, dôchodok",
          "text": "Чоловік «sa oženil» (одружився), жінка «sa vydala» (вийшла заміж), пара «sa zobrala» (побралися). З ким? — «oženiť sa s Ukrajinkou», «vydať sa za Slováka». «Narodila sa nám dcéra.» — у нас народилася донька. «Ísť do dôchodku» — вийти на пенсію.",
          "examples": [
            {
              "sk": "Brat sa oženil minulý rok.",
              "uk": "Брат одружився минулого року."
            },
            {
              "sk": "Mama išla do dôchodku na jar.",
              "uk": "Мама вийшла на пенсію навесні."
            }
          ],
          "shortRule": "oženiť sa s + орудний · vydať sa za + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Predtým a teraz",
          "text": "Порівнюємо: «Predtým som pracoval v kancelárii, teraz pracujem v sklade.» «Kedysi» — колись. «Už nie» — уже ні: «Už nefajčím.» «Stále» — досі: «Stále bývam v Prešove.» «Prestať» + недоконаний інфінітив — перестати: «Prestal som fajčiť.»",
          "examples": [
            {
              "sk": "Kedysi som veľa cestoval, teraz som skoro stále doma.",
              "uk": "Колись я багато подорожував, тепер я майже весь час удома."
            },
            {
              "sk": "Prestala som piť kávu.",
              "uk": "Я перестала пити каву."
            }
          ],
          "shortRule": "predtým / kedysi ↔ teraz · prestať + nedokonavý infinitív",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zmeniť a zmeniť sa",
          "text": "«Zmeniť» — змінити щось: «Zmenil som prácu.» «Zmeniť sa» — змінитися: «Môj život sa veľmi zmenil.» «Rozviesť sa» — розлучитися. Про наслідки зміни часто кажемо «odvtedy»: «Narodil sa nám syn. Odvtedy málo spíme.»",
          "examples": [
            {
              "sk": "Odkedy mám deti, môj život sa úplne zmenil.",
              "uk": "Відколи в мене діти, моє життя повністю змінилося."
