      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Keď a hneď ako",
          "text": "«Keď» — коли: «Keď som prišla domov, zavolala som mame.» «Hneď ako» — щойно, як тільки: «Hneď ako sa skončila zmena, išiel som domov.» Підрядне речення відокремлюємо комою. Частини можна поміняти місцями: «Zavolala som mame, keď som prišla domov.» Не плутай: «kedy?» — питання, «keď» — сполучник.",
          "examples": [
            {
              "sk": "Keď som bol malý, býval som na dedine.",
              "uk": "Коли я був малим, я жив у селі."
            },
            {
              "sk": "Hneď ako som dostala výplatu, zaplatila som nájom.",
              "uk": "Щойно я отримала зарплату, я заплатила оренду."
            }
          ],
          "shortRule": "keď / hneď ako + čiarka",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kým a zatiaľ čo",
          "text": "Дві дії одночасно: «Kým som varila, deti sa hrali.» — поки я готувала, діти гралися. «Zatiaľ čo» — тим часом як, а; часто з протиставленням: «Ja som pracoval, zatiaľ čo kamaráti oddychovali.» Тут здебільшого недоконаний вид, бо дії тривають.",
          "examples": [
            {
              "sk": "Kým som čakal na vlak, čítal som noviny.",
              "uk": "Поки я чекав на поїзд, я читав газету."
            },
            {
              "sk": "Ona upratovala, zatiaľ čo on varil.",
              "uk": "Вона прибирала, а він тим часом готував."
            }
          ],
          "shortRule": "kým / zatiaľ čo + nedokonavý vid",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odkedy, odvtedy, vtedy",
          "text": "«Odkedy» — відколи: «Odkedy bývam v Žiline, chodím do práce pešo.» Як і в українській, після «odkedy» буває теперішній час, якщо стан триває досі. «Odvtedy» — відтоді: «V roku 2023 som začal kurz. Odvtedy hovorím lepšie.» «Vtedy» — тоді. Порядок подій: «najprv → potom → nakoniec».",
          "examples": [
            {
              "sk": "Odkedy pracuješ v tejto firme?",
              "uk": "Відколи ти працюєш у цій фірмі?"
            },
            {
              "sk": "Odvtedy sme sa nevideli.",
              "uk": "Відтоді ми не бачилися."
            }
          ],
          "shortRule": "odkedy? (відколи) · odvtedy (відтоді) · vtedy (тоді)",
          "commonMistakes": [
