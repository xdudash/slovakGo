      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kam ísť?",
          "text": "Коли амбулаторія зачинена, а стан не загрожує життю (висока температура, біль у вусі), іди на «ambulantnú pohotovostnú službu» — розмовно «pohotovosť»; окремо для дорослих і для дітей. Якщо стан серйозний (тяжка травма, сильна кровотеча), — «urgentný príjem» у лікарні. Якщо людина не може рухатися або не дихає — телефонуй у «záchranku». Куди? — «na pohotovosť», де? — «na pohotovosti», «na urgentnom príjme».",
          "examples": [
            {
              "sk": "V noci sme išli na pohotovosť.",
              "uk": "Уночі ми пішли в черговий медпункт."
            },
            {
              "sk": "Po úraze ho odviezli na urgentný príjem.",
              "uk": "Після травми його відвезли в приймальне відділення."
            }
          ],
          "shortRule": "pohotovosť → urgentný príjem → 155",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Volám 155",
          "text": "«Tiesňová linka» — лінія екстреного виклику: 155 — швидка допомога, 112 — єдиний європейський номер. Диспетчер питає: «Čo sa stalo?», «Kde ste?», «Dýcha?», «Je pri vedomí?» (Чи при тямі?). Говори коротко: що сталося, де ти, як почувається людина.",
          "examples": [
            {
              "sk": "Môj kolega spadol z rebríka.",
              "uk": "Мій колега впав із драбини."
            },
            {
              "sk": "Je pri vedomí, ale nemôže sa hýbať.",
              "uk": "Він при тямі, але не може рухатися."
            }
          ],
          "shortRule": "Čo sa stalo? Kde ste? Je pri vedomí?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Úraz",
          "text": "«Úraz» — травма, нещасний випадок; «pracovný úraz» — травма на роботі. Що сталося — минулий час: «Zlomil som si ruku», «Porezala som sa», «Udrel sa do hlavy». Лікар надасть «ošetrenie» — допомогу: «ošetrenie rany». Якщо рана «krváca» (кровоточить), притисни її чистою тканиною. Травму на роботі обов’язково повідом роботодавцеві.",
          "examples": [
            {
              "sk": "Mal som pracovný úraz.",
              "uk": "У мене була травма на роботі."
            },
            {
              "sk": "Ošetrenie trvalo hodinu.",
              "uk": "Надання допомоги тривало годину."
            }
          ],
          "shortRule": "zlomiť si, porezať sa, udrieť sa",
