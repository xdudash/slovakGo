      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Verejné zdravotné poistenie",
          "text": "У Словаччині «zdravotné poistenie» (медичне страхування) обов’язкове для людей, які тут постійно живуть або працюють; точні умови залежать від твого статусу — уточни їх у страховій. Застрахована людина — «poistenec» / «poistenkyňa». Де? — «v poisťovni» (місцевий): «Som poistený v zdravotnej poisťovni Lipa.» Куди? — «do poisťovne» (родовий): «prihlásiť sa do poisťovne». Документ для цього — «prihláška».",
          "examples": [
            {
              "sk": "V ktorej poisťovni ste poistená?",
              "uk": "У якій страховій ви застраховані?"
            },
            {
              "sk": "Musím podať prihlášku do poisťovne.",
              "uk": "Мені треба подати заяву до страхової."
            }
          ],
          "shortRule": "v poisťovni (де) · do poisťovne (куди)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kto platí poistné?",
          "text": "«Poistné» — страховий внесок. Якщо ти «zamestnanec», частину внеску платить роботодавець, а частину він утримує з твоєї зарплати — це «odvody» (обов’язкові відрахування). За дітей, пенсіонерів і студентів poistné зазвичай платить держава — вона їхній «platiteľ» (платник): «Za deti platí poistné štát.» Хто працює на себе, платить сам. За кого? — «za» + знахідний: za mňa, za syna.",
          "examples": [
            {
              "sk": "Zamestnávateľ za mňa odvádza poistné.",
              "uk": "Роботодавець сплачує за мене внески."
            },
            {
              "sk": "Odvody nájdete na výplatnej páske.",
              "uk": "Відрахування знайдете в розрахунковому листку."
            }
          ],
          "shortRule": "platiť poistné za + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nárok a zmena poisťovne",
          "text": "«Mať nárok na» + знахідний — мати право на щось: «Mám nárok na bezplatné vyšetrenie.» Страхову можна змінити раз на рік: заяву («prihlášku») до нової страхової треба подати до 30 вересня, а зміна діє з 1 січня наступного року.",
          "examples": [
            {
              "sk": "Mám nárok na preventívnu prehliadku.",
              "uk": "Я маю право на профілактичний огляд."
            },
            {
              "sk": "Chcem zmeniť zdravotnú poisťovňu.",
              "uk": "Я хочу змінити медичну страхову."
            }
          ],
          "shortRule": "mať nárok na + знахідний · prihláška do 30. 9. → zmena od 1. 1.",
