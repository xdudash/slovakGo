      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Stratil som preukaz",
          "text": "Загубив(ла) картку — повідом свою страхову: «Stratil som preukaz poistenca.» Нову картку страхова «vystaví» (оформить) і надішле поштою — це «duplikát». Поки нової картки немає, лікар зазвичай знайде тебе в системі за «rodné číslo» (персональний номер) або іншим ідентифікаційним номером, а страхова може видати «potvrdenie o poistení».",
          "examples": [
            {
              "sk": "Prosím o vystavenie nového preukazu.",
              "uk": "Прошу оформити нову картку."
            },
            {
              "sk": "Aké je vaše rodné číslo?",
              "uk": "Який ваш персональний номер?"
            }
          ],
          "shortRule": "stratiť preukaz → vystaviť duplikát",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Európsky preukaz",
          "text": "На звороті словацької картки страхування зазвичай є «európsky preukaz zdravotného poistenia». З ним у країнах ЄС ти маєш право на необхідну медичну допомогу на тих самих умовах, що й місцеві. Де? — «v zahraničí» (за кордоном), куди? — «do zahraničia» (за кордон), звідки? — «zo zahraničia» (з-за кордону).",
          "examples": [
            {
              "sk": "Na zadnej strane je európsky preukaz.",
              "uk": "На звороті — європейська картка."
            },
            {
              "sk": "Cez leto cestujeme do zahraničia.",
              "uk": "Улітку ми їдемо за кордон."
            }
          ],
          "shortRule": "v zahraničí · do zahraničia · zo zahraničia",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Cestovné poistenie",
          "text": "Європейська картка покриває не все: наприклад, перевезення пацієнта додому чи лікування поза ЄС. Тому перед поїздкою варто оформити «cestovné poistenie» — туристичне страхування (добровільне, платне). Його можна «uzavrieť» онлайн на одну поїздку або на цілий рік. В Україні європейська картка не діє.",
          "examples": [
            {
              "sk": "Uzavrel som si cestovné poistenie na týždeň.",
              "uk": "Я оформив туристичне страхування на тиждень."
            },
            {
              "sk": "Na Ukrajine európsky preukaz neplatí.",
              "uk": "В Україні європейська картка не діє."
            }
          ],
          "shortRule": "európsky preukaz — ЄС · cestovné poistenie — будь-яка країна",
