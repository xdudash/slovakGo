      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pohotovostná lekáreň",
          "text": "Уночі, у вихідні та свята працює «pohotovostná lekáreň» — чергова аптека. Список чергових аптек є на дверях кожної аптеки й на сайті міста. «Lekáreň má službu» — аптека чергує. Уночі часто обслуговують через віконце.",
          "examples": [
            {
              "sk": "Kde je dnes pohotovostná lekáreň?",
              "uk": "Де сьогодні чергова аптека?"
            },
            {
              "sk": "Lekáreň má dnes službu do 22:00.",
              "uk": "Аптека сьогодні чергує до 22:00."
            }
          ],
          "shortRule": "mať službu — чергувати",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Generikum",
          "text": "«Účinná látka» — діюча речовина. «Generikum» — дешевший препарат із тією самою діючою речовиною, що й оригінал. Ліки з України часто продаються тут під іншою назвою — питай про діючу речовину. Фармацевт може запропонувати: «Máme generikum s rovnakou účinnou látkou.» Порівняння: lacný → lacnejší, drahý → drahší; «o päť eur lacnejší» — на п’ять євро дешевший.",
          "examples": [
            {
              "sk": "Je to tá istá účinná látka?",
              "uk": "Це та сама діюча речовина?"
            },
            {
              "sk": "Generikum je o päť eur lacnejšie.",
              "uk": "Генерик на п’ять євро дешевший."
            }
          ],
          "shortRule": "rovnaká účinná látka · nižšia cena",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dávkovanie a lekárnička",
          "text": "«Dávkovanie» — як приймати: «Dávkovanie: 3-krát denne 1 tableta.» Удома варто мати «lekárničku» — домашню аптечку: obväz (бинт), náplasť, dezinfekcia, lieky na horúčku. Слово «lekárnička» означає також фармацевтку — значення видно з контексту. Прострочені ліки віднеси в аптеку.",
          "examples": [
            {
              "sk": "V lekárničke mám obväz a dezinfekciu.",
              "uk": "В аптечці в мене є бинт і дезінфекційний засіб."
            },
            {
              "sk": "Dávkovanie nájdete na krabičke.",
              "uk": "Дозування знайдете на коробочці."
