      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Predpísať liek",
          "text": "«Predpísať» — виписати (ліки): «Lekár mi predpísal antibiotiká.» Кому? — давальний (mi, synovi), що? — знахідний. Офіційна назва рецепта — «lekársky predpis»; ліки «na lekársky predpis» продаються лише за рецептом. Лікар зазвичай оформлює «eRecept» — електронний рецепт: в аптеці зазвичай достатньо показати картку страхування.",
          "examples": [
            {
              "sk": "Pani doktorka mi predpísala sirup.",
              "uk": "Лікарка виписала мені сироп."
            },
            {
              "sk": "Tento liek je len na lekársky predpis.",
              "uk": "Ці ліки лише за рецептом."
            }
          ],
          "shortRule": "predpísať komu? čo?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Hradený liek",
          "text": "«Hradiť» — оплачувати (про страхову). Ліки бувають «plne hradené» — усе оплачує страхова; «čiastočne hradené» — частково, ти платиш доплату (doplatok); «nehradené» — платиш усю суму. Дієприкметник узгоджується з родом: liek je hradený, masť je hradená, lieky sú hradené.",
          "examples": [
            {
              "sk": "Tento liek poisťovňa nehradí.",
              "uk": "Ці ліки страхова не оплачує."
            },
            {
              "sk": "Masť je čiastočne hradená.",
              "uk": "Мазь частково оплачує страхова."
            }
          ],
          "shortRule": "plne · čiastočne · nehradený",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Lieky, ktoré užívam dlhodobo",
          "text": "Хто приймає ліки «dlhodobo» (тривалий час, постійно), не мусить щоразу йти на огляд: рецепт часто можна попросити телефоном або e-mailом, і лікар надішле eRecept. Рецепт діє обмежений час — подивись, до коли його треба використати.",
          "examples": [
            {
              "sk": "Lieky na tlak užívam dlhodobo.",
              "uk": "Ліки від тиску я приймаю постійно."
            },
            {
              "sk": "Mohli by ste mi predpísať lieky na tlak?",
