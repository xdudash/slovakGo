      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Odporúčanie a výmenný lístok",
          "text": "До більшості спеціалістів потрібне направлення від сімейного лікаря. Розмовно його називають «výmenný lístok», офіційно — «odporúčanie». Сьогодні лікар зазвичай надсилає його електронно. Без направлення можна йти, наприклад, до гінеколога чи стоматолога.",
          "examples": [
            {
              "sk": "Potrebujem odporúčanie ku kardiológovi.",
              "uk": "Мені потрібне направлення до кардіолога."
            },
            {
              "sk": "Dám vám výmenný lístok na ortopédiu.",
              "uk": "Я дам вам направлення в ортопедію."
            }
          ],
          "shortRule": "všeobecný lekár → odporúčanie → špecialista",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ku kardiológovi, k ortopédovi",
          "text": "Спеціаліст — «špecialista» або «odborný lekár». Куди? — k + давальний: «k ortopédovi», «k dermatológovi», «k neurológovi». Перед словами на k-, g- кажемо «ku»: «ku kardiológovi», «ku gynekológovi». Де? — u + родовий: «u kardiológa». Відділення — na + знахідний: «na ortopédiu», «na kardiológiu».",
          "examples": [
            {
              "sk": "Zajtra idem ku kardiológovi.",
              "uk": "Завтра я йду до кардіолога."
            },
            {
              "sk": "Bola som u očnej lekárky.",
              "uk": "Я була в окулістки."
            }
          ],
          "shortRule": "k / ku + давальний · u + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čakacia doba a nález",
          "text": "До спеціаліста часто доводиться довго чекати: «Čakacia doba je dva mesiace.» Можна спитати: «Nemáte skorší termín?» Після огляду спеціаліст пише «nález» (висновок) і надсилає його сімейному лікареві.",
          "examples": [
            {
              "sk": "Na neurológa sa čaká tri mesiace.",
              "uk": "До невролога чекають три місяці."
            },
            {
              "sk": "Nález pošleme vašej lekárke.",
              "uk": "Висновок ми надішлемо вашій лікарці."
            }
          ],
          "shortRule": "čakacia doba · skorší termín · nález",
