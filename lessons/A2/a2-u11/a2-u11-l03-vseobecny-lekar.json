      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Všeobecný lekár a pediater",
          "text": "Дорослі ходять до «všeobecného lekára pre dospelých», у розмові часто — «obvodný lekár». Діти — до «pediatra» (офіційно «lekár pre deti a dorast»). Сімейний лікар — перший, до кого ти йдеш: лікує звичайні хвороби, виписує рецепти й PN, робить профогляд і за потреби направляє до спеціаліста. Куди? — k + давальний: «k pediatrovi», «k lekárke».",
          "examples": [
            {
              "sk": "S dcérou idem k pediatrovi.",
              "uk": "Я йду з донькою до педіатра."
            },
