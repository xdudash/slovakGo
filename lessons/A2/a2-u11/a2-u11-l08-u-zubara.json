      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde vás bolí?",
          "text": "Де саме болить: «Bolí ma zub vľavo hore / vpravo dole.» «Mám kaz» — у мене карієс. Зуб може бути «citlivý na studené» — чутливий до холодного. «Ďasno» — ясна: «Krváca mi ďasno.» До стоматолога звертаються «pán doktor» / «pani doktorka».",
          "examples": [
            {
              "sk": "Bolí ma zub vpravo dole.",
              "uk": "У мене болить зуб унизу праворуч."
            },
            {
              "sk": "Pri čistení mi krváca ďasno.",
              "uk": "Під час чищення в мене кровоточать ясна."
            }
          ],
          "shortRule": "vľavo / vpravo · hore / dole",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ošetrenie u zubára",
          "text": "«Plomba» — пломба: «Treba vám dať plombu.» Перед лікуванням лікар каже «Dám vám injekciu» — зробить укол (знеболення). «Vytrhnúť zub» — видалити зуб. «Zubný kameň» — зубний камінь; його знімають на «dentálnej hygiene» (професійна гігієна). Пломба — жіночий рід: «Vypadla mi plomba.»",
          "examples": [
            {
              "sk": "Vypadla mi plomba.",
              "uk": "У мене випала пломба."
            },
            {
              "sk": "Ten zub budeme musieť vytrhnúť.",
              "uk": "Цей зуб доведеться видалити."
            }
          ],
          "shortRule": "dať plombu · vytrhnúť zub · odstrániť zubný kameň",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Prehliadka a platenie",
          "text": "У стоматолога теж треба бути зареєстрованим. Раз на рік ходи на «preventívnu prehliadku»: якщо її пропустиш, за деякі процедури доведеться доплачувати більше. Деякі процедури, наприклад dentálnu hygienu, пацієнт часто оплачує сам, тож ціну краще спитати наперед: «Koľko to bude stáť?»",
          "examples": [
            {
              "sk": "Koľko zaplatím za plombu?",
              "uk": "Скільки я заплачу за пломбу?"
            },
            {
              "sk": "Na prehliadku chodím raz ročne.",
              "uk": "На огляд я ходжу раз на рік."
            }
          ],
          "shortRule": "preventívna prehliadka — raz ročne",
          "commonMistakes": [
            {
              "mistake": "Bolí ma zub ľavý hore.",
              "correct": "Bolí ma zub vľavo hore."
