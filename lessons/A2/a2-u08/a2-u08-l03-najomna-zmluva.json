      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Сторони й строк",
          "text": "У договорі дві «zmluvné strany» — сторони: «prenajímateľ» (хто здає) і «nájomca» (хто наймає). «Predmet nájmu» — що саме здають. Договір буває «na dobu určitú» — на визначений строк (наприклад, на рік, до конкретної дати) або «na dobu neurčitú» — безстроковий.",
          "examples": [
            {
              "sk": "Zmluva sa uzatvára na dobu určitú, do 31. 8. 2027.",
              "uk": "Договір укладається на визначений строк, до 31.08.2027."
            },
            {
              "sk": "Máme zmluvu na dobu neurčitú.",
              "uk": "У нас безстроковий договір."
            }
          ],
          "shortRule": "na dobu určitú — до дати · na dobu neurčitú — без кінцевої дати",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як припинити договір",
          "text": "Договір можна «ukončiť» — припинити: «dohodou» (за згодою сторін) або «výpoveďou» (одностороннім повідомленням про розірвання). «Dať výpoveď» — повідомити іншу сторону, що розриваєш договір. «Výpovedná lehota» — строк від повідомлення до кінця оренди; він записаний у договорі. Výpoveď зазвичай подають «písomne» — письмово.",
          "examples": [
            {
              "sk": "Nájomca dal výpoveď v marci.",
              "uk": "Орендар повідомив про розірвання договору в березні."
            },
            {
              "sk": "Výpovedná lehota je podľa zmluvy dva mesiace.",
              "uk": "Строк попередження за договором — два місяці."
            }
          ],
          "shortRule": "ukončiť dohodou / výpoveďou · výpovedná lehota",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Мова договору",
          "text": "Обов’язки: «Nájomca je povinný…» + інфінітив — орендар зобов’язаний: «platiť nájomné včas». Заборони: «Nájomca nesmie…» — не має права: «prenajať byt ďalšej osobe». «Bez súhlasu prenajímateľa» — без згоди орендодавця (родовий). Умови договору — «podmienky».",
          "examples": [
            {
              "sk": "Nájomca je povinný udržiavať byt v poriadku.",
              "uk": "Орендар зобов’язаний утримувати квартиру в порядку."
            },
            {
              "sk": "Bez súhlasu prenajímateľa nájomca nesmie robiť v byte zmeny.",
              "uk": "Без згоди орендодавця орендар не має права робити зміни в квартирі."
