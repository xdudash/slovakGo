      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Не працює",
          "text": "Найчастіше кажемо «nefunguje» — не працює: «nefunguje práčka, bojler, internet». Про світло — «nesvieti»: «nesvieti svetlo v kúpeľni». Про воду й опалення розмовно — «nejde»: «nejde teplá voda», «nejde kúrenie». Про річ, що зламалася, — «je pokazený / pokazená»: «Chladnička je pokazená». Коли техніка зламалася, кажемо «nefunguje», а не «nepracuje» — це калька з української.",
          "examples": [
            {
              "sk": "Od rána nefunguje bojler.",
              "uk": "Із самого ранку не працює бойлер."
            },
            {
              "sk": "V kuchyni nesvieti svetlo.",
              "uk": "На кухні не світить світло."
            }
          ],
          "shortRule": "nefunguje · nesvieti · nejde · je pokazený",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Проблеми з водою",
          "text": "«Kvapká» — капає: «kvapká kohútik». «Tečie» — тече: «tečie voda spod práčky». «Zateká» — затікає (зверху): «zateká strop», «zateká od suseda». «Je upchatý» — засмічений: «upchatý odtok», «upchatý záchod».",
          "examples": [
            {
              "sk": "Zo stropu v kúpeľni zateká.",
              "uk": "Зі стелі у ванній затікає."
            },
            {
              "sk": "Odtok vo vani je upchatý.",
              "uk": "Злив у ванні засмічений."
            }
          ],
          "shortRule": "kvapká · tečie · zateká · je upchatý",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як повідомити",
          "text": "«Nahlásiť poruchu» — повідомити про поломку. Скажи 1) що, 2) де, 3) відколи: «Od včera nefunguje práčka v kúpeľni.» Попроси: «Mohli by ste poslať opravára?» Якщо сильно тече вода або пахне газом — це «havária»: перекрий воду чи газ і телефонуй до аварійної служби («havarijná služba»).",
          "examples": [
            {
              "sk": "Chcela by som nahlásiť poruchu.",
              "uk": "Я хотіла б повідомити про поломку."
            },
            {
              "sk": "Kedy môže prísť opravár?",
              "uk": "Коли може прийти майстер?"
            }
          ],
          "shortRule": "čo? kde? odkedy? → nahlásiť poruchu",
