      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nočný pokoj",
          "text": "«Domový poriadok» — правила будинку. Найважливіше — «nočný pokoj»: у цей час не можна шуміти. Точні години записані в правилах вашого будинку, найчастіше це пізній вечір і ніч. «Hluk» — шум, «rušiť» — заважати, турбувати: «rušiť susedov», «hudba ruší». Дієслово «rušiť» вимагає знахідного: «ruší nás», а не «ruší nám».",
          "examples": [
            {
              "sk": "Počas nočného pokoja nevŕtajte a nepúšťajte hlasnú hudbu.",
              "uk": "Під час нічного спокою не свердліть і не вмикайте гучну музику."
            },
            {
              "sk": "Prepáčte, ruší nás hluk z vášho bytu.",
              "uk": "Вибачте, нам заважає шум із вашої квартири."
            }
          ],
          "shortRule": "rušiť + знахідний: rušiť susedov, ruší nás",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Заборони",
          "text": "У правилах: «Je zakázané…» + інфінітив — заборонено: «Je zakázané fajčiť vo výťahu». «Zákaz…» + родовий віддієслівного іменника: «Zákaz fajčenia», «Zákaz vstupu», «Zákaz parkovania». М’якше: «Nie je dovolené…», «Prosíme, nenechávajte…».",
          "examples": [
            {
              "sk": "Je zakázané nechávať bicykle na chodbe.",
              "uk": "Заборонено залишати велосипеди в коридорі."
            },
            {
              "sk": "Zákaz parkovania pred vchodom.",
              "uk": "Паркування перед під’їздом заборонено."
            }
          ],
          "shortRule": "Je zakázané + інфінітив · Zákaz + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odpad",
          "text": "«Odpad» — відходи, сміття (розмовно «smeti»). Словаки «triedia odpad» — сортують сміття: «plast», «papier», «sklo», «bioodpad» і «zmesový odpad» — змішані відходи. Найчастіше пластик — у жовтий контейнер, папір — у синій, скло — у зелений, але в різних містах буває по-різному, тому читай напис на «kontajner».",
          "examples": [
            {
              "sk": "Plastové fľaše hádžeme do žltého kontajnera.",
              "uk": "Пластикові пляшки ми кидаємо в жовтий контейнер."
            },
            {
              "sk": "Triedite odpad?",
              "uk": "Ви сортуєте сміття?"
            }
          ],
          "shortRule": "triediť odpad: plast, papier, sklo, bioodpad",
          "commonMistakes": [
