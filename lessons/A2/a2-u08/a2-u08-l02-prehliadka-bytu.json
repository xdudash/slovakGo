      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Домовитися про огляд",
          "text": "Зручно почати з умовного способу: «Chcel(a) by som si pozrieť byt» — я хотів(ла) б подивитися квартиру. Дієслово «pozrieť si» (подивитися, оглянути) вживаємо із «si» і знахідним відмінком. Час пропонуємо так: «Môžem prísť zajtra o piatej?», «Hodí sa vám sobota dopoludnia?» — вам зручно в суботу до обіду?",
          "examples": [
            {
              "sk": "Chcela by som si pozrieť ten byt na Hlavnej ulici.",
              "uk": "Я хотіла б подивитися ту квартиру на Головній вулиці."
            },
            {
              "sk": "Hodí sa vám štvrtok o šiestej?",
              "uk": "Вам зручно в четвер о шостій?"
            }
          ],
          "shortRule": "pozrieť si + знахідний · Hodí sa vám…?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що запитати",
          "text": "Головні запитання: «Aké sú mesačné náklady?» — які щомісячні витрати? «Je byt zariadený?» — чи є меблі? «Aké spotrebiče sú v byte?» — яка є побутова техніка? «Je tu práčka?» «Môžem sa sem prihlásiť na pobyt?» — чи можна тут зареєструвати місце проживання? «Od kedy je byt voľný?» На «Je…?» відповідаємо «Áno, je» або «Nie, nie je».",
          "examples": [
            {
              "sk": "Aké spotrebiče sú v kuchyni?",
              "uk": "Яка техніка є на кухні?"
            },
            {
              "sk": "Je v byte práčka?",
              "uk": "У квартирі є пральна машина?"
            }
          ],
          "shortRule": "Je…? · Sú…? · Aké…? · Od kedy…?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Стан квартири",
          "text": "«Zrekonštruovaný byt» — квартира після ремонту (нові вікна, підлога, ванна). «V pôvodnom stave» — без ремонту, як було колись. «Vybavenie» — обладнання й меблі: «kuchynská linka» (кухонний гарнітур), «spotrebiče» (побутова техніка). У розмові кажуть і «byt je po rekonštrukcii» — це те саме, що zrekonštruovaný.",
          "examples": [
            {
              "sk": "Kúpeľňa je zrekonštruovaná, ale kuchyňa je v pôvodnom stave.",
              "uk": "Ванна кімната після ремонту, а кухня — без ремонту."
            },
            {
              "sk": "Vybavenie bytu je nové.",
              "uk": "Обладнання квартири нове."
            }
          ],
