      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто такий správca",
          "text": "«Správca» (správca domu) — фірма або людина, яка доглядає за всім будинком: «spoločné priestory» (під’їзд, сходи, підвали, ліфт), прибирання, технічні перевірки, розрахунки за енергії. Свою квартиру ти орендуєш у власника, а за спільне відповідає správca. Звертаємося з давальним: «zavolám správcovi», «napíšem správcovi».",
          "examples": [
            {
              "sk": "Výťah nefunguje, zavolám správcovi.",
              "uk": "Ліфт не працює, я зателефоную управителю."
            },
            {
              "sk": "Správca sa stará o celý dom.",
              "uk": "Управитель доглядає за всім будинком."
            }
          ],
          "shortRule": "квартира — prenajímateľ · спільні приміщення — správca",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Oznam na nástenke",
          "text": "Оголошення («oznam») висить на «nástenka» — дошці оголошень у під’їзді. Типові формули: «Oznamujeme obyvateľom, že…» — повідомляємо мешканцям, що…; «Žiadame vás, aby ste…» — просимо вас…; «Ďakujeme za pochopenie» — дякуємо за розуміння.",
          "examples": [
            {
              "sk": "Oznamujeme obyvateľom, že v piatok bude upratovanie pivníc.",
              "uk": "Повідомляємо мешканцям, що в п’ятницю буде прибирання підвалів."
            },
            {
              "sk": "Žiadame vás, aby ste nenechávali bicykle na chodbe.",
              "uk": "Просимо вас не залишати велосипеди в коридорі."
            }
          ],
          "shortRule": "Oznamujeme… · Žiadame vás… · Ďakujeme za pochopenie.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Revízia a odstávka",
          "text": "«Revízia» — обов’язкова технічна перевірка: «revízia plynu», «revízia komína», «revízia výťahu». Часто треба бути вдома або «sprístupniť byt» — надати доступ до квартири. «Odstávka» — планове відключення: «odstávka vody», «odstávka elektriny».",
          "examples": [
            {
              "sk": "V utorok bude revízia plynových spotrebičov.",
              "uk": "У вівторок буде перевірка газових приладів."
            },
            {
              "sk": "Počas odstávky nepoužívajte výťah.",
              "uk": "Під час відключення не користуйтеся ліфтом."
            }
          ],
          "shortRule": "revízia — перевірка · odstávka — відключення",
