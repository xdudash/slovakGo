      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prenajmem чи hľadám?",
          "text": "Оголошення часто починається з дієслова. «Prenajmem byt» — здам квартиру (так пише власник), «Hľadám byt» — шукаю квартиру (так пише той, хто хоче винайняти житло). «Na prenájom» — в оренду, «na predaj» — на продаж. Часто пишуть і без дієслова: «Byt na prenájom, Nitra – Chrenová».",
          "examples": [
            {
              "sk": "Prenajmem 2-izbový byt v centre Žiliny.",
              "uk": "Здам двокімнатну квартиру в центрі Жиліни."
            },
            {
              "sk": "Mladý pár hľadá byt na dlhodobý prenájom.",
              "uk": "Молода пара шукає квартиру в довгострокову оренду."
            }
          ],
          "shortRule": "prenajmem — здаю · hľadám — шукаю · na prenájom — в оренду",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Кімнати й площа",
          "text": "Словаки рахують кімнати разом із вітальнею, але без кухні: «2-izbový byt» (dvojizbový) — вітальня, спальня і кухня. «3-izbový» (trojizbový) — три кімнати й кухня. «Garsónka» — одна кімната з кухонним кутом. Площа — «rozloha»: «rozloha 52 m²» читаємо «päťdesiatdva štvorcových metrov».",
          "examples": [
            {
              "sk": "Garsónka má rozlohu 28 m².",
              "uk": "Квартира-студія має площу 28 м²."
            },
            {
              "sk": "Hľadáme trojizbový byt pre rodinu.",
              "uk": "Ми шукаємо трикімнатну квартиру для родини."
            }
          ],
          "shortRule": "2-izbový — dvojizbový · 3-izbový — trojizbový · garsónka — студія",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ціна і скорочення",
          "text": "«Cena: 650 € + energie» — 650 євро, а комунальні платежі окремо. «Vrátane energií» — включно з комунальними (vrátane + родовий). «RK» — realitná kancelária, агентство нерухомості; «bez RK» — без посередника, напряму від власника. «Provízia» — комісія агентства. «Voľný od 1. 11.» або «k dispozícii od 1. 11.» — вільна з 1 листопада.",
          "examples": [
            {
              "sk": "Cena je 700 € vrátane energií.",
              "uk": "Ціна — 700 євро включно з комунальними."
            },
            {
              "sk": "Byt je voľný ihneď.",
              "uk": "Квартира вільна одразу."
            }
          ],
