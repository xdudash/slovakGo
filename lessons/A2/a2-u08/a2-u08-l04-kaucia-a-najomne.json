      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три різні платежі",
          "text": "«Nájomné» — орендна плата за саму квартиру (у розмові часто просто «nájom»). «Zálohy na energie» — щомісячні аванси за комунальні послуги. «Kaucia» — застава: її платять один раз на початку, а після закінчення оренди повертають. У договорі заставу можуть назвати «finančná zábezpeka», а в розмові іноді теж «záloha» — тому уточнюй, про що саме йдеться.",
          "examples": [
            {
              "sk": "Nájomné je 550 € a zálohy na energie 150 €.",
              "uk": "Орендна плата — 550 €, а аванси за комунальні — 150 €."
            },
            {
              "sk": "Kauciu platíte len raz.",
              "uk": "Заставу ви платите лише один раз."
            }
          ],
          "shortRule": "nájomné — щомісяця · kaucia — один раз і повертається",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Скільки і як",
          "text": "«Vo výške» — у розмірі, із родовим: «kaucia vo výške dvoch nájmov», «vo výške 600 eur». «Vopred» — наперед: «nájomné sa platí mesačne vopred». «Na účet» — на рахунок, «v hotovosti» — готівкою. «Do piateho dňa v mesiaci» — до п’ятого числа.",
          "examples": [
            {
              "sk": "Kaucia je vo výške jedného nájmu.",
              "uk": "Застава — у розмірі однієї місячної орендної плати."
            },
            {
              "sk": "Nájomné platím vopred na účet.",
              "uk": "Орендну плату я сплачую наперед на рахунок."
            }
          ],
          "shortRule": "vo výške + родовий · vopred · na účet / v hotovosti",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Повернення застави",
          "text": "Після виїзду власник має «vrátiť kauciu». Але він може «zraziť z kaucie» — утримати із застави — гроші за «poškodenie» (пошкодження), наприклад за розбиту плитку, або за несплачені рахунки. «Bežné opotrebenie» — звичайне зношення (трохи стерта підлога) — пошкодженням не вважається. Тому на початку й наприкінці оренди фотографуй стан квартири.",
          "examples": [
            {
              "sk": "Prenajímateľ mi zrazil z kaucie 80 € za poškodené dvere.",
              "uk": "Орендодавець утримав мені із застави 80 € за пошкоджені двері."
            },
            {
              "sk": "Bežné opotrebenie nie je poškodenie.",
              "uk": "Звичайне зношення — це не пошкодження."
            }
          ],
          "shortRule": "vrátiť kauciu · zraziť z kaucie · poškodenie ≠ opotrebenie",
          "commonMistakes": [
