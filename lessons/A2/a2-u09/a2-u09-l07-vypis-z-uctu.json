      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Výpis z účtu",
          "text": "«Výpis z účtu» — виписка: перелік усіх операцій за певний період — «obdobie»: «výpis za september», «za obdobie od 1. 9. do 30. 9.». Банк надсилає виписку щомісяця в застосунок або електронною поштою; паперова виписка часто платна.",
          "examples": [
            {
              "sk": "Pošlite mi, prosím, výpis z účtu za august.",
              "uk": "Надішліть мені, будь ласка, виписку з рахунку за серпень."
            },
            {
              "sk": "Výpis nájdete v internetbankingu.",
              "uk": "Виписку знайдете в інтернет-банкінгу."
            }
          ],
          "shortRule": "výpis z účtu za + знахідний (za september)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pripísať a odpísať",
          "text": "Гроші прийшли — «boli pripísané na účet» (зараховані), розмовно «prišli mi peniaze». Гроші пішли — «boli odpísané z účtu» (списані). Кожна операція — «transakcia» або «pohyb na účte». У виписці «+» — «príjem», «−» — «výdavok».",
          "examples": [
            {
              "sk": "Výplata mi bola pripísaná desiateho.",
              "uk": "Зарплату мені зарахували десятого."
            },
            {
              "sk": "Z účtu mi odpísali tridsať eur.",
              "uk": "З рахунку мені списали тридцять євро."
            }
          ],
          "shortRule": "pripísať na účet (+) ↔ odpísať z účtu (−)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zostatok a dátumy",
          "text": "«Počiatočný zostatok» — залишок на початку періоду, «konečný zostatok» — у кінці. Дати в реченні читаємо в родовому: «5. 10.» — «piateho októbra». У виписці дати пишуть цифрами: «18. 9.»",
          "examples": [
            {
              "sk": "Konečný zostatok k 30. 9. je 412 eur.",
              "uk": "Кінцевий залишок на 30.09 — 412 євро."
            },
            {
              "sk": "Nájom odišiel tretieho septembra.",
              "uk": "Оренда пішла третього вересня."
            }
          ],
