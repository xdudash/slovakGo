        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Відмінки в банку",
          "text": "Куди? — «na účet», «do banky». Де? — «na účte», «v banke». Звідки? — «z účtu», «z bankomatu». Чим? — «kartou», «trvalým príkazom», «inkasom». Кому? — «mame», «majiteľovi». Коли? — «do pätnásteho októbra», «výpis za september».",
          "examples": [
            {
              "sk": "Peniaze posielam mame na účet.",
