      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "IBAN",
          "text": "«IBAN» — міжнародний номер рахунку. Словацький має 24 знаки й починається з «SK»: «SK31 4400 0000 1987 4263 7541». Цифри зазвичай читають групами по чотири. Питають так: «Aké je vaše číslo účtu?» або «Pošlite mi IBAN.»",
          "examples": [
            {
              "sk": "Môžete mi poslať váš IBAN?",
              "uk": "Можете надіслати мені ваш IBAN?"
            },
            {
              "sk": "Číslo účtu je v zmluve.",
              "uk": "Номер рахунку є в договорі."
            }
          ],
          "shortRule": "SK + 22 цифри",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Prevod",
          "text": "«Prevod» — переказ: «poslať peniaze prevodom», «previesť peniaze na účet». Кому? — давальний: «Posielam peniaze mame.» На чий рахунок? — «na účet» + родовий: «na účet pána Kováča». Звичайний переказ між банками зазвичай приходить наступного робочого дня, «okamžitá platba» — за кілька секунд.",
          "examples": [
            {
              "sk": "Peniaze som previedla na účet syna.",
              "uk": "Я переказала гроші на рахунок сина."
            },
            {
              "sk": "Posielam ti peniaze za lístky.",
              "uk": "Надсилаю тобі гроші за квитки."
            }
          ],
          "shortRule": "poslať komu? (давальний) · na účet koho? (родовий)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Údaje platby",
          "text": "У формі переказу є поля: «IBAN príjemcu» (номер рахунку одержувача), «suma», «variabilný symbol» (VS — число, за яким одержувач знаходить твій платіж, напр. номер фактури) і «správa pre príjemcu» (повідомлення). Хто отримує гроші — «príjemca», хто платить — «platiteľ».",
          "examples": [
            {
              "sk": "Do správy pre príjemcu napíšte svoje meno.",
              "uk": "У повідомленні для одержувача напишіть своє ім’я."
            },
            {
              "sk": "Variabilný symbol je číslo faktúry.",
              "uk": "Варіабельний символ — це номер фактури."
            }
          ],
          "shortRule": "príjemca, suma, VS, správa",
