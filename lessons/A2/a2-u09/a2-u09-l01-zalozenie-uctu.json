      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Založiť si účet",
          "text": "Рахунок у банку можна «založiť» або «otvoriť»: «Chcel by som si založiť účet.» Слово «si» показує, що рахунок відкриваєш для себе. Зазвичай потрібні «doklad totožnosti» (паспорт або посвідка на проживання) та адреса в Словаччині; у деяких банках рахунок можна відкрити й онлайн. Закрити рахунок — «zrušiť účet».",
          "examples": [
            {
              "sk": "Chcela by som si založiť účet.",
              "uk": "Я хотіла б відкрити рахунок."
            },
            {
              "sk": "Čo potrebujem na založenie účtu?",
              "uk": "Що мені потрібно, щоб відкрити рахунок?"
            }
          ],
          "shortRule": "založiť / otvoriť si účet · zrušiť účet",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Bežný a sporiaci účet",
          "text": "«Bežný účet» — поточний рахунок: на нього приходить зарплата, з нього платиш карткою. «Sporiaci účet» — ощадний рахунок: там гроші лежать і приносять відсотки. Людина, яка має рахунок у банку, — «klient» / «klientka» банку.",
          "examples": [
            {
              "sk": "Výplatu mi posielajú na bežný účet.",
              "uk": "Зарплату мені перераховують на поточний рахунок."
            },
            {
              "sk": "Na sporiacom účte mám rezervu.",
              "uk": "На ощадному рахунку в мене є резерв."
            }
          ],
          "shortRule": "bežný — для щоденних платежів, sporiaci — для заощаджень",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Na účet, na účte, z účtu",
          "text": "Куди? — «na účet» (знахідний): «poslať peniaze na účet». Де? — «na účte» (місцевий): «Mám na účte dvesto eur.» Звідки? — «z účtu» (родовий): «Platba odišla z môjho účtu.» Сам банк — «v banke» (де?), «do banky» (куди?).",
          "examples": [
            {
              "sk": "Peniaze sú už na účte.",
              "uk": "Гроші вже на рахунку."
            },
            {
