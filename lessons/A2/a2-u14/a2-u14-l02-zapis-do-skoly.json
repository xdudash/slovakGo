      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Zápis do 1. ročníka",
          "text": "У Словаччині до школи йдуть діти, яким до 31 серпня виповниться шість років. Батьки мусять записати дитину — це «zápis do prvého ročníka». Запис буває навесні, зазвичай у квітні; дати й години школа оголошує на своєму сайті. Про «prijatie» (прийняття) потім вирішує директор школи.",
          "examples": [
            {
              "sk": "Zápis do prvého ročníka bude v apríli.",
              "uk": "Запис до першого класу буде у квітні."
            },
            {
              "sk": "Syna musíme zapísať do školy.",
              "uk": "Сина ми мусимо записати до школи."
            }
          ],
          "shortRule": "zapísať dieťa do + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Základná škola",
          "text": "«Základná škola» (ZŠ) триває дев’ять років: «1. stupeň» — 1.–4. «ročník», «2. stupeň» — 5.–9. ročník. Учень першого класу — «prvák», учениця — «prváčka». Порядкові числівники відмінюються: «do prvého ročníka» (родовий), «v prvom ročníku» (місцевий).",
          "examples": [
            {
              "sk": "Dcéra bude od septembra prváčka.",
              "uk": "Із вересня донька буде першокласницею."
            },
            {
              "sk": "Brat chodí do piateho ročníka.",
              "uk": "Брат ходить у п’ятий клас."
            }
          ],
          "shortRule": "1. stupeň: 1.–4. ročník · 2. stupeň: 5.–9. ročník",
          "commonMistakes": [
            {
              "mistake": "zapísať do prvý ročník",
              "correct": "zapísať do prvého ročníka"
            },
            {
              "mistake": "Syn je v prvý ročník.",
              "correct": "Syn je v prvom ročníku."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čo prinesiem na zápis",
          "text": "На запис беруть «rodný list» дитини (свідоцтво про народження) і документ одного з батьків. В офіційних формулярах батьки — «zákonný zástupca» (законний представник), у множині «zákonní zástupcovia». Деякі школи просять перекласти українські документи — краще запитати заздалегідь.",
          "examples": [
            {
              "sk": "Na zápis si prineste rodný list dieťaťa.",
              "uk": "На запис принесіть свідоцтво про народження дитини."
            },
            {
              "sk": "Formulár podpisuje zákonný zástupca.",
              "uk": "Формуляр підписує законний представник."
            }
          ],
          "shortRule": "rodný list · zákonný zástupca",
          "button": "Далі →"
