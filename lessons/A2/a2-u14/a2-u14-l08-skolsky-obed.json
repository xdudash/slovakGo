      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Obedy v školskej jedálni",
          "text": "Діти обідають у «školskej jedálni». Дитину треба «prihlásiť na obedy» — записати на обіди (na + знахідний). «Stravné» — плата за харчування: зазвичай платять наперед за місяць, переказом. Обід часто видають за «čip» — чипом або карткою.",
          "examples": [
            {
              "sk": "Syn je prihlásený na obedy.",
              "uk": "Син записаний на обіди."
            },
            {
              "sk": "Stravné platíme vždy na mesiac dopredu.",
              "uk": "За харчування ми платимо завжди на місяць наперед."
            }
          ],
          "shortRule": "prihlásiť na obedy · platiť stravné",
          "commonMistakes": [
            {
              "mistake": "Syn je prihlásený do obedov.",
              "correct": "Syn je prihlásený na obedy."
            },
            {
              "mistake": "platiť stravný",
              "correct": "platiť stravné"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Odhlásiť obed",
          "text": "Якщо дитина хвора або її не буде в школі, обід треба «odhlásiť» — відписати, зазвичай до певної години попереднього дня (через застосунок, на сайті чи телефоном). Невідписаний обід треба оплатити. У перший день хвороби в багатьох їдальнях обід можна забрати у власному посуді.",
          "examples": [
            {
              "sk": "Odhláste obed do 14:00 predchádzajúceho dňa.",
              "uk": "Відпишіть обід до 14:00 попереднього дня."
            },
            {
              "sk": "Odhlásila som dcére obed na piatok.",
              "uk": "Я відписала доньці обід на п’ятницю."
            }
          ],
          "shortRule": "odhlásiť obed komu? na kedy?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Diéta a dotácia",
          "text": "Якщо дитина має алергію чи «diétu» (напр. «bezlepková» — безглютенова, «bezlaktózová» — безлактозна), потрібне «potvrdenie od lekára», і не кожна їдальня може готувати дієтичне меню. «Dotácia na stravu» — частину ціни обіду може оплачувати держава; хто має на неї право, пояснить школа.",
          "examples": [
            {
              "sk": "Dcéra má bezlaktózovú diétu.",
              "uk": "У доньки безлактозна дієта."
            },
            {
              "sk": "Na dotáciu sa opýtajte v škole.",
              "uk": "Про дотацію запитайте в школі."
            }
          ],
          "shortRule": "diéta + potvrdenie od lekára",
          "button": "Далі →"
        }
      ],
