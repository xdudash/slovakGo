      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ospravedlnenka",
          "text": "Якщо дитина не була в школі, батьки мусять «ospravedlniť neprítomnosť» — пояснити відсутність. Для цього пишуть «ospravedlnenku»: у паперовий щоденник або в шкільному застосунку. Типова формула: «Ospravedlňujem neprítomnosť svojho syna (svojej dcéry) v dňoch … z dôvodu choroby.» — і підпис. Після «neprítomnosť» — родовий: чия? — «syna, dcéry».",
          "examples": [
            {
              "sk": "Ospravedlňujem neprítomnosť svojej dcéry 3. – 5. marca z dôvodu choroby.",
              "uk": "Пояснюю відсутність своєї доньки 3–5 березня через хворобу."
            }
          ],
          "shortRule": "neprítomnosť + родовий · z dôvodu + родовий",
          "commonMistakes": [
            {
              "mistake": "Ospravedlňujem neprítomnosť môj syn.",
              "correct": "Ospravedlňujem neprítomnosť môjho syna."
            },
            {
              "mistake": "z dôvodu chorobu",
              "correct": "z dôvodu choroby"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vymeškať vyučovanie",
          "text": "«Vymeškať» — пропустити: «vymeškal tri dni», «vymeškané hodiny». Пояснені години — «ospravedlnené», без пояснення — «neospravedlnené», і це вже проблема. Кілька днів можуть пояснити батьки, довшу відсутність — зазвичай лише з «potvrdením od lekára». Точні правила — у «školskom poriadku» (правилах школи).",
          "examples": [
            {
              "sk": "Syn vymeškal celý týždeň.",
              "uk": "Син пропустив цілий тиждень."
            },
            {
              "sk": "Pri dlhšej neprítomnosti treba potvrdenie od lekára.",
              "uk": "При довшій відсутності потрібна довідка від лікаря."
            }
          ],
          "shortRule": "ospravedlnené ↔ neospravedlnené hodiny",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Uvoľniť z vyučovania",
          "text": "Якщо дитина має пропустити уроки, і це відомо заздалегідь (лікар, сімейні справи), батьки просять «uvoľniť ju z vyučovania» — відпустити з уроків: «Prosím o uvoľnenie syna z vyučovania dňa 12. 4. od 10:00 z rodinných dôvodov.»",
          "examples": [
            {
              "sk": "Prosím o uvoľnenie dcéry z vyučovania.",
              "uk": "Прошу відпустити доньку з уроків."
            },
            {
              "sk": "Syna uvoľnili z telesnej výchovy.",
              "uk": "Сина звільнили від фізкультури."
            }
          ],
          "shortRule": "uvoľniť z + родовий",
          "button": "Далі →"
        }
      ],
