      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Škôlka a materská škola",
          "text": "«Škôlka» — розмовна назва садка, офіційно це «materská škola» (MŠ). Діти зазвичай ходять туди з трьох років, а останній рік перед школою обов’язковий. Щоб дитину взяли, батьки подають «žiadosť o prijatie» — заяву про прийняття; рішення ухвалює директорка садка.",
          "examples": [
            {
              "sk": "Syn chodí do škôlky od septembra.",
              "uk": "Син ходить у садок із вересня."
            },
            {
              "sk": "Podali sme žiadosť o prijatie do materskej školy.",
              "uk": "Ми подали заяву про прийняття до дитсадка."
            }
          ],
          "shortRule": "škôlka (розмовно) = materská škola (офіційно)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Priviesť a vyzdvihnúť",
          "text": "Вранці дитину «privedieš do škôlky» — приведеш у садок (повторювана дія — «vodiť»: «Ráno vodím syna do škôlky.»). Після обіду чи ввечері дитину «vyzdvihneš zo škôlky» — забереш. Куди? — «do» + родовий: «do škôlky». Звідки? — «z / zo» + родовий: «zo škôlky». Де? — «v» + місцевий: «v škôlke».",
          "examples": [
            {
              "sk": "Ráno vodím dcéru do škôlky.",
              "uk": "Вранці я воджу доньку в садок."
            },
            {
              "sk": "Poobede ju vyzdvihne manžel.",
              "uk": "Після обіду її забере чоловік."
            }
          ],
          "shortRule": "do škôlky (куди) · v škôlke (де) · zo škôlky (звідки)",
          "commonMistakes": [
            {
              "mistake": "Syn chodí v škôlku.",
              "correct": "Syn chodí do škôlky."
            },
            {
              "mistake": "vyzdvihnúť dieťa zo škôlke",
              "correct": "vyzdvihnúť dieťa zo škôlky"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Prvé dni v škôlke",
          "text": "Перші тижні — «adaptácia»: дитина спочатку буває в садку кілька годин, потім до обіду, а згодом і на денний сон. Що потрібно: «prezuvky» (змінне взуття), «náhradné oblečenie» (запасний одяг), «pyžamo» на сон. Улюблену «hračku» (іграшку) часто можна принести з дому. Вихователька в садку — «pani učiteľka».",
          "examples": [
            {
              "sk": "Do škôlky potrebuje prezuvky a náhradné oblečenie.",
              "uk": "У садок потрібні змінне взуття й запасний одяг."
            },
            {
              "sk": "Adaptácia trvá asi dva týždne.",
              "uk": "Адаптація триває приблизно два тижні."
            }
          ],
          "shortRule": "prezuvky · náhradné oblečenie · pyžamo",
          "button": "Далі →"
        }
      ],
