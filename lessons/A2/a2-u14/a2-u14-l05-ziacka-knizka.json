          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Žiacka knižka a aplikácia",
          "text": "«Žiacka knižka» — учнівський щоденник: туди пишуть оцінки, «poznámky» (зауваження за погану поведінку чи забуті речі) і «pochvaly» (похвали). Багато шкіл має «elektronickú žiacku knižku» у шкільному застосунку: там батьки бачать «hodnotenie», розклад і повідомлення. Підпис батьків під зауваженням означає, що вони його бачили.",
          "examples": [
            {
              "sk": "Známky si pozriem v aplikácii.",
              "uk": "Оцінки я подивлюся в застосунку."
            },
            {
              "sk": "Podpíšte, prosím, poznámku v žiackej knižke.",
              "uk": "Підпишіть, будь ласка, зауваження в щоденнику."
            }
          ],
          "shortRule": "poznámka (−) · pochvala (+)",
          "button": "Далі →"
        }
      ],
