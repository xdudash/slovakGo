      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Známky od 1 po 5",
          "text": "У словацьких школах оцінки від 1 до 5, і 1 — найкраща! 1 — výborný, 2 — chválitebný, 3 — dobrý, 4 — dostatočný, 5 — nedostatočný (незадовільно). Розмовно оцінки називають «jednotka, dvojka, trojka, štvorka, päťka». Не плутай з українською шкалою, де більше — краще.",
          "examples": [
            {
              "sk": "Dostal jednotku!",
              "uk": "Він отримав одиницю — найкращу оцінку!"
            },
            {
              "sk": "Päťka znamená nedostatočný.",
              "uk": "П’ятірка означає «незадовільно»."
            }
          ],
          "shortRule": "1 = najlepšia · 5 = najhoršia",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dostať jednotku z…",
          "text": "Оцінку «dostať» — у знахідному: «jednotku, dvojku, päťku». З якого предмета чи роботи? — «z» + родовий: «z matematiky, z diktátu, z písomky». «Písomka» — письмова контрольна робота.",
          "examples": [
            {
              "sk": "Z písomky dostala dvojku.",
              "uk": "За контрольну вона отримала двійку."
            },
            {
              "sk": "Z čoho máš päťku?",
              "uk": "З чого в тебе п’ятірка?"
            }
          ],
