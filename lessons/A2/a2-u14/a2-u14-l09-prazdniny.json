      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prázdniny",
          "text": "«Prázdniny» — тільки множина: «letné prázdniny sa začínajú», «cez prázdniny» (під час канікул). Навчання триває з початку вересня до кінця червня. Канікули: «jesenné» (кінець жовтня), «vianočné», «polročné» (один день на початку лютого), «jarné» (лютий–березень, у різних краях у різний час), «veľkonočné» і «letné» (липень і серпень).",
          "examples": [
            {
              "sk": "Cez letné prázdniny ideme na Ukrajinu.",
              "uk": "На літніх канікулах ми їдемо в Україну."
            },
            {
              "sk": "Jarné prázdniny máme v marci.",
              "uk": "Весняні канікули в нас у березні."
            }
          ],
          "shortRule": "prázdniny — лише множина",
          "commonMistakes": [
            {
              "mistake": "Letná prázdnina",
              "correct": "Letné prázdniny"
            },
            {
              "mistake": "Prázdniny sa začína.",
              "correct": "Prázdniny sa začínajú."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vysvedčenie",
          "text": "«Vysvedčenie» — табель з оцінками за півріччя: «polročné» — наприкінці січня, «koncoročné» — наприкінці червня, в останній день навчального року. Кажуть «dostať vysvedčenie», «mať na vysvedčení samé jednotky» — мати в табелі самі одиниці, тобто вчитися на відмінно.",
          "examples": [
            {
              "sk": "Na vysvedčení má samé jednotky.",
              "uk": "У табелі в нього самі одиниці."
            },
            {
              "sk": "Vysvedčenie dostanú deti v posledný deň školského roka.",
              "uk": "Табель діти отримають в останній день навчального року."
            }
          ],
          "shortRule": "polročné (január) · koncoročné (jún)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Kam s deťmi cez prázdniny",
          "text": "Батьки працюють, а канікули довгі. Варіанти: «letný tábor» (табір із ночівлею), «denný tábor» (лише вдень, увечері дитина вдома) або бабуся, яка «postráži» дітей. Під час навчального року клас часто їде на кілька днів у «školu v prírode». Куди? — «do tábora»; де? — «v tábore».",
          "examples": [
            {
              "sk": "Babka nám postráži deti.",
              "uk": "Бабуся догляне наших дітей."
            },
            {
              "sk": "Syn ide na týždeň do tábora.",
              "uk": "Син їде на тиждень до табору."
            }
          ],
          "shortRule": "do tábora (куди) · v tábore (де)",
          "button": "Далі →"
        }
      ],
