      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Chodiť na krúžok",
          "text": "«Krúžok» — гурток після уроків. Куди? — «na» + знахідний: «chodí na futbal, na plávanie, na výtvarný krúžok». Де? — «na» + місцевий: «je na krúžku, na plávaní, na tréningu». Записати дитину — «prihlásiť dieťa na krúžok», для цього заповнюють «prihlášku».",
          "examples": [
            {
              "sk": "Dcéra chodí na plávanie.",
              "uk": "Донька ходить на плавання."
            },
            {
              "sk": "Syn je ešte na krúžku.",
              "uk": "Син ще на гуртку."
            }
          ],
          "shortRule": "na plávanie (куди) · na plávaní (де)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Hrať futbal, hrať na gitare",
          "text": "Спорт — «hrať» + знахідний без прийменника: «hrať futbal, hokej, tenis». Музичний інструмент — «hrať na» + місцевий: «hrať na klavíri, na gitare». Співати в хорі — «spievať v speváckom zbore».",
          "examples": [
            {
              "sk": "Syn hrá futbal a hrá aj na gitare.",
