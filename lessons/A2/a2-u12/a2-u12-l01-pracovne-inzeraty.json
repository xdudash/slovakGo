      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hľadáme…",
          "text": "Оголошення часто починається словом «Hľadáme» (шукаємо) + знахідний відмінок. Чоловічі назви людей отримують -a: «skladník → Hľadáme skladníka», «vodič → vodiča». Жіночі на -a мають -u: «predavačka → Hľadáme predavačku». Посада — «pozícia»: «voľná pozícia», «pozícia: kuchár». Людина, яка подається на посаду, — «uchádzač» / «uchádzačka».",
          "examples": [
            {
              "sk": "Hľadáme vodiča s praxou.",
              "uk": "Шукаємо водія з досвідом."
            },
            {
              "sk": "Hotel hľadá chyžnú na plný úväzok.",
              "uk": "Готель шукає покоївку на повну ставку."
            }
          ],
          "shortRule": "hľadať + знахідний: skladníka, predavačku",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ponúkame a požadujeme",
          "text": "«Ponúkame» — що дає фірма: зарплату, «stravné lístky» (талони на харчування), «ubytovanie» (житло), доплати. «Požadujeme» — що вимагають від тебе: освіту, досвід, «vodičský preukaz», мову. «Náplň práce» — що саме ти робитимеш щодня. Дієслово «požadovať» — вимагати.",
          "examples": [
            {
              "sk": "Ponúkame stravné lístky a ubytovanie.",
              "uk": "Пропонуємо талони на харчування й житло."
            },
            {
              "sk": "Požadujeme prax minimálne jeden rok.",
              "uk": "Вимагаємо досвід щонайменше один рік."
            }
          ],
          "shortRule": "Ponúkame — для тебе · Požadujeme — від тебе",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nástup, mzda, kontakt",
          "text": "«Nástup» — початок роботи: «nástup ihneď» (одразу), «nástup od 1. 11.», «nástup dohodou» (за домовленістю). Зарплату в оголошеннях зазвичай пишуть «brutto», тобто до сплати податків і внесків: «mzda od 1 100 € brutto» або «6 € / hod.». «Miesto výkonu práce» — де саме ти працюватимеш. Наприкінці: «Životopisy posielajte na…»",
          "examples": [
            {
              "sk": "Nástup je možný ihneď.",
              "uk": "Почати можна негайно."
            },
            {
              "sk": "Miesto výkonu práce: Trnava.",
              "uk": "Місце роботи: Трнава."
            }
          ],
          "shortRule": "nástup ihneď · nástup od… · nástup dohodou",
