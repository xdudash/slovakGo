      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Od inzerátu po pohovor",
          "text": "Шлях: «nájsť inzerát» → «poslať životopis a motivačný list» → «zavolať» → «ísť na pohovor». Головні відмінки розділу: «uchádzať sa o pozíciu» (o + знахідний), «volám ohľadom inzerátu» (родовий), «pracoval som ako skladník» (називний), «nastúpiť od prvého mája» (родовий).",
          "examples": [
            {
              "sk": "Uchádzam sa o pozíciu kuchára.",
              "uk": "Я претендую на посаду кухаря."
            },
            {
              "sk": "Volám ohľadom vašej ponuky.",
              "uk": "Телефоную щодо вашої пропозиції."
            }
          ],
          "shortRule": "o pozíciu · ohľadom inzerátu · ako skladník · od prvého mája",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Výberové konanie",
          "text": "«Výberové konanie» — відбір кандидатів, часто в кілька етапів: резюме, співбесіда, іноді тест. Результат: «Prijali sme vás.» (вас прийнято) або «Rozhodli sme sa pre iného uchádzača.» — ввічлива відмова. Фірма може тебе «zamestnať» (працевлаштувати), а ти пропозицію «prijať» (прийняти) або «odmietnuť» (відхилити).",
          "examples": [
            {
              "sk": "Firma ma prijala na plný úväzok.",
              "uk": "Фірма прийняла мене на повну ставку."
            },
            {
              "sk": "Ponuku som odmietla, plat bol nízky.",
              "uk": "Пропозицію я відхилила, зарплата була низька."
            }
          ],
          "shortRule": "prijať ↔ odmietnuť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Keď to nevyjde",
          "text": "Відмова — це нормально. Можна ввічливо попросити зворотний зв’язок: «Môžete mi povedať, čo by som mal(a) zlepšiť?» А тоді шукати далі: портали вакансій, агентства, знайомі, úrad práce.",
          "examples": [
            {
              "sk": "Tentoraz to nevyšlo, skúsim to znova.",
              "uk": "Цього разу не вийшло, спробую ще раз."
            },
            {
              "sk": "Ďakujem za informáciu aj za Váš čas.",
              "uk": "Дякую за інформацію й за Ваш час."
            }
          ],
          "shortRule": "odmietnutie → spätná väzba → ďalší inzerát",
          "button": "Далі →"
        }
