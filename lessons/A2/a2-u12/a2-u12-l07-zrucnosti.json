      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Viem a ovládam",
          "text": "«Viem» + інфінітив — що ти вмієш робити: «Viem šoférovať», «Viem variť». «Ovládam» + знахідний — чим ти володієш: «Ovládam Excel», «Ovládam slovenčinu na úrovni B1», «Ovládam vysokozdvižný vozík» (навантажувач). Навичка — «zručnosť»: «počítačové zručnosti», «manuálna zručnosť».",
          "examples": [
            {
              "sk": "Viem pracovať s počítačom.",
              "uk": "Я вмію працювати з комп’ютером."
            },
            {
              "sk": "Ovládam angličtinu aj nemčinu.",
              "uk": "Я володію англійською і німецькою."
            }
          ],
          "shortRule": "viem + інфінітив · ovládam + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Aký som",
          "text": "Якості — прикметники, які узгоджуються з тим, хто говорить: «samostatný / samostatná» (самостійний), «flexibilný / flexibilná» (гнучкий, готовий до змін), «komunikatívny / komunikatívna» (комунікабельний), «presný / presná» (точний, акуратний). Від них є іменники: «samostatnosť», «flexibilita», «presnosť».",
          "examples": [
            {
              "sk": "Som presná a samostatná.",
              "uk": "Я акуратна й самостійна."
            },
            {
              "sk": "Som flexibilný, môžem pracovať aj v noci.",
              "uk": "Я гнучкий, можу працювати й уночі."
            }
          ],
          "shortRule": "on: samostatný · ona: samostatná",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Konkrétne zručnosti",
          "text": "Часті вимоги в оголошеннях: «vodičský preukaz sk. B» (розмовно «vodičák»), «práca s PC», «znalosť slovenského jazyka», «ochota pracovať na zmeny» (готовність працювати позмінно). Пиши про себе конкретно: «Mám vodičský preukaz skupiny C.», «Viem obsluhovať pokladňu.» «Obsluhovať» — працювати з машиною чи пристроєм.",
          "examples": [
            {
              "sk": "Mám vodičský preukaz skupiny B.",
              "uk": "У мене посвідчення водія категорії B."
            },
            {
              "sk": "Viem obsluhovať pokladňu.",
              "uk": "Я вмію працювати з касою."
            }
          ],
          "shortRule": "konkrétne: čo viem, čo ovládam, čo mám",
          "commonMistakes": [
            {
              "mistake": "Ovládam slovenčina.",
              "correct": "Ovládam slovenčinu."
            },
            {
              "mistake": "Viem počítač.",
              "correct": "Viem pracovať s počítačom."
            },
            {
              "mistake": "Ona je samostatný.",
              "correct": "Ona je samostatná."
            }
          ],
          "button": "Далі →"
        }
      ],
