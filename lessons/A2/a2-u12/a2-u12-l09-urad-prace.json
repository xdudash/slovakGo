      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Úrad práce",
          "text": "Повна назва — «Úrad práce, sociálnych vecí a rodiny», розмовно — «úrad práce». Якщо ти без роботи, можеш стати на облік: «zaradiť sa do evidencie uchádzačov o zamestnanie». Розмовно кажуть: «Som na úrade práce» або «Som v evidencii». Зазвичай потрібен документ, що посвідчує особу, і підтвердження про закінчення останньої роботи.",
          "examples": [
            {
              "sk": "Chcem sa zaradiť do evidencie uchádzačov o zamestnanie.",
              "uk": "Я хочу стати на облік як шукач роботи."
            },
            {
              "sk": "Od marca som nezamestnaný.",
              "uk": "З березня я безробітний."
            }
          ],
          "shortRule": "úrad práce · evidencia · uchádzač o zamestnanie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Povinnosti a pomoc",
          "text": "На обліку треба «prísť na úrad v určenom termíne» і активно шукати роботу. Úrad práce пропонує посередництво: «sprostredkovať prácu» (знайти й запропонувати роботу в роботодавця), консультації й «rekvalifikačný kurz» — курс перекваліфікації, наприклад зварювання чи догляду за людьми.",
          "examples": [
            {
              "sk": "Úrad práce mi sprostredkoval prácu v sklade.",
              "uk": "Служба зайнятості знайшла мені роботу на складі."
            },
            {
              "sk": "Úrad mi zaplatil rekvalifikačný kurz.",
              "uk": "Служба оплатила мені курс перекваліфікації."
            }
          ],
          "shortRule": "sprostredkovať prácu · rekvalifikačný kurz",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dávka v nezamestnanosti",
          "text": "«Dávka v nezamestnanosti» — допомога з безробіття. Її виплачує «Sociálna poisťovňa», і тільки тоді, коли ти раніше достатньо довго працював(ла) й сплачував(ла) страхування на випадок безробіття. Спершу треба стати на облік в úrade práce. Відмінки: «do evidencie» (куди?), «v evidencii» (де?), «z evidencie» (звідки?): «vyradiť z evidencie» — зняти з обліку.",
          "examples": [
            {
              "sk": "Mám nárok na dávku v nezamestnanosti?",
              "uk": "Чи маю я право на допомогу з безробіття?"
            },
            {
              "sk": "Keď si nájdete prácu, vyradíme vás z evidencie.",
              "uk": "Коли знайдете роботу, ми знімемо вас з обліку."
            }
          ],
