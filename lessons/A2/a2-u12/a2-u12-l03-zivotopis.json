      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Časti životopisu",
          "text": "Типове словацьке резюме має розділи: «Osobné údaje» (ім’я, дата народження, адреса, телефон, e-mail), «Vzdelanie», «Pracovné skúsenosti», «Jazykové znalosti» і «Ďalšie zručnosti» (комп’ютер, посвідчення водія). Часто використовують формат Europass. Фото не обов’язкове. Резюме зазвичай надсилають e-mailom «v prílohe» — у додатку.",
          "examples": [
            {
              "sk": "Životopis posielam v prílohe.",
              "uk": "Резюме надсилаю в додатку."
            },
            {
              "sk": "V životopise chýba telefónne číslo.",
              "uk": "У резюме бракує номера телефону."
            }
          ],
          "shortRule": "osobné údaje → vzdelanie → skúsenosti → jazyky",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vzdelanie",
          "text": "Середня школа з атестатом — «stredná škola s maturitou»; «maturita» — випускні іспити й атестат. Університет — «vysoká škola». Закінчити школу чи курс — «absolvovať» або «skončiť» + знахідний: «Absolvoval som vysokú školu v Kyjeve.» Український диплом інколи треба офіційно визнати — «uznanie dokladu o vzdelaní».",
          "examples": [
            {
              "sk": "Mám strednú školu s maturitou.",
              "uk": "У мене середня освіта з атестатом."
            },
            {
              "sk": "Absolvovala som kurz účtovníctva.",
              "uk": "Я закінчила курс бухгалтерії."
            }
          ],
          "shortRule": "absolvovať + знахідний: vysokú školu, kurz",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Skúsenosti a jazyky",
          "text": "Досвід пишуть від найновішого: «2022 – teraz: skladník, Logis s. r. o., Senec». Мови оцінюють так: «materinský jazyk» (рідна), «pokročilý» (просунутий рівень), «mierne pokročilý» (середній), «základy» (початковий), або рівнем A1–C2. Ти «ovládaš» мову — володієш нею.",
          "examples": [
            {
              "sk": "Ukrajinčina – materinský jazyk.",
              "uk": "Українська — рідна мова."
            },
            {
              "sk": "Slovenčina – úroveň B1.",
              "uk": "Словацька — рівень B1."
            }
          ],
          "shortRule": "materinský jazyk · pokročilý · mierne pokročilý · základy",
          "commonMistakes": [
