      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pracovný pomer",
          "text": "«Pracovný pomer» — звичайне працевлаштування за трудовим договором («pracovná zmluva»). Він буває на «plný úväzok» або на «skrátený úväzok». Договір укладають «na dobu neurčitú» (безстроково) або «na dobu určitú» — на визначений строк, наприклад на рік чи до кінця сезону. «Na dobu» — це na + знахідний відмінок.",
          "examples": [
            {
              "sk": "Mám zmluvu na dobu neurčitú.",
              "uk": "У мене безстроковий договір."
            },
            {
              "sk": "Zmluvu mi dali na dobu určitú, do konca roka.",
              "uk": "Договір мені дали на визначений строк, до кінця року."
            }
          ],
          "shortRule": "na dobu určitú — до певної дати · na dobu neurčitú — без кінцевої дати",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Skúšobná doba",
          "text": "На початку роботи часто буває «skúšobná doba» — випробувальний термін, для звичайних працівників найбільше три місяці. У цей час і працівник, і роботодавець можуть легко припинити трудові відносини. Питаємо: «Aká dlhá je skúšobná doba?» Відмінки: «v skúšobnej dobe» (під час), «po skúšobnej dobe» (після).",
          "examples": [
            {
              "sk": "Skúšobná doba je tri mesiace.",
              "uk": "Випробувальний термін — три місяці."
            },
            {
              "sk": "Po skúšobnej dobe dostanete vyššiu mzdu.",
              "uk": "Після випробувального терміну отримаєте вищу зарплату."
            }
          ],
          "shortRule": "v skúšobnej dobe · po skúšobnej dobe",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dohoda a živnosť",
          "text": "Коротку або нерегулярну роботу часто оформлюють не трудовим договором, а угодою: «pracovať na dohodu». Є, наприклад, «dohoda o vykonaní práce» (окреме завдання, обмежена кількість годин на рік) і «dohoda o brigádnickej práci študentov» (лише для студентів). «Živnosť» — підприємницька діяльність: «živnostník» працює сам на себе, виставляє фактури й сам сплачує внески.",
          "examples": [
            {
              "sk": "Cez leto pracujem na dohodu.",
              "uk": "Улітку я працюю за угодою."
            },
            {
              "sk": "Brat má živnosť, pracuje ako elektrikár.",
              "uk": "Брат — підприємець, працює електриком."
            }
          ],
          "shortRule": "zmluva — pracovný pomer · dohoda — kratšia práca · živnosť — sám na seba",
          "commonMistakes": [
            {
