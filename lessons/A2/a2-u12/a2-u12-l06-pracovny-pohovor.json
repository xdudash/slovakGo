      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Povedzte nám niečo o sebe",
          "text": "Співбесіда часто починається так: «Predstavte sa, prosím.» або «Povedzte nám niečo o sebe.» Відповідай коротко: хто ти, звідки, який маєш досвід. Досвід — у минулому часі: «Pracoval(a) som tri roky ako…» Після «ako» — називний відмінок: «ako vodič», «ako zdravotná sestra».",
          "examples": [
            {
              "sk": "Volám sa Iryna a pochádzam z Odesy.",
              "uk": "Мене звати Ірина, я з Одеси."
            },
            {
              "sk": "Päť rokov som pracovala ako zdravotná sestra.",
              "uk": "П’ять років я працювала медсестрою."
            }
          ],
          "shortRule": "pracoval(a) som ako + називний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Silné a slabé stránky",
          "text": "«Aké sú vaše silné stránky?» — запитання про сильні сторони: «Som spoľahlivý», «Rýchlo sa učím», «Viem pracovať v tíme». Сильна сторона може бути й іменником: «spoľahlivosť», «presnosť». «Slabá stránka» — слабка сторона; називай її чесно, але покажи, що працюєш над нею.",
          "examples": [
            {
              "sk": "Moja silná stránka je spoľahlivosť.",
              "uk": "Моя сильна сторона — надійність."
            },
            {
              "sk": "Moja slabá stránka je slovenčina, ale chodím na kurz.",
              "uk": "Моя слабка сторона — словацька, але я ходжу на курс."
            }
          ],
          "shortRule": "som spoľahlivý · moja silná stránka je spoľahlivosť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Plat a nástup",
          "text": "«Aké sú vaše platové očakávania?» — на яку зарплату ти розраховуєш: «Predstavujem si okolo 1 300 eur brutto.» «Kedy môžete nastúpiť?» — «Môžem nastúpiť ihneď.» або «od prvého decembra» (od + родовий). Наприкінці зазвичай питають: «Máte nejaké otázky?» Добре мати 1–2 запитання.",
          "examples": [
            {
              "sk": "Môžem nastúpiť od pondelka.",
              "uk": "Можу вийти на роботу з понеділка."
            },
            {
              "sk": "Aký bude pracovný čas?",
              "uk": "Яким буде робочий час?"
            }
          ],
