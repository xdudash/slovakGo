      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prečo volám",
          "text": "Спершу привітайся й назви себе: «Dobrý deň, volám sa Oleh Kravec.» Потім скажи мету: «Volám ohľadom inzerátu na pozíciu skladníka.» «Ohľadom» + родовий відмінок означає «щодо». Якщо не знаєш, з ким говорити: «Môžem hovoriť s niekým z personálneho oddelenia?» Працівник відділу кадрів — «personalista», працівниця — «personalistka».",
          "examples": [
            {
              "sk": "Volám ohľadom vašej pracovnej ponuky.",
              "uk": "Я телефоную щодо вашої вакансії."
            },
            {
              "sk": "Môžete ma spojiť s personalistkou?",
              "uk": "Можете з’єднати мене з працівницею відділу кадрів?"
            }
          ],
          "shortRule": "ohľadom + родовий: inzerátu, ponuky",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Je miesto voľné?",
          "text": "Головне запитання: «Je to miesto ešte voľné?» або «Je ponuka ešte aktuálna?» Можливі відповіді: «Áno, ešte hľadáme.» — «Nie, miesto je už obsadené.» Якщо місце вільне, уточни умови: «Aký je pracovný čas?», «Je potrebná prax?»",
          "examples": [
            {
              "sk": "Prepáčte, miesto je už obsadené.",
              "uk": "Перепрошуємо, місце вже зайняте."
            },
            {
              "sk": "Ponuka je stále aktuálna.",
              "uk": "Пропозиція досі актуальна."
            }
          ],
          "shortRule": "voľné ↔ obsadené · ponuka je aktuálna",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ďalší krok",
          "text": "Роботодавець часто каже: «Pošlite nám životopis e-mailom.» або «Ozveme sa vám.» «Ozvať sa» — зв’язатися, дати про себе знати; кому? — давальний: «ozveme sa vám». Домовляючись про зустріч: «Môžete prísť v utorok o desiatej?» — «Áno, to mi vyhovuje.» Якщо не зрозумів(ла): «Môžete to, prosím, zopakovať?»",
          "examples": [
            {
              "sk": "Ozvem sa vám zajtra.",
              "uk": "Я зв’яжуся з вами завтра."
            },
            {
              "sk": "Kedy sa mi ozvete?",
              "uk": "Коли ви зі мною зв’яжетеся?"
            }
          ],
          "shortRule": "ozvať sa komu? — vám, mi, jej",
