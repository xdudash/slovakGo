      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Páči sa mi",
          "text": "Як і в українському «мені подобається», той, кому подобається, стоїть у давальному, а те, що подобається, — у називному: «Páči sa mi Bratislava». Якщо подобаються кілька речей — «páčia sa mi»: «Páčia sa mi tvoje topánky».",
          "examples": [
            {
              "sk": "Páči sa mi tvoja bunda.",
              "uk": "Мені подобається твоя куртка."
            },
            {
              "sk": "Páčia sa ti hory?",
              "uk": "Тобі подобаються гори?"
            }
          ],
          "shortRule": "páči sa (одне) / páčia sa (кілька)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Минулий час і заперечення",
          "text": "У минулому часі дієслово узгоджується з тим, що подобалося: «Film sa mi páčil», «Výstava sa mi páčila», «To sa mi páčilo», «Hory sa mi páčili». Заперечення — «nepáči sa mi». Питання про враження: «Ako sa ti páčilo v Tatrách?»",
          "examples": [
            {
              "sk": "Koncert sa nám veľmi páčil.",
              "uk": "Концерт нам дуже сподобався."
            },
            {
              "sk": "Nepáči sa mi toto počasie.",
              "uk": "Мені не подобається ця погода."
            }
          ],
          "shortRule": "páčil / páčila / páčilo / páčili",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Компліменти",
          "text": "«Svedčí ti to» — тобі це личить (одяг, зачіска). Увага: це не «свідчить»! «Tá farba ti pristane» — тобі пасує цей колір. «Máš dobrý vkus» — у тебе гарний смак. «Zdá sa mi, že…» — мені здається, що… На комплімент можна відповісти: «Ďakujem, lichotíš mi!» «Hodí sa ti to?» — тобі це підходить (зручно)?",
          "examples": [
            {
              "sk": "Ten nový účes ti svedčí.",
              "uk": "Тобі личить нова зачіска."
            },
            {
              "sk": "Zdá sa mi, že prší.",
              "uk": "Мені здається, що йде дощ."
            }
          ],
          "shortRule": "svedčí ti, pristane ti, zdá sa mi",
          "commonMistakes": [
            {
              "mistake": "Ja sa páči Bratislava.",
              "correct": "Páči sa mi Bratislava."
            },
            {
              "mistake": "Páči sa mi tvoje topánky.",
              "correct": "Páčia sa mi tvoje topánky."
            },
            {
              "mistake": "Film sa mi páčila.",
              "correct": "Film sa mi páčil."
            }
          ],
          "button": "Далі →"
        }
      ],
