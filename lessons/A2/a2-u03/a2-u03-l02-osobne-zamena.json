      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Таблиця займенників",
          "text": "ja → mi (mne), ty → ti (tebe), on / ono → mu (jemu), ona → jej, my → nám, vy → vám, oni / ony → im. Короткі форми — звичайні, ненаголошені: «Daj mi to» — дай мені це.",
          "examples": [
            {
              "sk": "Zavolám ti večer.",
              "uk": "Я подзвоню тобі ввечері."
            },
            {
              "sk": "Pošlem vám to e-mailom.",
              "uk": "Я надішлю вам це електронною поштою."
            }
          ],
          "shortRule": "mi, ti, mu, jej, nám, vám, im",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mne чи mi?",
          "text": "Довгі форми «mne, tebe, jemu» — для наголосу або протиставлення: «Tebe to poviem, ale jemu nie». Після прийменника — теж довгі: «ku mne, k tebe». Для «він, вона, вони» після прийменника додається n-: «k nemu, k nej, k nim».",
          "examples": [
            {
              "sk": "Tebe to poviem, ale jemu nie.",
              "uk": "Тобі я це скажу, а йому ні."
            },
            {
              "sk": "Príď ku mne.",
              "uk": "Приходь до мене."
            }
          ],
          "shortRule": "наголос і прийменник → довга форма",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Je mi zima",
          "text": "Стан людини словацька, як і українська, часто передає давальним: «Je mi zima» — мені холодно, «Je mi teplo», «Je mi zle» — мені погано, «Je mi to jedno» — мені все одно, «Je mi ľúto» — мені шкода. Коротка форма ніколи не стоїть на початку речення: не «Mi je zima», а «Je mi zima».",
          "examples": [
            {
              "sk": "Je mi zima, zavri okno.",
              "uk": "Мені холодно, зачини вікно."
            },
            {
              "sk": "Je mi ľúto.",
              "uk": "Мені шкода."
            }
          ],
          "shortRule": "mi / ti / mu — ніколи не на початку",
          "commonMistakes": [
            {
              "mistake": "Mi je zima.",
              "correct": "Je mi zima."
            },
            {
              "mistake": "Príď k mi.",
              "correct": "Príď ku mne."
            },
            {
              "mistake": "Pomôžem ťa.",
              "correct": "Pomôžem ti."
            }
          ],
          "button": "Далі →"
        }
      ],
