      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Chutí mi",
          "text": "«Chutiť» працює як «páčiť sa»: той, кому смакує, — у давальному, страва — у називному. «Chutí mi káva», «Chutia mi halušky» (множина). Минулий час: «Chutil mi guláš», «Chutila mi polievka», «Chutilo mi to».",
          "examples": [
            {
              "sk": "Chutí ti slovenská kuchyňa?",
              "uk": "Тобі смакує словацька кухня?"
            },
            {
              "sk": "Deťom chutia palacinky.",
              "uk": "Дітям смакують млинці."
            }
          ],
          "shortRule": "chutí (одне) / chutia (кілька)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Смаки",
          "text": "«Sladký, slaný» ти вже знаєш. Нові: «kyslý» — кислий, «horký» — гіркий, «mastný» — жирний, «presolený» — пересолений, «lahodný» — дуже смачний. Увага: «horký» — гіркий, а не гарячий! Гарячий — «horúci».",
          "examples": [
            {
              "sk": "Káva bez cukru je horká.",
              "uk": "Кава без цукру гірка."
            },
            {
              "sk": "Polievka je trochu presolená.",
              "uk": "Суп трохи пересолений."
            }
          ],
          "shortRule": "horký — гіркий, horúci — гарячий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ввічливо за столом",
          "text": "Господиня питає: «Chutilo vám?» — Вам смакувало? Відповідь: «Áno, bolo to výborné!» Якщо щось не смакує, кажи м’яко: «Je to dobré, ale pikantné jedlá mi veľmi nechutia». Коли вже наївся: «Ďakujem, už nevládzem».",
          "examples": [
            {
              "sk": "Ďakujem, už nevládzem, ale veľmi mi chutilo.",
              "uk": "Дякую, я вже не можу, але було дуже смачно."
            }
          ],
          "shortRule": "Chutilo vám? — Áno, výborné!",
          "commonMistakes": [
