      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "K / ku",
          "text": "«K» + давальний — до людини або в напрямку чогось: «Idem k lekárovi» (до лікаря), «Ideme k babke», «Choď k oknu». Перед словами на k, g та в «ku mne» — форма «ku»: «ku kamarátke». Увага: до людини — не «do», а «k»!",
          "examples": [
            {
              "sk": "Zajtra idem k zubárovi.",
              "uk": "Завтра йду до стоматолога."
            },
            {
              "sk": "Príďte k nám na kávu.",
              "uk": "Приходьте до нас на каву."
            }
          ],
          "shortRule": "k + давальний: до кого",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vďaka і kvôli",
          "text": "«Vďaka» — завдяки (про щось добре): «Vďaka tebe mám prácu». «Kvôli» — через (зазвичай про щось погане): «Meškám kvôli zápche» — запізнююся через затор. Обидва — з давальним.",
          "examples": [
            {
              "sk": "Vďaka kolegovi som to stihol.",
              "uk": "Завдяки колезі я встиг."
            },
            {
              "sk": "Kvôli dažďu sme zostali doma.",
              "uk": "Через дощ ми залишилися вдома."
            }
          ],
          "shortRule": "vďaka — добре, kvôli — погане",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Proti, naproti, oproti",
          "text": "«Proti» — проти, а про ліки — від: «liek proti bolesti hlavy», «očkovanie proti chrípke», «Nemám nič proti» — я не заперечую. «Naproti / oproti» — навпроти: «Lekáreň je naproti pošte». В українській «проти» і «навпроти» вимагають родового, а в словацькій — давального!",
          "examples": [
            {
              "sk": "Máte niečo proti kašľu?",
              "uk": "Маєте щось від кашлю?"
            },
            {
              "sk": "Bývame oproti škole.",
              "uk": "Ми живемо навпроти школи."
            }
          ],
          "shortRule": "proti / naproti / oproti + давальний",
          "commonMistakes": [
            {
              "mistake": "Idem do lekára.",
              "correct": "Idem k lekárovi."
            },
            {
              "mistake": "očkovanie proti chrípky",
              "correct": "očkovanie proti chrípke"
            },
            {
              "mistake": "Vďaka zápche meškám.",
              "correct": "Kvôli zápche meškám."
            }
          ],
          "button": "Далі →"
        }
      ],
