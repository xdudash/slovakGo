      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pomôcť komu",
          "text": "«Pomôcť» (допомогти, один раз) і «pomáhať» (допомагати, регулярно) — з давальним, як в українській: «Pomôžem ti» — я допоможу тобі. З чим? — «s» + орудний: «Pomôžeš mi s kufrom?»",
          "examples": [
            {
              "sk": "Môžem vám nejako pomôcť?",
              "uk": "Можу вам якось допомогти?"
            },
            {
              "sk": "Syn pomáha otcovi v dielni.",
              "uk": "Син допомагає батькові в майстерні."
            }
          ],
          "shortRule": "pomôcť / pomáhať + давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Zavolať, odpovedať, pripomenúť",
          "text": "«Zavolať mame» — подзвонити мамі, «napísať kamarátovi» — написати другові, «odpovedať šéfovi» — відповісти шефові, «pripomenúť niekomu niečo» — нагадати комусь щось. «Odpíšem ti» — відпишу тобі (на повідомлення).",
          "examples": [
            {
              "sk": "Pripomeň mi to zajtra ráno.",
              "uk": "Нагадай мені це завтра зранку."
            },
            {
              "sk": "Šéf mi ešte neodpovedal.",
              "uk": "Шеф мені ще не відповів."
            }
          ],
          "shortRule": "кому? — давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Poďakovať a poradiť",
          "text": "«Poďakovať sa niekomu za niečo» — подякувати комусь за щось: «Chcem sa vám poďakovať za pomoc». «Poradiť» — порадити: «Poraďte mi, prosím, čo si mám kúpiť». «Ospravedlniť sa niekomu» — вибачитися перед кимось (словацькою — давальний, без прийменника). На подяку відповідаємо: «Niet za čo» або «Rado sa stalo».",
          "examples": [
            {
              "sk": "Poďakoval som sa susedovi za pomoc.",
              "uk": "Я подякував сусідові за допомогу."
            },
            {
              "sk": "Čo mi poradíš?",
              "uk": "Що ти мені порадиш?"
            }
          ],
          "shortRule": "poďakovať sa komu za čo",
