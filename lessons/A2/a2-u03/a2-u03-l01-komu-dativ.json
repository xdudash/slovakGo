      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Komu?",
          "text": "Давальний відмінок (datív) відповідає на питання «komu?» — кому? Як і в українській, це той, хто щось отримує або кому щось адресовано: «Dám to kamarátovi» — дам це другові. Зазвичай порядок такий: дієслово + кому + що.",
          "examples": [
            {
              "sk": "Komu píšeš?",
              "uk": "Кому ти пишеш?"
            },
            {
              "sk": "Kúpim mame kvety.",
              "uk": "Куплю мамі квіти."
            }
          ],
          "shortRule": "komu? — той, хто отримує",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чоловічий рід",
          "text": "Істоти чоловічого роду мають закінчення «-ovi»: kamarát → kamarátovi, Peter → Petrovi, šéf → šéfovi, lekár → lekárovi. Неістоти — «-u»: dom → domu, zákon → zákonu. Прикметник має закінчення «-ému»: «novému kolegovi».",
          "examples": [
            {
              "sk": "Napíšem šéfovi e-mail.",
              "uk": "Напишу шефові електронного листа."
            },
            {
              "sk": "Nerozumiem tomu zákonu.",
              "uk": "Я не розумію цього закону."
            }
          ],
          "shortRule": "істоти -ovi, неістоти -u",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Жіночий і середній рід",
          "text": "Жіночий рід на -a → «-e»: mama → mame, Jana → Jane, sestra → sestre. Після м’якого приголосного і в словах на -ia → «-i»: kolegyňa → kolegyni, ulica → ulici, Mária → Márii. Прикметник — «-ej»: «novej kolegyni». Середній рід → «-u»: mesto → mestu, dieťa → dieťaťu. Множина: «-om / -ám»: kamarátom, ženám, deťom.",
          "examples": [
            {
              "sk": "Vysvetlím to novej kolegyni.",
              "uk": "Я поясню це новій колезі."
            },
            {
              "sk": "Kúpime deťom zmrzlinu.",
              "uk": "Купимо дітям морозиво."
            }
          ],
          "shortRule": "-e / -i; -u; мн. -om / -ám",
          "commonMistakes": [
            {
              "mistake": "Dám to Peter.",
              "correct": "Dám to Petrovi."
            },
            {
              "mistake": "Kúpim darček mama.",
              "correct": "Kúpim darček mame."
            },
            {
              "mistake": "Napíšem kolegyňe.",
              "correct": "Napíšem kolegyni."
            }
          ],
          "button": "Далі →"
        }
      ],
