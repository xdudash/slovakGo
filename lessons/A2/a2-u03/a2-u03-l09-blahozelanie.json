      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Blahoželať k…",
          "text": "«Blahoželať» і «gratulovať» — вітати, обидва з давальним: кому? З чим? — «k» + давальний: «Blahoželám ti k narodeninám», «Gratulujem k meninám». Найкоротше: «Všetko najlepšie!» Українське «вітаю з…» — тут не «s», а «k»!",
          "examples": [
            {
              "sk": "Všetko najlepšie k narodeninám!",
              "uk": "З днем народження!"
            },
            {
              "sk": "Gratulujem ti k novej práci!",
              "uk": "Вітаю тебе з новою роботою!"
            }
          ],
          "shortRule": "blahoželať / gratulovať komu k čomu",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Prajem ti…",
          "text": "«Priať» або «želať» — бажати: «Prajem ti veľa zdravia, šťastia a lásky». Після «veľa» — родовий: zdravie → zdravia, šťastie → šťastia, úspech → úspechov. Ще одне популярне побажання: «Nech sa ti splnia všetky sny».",
          "examples": [
            {
              "sk": "Želáme vám veľa úspechov v práci.",
              "uk": "Бажаємо вам багато успіхів у роботі."
            },
            {
              "sk": "Prajem ti, nech sa ti splnia všetky sny.",
              "uk": "Бажаю, щоб збулися всі твої мрії."
            }
          ],
          "shortRule": "veľa + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Офіційно",
          "text": "Колезі чи керівникові пишуть «Vám» з великої літери: «Milá pani Horváthová, srdečne Vám blahoželáme k životnému jubileu». «Srdečne» — щиро, від серця. «Životné jubileum» — ювілей. Підпис: «Vaši kolegovia» або «kolektív oddelenia».",
          "examples": [
            {
              "sk": "Srdečne Vám blahoželáme k meninám.",
              "uk": "Щиро вітаємо Вас з іменинами."
            }
          ],
          "shortRule": "Vám — з великої в листі",
          "commonMistakes": [
