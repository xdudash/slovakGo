      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Poradový lístok",
          "text": "У багатьох установах біля входу береш «poradový lístok» — номерок: «Zoberte si poradový lístok». Потім стежиш за «obrazovka» — табло: «A047 – okienko 3». Кажуть, що система «vyvoláva» — викликає номери. «Okienko» — віконце, де приймають відвідувачів.",
          "examples": [
            {
              "sk": "Moje číslo ešte nevyvolali.",
              "uk": "Мій номер ще не викликали."
            },
            {
              "sk": "Choďte k okienku číslo tri.",
              "uk": "Підійдіть до віконця номер три."
            }
          ],
          "shortRule": "poradový lístok → obrazovka → okienko",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na rade",
          "text": "«Byť na rade» — бути наступним: «Kto je na rade?» — Чия черга? «Ste na rade.» — Ваша черга. «Kto je posledný?» — Хто останній? Саме слово «rad» — черга; де? — «v rade»: «stáť v rade» — стояти в черзі.",
          "examples": [
            {
              "sk": "Teraz ste na rade vy.",
              "uk": "Тепер ваша черга."
            },
            {
              "sk": "Stojím v rade už hodinu.",
              "uk": "Я стою в черзі вже годину."
            }
          ],
          "shortRule": "byť na rade · stáť v rade",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ввічливо в черзі",
          "text": "Якщо хтось пролазить без черги («predbehnúť» — випередити), скажи спокійно: «Prepáčte, ale teraz som na rade ja.» або «Prepáčte, máte poradový lístok?». Якщо треба ненадовго вийти: «Môžete mi podržať miesto?» — Можете притримати мені місце?",
          "examples": [
            {
              "sk": "Prepáčte, ja som tu bola prvá.",
              "uk": "Перепрошую, я тут була перша."
            },
            {
              "sk": "Ten pán ma predbehol.",
              "uk": "Цей пан пройшов поперед мене."
            }
          ],
          "shortRule": "Prepáčte, ale… — спокійно й ввічливо",
