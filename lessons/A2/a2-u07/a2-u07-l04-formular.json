      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Поля формуляра",
          "text": "«Formulár» або «tlačivo» — бланк. Типові поля: «priezvisko» — прізвище, «rodné priezvisko» — прізвище при народженні (у жінок часто дівоче), «dátum narodenia», «miesto narodenia» — місце народження, «štátna príslušnosť» — громадянство, «rodinný stav» — сімейний стан, «adresa pobytu na Slovensku» — адреса в Словаччині. Ім’я та прізвище пиши так, як у паспорті.",
          "examples": [
            {
              "sk": "Miesto narodenia: Odesa, Ukrajina",
              "uk": "Місце народження: Одеса, Україна"
            },
            {
              "sk": "Štátna príslušnosť: ukrajinská",
              "uk": "Громадянство: українське"
            }
          ],
          "shortRule": "ім’я та прізвище — як у паспорті",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Сімейний стан",
          "text": "У полі «rodinný stav» пишуть: «slobodný / slobodná» — неодружений / незаміжня, «ženatý» — одружений (про чоловіка), «vydatá» — заміжня (про жінку), «rozvedený / rozvedená» — розлучений / розлучена, «vdovec / vdova» — вдівець / вдова. Чоловік ніколи не буває «vydatý», а жінка — «ženatá».",
          "examples": [
            {
              "sk": "Som vydatá.",
              "uk": "Я заміжня."
            },
            {
              "sk": "Brat je ženatý.",
              "uk": "Брат одружений."
            }
          ],
          "shortRule": "ženatý — він · vydatá — вона",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Інструкції у формулярі",
          "text": "Інструкції пишуть у наказовому способі на «vy»: «Vyplňte» — заповніть, «Podpíšte» — підпишіть, «Priložte» — додайте. «Vyplňte paličkovým písmom» — заповніть друкованими літерами. «Nehodiace sa prečiarknite» — непотрібне закресліть. «Podpis žiadateľa» — підпис заявника.",
          "examples": [
            {
              "sk": "Vyplňte paličkovým písmom.",
              "uk": "Заповніть друкованими літерами."
            },
            {
              "sk": "Podpíšte sa tu, prosím.",
              "uk": "Підпишіться тут, будь ласка."
            }
          ],
