      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Podať žiadosť",
          "text": "«Podať žiadosť» — подати заяву (доконаний вид, одна дія з результатом), «podávať» — подавати (процес або повторення). Після подання зазвичай отримуєш «potvrdenie o podaní žiadosti» — підтвердження про подання. Збережи його: воно показує, що заява на розгляді.",
          "examples": [
            {
              "sk": "Žiadosť som podal v pondelok.",
              "uk": "Заяву я подав у понеділок."
            },
            {
              "sk": "Tu je potvrdenie o podaní žiadosti.",
              "uk": "Ось підтвердження про подання заяви."
            }
          ],
          "shortRule": "podať (результат) · podávať (процес)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Rozhodnutie",
          "text": "«Rozhodnutie» — рішення установи. Позитивне: «žiadosť schválili» — заяву схвалили, офіційно «žiadosti sa vyhovuje» або «Vašej žiadosti bolo vyhovené» — заяву задоволено. Негативне: «žiadosť zamietli» — заяву відхилили. У рішенні зазвичай написано й те, як його можна оскаржити.",
          "examples": [
            {
              "sk": "Žiadosť mi schválili.",
              "uk": "Мою заяву схвалили."
            },
            {
              "sk": "Rozhodnutie príde poštou.",
              "uk": "Рішення прийде поштою."
            }
          ],
          "shortRule": "schváliť ↔ zamietnuť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Prevziať doklad",
          "text": "Коли документ готовий, його треба «prevziať» — отримати, забрати (офіційне слово, розмовно «vyzdvihnúť»). «Doklad o pobyte» — документ (картка) про перебування. На довідках часто є «pečiatka» — печатка. Перевір рядок «platný do» — дійсний до.",
          "examples": [
            {
              "sk": "Doklad o pobyte si môžete prevziať osobne.",
              "uk": "Документ про перебування ви можете забрати особисто."
            },
            {
              "sk": "Na potvrdení chýba pečiatka.",
              "uk": "На підтвердженні немає печатки."
            }
          ],
          "shortRule": "prevziať (офіц.) ≈ vyzdvihnúť",
          "commonMistakes": [
