      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Objednať sa na termín",
          "text": "У багатьох установах треба заздалегідь записатися: «objednať sa na termín» (na + знахідний). Онлайн це роблять через «rezervačný systém». Корисні фрази: «Chcel(a) by som sa objednať na termín.», «Máte voľný termín budúci týždeň?», «Najbližší voľný termín je…».",
          "examples": [
            {
              "sk": "Najbližší voľný termín je až v novembri.",
              "uk": "Найближчий вільний термін — аж у листопаді."
            },
            {
              "sk": "Objednala som sa na utorok.",
              "uk": "Я записалася на вівторок."
            }
          ],
          "shortRule": "objednať sa na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Коли? День і година",
          "text": "Дні: «v pondelok, v utorok, v stredu, vo štvrtok, v piatok». Година: «o ôsmej», «o pol desiatej» — о пів на десяту (9:30), «o štvrť na jedenásť» — 10:15. Дата — у родовому: «dvadsiateho októbra». Разом: «Termín máte v utorok dvadsiateho októbra o deviatej.»",
          "examples": [
            {
              "sk": "Prídem vo štvrtok o desiatej.",
              "uk": "Я прийду в четвер о десятій."
            },
            {
              "sk": "Termín mám o pol deviatej.",
              "uk": "Мій термін о пів на дев’яту (8:30)."
            }
          ],
          "shortRule": "v/vo + день · o + година",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перенести, скасувати, з’явитися",
          "text": "«Presunúť termín» — перенести, «zrušiť termín» — скасувати. В офіційних листах: «Dostavte sa 10 minút pred termínom» — з’явіться за 10 хвилин до терміну; «Ak sa nemôžete dostaviť, termín zrušte» — якщо не можете прийти, скасуйте термін. «Náhradný termín» — новий термін замість попереднього.",
          "examples": [
            {
              "sk": "Môžem si presunúť termín na piatok?",
              "uk": "Можу я перенести свій термін на п’ятницю?"
            },
            {
              "sk": "Dostavte sa včas.",
              "uk": "З’явіться вчасно."
            }
          ],
          "shortRule": "presunúť na + знахідний · dostaviť sa — офіційне «прийти»",
