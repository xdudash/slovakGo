      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ohlásiť pobyt",
          "text": "«Ohlásiť» — офіційно повідомити: «ohlásiť pobyt», «ohlásiť zmenu adresy». Іноземці мусять повідомляти поліції адресу, де живуть, у встановлений строк. Точні правила залежать від статусу й можуть змінюватися, тому перевіряй їх на офіційному сайті. Розмовно кажуть і «nahlásiť adresu».",
          "examples": [
            {
              "sk": "Musím ohlásiť zmenu adresy.",
              "uk": "Я мушу повідомити про зміну адреси."
            },
            {
              "sk": "Pobyt som ohlásila na polícii.",
              "uk": "Про своє перебування я повідомила в поліції."
            }
          ],
          "shortRule": "ohlásiť + знахідний (без прийменника)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vlastník і nájomca",
          "text": "«Vlastník» — власник квартири, «nájomca» — орендар. Щоб підтвердити житло, зазвичай потрібна «nájomná zmluva» — договір оренди або «súhlas vlastníka» — згода власника, іноді також «list vlastníctva» — витяг про право власності. Іноді підпис власника має бути офіційно засвідчений.",
          "examples": [
            {
              "sk": "Vlastník bytu mi dal písomný súhlas.",
              "uk": "Власник квартири дав мені письмову згоду."
            },
            {
              "sk": "Som nájomca, nie vlastník.",
              "uk": "Я орендар, а не власник."
            }
          ],
          "shortRule": "vlastník (власник) ≠ nájomca (орендар)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Після переїзду",
          "text": "Про переїзд кажемо доконаним видом у минулому: «Presťahoval som sa», «Presťahovali sme sa do Trnavy». Після переїзду треба «ohlásiť novú adresu». Документ про житло може видати й «ubytovateľ» — той, хто надає житло: власник, гуртожиток або готель.",
          "examples": [
            {
              "sk": "Minulý mesiac sme sa presťahovali.",
              "uk": "Минулого місяця ми переїхали."
            },
            {
              "sk": "Ubytovateľ mi vydal potvrdenie o ubytovaní.",
              "uk": "Власник житла видав мені підтвердження про проживання."
