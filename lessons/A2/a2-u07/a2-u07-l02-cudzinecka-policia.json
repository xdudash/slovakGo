      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Na políciu — na polícii",
          "text": "Як «na poštu — na pošte», так і з поліцією: куди? — «na políciu» (знахідний), де? — «na polícii» (місцевий). Відділ має довгу назву з родовим: «oddelenie cudzineckej polície» — відділ іноземної поліції. У розмові кажуть просто «cudzinecká polícia» або навіть «cudzinecká».",
          "examples": [
            {
              "sk": "Zajtra idem na cudzineckú políciu.",
              "uk": "Завтра я йду в іноземну поліцію."
            },
            {
              "sk": "Celé dopoludnie som bol na polícii.",
              "uk": "Усю першу половину дня я був у поліції."
            }
          ],
          "shortRule": "kam? na políciu · kde? na polícii",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Úradné hodiny",
          "text": "«Úradné hodiny» — години прийому відвідувачів. У різні дні вони часто різні: «Pondelok: 8:00 – 12:00, 13:00 – 15:00», «Streda: 8:00 – 12:00, 13:00 – 17:30». «Nestránkový deň» — день, коли відвідувачів не приймають («stránka» — офіційна назва відвідувача установи). Години прийому конкретного відділу перевіряй на офіційному сайті.",
          "examples": [
            {
              "sk": "V piatok je nestránkový deň.",
              "uk": "У п’ятницю відвідувачів не приймають."
            },
            {
              "sk": "Úradné hodiny sú dnes do tretej.",
              "uk": "Сьогодні прийом до третьої."
            }
          ],
          "shortRule": "úradné hodiny · nestránkový deň",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ввічливо на úrade",
          "text": "На úrade говорять на «vy». Розмову починають із «Dobrý deň» і «Prepáčte» або «Prosím vás». Ввічливе прохання — умовний спосіб: «Mohli by ste mi povedať…?», «Mohli by ste to zopakovať?», «Mohli by ste hovoriť pomalšie?». До поліцейського можна звернутися «pán policajt».",
          "examples": [
            {
              "sk": "Prepáčte, kde je oddelenie cudzineckej polície?",
              "uk": "Перепрошую, де відділ іноземної поліції?"
            },
            {
              "sk": "Mohli by ste hovoriť pomalšie?",
              "uk": "Чи не могли б ви говорити повільніше?"
            }
          ],
          "shortRule": "vy + Mohli by ste…?",
