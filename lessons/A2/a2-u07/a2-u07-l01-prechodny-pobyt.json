      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три види перебування",
          "text": "Українці в Словаччині найчастіше мають «dočasné útočisko» — тимчасовий притулок (українською зазвичай кажуть «тимчасовий захист»). Інші іноземці отримують «prechodný pobyt» — тимчасове перебування на певний строк, а згодом можуть мати «trvalý pobyt» — постійне перебування. Слово «pobyt» — чоловічого роду: «môj pobyt», «bez pobytu», «žiadosť o pobyt».",
          "examples": [
            {
              "sk": "Mám dočasné útočisko.",
              "uk": "Я маю тимчасовий захист."
            },
            {
              "sk": "Brat má prechodný pobyt na dva roky.",
              "uk": "Брат має тимчасове перебування на два роки."
            }
          ],
          "shortRule": "dočasné útočisko · prechodný pobyt · trvalý pobyt",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Мета перебування",
          "text": "Тимчасове перебування завжди має мету — «účel». Офіційно кажуть «za účelom» + родовий: «za účelom zamestnania» — з метою працевлаштування, «za účelom štúdia» — з метою навчання, «za účelom zlúčenia rodiny» — з метою возз’єднання сім’ї. У розмові простіше: «kvôli» + давальний: «Som tu kvôli práci».",
          "examples": [
            {
              "sk": "Mám prechodný pobyt za účelom zamestnania.",
              "uk": "Я маю тимчасове перебування з метою працевлаштування."
            },
            {
              "sk": "Sestra je tu kvôli štúdiu.",
              "uk": "Сестра тут через навчання."
            }
          ],
          "shortRule": "za účelom + родовий (офіційно) · kvôli + давальний (розмовно)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Požiadať o, povolenie na",
          "text": "Дієслово «požiadať» вимагає «o» + знахідний: «požiadať o prechodný pobyt», «požiadať o predĺženie pobytu». Слово «povolenie» — дозвіл — уживаємо з «na» + знахідний: «povolenie na pobyt», «povolenie na zamestnanie». Не плутай: «žiadam o pobyt», а не «žiadam na pobyt».",
          "examples": [
            {
              "sk": "Chcem požiadať o prechodný pobyt.",
              "uk": "Я хочу подати заяву на тимчасове перебування."
            },
            {
              "sk": "Manžel má povolenie na pobyt.",
              "uk": "Чоловік має дозвіл на перебування."
            }
          ],
          "shortRule": "požiadať o + знахідний · povolenie na + знахідний",
          "commonMistakes": [
            {
              "mistake": "požiadať na pobyt",
              "correct": "požiadať o pobyt"
            },
            {
              "mistake": "za účelom práca",
              "correct": "za účelom práce"
            },
            {
              "mistake": "povolenie o pobyt",
              "correct": "povolenie na pobyt"
            }
          ],
          "button": "Далі →"
        }
