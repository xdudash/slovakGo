      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Správny poplatok",
          "text": "За багато послуг установа бере «správny poplatok» — адміністративний збір. Сума залежить від послуги й може змінюватися, тому актуальну суму завжди перевіряй на офіційному сайті. Питають так: «Koľko je poplatok za…?» (za + знахідний). Деякі люди або послуги «oslobodené od poplatku» — звільнені від збору.",
          "examples": [
            {
              "sk": "Koľko je správny poplatok za vydanie dokladu?",
              "uk": "Скільки становить адміністративний збір за видачу документа?"
            },
            {
              "sk": "Za túto službu sa poplatok neplatí.",
              "uk": "За цю послугу збір не сплачується."
            }
          ],
          "shortRule": "poplatok za + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kolok і e-kolok",
          "text": "Збір часто сплачують «kolkom» — гербовою маркою. Сьогодні це зазвичай «e-kolok» — електронна марка: її можна купити на пошті, в автоматі («kolkomat») або онлайн, а в установі показуєш чек чи код. Іноді можна заплатити й карткою на місці.",
          "examples": [
            {
              "sk": "E-kolok si môžete kúpiť na pošte.",
              "uk": "Е-марку можна купити на пошті."
            },
            {
              "sk": "Máte už zaplatený kolok?",
              "uk": "Ви вже сплатили марку?"
            }
          ],
          "shortRule": "e-kolok: pošta, kolkomat, online",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Uhradiť, úhrada",
          "text": "Офіційно замість «zaplatiť» кажуть «uhradiť»: «uhradiť poplatok» — сплатити збір. Іменник — «úhrada»: «potvrdenie o úhrade» — підтвердження оплати, «úhrada kartou» — оплата карткою. «Oslobodený od» + родовий: «oslobodený od poplatku».",
          "examples": [
            {
              "sk": "Poplatok som uhradila cez aplikáciu.",
              "uk": "Збір я сплатила через застосунок."
            },
            {
              "sk": "Tu je potvrdenie o úhrade.",
              "uk": "Ось підтвердження оплати."
            }
          ],
          "shortRule": "uhradiť (офіц.) · oslobodený od + родовий",
