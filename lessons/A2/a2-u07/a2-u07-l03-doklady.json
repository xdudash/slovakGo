      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Основні документи",
          "text": "Найчастіше потрібні: «cestovný pas» — закордонний паспорт, «doklad totožnosti» — документ, що посвідчує особу, «fotografia» — фотографія, «doklad o ubytovaní» — документ про житло, «potvrdenie o zdravotnom poistení» — підтвердження медичного страхування. Для деяких заяв потрібен і «výpis z registra trestov» — довідка про несудимість. Точний список для своєї заяви завжди перевіряй на офіційному сайті.",
          "examples": [
            {
              "sk": "Mám so sebou cestovný pas.",
              "uk": "Я маю із собою закордонний паспорт."
            },
            {
              "sk": "Chýba mi doklad o ubytovaní.",
              "uk": "Мені бракує документа про житло."
            }
          ],
          "shortRule": "cestovný pas · doklad totožnosti · doklad o ubytovaní",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Doklad o + місцевий",
          "text": "Назви документів часто будуються з «o» + місцевий відмінок: «doklad o ubytovaní», «potvrdenie o príjme» — довідка про дохід, «potvrdenie o zamestnaní» — довідка з місця роботи, «doklad o zaplatení» — документ про оплату. «Doklad» — будь-який офіційний документ, «potvrdenie» — довідка, підтвердження.",
          "examples": [
            {
              "sk": "Potrebujem potvrdenie o zamestnaní.",
              "uk": "Мені потрібна довідка з місця роботи."
            },
            {
              "sk": "Priniesla som doklad o ubytovaní.",
              "uk": "Я принесла документ про житло."
            }
          ],
          "shortRule": "doklad / potvrdenie o + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Originál, kópia, preklad",
          "text": "«Originál» — оригінал, «kópia» — копія. «Overená kópia» — засвідчена копія (з печаткою нотаріуса або установи). До документів іноземною мовою часто потрібен «úradný preklad» — офіційний переклад словацькою. Документи «priložiť k žiadosti» — додати до заяви (k + давальний).",
          "examples": [
            {
              "sk": "Priložte kópiu pasu.",
              "uk": "Додайте копію паспорта."
            },
            {
              "sk": "Doklady musia byť platné.",
              "uk": "Документи мають бути чинними."
            }
          ],
          "shortRule": "originál ≠ kópia · overená kópia · úradný preklad",
