      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kedy? Prvého mája",
          "text": "На питання «kedy?» дата, як і в українській, стоїть у родовому: «prvého mája» — першого травня. Порядкові числівники: prvého, druhého, tretieho, štvrtého, piateho, šiesteho, siedmeho, ôsmeho, deviateho, desiateho… dvadsiateho, tridsiateho. На письмі — крапка: «5. 3.» читаємо «piateho marca».",
          "examples": [
            {
              "sk": "Narodil som sa dvanásteho apríla.",
              "uk": "Я народився дванадцятого квітня."
            },
            {
              "sk": "Prídem tretieho októbra.",
              "uk": "Я приїду третього жовтня."
            }
          ],
          "shortRule": "kedy? → -ého + місяць у родовому",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Місяці в родовому",
          "text": "Назви місяців — чоловічого роду, у родовому мають -a: januára, februára, marca, apríla, mája, júna, júla, augusta, septembra, októbra, novembra, decembra. Складені числа: «dvadsiateho prvého júna» (21 червня). Рік читаємо окремо: «pätnásteho mája 2026» або «v roku 2026».",
          "examples": [
            {
              "sk": "Deň nezávislosti Ukrajiny oslavujeme dvadsiateho štvrtého augusta.",
              "uk": "День незалежності України ми святкуємо двадцять четвертого серпня."
            },
            {
              "sk": "Dovolenku mám od prvého do pätnásteho júla.",
              "uk": "Відпустку маю з першого до п’ятнадцятого липня."
            }
          ],
          "shortRule": "mája, júna, júla, augusta…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Od, do, začiatok, koniec",
          "text": "«Od pondelka do piatku», «od 1. do 15. júla». «Do konca mesiaca» — до кінця місяця, «na začiatku roka» — на початку року, «v polovici mája» — у середині травня. У документах: «platnosť do 31. 12. 2027» — дійсний до…, «dátum splatnosti» — кінцевий термін оплати.",
          "examples": [
            {
              "sk": "Nájom treba zaplatiť do piateho dňa v mesiaci.",
              "uk": "Оренду треба сплатити до п’ятого числа місяця."
            },
            {
              "sk": "Na začiatku septembra začína škola.",
              "uk": "На початку вересня починається школа."
            }
          ],
          "shortRule": "do konca / od začiatku + родовий",
          "commonMistakes": [
            {
              "mistake": "prvý mája",
              "correct": "prvého mája"
            },
            {
              "mistake": "desiateho máj",
              "correct": "desiateho mája"
            },
            {
