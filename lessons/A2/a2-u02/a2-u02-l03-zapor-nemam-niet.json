      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nemám + знахідний",
          "text": "Українською «не маю часу, грошей» — родовий. Словацькою після «nemám» відмінок не змінюється — так само, як після «mám», ставимо знахідний: «Mám čas → Nemám čas», «Mám auto → Nemám auto», «Mám sestru → Nemám sestru». Форма «nemám času» звучить застаріло.",
          "examples": [
            {
              "sk": "Dnes nemám čas.",
              "uk": "Сьогодні в мене немає часу."
            },
            {
              "sk": "Nemáme peniaze na nové auto.",
              "uk": "Не маємо грошей на нову машину."
            }
          ],
          "shortRule": "nemám + той самий відмінок, що й після mám",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nie je + називний",
          "text": "«Тут немає магазину» — «Nie je tu obchod» (називний!). «Šéf nie je v kancelárii» — шефа немає в кабінеті. Для множини — «nie sú»: «Kolegovia ešte nie sú v práci». Часто додають «žiadny»: «Nie je tu žiadny obchod».",
          "examples": [
            {
              "sk": "V chladničke už nie je mlieko.",
              "uk": "У холодильнику вже немає молока."
            },
            {
              "sk": "Kolegovia ešte nie sú v práci.",
              "uk": "Колег ще немає на роботі."
            }
          ],
          "shortRule": "nie je / nie sú + називний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де родовий залишився",
          "text": "Родовий у запереченні трапляється в кількох випадках: 1) «niet» + родовий (книжне, експресивне): «Niet času» — немає часу, «Niet divu» — не дивно; 2) після слів кількості: «Nemám veľa času», «Nemáme dosť miesta»; 3) займенник «nikoho»: «Nikoho tu nepoznám».",
          "examples": [
            {
              "sk": "Nemám veľa práce.",
              "uk": "У мене небагато роботи."
            },
            {
              "sk": "Niet divu, že je unavený.",
              "uk": "Не дивно, що він утомлений."
            }
          ],
          "shortRule": "niet / veľa / dosť / nikoho → родовий",
          "commonMistakes": [
            {
              "mistake": "Nemám času.",
              "correct": "Nemám čas."
            },
