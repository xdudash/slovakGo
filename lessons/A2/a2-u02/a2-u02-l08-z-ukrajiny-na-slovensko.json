      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Z Ukrajiny",
          "text": "«Odkiaľ ste?» — «Som z Ukrajiny, z Charkova.» «Pochádzam z…» — я родом з… Українські міста словацькою: «z Kyjeva, z Charkova, z Odesy, z Dnipra, z Užhorodu». Перед s, z, š, ž — «zo»: «zo Slovenska, zo Zvolena».",
          "examples": [
            {
              "sk": "Pochádzam z Ukrajiny, z Poltavy.",
              "uk": "Я родом з України, з Полтави."
            },
            {
              "sk": "Kolega je zo Slovenska, zo Zvolena.",
              "uk": "Колега зі Словаччини, зі Зволена."
            }
          ],
          "shortRule": "z / zo + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na Slovensko, ale do Česka",
          "text": "До більшості країн і міст їдемо з «do»: «do Česka, do Poľska, do Rakúska, do Bratislavy». Словаччина й Україна традиційно мають «na»: «ísť na Slovensko» (знахідний), «žiť na Slovensku», «vrátiť sa na Ukrajinu». Але звідки — завжди «z / zo» + родовий: «zo Slovenska», «z Ukrajiny».",
          "examples": [
            {
              "sk": "Na Slovensko sme prišli v roku 2022.",
              "uk": "До Словаччини ми приїхали у 2022 році."
            },
            {
              "sk": "V lete idem do Poľska.",
              "uk": "Улітку я їду до Польщі."
            }
          ],
          "shortRule": "na Slovensko, do Česka; zo Slovenska, z Česka",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Назви в множині",
          "text": "Деякі назви вживаються лише в множині, і їхній родовий не має закінчення: «Košice → do Košíc», «Michalovce → z Michaloviec», «Tatry → do Tatier», «Piešťany → do Piešťan». Назви з прикметником змінюють обидва слова: «Banská Bystrica → do Banskej Bystrice», «Nové Zámky → z Nových Zámkov».",
          "examples": [
            {
              "sk": "Autobus ide z Užhorodu do Košíc.",
              "uk": "Автобус їде з Ужгорода до Кошиць."
            },
            {
              "sk": "V lete ideme do Tatier.",
              "uk": "Улітку ми їдемо в Татри."
            }
