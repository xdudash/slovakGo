      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Do і z / zo",
          "text": "«Do» — куди (всередину): «do práce, do obchodu, do Bratislavy». Також до певного часу: «do piatku», «do ôsmej». «Z» — звідки (зсередини): «z práce, z obchodu». Перед s, z, š, ž і деякими групами приголосних — «zo»: «zo školy, zo Žiliny, zo stanice».",
          "examples": [
            {
              "sk": "Idem do lekárne.",
              "uk": "Іду в аптеку."
            },
            {
              "sk": "Z práce sa vraciam o piatej.",
              "uk": "З роботи я повертаюся о п’ятій."
            }
          ],
          "shortRule": "do ↔ z / zo",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "U і od",
          "text": "«U» — у когось, біля когось (де?): «u lekára» — у лікаря, «u babky» — у бабусі, «u nás» — у нас. «Od» — від когось (звідки?): «Idem od lekára» — іду від лікаря, «list od mamy» — лист від мами. Також «od» — відколи: «od rána», «od pondelka do piatku».",
          "examples": [
            {
              "sk": "Bol som u zubára.",
              "uk": "Я був у стоматолога."
            },
            {
              "sk": "Mám správu od šéfa.",
              "uk": "У мене повідомлення від шефа."
            }
          ],
          "shortRule": "u — де? od — від кого? відколи?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Bez",
          "text": "«Bez» — без, як в українській, із родовим: «káva bez cukru», «bez problémov», «bez dokladu». Корисні вирази: «bez obáv» — не хвилюйтеся, «bez výnimky» — без винятку.",
          "examples": [
            {
              "sk": "Čaj bez cukru, prosím.",
              "uk": "Чай без цукру, будь ласка."
            },
            {
              "sk": "Bez preukazu vás nepustia.",
              "uk": "Без посвідчення вас не пропустять."
            }
          ],
          "shortRule": "bez + родовий",
          "commonMistakes": [
            {
              "mistake": "Idem v obchod.",
              "correct": "Idem do obchodu."
            },
            {
              "mistake": "z školy",
              "correct": "zo školy"
            },
            {
              "mistake": "Som v lekára.",
              "correct": "Som u lekára."
            }
          ],
          "button": "Далі →"
        }
      ],
