      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kilo, deka, deci",
          "text": "Після слів міри — родовий: «kilo cukru», «liter mlieka», «fľaša vody». Словаки важать сир і ковбасу в «deka» (10 грамів): «desať deka syra» — 100 г сиру, «tridsať deka salámy» — 300 г салямі. Вино в барі — у «deci» (0,1 л): «dve deci vína». «Pol kila» — пів кілограма.",
          "examples": [
            {
              "sk": "Prosím si dvadsať deka šunky.",
              "uk": "Дайте, будь ласка, 200 грамів шинки."
            },
            {
              "sk": "Pol kila cukru, prosím.",
              "uk": "Пів кіло цукру, будь ласка."
            }
          ],
          "shortRule": "міра + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Šálka, pohár, kúsok",
          "text": "У кав’ярні й удома: «šálka kávy, čaju», «pohár vody, džúsu», «kus koláča» (шматок пирога), «kúsok chleba». Коли замовляємо, перше слово стоїть у знахідному, друге — у родовому: «Dám si šálku čaju».",
          "examples": [
            {
              "sk": "Dám si pohár vody.",
              "uk": "Я візьму склянку води."
            },
            {
              "sk": "Ešte kúsok koláča?",
              "uk": "Ще шматочок пирога?"
            }
          ],
          "shortRule": "šálka + родовий; dám si šálku…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Veľa, málo, dosť, trochu",
          "text": "«Veľa práce» — багато роботи, «málo času» — мало часу, «dosť miesta» — досить місця, «trochu soli» — трохи солі. З незлічуваними іменниками — родовий однини. «Množstvo» — кількість: «veľké množstvo vody».",
          "examples": [
            {
              "sk": "V lete máme veľa práce.",
              "uk": "Улітку в нас багато роботи."
            },
            {
              "sk": "Na parkovisku je dosť miesta.",
              "uk": "На парковці достатньо місця."
            }
          ],
          "shortRule": "veľa / málo / dosť / trochu + родовий",
