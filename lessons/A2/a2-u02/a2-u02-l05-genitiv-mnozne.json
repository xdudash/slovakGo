      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від п’яти й більше",
          "text": "«Dva roky, tri eurá, štyri ženy» — називний. Від п’яти, а також після «veľa, málo, niekoľko, pár, koľko» — родовий множини: «päť rokov, desať eur, veľa žien». Як в українській: два роки — п’ять років.",
          "examples": [
            {
              "sk": "Mám dve eurá, ale potrebujem päť eur.",
              "uk": "Маю два євро, а треба п’ять."
            },
            {
              "sk": "Koľko ľudí tu pracuje?",
              "uk": "Скільки людей тут працює?"
            }
          ],
          "shortRule": "2–4 + називний, 5+ + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чоловічий рід: -ov",
          "text": "Більшість іменників чоловічого роду мають -ov: «rok → rokov», «muž → mužov», «kolega → kolegov», «zamestnanec → zamestnancov», «týždeň → týždňov». Окремі мають -í: «deň → dní», «hosť → hostí», «ľudia → ľudí». Прикметники в множині — -ých / -ich: «nových, cudzích».",
          "examples": [
            {
              "sk": "Pracujem tu sedem rokov.",
              "uk": "Я працюю тут сім років."
            },
            {
              "sk": "Dovolenka trvá desať dní.",
              "uk": "Відпустка триває десять днів."
            }
          ],
          "shortRule": "-ov, але dní, ľudí",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Жіночий і середній рід: без закінчення",
          "text": "Закінчення зникає, а голосний основи часто подовжується або з’являється вставний голосний: «žena → žien», «ulica → ulíc», «hodina → hodín», «minúta → minút», «euro → eur», «mesto → miest», «auto → áut», «okno → okien», «sestra → sestier», «jablko → jabĺk». Слова на приголосний і на -ie — -í: «vec → vecí», «námestie → námestí». Особливі: «deti → detí», «peniaze → peňazí».",
          "examples": [
            {
              "sk": "V kancelárii pracuje osem žien.",
              "uk": "У кабінеті працює вісім жінок."
            },
            {
              "sk": "Nitra má veľa pekných ulíc.",
              "uk": "У Нітрі багато гарних вулиць."
            }
          ],
          "shortRule": "žien, miest, ulíc, eur",
          "commonMistakes": [
            {
              "mistake": "päť euro",
              "correct": "päť eur"
            },
            {
              "mistake": "desať roky",
              "correct": "desať rokov"
            },
            {
              "mistake": "veľa ženy",
              "correct": "veľa žien"
            }
          ],
          "button": "Далі →"
        }
      ],
