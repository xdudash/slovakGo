      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Жіночий рід",
          "text": "Родовий відповідає на питання «koho? čoho?» — кого? чого? Іменники з твердою основою на -a отримують -y: «žena → ženy», «kniha → knihy», «voda → vody». М’які основи (-ca, -ia, -ňa, -ľa…) отримують -e: «ulica → ulice», «stanica → stanice», «kancelária → kancelárie», «práca → práce». Іменники на -sť — -i: «kosť → kosti», «radosť → radosti».",
          "examples": [
            {
              "sk": "názov ulice",
              "uk": "назва вулиці"
            },
            {
              "sk": "fľaša vody",
              "uk": "пляшка води"
            }
          ],
          "shortRule": "-a → -y (тверді) / -e (м’які), -sť → -i",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чоловічий рід",
          "text": "Живі (люди, тварини) завжди мають -a: «brat → brata», «otec → otca», «sused → suseda». Іменники на -a, як «kolega», мають -u: «kolegu». Неживі найчастіше мають -u: «dom → domu», «čaj → čaju», «obchod → obchodu». Але частина неживих має -a: «stôl → stola», «chlieb → chleba», «syr → syra», а також слова часу: «rok → roka», «týždeň → týždňa», «deň → dňa». Сумнівну форму перевір у словнику.",
          "examples": [
            {
              "sk": "auto brata",
              "uk": "машина брата"
            },
            {
              "sk": "kúsok syra",
              "uk": "шматочок сиру"
            }
          ],
          "shortRule": "живі -a, неживі -u або -a",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Середній рід і прикметники",
          "text": "Середній рід на -o, -e, -ie отримує -a: «mesto → mesta», «more → mora», «námestie → námestia». Прикметники чоловічого й середнього роду мають -ého (м’які -ieho): «nový dom → nového domu», «cudzí → cudzieho». Жіночий рід — -ej: «nová ulica → novej ulice». Займенники: «môjho, tvojho, toho» / «mojej, tvojej, tej».",
          "examples": [
            {
              "sk": "stred mesta",
              "uk": "центр міста"
            },
            {
              "sk": "adresa novej firmy",
              "uk": "адреса нової фірми"
            }
          ],
          "shortRule": "-ého / -ej + іменник",
          "commonMistakes": [
            {
              "mistake": "auto môj brat",
              "correct": "auto môjho brata"
            },
