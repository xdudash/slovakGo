      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Auto kamaráta",
          "text": "Приналежність — родовий відмінок після іменника: «auto kamaráta» — машина друга, «izba syna» — кімната сина, «kancelária šéfa» — кабінет шефа. Як і в українській, родовий стоїть після головного слова: «telefón kolegyne». Питання — «čí? čia? čie?» (чий? чия? чиє?).",
          "examples": [
            {
              "sk": "Toto je kabát kolegu.",
              "uk": "Це пальто колеги."
            },
            {
              "sk": "Čie je to auto? — Suseda.",
              "uk": "Чия це машина? — Сусіда."
            }
          ],
          "shortRule": "іменник + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Môjho brata, mojej sestry",
          "text": "Із займенником і прикметником: «auto môjho brata», «byt mojej sestry», «číslo nášho suseda», «adresa našej firmy». Множина: «izba mojich detí», «dom rodičov».",
          "examples": [
            {
              "sk": "Bývam v byte mojej tety.",
              "uk": "Я живу у квартирі моєї тітки."
            },
            {
              "sk": "Je to auto nášho šéfa.",
              "uk": "Це машина нашого шефа."
            }
          ],
          "shortRule": "môjho, nášho / mojej, našej / mojich, našich",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Bratov, sestrin",
          "text": "У розмові можна сказати й присвійним прикметником: «bratov» (братів), «sestrin» (сестрин): «bratovo auto» — те саме, що «auto brata», «sestrina izba» — те саме, що «izba sestry». Якщо слів кілька — тільки родовий: «auto môjho staršieho brata». У документах завжди родовий: «meno majiteľa», «podpis nájomcu».",
          "examples": [
            {
