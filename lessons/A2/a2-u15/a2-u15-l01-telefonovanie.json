      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Začiatok hovoru",
          "text": "Коли піднімаєш слухавку («zdvihnúť telefón»), кажи «Prosím?» або «Haló?»; у фірмі — назву фірми та ім’я: «Firma Domstav, pri telefóne Jana Kováčová.» Коли дзвониш ти, привітайся й назви себе: «Dobrý deň, tu je Oksana Melnyk.» Якщо не знаєш, хто дзвонить, запитай: «S kým hovorím, prosím?» Сама розмова — «telefonát», дзвінок як подія — «hovor»: «prichádzajúci hovor» (вхідний дзвінок).",
          "examples": [
            {
              "sk": "Pri telefóne Ivan Bondar.",
              "uk": "Біля телефону Іван Бондар."
            },
            {
              "sk": "S kým hovorím, prosím?",
              "uk": "З ким я розмовляю, будь ласка?"
            }
          ],
          "shortRule": "Prosím? / Haló? · Tu je + ім’я",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Komu volám",
          "text": "«Volať / zavolať» + давальний — кому телефонуєш: «Zavolám mame.», «Zavolajte pánovi Horvátovi.» Куди? — «na číslo», «na klapku», «do firmy». Якщо потрібна інша людина, попроси: «Môžete ma prepojiť na pani Novákovú?» (prepojiť na + знахідний). Секретарка відповідає: «Moment, prepájam.» — Хвилинку, з’єдную.",
          "examples": [
            {
              "sk": "Zavolám ti večer.",
              "uk": "Я подзвоню тобі ввечері."
            },
            {
              "sk": "Prepojím vás na účtovníčku.",
              "uk": "Я з’єднаю вас із бухгалтеркою."
            }
          ],
          "shortRule": "zavolať komu? · prepojiť na koho?",
          "commonMistakes": [
            {
              "mistake": "Zavolám pán Horvát.",
              "correct": "Zavolám pánovi Horvátovi."
            },
            {
              "mistake": "Prepojte ma na pán Kráľ.",
              "correct": "Prepojte ma na pána Kráľa."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zlé spojenie",
          "text": "Коли погано чути: «Zle vás počujem.», «Máte slabý signál.», «Vypadol mi signál.» Якщо зв’язок обірвався: «Hovor sa prerušil.» Попроси: «Môžete hovoriť hlasnejšie?» або пообіцяй: «Zavolám vám o chvíľu znova.» Наприкінці розмови кажи «Dopočutia!» — це телефонне «до побачення».",
          "examples": [
            {
              "sk": "Prepáčte, zle vás počujem.",
              "uk": "Вибачте, я вас погано чую."
            },
            {
              "sk": "Ďakujem, dopočutia!",
              "uk": "Дякую, до побачення!"
            }
          ],
          "shortRule": "Dopočutia — тільки по телефону",
          "button": "Далі →"
        }
      ],
