      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Musím to zrušiť",
          "text": "«Zrušiť» — скасувати, «presunúť» — перенести. Іменник — «zrušenie»: «zrušenie termínu», «zrušenie objednávky». Почни ввічливо: «Žiaľ, musím zrušiť náš termín.», «Prepáčte, zajtra nemôžem prísť.» Часто є умови: «Zrušenie najneskôr 24 hodín pred termínom je bezplatné.»",
          "examples": [
            {
              "sk": "Žiaľ, zajtrajšie stretnutie musím zrušiť.",
              "uk": "На жаль, завтрашню зустріч мушу скасувати."
            },
            {
              "sk": "Zrušenie je bezplatné.",
              "uk": "Скасування безкоштовне."
            }
          ],
          "shortRule": "žiaľ / bohužiaľ + musím zrušiť",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Prečo a prepáčte",
          "text": "Коротко поясни причину: «Ochorelo mi dieťa.», «Mám zmenu do šiestej, nestihnem to.» «Nestihnúť» — не встигнути: «Nestihnem to.» (майбутній час доконаного виду). Вибачення: «Mrzí ma to.» — мені шкода (mrzí + знахідний: ma, ťa, nás).",
          "examples": [
            {
              "sk": "Mrzí ma to, ale nestihnem prísť.",
              "uk": "Мені шкода, але я не встигну прийти."
            },
            {
              "sk": "Ochorel mi syn, preto nemôžem prísť.",
              "uk": "У мене захворів син, тому я не можу прийти."
            }
          ],
          "shortRule": "Mrzí ma to. · Nestihnem to.",
          "commonMistakes": [
            {
              "mistake": "Mrzí mi to.",
              "correct": "Mrzí ma to."
            },
            {
              "mistake": "Ja nestihnúť.",
              "correct": "Nestihnem to."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Náhradný termín",
          "text": "Одразу запропонуй інший час: «Mohli by sme to presunúť na pondelok?», «Máte nejaký náhradný termín?», «Hodí sa vám budúci týždeň?» Куди переносимо? — presunúť na + знахідний: «na pondelok», «na budúci týždeň», «na neskôr».",
          "examples": [
            {
              "sk": "Môžeme to presunúť na piatok?",
              "uk": "Можемо перенести це на п’ятницю?"
            },
            {
              "sk": "Ponúkli mi náhradný termín v stredu.",
              "uk": "Мені запропонували інший термін у середу."
            }
          ],
          "shortRule": "presunúť na + знахідний · náhradný termín",
          "button": "Далі →"
        }
      ],
