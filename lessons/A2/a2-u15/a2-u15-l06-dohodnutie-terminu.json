      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kedy sa vám hodí?",
          "text": "Запропонувати час: «Môžeme sa stretnúť v utorok o desiatej?», «Hodí sa vám štvrtok poobede?», «Vyhovuje vám piatok?» Кому підходить? — давальний: mi, ti, vám. Відповіді: «Áno, to mi vyhovuje.», «V utorok nemôžem, ale v stredu áno.», «Mne je to jedno, môžem kedykoľvek.»",
          "examples": [
            {
              "sk": "Hodí sa ti piatok večer?",
              "uk": "Тобі підходить п’ятниця ввечері?"
            },
            {
              "sk": "Kedy sa vám to hodí?",
              "uk": "Коли вам зручно?"
            }
          ],
          "shortRule": "hodí sa / vyhovuje + mi, ti, vám",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Čas presne",
          "text": "День: «v pondelok», «v stredu», але «vo štvrtok» (перед в- кажемо vo). Година: «o ôsmej», «o pol desiatej» (9:30), «o štvrť na tri» (2:15). Проміжок: «medzi ôsmou a desiatou» (орудний), «pred obedom», «po práci». «Najskôr» — найраніше: «Najskôr môžem v stredu.»",
          "examples": [
            {
              "sk": "Môžem prísť najskôr o piatej.",
              "uk": "Найраніше я можу прийти о п’ятій."
            },
            {
              "sk": "Príďte medzi deviatou a jedenástou.",
              "uk": "Приходьте між дев’ятою та одинадцятою."
            }
          ],
          "shortRule": "v / vo + день · o + година · medzi + орудний",
          "commonMistakes": [
            {
              "mistake": "v štvrtok",
              "correct": "vo štvrtok"
            },
            {
              "mistake": "o osem",
              "correct": "o ôsmej"
            },
            {
              "mistake": "medzi osem a desať",
              "correct": "medzi ôsmou a desiatou"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Potvrdenie",
          "text": "Наприкінці повтори домовленість: «Takže dohodnutý termín je štvrtok o pol tretej.», «Takže v stredu o deviatej, platí?» (домовились?). Щоб не забути: «Zapíšem si to do kalendára.» Можна попросити: «Pošlite mi to, prosím, aj e-mailom.»",
          "examples": [
            {
              "sk": "Takže v stredu o deviatej, platí?",
              "uk": "Отже, у середу о дев’ятій, домовились?"
            },
            {
              "sk": "Zapísala som si to do kalendára.",
              "uk": "Я записала це собі в календар."
            }
          ],
          "shortRule": "Takže… platí? · zapísať si do kalendára",
          "button": "Далі →"
        }
      ],
