      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Paušál alebo predplatenka",
          "text": "У Словаччині працює кілька мобільних операторів. Можна вибрати «paušál» — пакет хвилин, SMS і даних за фіксовану щомісячну плату (потрібен договір, рахунок приходить щомісяця), або «predplatenú kartu» (розмовно «predplatenka»): платиш наперед і «dobíjaš kredit» — поповнюєш рахунок.",
          "examples": [
            {
              "sk": "Mám paušál za pätnásť eur mesačne.",
              "uk": "У мене тариф за п’ятнадцять євро на місяць."
            },
            {
              "sk": "Kredit si dobíjam cez aplikáciu.",
              "uk": "Я поповнюю рахунок через застосунок."
            }
          ],
          "shortRule": "paušál — договір і щомісячна плата · predplatená karta — платиш наперед",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dáta a pokrytie",
          "text": "«Mobilné dáta» — мобільний інтернет: «Minuli sa mi dáta.» (закінчився інтернет), «neobmedzené dáta» (безлімітний інтернет). «Pokrytie» — покриття мережі: «V horách nie je pokrytie.» «Viazanosť» — мінімальний строк договору, напр. 24 місяці: якщо розірвеш договір раніше, заплатиш штраф.",
          "examples": [
            {
              "sk": "Minuli sa mi mobilné dáta.",
              "uk": "У мене закінчився мобільний інтернет."
            },
            {
              "sk": "Tu nie je dobré pokrytie.",
              "uk": "Тут погане покриття."
            }
          ],
          "shortRule": "minuli sa mi dáta · viazanosť 24 mesiacov",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zákaznícka linka",
          "text": "На лінії підтримки спершу говорить автомат: «Pre informácie o paušále stlačte jednotku.» (натисніть одиницю), «Pre spojenie s operátorom stlačte nulu.» Тут «operátor» — працівник лінії. Корисні фрази: «Chcel(a) by som si zmeniť paušál.», «Chcem si preniesť číslo k inému operátorovi.», «Aká dlhá je viazanosť?»",
          "examples": [
            {
              "sk": "Stlačte dvojku.",
              "uk": "Натисніть двійку."
            },
            {
              "sk": "Chcel by som si zmeniť paušál.",
              "uk": "Я хотів би змінити тариф."
            }
          ],
          "shortRule": "stlačiť jednotku / dvojku / nulu",
