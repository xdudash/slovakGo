      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "SMS, esemeska",
          "text": "«SMS» читається [es-em-es], у розмовній мові — «esemeska»: «Pošli mi esemesku.» Дієслова: «napísať» (написати), «poslať» (надіслати), «odpísať» (відписати), «preposlať» (переслати далі). Кому? — давальний: «Napíš mi.», «Pošlem Petrovi esemesku.»",
          "examples": [
            {
              "sk": "Pošli mi SMS, keď prídeš.",
              "uk": "Надішли мені SMS, коли прийдеш."
            },
            {
              "sk": "Preposlala som ti správu od šéfa.",
              "uk": "Я переслала тобі повідомлення від шефа."
            }
          ],
          "shortRule": "napísať / poslať / preposlať komu?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Chat a skupina",
          "text": "«Chat» читається [čet]: «na chate» (де?), «do chatu» (куди?), «v skupinovom chate». «Písať si s niekým» — листуватися з кимось. Замість тексту можна надіслати «hlasovú správu» (голосове повідомлення). Позначки в застосунку: «doručené» (доставлено), «prečítané» (прочитано), «píše…» (пише…).",
          "examples": [
            {
              "sk": "Píšem si s kamarátkou z Kyjeva.",
              "uk": "Я листуюся з подругою з Києва."
            },
            {
              "sk": "Pošli to do skupinového chatu.",
              "uk": "Надішли це в груповий чат."
            }
          ],
          "shortRule": "písať si s kým? · na chate · do chatu",
          "commonMistakes": [
            {
              "mistake": "Pošli ma esemesku.",
              "correct": "Pošli mi esemesku."
            },
            {
              "mistake": "Píšem s kamarátkou.",
              "correct": "Píšem si s kamarátkou."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Krátko a neformálne",
          "text": "Повідомлення друзям короткі: «Ahoj, už idem.», «Ok, dík!», «Meškám 10 min.», «Kde si?» Часті скорочення: «napr.» (napríklad — наприклад), «dík» (дякую), «čau» (привіт або бувай). Усміхнене обличчя — «smajlík». Шефові чи в установу так не пиши: там потрібні привітання, повні слова й увічлива форма на «vy».",
          "examples": [
            {
              "sk": "Meškám desať minút, prepáč!",
              "uk": "Запізнююсь на десять хвилин, вибач!"
            },
            {
              "sk": "Dobrý deň, prídem o desať minút neskôr.",
              "uk": "Добрий день, я прийду на десять хвилин пізніше."
            }
          ],
          "shortRule": "другові — коротко · шефові — повністю й увічливо",
          "button": "Далі →"
        }
      ],
