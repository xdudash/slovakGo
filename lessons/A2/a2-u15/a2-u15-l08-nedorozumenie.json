      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nerozumiem",
          "text": "Коли не розумієш, не мовчи: «Prepáčte, nerozumiem.», «Môžete to zopakovať pomalšie?», «Môžete to povedať znova?» Якщо незрозумілий зміст: «Ako to myslíte?» (що ви маєте на увазі?), «Môžete to upresniť?» (уточнити).",
          "examples": [
            {
              "sk": "Môžete to, prosím, upresniť?",
              "uk": "Можете, будь ласка, уточнити?"
            },
            {
              "sk": "Ako to myslíte?",
              "uk": "Що ви маєте на увазі?"
            }
          ],
          "shortRule": "Ako to myslíte? · Môžete to upresniť?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Overiť si",
          "text": "Повтори своїми словами, щоб перевірити: «Takže…?», «Rozumiem správne, že prídete v stredu?», «Povedali ste pätnásť alebo päťdesiat?» Легко переплутати («zameniť») числа: štrnásť (14) — štyridsať (40), pätnásť (15) — päťdesiat (50), šestnásť (16) — šesťdesiat (60). Номери краще диктувати по цифрах: «jedna, štyri».",
          "examples": [
            {
              "sk": "Rozumiem správne, že stretnutie je o pol piatej?",
              "uk": "Я правильно розумію, що зустріч о пів на п’яту?"
            },
            {
              "sk": "Povedali ste pätnásť alebo päťdesiat?",
              "uk": "Ви сказали п’ятнадцять чи п’ятдесят?"
            }
          ],
          "shortRule": "-násť = 11–19 · -dsiat / -desiat = десятки",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Omyl",
          "text": "Якщо сталася помилка: «To je omyl.», «Asi došlo k nedorozumeniu.» (мабуть, сталося непорозуміння), «Zamenil som dátumy.» (я переплутав дати), «Myslela som, že stretnutie je v utorok.», «Prepáčte za zmätok.» (вибачте за плутанину).",
          "examples": [
            {
              "sk": "Prepáčte, to bol omyl.",
              "uk": "Вибачте, це була помилка."
            },
            {
              "sk": "Zamenila som utorok a štvrtok.",
              "uk": "Я переплутала вівторок і четвер."
            }
          ],
          "shortRule": "došlo k nedorozumeniu · zameniť + знахідний",
