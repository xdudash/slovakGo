      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Oslovenie a záver",
          "text": "Офіційний лист починаємо: «Dobrý deň,» (найнейтральніше), «Vážená pani Kováčová,», «Vážený pán Novák,»; якщо не знаєш імені — «Vážená pani, vážený pán,». Закінчуємо: «S pozdravom» (найчастіше) або «S úctou» (дуже офіційно), далі ім’я та контакт. Займенники «Vy, Vás, Vám, Váš» у листі пишемо з великої літери.",
          "examples": [
            {
              "sk": "Vážená pani Kováčová, obraciam sa na Vás s prosbou.",
              "uk": "Шановна пані Ковачова, звертаюся до Вас із проханням."
            },
            {
              "sk": "S úctou Oleh Kravec",
              "uk": "З повагою Олег Кравець"
            }
          ],
          "shortRule": "Dobrý deň / Vážená pani… → S pozdravom / S úctou",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Prečo píšem",
          "text": "Мету називай одразу: «Obraciam sa na Vás s otázkou / s prosbou / so žiadosťou.» (obrátiť sa na koho? + s čím? — орудний), «Píšem Vám ohľadom zmluvy.» (ohľadom + родовий), «Chcel(a) by som sa opýtať, či…». Прохання — в умовному способі: «Mohli by ste mi zaslať formulár?»",
          "examples": [
            {
              "sk": "Píšem Vám ohľadom nájomnej zmluvy.",
              "uk": "Пишу Вам щодо договору оренди."
            },
            {
              "sk": "Mohli by ste mi zaslať formulár?",
              "uk": "Чи не могли б Ви надіслати мені формуляр?"
            }
          ],
          "shortRule": "obrátiť sa na + знахідний · ohľadom + родовий",
          "commonMistakes": [
            {
              "mistake": "Obraciam sa na Vás s prosbu.",
              "correct": "Obraciam sa na Vás s prosbou."
            },
            {
              "mistake": "Píšem Vám ohľadom zmluva.",
              "correct": "Píšem Vám ohľadom zmluvy."
            },
            {
              "mistake": "Ahoj, pani Kováčová,",
              "correct": "Dobrý deň, pani Kováčová,"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Príloha a záver",
          "text": "Корисні фрази: «V prílohe Vám zasielam…» (у вкладенні надсилаю Вам…), «Uvedený termín mi nevyhovuje.» (зазначений термін мені не підходить), «V prípade otázok som Vám k dispozícii.» (якщо будуть питання, я до Ваших послуг), «Vopred ďakujem za odpoveď.» «Zaslať» — офіційніше, ніж «poslať».",
          "examples": [
            {
              "sk": "V prílohe Vám zasielam potvrdenie o pobyte.",
              "uk": "У вкладенні надсилаю Вам підтвердження про перебування."
            },
            {
              "sk": "Vopred ďakujem za odpoveď.",
              "uk": "Заздалегідь дякую за відповідь."
            }
          ],
          "shortRule": "V prílohe Vám zasielam… · Vopred ďakujem…",
          "button": "Далі →"
        }
