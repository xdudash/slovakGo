      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Oslovenie",
          "text": "Звертання («oslovenie») у дружньому листі: «Ahoj Mária,», «Milá Zuzka,», «Milý Peter,», кільком людям — «Ahojte,» або «Milí priatelia,». Увага: у словацькій немає кличного відмінка, як в українській: пишемо «Milý Peter», а не «Petre», «Milá Oksana», а не «Oksano».",
          "examples": [
            {
              "sk": "Milá Zuzka, ďakujem za fotky z výletu.",
              "uk": "Люба Зузко, дякую за фото з поїздки."
            },
            {
              "sk": "Ahojte, ako sa máte?",
              "uk": "Привіт усім, як справи?"
            }
          ],
          "shortRule": "Milý / Milá + ім’я в називному відмінку",
          "commonMistakes": [
            {
              "mistake": "Milý Petre,",
              "correct": "Milý Peter,"
            },
            {
              "mistake": "Milá Oksano,",
              "correct": "Milá Oksana,"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Novinky a pozdravy",
          "text": "Після звертання — питання й новини: «Čo je u teba nové?», «Mám pre teba novinku.», «Prepáč, že píšem až teraz.» Передати вітання: «Pozdravuj mamu.» або «Daj pozdravovať rodičov.» (кого? — знахідний), а «Mama ťa pozdravuje.» — мама передає тобі вітання.",
          "examples": [
            {
              "sk": "Čo je u teba nové?",
              "uk": "Що в тебе нового?"
            },
            {
              "sk": "Daj pozdravovať celú rodinu!",
              "uk": "Передавай вітання всій родині!"
            }
          ],
          "shortRule": "pozdravuj / daj pozdravovať + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Koniec a adresa",
          "text": "Закінчення: «Maj sa (pekne)!», «Ozvi sa.», «Teším sa na tvoju odpoveď.», «Objímam» (обіймаю), далі ім’я. Диктуєш адресу так: «@» — «zavináč», «.» — «bodka», «-» — «pomlčka». «Predmet» — тема листа, «príloha» — вкладений файл.",
          "examples": [
            {
              "sk": "Moja e-mailová adresa je oksana.melnyk@posta.sk.",
              "uk": "Моя електронна адреса — oksana.melnyk@posta.sk."
            },
            {
              "sk": "Maj sa pekne a ozvi sa!",
              "uk": "Бувай і пиши!"
            }
          ],
          "shortRule": "Maj sa · Ozvi sa · Objímam",
          "button": "Далі →"
        }
      ],
