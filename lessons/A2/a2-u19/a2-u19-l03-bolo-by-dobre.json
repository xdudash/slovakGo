      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Bolo by dobré + інфінітив",
          "text": "Безособова форма — м’яка порада для всіх: «Bolo by dobré prísť skôr.» (Було б добре прийти раніше.) Так само «Bolo by lepšie…» (краще було б), «Bolo by fajn…» (було б класно — розмовно), «Bolo by treba…» (треба було б). Форма завжди «bolo» — середній рід.",
          "examples": [
            {
              "sk": "Bolo by dobré zavolať šéfovi.",
              "uk": "Було б добре зателефонувати шефові."
            },
            {
              "sk": "Bolo by lepšie ísť vlakom.",
              "uk": "Краще було б поїхати поїздом."
            }
          ],
          "shortRule": "Bolo by dobré / lepšie / fajn + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nebolo by lepšie…? Čo keby sme…?",
          "text": "Пропозиція у формі запитання звучить ще м’якше: «Nebolo by lepšie ísť pešo?» (А чи не краще піти пішки?). Друзям часто кажуть «Čo keby sme…?» — А що, якби ми…?: «Čo keby sme išli do kina?» Після «keby sme» — l-форма: išli, šli, zostali.",
          "examples": [
            {
              "sk": "Nebolo by lepšie zostať doma?",
              "uk": "А чи не краще залишитися вдома?"
            },
            {
              "sk": "Čo keby sme išli na výlet?",
              "uk": "А що, якби ми кудись поїхали на екскурсію?"
            }
          ],
          "shortRule": "Nebolo by lepšie…? · Čo keby sme + l-форма?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "To by bolo fajn!",
          "text": "Відповідь на пропозицію: «To by bolo fajn!», «To by bolo super!», «To by nebolo zlé.» (непогано було б). Слово «to» стоїть першим, тому «by» — одразу після нього: «To by bolo…», не «To bolo by…». Відмова: «Radšej nie.», «Tento týždeň to nepôjde.»",
          "examples": [
            {
              "sk": "To by bolo fajn!",
              "uk": "Це було б класно!"
            },
            {
              "sk": "To by nebolo zlé.",
              "uk": "Було б непогано."
            }
