      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nedali by ste si…?",
          "text": "Найчастіше пропонують через «dať si» (з’їсти, випити): «Dáte si kávu?» — нейтрально, «Nedali by ste si kávu?» — дуже ввічливо. Другові: «Nedal by si si čaj?» — тут два «si»: перше — «ти» (by si), друге — від «dať si». Ще так: «Môžem vám ponúknuť…?»",
          "examples": [
            {
              "sk": "Nedali by ste si pohár vody?",
              "uk": "Чи не випили б ви склянку води?"
            },
            {
              "sk": "Nedala by si si kúsok koláča?",
              "uk": "Може, з’їси шматочок пирога?"
            }
          ],
          "shortRule": "Nedali by ste si + знахідний?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Áno, rád — Nie, ďakujem",
          "text": "Погодитися: «Áno, rád / rada.», «Dal by som si, ďakujem.», «To by bolo milé.» Відмовитися: «Nie, ďakujem, už nič.», «Ďakujem, rád by som, ale už musím ísť.» У Словаччині господарі часто пропонують двічі-тричі — це гостинність, а не нав’язливість.",
          "examples": [
            {
              "sk": "Dala by som si čaj, ďakujem.",
              "uk": "Я б випила чаю, дякую."
            },
            {
              "sk": "Ďakujem, rád by som, ale šoférujem.",
              "uk": "Дякую, я б охоче, але я за кермом."
            }
          ],
          "shortRule": "rád by som, ale… — увічлива відмова",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ponúknite sa! Môžem vám pomôcť?",
          "text": "«Ponúknite sa!» (до друга «Ponúkni sa!») — пригощайтеся!: «Ponúknite sa koláčom.» Запропонувати допомогу: «Môžem vám pomôcť?», «Mám vám pomôcť s taškou?» Відповідь: «To je od vás milé, ďakujem.»",
          "examples": [
            {
              "sk": "Ponúknite sa, prosím!",
              "uk": "Пригощайтеся, будь ласка!"
            },
            {
              "sk": "Ochotne vám pomôžem.",
              "uk": "Я охоче вам допоможу."
            }
          ],
          "shortRule": "Ponúknite sa + орудний (koláčom)",
          "commonMistakes": [
            {
