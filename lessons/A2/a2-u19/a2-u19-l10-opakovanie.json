      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Forma a slovosled",
          "text": "l-форма + by + som / si / sme / ste: chcel by som, mohli by ste, bolo by. «By» — завжди на другому місці: «Chcel by som…», «Ja by som chcel…», «To by bolo fajn», «Na tvojom mieste by som…». «Sa / si» — після нього: «Dal by som si…». «Keby» вже містить «by»: «keby som», ніколи «keby by som».",
          "examples": [
            {
              "sk": "Ja by som si dal čaj.",
              "uk": "Я б випив чаю."
            },
            {
              "sk": "Keby som mal čas, prišiel by som.",
              "uk": "Якби я мав час, я прийшов би."
            }
          ],
          "shortRule": "by — 2-ге місце · keby som (без by)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ktorá fráza kedy",
          "text": "Хочеш — «Chcel(a) by som…». Просиш — «Mohli by ste…?», «Boli by ste taký láskavý a…?». Питаєш дозволу — «Nevadilo by vám…?». Радиш — «Na tvojom mieste by som…», «Mal by si…», «Bolo by dobré…». Пропонуєш — «Nedali by ste si…?». Питаєш про можливість — «Bolo by možné…?». Мрієш — «Rád by som…», «Kiežby…!».",
          "examples": [
            {
              "sk": "Nevadilo by vám, keby som zavrel okno?",
              "uk": "Ви не заперечуєте, якщо я зачиню вікно?"
            },
            {
              "sk": "Bolo by možné prísť zajtra?",
              "uk": "Чи можна було б прийти завтра?"
            }
          ],
          "shortRule": "ситуація → формула",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zdvorilosť na Slovensku",
          "text": "З незнайомими людьми, урядниками, офіціантами, лікарями говорять на «vy» (vykanie): «Chceli by ste…?» — форма на «-li» навіть до однієї людини. До жінки — «pani» + прізвище: «pani Nováková». Чарівні слова: «Prosím vás», «Prepáčte», «Ďakujem pekne». Коли тобі дякують — «Rado sa stalo.»",
          "examples": [
            {
              "sk": "Pani Nováková, chceli by ste ešte kávu?",
              "uk": "Пані Новакова, чи не хотіли б ви ще кави?"
            },
            {
              "sk": "Ďakujem pekne, ste veľmi láskavá.",
              "uk": "Щиро дякую, ви дуже люб’язні."
            }
          ],
          "shortRule": "vykanie: chceli by ste, mohli by ste",
          "button": "Далі →"
        }
      ],
