      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Na tvojom mieste by som…",
          "text": "Найтиповіша порада: «Na tvojom mieste by som…» — на твоєму місці я б… «Na tvojom mieste» — одна група, тому «by som» іде одразу після неї. Ввічливо: «Na vašom mieste by som…». Далі — l-форма: «…by som zavolal», «…by som počkala».",
          "examples": [
            {
              "sk": "Na tvojom mieste by som zavolal lekárovi.",
              "uk": "На твоєму місці я б зателефонував лікареві."
            },
            {
              "sk": "Na vašom mieste by som počkala.",
              "uk": "На вашому місці я б почекала."
            }
          ],
          "shortRule": "Na tvojom / vašom mieste + by som + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mal by si…",
          "text": "«Mal by si + інфінітив» — тобі слід, ти мав би: «Mal by si viac spať.» Заперечення: «Nemal by si…» — тобі не слід. Ввічливо: «Mali by ste…». Жінці: «Mala by si…».",
          "examples": [
            {
              "sk": "Mal by si viac oddychovať.",
              "uk": "Тобі слід більше відпочивати."
            },
            {
              "sk": "Nemali by ste riskovať.",
              "uk": "Вам не слід ризикувати."
            }
          ],
          "shortRule": "mal / mala / mali by + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Radiť, odporúčať",
          "text": "«Radiť» і «odporúčať» — кому? (давальний): «Radím ti…», «Odporúčam vám…» + інфінітив. З kondicionálom м’якше: «Odporúčal by som vám…». Попросити поради: «Čo by si mi poradil?», «Čo by ste mi odporučili?»",
          "examples": [
            {
              "sk": "Radím ti počkať do pondelka.",
              "uk": "Раджу тобі почекати до понеділка."
            },
            {
              "sk": "Čo by ste mi poradili?",
              "uk": "Що б ви мені порадили?"
            }
          ],
          "shortRule": "radiť / odporúčať + давальний (ti, vám)",
          "commonMistakes": [
            {
              "mistake": "Na tvojom mieste som by išiel.",
              "correct": "Na tvojom mieste by som išiel."
            },
            {
              "mistake": "Mal by si viac spíš.",
              "correct": "Mal by si viac spať."
            },
            {
              "mistake": "Radím ťa…",
              "correct": "Radím ti…"
            },
            {
              "mistake": "Odporúčam vás…",
              "correct": "Odporúčam vám…"
            }
          ],
          "button": "Далі →"
        }
      ],
