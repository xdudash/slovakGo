      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Rád by som…",
          "text": "«Rád by som…» — я охоче б…, я б із радістю…: «Rád by som cestoval.» Після «rád by som» іде l-форма, а не інфінітив! Rád / rada / radi узгоджуються з тим, хто говорить: «Rada by som…» (жінка), «Radi by sme…» (ми). «Najradšej by som…» — найбільше я хотів би.",
          "examples": [
            {
              "sk": "Rád by som býval pri mori.",
              "uk": "Я б охоче жив біля моря."
            },
            {
              "sk": "Najradšej by som teraz spala.",
              "uk": "Найбільше я зараз хотіла б спати."
            }
          ],
          "shortRule": "rád by som + l-форма (cestoval, býval)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kiežby…!",
          "text": "«Kiežby» — якби ж то…!, хоч би…!: «Kiežby už bolo leto!» Після «kiežby» — l-форма. Для «я» і «ти» додаємо «som / si»: «Kiežby som mal viac času!», «Kiežby si tu bol!»",
          "examples": [
            {
              "sk": "Kiežby som vedela lepšie po slovensky!",
              "uk": "Якби ж то я краще знала словацьку!"
            },
            {
              "sk": "Kiežby už bol piatok!",
              "uk": "Хоч би вже була п’ятниця!"
            }
          ],
          "shortRule": "kiežby (som) + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Sen, želanie, túžiť",
          "text": "«Mojím snom je…» (орудний!) — моя мрія — це…; «Moje najväčšie želanie je…» — моє найбільше бажання… «Túžiť po» + місцевий: «túžim po pokoji». Побажати іншим: «Prajem ti / vám…» + знахідний: «Prajem vám veľa zdravia.»",
          "examples": [
            {
              "sk": "Mojím snom je vlastný dom.",
              "uk": "Моя мрія — власний будинок."
            },
            {
              "sk": "Túžim po dovolenke.",
              "uk": "Я дуже хочу у відпустку."
            }
          ],
          "shortRule": "Mojím snom je… · túžiť po + місцевий",
          "commonMistakes": [
            {
              "mistake": "Rád by som cestovať.",
              "correct": "Rád by som cestoval."
            },
            {
              "mistake": "Kiežby som mám čas.",
              "correct": "Kiežby som mal čas."
            },
            {
              "mistake": "Môj snom je…",
              "correct": "Mojím snom je…"
            },
            {
              "mistake": "Túžim na pokoj.",
              "correct": "Túžim po pokoji."
            }
          ],
          "button": "Далі →"
        }
