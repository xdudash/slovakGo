      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Stôl a jedálny lístok",
          "text": "Без резервації: «Mali by ste voľný stôl pre dvoch / troch / štyroch?» (pre + знахідний чоловічої особової форми). Де сісти: «Mohli by sme si sadnúť k oknu / vonku?» Попросити меню: «Mohli by ste nám priniesť jedálny lístok?»",
          "examples": [
            {
              "sk": "Mali by ste voľný stôl pre štyroch?",
              "uk": "У вас знайшовся б вільний столик на чотирьох?"
            },
            {
              "sk": "Mohli by sme sedieť vonku?",
              "uk": "Можна нам сісти надворі?"
            }
          ],
          "shortRule": "pre dvoch · pre troch · pre štyroch",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dal by som si…",
          "text": "Офіціант питає: «Čo si dáte?», «Dáte si aj dezert?» Ти відповідаєш: «Dal(a) by som si…» + знахідний: «Dal by som si kuraciu polievku a rezeň.» Порада: «Čo by ste nám odporučili?» Особливі побажання: «Mali by ste aj niečo vegetariánske?»",
          "examples": [
            {
              "sk": "Dala by som si cesnačku.",
              "uk": "Я б узяла часникову юшку."
            },
            {
              "sk": "Čo by ste nám odporučili?",
              "uk": "Що б ви нам порадили?"
            }
          ],
          "shortRule": "Dal(a) by som si + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Platenie",
          "text": "Покликати офіціанта: «Prosím vás!». Рахунок: «Mohli by sme zaplatiť?» Офіціант спитає: «Spolu, alebo zvlášť?» — разом чи окремо. Чайові («prepitné») зазвичай 5–10 %: «To je v poriadku, zvyšok si nechajte.» — решти не треба. Чек — «účtenka».",
          "examples": [
            {
              "sk": "Platíme zvlášť, prosím.",
              "uk": "Ми платимо окремо, будь ласка."
            },
            {
              "sk": "Zvyšok si nechajte.",
              "uk": "Решту залиште собі."
            }
