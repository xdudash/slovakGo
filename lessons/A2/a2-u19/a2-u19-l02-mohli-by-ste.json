      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Mohli by ste…?",
          "text": "«Môžete mi pomôcť?» — нейтральне прохання. «Mohli by ste mi pomôcť?» — увічливіше. Після «mohli by ste» іде інфінітив. Другові: «Mohol by si…?» (чоловікові), «Mohla by si…?» (жінці).",
          "examples": [
            {
              "sk": "Mohli by ste zavrieť okno?",
              "uk": "Чи не могли б ви зачинити вікно?"
            },
            {
              "sk": "Mohla by si mi zajtra zavolať?",
              "uk": "Чи могла б ти завтра мені зателефонувати?"
            }
          ],
          "shortRule": "Mohli by ste + інфінітив?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nemohli by ste…? Boli by ste taký láskavý…?",
          "text": "Із запереченням прохання звучить ще м’якше: «Nemohli by ste chvíľu počkať?» Дуже ввічливо: «Boli by ste taký láskavý a…?» (до чоловіка), «Boli by ste taká láskavá a…?» (до жінки). Після «a» дієслово теж у l-формі: «…a zavreli okno?»",
          "examples": [
            {
              "sk": "Nemohli by ste hovoriť pomalšie?",
              "uk": "Чи не могли б ви говорити повільніше?"
            },
            {
              "sk": "Boli by ste taká láskavá a podali mi soľ?",
              "uk": "Чи не були б ви такі ласкаві подати мені сіль?"
            }
          ],
          "shortRule": "taký láskavý (він) · taká láskavá (вона) + a + l-форма",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nevadilo by vám…?",
          "text": "Коли просиш дозволу: «Nevadilo by vám, keby som otvoril okno?» — Ви не заперечуєте, якщо я відчиню вікно? Відповідь «Nie, vôbec nie.» означає «Не заперечую — будь ласка!». Якщо заважає: «Prepáčte, radšej nie.» Другові: «Nevadilo by ti…?»",
          "examples": [
            {
              "sk": "Nevadilo by vám, keby som si sadol sem?",
              "uk": "Ви не заперечуєте, якщо я сяду тут?"
            },
            {
              "sk": "Nie, vôbec nie, nech sa páči.",
              "uk": "Ні, анітрохи, будь ласка."
            }
          ],
          "shortRule": "Nevadilo by vám…? — Nie = можна",
          "commonMistakes": [
