      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prečo ste prišli",
          "text": "Почни з привітання і кондиціоналу: «Dobrý deň, chcel(a) by som podať žiadosť o…», «Potreboval(a) by som potvrdenie o…». «Žiadosť o» + знахідний: «žiadosť o predĺženie pobytu». Урядник часто каже: «Zoberte si poradové číslo a počkajte.»",
          "examples": [
            {
              "sk": "Chcela by som podať žiadosť o predĺženie pobytu.",
              "uk": "Я хотіла б подати заяву на продовження перебування."
            },
            {
              "sk": "Potreboval by som potvrdenie o pobyte.",
              "uk": "Мені потрібна була б довідка про проживання."
            }
          ],
          "shortRule": "žiadosť o + знахідний · potvrdenie o + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Bolo by možné…?",
          "text": "«Bolo by možné…?» — чи можна було б…? Дуже ввічливе запитання про можливість: «Bolo by možné prísť zajtra?», «Bolo by možné poslať to e-mailom?» Відповіді: «Áno, to by išlo.» (так, можна) або «Žiaľ, to nie je možné.»",
          "examples": [
            {
              "sk": "Bolo by možné doniesť preklad neskôr?",
              "uk": "Чи можна було б принести переклад пізніше?"
            },
            {
              "sk": "Áno, to by išlo.",
              "uk": "Так, це можливо."
            }
          ],
          "shortRule": "Bolo by možné + інфінітив?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Keď nerozumieš",
          "text": "Не соромся перепитувати: «Prepáčte, nerozumel(a) som. Mohli by ste to zopakovať pomalšie?», «Mohli by ste mi to napísať?», «Mohli by ste mi ukázať, kde to mám vyplniť?» Урядник частіше допоможе, якщо ти ввічливий(-а).",
          "examples": [
            {
              "sk": "Mohli by ste mi to napísať?",
              "uk": "Чи не могли б ви мені це написати?"
            },
            {
              "sk": "Mohli by ste hovoriť pomalšie?",
              "uk": "Чи не могли б ви говорити повільніше?"
            }
          ],
