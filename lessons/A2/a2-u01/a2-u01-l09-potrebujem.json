      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Potrebujem + знахідний",
          "text": "В українській «мені потрібна довідка» — довідка в називному. У словацькій підмет — «я», а річ у знахідному: «Potrebujem potvrdenie», «Potrebujem novú kartu», «Potrebujem tlmočníka» (живий!). Можна й з інфінітивом: «Potrebujem si vybaviť pas».",
          "examples": [
            {
              "sk": "Potrebujem potvrdenie o zamestnaní.",
              "uk": "Мені потрібна довідка з місця роботи."
            },
            {
              "sk": "Potrebujeme tlmočníka.",
              "uk": "Нам потрібен перекладач."
            }
          ],
          "shortRule": "potrebovať + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ввічливо",
          "text": "«Potreboval by som…» (чоловік) / «Potrebovala by som…» (жінка) — мені потрібно було б… «Chcel by som požiadať o…» — хотів би попросити про… «Mohli by ste mi pomôcť?» — могли б ви мені допомогти?",
          "examples": [
            {
              "sk": "Potrebovala by som novú kartu poistenca.",
              "uk": "Мені потрібна нова картка застрахованого."
            },
            {
              "sk": "Chcel by som požiadať o radu.",
              "uk": "Я хотів би попросити поради."
            }
          ],
          "shortRule": "Potreboval / Potrebovala by som…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nepotrebujem і vybaviť",
          "text": "Після «nepotrebujem» у словацькій теж знахідний: «Nepotrebujem tašku, ďakujem». «Vybaviť» — оформити, залагодити справу: «Musím si vybaviť nový pas». «Je to súrne» — це терміново.",
          "examples": [
            {
              "sk": "Nepotrebujem tašku, ďakujem.",
              "uk": "Пакет не потрібен, дякую."
            },
            {
              "sk": "Musím si vybaviť nový pas.",
              "uk": "Мені треба оформити новий паспорт."
            }
          ],
          "shortRule": "nepotrebujem + знахідний",
          "commonMistakes": [
            {
              "mistake": "Mne potrebné potvrdenie.",
              "correct": "Potrebujem potvrdenie."
