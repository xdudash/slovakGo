      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Закінчення — шпаргалка",
          "text": "Жіночий: «nová práca → novú prácu», «moja sestra → moju sestru». Чоловічий живий: «nový kolega → nového kolegu», «môj brat → môjho brata». Неживий і середній — без змін: «nový byt», «nové auto». Займенники: «ma, ťa, ho, ju, nás, vás, ich»; після прийменника: «mňa, teba, neho, ňu».",
          "examples": [
            {
              "sk": "Poznáš môjho nového kolegu?",
              "uk": "Ти знаєш мого нового колегу?"
            },
            {
              "sk": "Vidím ju každý deň.",
              "uk": "Я бачу її щодня."
            }
          ],
          "shortRule": "-ú / -ého / без змін",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Прийменники — шпаргалка",
          "text": "«Na» — куди: «idem na poštu»; «čakať na, myslieť na, tešiť sa na». «O»: «starať sa o, zaujímať sa o, mať záujem o, požiadať o». «Cez» — через, протягом. «Pre» — для, по когось. «Za» — за що, через скільки, замість. Рух під, перед, за: «pod stôl».",
          "examples": [
            {
              "sk": "Ďakujem za pomoc.",
              "uk": "Дякую за допомогу."
            },
            {
              "sk": "Idem pre deti.",
              "uk": "Я йду по дітей."
            }
          ],
          "shortRule": "na, o, cez, pre, za + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Час і потреби",
          "text": "Час: «v sobotu, každý deň, celú noc, na rok, o týždeň, raz za mesiac». Потреби й пошук: «Hľadám prácu / spolubývajúceho», «Potrebujem radu / tlmočníka», «Mám na vás prosbu» — у мене до вас прохання.",
