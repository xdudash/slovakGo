      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Koho? Čo?",
          "text": "Знахідний відмінок (akuzatív) відповідає на питання «koho? čo?» — кого? що? Він стоїть після більшості дієслів: «vidím», «poznám», «čakám», «hľadám», «mám», «kupujem». Як і в українській: «бачу маму» — «vidím mamu».",
          "examples": [
            {
              "sk": "Vidím mamu na balkóne.",
              "uk": "Я бачу маму на балконі."
            },
            {
              "sk": "Čakám suseda.",
              "uk": "Я чекаю сусіда."
            }
          ],
          "shortRule": "дієслово + koho? čo? — знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Жіночий і середній рід",
          "text": "Жіночий рід на -a: -a → -u: «žena → ženu», «ulica → ulicu», «kolegyňa → kolegyňu». На -ia: -ia → -iu: «kancelária → kanceláriu». Жіночі на приголосний не змінюються: «posteľ», «jeseň». Середній рід — як у називному: «auto», «mesto», «dievča».",
          "examples": [
            {
              "sk": "Na kurze som spoznala kolegyňu z Poľska.",
              "uk": "На курсі я познайомилася з колегою з Польщі."
            },
            {
              "sk": "Vidíš to mesto?",
              "uk": "Ти бачиш те місто?"
            }
          ],
          "shortRule": "-a → -u ;; -ia → -iu ;; середній рід без змін",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Чоловічий рід: живий і неживий",
          "text": "Живі (люди, тварини) отримують -a: «brat → brata», «sused → suseda», «lekár → lekára», «pes → psa». Чоловічі на -a мають -u: «kolega → kolegu». Неживі не змінюються: «stôl», «byt», «autobus». У множині чоловіки-люди мають -ov: «vidím kolegov»; решта — як у називному: «vidím autá, ženy».",
          "examples": [
            {
              "sk": "Poznáš Petra?",
              "uk": "Ти знаєш Петра?"
            },
            {
              "sk": "Kúpili sme stôl.",
              "uk": "Ми купили стіл."
            }
          ],
          "shortRule": "живий -a (kolega → kolegu) ;; неживий без змін",
          "commonMistakes": [
            {
              "mistake": "Vidím brat.",
              "correct": "Vidím brata."
            },
            {
              "mistake": "Pozdrav mama!",
              "correct": "Pozdrav mamu!"
            },
            {
              "mistake": "Kúpil som stola.",
              "correct": "Kúpil som stôl."
            }
          ],
          "button": "Далі →"
        }
      ],
