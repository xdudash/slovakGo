      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Na + знахідний",
          "text": "Після цих дієслів — «na» + знахідний: «čakať na» (чекати на), «myslieť na» (думати про!), «tešiť sa na» (радісно чекати), «zabudnúť na» (забути про), «spoliehať sa na» (покладатися на), «hnevať sa na» (сердитися на), «sťažovať sa na» (скаржитися на).",
          "examples": [
            {
              "sk": "Myslím na teba.",
              "uk": "Я думаю про тебе."
            },
            {
              "sk": "Teším sa na víkend.",
              "uk": "Я з нетерпінням чекаю вихідних."
            }
          ],
          "shortRule": "myslieť na — думати ПРО",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "O + знахідний",
          "text": "«Starať sa o» — дбати про, доглядати; «zaujímať sa o» — цікавитися чимось; «mať záujem o» — бути зацікавленим у; «požiadať o» — попросити про, подати заяву на. Увага: «starám sa o babku» (знахідний), але «hovorím o babke» (місцевий).",
          "examples": [
            {
              "sk": "Starám sa o babku.",
              "uk": "Я доглядаю бабусю."
            },
            {
              "sk": "Zaujímam sa o históriu.",
              "uk": "Я цікавлюся історією."
            }
          ],
          "shortRule": "starať sa o babku ;; hovoriť o babke",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменники не збігаються",
          "text": "Українська і словацька часто вживають різні конструкції: «думати про» → «myslieť na»; «цікавитися (чим?)» → «zaujímať sa o (čo?)»; «доглядати (кого?)» → «starať sa o (koho?)». Тому дієслово вчимо одразу з прийменником.",
          "examples": [
            {
              "sk": "Sťažujem sa na hluk.",
              "uk": "Я скаржуся на шум."
            },
            {
              "sk": "Spoľahni sa na mňa!",
              "uk": "Покладися на мене!"
            }
          ],
