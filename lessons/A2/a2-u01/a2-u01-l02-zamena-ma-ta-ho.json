      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Короткі форми",
          "text": "ja → ma, ty → ťa, on → ho, ona → ju, ono → ho, my → nás, vy → vás, oni / ony → ich. «Vidíš ma?» — ти мене бачиш? «Poznáš ho?» — ти його знаєш? «Pozdravím ju» — я її привітаю.",
          "examples": [
            {
              "sk": "Počuješ ma?",
              "uk": "Ти мене чуєш?"
            },
            {
              "sk": "Poznáš ju?",
              "uk": "Ти її знаєш?"
            }
          ],
          "shortRule": "ma, ťa, ho, ju, nás, vás, ich",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Місце в реченні",
          "text": "Короткі форми ніколи не стоять на початку речення — вони йдуть на друге місце: «Šéf ťa hľadá», «Zajtra ťa odprevadím». Якщо є «som, si, sme, ste», займенник стоїть після них: «Včera som ho videl».",
          "examples": [
            {
              "sk": "Zajtra ťa odprevadím na stanicu.",
              "uk": "Завтра я проведу тебе на вокзал."
            },
            {
              "sk": "Mama ho volá na obed.",
              "uk": "Мама кличе його на обід."
            }
          ],
          "shortRule": "коротка форма — на другому місці",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Довгі форми",
          "text": "Довгі форми — «mňa, teba, jeho, ju, nás, vás, ich». Вони потрібні: 1) для наголосу або на початку: «Teba hľadám, nie jeho»; 2) після прийменника: «pre mňa», «na teba», «pre neho» (або «preňho»), «na ňu», «pre nich». Після прийменника «on» → «neho», «ona» → «ňu».",
          "examples": [
            {
              "sk": "To je pre teba.",
              "uk": "Це для тебе."
            },
            {
              "sk": "Čakám na neho.",
              "uk": "Я чекаю на нього."
            }
          ],
          "shortRule": "прийменник + довга форма: pre mňa, na ňu",
          "commonMistakes": [
            {
              "mistake": "Ma vidíš?",
              "correct": "Vidíš ma?"
            },
            {
              "mistake": "To je pre ma.",
              "correct": "To je pre mňa."
            },
            {
              "mistake": "Čakám na ho.",
              "correct": "Čakám na neho."
            }
          ],
          "button": "Далі →"
        }
      ],
