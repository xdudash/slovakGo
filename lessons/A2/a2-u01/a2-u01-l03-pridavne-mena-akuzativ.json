      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Жіночий рід: -ú / -iu",
          "text": "Прикметник жіночого роду: -á → -ú: «nová práca → novú prácu», «pekná izba → peknú izbu». М’які: -ia → -iu: «mladšia sestra → mladšiu sestru», «cudzia → cudziu». Також «moja → moju», «tvoja → tvoju», «naša → našu», «tá → tú».",
          "examples": [
            {
              "sk": "Mám novú prácu.",
              "uk": "У мене нова робота."
            },
            {
              "sk": "Hľadám lacnú izbu.",
              "uk": "Я шукаю дешеву кімнату."
            }
          ],
          "shortRule": "-á → -ú ;; -ia → -iu ;; moja → moju, tá → tú",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чоловічий рід: -ého чи без змін?",
          "text": "Неживий — як у називному: «nový byt», «ten stôl», «môj mobil». Живий — прикметник отримує -ého (-ieho): «nového kolegu», «mladšieho brata», «môjho syna», «toho suseda», «nášho šéfa».",
          "examples": [
            {
              "sk": "Máme nového šéfa.",
              "uk": "У нас новий шеф."
            },
            {
              "sk": "Kúpil som nový mobil.",
              "uk": "Я купив новий телефон."
            }
          ],
          "shortRule": "живий: nového, môjho, toho ;; неживий: nový, môj, ten",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Середній рід і множина",
          "text": "Середній рід не змінюється: «nové auto», «to mesto». Множина (крім чоловіків-людей) — як у називному: «nové topánky», «tie autá». Чоловіки-люди у множині: «nových kolegov», «tých susedov» — це форму варто впізнавати.",
          "examples": [
            {
              "sk": "Kúpili sme nové topánky.",
              "uk": "Ми купили нові черевики."
            },
            {
              "sk": "Pozvali sme nových susedov.",
              "uk": "Ми запросили нових сусідів."
            }
          ],
          "shortRule": "середній рід і більшість множини без змін",
          "commonMistakes": [
            {
              "mistake": "Mám nová práca.",
              "correct": "Mám novú prácu."
            },
            {
              "mistake": "Máme nový šéf.",
              "correct": "Máme nového šéfa."
            },
            {
              "mistake": "Kúpil som nového mobilu.",
              "correct": "Kúpil som nový mobil."
            }
          ],
          "button": "Далі →"
        }
      ],
