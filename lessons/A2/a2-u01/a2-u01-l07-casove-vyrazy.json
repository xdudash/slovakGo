      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Дні й «кожен, цілий, цей»",
          "text": "Дні тижня: «v» + знахідний: «v pondelok, v utorok, v stredu, vo štvrtok, v piatok, v sobotu, v nedeľu». Без прийменника, теж знахідний: «každý deň», «celý týždeň», «celú noc», «túto sobotu», «minulý rok», «budúci mesiac».",
          "examples": [
            {
              "sk": "Túto sobotu pracujem.",
              "uk": "Цієї суботи я працюю."
            },
            {
              "sk": "Celú noc som nespal.",
              "uk": "Я не спав цілу ніч."
            }
          ],
          "shortRule": "v stredu, v sobotu ;; každý deň, celú noc",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na rok чи rok?",
          "text": "«Na» + знахідний — на який строк (план, домовленість): «Idem na týždeň do Tatier», «Zmluvu mám na rok». Без прийменника — скільки тривало: «Čakal som hodinu», «Býval som tam rok».",
          "examples": [
            {
              "sk": "Zmluvu mám na polrok.",
              "uk": "Договір у мене на пів року."
            },
            {
              "sk": "Čakal som hodinu.",
              "uk": "Я чекав годину."
            }
          ],
          "shortRule": "na rok — строк ;; rok — тривалість",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "O, za, raz za",
          "text": "«O týždeň» і «za týždeň» — через тиждень (у майбутньому). «Za hodinu» ще й «протягом години»: «Urobil som to za hodinu». «Cez týždeň» — у будні. «Raz za mesiac» — раз на місяць, «dvakrát za rok» — двічі на рік. «Vopred» — заздалегідь.",
          "examples": [
            {
              "sk": "Vrátim sa o dva dni.",
              "uk": "Я повернуся через два дні."
            },
            {
              "sk": "Nájom platím raz za mesiac.",
              "uk": "Оренду я плачу раз на місяць."
            }
          ],
          "shortRule": "o / za týždeň — через тиждень ;; raz za mesiac — раз на місяць",
