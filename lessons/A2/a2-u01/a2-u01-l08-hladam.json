      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hľadám + знахідний",
          "text": "«Hľadám» — шукаю: «hľadám prácu, byt, izbu, kľúče». Коли шукаємо людей, пам’ятаємо про живий рід: «hľadám elektrikára», «opatrovateľku», «spolubývajúceho» (співмешканця) або «spolubývajúcu» (співмешканку).",
          "examples": [
            {
              "sk": "Hľadám prácu na čiastočný úväzok.",
              "uk": "Шукаю роботу на неповний робочий день."
            },
            {
              "sk": "Hľadám spolubývajúcu do bytu v Nitre.",
              "uk": "Шукаю співмешканку у квартиру в Нітрі."
            }
          ],
          "shortRule": "hľadať koho? čo?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Мова оголошень",
          "text": "Фірма пише: «Hľadáme» (шукаємо), «Ponúkame» (пропонуємо), «Požadujeme» (вимагаємо) — і після них знахідний: «Ponúkame stabilnú prácu a ubytovanie». «Požiadavky» — вимоги, «nástup» — початок роботи, «hľadá sa» — шукається.",
          "examples": [
            {
              "sk": "Hľadáme skúseného murára.",
              "uk": "Шукаємо досвідченого муляра."
            },
            {
              "sk": "Ponúkame dobrý plat.",
              "uk": "Пропонуємо гарну зарплату."
            }
          ],
          "shortRule": "Hľadáme / Ponúkame / Požadujeme + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як відповісти",
          "text": "«Dobrý deň, volám kvôli inzerátu.» — телефоную щодо оголошення. «Mám záujem o izbu» — мене цікавить кімната. «Je ponuka ešte aktuálna?» — пропозиція ще актуальна? «Kedy si môžem izbu pozrieť?» — коли можна подивитися кімнату?",
          "examples": [
            {
              "sk": "Mám záujem o túto ponuku.",
              "uk": "Мене цікавить ця пропозиція."
            },
            {
              "sk": "Je izba ešte voľná?",
              "uk": "Кімната ще вільна?"
            }
          ],
          "shortRule": "mať záujem o + знахідний",
