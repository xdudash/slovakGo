      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kam? і Kde?",
          "text": "«Kam ideš? — Na poštu.» — напрям: na + знахідний. «Kde si? — Na pošte.» — місце: na + місцевий. Так само: «na úrad / na úrade», «na stanicu / na stanici», «na trh / na trhu», «na letisko / na letisku».",
          "examples": [
            {
              "sk": "Idem na úrad.",
              "uk": "Я йду в установу."
            },
            {
              "sk": "Som na úrade.",
              "uk": "Я в установі."
            }
          ],
          "shortRule": "Kam? na + знахідний ;; Kde? na + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Покласти й повісити",
          "text": "Дієслова «položiť, dať, postaviť, zavesiť» відповідають на «куди?», тому — знахідний: «polož kľúče na stôl». Коли річ уже там — «де?», місцевий: «kľúče ležia na stole». «Zavesiť na vešiak» — повісити на вішак, але «visí na vešiaku» — висить на вішаку.",
          "examples": [
            {
              "sk": "Polož kľúče na stôl.",
              "uk": "Поклади ключі на стіл."
            },
            {
              "sk": "Kľúče ležia na stole.",
              "uk": "Ключі лежать на столі."
            }
          ],
          "shortRule": "položiť na stôl ;; leží na stole",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pod, pred, za, nad, medzi",
          "text": "Ці прийменники теж мають знахідний, коли є рух «куди?»: «Daj tašku pod stôl» — постав сумку під стіл. Якщо «де?» — орудний: «Taška je pod stolom». «Mačka skočila na skriňu.»",
          "examples": [
            {
              "sk": "Schovaj darček pod posteľ!",
              "uk": "Сховай подарунок під ліжко!"
            },
            {
              "sk": "Taška je pod stolom.",
              "uk": "Сумка під столом."
            }
          ],
          "shortRule": "куди? pod stôl ;; де? pod stolom",
          "commonMistakes": [
            {
              "mistake": "Idem na pošte.",
              "correct": "Idem na poštu."
            },
            {
              "mistake": "Kľúče sú na stôl.",
              "correct": "Kľúče sú na stole."
            },
            {
              "mistake": "Polož to na stole.",
              "correct": "Polož to na stôl."
            }
          ],
          "button": "Далі →"
        }
      ],
