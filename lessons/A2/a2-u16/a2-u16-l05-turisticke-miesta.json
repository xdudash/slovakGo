      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pamiatky",
          "text": "«Pamiatka» — історична пам’ятка: «hrad, kostol, katedrála, radnica, námestie, mestská brána» (міська брама). Кілька місць Словаччини внесено до списку ЮНЕСКО: «Banská Štiavnica», «Levoča», «Spišský hrad», «Bardejov», село «Vlkolínec». Мапу й поради дає «infocentrum» — туристичний інформаційний центр.",
          "examples": [
            {
              "sk": "V Košiciach stojí Dóm svätej Alžbety, najväčší kostol na Slovensku.",
              "uk": "У Кошицях стоїть собор святої Єлизавети, найбільший храм у Словаччині."
            },
            {
              "sk": "V infocentre nám dali mapu mesta.",
              "uk": "В інфоцентрі нам дали мапу міста."
            }
          ],
          "shortRule": "pamiatka · katedrála · infocentrum",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Oplatí sa…",
          "text": "Порадити — «Oplatí sa navštíviť Bardejov» (Бардеєв варто відвідати). Запитати — «Čo sa oplatí vidieť v Levoči?» Дієслово «oplatiť sa» завжди з «sa» і в третій особі однини: «oplatí sa», «neoplatí sa».",
          "examples": [
            {
              "sk": "Do Banskej Štiavnice sa oplatí ísť na celý deň.",
              "uk": "До Банської Штявниці варто поїхати на цілий день."
            },
            {
              "sk": "V lete sa oplatí prísť skoro ráno.",
              "uk": "Улітку варто прийти рано-вранці."
            }
          ],
          "shortRule": "oplatí sa + інфінітив",
