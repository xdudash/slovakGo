      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Mám rezerváciu na meno…",
          "text": "Адміністратор — «recepčný», адміністраторка — «recepčná». Поселяючись, кажеш: «Dobrý deň, mám rezerváciu na meno Kovalenko.» Тебе попросять документ і, можливо, заповнити картку гостя. Якщо приїдеш пізно, попередь заздалегідь — це «neskorý príchod»: «Prídeme neskoro, okolo desiatej.»",
          "examples": [
            {
              "sk": "Mám rezerváciu na meno Bondar.",
              "uk": "У мене бронювання на прізвище Бондар."
            },
            {
              "sk": "Môžeme sa ubytovať už teraz?",
              "uk": "Можемо поселитися вже зараз?"
            }
          ],
          "shortRule": "rezervácia na meno + прізвище",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mohli by ste…?",
          "text": "Ввічливе прохання — «Mohli by ste…?» (Чи не могли б ви…?) або «Chcel(a) by som…». Попросити побудку — «budenie»: «Mohli by ste ma zobudiť o šiestej?» Речі можна «uschovať» — залишити на зберігання: «Môžem si tu uschovať batožinu?» Цінні речі кладуть у «trezor» (сейф).",
          "examples": [
            {
              "sk": "Mohli by ste mi uschovať kufor do obeda?",
              "uk": "Чи не могли б ви зберегти мою валізу до обіду?"
            },
            {
              "sk": "Doklady máme v trezore.",
              "uk": "Документи в нас у сейфі."
            }
          ],
          "shortRule": "Mohli by ste + інфінітив?",
          "commonMistakes": [
            {
              "mistake": "Mám rezervácia.",
              "correct": "Mám rezerváciu."
            },
            {
              "mistake": "Môžete by ste…?",
              "correct": "Mohli by ste…?"
            },
            {
              "mistake": "Mohol by ste…?",
              "correct": "Mohli by ste…?"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odkedy? Do koľkej?",
          "text": "Час: «Odkedy sú raňajky?» — «Od siedmej.» «Do koľkej musíme opustiť izbu?» — «Do desiatej.» Після od / do — родовий порядкового числівника. У багатьох містах Словаччини за кожну ніч платять «miestny poplatok» — місцевий збір; часто його оплачують окремо на рецепції.",
          "examples": [
            {
              "sk": "Raňajky sú od siedmej do desiatej.",
              "uk": "Сніданок із сьомої до десятої."
            },
            {
              "sk": "Miestny poplatok sa platí na recepcii.",
              "uk": "Місцевий збір оплачують на рецепції."
            }
          ],
          "shortRule": "od siedmej · do desiatej · do koľkej?",
          "button": "Далі →"
        }
      ],
