      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde sa ubytovať?",
          "text": "«Ubytovať sa» — поселитися, «prenocovať» — переночувати. Найдешевше — «hostel» (часто ліжко у спільній кімнаті), затишно — «penzión», із власною кухнею — «apartmán», у горах — «chata».",
          "examples": [
            {
              "sk": "Kde sa ubytujeme v Tatrách?",
              "uk": "Де ми поселимося в Татрах?"
            },
            {
              "sk": "Prenocujeme v hosteli pri stanici.",
              "uk": "Переночуємо в хостелі біля вокзалу."
            }
          ],
          "shortRule": "ubytovať sa / prenocovať + v + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na koľko nocí?",
          "text": "Тривалість — «na» + знахідний: «na jednu noc, na dve noci, na víkend». Після п’яти — родовий множини: «na päť nocí». Дати — «od» + родовий «do» + родовий: «od piatku do nedele», «od desiateho do dvanásteho júla».",
          "examples": [
            {
              "sk": "Hľadáme ubytovanie na tri noci.",
              "uk": "Шукаємо житло на три ночі."
            },
            {
              "sk": "Máte voľnú izbu od piatku do nedele?",
              "uk": "У вас є вільний номер із п’ятниці до неділі?"
            }
          ],
          "shortRule": "na + знахідний · 2–4 noci, 5+ nocí · od + родовий do + родовий",
          "commonMistakes": [
            {
              "mistake": "na dva noci",
              "correct": "na dve noci"
            },
            {
              "mistake": "na päť noci",
              "correct": "na päť nocí"
            },
            {
              "mistake": "izba s kúpeľňa",
              "correct": "izba s kúpeľňou"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Aká izba?",
          "text": "«Jednolôžková izba» — одномісний номер, «dvojlôžková izba» — двомісний. Для дитини можна попросити «prístelku» — додаткове ліжко. Харчування: «raňajky» — сніданок, «polpenzia» — сніданок і вечеря. Що є в номері — «s» + орудний: «izba s kúpeľňou, s balkónom, s výhľadom na hory».",
          "examples": [
            {
              "sk": "Chceli by sme dvojlôžkovú izbu s prístelkou.",
              "uk": "Ми хотіли б двомісний номер із додатковим ліжком."
            },
            {
              "sk": "Cena je s raňajkami.",
              "uk": "Ціна зі сніданком."
            }
          ],
          "shortRule": "s + орудний: s kúpeľňou, s raňajkami, s polpenziou",
          "button": "Далі →"
        }
      ],
