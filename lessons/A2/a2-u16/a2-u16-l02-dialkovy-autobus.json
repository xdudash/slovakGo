      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Na autobusovej stanici",
          "text": "Міжміські автобуси відправляються з «autobusová stanica» (автовокзал, скорочено AS). Кожен автобус має своє «stanovište» — пронумероване місце посадки: «Autobus do Nitry odchádza zo stanovišťa číslo 12.» Компанія, яка возить пасажирів, — «dopravca». Квиток часто можна купити онлайн або «u vodiča» (у водія).",
          "examples": [
            {
              "sk": "Z ktorého stanovišťa ide autobus do Nitry?",
              "uk": "З якого місця посадки їде автобус до Нітри?"
            },
            {
              "sk": "Lístok si kúpim u vodiča.",
              "uk": "Квиток я куплю у водія."
            }
          ],
          "shortRule": "zo stanovišťa · u vodiča (родовий)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Zastavuje v… / ide cez…",
          "text": "Де зупиняється? — «v» + місцевий: «Zastavuje v Martine? v Ružomberku? v Liptovskom Mikuláši?» Через що їде? — «cez» + знахідний: «Autobus ide cez Banskú Bystricu.» Кінцевий пункт — «do» + родовий.",
          "examples": [
            {
              "sk": "Tento autobus ide cez Martin do Žiliny.",
              "uk": "Цей автобус їде через Мартін до Жиліни."
            },
            {
              "sk": "Zastavuje aj v Ružomberku?",
              "uk": "Він зупиняється і в Ружомбероку?"
            }
          ],
          "shortRule": "v + місцевий (де) · cez + знахідний (через)",
          "commonMistakes": [
            {
              "mistake": "Zastavuje na Martine?",
              "correct": "Zastavuje v Martine?"
            },
            {
              "mistake": "ide cez Banská Bystrica",
              "correct": "ide cez Banskú Bystricu"
            },
            {
              "mistake": "kúpim u vodič",
              "correct": "kúpim u vodiča"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Batožina a zastávka na znamenie",
          "text": "Великі валізи кладуть у «batožinový priestor» — багажне відділення внизу автобуса. На деяких зупинках автобус зупиняється лише на вимогу — це «zastávka na znamenie». Щоб вийти, натисни кнопку або заздалегідь скажи водієві: «Zastavíte mi, prosím, v Lazanoch?» Щоб сісти, подай водієві знак рукою.",
          "examples": [
            {
              "sk": "Kufor dajte do batožinového priestoru.",
              "uk": "Валізу покладіть у багажне відділення."
            },
            {
              "sk": "Na zastávke na znamenie treba stlačiť tlačidlo.",
              "uk": "На зупинці на вимогу треба натиснути кнопку."
            }
          ],
          "shortRule": "zastávka na znamenie — сказати водієві або натиснути кнопку",
          "button": "Далі →"
        }
      ],
