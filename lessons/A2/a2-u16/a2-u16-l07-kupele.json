        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Liečebný pobyt a procedúry",
          "text": "Словаччина багата на «pramene» — джерела мінеральної й «termálnej» (гарячої) води. «Liečebný pobyt» — лікувальне перебування, часто на кілька тижнів. Лікар призначає «procedúry»: «masáž», «bahenný zábal» (грязьове обгортання), «rehabilitácia». Іноді частину перебування оплачує медична страхова компанія за рекомендацією лікаря.",
          "examples": [
            {
              "sk": "Piešťany sú známe liečivým bahnom.",
              "uk": "Піщани відомі лікувальною гряззю."
            },
            {
              "sk": "Každé ráno mám dve procedúry.",
              "uk": "Щоранку в мене дві процедури."
            }
          ],
          "shortRule": "prameň · procedúra · liečebný pobyt",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Termálne kúpaliská",
          "text": "Не лише для лікування: у термальних басейнах відпочивають цілі родини — відомі, наприклад, «Bešeňová», «Podhájska», «Tatralandia». Не забудь «plavky» (купальник або плавки) і рушник. Іти «na masáž», бути «na masáži», «po masáži» — місцевий відмінок.",
          "examples": [
            {
              "sk": "Zabudol som si plavky!",
              "uk": "Я забув плавки!"
            },
            {
              "sk": "Po masáži sa cítim výborne.",
              "uk": "Після масажу почуваюся чудово."
            }
          ],
          "shortRule": "ísť na masáž · byť na masáži · po masáži",
          "button": "Далі →"
        }
