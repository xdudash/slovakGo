      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kúpele — iba množné číslo",
          "text": "«Kúpele» — лікувальний курорт; слово вживається лише в множині: «ísť do kúpeľov», «byť v kúpeľoch», «vrátiť sa z kúpeľov». Так само багато назв курортних міст: «Piešťany → v Piešťanoch, do Piešťan», «Trenčianske Teplice → v Trenčianskych Tepliciach, do Trenčianskych Teplíc».",
          "examples": [
            {
              "sk": "Mama je dva týždne v kúpeľoch.",
              "uk": "Мама два тижні на курорті."
            },
