      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Osobný vlak, rýchlik, IC",
          "text": "«Osobný vlak» (Os) зупиняється майже на кожній станції. «Rýchlik» (R) — швидший, зупиняється в більших містах. «IC» (InterCity) — найшвидший і найзручніший, їздить, наприклад, між Братиславою і Кошицями через Жиліну й Попрад. На IC зазвичай потрібна «miestenka» — резервування місця. Усю мережу називають «železnica».",
          "examples": [
            {
              "sk": "Osobný vlak zastavuje takmer na každej stanici.",
              "uk": "Пасажирський поїзд зупиняється майже на кожній станції."
            },
            {
              "sk": "Na IC potrebujete aj miestenku.",
              "uk": "На IC вам потрібне ще й резервування місця."
            }
          ],
          "shortRule": "Os — повільно · R — швидше · IC — найшвидше + miestenka",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Cestovať vlakom do…",
          "text": "Чим? — орудний відмінок без прийменника: «vlakom», «autobusom». Куди? — «do» + родовий: «do Žiliny, do Popradu, do Prešova, do Košíc». Звідки? — «z» + родовий: «z Bratislavy». Не кажи «s vlakom» чи «na vlaku», коли говориш про спосіб подорожі.",
          "examples": [
            {
              "sk": "Cestujem vlakom z Bratislavy do Žiliny.",
              "uk": "Я їду поїздом із Братислави до Жиліни."
            },
            {
              "sk": "Kedy ide najbližší vlak do Popradu?",
              "uk": "Коли йде найближчий поїзд до Попраду?"
            }
          ],
          "shortRule": "vlakom (чим) · do + родовий (куди) · z + родовий (звідки)",
          "commonMistakes": [
            {
              "mistake": "Idem s vlakom.",
              "correct": "Idem vlakom."
            },
            {
              "mistake": "lístok do Košice",
              "correct": "lístok do Košíc"
            },
            {
              "mistake": "vlak na Žilinu",
              "correct": "vlak do Žiliny"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Priamy vlak, prípoj, trieda",
          "text": "«Priamy vlak» їде до мети без пересадки. Якщо треба пересідати, у тебе є «prípoj» — поїзд, на який пересідаєш: «V Žiline máte prípoj do Martina.» У поїздах є «prvá trieda» (дорожча й зручніша) і «druhá trieda». Плата за проїзд — «cestovné»; діти, студенти й пенсіонери часто мають «zľavnený lístok». Умови пільг змінюються, тому перевіряй їх перед поїздкою.",
          "examples": [
            {
              "sk": "Je to priamy vlak, alebo musím prestupovať?",
              "uk": "Це прямий поїзд чи мені треба пересідати?"
            },
            {
              "sk": "Prosím si zľavnený lístok pre študenta.",
              "uk": "Пільговий квиток для студента, будь ласка."
            }
          ],
          "shortRule": "priamy vlak — без пересадки · prípoj — поїзд після пересадки",
          "button": "Далі →"
        }
      ],
