      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hrad, zámok, zrúcanina",
          "text": "«Hrad» — фортеця, зазвичай на пагорбі, з «hradby» (мурами) і «veža» (вежею). «Zámok» — пізніший палац-резиденція для зручного життя, напр. «Bojnický zámok». Зруйнований замок — «zrúcanina». Увага: «zámok» означає ще й «замок у дверях»!",
          "examples": [
            {
              "sk": "Spišský hrad je jeden z najväčších hradov v strednej Európe.",
              "uk": "Спіський замок — один із найбільших замків у Центральній Європі."
            },
            {
              "sk": "Z hradu zostala len zrúcanina.",
              "uk": "Від замку залишилися лише руїни."
            }
          ],
          "shortRule": "hrad — фортеця · zámok — палац · zrúcanina — руїни",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "V trinástom storočí",
          "text": "Століття — «storočie». Коли? — «v» + місцевий порядкового числівника: «v 13. storočí» = «v trinástom storočí». Звідки? — «z» + родовий: «zo 14. storočia» = «zo štrnásteho storočia». Безособово про минуле — 3-тя особа множини без підмета: «Hrad postavili v 13. storočí.» (замок збудували).",
          "examples": [
            {
              "sk": "Hrad postavili v trinástom storočí.",
              "uk": "Замок збудували в тринадцятому столітті."
            },
            {
              "sk": "V 18. storočí hrad vyhorel.",
              "uk": "У 18 столітті замок згорів."
            }
          ],
          "shortRule": "v trinástom storočí · zo štrnásteho storočia · postavili",
          "commonMistakes": [
            {
              "mistake": "v trinásty storočie",
              "correct": "v trinástom storočí"
            },
            {
              "mistake": "Hrad postavil v 13. storočí.",
              "correct": "Hrad postavili v 13. storočí."
            },
            {
              "mistake": "z štrnásteho storočia",
              "correct": "zo štrnásteho storočia"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Legendy",
          "text": "Багато замків мають свою «legenda». У Бойніцькому замку щовесни відбувається міжнародний фестиваль привидів і страховиськ. Про «Čachtický hrad» розповідають історію графині Алжбети Баторі. В Оравському замку знімали німий фільм «Носферату» (1922). З Тренчанським замком пов’язана легенда про «Studňa lásky» — криницю кохання.",
          "examples": [
            {
              "sk": "Na Oravskom hrade nakrúcali film Nosferatu.",
              "uk": "В Оравському замку знімали фільм «Носферату»."
            },
            {
              "sk": "Podľa legendy kopali studňu tri roky.",
              "uk": "За легендою, криницю копали три роки."
            }
          ],
          "shortRule": "podľa legendy — за легендою",
          "button": "Далі →"
        }
