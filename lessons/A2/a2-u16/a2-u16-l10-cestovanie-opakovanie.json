        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Rozprávanie o ceste",
          "text": "Розповідь про поїздку — минулий час і слова послідовності: «najprv» (спочатку), «potom» (потім), «nakoniec» (нарешті). Порадити — «Oplatí sa…». Цікаве місце чи факт — «zaujímavosť»; пам’ятна річ — «suvenír».",
          "examples": [
            {
              "sk": "Najprv sme boli na Spišskom hrade, potom v Levoči.",
              "uk": "Спочатку ми були в Спіському замку, потім у Левочі."
            },
            {
              "sk": "Ako suvenír som kúpila drevenú hračku.",
              "uk": "На сувенір я купила дерев’яну іграшку."
            }
          ],
          "shortRule": "najprv → potom → nakoniec",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Skanzen a cestovateľ",
          "text": "«Skanzen» — музей народної архітектури просто неба: дерев’яні хати, церкви, млини. Відомі скансени є в Мартіні, Зуберці, Бардеївських Купелях і Старій Любовні. Людина, яка любить подорожувати, — «cestovateľ / cestovateľka».",
          "examples": [
            {
              "sk": "V skanzene v Zuberci sú staré oravské domy.",
              "uk": "У скансені в Зуберці є старі оравські хати."
            },
            {
              "sk": "Môj brat je skúsený cestovateľ.",
              "uk": "Мій брат — досвідчений мандрівник."
            }
          ],
          "shortRule": "skanzen — музей просто неба",
          "button": "Далі →"
        }
