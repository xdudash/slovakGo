      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čaj s citrónom",
          "text": "З чим страва чи напій — «s» + орудний: «čaj s citrónom», «káva s mliekom», «chlieb s maslom», «palacinky s džemom», «halušky s bryndzou». Протилежне — «bez» + родовий: «káva bez cukru» — «káva s cukrom».",
          "examples": [
            {
              "sk": "Dám si čaj s citrónom.",
              "uk": "Я візьму чай із лимоном."
            },
            {
              "sk": "Kávu bez mlieka, ale s cukrom.",
              "uk": "Каву без молока, але з цукром."
            }
          ],
          "shortRule": "s + орудний ↔ bez + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Гарніри в множині",
          "text": "Багато гарнірів — у множині, тож потрібен орудний множини на -mi / -ami: «zemiaky → so zemiakmi», «hranolky → s hranolkami», «palacinky → s palacinkami». Інші — в однині: «ryža → s ryžou», «šalát → so šalátom».",
          "examples": [
            {
              "sk": "Rezeň so zemiakmi, prosím.",
              "uk": "Відбивну з картоплею, будь ласка."
            },
            {
              "sk": "Kuracie prsia s ryžou a šalátom.",
              "uk": "Куряче філе з рисом і салатом."
            }
          ],
          "shortRule": "so zemiakmi, s hranolkami, s ryžou",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Príloha: s čím?",
          "text": "У словацькому меню гарнір — «príloha»: «hlavné jedlo + príloha». Офіціант може спитати: «S čím si to dáte?» — З чим ви це візьмете? Відповідь: «S ryžou, prosím.» Також: «s kečupom, s horčicou», «so šľahačkou».",
          "examples": [
            {
              "sk": "S čím je ten rezeň?",
              "uk": "З чим ця відбивна?"
            },
            {
              "sk": "Palacinky so šľahačkou, prosím.",
              "uk": "Млинці зі збитими вершками, будь ласка."
            }
          ],
          "shortRule": "S čím? — s + орудний",
          "commonMistakes": [
            {
              "mistake": "čaj s citrón",
              "correct": "čaj s citrónom"
            },
            {
              "mistake": "rezeň s zemiaky",
              "correct": "rezeň so zemiakmi"
            },
            {
              "mistake": "káva bez cukrom",
              "correct": "káva bez cukru"
            }
          ],
          "button": "Далі →"
        }
      ],
