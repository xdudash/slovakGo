      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Pred, za",
          "text": "«Pred» — перед: «pred domom, pred vchodom, pred obchodom». «Za» — за, позаду: «za domom, za rohom, za mostom». На питання «kde?» (де?) після них стоїть орудний.",
          "examples": [
            {
              "sk": "Čakám ťa pred vchodom.",
              "uk": "Чекаю на тебе перед входом."
            },
            {
              "sk": "Lekáreň je hneď za rohom.",
              "uk": "Аптека одразу за рогом."
            }
          ],
          "shortRule": "kde? pred / za + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nad, pod, medzi",
          "text": "«Nad» — над: «nad stolom, nad dverami». «Pod» — під: «pod posteľou, pod mostom». «Medzi» — між: «medzi bankou a poštou», «medzi nami». Слово «dvere» має лише множину: «pred dverami, nad dverami».",
          "examples": [
            {
              "sk": "Lampa visí nad stolom.",
              "uk": "Лампа висить над столом."
            },
            {
              "sk": "Pošta je medzi bankou a lekárňou.",
              "uk": "Пошта між банком і аптекою."
            }
          ],
          "shortRule": "nad / pod / medzi + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де? чи куди? І час",
          "text": "Якщо питаємо «kam?» (куди?), після цих прийменників — знахідний: «Daj kufor pod posteľ» — поклади валізу під ліжко, але «Kufor je pod posteľou» — валіза під ліжком. «Pred» про час: «pred obedom» — перед обідом, «pred rokom» — рік тому, «pred týždňom» — тиждень тому.",
          "examples": [
            {
              "sk": "Prišli sme pred dvoma rokmi.",
              "uk": "Ми приїхали два роки тому."
            },
            {
              "sk": "Zavolám ti pred obedom.",
              "uk": "Я подзвоню тобі перед обідом."
            }
          ],
          "shortRule": "kde? — орудний, kam? — знахідний; pred rokom = рік тому",
          "commonMistakes": [
            {
              "mistake": "Auto stojí pred dom.",
              "correct": "Auto stojí pred domom."
            },
            {
              "mistake": "Kufor je pod posteľ.",
              "correct": "Kufor je pod posteľou."
            },
            {
              "mistake": "Prišiel som rok pred.",
              "correct": "Prišiel som pred rokom."
            }
          ],
          "button": "Далі →"
        }
      ],
