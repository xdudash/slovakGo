      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Stať sa + орудний",
          "text": "«Stať sa kým / čím» — стати кимось, чимось. Після нього завжди орудний: «Stal sa otcom» — він став батьком, «Stala sa riaditeľkou» — вона стала директоркою, «Chcem sa stať občanom Slovenska». Не забувай «sa»: «stal som sa», «stala si sa».",
          "examples": [
            {
              "sk": "Minulý rok som sa stal otcom.",
              "uk": "Торік я став батьком."
            },
            {
              "sk": "Stala sa vedúcou predajne.",
              "uk": "Вона стала завідувачкою магазину."
            }
          ],
          "shortRule": "stať sa + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Zostať, byť",
          "text": "«Zostať kým» — залишитися кимось, теж з орудним: «Aj po rokoch sme zostali dobrými priateľmi». З «byť» про професію чи роль можна і називний, і орудний: «Je lekár» і «Je lekárom» — обидва правильні. Але зі «stať sa» — тільки орудний.",
          "examples": [
            {
              "sk": "Aj po rokoch sme zostali dobrými priateľmi.",
              "uk": "Навіть через роки ми залишилися добрими друзями."
            },
            {
              "sk": "Brat je vodičom autobusu.",
              "uk": "Брат — водій автобуса."
            }
          ],
          "shortRule": "stať sa / zostať + орудний; byť + називний або орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čo sa stalo?",
          "text": "Обережно: «Čo sa stalo?» — що сталося? Тут «stať sa» означає «статися», і підмет стоїть у називному: «Stala sa nehoda» — сталася аварія, «Stalo sa to včera» — це сталося вчора. А «stať sa kým» — стати кимось: «Stal sa víťazom» — він став переможцем.",
          "examples": [
            {
              "sk": "Čo sa ti stalo?",
              "uk": "Що з тобою сталося?"
            },
            {
              "sk": "Náš tím sa stal víťazom turnaja.",
              "uk": "Наша команда стала переможцем турніру."
            }
          ],
          "shortRule": "stať sa = статися / стати кимось",
          "commonMistakes": [
            {
              "mistake": "Stal sa otec.",
              "correct": "Stal sa otcom."
            },
            {
              "mistake": "Stala sa riaditeľka.",
              "correct": "Stala sa riaditeľkou."
            },
            {
              "mistake": "Chcem stať občanom.",
              "correct": "Chcem sa stať občanom."
            }
          ],
          "button": "Далі →"
        }
      ],
