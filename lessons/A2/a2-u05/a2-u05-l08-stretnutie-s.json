      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Stretnúť sa s",
          "text": "«Stretnúť sa s kým» — зустрітися з кимось (домовлено): «Stretnem sa s kamarátom», «Zajtra sa stretneme so šéfom». Регулярно — «stretávať sa»: «Stretávame sa s ukrajinskými rodinami každú nedeľu». Без «sa» — випадково зустріти, із знахідним: «Stretol som suseda».",
          "examples": [
            {
              "sk": "V sobotu sa stretnem so sestrou.",
              "uk": "У суботу я зустрінуся із сестрою."
            },
            {
              "sk": "Včera som v obchode stretol suseda.",
              "uk": "Учора я випадково зустрів у магазині сусіда."
            }
          ],
          "shortRule": "stretnúť sa s + орудний; stretnúť + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Stretnutie, schôdzka, pohovor",
          "text": "«Stretnutie s klientom» — зустріч із клієнтом, «schôdzka s kamarátkou» — зустріч, побачення, «pracovný pohovor s personalistkou» — співбесіда з працівницею відділу кадрів. «Porada» — нарада в колективі.",
          "examples": [
            {
              "sk": "Mám pohovor s majiteľom firmy.",
              "uk": "У мене співбесіда з власником фірми."
            },
            {
              "sk": "Schôdzku s ňou mám o šiestej.",
              "uk": "Зустріч із нею в мене о шостій."
            }
          ],
          "shortRule": "stretnutie / schôdzka / pohovor s + орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dohodnúť sa s, hodí sa vám?",
          "text": "«Dohodnúť sa s kým» — домовитися з кимось: «Dohodol som sa s majiteľom». Корисні фрази: «Môžeme sa stretnúť v utorok?», «Hodí sa vám to?» — вам зручно?, «Musím presunúť stretnutie» — мушу перенести зустріч, «Termín je potvrdený» — дату підтверджено.",
          "examples": [
            {
              "sk": "Dohodli sme sa so zástupcom firmy.",
              "uk": "Ми домовилися з представником фірми."
            },
