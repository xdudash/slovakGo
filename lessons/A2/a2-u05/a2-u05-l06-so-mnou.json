      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Однина",
          "text": "Займенники в орудному: «ja → so mnou», «ty → s tebou», «on, ono → s ním», «ona → s ňou». Перед «mnou» завжди «so»: «Poď so mnou!». Розрізняй «s ním» (з ним) і «s ňou» (з нею).",
          "examples": [
            {
              "sk": "Pôjdeš so mnou do kina?",
              "uk": "Підеш зі мною в кіно?"
            },
            {
              "sk": "S ňou sa dobre rozpráva.",
              "uk": "З нею добре розмовляти."
            }
          ],
          "shortRule": "so mnou, s tebou, s ním, s ňou",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Множина і ввічливе vy",
          "text": "«My → s nami», «vy → s vami», «oni → s nimi». «S vami» — і до кількох людей, і ввічливо до однієї особи: «Môžem sa s vami porozprávať?». Присвійні займенники: «s mojím, s tvojím, s naším, s vaším» (чол. рід), «s mojou, s našou» (жін. рід).",
          "examples": [
            {
              "sk": "Môžem ísť s vami?",
              "uk": "Можна мені піти з вами?"
            },
            {
              "sk": "S nimi sa poznám už roky.",
              "uk": "З ними я знайомий уже багато років."
            }
          ],
          "shortRule": "s nami, s vami, s nimi",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Дієслова з s",
          "text": "З орудним часто вживаються: «počítať s kým» — розраховувати на когось («Môžeš so mnou počítať»), «poradiť sa s kým» — порадитися, «rozlúčiť sa s kým» — попрощатися, «podeliť sa s kým o čo» — поділитися. Українське «на тебе» тут — словацьке «s tebou»!",
          "examples": [
            {
              "sk": "Počítam s tebou.",
              "uk": "Я розраховую на тебе."
            },
            {
              "sk": "Musím sa poradiť s manželkou.",
              "uk": "Мені треба порадитися з дружиною."
            }
          ],
          "shortRule": "počítať / poradiť sa / rozlúčiť sa s + орудний",
          "commonMistakes": [
            {
              "mistake": "s mnou",
              "correct": "so mnou"
            },
            {
              "mistake": "Počítam na teba.",
              "correct": "Počítam s tebou."
            },
            {
              "mistake": "Idem s on.",
              "correct": "Idem s ním."
            }
          ],
          "button": "Далі →"
        }
      ],
