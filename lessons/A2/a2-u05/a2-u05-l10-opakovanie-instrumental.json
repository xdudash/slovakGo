      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Закінчення",
          "text": "Однина: чоловічий і середній рід -om (bratom, autom), жіночий -ou (sestrou, kosťou), середній на -ie — -ím (námestím). Прикметник: -ým / -ou. Множина: -mi / -ami (priateľmi, ženami); особливі форми: deťmi, ľuďmi; прикметник -ými.",
          "examples": [
            {
              "sk": "s mojím bratom a jeho novou ženou",
              "uk": "з моїм братом і його новою дружиною"
            },
            {
              "sk": "s novými kolegami",
              "uk": "з новими колегами"
            }
          ],
          "shortRule": "-om / -ou / -mi, -ami",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "З прийменником і без",
          "text": "З «s / so» — з ким, з чим: «s kolegom, so zemiakmi, so mnou». Без прийменника — знаряддя й транспорт: «nožom, autobusom, kartou». Прийменники місця «pred, za, nad, pod, medzi» + орудний — де?, але + знахідний — куди?.",
          "examples": [
            {
              "sk": "Idem s kamarátom autobusom.",
              "uk": "Я їду з другом автобусом."
            },
            {
              "sk": "Auto je pred domom.",
              "uk": "Машина перед будинком."
            }
          ],
          "shortRule": "s + орудний; čím? — без прийменника",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Дієслова й вирази",
          "text": "«Stať sa / zostať kým» — орудний; «byť kým» — орудний або називний; «pracovať ako» — називний. «Spokojný s, súhlasiť s, počítať s, stretnúť sa s, dohodnúť sa s» — орудний.",
          "examples": [
            {
              "sk": "Stala sa vedúcou a je spokojná s prácou.",
              "uk": "Вона стала керівницею і задоволена роботою."
            },
            {
              "sk": "Pracujem ako vodič.",
              "uk": "Я працюю водієм."
            }
