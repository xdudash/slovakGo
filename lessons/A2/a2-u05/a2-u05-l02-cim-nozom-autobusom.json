      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Знаряддя: čím?",
          "text": "Чим ми щось робимо — орудний без прийменника, так само як в українській: «krájať nožom» — різати ножем, «písať perom, ceruzkou», «jesť lyžicou, vidličkou». Прийменник «s» тут не потрібен: «muž s nožom» — чоловік, у якого є ніж, а «krájať nožom» — різати ножем.",
          "examples": [
            {
              "sk": "Chlieb krájam ostrým nožom.",
              "uk": "Хліб я ріжу гострим ножем."
            },
            {
              "sk": "Formulár vyplňte perom.",
              "uk": "Заповніть формуляр ручкою."
            }
          ],
          "shortRule": "čím? — орудний без s",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Транспорт: autobusom, vlakom",
          "text": "Як ти їдеш — теж орудний без прийменника: «ísť autobusom, vlakom, autom, metrom», «cestovať električkou, loďou, lietadlom». Не кажи «na autobuse» чи «s autobusom»! Без транспорту — «pešo» (пішки).",
          "examples": [
            {
              "sk": "Do práce chodím električkou.",
              "uk": "На роботу я їжджу трамваєм."
            },
            {
              "sk": "Do Košíc cestujem vlakom.",
              "uk": "До Кошиць я їжджу потягом."
            }
          ],
          "shortRule": "ísť + транспорт в орудному",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Poštou, kartou, touto ulicou",
          "text": "Орудний без прийменника також у виразах: «poslať poštou, e-mailom» — надіслати поштою, мейлом; «platiť kartou» — платити карткою (але готівкою — «v hotovosti»); «ísť touto ulicou» — іти цією вулицею.",
          "examples": [
            {
              "sk": "Faktúru vám pošleme e-mailom.",
              "uk": "Рахунок ми надішлемо вам мейлом."
            },
            {
              "sk": "Choďte touto ulicou rovno.",
              "uk": "Ідіть цією вулицею прямо."
            }
          ],
          "shortRule": "poštou, e-mailom, kartou",
