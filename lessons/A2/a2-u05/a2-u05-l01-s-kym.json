      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чоловічий і середній рід: -om",
          "text": "Орудний відповідає на питання «s kým? s čím?» — з ким? з чим? Чоловічий рід (і живі, і неживі іменники) має закінчення -om: «brat → s bratom», «kolega → s kolegom», «muž → s mužom». Середній рід теж -om: «auto → s autom», «mesto → s mestom». Іменники на -ie мають -ím: «námestie → námestím». Прикметник — -ým (м’які -ím): «s novým kolegom», «s cudzím človekom».",
          "examples": [
            {
              "sk": "Bývam s bratom.",
              "uk": "Я живу з братом."
            },
            {
              "sk": "Pracujem s novým kolegom.",
              "uk": "Я працюю з новим колегою."
            }
          ],
          "shortRule": "чол. і сер. рід: -om; прикметник -ým",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Жіночий рід: -ou; s і so",
          "text": "Жіночий рід має -ou: «žena → so ženou», «mama → s mamou», «kolegyňa → s kolegyňou», «kosť → s kosťou». Прикметник і займенник теж -ou: «s mojou sestrou», «s novou kolegyňou». Прийменник «s» перед s, z, š, ž і деякими групами приголосних має форму «so»: «so sestrou», «so Zuzanou», «so ženou», «so švagrom».",
          "examples": [
            {
              "sk": "Bývam so sestrou.",
              "uk": "Я живу із сестрою."
            },
            {
              "sk": "Idem do kina s kamarátkou.",
              "uk": "Я йду в кіно з подругою."
            }
          ],
          "shortRule": "жін. рід: -ou; so перед s, z, š, ž",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Множина: -mi, -ami",
          "text": "У множині орудний закінчується на -mi або -ami: «priatelia → s priateľmi», «kolegovia → s kolegami», «ženy → so ženami», «autá → s autami». Особливі форми треба запам’ятати: «deti → s deťmi», «ľudia → s ľuďmi». Прикметник у множині — -ými: «s novými kolegami».",
          "examples": [
            {
              "sk": "Cez víkend som s deťmi doma.",
              "uk": "На вихідних я з дітьми вдома."
            },
            {
              "sk": "Rád sa rozprávam s ľuďmi.",
              "uk": "Я люблю розмовляти з людьми."
            }
          ],
          "shortRule": "мн.: -mi / -ami; s deťmi, s ľuďmi",
          "commonMistakes": [
            {
