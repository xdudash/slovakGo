      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Byť kým?",
          "text": "Про професію можна сказати з називним або з орудним: «Som kuchár» і «Som kuchárom». Про бажання й минуле частіше орудний: «Chcem byť lekárom», «Na Ukrajine som bola učiteľkou». Питання: «Kým / Čím chceš byť?» — ким ти хочеш бути? «Čím ste povolaním?» — хто ви за фахом?",
          "examples": [
            {
              "sk": "Syn chce byť hasičom.",
              "uk": "Син хоче бути пожежником."
            },
            {
              "sk": "Doma som bola účtovníčkou.",
              "uk": "Удома я була бухгалтеркою."
            }
          ],
          "shortRule": "byť + називний або орудний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pracovať ako + називний",
          "text": "Після «ako» — називний, не орудний: «Pracujem ako vodič», «Pracuje ako opatrovateľka». Українське «працюю водієм» словацькою — «pracujem ako vodič». А «stať sa» — завжди з орудним: «Stal sa vodičom».",
          "examples": [
            {
              "sk": "Pracujem ako zvárač v Trnave.",
              "uk": "Я працюю зварником у Трнаві."
            },
            {
              "sk": "Manželka pracuje ako zdravotná sestra.",
              "uk": "Дружина працює медсестрою."
            }
          ],
          "shortRule": "pracovať ako + називний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Жіночі форми",
          "text": "Більшість професій має жіночу форму: «učiteľ → učiteľka», «kuchár → kuchárka», «programátor → programátorka», «záchranár → záchranárka», «predavač → predavačka». В орудному — -ou: «Stala sa programátorkou», «Chce byť záchranárkou».",
          "examples": [
            {
              "sk": "Dcéra chce byť programátorkou.",
              "uk": "Донька хоче бути програмісткою."
            },
            {
              "sk": "Pracuje ako kuchárka v hoteli.",
              "uk": "Вона працює кухаркою в готелі."
            }
          ],
          "shortRule": "-ka; в орудному -kou",
          "commonMistakes": [
            {
              "mistake": "Pracujem ako vodičom.",
              "correct": "Pracujem ako vodič."
            },
            {
              "mistake": "Chcem sa stať hasič.",
              "correct": "Chcem sa stať hasičom."
            },
            {
              "mistake": "Bola som učiteľ.",
              "correct": "Bola som učiteľka."
            }
          ],
          "button": "Далі →"
        }
      ],
