      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три форми наказу",
          "text": "Ty — від форми «oni»: «robia → rob», «spia → spi»; vy — «+ -te»: «robte, spite»; my — «+ -me»: «robme, poďme». Неправильні: «buď, choď, poď, jedz, povedz, maj». Заперечення пишемо разом: «nerob, nechoďte».",
          "examples": [
            {
              "sk": "Poďme domov, už je neskoro.",
              "uk": "Ходімо додому, вже пізно."
            },
            {
              "sk": "Povedzte mi pravdu.",
              "uk": "Скажіть мені правду."
            }
          ],
          "shortRule": "rob · robte · robme · nerob",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вид і ввічливість",
          "text": "Одна дія — доконаний вид: «Zatvor okno.» Заборона — недоконаний: «Nezatváraj okno.» Застереження — доконаний: «Nezabudni!», «Nespadni!». Повторювана дія — недоконаний: «Dávajte mu jesť dvakrát denne.» Ввічливість: «prosím», «Buďte taký láskavý a…», «Mohli by ste…?»",
          "examples": [
            {
              "sk": "Zavolaj mi, ale nevolaj po desiatej.",
              "uk": "Подзвони мені, але не дзвони після десятої."
            },
            {
              "sk": "Buďte taká láskavá a zatvorte okno.",
              "uk": "Будьте ласкаві, зачиніть вікно."
            }
          ],
          "shortRule": "zatvor → nezatváraj · nezabudni",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Príkaz, pokyn, rada, prosba",
          "text": "«Príkaz» — наказ (керівник, поліція); «pokyn» — вказівка, інструкція; «rada» — порада; «prosba» — прохання. Дитині: «Poslúchni mamu!» — послухайся маму! Тому, хто нервує: «Upokoj sa.» — заспокойся. Застереження: «Buď opatrný!» / «Buď opatrná!» — будь обережний / обережна.",
          "examples": [
            {
              "sk": "Buď opatrná, na ceste je ľad.",
              "uk": "Будь обережна, на дорозі лід."
            },
            {
              "sk": "Upokojte sa, všetko vyriešime.",
              "uk": "Заспокойтеся, ми все вирішимо."
            }
          ],
          "shortRule": "príkaz · pokyn · rada · prosba",
          "button": "Далі →"
        }
