      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prosím",
          "text": "Голий наказ «Daj mi to.» звучить різко. Додаємо «prosím»: «Podaj mi, prosím, soľ.» Звертання: «prosím ťa» (до знайомого на «ти»), «prosím vás» (на «vy»): «Prosím vás, kde je tu pošta?» «Prosím» може стояти на початку, всередині (між комами) або в кінці.",
          "examples": [
            {
              "sk": "Zatvorte, prosím, dvere.",
              "uk": "Зачиніть, будь ласка, двері."
            },
            {
              "sk": "Prosím ťa, pomôž mi s taškou.",
              "uk": "Будь ласка, допоможи мені із сумкою."
            }
          ],
          "shortRule": "prosím ťa (ти) · prosím vás (ви)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Buďte taký láskavý",
          "text": "Дуже ввічлива формула: «Buďte taký láskavý a…» (до чоловіка), «Buďte taká láskavá a…» (до жінки) + наказ: «Buďte taká láskavá a zavolajte mi taxík.» На «ти»: «Buď taký dobrý a…». У транспорті чи в натовпі: «Dovoľte, prosím.» — дозвольте пройти; «Posuňte sa, prosím.» — посуньтеся, будь ласка.",
          "examples": [
            {
              "sk": "Buďte taký láskavý a podajte mi ten kufor.",
              "uk": "Будьте ласкаві, подайте мені цю валізу."
            },
            {
              "sk": "Dovoľte, prosím, vystupujem.",
              "uk": "Дозвольте, будь ласка, я виходжу."
            }
          ],
          "shortRule": "taký láskavý (він) · taká láskavá (вона)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Mohli by ste…?",
          "text": "Найм’якше прохання — питання з умовним способом: «Mohli by ste mi pomôcť?» — Чи не могли б ви мені допомогти? До однієї людини на «vy» — завжди «mohli by ste», і до чоловіка, і до жінки. На «ти»: «Mohol by si…?» (до чоловіка), «Mohla by si…?» (до жінки). Умовний спосіб докладно — у наступному розділі.",
          "examples": [
            {
              "sk": "Mohli by ste hovoriť pomalšie?",
              "uk": "Чи не могли б ви говорити повільніше?"
            },
            {
              "sk": "Mohla by si mi poslať tú fotku?",
              "uk": "Чи не могла б ти надіслати мені те фото?"
            }
          ],
          "shortRule": "mohli by ste + інфінітив",
          "commonMistakes": [
            {
              "mistake": "Buďte taký láskavá.",
              "correct": "Buďte taká láskavá."
            },
            {
              "mistake": "Prosím ťa, pani doktorka.",
              "correct": "Prosím vás, pani doktorka."
            },
            {
              "mistake": "Mohli ste by mi pomôcť?",
              "correct": "Mohli by ste mi pomôcť?"
            }
          ],
          "button": "Далі →"
        }
