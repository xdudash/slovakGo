      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Rada ako rozkaz",
          "text": "Другові часто радимо просто наказом: «Choď k lekárovi.» «Vypi si čaj s medom.» Пом’якшують: «skús» (спробуй) + інфінітив — «Skús sa vyspať.»; «radšej» (краще) — «Radšej zostaň doma.»; «určite» (обов’язково) — «Určite si to pozri.»",
          "examples": [
            {
              "sk": "Skús mu zavolať ešte raz.",
              "uk": "Спробуй подзвонити йому ще раз."
            },
            {
              "sk": "Radšej si zober dáždnik.",
              "uk": "Краще візьми парасольку."
            }
          ],
          "shortRule": "skús + інфінітив · radšej + наказ",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mal by si…",
          "text": "М’якша порада — «mal by si» (до чоловіка), «mala by si» (до жінки), «mali by ste» (ввічливо або кільком) + інфінітив: «Mali by ste si oddýchnuť.» — Вам варто відпочити. «Na tvojom mieste by som…» — На твоєму місці я б… Докладно про умовний спосіб — у наступному розділі.",
          "examples": [
            {
              "sk": "Mala by si viac spať.",
              "uk": "Тобі варто більше спати."
            },
            {
              "sk": "Na tvojom mieste by som tam nešiel.",
              "uk": "На твоєму місці я б туди не йшов."
            }
          ],
          "shortRule": "mal(a) by si · mali by ste + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odporúčam, daj si pozor",
          "text": "Офіційніша порада: «Odporúčam vám…» + інфінітив: «Odporúčam vám užívať tieto lieky ráno.» Застереження: «Dajte si pozor na…» + знахідний — остерігайтеся… «Vyhýbajte sa…» + давальний — уникайте: «Vyhýbajte sa stresu.» Заборона-порада: «Nepreháňaj to!» — не перестарайся!",
          "examples": [
            {
              "sk": "Odporúčam vám ísť na pohotovosť.",
              "uk": "Раджу вам звернутися до невідкладної допомоги."
            },
            {
              "sk": "Dajte si pozor na vreckárov.",
              "uk": "Остерігайтеся кишенькових злодіїв."
            }
          ],
