      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ne- разом",
          "text": "Заперечна частка «ne-» пишеться разом із дієсловом: «nerob», «nehovor», «nefajčite», «nechoďme». Наголос падає на «ne-». Для «ти», «ви» і «ми» правило однакове.",
          "examples": [
            {
              "sk": "Nehovor to nikomu.",
              "uk": "Нікому цього не кажи."
            },
            {
              "sk": "Nefajčite tu, prosím.",
              "uk": "Не паліть тут, будь ласка."
            }
          ],
          "shortRule": "ne + наказ: nerob, nerobte, nerobme",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Заборона — недоконаний вид",
          "text": "Позитивний наказ про одну конкретну дію зазвичай доконаний: «Zatvor okno.» «Kúp chlieb.» «Zavolaj mu.» Якщо ж просимо цього НЕ робити, беремо недоконаний вид: «Nezatváraj okno.» «Nekupuj chlieb.» «Nevolaj mu.» Так само в українській: «купи» — але «не купуй».",
          "examples": [
            {
              "sk": "Kúp mlieko, ale nekupuj chlieb, ešte máme.",
              "uk": "Купи молоко, але не купуй хліба, у нас ще є."
            },
            {
              "sk": "Zavolaj mi zajtra, dnes mi nevolaj.",
              "uk": "Подзвони мені завтра, сьогодні не дзвони."
            }
          ],
          "shortRule": "zatvor → nezatváraj · kúp → nekupuj · zavolaj → nevolaj",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Застереження — доконаний вид",
          "text": "Коли застерігаємо від того, що може статися ненавмисно, вживаємо доконаний вид: «Nezabudni na kľúče!» — не забудь; «Nespadni!» — не впади; «Nestrať to!» — не загуби; «Neprechladni!» — не застудися; «Nezmeškaj vlak!» — не спізнися на потяг. Часті фрази: «Neboj sa.» — не бійся; «Netráp sa.» — не переймайся.",
          "examples": [
            {
              "sk": "Nezabudnite si zobrať doklady!",
              "uk": "Не забудьте взяти документи!"
            },
            {
              "sk": "Daj pozor, nespadni!",
              "uk": "Обережно, не впади!"
            }
          ],
          "shortRule": "nezabudni, nespadni, nestrať, neprechladni — ненавмисне",
          "commonMistakes": [
            {
              "mistake": "Ne rob to!",
              "correct": "Nerob to!"
            },
            {
              "mistake": "Nezatvor okno!",
              "correct": "Nezatváraj okno!"
            },
            {
              "mistake": "Nezavolaj mi!",
              "correct": "Nevolaj mi!"
            }
          ],
          "button": "Далі →"
        }
      ],
