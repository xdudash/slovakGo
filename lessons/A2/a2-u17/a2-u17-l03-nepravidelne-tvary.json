      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Dobrý → lepší, zlý → horší",
          "text": "Як і в українській (добрий → кращий), деякі прикметники мають інший корінь: «dobrý → lepší → najlepší», «zlý → horší → najhorší». Форм «dobrejší» чи «zlejší» немає.",
          "examples": [
            {
              "sk": "Tento rok je lepší ako minulý.",
              "uk": "Цей рік кращий за минулий."
            },
            {
              "sk": "Pondelok je najhorší deň v týždni.",
              "uk": "Понеділок — найгірший день тижня."
            }
          ],
          "shortRule": "dobrý → lepší → najlepší · zlý → horší → najhorší",
          "commonMistakes": [
            {
              "mistake": "dobrejší",
              "correct": "lepší"
            },
            {
              "mistake": "viac dobrý",
              "correct": "lepší"
            },
            {
              "mistake": "najdobrejší",
              "correct": "najlepší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Veľký → väčší, malý → menší",
          "text": "«veľký → väčší → najväčší», «malý → menší → najmenší». Зверни увагу на «ä» у «väčší». Жіночий рід: «väčšia izba», «menšia kuchyňa»; середній: «väčšie mesto».",
          "examples": [
            {
              "sk": "Potrebujeme väčší byt.",
              "uk": "Нам потрібна більша квартира."
            },
            {
              "sk": "Bratislava je najväčšie mesto na Slovensku.",
              "uk": "Братислава — найбільше місто Словаччини."
            }
          ],
          "shortRule": "veľký → väčší → najväčší · malý → menší → najmenší",
          "commonMistakes": [
            {
              "mistake": "veľkejší",
              "correct": "väčší"
            },
            {
              "mistake": "malejší",
              "correct": "menší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pekný → krajší",
          "text": "«pekný → krajší → najkrajší» — гарний → гарніший → найгарніший. У розмові іноді чути «peknejší», але правильна форма — «krajší». Ці неправильні форми теж мають рід: «krajší deň», «krajšia ulica», «krajšie počasie».",
          "examples": [
            {
              "sk": "Ktoré mesto je podľa teba najkrajšie?",
              "uk": "Яке місто, на твою думку, найгарніше?"
            },
            {
              "sk": "Dnes je krajšie počasie ako včera.",
              "uk": "Сьогодні гарніша погода, ніж учора."
            }
          ],
          "shortRule": "pekný → krajší → najkrajší",
          "button": "Далі →"
        }
      ],
