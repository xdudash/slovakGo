      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Tri stupne",
          "text": "Усе разом: «lacný → lacnejší → najlacnejší», «vysoký → vyšší → najvyšší», «dobrý → lepší → najlepší», «zlý → horší → najhorší», «veľký → väčší → najväčší», «malý → menší → najmenší». Рід: «-ší, -šia, -šie». Прислівники: «rýchlo → rýchlejšie», «dobre → lepšie», «veľa → viac → najviac», «málo → menej → najmenej».",
          "examples": [
            {
              "sk": "Toto je najlepšia ponuka.",
              "uk": "Це найкраща пропозиція."
            },
            {
              "sk": "Najmenej času mám v pondelok.",
              "uk": "Найменше часу в мене в понеділок."
            }
          ],
          "shortRule": "-ší / -ejší · naj- · lepší, horší, väčší, menší",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ako porovnávať",
          "text": "«ako / než» + називний: «starší ako ja». Різниця: «o dve eurá lacnejší», «oveľa lepší», «trochu drahší». Однаково: «rovnako … ako». Не такий: «nie je taký … ako». Найкращий із: «najlepší z troch», «najlacnejší v meste».",
          "examples": [
            {
              "sk": "Tento byt je o sto eur lacnejší ako ten prvý.",
              "uk": "Ця квартира на сто євро дешевша, ніж перша."
            },
            {
              "sk": "Je to najlacnejší z troch.",
              "uk": "Це найдешевший із трьох."
            }
          ],
          "shortRule": "ako / než · o + знахідний · z + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Výhody a nevýhody",
          "text": "Коли вибираєш, говори про «výhody» (переваги) і «nevýhody» (недоліки): «Výhodou je nižšia cena. Nevýhodou je dlhšia cesta.» (výhodou — орудний відмінок). Також: «Má to jednu veľkú výhodu.» Найбільше / найменше — «najviac» / «najmenej»: «Najviac míňame za bývanie.»",
          "examples": [
            {
              "sk": "Veľkou výhodou je nižšia cena.",
              "uk": "Великою перевагою є нижча ціна."
            },
            {
              "sk": "Nevýhodou je, že je to ďaleko.",
              "uk": "Недолік у тому, що це далеко."
            }
          ],
          "shortRule": "výhoda (+) ↔ nevýhoda (−)",
          "commonMistakes": [
            {
              "mistake": "najviac lacný",
              "correct": "najlacnejší"
            },
            {
              "mistake": "viac lepší",
              "correct": "lepší"
            }
          ],
          "button": "Далі →"
        }
      ],
