      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Rýchlo → rýchlejšie",
          "text": "Прислівник відповідає на питання «як?». Вищий ступінь закінчується на «-ejšie» або «-šie»: «rýchlo → rýchlejšie», «často → častejšie», «pomaly → pomalšie», «draho → drahšie», «ďaleko → ďalej», «blízko → bližšie». Найвищий — з «naj-»: «najrýchlejšie», «najčastejšie».",
          "examples": [
            {
              "sk": "Hovorte, prosím, pomalšie.",
              "uk": "Говоріть, будь ласка, повільніше."
            },
            {
              "sk": "Ráno chodia autobusy častejšie.",
              "uk": "Уранці автобуси ходять частіше."
            }
          ],
          "shortRule": "-o → -ejšie / -šie · naj- → najrýchlejšie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Lepšie, horšie, viac, menej",
          "text": "Неправильні форми: «dobre → lepšie → najlepšie», «zle → horšie → najhoršie», «veľa → viac → najviac», «málo → menej → najmenej». Порівняй: «Je to lepší kurz.» (який? — прикметник) і «Hovorí lepšie po slovensky.» (як? — прислівник).",
          "examples": [
            {
              "sk": "Už hovorím lepšie po slovensky.",
              "uk": "Я вже краще розмовляю словацькою."
            },
            {
              "sk": "Teraz pracujem menej.",
              "uk": "Тепер я працюю менше."
            }
          ],
          "shortRule": "lepší (який?) ↔ lepšie (як?)",
          "commonMistakes": [
            {
              "mistake": "Hovorí lepší po slovensky.",
              "correct": "Hovorí lepšie po slovensky."
            },
            {
              "mistake": "viac lepšie",
              "correct": "lepšie"
            },
            {
              "mistake": "dobrejšie",
              "correct": "lepšie"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čo najskôr, stále lepšie",
          "text": "«Čo» + найвищий ступінь означає «якомога»: «čo najrýchlejšie» — якомога швидше, «čo najskôr» — якомога раніше, «čo najlacnejšie» — якомога дешевше. «Stále» + вищий ступінь — «дедалі»: «stále lepšie», «stále viac».",
          "examples": [
            {
              "sk": "Odpíšte mi, prosím, čo najskôr.",
              "uk": "Відпишіть мені, будь ласка, якомога швидше."
            },
            {
              "sk": "Rozumiem stále viac.",
              "uk": "Я розумію дедалі більше."
            }
          ],
          "shortRule": "čo + naj-: čo najskôr · stále + вищий ступінь",
          "button": "Далі →"
        }
      ],
