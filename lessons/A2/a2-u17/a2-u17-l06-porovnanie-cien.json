      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Lacnejšie, drahšie",
          "text": "Ціни порівнюємо так: «Na trhu je to lacnejšie.» — дешевше; «Tu je to drahšie.» — дорожче. Зверни увагу: «lacnejšie» буває прислівником (kúpiť lacnejšie) і прикметником середнього роду чи множини (lacnejšie mlieko, lacnejšie topánky). «Porovnať ceny» — порівняти ціни.",
          "examples": [
            {
              "sk": "Na trhu je ovocie lacnejšie.",
              "uk": "На ринку фрукти дешевші."
            },
            {
              "sk": "Online to kúpiš lacnejšie.",
              "uk": "Онлайн ти це купиш дешевше."
            }
          ],
          "shortRule": "lacnejšie ↔ drahšie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Jednotková cena",
          "text": "На цінниках у Словаччині є «jednotková cena» — ціна за 1 kg, 1 l або 1 kus. Саме її варто порівнювати: велика упаковка не завжди вигідніша. «Za kilo» — розмовно, «za kilogram» — офіційно.",
          "examples": [
            {
              "sk": "Veľké balenie je drahšie, ale za kilo je lacnejšie.",
              "uk": "Велика упаковка дорожча, але за кілограм дешевша."
            },
            {
              "sk": "Jednotková cena je 3,20 € za kilogram.",
              "uk": "Ціна за одиницю — 3,20 € за кілограм."
            }
          ],
          "shortRule": "porovnávaj cenu za 1 kg / 1 l",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Zlacnieť, zdražieť",
          "text": "«Zlacnieť» — подешевшати, «zdražieť» — подорожчати: «Maslo zlacnelo.», «Benzín zdražel o desať centov.» Минулий час: zlacnel, zlacnela, zlacnelo, zlacneli; zdražel, zdražela, zdraželo, zdraželi. На скільки? — «o» + знахідний.",
          "examples": [
            {
              "sk": "Káva zdražela o pol eura.",
              "uk": "Кава подорожчала на пів євро."
            },
            {
              "sk": "Paradajky zlacneli.",
              "uk": "Помідори подешевшали."
            }
          ],
          "shortRule": "zlacnieť (−) ↔ zdražieť (+) · o + знахідний",
          "commonMistakes": [
            {
              "mistake": "Maslo zlacnilo.",
              "correct": "Maslo zlacnelo."
            },
            {
              "mistake": "zdražel na desať centov",
              "correct": "zdražel o desať centov"
            }
          ],
          "button": "Далі →"
        }
      ],
