      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Recenzia a hodnotenie",
          "text": "«Recenzia» — відгук (про ресторан, товар, готель), «hodnotenie» — оцінка, рейтинг. Оцінюють «hviezdičkami» — зірочками: «päť hviezdičiek z piatich», «hodnotenie 4,6 z 5». Після 2, 3, 4 — «hviezdičky», після 5 і більше — «hviezdičiek».",
          "examples": [
            {
              "sk": "Reštaurácia má hodnotenie 4,7.",
              "uk": "Ресторан має рейтинг 4,7."
            },
            {
              "sk": "Dal som tri hviezdičky z piatich.",
              "uk": "Я поставив три зірочки з п’яти."
            }
          ],
          "shortRule": "1 hviezdička · 2 – 4 hviezdičky · 5 hviezdičiek",
          "commonMistakes": [
            {
              "mistake": "päť hviezdičky",
              "correct": "päť hviezdičiek"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vynikajúci, priemerný, sklamaný",
          "text": "Шкала: «vynikajúci» (чудовий), «výborný», «dobrý», «priemerný» (середній, посередній), «zlý», «najhorší». Почуття клієнта: «spokojný» — задоволений, «sklamaný» — розчарований: «Som sklamaný z obsluhy.» (z + родовий).",
          "examples": [
            {
              "sk": "Jedlo bolo vynikajúce.",
              "uk": "Їжа була чудова."
            },
            {
              "sk": "Bola som sklamaná z kvality.",
              "uk": "Я була розчарована якістю."
            }
          ],
          "shortRule": "sklamaný z + родовий",
          "commonMistakes": [
            {
              "mistake": "sklamaný s obsluhou",
              "correct": "sklamaný z obsluhy"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Porovnanie v recenzii",
          "text": "У відгуках часто порівнюють: «Lepšie ako minule.», «Najlepšia pizza v meste!», «Drahšie ako inde, ale kvalita je vynikajúca.» Корисні фрази: «Odporúčam.» — рекомендую; «Neodporúčam.» — не рекомендую; «Prídeme znova.» — прийдемо ще.",
          "examples": [
            {
              "sk": "Najlepšia kaviareň v Trnave, odporúčam!",
              "uk": "Найкраща кав’ярня в Трнаві, рекомендую!"
            },
            {
              "sk": "Obsluha bola pomalšia ako minule.",
              "uk": "Обслуговування було повільнішим, ніж минулого разу."
            }
          ],
          "shortRule": "odporúčam ↔ neodporúčam",
          "button": "Далі →"
        }
      ],
