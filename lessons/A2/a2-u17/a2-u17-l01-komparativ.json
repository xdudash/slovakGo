      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Vyšší stupeň: -ší a -ejší",
          "text": "Вищий ступінь прикметника утворюємо суфіксом «-ší» або «-ejší». «-ší» — переважно в коротких прикметниках: «mladý → mladší», «starý → starší», «nový → novší», «dlhý → dlhší», «drahý → drahší». «-ejší» — у багатьох інших: «teplý → teplejší», «lacný → lacnejší», «rýchly → rýchlejší», «čistý → čistejší». Яку форму вибрати, запам’ятовуй разом зі словом.",
          "examples": [
            {
              "sk": "Tento byt je novší.",
              "uk": "Ця квартира новіша."
            },
            {
              "sk": "Dnes je teplejší deň ako včera.",
              "uk": "Сьогодні тепліший день, ніж учора."
            }
          ],
          "shortRule": "-ší: mladší, dlhší · -ejší: teplejší, lacnejší",
          "commonMistakes": [
            {
              "mistake": "tepleší",
              "correct": "teplejší"
            },
            {
              "mistake": "dlhejší",
              "correct": "dlhší"
            },
            {
              "mistake": "viac lacný",
              "correct": "lacnejší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vysoký → vyšší",
          "text": "У прикметниках на «-ký», «-oký» ця частина зникає, а приголосний перед «-ší» часто змінюється: «vysoký → vyšší», «nízky → nižší», «krátky → kratší», «ťažký → ťažší», «ľahký → ľahší», «široký → širší». Так само в українській: високий → вищий, низький → нижчий.",
          "examples": [
            {
              "sk": "Môj brat je vyšší ako ja.",
              "uk": "Мій брат вищий за мене."
            },
            {
              "sk": "Táto cesta je kratšia.",
              "uk": "Ця дорога коротша."
            }
          ],
          "shortRule": "vysoký → vyšší · nízky → nižší · krátky → kratší",
          "commonMistakes": [
            {
              "mistake": "vysokejší",
              "correct": "vyšší"
            },
            {
              "mistake": "krátkejší",
              "correct": "kratší"
            },
            {
              "mistake": "ťažkejší",
              "correct": "ťažší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Vyšší, vyššia, vyššie",
          "text": "Вищий ступінь відмінюється як «cudzí»: чоловічий рід «-ší» (vyšší dom), жіночий «-šia» (vyššia cena), середній «-šie» (vyššie číslo). У множині: «vyšší muži», але «vyššie ceny», «vyššie domy». Знахідний жіночого роду: «Chcem kratšiu cestu.»",
          "examples": [
            {
              "sk": "Nájom je tu vyšší.",
              "uk": "Оренда тут вища."
            },
            {
              "sk": "Hľadám teplejšiu bundu.",
              "uk": "Я шукаю теплішу куртку."
            }
          ],
          "shortRule": "-ší (m) · -šia (ž) · -šie (s) · -šiu (знахідний ž)",
          "button": "Далі →"
        }
      ],
