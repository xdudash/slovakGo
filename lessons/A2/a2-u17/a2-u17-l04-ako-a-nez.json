      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ako a než",
          "text": "«Ніж» / «за» по-словацьки — «ako» або «než»: «Vlak je rýchlejší ako autobus» або «Vlak je rýchlejší než autobus». Обидва варіанти правильні, у розмові частіше «ako». Після «ako / než» займенник стоїть у називному: «Som starší ako ty», а не «ako teba». Прийменника «od» тут немає.",
          "examples": [
            {
              "sk": "Káva je tu drahšia ako v Nitre.",
              "uk": "Кава тут дорожча, ніж у Нітрі."
            },
            {
              "sk": "Moja sestra je mladšia než ja.",
              "uk": "Моя сестра молодша за мене."
            }
          ],
          "shortRule": "drahší ako / než + називний",
          "commonMistakes": [
            {
              "mistake": "starší ako mňa",
              "correct": "starší ako ja"
            },
            {
              "mistake": "lacnejší od autobusu",
              "correct": "lacnejší ako autobus"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "O koľko? Oveľa, trochu",
          "text": "Різницю показує «o» + знахідний: «o dve eurá lacnejší», «o rok starší», «o desať minút rýchlejší». «Oveľa» — набагато: «oveľa lepší»; «trochu» — трохи: «trochu drahší»; «ešte» — ще: «ešte lacnejší». «Veľmi» з вищим ступенем не вживають.",
          "examples": [
            {
              "sk": "Tento telefón je o sto eur lacnejší.",
              "uk": "Цей телефон на сто євро дешевший."
            },
            {
              "sk": "Vlak je oveľa rýchlejší.",
              "uk": "Поїзд набагато швидший."
            }
          ],
          "shortRule": "o + знахідний · oveľa · trochu · ešte",
          "commonMistakes": [
            {
              "mistake": "na sto eur lacnejší",
              "correct": "o sto eur lacnejší"
            },
            {
              "mistake": "veľmi lepší",
              "correct": "oveľa lepší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Rovnako ako, nie taký ako",
          "text": "Однаково: «rovnako … ako»: «Byt je rovnako veľký ako náš.» Не такий: «nie je taký … ako»: «Košice nie sú také veľké ako Bratislava.» «Rovnaký» — однаковий: «Máme rovnaký telefón.» «Podobný» + давальний — схожий на: «Slovenčina je podobná ukrajinčine.» «Rozdiel medzi» + орудний — різниця між.",
          "examples": [
            {
              "sk": "Lístok na vlak stojí rovnako ako lístok na autobus.",
              "uk": "Квиток на поїзд коштує стільки ж, скільки на автобус."
            },
            {
              "sk": "Nový byt nie je taký veľký ako starý.",
              "uk": "Нова квартира не така велика, як стара."
            }
          ],
          "shortRule": "rovnako … ako · nie taký … ako · rozdiel medzi + орудний",
          "button": "Далі →"
        }
      ],
