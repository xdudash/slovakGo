      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Naj- + vyšší stupeň",
          "text": "Найвищий ступінь — це «naj-» + вищий ступінь, разом: «lacnejší → najlacnejší», «starší → najstarší», «vyšší → najvyšší». Українською так само: найдешевший, найстаріший. Форма «najviac lacný» неправильна.",
          "examples": [
            {
              "sk": "Toto je najlacnejší telefón.",
              "uk": "Це найдешевший телефон."
            },
            {
              "sk": "Gerlachovský štít je najvyšší vrch Slovenska.",
              "uk": "Герлахівський Штит — найвища вершина Словаччини."
            }
          ],
          "shortRule": "naj + -ší / -ejší (разом)",
          "commonMistakes": [
            {
              "mistake": "najviac lacný",
              "correct": "najlacnejší"
            },
            {
              "mistake": "naj lacnejší",
              "correct": "najlacnejší"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Z, v, na",
          "text": "З чого вибираємо? — «z» + родовий: «najlacnejší z troch», «najmladší z nás». Де? — «v» / «na» + місцевий: «najstaršia kaviareň v meste», «najvyšší vrch na Slovensku».",
          "examples": [
            {
              "sk": "Mária je najmladšia z nás.",
              "uk": "Марія наймолодша з нас."
            },
            {
              "sk": "Je to najlepšia kaviareň v meste.",
              "uk": "Це найкраща кав’ярня в місті."
