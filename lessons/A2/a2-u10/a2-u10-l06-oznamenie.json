      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Lístok v schránke",
          "text": "Якщо тебе не застали вдома, у поштовій скриньці буде «Oznámenie o uložení zásielky» — повідомлення, що відправлення залишили на пошті. Там написано: хто адресат, який вид відправлення, на якій пошті й до якого числа його можна забрати. Дієслово «uložiť» — залишити на зберігання: «Zásielka je uložená na pošte do 18. 11.»",
          "examples": [
            {
              "sk": "Mám v schránke oznámenie.",
              "uk": "У мене в скриньці повідомлення."
            },
            {
              "sk": "List je uložený na pošte.",
              "uk": "Лист чекає на пошті."
            }
          ],
          "shortRule": "oznámenie + doklad → pošta",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Doklad a splnomocnenie",
          "text": "Щоб отримати відправлення, покажи документ: «občiansky preukaz», паспорт або документ про перебування. Якщо замість тебе йде інша людина, їй потрібна довіреність: «Za iného človeka môžete zásielku prevziať len so splnomocnením». Іти по посилку — «ísť po balík» (po + знахідний).",
          "examples": [
            {
              "sk": "Prosím si zásielku, tu je oznámenie a pas.",
              "uk": "Мені відправлення, ось повідомлення й паспорт."
            },
            {
              "sk": "Idem po balík za manžela.",
              "uk": "Я йду по посилку замість чоловіка."
            }
          ],
          "shortRule": "ísť po + знахідний; so splnomocnením",
          "commonMistakes": [
            {
              "mistake": "Mám v schránke oznámení.",
              "correct": "Mám v schránke oznámenie."
            },
            {
              "mistake": "Idem na poštu na balík.",
              "correct": "Idem na poštu po balík."
            },
            {
              "mistake": "so splnomocnenie",
              "correct": "so splnomocnením"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Do vlastných rúk",
          "text": "Офіційні листи (з úradu, від суду, від роботодавця) часто бувають «do vlastných rúk» — особисто в руки. Їх видають самому адресатові, а іншій людині — лише зі спеціальною, офіційно засвідченою довіреністю. Такий лист не можна ігнорувати: якщо його не забрати вчасно, він може вважатися врученим.",
          "examples": [
            {
              "sk": "Prišiel mi list do vlastných rúk.",
              "uk": "Мені прийшов лист «особисто в руки»."
            },
            {
              "sk": "Musím ísť na poštu osobne.",
              "uk": "Мені треба йти на пошту особисто."
            }
          ],
          "shortRule": "do vlastných rúk = особисто адресатові",
          "button": "Далі →"
        }
      ],
