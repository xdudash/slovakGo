      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "List, balík, zásielka",
          "text": "«List» — лист у конверті, «balík» — посилка, а «zásielka» — загальне слово для будь-якого відправлення. На сайтах і в SMS ти найчастіше бачитимеш саме його: «Vaša zásielka je na ceste». Листи бувають «obyčajný» (звичайний, дешевший), «prioritný» (пріоритетний, швидший) і «doporučený» (рекомендований, із підписом одержувача).",
          "examples": [
            {
              "sk": "Posielam mame balík.",
              "uk": "Я надсилаю мамі посилку."
            },
            {
              "sk": "Vaša zásielka bola doručená.",
              "uk": "Ваше відправлення доставлено."
            }
          ],
          "shortRule": "list, balík → zásielka",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Poslať komu, kam, ako",
          "text": "Схема: «poslať» + що (знахідний) + кому (давальний) + куди + як. Куди: «na Ukrajinu, na Slovensko», але «do Poľska, do Česka, do Kyjeva». Як — орудний відмінок без прийменника: «poštou» (поштою), «kuriérom» (кур’єром), або прислівник «letecky» (авіа).",
          "examples": [
            {
              "sk": "Pošlem sestre balík na Ukrajinu.",
              "uk": "Я надішлю сестрі посилку в Україну."
            },
            {
              "sk": "Dokumenty pošlem kuriérom.",
              "uk": "Документи я надішлю кур’єром."
            }
          ],
          "shortRule": "poslať čo + komu + kam + čím",
