      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Poradie v adrese",
          "text": "Словацька адреса: 1) ім’я та прізвище; 2) вулиця й номер; 3) PSČ і місто; 4) країна (для закордону — великими літерами). PSČ — п’ять цифр, після трьох — пробіл: «949 01 Nitra». Про вулицю кажуть з «na»: «bývam na Hlavnej».",
          "examples": [
            {
              "sk": "Hlavná 12, 949 01 Nitra",
              "uk": "вулиця Головна, 12, 949 01 Нітра"
            },
            {
              "sk": "Bývam na Štúrovej 5.",
              "uk": "Я живу на вулиці Штурова, 5."
            }
          ],
          "shortRule": "meno → ulica a číslo → PSČ a mesto → KRAJINA",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dve čísla na dome",
          "text": "На багатьох будинках два номери, наприклад «1243/15». Перше — «súpisné číslo» (реєстраційний номер будинку в громаді), друге — «orientačné číslo» (номер на вулиці). Кур’єрові для орієнтації потрібне саме orientačné. У селах без назв вулиць пишуть назву села й súpisné číslo: «Malá Ves 245».",
          "examples": [
            {
              "sk": "Bývam na Hlavnej 1243/15.",
              "uk": "Я живу на вулиці Головній, 1243/15."
            },
            {
              "sk": "Bývame v obci Malá Ves, číslo 245.",
              "uk": "Ми живемо в селі Мала Вес, номер 245."
            }
          ],
          "shortRule": "súpisné / orientačné",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Byt, zvonček, poznámka",
          "text": "У багатоквартирному будинку кур’єрові допоможе «poznámka»: поверх, номер квартири, ім’я на дзвінку. Твоє ім’я має бути й на поштовій скриньці — інакше листоноша може не знайти адресата. Перевір кожен «údaj»: один «preklep» у номері — і посилка поїде не туди.",
          "examples": [
            {
              "sk": "3. poschodie, byt 12, zvonček Kovalenko.",
              "uk": "3-й поверх, квартира 12, дзвінок «Коваленко»."
            },
            {
              "sk": "V adrese je preklep.",
              "uk": "В адресі описка."
            }
          ],
          "shortRule": "adresa + poznámka pre kuriéra",
          "commonMistakes": [
            {
              "mistake": "Nitra 949 01",
              "correct": "949 01 Nitra"
            },
            {
              "mistake": "Bývam v Hlavnej ulici.",
              "correct": "Bývam na Hlavnej ulici."
            }
          ],
          "button": "Далі →"
