      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kuriér volá",
          "text": "Перед доставкою кур’єр часто телефонує або пише SMS: «Dobrý deň, tu kuriér, mám pre vás balík. Budete doma medzi druhou a štvrtou?» Відповіді: «Áno, budem doma» або «Nie, budem v práci. Môžete prísť po piatej?»",
          "examples": [
            {
              "sk": "Budete doma okolo obeda?",
              "uk": "Ви будете вдома близько обіду?"
            },
            {
              "sk": "Som v práci, domov prídem o šiestej.",
              "uk": "Я на роботі, додому прийду о шостій."
            }
          ],
          "shortRule": "Budete doma? — Áno, budem / Nie, nebudem",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Nezastihli sme vás",
          "text": "Якщо тебе немає вдома, кур’єр напише: «Nezastihli sme vás» — ми не застали вас. Далі: «Zásielku doručíme opätovne zajtra» — доставимо повторно завтра, або «Zásielka bola uložená na výdajnom mieste». Дієслово «zastihnúť» (застати): zastihol, zastihla; заперечення — nezastihol.",
          "examples": [
            {
              "sk": "Kuriér ma nezastihol.",
              "uk": "Кур’єр мене не застав."
            },
            {
              "sk": "Skúsime to znova zajtra.",
              "uk": "Спробуємо ще раз завтра."
            }
          ],
          "shortRule": "zastihnúť koho: ma, ťa, vás",
          "commonMistakes": [
            {
              "mistake": "Mohol by ste prísť zajtra?",
              "correct": "Mohli by ste prísť zajtra?"
            },
            {
              "mistake": "Môžete nechať to na vrátnici?",
              "correct": "Môžete to nechať na vrátnici?"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Iný čas, iné miesto",
          "text": "Увічливе прохання — умовний спосіб: «Mohli by ste prísť zajtra?», «Mohli by ste to nechať na vrátnici?», «Mohli by ste balík nechať u susedky?» «Doručovateľ» — загальне слово для того, хто доставляє: листоноші чи кур’єра.",
          "examples": [
            {
              "sk": "Mohli by ste prísť až po piatej?",
              "uk": "Могли б ви приїхати лише після п’ятої?"
            },
            {
              "sk": "Nechajte to, prosím, u suseda.",
              "uk": "Залиште, будь ласка, в сусіда."
            }
          ],
          "shortRule": "mohli by ste + інфінітив",
          "button": "Далі →"
        }
