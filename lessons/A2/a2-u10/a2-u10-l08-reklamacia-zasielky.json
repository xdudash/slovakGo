      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Poškodený balík",
          "text": "Якщо коробка м’ята, мокра чи розірвана, перевір посилку ще при кур’єрові. Можна «spísať záznam o poškodení» — скласти протокол про пошкодження. Сфотографуй усе: «odfoťte obal aj obsah» — упаковку й вміст.",
          "examples": [
            {
              "sk": "Krabica je mokrá a roztrhnutá.",
              "uk": "Коробка мокра й розірвана."
            },
            {
              "sk": "Chcem spísať záznam o poškodení.",
              "uk": "Я хочу скласти протокол про пошкодження."
            }
          ],
          "shortRule": "najprv skontrolovať, potom prevziať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Stratená zásielka",
          "text": "Якщо статус давно не змінюється або посилка не прийшла: «Zásielka mi neprišla», «Zásielka sa stratila» — загубилася. Про проблему треба «nahlásiť» — повідомити перевізника. Рекламацію в перевізника зазвичай подає відправник; якщо ти купував(ла) в інтернет-магазині — пиши продавцеві.",
          "examples": [
            {
              "sk": "Balík mi doteraz neprišiel.",
              "uk": "Посилка мені досі не прийшла."
            },
            {
              "sk": "Chcem nahlásiť stratenú zásielku.",
              "uk": "Я хочу повідомити про загублене відправлення."
            }
          ],
          "shortRule": "neprišla / stratila sa → nahlásiť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ako napísať reklamáciu",
          "text": "Схема: номер відправлення → що сталося → доказ → чого ти хочеш. «Dobrý deň, podávam reklamáciu zásielky č. 5521. Balík prišiel poškodený, váza je rozbitá. V prílohe posielam fotky. Žiadam o náhradu škody.» «Žiadam o…» — офіційне «прошу» + знахідний.",
          "examples": [
            {
              "sk": "Žiadam o vrátenie peňazí.",
              "uk": "Прошу повернути гроші."
            },
            {
              "sk": "V prílohe posielam fotografie.",
              "uk": "У додатку надсилаю фотографії."
            }
          ],
          "shortRule": "žiadam o + знахідний",
          "commonMistakes": [
            {
              "mistake": "Zásielka sa stratil.",
              "correct": "Zásielka sa stratila."
            },
            {
              "mistake": "Žiadam na náhradu.",
              "correct": "Žiadam o náhradu."
            },
            {
              "mistake": "Balík prišiel poškodená.",
              "correct": "Balík prišiel poškodený."
            }
          ],
          "button": "Далі →"
        }
      ],
