      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Mimo EÚ",
          "text": "Посилки з країн поза Європейським Союзом (Україна, США, Китай…) проходять «colnú kontrolu» — митну перевірку. За них можуть нарахувати «clo» — мито та «DPH» — ПДВ (daň z pridanej hodnoty). Усередині ЄС (з Польщі, Чехії, Німеччини) мита немає.",
          "examples": [
            {
              "sk": "Balík z Ukrajiny ide cez colnú kontrolu.",
              "uk": "Посилка з України проходить митну перевірку."
            },
            {
              "sk": "Z Česka sa clo neplatí.",
              "uk": "За посилки з Чехії мито не платять."
            }
          ],
          "shortRule": "mimo EÚ → clo a DPH",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Darček alebo tovar",
          "text": "Подарунок від однієї приватної особи іншій вартістю до 45 € — без мита й без ПДВ. За покупки в інтернет-магазинах поза ЄС ПДВ платять із будь-якої суми, а мито — зазвичай, якщо вартість понад 150 €. Тому в «colnom vyhlásení» важливо чесно вказати, що це: «darček» чи «tovar», і його «hodnotu».",
          "examples": [
            {
              "sk": "Darček do 45 eur je bez cla.",
              "uk": "Подарунок до 45 євро — без мита."
            },
            {
              "sk": "Z nákupu mimo EÚ zaplatíte DPH.",
              "uk": "За покупку з-поза ЄС ви заплатите ПДВ."
            }
          ],
          "shortRule": "darček / tovar + hodnota",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Preclenie",
          "text": "«Zásielka čaká na preclenie» — посилка чекає на митне оформлення. Перевізник напише, скільки заплатити: clo, DPH і часто «poplatok za preclenie» — плату за оформлення. Іноді попросять документ: «faktúru» (рахунок) за товар. Після оплати посилку доставлять.",
          "examples": [
            {
              "sk": "Zaplaťte clo a DPH online.",
              "uk": "Сплатіть мито й ПДВ онлайн."
            },
            {
              "sk": "Pošlite nám faktúru za tovar.",
              "uk": "Надішліть нам рахунок за товар."
            }
          ],
          "shortRule": "preclenie → zaplatiť → doručenie",
