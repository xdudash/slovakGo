      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Sledovacie číslo",
          "text": "Після відправлення ти отримуєш «sledovacie číslo» або «číslo zásielky» — трек-номер. На сайті перевізника вводиш його й натискаєш «Sledovať». Так можна «sledovať zásielku» — відстежувати відправлення онлайн.",
          "examples": [
            {
              "sk": "Mám sledovacie číslo, ale nefunguje.",
              "uk": "У мене є трек-номер, але він не працює."
            },
            {
              "sk": "Kde môžem sledovať balík?",
              "uk": "Де я можу відстежити посилку?"
            }
          ],
          "shortRule": "sledovať zásielku podľa čísla",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Stav zásielky",
          "text": "Статуси пишуть дієприкметником, який узгоджується з іменником: «Zásielka bola podaná / odoslaná / doručená» — zásielka жіночого роду (-á). «Balík bol odoslaný» — чоловічий рід (-ý). Також: «je na ceste» (у дорозі), «v depe» (у сортувальному центрі), «u kuriéra» (у кур’єра), «pripravená na vyzdvihnutie» (готова до видачі).",
          "examples": [
            {
              "sk": "Zásielka bola doručená.",
              "uk": "Відправлення доставлено."
            },
            {
              "sk": "Balík je na ceste.",
              "uk": "Посилка в дорозі."
            }
          ],
          "shortRule": "zásielka … -á / balík … -ý",
          "commonMistakes": [
            {
              "mistake": "Zásielka bol doručený.",
              "correct": "Zásielka bola doručená."
            },
            {
              "mistake": "Balík je na cesta.",
              "correct": "Balík je na ceste."
            },
            {
              "mistake": "sledovať na zásielku",
              "correct": "sledovať zásielku"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Kedy to príde?",
          "text": "Інтернет-магазини пишуть: «Objednávka bola expedovaná» — замовлення відправлено зі складу. «Predpokladaný termín doručenia: 2 – 3 pracovné dni» — орієнтовно 2–3 робочі дні, тобто без гарантії. Якщо статус довго не змінюється, напиши: «Stav zásielky sa nemení už päť dní».",
          "examples": [
            {
              "sk": "Kedy príde môj balík?",
