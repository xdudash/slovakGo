      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Одне прохання — доконаний",
          "text": "Коли просимо зробити щось конкретне один раз, найчастіше вживаємо доконаний вид: «Zatvorte dvere, prosím», «Pošli mi adresu», «Podpíšte to tu». Форми: «zatvor – zatvorte», «zavolaj – zavolajte», «pošli – pošlite», «podpíš – podpíšte».",
          "examples": [
            {
              "sk": "Pošlite mi tú faktúru do piatku.",
              "uk": "Надішліть мені той рахунок до п’ятниці."
            },
            {
              "sk": "Zamkni dvere, prosím.",
              "uk": "Замкни двері, будь ласка."
            }
          ],
          "shortRule": "konkrétna prosba → dokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Правила й звички — недоконаний",
          "text": "Загальні правила будинку чи фірми, поради «завжди так робіть» часто мають недоконаний вид: «Pite veľa vody», «Pri odchode vypínajte svetlo», «Zamykajte vchod».",
          "examples": [
            {
              "sk": "Pri odchode vypínajte svetlo.",
              "uk": "Виходячи, вимикайте світло."
            },
            {
              "sk": "Pite veľa vody.",
              "uk": "Пийте багато води."
            }
          ],
          "shortRule": "pravidlo → často nedokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Заборона й застереження",
          "text": "Заборона — недоконаний вид із «ne-»: «Nefajčite», «Neparkujte pred bránou», «Neotvárajte okno». Доконаний вид із «ne-» — застереження від випадкової помилки: «Nezabudni si kľúče!» — не забудь ключі, «Nespadni!» — не впади. На табличках часто інфінітив: «Nefajčiť», «Neparkovať».",
          "examples": [
            {
              "sk": "Neotvárajte okno, je zima.",
              "uk": "Не відчиняйте вікно, холодно."
            },
            {
              "sk": "Nezabudnite si pas!",
              "uk": "Не забудьте паспорт!"
            }
          ],
          "shortRule": "zákaz → ne + nedokonavý",
          "commonMistakes": [
            {
              "mistake": "Neotvorte okno!",
              "correct": "Neotvárajte okno!"
            },
            {
              "mistake": "Nezaparkujte tu!",
              "correct": "Neparkujte tu!"
            }
          ],
          "button": "Далі →"
        }
