      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Префікси na- і pre-",
          "text": "Префікс «na-»: «písať → napísať», «kresliť → nakresliť», «učiť sa → naučiť sa», «skenovať → naskenovať», «obedovať → naobedovať sa» (зверни увагу: доконане дієслово із «sa»). Префікс «pre-»: «čítať → prečítať».",
          "examples": [
            {
              "sk": "Naučil som sa nové slovíčka.",
              "uk": "Я вивчив нові слова."
            },
            {
              "sk": "Už ste sa naobedovali?",
              "uk": "Ви вже пообідали?"
            }
          ],
          "shortRule": "na-, pre- + дієслово → результат",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Префікси o-, s-, po-, za-",
          "text": "«pýtať sa → opýtať sa» або «spýtať sa» — запитати (обидва варіанти означають те саме), «ďakovať → poďakovať» — подякувати, «telefonovať → zatelefonovať» — зателефонувати.",
          "examples": [
            {
              "sk": "Opýtam sa šéfa.",
              "uk": "Я запитаю шефа."
            },
            {
              "sk": "Poďakovala som susedke za pomoc.",
              "uk": "Я подякувала сусідці за допомогу."
            }
          ],
          "shortRule": "pýtať sa – opýtať sa / spýtať sa",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Префікс змінює значення",
          "text": "Деякі префікси дають нове значення: «písať» — писати, але «podpísať» — підписати, «prepísať» — переписати, «zapísať» — записати. Таке нове дієслово має власну недоконану пару із суфіксом: «podpísať – podpisovať», «prepísať – prepisovať», «zapísať – zapisovať». Як в українській: підписати — підписувати.",
          "examples": [
            {
              "sk": "Podpíšte to, prosím.",
              "uk": "Підпишіть це, будь ласка."
            },
            {
              "sk": "Na úrade podpisujem veľa papierov.",
              "uk": "В установі я підписую багато паперів."
            }
          ],
          "shortRule": "podpísať ≠ napísať",
          "commonMistakes": [
            {
              "mistake": "Už som sa obedoval.",
              "correct": "Už som sa naobedoval."
            },
            {
              "mistake": "Budem opýtať šéfa.",
              "correct": "Opýtam sa šéfa."
            }
          ],
          "button": "Далі →"
        }
      ],
