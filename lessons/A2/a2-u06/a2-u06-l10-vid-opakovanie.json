      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Шпаргалка: коли який вид",
          "text": "Недоконаний: процес, тривалість (celý deň, dlho), дія саме зараз (práve), фон розповіді, заборона (Nefajčite), після budem, začať, prestať. Доконаний: результат, «за + час», ланцюжок подій, раптова подія (zrazu), обіцянка (zavolám), одне конкретне прохання (Zatvorte dvere).",
          "examples": [
            {
              "sk": "Celý deň som písal.",
              "uk": "Цілий день я писав."
            },
            {
              "sk": "Za hodinu som napísal správu.",
              "uk": "За годину я написав звіт."
            }
          ],
          "shortRule": "proces vs výsledok",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Шпаргалка пар",
          "text": "Префікс: robiť – urobiť, písať – napísať, čítať – prečítať, platiť – zaplatiť, jesť – zjesť. Суфікс: kupovať – kúpiť, posielať – poslať, vracať – vrátiť, otvárať – otvoriť. Різні слова: brať – vziať, hovoriť – povedať.",
          "examples": [
            {
              "sk": "Každý týždeň kupujem ovocie.",
              "uk": "Щотижня я купую фрукти."
            },
            {
              "sk": "Zajtra kúpim jahody.",
              "uk": "Завтра я куплю полуниці."
            }
          ],
          "shortRule": "учи дієслова парами",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Час і вид",
          "text": "Теперішній час — лише недоконаний: «píšem». Минулий — обидва: «písal som» (процес) / «napísal som» (результат). Майбутній — «budem písať» (процес) / «napíšem» (результат).",
          "examples": [
            {
              "sk": "Budem pracovať.",
              "uk": "Я працюватиму."
            },
            {
              "sk": "Urobím to.",
              "uk": "Я це зроблю."
            }
          ],
          "shortRule": "3 часи × 2 види",
          "button": "Далі →"
        }
      ],
