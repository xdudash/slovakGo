      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Префікс робить дієслово доконаним",
          "text": "Найчастіше доконаний вид утворюємо префіксом: «robiť → urobiť», «variť → uvariť», «platiť → zaplatiť», «volať → zavolať», «jesť → zjesť», «piť → vypiť». Значення не змінюється, додається лише завершеність і результат. Як в українській: платити — заплатити.",
          "examples": [
            {
              "sk": "Platím kartou.",
              "uk": "Я плачу карткою."
            },
            {
              "sk": "Už som zaplatil nájom.",
              "uk": "Я вже заплатив за оренду."
            }
          ],
          "shortRule": "дієслово + префікс → доконаний вид",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Префікс треба запам’ятати",
          "text": "Префікс не завжди такий, як в українському відповіднику, тому вчи пари цілком: «jesť → zjesť» (з’їсти), «piť → vypiť» (випити), «parkovať → zaparkovať» (припаркувати), «baliť → zbaliť» (спакувати), «čistiť → vyčistiť» (почистити), «tlačiť → vytlačiť» (надрукувати), «kopírovať → skopírovať» (скопіювати).",
          "examples": [
            {
              "sk": "Zaparkoval som pred domom.",
              "uk": "Я припаркувався перед будинком."
            },
            {
              "sk": "Vytlačte mi to, prosím.",
              "uk": "Роздрукуйте мені це, будь ласка."
            }
          ],
          "shortRule": "учи пару цілком: tlačiť – vytlačiť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Форми доконаного",
          "text": "Доконані дієслова відмінюються так само, як їхні недоконані пари, але теперішня форма означає майбутнє: «robím» — роблю, «urobím» — зроблю. Минулий час звичайний: «urobil som». Особливі форми: «zjesť — zjem, zješ, zje; zjedol som» і «vypiť — vypijem, vypiješ, vypije; vypil som».",
          "examples": [
            {
              "sk": "Zjem polievku a idem.",
              "uk": "Я з’їм суп і піду."
            },
            {
              "sk": "Vypil som dve kávy.",
              "uk": "Я випив дві кави."
            }
          ],
          "shortRule": "urobím — зроблю; urobil som — я зробив",
          "commonMistakes": [
            {
              "mistake": "budem zaplatiť",
              "correct": "zaplatím"
            },
            {
              "mistake": "Za hodinu som čistil celý byt.",
              "correct": "Za hodinu som vyčistil celý byt."
            }
          ],
          "button": "Далі →"
        }
      ],
