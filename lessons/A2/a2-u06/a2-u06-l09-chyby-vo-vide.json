      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чотири неможливі поєднання",
          "text": "1) «budem» + доконаний: не «budem urobiť», а «urobím». 2) Доконаний для дії зараз: «napíšem» — це «напишу», а не «пишу». 3) Тривалість + доконаний: не «dve hodiny som napísal», а «písal». 4) «Za + час» + недоконаний у минулому: не «za hodinu som písal», а «napísal».",
          "examples": [
            {
              "sk": "Zajtra ti napíšem.",
              "uk": "Завтра я тобі напишу."
            },
            {
              "sk": "Dve hodiny som písal list.",
              "uk": "Дві години я писав листа."
            }
          ],
          "shortRule": "budem + dok., dlho + dok., za hodinu + nedok. — помилка",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Začať, prestať + недоконаний",
          "text": "Після «začať / začínať, prestať / prestávať» уживаємо тільки недоконаний інфінітив: «Začal som sa učiť po slovensky», «Otec prestal fajčiť». Не «začal som sa naučiť». Як в українській: почав учитися, а не «почав вивчити».",
          "examples": [
            {
              "sk": "Minulý rok som začala pracovať v hoteli.",
              "uk": "Минулого року я почала працювати в готелі."
            },
            {
              "sk": "Otec prestal fajčiť.",
              "uk": "Тато кинув курити."
            }
          ],
          "shortRule": "začať / prestať + nedokonavý infinitív",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Пари, які легко сплутати",
          "text": "«Hľadať» — шукати (процес), «nájsť» — знайти (результат): «Hľadám prácu» — я шукаю роботу; «Našiel som prácu» — я знайшов роботу. «Učiť sa» — учитися, учити; «naučiť sa» — вивчити. «Riešiť» — вирішувати; «vyriešiť» — вирішити.",
          "examples": [
            {
              "sk": "Hľadám byt už dva mesiace.",
              "uk": "Я шукаю квартиру вже два місяці."
            },
            {
              "sk": "Konečne som našla byt!",
              "uk": "Нарешті я знайшла квартиру!"
            }
          ],
          "shortRule": "hľadať ≠ nájsť, učiť sa ≠ naučiť sa",
          "commonMistakes": [
            {
              "mistake": "budem urobiť",
              "correct": "urobím"
            },
