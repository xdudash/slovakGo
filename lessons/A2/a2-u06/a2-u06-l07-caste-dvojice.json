      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Пари із суфіксом",
          "text": "Багато пар відрізняються не префіксом, а суфіксом. Недоконане дієслово зазвичай довше: «kupovať – kúpiť», «dávať – dať», «posielať – poslať», «vracať – vrátiť», «dostávať – dostať», «otvárať – otvoriť». Як в українській: купувати — купити, давати — дати.",
          "examples": [
            {
              "sk": "Kupujem si lístok na vlak.",
              "uk": "Я купую квиток на потяг."
            },
            {
              "sk": "Kúpil som si lístok na vlak.",
              "uk": "Я купив квиток на потяг."
            }
          ],
          "shortRule": "dlhšie sloveso → zvyčajne nedokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пари з різних слів",
          "text": "Деякі пари утворені зовсім різними словами: «brať – vziať» (брати – взяти; у розмові також «zobrať»), «hovoriť – povedať» (говорити – сказати), «klásť – položiť» (класти – покласти). Їх треба просто вивчити. Форми «vziať»: vezmem, vezmeš, vezme; vzal som; імператив «vezmi».",
          "examples": [
            {
              "sk": "Vezmi si dáždnik.",
              "uk": "Візьми парасольку."
            },
            {
              "sk": "Povedz mi pravdu.",
              "uk": "Скажи мені правду."
            }
          ],
          "shortRule": "brať – vziať, hovoriť – povedať",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Префікс + суфікс",
          "text": "Якщо обидва дієслова мають префікс, він однаковий, а різниться суфікс: «vyberať – vybrať» (вибирати – вибрати; знімати – зняти гроші), «zabúdať – zabudnúť», «začínať – začať», «zapínať – zapnúť».",
          "examples": [
            {
              "sk": "Peniaze vyberám v bankomate pri práci.",
              "uk": "Гроші я знімаю в банкоматі біля роботи."
            },
            {
              "sk": "Vybral som sto eur.",
              "uk": "Я зняв сто євро."
            }
          ],
          "shortRule": "vyberať – vybrať, zabúdať – zabudnúť",
          "commonMistakes": [
            {
              "mistake": "budem kúpiť",
              "correct": "kúpim / budem kupovať"
            },
            {
              "mistake": "Dve hodiny som kúpil darčeky.",
              "correct": "Dve hodiny som kupoval darčeky."
            }
          ],
          "button": "Далі →"
        }
      ],
