      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Фон і події",
          "text": "У розповіді недоконаний вид описує фон, ситуацію, процес: «Bolo neskoro, pršalo, čakal som na autobus». Доконаний — події, що йдуть одна за одною: «Prišiel autobus, nastúpil som a sadol som si».",
          "examples": [
            {
              "sk": "Pršalo a ja som stál na zastávke.",
              "uk": "Ішов дощ, а я стояв на зупинці."
            },
            {
              "sk": "Prišiel autobus a ja som nastúpil.",
              "uk": "Приїхав автобус, і я сів у нього."
            }
          ],
          "shortRule": "pozadie → nedokonavý; udalosti → dokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Keď… zrazu",
          "text": "Дія, що тривала, і подія, яка її перервала: «Keď som varila večeru, zrazu zazvonil telefón». Процес — недоконаний, раптова подія — доконаний. Корисні слова: «zrazu» — раптом, «medzitým» — тим часом, «potom» — потім, «nakoniec» — зрештою.",
          "examples": [
            {
              "sk": "Keď som išiel domov, stretol som suseda.",
              "uk": "Коли я йшов додому, я зустрів сусіда."
            },
            {
              "sk": "Medzitým začalo pršať.",
              "uk": "Тим часом почався дощ."
            }
          ],
          "shortRule": "keď + nedokonavý … zrazu + dokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ланцюжок чи одночасність",
          "text": "Послідовні дії — доконаний: «Vstal som, umyl som sa, naraňajkoval som sa a odišiel som». Одночасні дії — недоконаний: «Varila som a počúvala som rádio».",
          "examples": [
            {
              "sk": "Prišla som domov, zatvorila som okno a ľahla som si.",
              "uk": "Я прийшла додому, зачинила вікно й лягла."
            },
            {
              "sk": "Varila som a počúvala som rádio.",
              "uk": "Я варила й слухала радіо."
            }
          ],
          "shortRule": "jedno po druhom → dokonavý; súčasne → nedokonavý",
          "commonMistakes": [
            {
              "mistake": "Keď som išiel domov, zrazu som stretával suseda.",
              "correct": "Keď som išiel domov, zrazu som stretol suseda."
            }
          ],
          "button": "Далі →"
        }
