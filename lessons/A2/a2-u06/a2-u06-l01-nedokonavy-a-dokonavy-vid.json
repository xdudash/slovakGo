      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Два види",
          "text": "Як і в українській, словацькі дієслова мають два види. Недоконаний (nedokonavý) — процес, тривалість, повторення: «robiť, písať, čítať» — робити, писати, читати. Доконаний (dokonavý) — одна завершена дія з результатом: «urobiť, napísať, prečítať» — зробити, написати, прочитати. Більшість дієслів утворює видові пари.",
          "examples": [
            {
              "sk": "Píšem e-mail.",
              "uk": "Я пишу імейл."
            },
            {
              "sk": "Napísal som e-mail.",
              "uk": "Я написав імейл."
            }
          ],
          "shortRule": "процес → nedokonavý, результат → dokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Процес чи результат",
          "text": "Недоконаний вид відповідає на питання «що робив? як довго?»: «Celý večer som čítal» — увесь вечір я читав. Доконаний — «що зробив? чого досяг?»: «Prečítal som celú knihu» — я прочитав усю книжку. Із «celý deň, dlho, dve hodiny» уживаємо тільки недоконаний. Із «za hodinu, za týždeň» (за який час) — тільки доконаний.",
          "examples": [
            {
              "sk": "Dlho som hľadal kľúče.",
              "uk": "Я довго шукав ключі."
            },
            {
              "sk": "Za hodinu som napísal celú správu.",
              "uk": "За годину я написав увесь звіт."
            }
          ],
          "shortRule": "ako dlho? → nedokonavý; za koľko? → dokonavý",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Теперішній час — лише в недоконаного",
          "text": "«Píšem» — пишу (зараз). Доконане дієслово в теперішній формі означає майбутнє: «napíšem» — напишу. Тому «зараз я пишу» — тільки «Práve píšem», а «напишу завтра» — «Napíšem zajtra». Так само в українській: пишу — напишу.",
          "examples": [
            {
              "sk": "Práve varím obed.",
              "uk": "Я якраз варю обід."
            },
            {
              "sk": "Uvarím obed a zavolám ti.",
              "uk": "Зварю обід і зателефоную тобі."
            }
          ],
          "shortRule": "píšem — пишу; napíšem — напишу",
          "commonMistakes": [
            {
              "mistake": "Dve hodiny som napísal list.",
              "correct": "Dve hodiny som písal list."
            },
            {
              "mistake": "Za hodinu som písal list.",
              "correct": "Za hodinu som napísal list."
            }
          ],
          "button": "Далі →"
        }
      ],
