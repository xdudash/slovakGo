      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Budem + недоконаний",
          "text": "Майбутній час недоконаних дієслів: «budem, budeš, bude, budeme, budete, budú» + інфінітив: «budem pracovať, budeme čakať». Так говоримо про процес, тривалість, повторення: «Zajtra budem celý deň pracovať».",
          "examples": [
            {
              "sk": "Zajtra budem celý deň pracovať.",
              "uk": "Завтра я цілий день працюватиму."
            },
            {
              "sk": "Budúci rok budeme bývať v Košiciach.",
              "uk": "Наступного року ми житимемо в Кошицях."
            }
          ],
          "shortRule": "budem + nedokonavý infinitív",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Urobím — доконаний майбутній",
          "text": "Доконане дієслово в теперішній формі — це майбутнє з результатом: «urobím» — зроблю, «zavolám» — зателефоную, «pošlem» — надішлю. «Budem» із доконаним дієсловом НЕ вживаємо: «budem urobiť» — помилка! Як в українській: не кажемо «буду зробити».",
          "examples": [
            {
              "sk": "Zajtra ti zavolám.",
              "uk": "Завтра я тобі зателефоную."
            },
            {
              "sk": "Dokument pošlem do piatku.",
              "uk": "Документ надішлю до п’ятниці."
            }
          ],
          "shortRule": "urobím, ale nikdy budem urobiť",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Процес чи результат у майбутньому",
          "text": "«Budem písať správu» — писатиму звіт (процес, можливо, довгий). «Napíšem správu» — напишу звіт (він буде готовий). Із «celý deň, dlho» — budem + недоконаний; із «do piatku, za hodinu» — доконаний.",
          "examples": [
            {
              "sk": "Cez víkend budem odpočívať.",
              "uk": "На вихідних я відпочиватиму."
            },
            {
              "sk": "Do piatku to dokončím.",
              "uk": "До п’ятниці я це закінчу."
            }
          ],
