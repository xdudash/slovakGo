      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Niečo nefunguje",
          "text": "Про техніку: «Stroj sa pokazil» (зламався), «Skener nefunguje», «Je tam porucha». Матеріал закінчився — «Došiel materiál», «Došli nám krabice» (дієслово «dôjsť»). Одразу повідом майстрові й не ремонтуй сам, якщо тебе цього не навчили.",
          "examples": [
            {
              "sk": "Pán majster, linka stojí, je tam porucha.",
              "uk": "Пане майстре, лінія стоїть, там несправність."
            },
            {
              "sk": "Došli nám štítky.",
              "uk": "У нас закінчилися етикетки."
            }
          ],
          "shortRule": "dôjsť: došiel (він), došla (вона), došli (вони)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Moja chyba",
          "text": "Визнати помилку — «pomýliť sa»: «Pomýlil som sa v počte.» Перепросити: «Prepáčte, to bola moja chyba. Hneď to opravím.» Запізнення: «Meškám, lebo mi ušiel autobus.» (ujsť — утекти; дослівно «автобус мені втік»). Попереджай заздалегідь: «Budem meškať asi desať minút.»",
          "examples": [
            {
              "sk": "Prepáčte, pomýlila som sa, opravím to.",
              "uk": "Перепрошую, я помилилася, виправлю це."
            },
            {
              "sk": "Ušiel mi vlak, budem meškať pol hodiny.",
              "uk": "Я не встиг на потяг, запізнюся на пів години."
            }
          ],
          "shortRule": "ušiel mi autobus — я не встиг на автобус (mi — давальний)",
          "commonMistakes": [
            {
              "mistake": "Ušiel som autobus.",
              "correct": "Ušiel mi autobus."
            },
