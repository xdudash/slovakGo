      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo je BOZP",
          "text": "BOZP — «bezpečnosť a ochrana zdravia pri práci», охорона праці. Кожен новий працівник проходить «školenie BOZP» (інструктаж) і підписує, що правила зрозумів. Правил треба «dodržiavať» — дотримуватися.",
          "examples": [
            {
              "sk": "Pred prvou zmenou máte školenie BOZP.",
              "uk": "Перед першою зміною у вас інструктаж з охорони праці."
            },
            {
              "sk": "Pravidlá treba dodržiavať.",
              "uk": "Правил треба дотримуватися."
            }
          ],
          "shortRule": "dodržiavať + знахідний: pravidlá, pokyny",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Musíte, nesmiete, nemusíte",
          "text": "Обов’язок — «musieť»: «Musíte nosiť reflexnú vestu.» Заборона — «nesmieť»: «Nesmiete fajčiť v sklade.» На табличках: «Vstup zakázaný», «Zákaz fajčenia» (zákaz + родовий). Увага: «nemusíte» = не обов’язково, а «nesmiete» = не можна!",
          "examples": [
            {
              "sk": "V hale musíte mať prilbu.",
              "uk": "У цеху ви мусите бути в касці."
            },
            {
              "sk": "Pri stroji nesmiete používať mobil.",
              "uk": "Біля верстата не можна користуватися мобільним."
            }
          ],
          "shortRule": "nemusieť = не обов’язково · nesmieť = заборонено",
          "commonMistakes": [
            {
              "mistake": "Nemusíte fajčiť v sklade. (заборона)",
              "correct": "Nesmiete fajčiť v sklade."
            },
            {
              "mistake": "Zákaz fajčenie",
              "correct": "Zákaz fajčenia"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Úraz a požiar",
          "text": "Травма на роботі — «pracovný úraz»: одразу повідом майстра, навіть якщо це дрібниця, бо інакше потім важко щось довести. Аптечка — «lekárnička». При пожежі: «hasiaci prístroj» (вогнегасник) і «núdzový východ» (аварійний вихід). Екстрений номер — 112.",
          "examples": [
            {
              "sk": "Mal som malý pracovný úraz, kde je lekárnička?",
              "uk": "У мене невелика травма, де аптечка?"
            },
            {
              "sk": "Núdzový východ nesmie byť zatarasený.",
              "uk": "Аварійний вихід не можна захаращувати."
            }
          ],
          "shortRule": "úraz → hneď nahlásiť majstrovi",
          "button": "Далі →"
        }
      ],
