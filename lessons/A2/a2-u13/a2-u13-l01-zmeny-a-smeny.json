      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ranná, poobedná, nočná",
          "text": "На виробництві, складах і в сервісі в Словаччині часто працюють на зміни: «ranná zmena» (наприклад, 6:00–14:00), «poobedná zmena» (14:00–22:00) і «nočná zmena» (22:00–6:00). Якщо фірма працює цілодобово без зупинки, це «nepretržitá prevádzka». Слово «smena» часто почуєш у розмові, але літературна норма — «zmena»; розмовно кажуть ще «šichta».",
          "examples": [
            {
              "sk": "Tento týždeň mám rannú zmenu.",
              "uk": "Цього тижня в мене ранкова зміна."
            },
            {
              "sk": "Firma má nepretržitú prevádzku.",
              "uk": "Фірма працює цілодобово без перерв."
            }
          ],
          "shortRule": "норма: zmena · розмовно: šichta, smena",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відмінки зі словом zmena",
          "text": "Що маю? — знахідний: «mám rannú (zmenu)». Куди йду? — теж знахідний: «idem na nočnú». Де я? — місцевий: «som na poobednej». Після чого? — «po nočnej zmene» (місцевий). Саме слово «zmena» часто пропускають: «Zajtra mám nočnú.»",
          "examples": [
            {
              "sk": "Idem na rannú.",
              "uk": "Іду на ранкову (зміну)."
            },
            {
              "sk": "Po nočnej zmene spím do obeda.",
              "uk": "Після нічної зміни я сплю до обіду."
            }
          ],
          "shortRule": "mám / idem na rannú · som na rannej · po rannej",
          "commonMistakes": [
            {
              "mistake": "Som na nočnú.",
              "correct": "Som na nočnej."
            },
            {
              "mistake": "Po nočná zmena spím.",
              "correct": "Po nočnej zmene spím."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Rozpis zmien a výmena",
          "text": "Графік змін — «rozpis zmien» — висить на дошці біля роздягальні або приходить у застосунку. Якщо зміни чергуються щотижня, кажуть «zmeny sa striedajú». Хочеш помінятися з колегою? — «Nevymeníš si so mnou zmenu?» Обмін зазвичай має погодити майстер або керівник.",
          "examples": [
            {
              "sk": "V piatok mám poobednú, nevymeníš si so mnou?",
              "uk": "У п’ятницю в мене післяобідня, не поміняєшся зі мною?"
            },
            {
              "sk": "Zmeny sa striedajú každý týždeň.",
              "uk": "Зміни чергуються щотижня."
            }
          ],
          "shortRule": "vymeniť si zmenu s + орудний: s kolegom, so mnou",
          "button": "Далі →"
        }
