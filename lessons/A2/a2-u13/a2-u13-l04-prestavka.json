      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Koľko trvá prestávka",
          "text": "За Трудовим кодексом Словаччини («Zákonník práce») після шести годин роботи належить перерва на відпочинок і їжу — 30 хвилин. Зазвичай вона не входить у робочий час. Обідня перерва — «obedňajšia prestávka» або «prestávka na obed». Коротку перерву розмовно називають «pauza».",
          "examples": [
            {
              "sk": "Obedňajšia prestávka je od dvanástej do pol jednej.",
              "uk": "Обідня перерва — з дванадцятої до пів на першу."
            },
            {
              "sk": "Po šiestich hodinách máme polhodinovú prestávku.",
              "uk": "Після шести годин у нас пів години перерви."
            }
          ],
          "shortRule": "6 hodín práce → 30 minút prestávky",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na prestávku, na prestávke",
          "text": "Куди? — «idem na prestávku» (знахідний). Де? — «som na prestávke» (місцевий). Коли? — «cez prestávku» (під час перерви), «po prestávke» (після перерви).",
          "examples": [
            {
              "sk": "Cez prestávku si zavolám domov.",
