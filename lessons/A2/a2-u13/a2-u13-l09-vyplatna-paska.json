      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo je výplatná páska",
          "text": "«Výplatná páska» — розрахунковий листок, який отримуєш щомісяця (папером, електронною поштою або в застосунку). Зверху — «hrubá mzda» (брутто), внизу — «čistá mzda» (нетто), яка прийде на рахунок. Між ними — «odvody» (внески) і «daň» (податок).",
          "examples": [
            {
              "sk": "Výplatnú pásku dostávam e-mailom.",
              "uk": "Розрахунковий листок я отримую електронною поштою."
            },
            {
              "sk": "Z hrubej mzdy sa platia odvody a daň.",
              "uk": "З брутто-зарплати сплачуються внески й податок."
            }
          ],
          "shortRule": "hrubá mzda − odvody − daň = čistá mzda",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Odvody a daň",
          "text": "Працівник сплачує «zdravotné poistenie» (медичне страхування) і «sociálne poistenie» (соціальне: пенсія, лікарняні, допомога з безробіття). Потім іде «daň z príjmu» — податок на доходи. Сам нічого не перераховуєш: роботодавець утримує все із зарплати й надсилає куди треба.",
          "examples": [
            {
              "sk": "Odvody a daň mi zamestnávateľ strhne zo mzdy.",
              "uk": "Внески й податок роботодавець утримує мені із зарплати."
            },
            {
              "sk": "Zo sociálneho poistenia dostanem aj dôchodok.",
              "uk": "Із соціального страхування я отримаю й пенсію."
            }
          ],
          "shortRule": "zdravotné + sociálne poistenie = odvody",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Hodiny a príplatky",
          "text": "На листку є «odpracované hodiny» (відпрацьовані години), «nadčasy» і «príplatky» — за ніч, суботу, неділю чи свято. Якщо щось не сходиться, звертайся в «mzdovú účtáreň» (бухгалтерію із зарплати): «Na páske mi chýba príplatok za nočné.»",
          "examples": [
            {
              "sk": "Minulý mesiac som odpracoval 168 hodín.",
              "uk": "Минулого місяця я відпрацював 168 годин."
            },
            {
              "sk": "Na páske mi chýbajú dve hodiny nadčasu.",
              "uk": "У листку бракує двох годин понаднормової роботи."
            }
          ],
          "shortRule": "mi chýba (однина) · mi chýbajú (множина)",
