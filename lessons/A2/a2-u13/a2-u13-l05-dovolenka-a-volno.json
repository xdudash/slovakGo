      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nárok na dovolenku",
          "text": "Кожен працівник має «nárok» (право) на оплачувану відпустку: щонайменше 4 тижні на рік. Якщо до кінця року тобі виповнюється 33 роки або ти постійно доглядаєш дитину — 5 тижнів. Використовувати відпустку — «čerpať dovolenku».",
          "examples": [
            {
              "sk": "Tento rok mám nárok na päť týždňov dovolenky.",
              "uk": "Цього року я маю право на п’ять тижнів відпустки."
            },
            {
              "sk": "V júli chcem čerpať dva týždne dovolenky.",
              "uk": "У липні я хочу взяти два тижні відпустки."
            }
          ],
          "shortRule": "nárok na + знахідний · čerpať dovolenku",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ako požiadať",
          "text": "Усно: «Chcel(a) by som si zobrať dovolenku od … do …» або «zobrať si deň voľna». Письмово — «žiadosť o dovolenku», часто в застосунку чи на бланку. Дати: «od štvrtého do pätnásteho augusta» (od / do + родовий), «na dva týždne» (na + знахідний). Керівник відпустку «schváli» — погодить.",
          "examples": [
            {
              "sk": "Môžem si v piatok zobrať deň voľna?",
              "uk": "Можна мені в п’ятницю взяти вихідний?"
            },
            {
              "sk": "Žiadam o dovolenku od 4. do 15. augusta.",
              "uk": "Прошу відпустку з 4 по 15 серпня."
            }
          ],
          "shortRule": "od + родовий · do + родовий · na + знахідний",
          "commonMistakes": [
            {
              "mistake": "od 4. na 15. augusta",
              "correct": "od 4. do 15. augusta"
            },
            {
              "mistake": "deň voľno",
              "correct": "deň voľna"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Náhradné a neplatené voľno",
          "text": "«Náhradné voľno» — відгул: вільний час замість доплати за понаднормову роботу. «Neplatené voľno» — відпустка за власний рахунок: без зарплати, і керівник не мусить її давати. Відмінки: «ísť na dovolenku», «byť na dovolenke», «po dovolenke».",
          "examples": [
            {
              "sk": "Za sobotu dostanem náhradné voľno.",
              "uk": "За суботу я отримаю відгул."
            },
            {
              "sk": "Na svadbu si beriem neplatené voľno.",
              "uk": "На весілля я беру відпустку за власний рахунок."
            }
          ],
          "shortRule": "náhradné — за nadčasy · neplatené — bez peňazí",
          "button": "Далі →"
        }
      ],
