      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Хто є хто",
          "text": "«Nadriadený» — той, хто стоїть над тобою: «majster» на виробництві, «vedúci / vedúca» зміни чи відділу, ще вище — «riaditeľ». Ти для них — «podriadený / podriadená». До керівника звертаються на «vy» й із посадою: «pán vedúci», «pani vedúca», «pán majster».",
          "examples": [
            {
              "sk": "Pani vedúca, máte chvíľku?",
              "uk": "Пані керівнице, маєте хвилинку?"
            },
            {
              "sk": "Môj priamy nadriadený je majster Kováč.",
              "uk": "Мій безпосередній керівник — майстер Ковач."
            }
          ],
          "shortRule": "pán + чоловіча форма · pani + жіноча форма",
          "commonMistakes": [
            {
              "mistake": "pán vedúca",
              "correct": "pani vedúca"
            },
            {
              "mistake": "Hlásim sa pri majstrovi.",
              "correct": "Hlásim sa u majstra."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pokyny — вказівки",
          "text": "Керівник дає «pokyny» (вказівки), часто в наказовому способі на «vy»: «Skontrolujte…», «Upracte…», «Nezabudnite…». Також кажуть «Treba…» (Треба…) або «Prosím vás, …». Керівник може тебе «upozorniť» — звернути твою увагу на щось або попередити.",
          "examples": [
            {
              "sk": "Najprv skontrolujte tovar, potom ho uložte do regálu.",
              "uk": "Спочатку перевірте товар, потім покладіть його на стелаж."
            },
            {
              "sk": "Vedúca ma upozornila, že zajtra je porada.",
              "uk": "Керівниця попередила мене, що завтра нарада."
            }
          ],
          "shortRule": "наказ на vy: -te (urobte, skontrolujte, nezabudnite)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ввічливо питати й звітувати",
          "text": "Прохання: «Mohli by ste mi vysvetliť…?», «Chcel(a) by som sa opýtať…». Не зрозумів(ла) — «Prepáčte, môžete to zopakovať?». Звіт: «Hotovo, tovar je uložený.» Першого дня треба «hlásiť sa» в майстра — зголоситися, прийти й сказати, що ти тут. Роботу між людьми «rozdeľuje» майстер.",
          "examples": [
            {
              "sk": "Mohli by ste mi to ešte raz vysvetliť?",
              "uk": "Могли б ви мені це ще раз пояснити?"
            },
            {
              "sk": "Ráno sa hláste u pána Kováča.",
              "uk": "Вранці зголосіться в пана Ковача."
            }
          ],
          "shortRule": "Mohli by ste…? · Prepáčte, môžete to zopakovať? · hlásiť sa u + родовий",
          "button": "Далі →"
        }
      ],
