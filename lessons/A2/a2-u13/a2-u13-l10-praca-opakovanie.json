        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Hodnotiaci pohovor",
          "text": "У багатьох фірмах раз на рік буває «hodnotiaci pohovor» — оцінювальна розмова з керівником. Говорять про «výkon» (результати роботи), «zodpovednosť» (відповідальність) і цілі. За добру роботу можна отримати похвалу, «prémiu» або навіть «povýšenie» — підвищення на посаді.",
          "examples": [
            {
              "sk": "Vedúca je s mojím výkonom spokojná.",
              "uk": "Керівниця задоволена моїми результатами."
            },
            {
              "sk": "Som zodpovedný za kontrolu kvality.",
              "uk": "Я відповідаю за контроль якості."
            }
          ],
          "shortRule": "byť zodpovedný za + знахідний · dostať povýšenie",
          "button": "Далі →"
        }
