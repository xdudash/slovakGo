      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Program porady",
          "text": "Нарада («porada») має «program» — список «bodov» (пунктів): «bod jeden, bod dva». Веде її зазвичай керівник: «Prvý bod je rozpis zmien.» Після наради пишуть «zápisnicu» — протокол. Брати участь — «zúčastniť sa na porade» або «zúčastniť sa porady».",
          "examples": [
            {
              "sk": "Na programe sú tri body.",
              "uk": "У програмі три пункти."
            },
            {
              "sk": "Zápisnicu vám pošlem e-mailom.",
              "uk": "Протокол надішлю вам електронною поштою."
            }
          ],
          "shortRule": "bod – body · zúčastniť sa na porade",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Navrhnúť a dodať",
          "text": "Пропозиція: «Navrhujem…» (пропоную), «Mám návrh: …». Додати думку: «Môžem k tomu niečo dodať?» Запитання до пункту: «Mám otázku k bodu dva.» (k + давальний).",
          "examples": [
            {
              "sk": "Navrhujem dať do skladu ešte jeden skener.",
              "uk": "Пропоную поставити на склад ще один сканер."
            },
            {
              "sk": "Môžem k tomu niečo dodať?",
              "uk": "Можна мені щось до цього додати?"
            }
          ],
          "shortRule": "navrhnúť · dodať · k bodu dva",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Súhlasím, nesúhlasím",
          "text": "Згода — «Súhlasím.», «To je dobrý nápad.» Незгода ввічливо — «Nesúhlasím, lebo…», «Mám iný názor.» Не перебивай: «Prepáčte, môžem?» З ким згоден? — «súhlasiť s» + орудний.",
          "examples": [
            {
              "sk": "Súhlasím s Martinom.",
              "uk": "Я згоден із Мартином."
            },
            {
              "sk": "Nesúhlasím, lebo v sobotu nemáme dosť ľudí.",
              "uk": "Я не згоден, бо в суботу в нас замало людей."
            }
          ],
          "shortRule": "súhlasiť s + орудний · nesúhlasím, lebo…",
