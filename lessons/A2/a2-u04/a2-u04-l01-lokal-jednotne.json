      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чоловічий рід",
          "text": "Неживі іменники з твердою основою мають -e: «dom → v dome», «obchod → v obchode», «stôl → na stole». Після k, g, h, ch — -u: «park → v parku», «vlak → vo vlaku», «roh → v rohu». М’яка основа і слова типу hotel мають -i: «hotel → v hoteli», «gauč → na gauči», «koberec → na koberci». Живі іменники (люди, тварини) мають -ovi: «brat → o bratovi», «kolega → o kolegovi».",
          "examples": [
            {
              "sk": "Kľúče sú na stole.",
              "uk": "Ключі на столі."
            },
            {
              "sk": "Rozprávali sme sa o novom kolegovi.",
              "uk": "Ми говорили про нового колегу."
            }
          ],
          "shortRule": "-e / -u (після k, g, h, ch) / -i (м’які) / -ovi (живі)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Середній рід",
          "text": "На -o мають -e: «mesto → v meste», «auto → v aute», «okno → na okne». Але після k, g, h, ch — -u: «Slovensko → na Slovensku», «Česko → v Česku», «mlieko → v mlieku». На -e — -i: «more → pri mori»; на -ie — -í: «námestie → na námestí», «poschodie → na poschodí». На -eum — -u: «múzeum → v múzeu», але «centrum → v centre».",
          "examples": [
            {
              "sk": "Bývame v malom meste pri Nitre.",
              "uk": "Ми живемо в маленькому місті біля Нітри."
            },
            {
              "sk": "Na námestí je trh.",
              "uk": "На площі ринок."
            }
          ],
          "shortRule": "-e / -u (k, g, h, ch) / -i, -í",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Жіночий рід і узгодження",
          "text": "Тверда основа — -e: «škola → v škole», «banka → v banke», «Ukrajina → na Ukrajine». М’яка основа (-ca, -ňa, -ia) і іменники на приголосний — -i: «ulica → na ulici», «kuchyňa → v kuchyni», «kancelária → v kancelárii», «miestnosť → v miestnosti». Прикметник чоловічого й середнього роду має -om, жіночого — -ej: «v novom byte», «v malom meste», «na novej ulici». Займенники: «v mojom, v našom, v tom» / «v mojej, v našej, v tej».",
          "examples": [
            {
              "sk": "Bývame v novom byte na tichej ulici.",
              "uk": "Ми живемо в новій квартирі на тихій вулиці."
            },
            {
              "sk": "V našej firme pracuje veľa Ukrajincov.",
              "uk": "У нашій фірмі працює багато українців."
            }
          ],
          "shortRule": "-om (чоловічий і середній) / -ej (жіночий)",
          "commonMistakes": [
            {
              "mistake": "v parke",
              "correct": "v parku"
