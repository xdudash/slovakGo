      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Де ти працюєш?",
          "text": "«V» — у приміщенні чи фірмі: «v sklade, v kancelárii, vo fabrike, vo firme, v nemocnici, v hoteli». «Na» — робоче місце, відділ, ділянка: «na stavbe» — на будові, «na recepcii», «na oddelení» — у відділі, «na pokladni» — на касі, «na linke» — на лінії. «Vo výrobe» — на виробництві. І головне: «v práci» — на роботі!",
          "examples": [
            {
              "sk": "Pracujem vo výrobe na linke.",
              "uk": "Я працюю на виробництві на лінії."
            },
            {
              "sk": "Manžel robí na stavbe v Bratislave.",
              "uk": "Чоловік працює на будові в Братиславі."
            }
          ],
          "shortRule": "v práci = на роботі",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na úrade, na polícii",
          "text": "Установи — переважно з «na»: «na úrade, na úrade práce, na cudzineckej polícii, na matrike, na pošte, na pohotovosti» (у невідкладній допомозі). Але «v nemocnici, v banke, v ambulancii».",
          "examples": [
            {
              "sk": "Včera som bol celé doobedie na cudzineckej polícii.",
              "uk": "Учора я цілий ранок був у міграційній поліції."
            },
            {
              "sk": "V noci sme boli so synom na pohotovosti.",
              "uk": "Уночі ми із сином були в невідкладній допомозі."
            }
          ],
          "shortRule": "na úrade, na polícii — v nemocnici, v banke",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Na PN, na dovolenke",
          "text": "Чому колеги немає? Словацькою це теж «na» + місцевий: «je na PN» (на лікарняному; PN — práceneschopnosť), «na dovolenke» — у відпустці, «na materskej» — у декретній відпустці, «na služobnej ceste» — у відрядженні, «na obede», «na porade», «na školení».",
          "examples": [
            {
              "sk": "Šéfka je tento týždeň na služobnej ceste vo Viedni.",
              "uk": "Цього тижня шефиня у відрядженні у Відні."
            },
            {
              "sk": "Kolegyňa je na materskej.",
              "uk": "Колега в декретній відпустці."
            }
          ],
          "shortRule": "na PN, na dovolenke, na materskej, na služobnej ceste",
