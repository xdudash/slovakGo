      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "V чи na?",
          "text": "«V» — усередині закритого простору: «v obchode, v banke, v nemocnici, v aute, v meste, v Bratislave». «Na» — на поверхні й на відкритому просторі: «na stole, na ulici, na námestí, na dvore». Але багато слів треба просто запам’ятати: «na pošte, na úrade, na stanici, na letisku, na polícii, na univerzite, na poschodí».",
          "examples": [
            {
              "sk": "Kúpil som to v obchode na námestí.",
              "uk": "Я купив це в магазині на площі."
            },
            {
              "sk": "Čakám na stanici.",
              "uk": "Я чекаю на вокзалі."
            }
          ],
          "shortRule": "v = усередині; na = на поверхні + слова, які треба запам’ятати",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na koncerte, na Slovensku, vo vlaku",
          "text": "«Na» вживаємо також із подіями: «na koncerte, na svadbe, na porade, na školení, na návšteve, na dovolenke». Країни: «na Slovensku, na Ukrajine», але «v Česku, v Poľsku, v Rakúsku, v Nemecku». Перед словами на v і f та перед деякими групами приголосних — «vo»: «vo vlaku, vo firme, vo Zvolene, vo Viedni».",
          "examples": [
            {
              "sk": "Minulý týždeň som bol na školení vo Zvolene.",
              "uk": "Минулого тижня я був на навчанні у Зволені."
            },
            {
              "sk": "Brat žije v Česku a ja na Slovensku.",
              "uk": "Брат живе в Чехії, а я в Словаччині."
            }
          ],
          "shortRule": "na + події; vo перед v, f",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pri",
          "text": "«Pri» з місцевим — біля, поруч: «pri okne, pri stanici, pri mori, pri Nitre» (біля Нітри). Також «під час» дії: «pri práci, pri jedle, pri platení» і «у присутності»: «pri deťoch».",
          "examples": [
            {
              "sk": "Sedím pri okne.",
              "uk": "Я сиджу біля вікна."
            },
            {
              "sk": "Pri práci nosíme ochranné okuliare.",
              "uk": "Під час роботи ми носимо захисні окуляри."
            }
          ],
          "shortRule": "pri = біля / під час",
          "commonMistakes": [
