      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чоловічий рід: -och",
          "text": "Усі іменники чоловічого роду — і живі, і неживі — мають у місцевому відмінку множини -och: «obchod → v obchodoch», «park → v parkoch», «úrad → na úradoch», «kolega → o kolegoch», «sused → o susedoch».",
          "examples": [
            {
              "sk": "V obchodoch je cez víkend veľa ľudí.",
              "uk": "У магазинах на вихідних багато людей."
            },
            {
              "sk": "Často hovoríme o kolegoch.",
              "uk": "Ми часто говоримо про колег."
            }
          ],
          "shortRule": "чоловічий рід → -och",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Жіночий і середній рід: -ách / -iach",
          "text": "Тверда основа — -ách: «škola → v školách», «mesto → v mestách», «hora → v horách». М’яка основа, іменники на приголосний і на -ie — -iach: «ulica → na uliciach», «miestnosť → v miestnostiach», «námestie → na námestiach». На -ia — -iách: «kancelária → v kanceláriách». Якщо попередній склад довгий, закінчення коротшає: «miesto → na miestach», «trieda → v triedach».",
          "examples": [
            {
              "sk": "Na uliciach je dnes veľa áut.",
              "uk": "На вулицях сьогодні багато машин."
            },
            {
              "sk": "V horách je ešte sneh.",
              "uk": "У горах ще сніг."
            }
          ],
          "shortRule": "-ách (тверді) / -iach (м’які)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прикметники й назви",
          "text": "Прикметник у множині має -ých, після м’яких — -ich: «v nových bytoch», «v cudzích krajinách». Займенники: «v našich, v mojich, v tých». Назви, що мають лише множину: «Košice → v Košiciach», «Michalovce → v Michalovciach», «Tatry → v Tatrách», «Piešťany → v Piešťanoch», «Nové Zámky → v Nových Zámkoch».",
          "examples": [
            {
              "sk": "Brat pracuje v Košiciach.",
              "uk": "Брат працює в Кошицях."
            },
            {
              "sk": "Leto sme strávili v Tatrách.",
              "uk": "Літо ми провели в Татрах."
            }
          ],
          "shortRule": "-ých / -ich + -och / -ách / -iach",
