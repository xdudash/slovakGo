      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "O čom? O kom?",
          "text": "Прийменник «o» (про) завжди вживаємо з місцевим: «o práci, o meste, o bratovi». Питання: «O čom?» — про що?, «O kom?» — про кого? Типові дієслова: «hovoriť / rozprávať sa o…», «diskutovať o…» (обговорювати), «premýšľať o…» (обмірковувати), «snívať o…» (мріяти про), «vedieť o…» (знати про). Але «думати про когось» найчастіше — «myslieť na» + знахідний: «Myslím na teba».",
          "examples": [
            {
              "sk": "O čom ste sa rozprávali?",
              "uk": "Про що ви говорили?"
            },
            {
              "sk": "Snívam o vlastnom dome.",
              "uk": "Я мрію про власний будинок."
            }
          ],
          "shortRule": "o + місцевий: o čom? o kom?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "O mne, o ňom",
          "text": "Особові займенники в місцевому: «o mne, o tebe, o ňom (про нього), o nej, o nás, o vás, o nich», зворотний — «o sebe». Після прийменника — форма з «ň»: «o ňom», не «o ním». Так само з іншими прийменниками: «pri nej», «na ňom», «v nich».",
          "examples": [
            {
              "sk": "Šéf o tebe hovoril len dobre.",
              "uk": "Шеф про тебе казав лише добре."
            },
            {
              "sk": "Povedz mi niečo o sebe.",
              "uk": "Розкажи мені щось про себе."
            }
          ],
          "shortRule": "o mne, o tebe, o ňom, o nej, o nás, o vás, o nich",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "O piatej, ale o hodinu",
          "text": "«O» з місцевим також означає годину: «o piatej» — о п’ятій, «o deviatej». А «o» зі знахідним означає «через» або «на (скільки)»: «Prídem o hodinu» — прийду через годину, «Cena stúpla o päť eur» — ціна зросла на п’ять євро.",
          "examples": [
            {
              "sk": "Porada začne o deviatej.",
              "uk": "Нарада почнеться о дев’ятій."
            },
            {
              "sk": "Vrátim sa o týždeň.",
              "uk": "Я повернуся через тиждень."
            }
          ],
          "shortRule": "o + місцевий = про / о котрій; o + знахідний = через / на скільки",
          "commonMistakes": [
            {
              "mistake": "Hovoríme o brat.",
              "correct": "Hovoríme o bratovi."
            },
            {
              "mistake": "Hovorili sme o ním.",
              "correct": "Hovorili sme o ňom."
            },
            {
              "mistake": "Myslím o tebe.",
              "correct": "Myslím na teba."
            }
          ],
          "button": "Далі →"
        }
      ],
