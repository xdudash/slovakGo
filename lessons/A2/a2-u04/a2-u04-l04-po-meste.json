      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Po meste, po Slovensku",
          "text": "«Po» з місцевим означає рух поверхнею чи територією: «prechádzať sa po meste» — гуляти містом, «chodiť po obchodoch» — ходити по магазинах, «cestovať po Slovensku» — подорожувати Словаччиною, «rozvážať balíky po meste» — розвозити посилки містом. «Po celom…» — по всьому: «po celom svete».",
          "examples": [
            {
              "sk": "V sobotu sme sa prechádzali po starom meste.",
              "uk": "У суботу ми гуляли старим містом."
            },
            {
              "sk": "Kuriér jazdí celý deň po meste.",
              "uk": "Кур’єр цілий день їздить містом."
            }
          ],
          "shortRule": "po + місцевий = по (територією)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Po práci, po obede",
          "text": "«Po» з місцевим — це також «після»: «po práci», «po obede», «po dovolenke», «po skončení kurzu» — після закінчення курсу. А ще засіб зв’язку: «po telefóne» — телефоном.",
          "examples": [
            {
              "sk": "Po práci idem rovno domov.",
              "uk": "Після роботи я йду прямо додому."
            },
            {
              "sk": "Toto po telefóne nevybavíte, musíte prísť osobne.",
              "uk": "Телефоном ви цього не залагодите, треба прийти особисто."
            }
          ],
          "shortRule": "po + місцевий = після; po telefóne",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Po deti — зі знахідним",
          "text": "«Po» зі знахідним означає «по когось / по щось» (щоб забрати чи принести): «Idem po deti do škôlky» — іду забрати дітей із садка, «Idem po chlieb» — іду по хліб. Не плутай: «po obede» (після обіду, місцевий) — «idem po obed» (іду по обід, знахідний).",
          "examples": [
            {
              "sk": "O štvrtej idem po syna do školy.",
              "uk": "О четвертій я йду забрати сина зі школи."
            },
            {
              "sk": "Skočím po kávu.",
              "uk": "Я збігаю по каву."
            }
          ],
          "shortRule": "po + знахідний = по когось / по щось",
          "commonMistakes": [
