      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Oslava",
          "text": "«Oslava» — свято, вечірка: «oslava narodenín» — святкування дня народження. «V sobotu budem mať oslavu» — у суботу в мене буде свято. «Pozvánka» — запрошення (листівка чи повідомлення). «Osláviť» — відсвяткувати: «Narodeniny oslávime v reštaurácii».",
          "examples": [
            {
              "sk": "Pozývam ťa na svoju oslavu.",
              "uk": "Запрошую тебе на своє свято."
            },
            {
              "sk": "Dostali sme pozvánku na svadbu.",
              "uk": "Ми отримали запрошення на весілля."
            }
          ],
          "shortRule": "pozvať na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Čo mám priniesť?",
          "text": "Гість ввічливо питає: «Čo mám priniesť?» — що мені принести? Відповіді: «Prines šalát» — принеси салат, «Netreba nič, stačí, že prídeš» — нічого не треба, досить, що прийдеш. «Torta» — торт, «víno» — вино.",
          "examples": [
            {
              "sk": "Prinesiem tortu.",
              "uk": "Принесу торт."
            },
            {
              "sk": "Netreba nič.",
              "uk": "Нічого не треба."
            }
          ],
          "shortRule": "priniesť → prinesiem",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Привітання",
          "text": "«Všetko najlepšie k narodeninám!» — з днем народження! (k + давальний). «Blahoželám!» — вітаю! «Na zdravie!» — будьмо! (тост). «Toto musíme osláviť!» — це треба відсвяткувати!",
          "examples": [
            {
              "sk": "Blahoželám k výročiu!",
              "uk": "Вітаю з річницею!"
            },
            {
              "sk": "Na zdravie!",
              "uk": "Будьмо!"
            }
          ],
          "shortRule": "k narodeninám, k výročiu",
          "commonMistakes": [
            {
              "mistake": "Všetko najlepšie na narodeniny!",
              "correct": "Všetko najlepšie k narodeninám!"
            },
            {
              "mistake": "Čo mám prinesiem?",
              "correct": "Čo mám priniesť?"
            },
            {
              "mistake": "Pozývam ťa do oslavy.",
              "correct": "Pozývam ťa na oslavu."
            }
          ],
          "button": "Далі →"
        }
      ],
