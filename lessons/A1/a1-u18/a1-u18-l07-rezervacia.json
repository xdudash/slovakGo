      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Chcel by som si rezervovať…",
          "text": "Ввічливий початок: «Chcel by som si rezervovať…» (чоловік) / «Chcela by som si rezervovať…» (жінка). Що бронюємо: «stôl na sobotu» — столик на суботу, «izbu na dve noci» — кімнату на дві ночі, «termín u kaderníčky» — запис до перукарки.",
          "examples": [
            {
              "sk": "Chcela by som si rezervovať stôl na sobotu.",
              "uk": "Я хотіла б забронювати столик на суботу."
            },
            {
              "sk": "Mám rezerváciu na meno Bondar.",
              "uk": "У мене бронювання на прізвище Бондар."
            }
          ],
          "shortRule": "na meno = на прізвище",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Na kedy a pre koľko?",
          "text": "Адміністратор питає: «Na kedy?» — на коли? «Na koľkú?» — на котру годину? «Pre koľko osôb?» — на скільки осіб? Відповідь: «Na siedmu, pre štyri osoby». «Máte voľný stôl?» — у вас є вільний столик?",
          "examples": [
            {
              "sk": "Na piatok, na ôsmu, pre dve osoby.",
              "uk": "На п’ятницю, на восьму, на двох осіб."
            }
          ],
          "shortRule": "pre + кількість осіб",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Potvrdiť a zrušiť",
          "text": "«Potvrdiť» — підтвердити: «Rezerváciu vám potvrdíme e-mailom». «Zrušiť» — скасувати: «Chcem zrušiť rezerváciu». «Ubytovanie» — житло, проживання (готель, «penzión» — пансіонат). «Raňajky v cene» — сніданок включено.",
          "examples": [
            {
              "sk": "Ubytovanie je s raňajkami.",
              "uk": "Проживання зі сніданком."
            }
          ],
          "shortRule": "potvrdiť ≠ zrušiť",
          "commonMistakes": [
            {
              "mistake": "Chcem rezervovať stôl pre dva osoby.",
              "correct": "Chcem rezervovať stôl pre dve osoby."
