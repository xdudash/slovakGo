      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Zajtra a pozajtra",
          "text": "«Dnes» — сьогодні, «zajtra» — завтра, «pozajtra» — післязавтра. Можна уточнити: «zajtra ráno» — завтра вранці, «zajtra večer» — завтра ввечері.",
          "examples": [
            {
              "sk": "Pozajtra mám voľno.",
              "uk": "Післязавтра в мене вихідний."
            },
            {
              "sk": "Zajtra ráno pôjdem na úrad.",
              "uk": "Завтра вранці піду в установу."
            }
          ],
          "shortRule": "dnes → zajtra → pozajtra",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Budúci týždeň, o týždeň",
          "text": "«Budúci týždeň / mesiac / rok» — наступного тижня / місяця / року, без прийменника. «Budúci» узгоджується: «budúca sobota», «budúce leto». «O» + знахідний — «через»: «o hodinu» — через годину, «o dva dni» — через два дні, «o týždeň» — через тиждень.",
          "examples": [
            {
              "sk": "Budúci mesiac začnem nový kurz.",
              "uk": "Наступного місяця почну новий курс."
            },
            {
              "sk": "Prídem o hodinu.",
              "uk": "Прийду через годину."
            }
          ],
          "shortRule": "o + знахідний = через",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Od, do, nabudúce",
          "text": "«Od pondelka» — з понеділка, «do piatku» — до п’ятниці (обидва + родовий). «Dovtedy» — до того часу. «Nabudúce» — наступного разу. «Skôr» — раніше.",
          "examples": [
            {
              "sk": "Od pondelka budem pracovať na zmeny.",
              "uk": "З понеділка я працюватиму позмінно."
            },
            {
              "sk": "Nabudúce prídem skôr.",
              "uk": "Наступного разу прийду раніше."
            }
          ],
          "shortRule": "od / do + родовий",
          "commonMistakes": [
            {
              "mistake": "Prídem cez hodinu.",
              "correct": "Prídem o hodinu."
            },
            {
              "mistake": "Od pondelok.",
              "correct": "Od pondelka."
            },
            {
              "mistake": "Budúca týždeň.",
              "correct": "Budúci týždeň."
            }
          ],
          "button": "Далі →"
        }
