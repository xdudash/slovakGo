      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Budem + інфінітив",
          "text": "Майбутній час словацькою утворюється так само, як українське «буду працювати»: форма budem + інфінітив. Відмінювання: «budem, budeš, bude, budeme, budete, budú». Займенник зазвичай не кажемо: «Zajtra budem pracovať».",
          "examples": [
            {
              "sk": "Budúci týždeň budem pracovať v noci.",
              "uk": "Наступного тижня я працюватиму вночі."
            },
            {
              "sk": "Večer budeme pozerať film.",
              "uk": "Увечері ми дивитимемося фільм."
            }
          ],
          "shortRule": "budem + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Заперечення й питання",
          "text": "Заперечення — злитно: «nebudem, nebudeš, nebude…»: «Zajtra nebudem variť». Питання — інтонацією: «Budeš doma?» Без інфінітива budem означає просто «буду»: «Budem doma o šiestej», «Bude teplo».",
          "examples": [
            {
              "sk": "Zajtra nebudem v práci.",
              "uk": "Завтра мене не буде на роботі."
            },
            {
              "sk": "Kde budeš v sobotu?",
              "uk": "Де ти будеш у суботу?"
            }
          ],
          "shortRule": "nebudem — разом",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Тільки недоконаний вид",
          "text": "Budem поєднується лише з недоконаними дієсловами (процес, тривалість): «budem pracovať, budem čakať, budem sa učiť». Не можна сказати «budem urobiť» чи «budem kúpiť» — для результату є інша форма (наступний урок). І ще: «ísť» → «pôjdem», а не «budem ísť».",
          "examples": [
            {
              "sk": "Celý deň budem upratovať.",
              "uk": "Цілий день я прибиратиму."
            }
          ],
          "shortRule": "budem + процес",
          "commonMistakes": [
            {
              "mistake": "Budem urobiť.",
              "correct": "Urobím."
            },
            {
              "mistake": "Ja budem pracujem.",
              "correct": "Budem pracovať."
            },
            {
              "mistake": "Ne budem.",
              "correct": "Nebudem."
            }
          ],
          "button": "Далі →"
        }
      ],
