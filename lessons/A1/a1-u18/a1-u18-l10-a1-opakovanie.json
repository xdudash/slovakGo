      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Три часи",
          "text": "Минуле — «bol som, pracoval som», теперішнє — «som, pracujem», майбутнє — «budem, budem pracovať» або доконане дієслово: «urobím, pôjdem». Один і той самий день у трьох часах — ключ до розмови про своє життя.",
          "examples": [
            {
              "sk": "Včera som pracoval, dnes pracujem a zajtra budem pracovať.",
              "uk": "Учора я працював, сьогодні працюю і завтра працюватиму."
            },
            {
              "sk": "Minulý rok som nevedel po slovensky, teraz už rozumiem.",
              "uk": "Торік я не знав словацької, тепер уже розумію."
            }
          ],
          "shortRule": "bol som → som → budem",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Майбутнє: шпаргалка",
          "text": "Процес: «budem + недоконане» (budem sa učiť). Результат: доконане дієслово (urobím, kúpim, napíšem). Рух: «pôjdem, prídem». Плани: «Mám v pláne…, Chystám sa…». Обіцянка: «Sľubujem, že…». Прогноз: «Pravdepodobne…, Myslím, že…».",
          "examples": [
            {
              "sk": "Budúci mesiac začnem kurz A2.",
              "uk": "Наступного місяця почну курс A2."
            }
          ],
          "shortRule": "budem robiť / urobím / pôjdem",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Твій A1",
          "text": "На рівні A1 ти навчився: знайомитися, розповідати про родину, житло й роботу, купувати, питати дорогу, їздити транспортом, говорити про погоду, здоров’я, одяг і вільний час — у минулому, теперішньому й майбутньому. «Úroveň» — рівень, «pokrok» — прогрес, «úspech» — успіх.",
          "examples": [
