      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Mám v pláne…",
          "text": "«Mám v pláne» — я планую, у мене в планах + інфінітив: «Mám v pláne kúpiť auto». «Plánujem» — те саме: «Plánujeme ísť k moru». Питання: «Čo plánuješ na leto?»",
          "examples": [
            {
              "sk": "Mám v pláne ísť na kurz.",
              "uk": "Я планую піти на курси."
            },
            {
              "sk": "Čo plánuješ na víkend?",
              "uk": "Що плануєш на вихідні?"
            }
          ],
          "shortRule": "mám v pláne / plánujem + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Chystám sa",
          "text": "«Chystať sa» — збиратися: «Chystám sa k zubárovi» — збираюся до зубного, «Chystám sa kúpiť nový mobil». Якщо ще не знаєш: «Ešte neviem, uvidím» — ще не знаю, побачу. «Ešte sa musím rozhodnúť» — ще маю вирішити.",
          "examples": [
            {
              "sk": "Chystáme sa na sťahovanie.",
              "uk": "Ми готуємося до переїзду."
            }
          ],
          "shortRule": "chystať sa = збиратися",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Dúfam, že… / Ak…",
          "text": "«Dúfam, že to stihnem» — сподіваюся, що встигну. «Ak» — якщо; про майбутнє зазвичай майбутній час в обох частинах: «Ak bude pekne, pôjdeme k jazeru». Перед «že» ставимо кому.",
          "examples": [
            {
              "sk": "Ak budem mať čas, zavolám ti.",
              "uk": "Якщо матиму час, подзвоню тобі."
            }
          ],
          "shortRule": "Ak bude…, pôjdeme…",
          "commonMistakes": [
            {
              "mistake": "Mám v pláne kúpim auto.",
              "correct": "Mám v pláne kúpiť auto."
            },
            {
              "mistake": "Dúfam že prídeš.",
              "correct": "Dúfam, že prídeš."
            },
            {
              "mistake": "Ak bude pekne, budeme ísť k jazeru.",
              "correct": "Ak bude pekne, pôjdeme k jazeru."
            }
          ],
          "button": "Далі →"
        }
      ],
