      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Bude + прислівник",
          "text": "Про погоду й ситуацію: «Zajtra bude teplo / zima / pekne» — завтра буде тепло / холодно / гарно. «Bude pršať» — буде дощ. Дієслово — у 3-й особі однини: «bude», не «budú».",
          "examples": [
            {
              "sk": "Zajtra bude pekne.",
              "uk": "Завтра буде гарна погода."
            },
            {
              "sk": "Cez víkend bude pršať.",
              "uk": "На вихідних буде дощ."
            }
          ],
          "shortRule": "bude + teplo / pekne",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Наскільки впевнено?",
          "text": "Від найвпевненішого: «určite» (точно) → «pravdepodobne» (імовірно) → «zrejme / asi» (мабуть) → «možno» (можливо). «Zrejme» часто означає, що є ознаки: «Vlak zrejme bude meškať».",
          "examples": [
            {
              "sk": "Pravdepodobne prídem neskôr.",
              "uk": "Я, імовірно, прийду пізніше."
            },
            {
              "sk": "Zrejme bude meškať.",
              "uk": "Він, мабуть, запізниться."
            }
          ],
          "shortRule": "určite > pravdepodobne > asi > možno",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Myslím, že… / Uvidíme",
          "text": "«Myslím, že bude dobre» — думаю, буде добре. «Uvidíme» — побачимо (ще невідомо). «Všetko bude v poriadku» — усе буде гаразд. «Máme šancu» — у нас є шанс.",
          "examples": [
            {
              "sk": "Myslím, že vyhráme.",
              "uk": "Думаю, ми виграємо."
            },
            {
              "sk": "Neboj sa, všetko bude v poriadku.",
              "uk": "Не хвилюйся, усе буде гаразд."
            }
          ],
          "shortRule": "Myslím, že…",
          "commonMistakes": [
