      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Predsavzatie",
          "text": "«Predsavzatie» — намір, рішення, особливо новорічне: «Moje predsavzatie je viac športovať». «Na budúci rok» / «budúci rok» — на наступний рік, наступного року. «Tento rok» — цього року.",
          "examples": [
            {
              "sk": "Tento rok sa naučím plávať.",
              "uk": "Цього року я навчуся плавати."
            },
            {
              "sk": "Aké máš predsavzatia?",
              "uk": "Які в тебе рішення на новий рік?"
            }
          ],
          "shortRule": "Moje predsavzatie je + інфінітив",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Цілі",
          "text": "«Urobiť si vodičák» — отримати водійські права (vodičák — розмовне). «Urobiť skúšku» — скласти іспит. «Zlepšiť sa v slovenčine» — покращити словацьку. «Nájsť si lepšiu prácu» — знайти кращу роботу. «Presťahovať sa» — переїхати. «Dosiahnuť cieľ» — досягти мети.",
          "examples": [
            {
              "sk": "Chcem sa zlepšiť v slovenčine.",
              "uk": "Хочу покращити свою словацьку."
            },
            {
              "sk": "V lete sa presťahujeme.",
              "uk": "Улітку ми переїдемо."
            }
          ],
          "shortRule": "zlepšiť sa v + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "План по місяцях",
          "text": "Місяці з «v»: «v januári, v júni, v septembri»; пори року: «v lete, v zime, na jar, na jeseň». «Do konca roka» — до кінця року. Результат — доконане дієслово: «začnem, urobím, nájdem»; процес — budem: «každý deň sa budem učiť».",
          "examples": [
            {
              "sk": "V januári začnem kurz a v júni urobím skúšku.",
              "uk": "У січні почну курс, а в червні складу іспит."
            }
          ],
          "shortRule": "доконане — результат, budem — процес",
