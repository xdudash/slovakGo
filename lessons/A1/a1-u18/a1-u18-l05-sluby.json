      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Sľubujem",
          "text": "«Sľubujem, že prídem» — обіцяю, що прийду. Після «že» — майбутній час: «prídem, zavolám, budem chodiť načas». «Sľub» — обіцянка, «dodržať sľub» — дотримати обіцянки.",
          "examples": [
            {
              "sk": "Sľubujem, že ti zavolám.",
              "uk": "Обіцяю, що подзвоню тобі."
            },
            {
              "sk": "Sľub treba dodržať.",
              "uk": "Обіцянку треба дотримати."
            }
          ],
          "shortRule": "Sľubujem, že + майбутнє",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Určite a nezabudnem",
          "text": "«Určite to urobím» — неодмінно зроблю. «Nezabudnem!» — не забуду! «Nezabudni na kľúče!» — не забудь ключі! «Spoľahni sa!» — можеш на мене покластися! «Neboj sa» — не хвилюйся.",
          "examples": [
            {
              "sk": "Neboj sa, nezabudnem.",
              "uk": "Не хвилюйся, не забуду."
            }
          ],
          "shortRule": "zabudnúť na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pomôžem ti",
          "text": "«Pomôcť» — допомогти: «pomôžem, pomôžeš, pomôže…». «Pomôžem ti so sťahovaním» — допоможу тобі з переїздом. «Prinesiem» — принесу. «Postarám sa o to» — я про це подбаю.",
          "examples": [
            {
              "sk": "Postarám sa o deti.",
              "uk": "Я подбаю про дітей."
            },
            {
              "sk": "Prinesiem ti to zajtra.",
              "uk": "Принесу тобі це завтра."
            }
          ],
          "shortRule": "pomôžem, prinesiem, postarám sa",
          "commonMistakes": [
            {
              "mistake": "Budem ti pomôcť.",
              "correct": "Pomôžem ti."
            },
            {
              "mistake": "Sľubujem, že budem prísť.",
              "correct": "Sľubujem, že prídem."
            },
            {
              "mistake": "Spoľahni!",
              "correct": "Spoľahni sa!"
            }
          ],
          "button": "Далі →"
        }
      ],
