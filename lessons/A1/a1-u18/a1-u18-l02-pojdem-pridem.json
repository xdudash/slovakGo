      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Доконане дієслово = майбутнє",
          "text": "Доконане дієслово в «теперішній» формі означає майбутнє, як і в українській: «napíšem» — напишу, «urobím» — зроблю, «kúpim» — куплю, «zavolám» — подзвоню. Слово budem тут не потрібне!",
          "examples": [
            {
              "sk": "Zavolám ti večer.",
              "uk": "Подзвоню тобі ввечері."
            },
            {
              "sk": "Kúpim chlieb a mlieko.",
              "uk": "Куплю хліб і молоко."
            }
          ],
          "shortRule": "доконане + -m = майбутнє",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ísť → pôjdem",
          "text": "Дієслово «ísť» має особливе майбутнє: «pôjdem, pôjdeš, pôjde, pôjdeme, pôjdete, pôjdu» — піду / поїду. Подібно: «prísť» → «prídem» (прийду), «odísť» → «odídem» (піду геть). Ніколи не кажи «budem ísť».",
          "examples": [
            {
              "sk": "V sobotu pôjdeme do hôr.",
              "uk": "У суботу поїдемо в гори."
            },
            {
              "sk": "Kedy prídeš?",
              "uk": "Коли ти прийдеш?"
            }
          ],
          "shortRule": "ísť → pôjdem",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Процес чи результат?",
          "text": "«Večer budem písať e-maily» — увечері писатиму листи (процес, довго). «Večer napíšem e-mail» — увечері напишу лист (результат, готово). Пари: robiť / urobiť, písať / napísať, kupovať / kúpiť, volať / zavolať, variť / uvariť.",
          "examples": [
            {
              "sk": "Zajtra uvarím guláš.",
              "uk": "Завтра зварю гуляш."
            },
            {
              "sk": "Celé popoludnie budem variť.",
              "uk": "Усе пообіддя я куховаритиму."
            }
          ],
          "shortRule": "budem + процес, доконане = результат",
          "commonMistakes": [
            {
              "mistake": "Budem urobiť.",
              "correct": "Urobím."
            },
            {
              "mistake": "Budem ísť do práce.",
              "correct": "Pôjdem do práce."
            },
            {
              "mistake": "Zajtra budem kúpiť chlieb.",
              "correct": "Zajtra kúpim chlieb."
            }
          ],
          "button": "Далі →"
        }
      ],
