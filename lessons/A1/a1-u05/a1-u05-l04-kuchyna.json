            }
          ],
          "shortRule": "mikrovlnka, umývačka",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Riad",
          "text": "«Riad» — посуд (збірне): taniere (тарілки), poháre (склянки), hrnčeky (чашки), príbor (прибори). «Umývať riad» — мити посуд.",
          "examples": [
            {
              "sk": "Riad je v umývačke.",
              "uk": "Посуд у посудомийці."
            },
            {
              "sk": "Kto dnes umýva riad?",
              "uk": "Хто сьогодні миє посуд?"
            }
          ],
          "shortRule": "riad = посуд",
          "button": "Далі →"
        },
        {
