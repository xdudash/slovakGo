      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Byt і izby",
          "text": "«Byt» — квартира, «izba» — кімната. «Obývačka» — вітальня, «spálňa» — спальня, «detská izba» — дитяча, «chodba» — коридор.",
          "examples": [
            {
              "sk": "Byt má tri izby.",
              "uk": "Квартира має три кімнати."
            },
            {
              "sk": "Deti spia v detskej izbe.",
              "uk": "Діти сплять у дитячій."
            }
          ],
          "shortRule": "izba = кімната",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Типи квартир",
          "text": "Кількість кімнат у назві: jednoizbový (1 кімната), dvojizbový (2), trojizbový (3). В оголошеннях скорочено: 1-izb., 2-izb., 3-izb. Кухня не рахується як кімната. «Garsónka» — студія / малосімейка.",
          "examples": [
            {
              "sk": "Prenajmem 2-izbový byt.",
              "uk": "Здам двокімнатну квартиру."
            },
            {
              "sk": "Bývam v garsónke.",
              "uk": "Я живу в однокімнатній студії."
            }
          ],
          "shortRule": "2-izbový = 2 кімнати + кухня",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де?",
          "text": "«V obývačke, v spálni, v izbe, na chodbe» — у вітальні, у спальні, у кімнаті, у коридорі (na chodbe!).",
          "examples": [
            {
              "sk": "Topánky sú na chodbe.",
              "uk": "Взуття в коридорі."
            },
            {
              "sk": "Televízor je v obývačke.",
              "uk": "Телевізор у вітальні."
            }
          ],
          "shortRule": "na chodbe, ale v obývačke",
          "button": "Далі →"
        }
