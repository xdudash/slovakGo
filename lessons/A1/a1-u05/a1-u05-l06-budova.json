        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ліфт і сходи",
          "text": "«Výťah» — ліфт, «schody» — сходи, «schodisko» — сходова клітка. «Výťah nejde» — ліфт не працює. «Ísť po schodoch» — іти сходами.",
          "examples": [
            {
              "sk": "Výťah je pokazený, ideme po schodoch.",
              "uk": "Ліфт зламаний, ідемо сходами."
            }
