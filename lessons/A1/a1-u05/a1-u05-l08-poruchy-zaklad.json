          "order": 1,
          "title": "Nefunguje / je pokazený",
          "text": "«Nefunguje» — не працює, «je pokazený / pokazená / pokazené» — зламаний / зламана / зламане. «Nesvieti» — не світить (світло).",
          "examples": [
            {
              "sk": "Chladnička nefunguje.",
              "uk": "Холодильник не працює."
            },
            {
              "sk": "Svetlo v kúpeľni nesvieti.",
              "uk": "Світло у ванній не світить."
            }
          ],
          "shortRule": "pokazený / pokazená / pokazené",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Вода й тепло",
          "text": "«Kvapká kohútik» — капає кран. «Tečie voda» — тече вода (протікає). «Nejde teplá voda» — немає гарячої води. «Kúrenie nekúri» — опалення не гріє.",
          "examples": [
            {
              "sk": "Zo stropu tečie voda!",
              "uk": "Зі стелі тече вода!"
            },
            {
              "sk": "Nejde kúrenie.",
              "uk": "Не працює опалення."
            }
          ],
          "shortRule": "kvapká / tečie",
          "button": "Далі →"
        },
