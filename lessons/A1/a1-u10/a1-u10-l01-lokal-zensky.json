      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Тверда основа: -e",
          "text": "Після твердих приголосних -a → -e: škola → v škole, banka → v banke, pošta → na pošte, univerzita → na univerzite.",
          "examples": [
            {
              "sk": "Som v škole.",
              "uk": "Я в школі."
            },
            {
              "sk": "Čakám na pošte.",
              "uk": "Я чекаю на пошті."
            }
          ],
          "shortRule": "-a → -e",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "М’яка основа: -i",
          "text": "Після м’яких (c, č, š, ž, j, ľ, ň) і на -ia: ulica → na ulici, knižnica → v knižnici, kancelária → v kancelárii, reštaurácia → v reštaurácii, pekáreň → v pekárni.",
          "examples": [
            {
              "sk": "Bývam na Hlavnej ulici.",
              "uk": "Живу на Головній вулиці."
            },
            {
              "sk": "Sme v reštaurácii.",
              "uk": "Ми в ресторані."
            }
          ],
          "shortRule": "-ca, -ia, -eň → -i",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прийменники місцевого",
          "text": "v, na, o (про), po (по, після), pri (біля) — завжди з місцевим відмінком. «Pri radnici» — біля ратуші, «o práci» — про роботу.",
          "examples": [
            {
              "sk": "Stretneme sa pri radnici.",
              "uk": "Зустрінемося біля ратуші."
            },
            {
              "sk": "Hovoríme o škole.",
              "uk": "Говоримо про школу."
            }
          ],
          "shortRule": "v / na / o / po / pri + місцевий",
          "button": "Далі →"
        }
      ],
