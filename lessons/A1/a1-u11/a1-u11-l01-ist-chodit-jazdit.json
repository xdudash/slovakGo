      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ísť і chodiť",
          "text": "«Ísť» — іти / їхати зараз, один раз, у певному напрямку: «Idem do práce». «Chodiť» — регулярно або взагалі: «Chodím do práce pešo». Словацьке ísť охоплює і «йти», і «їхати»: «Idem autobusom».",
          "examples": [
            {
              "sk": "Teraz idem domov.",
              "uk": "Зараз я йду додому."
            },
            {
              "sk": "Chodím do školy každý deň.",
              "uk": "Я ходжу до школи щодня."
            }
          ],
          "shortRule": "ísť — зараз; chodiť — регулярно",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Jazdiť і šoférovať",
          "text": "«Jazdiť» — їздити (регулярно транспортом): «Jazdím električkou». «Šoférovať» — керувати машиною: «Šoféruješ?» — ти за кермом? «Viem šoférovať» — умію водити.",
          "examples": [
            {
              "sk": "Jazdím do práce autom.",
              "uk": "Я їжджу на роботу машиною."
            },
            {
              "sk": "Dnes šoféruje manžel.",
              "uk": "Сьогодні за кермом чоловік."
            }
          ],
          "shortRule": "šoférovať = бути водієм",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Літати й пливти",
          "text": "«Letieť» — летіти (зараз), «lietať» — літати (регулярно). «Lietadlo» — літак, «loď» — корабель, «trolejbus» — тролейбус.",
          "examples": [
            {
              "sk": "Letíme do Kyjeva?",
              "uk": "Ми летимо до Києва?"
            },
            {
              "sk": "Lietam často.",
              "uk": "Я часто літаю."
            }
          ],
          "shortRule": "letím — lietam",
          "button": "Далі →"
        }
      ],
