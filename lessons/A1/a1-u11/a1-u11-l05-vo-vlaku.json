      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Вагон і місце",
          "text": "«Vagón» — вагон, «sedadlo» — сидіння, місце, «kupé» — купе, «miestenka» — резервування місця. «Toto je moje miesto» — це моє місце.",
          "examples": [
            {
              "sk": "Mám miestenku na sedadlo 24.",
              "uk": "У мене резерв на місце 24."
            },
            {
              "sk": "Prepáčte, toto je moje miesto.",
              "uk": "Вибачте, це моє місце."
            }
          ],
          "shortRule": "miestenka = резерв місця",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Типи поїздів",
          "text": "«Osobný vlak» — приміський (зупиняється всюди), «rýchlik (R)» — швидкий, «IC / EC» — інтерсіті (потрібна miestenka), «nočný vlak» — нічний. «Jedálny vozeň» — вагон-ресторан.",
          "examples": [
            {
              "sk": "Rýchlik stojí len vo väčších mestách.",
              "uk": "Швидкий зупиняється лише у великих містах."
            }
          ],
          "shortRule": "osobný / rýchlik / IC",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Кондуктор",
          "text": "Кондуктор: «Cestovné lístky, prosím» — квитки, будь ласка. «Máte zľavu?» Ти: «Kde mám vystúpiť do…?», «Stojí tento vlak v…?» (чи зупиняється в…?).",
          "examples": [
            {
              "sk": "Stojí tento vlak v Ružomberku?",
              "uk": "Цей поїзд зупиняється в Ружомберку?"
            }
          ],
          "shortRule": "Stojí tento vlak v…?",
          "button": "Далі →"
        }
      ],
