      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "-i",
          "text": "Найчастіше: študent → študenti, Slovák → Slováci (k → c), chlapec → chlapci, muž → muži, lekár → lekári, Ukrajinec → Ukrajinci. Зверни увагу на зміни: k → c, ch → s (Čech → Česi).",
          "examples": [
            {
              "sk": "Študenti sú v triede.",
              "uk": "Студенти в класі."
            },
            {
              "sk": "Muži pracujú na stavbe.",
              "uk": "Чоловіки працюють на будові."
            }
          ],
          "shortRule": "-i; k → c",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "-ia і -ovia",
          "text": "-teľ → -telia: učiteľ → učitelia, priateľ → priatelia. Родина, професії на -a, деякі короткі слова → -ovia: syn → synovia, otec → otcovia, kolega → kolegovia, hrdina → hrdinovia.",
          "examples": [
            {
              "sk": "Moji priatelia sú zo Slovenska.",
              "uk": "Мої друзі зі Словаччини."
            },
            {
              "sk": "Noví kolegovia sú milí.",
              "uk": "Нові колеги милі."
            }
          ],
          "shortRule": "-teľ → -telia; syn → synovia",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Прикметник: -í",
          "text": "Для людей-чоловіків прикметник у множині — на -í: noví kolegovia, mladí študenti, slovenskí priatelia. Займенники: títo (ці), tí (ті).",
          "examples": [
            {
              "sk": "Títo chlapci sú moji synovia.",
              "uk": "Ці хлопці — мої сини."
