      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ознака — приголосний",
          "text": "Більшість іменників чоловічого роду закінчуються на приголосний: počítač, telefón, zošit, stôl, dom. Прикметник при них — на -ý / -y: nový počítač, veľký stôl.",
          "examples": [
            {
              "sk": "nový telefón",
              "uk": "новий телефон"
            },
            {
              "sk": "malý zošit",
              "uk": "маленький зошит"
            }
          ],
          "shortRule": "приголосний наприкінці → чоловічий рід",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Живі й неживі",
          "text": "Чоловічий рід ділиться на живий (люди, тварини: brat, pes) і неживий (речі: stôl, telefón). Це важливо для відмінків і множини — побачиш у наступних уроках.",
          "examples": [
            {
              "sk": "Mám brata. (живий)",
              "uk": "У мене є брат."
            },
            {
              "sk": "Mám telefón. (неживий)",
              "uk": "У мене є телефон."
            }
          ],
          "shortRule": "brat → brata, telefón → telefón",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Винятки",
          "text": "Деякі іменники чоловічого роду закінчуються на -a: kolega, hrdina (герой), turista. На -o: dedko, Janko (зменшувальні імена). Рід видно з прикметника: dobrý kolega.",
          "examples": [
            {
              "sk": "môj kolega",
              "uk": "мій колега"
            },
            {
              "sk": "starý dedko",
              "uk": "старий дідусь"
            }
          ],
          "shortRule": "kolega, turista — чоловічий рід!",
          "button": "Далі →"
        }
