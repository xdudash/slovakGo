            {
              "sk": "Ten muž je môj sused.",
              "uk": "Той чоловік — мій сусід."
            },
            {
              "sk": "Tá káva je studená.",
              "uk": "Ця кава холодна."
            }
          ],
          "shortRule": "ten / tá / to",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Tento, táto, toto — «оцей»",
          "text": "З -to — щось близьке: tento telefón (оцей телефон), táto taška, toto auto. У магазині: «Tento, prosím» — оцей, будь ласка.",
          "examples": [
            {
              "sk": "Táto bunda je pekná.",
              "uk": "Ця куртка гарна."
            },
            {
              "sk": "Toto jedlo je výborné.",
              "uk": "Ця страва чудова."
            }
          ],
          "shortRule": "tento / táto / toto",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ktorý?",
          "text": "«Ktorý?» (який саме, чол.), «ktorá?» (жін.), «ktoré?» (сер.). «Ktorý chcete? — Tento.»",
          "examples": [
            {
              "sk": "Ktorá taška je vaša? — Tá čierna.",
              "uk": "Яка сумка ваша? — Та чорна."
            },
            {
              "sk": "Ktoré jedlo odporúčate?",
              "uk": "Яку страву радите?"
            }
          ],
          "shortRule": "ktorý / ktorá / ktoré",
          "button": "Далі →"
        }
