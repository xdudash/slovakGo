      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Aký?",
          "text": "Питання узгоджується з іменником: aký (чол.), aká (жін.), aké (сер. і множина речей), akí (чол. особи). «Aký je ten byt?», «Aké sú ceny?»",
          "examples": [
            {
              "sk": "Aká je káva? — Výborná.",
              "uk": "Яка кава? — Чудова."
            },
            {
              "sk": "Akí sú tvoji kolegovia?",
              "uk": "Які твої колеги?"
            }
          ],
          "shortRule": "aký / aká / aké / akí",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Міра",
          "text": "veľmi (дуже), dosť (досить, доволі), celkom (цілком, загалом), trochu (трохи), úplne (повністю, зовсім). «Je dosť drahé» — доволі дорого. «Úplne nový» — абсолютно новий.",
          "examples": [
            {
              "sk": "Je to celkom dobré.",
              "uk": "Це загалом непогано."
            },
            {
              "sk": "Som úplne unavený.",
              "uk": "Я зовсім виснажений."
            }
          ],
          "shortRule": "veľmi > dosť > celkom > trochu",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Príliš — занадто",
          "text": "«Príliš» — занадто (негатив): príliš drahé (занадто дорого), príliš ďaleko. Не плутай із «dosť» — доволі.",
          "examples": [
            {
              "sk": "Je to príliš ďaleko.",
              "uk": "Це занадто далеко."
            },
            {
              "sk": "Káva je príliš horúca.",
              "uk": "Кава занадто гаряча."
            }
          ],
          "shortRule": "príliš = занадто (погано)",
          "button": "Далі →"
        }
      ],
