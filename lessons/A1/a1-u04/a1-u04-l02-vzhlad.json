            {
              "sk": "Je vysoký a štíhly.",
              "uk": "Він високий і стрункий."
            },
            {
              "sk": "Je stredne vysoká.",
              "uk": "Вона середнього зросту."
            }
          ],
          "shortRule": "silnejší — ввічливо",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Волосся та очі",
          "text": "«Má krátke / dlhé vlasy» — у нього коротке / довге волосся (vlasy — множина!). Колір: čierne, hnedé, blond, šedivé. «Má modré / hnedé / zelené oči».",
          "examples": [
            {
              "sk": "Má dlhé hnedé vlasy.",
              "uk": "У неї довге каштанове волосся."
            },
            {
              "sk": "Má zelené oči.",
              "uk": "У неї зелені очі."
            }
          ],
          "shortRule": "vlasy — множина",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як виглядає?",
          "text": "«Ako vyzerá?» — як він / вона виглядає? «Nosí okuliare» — носить окуляри. «Vyzerá mlado» — виглядає молодо.",
          "examples": [
            {
              "sk": "Ako vyzerá tvoj brat?",
              "uk": "Як виглядає твій брат?"
            },
            {
              "sk": "Nosí okuliare a bradu.",
              "uk": "Він носить окуляри й бороду."
            }
          ],
          "shortRule": "Ako vyzerá…?",
          "button": "Далі →"
        }
      ],
