            {
              "sk": "Sú to dobrí ľudia.",
              "uk": "Це хороші люди."
            },
            {
              "sk": "Sú to zaujímavé knihy.",
              "uk": "Це цікаві книжки."
            }
          ],
          "shortRule": "-í (чол. особи) / -é (решта)",
