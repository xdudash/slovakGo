        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Деталі",
          "text": "brada (борода), fúzy (вуса), kučeravé vlasy (кучеряве волосся), rovné vlasy (пряме), tetovanie (татуювання), piercing. «Má na ruke tetovanie» — у нього на руці татуювання.",
          "examples": [
            {
              "sk": "Má hustú bradu.",
              "uk": "У нього густа борода."
            },
            {
              "sk": "Má kučeravé vlasy.",
              "uk": "У неї кучеряве волосся."
            }
          ],
          "shortRule": "brada, fúzy, tetovanie",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vyzerá…",
          "text": "«Vyzerá unavene / mlado / šťastne» — виглядає втомлено / молодо / щасливо (прислівник). «Vyzerá ako…» — виглядає як… «Vyzeráš dobre!» — гарно виглядаєш!",
          "examples": [
            {
              "sk": "Vyzeráš unavene.",
              "uk": "Ти виглядаєш утомлено."
            },
            {
              "sk": "Vyzerá ako jeho otec.",
              "uk": "Він схожий на свого батька."
            }
          ],
          "shortRule": "vyzerať + -e / ako…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Структура опису",
          "text": "1) Хто це і звідки. 2) Вік. 3) Зовнішність. 4) Характер. 5) Що любить / робить. Сполучники: a (і), ale (але), preto (тому).",
          "examples": [
            {
              "sk": "Je vysoký a má bradu.",
              "uk": "Він високий і має бороду."
            },
            {
              "sk": "Je tichý, ale veselý.",
              "uk": "Він тихий, але веселий."
            }
          ],
          "shortRule": "a / ale",
          "button": "Далі →"
        }
      ],
