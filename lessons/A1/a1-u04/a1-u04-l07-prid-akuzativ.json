          "order": 1,
          "title": "Жіночий рід: -ú",
          "text": "nová → novú: «Hľadám novú prácu» — шукаю нову роботу. «Mám dobrú správu» — маю добру новину.",
          "examples": [
            {
              "sk": "Potrebujem šikovnú opatrovateľku.",
              "uk": "Мені потрібна вміла доглядальниця."
            }
          ],
          "shortRule": "-á → -ú",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Чоловічий живий: -ého",
          "text": "Для людей і тварин: nový → nového, dobrý kolega → dobrého kolegu. «Hľadáme skúseného murára» — шукаємо досвідченого муляра.",
          "examples": [
            {
              "sk": "Máme nového šéfa.",
              "uk": "У нас новий шеф."
            },
            {
              "sk": "Hľadáme spoľahlivého vodiča.",
              "uk": "Шукаємо надійного водія."
            }
          ],
          "shortRule": "-ý → -ého (+ іменник -a/-u)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Неживий і середній — без змін",
          "text": "«Mám nový telefón», «Kúpil som staré auto». Знахідний неживого чоловічого й середнього = називний.",
