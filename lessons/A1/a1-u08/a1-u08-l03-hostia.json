      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Живий чоловічий: -a",
          "text": "Люди й тварини чоловічого роду в знахідному: kamarát → kamaráta, brat → brata, sused → suseda. «Pozvem suseda na večeru» — запрошу сусіда на вечерю.",
          "examples": [
            {
              "sk": "Pozvali sme kolegu.",
              "uk": "Ми запросили колегу."
            },
            {
              "sk": "Vidím psa.",
              "uk": "Я бачу собаку."
            }
          ],
          "shortRule": "kamarát → kamaráta",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Пригощання",
          "text": "Господиня каже: «Ponúknite sa!» (Пригощайтеся!), «Nech sa páči, ochutnajte» (скуштуйте). Гість: «Ďakujem, ochutnám» / «Je to vynikajúce!»",
          "examples": [
            {
              "sk": "Ponúknite sa, prosím.",
              "uk": "Пригощайтеся, будь ласка."
            },
            {
              "sk": "To je výborné!",
              "uk": "Це чудово!"
            }
          ],
          "shortRule": "Ponúknite sa! — Ďakujem.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Вистачить",
          "text": "Коли наївся: «Ďakujem, už nevládzem» (дякую, більше не можу), «Bolo to výborné». На відмову словаки зазвичай ще раз пропонують — це ввічливість.",
          "examples": [
            {
              "sk": "Ešte kúsok? — Nie, ďakujem, už nevládzem.",
              "uk": "Ще шматочок? — Ні, дякую, більше не можу."
            }
          ],
          "shortRule": "už nevládzem = більше не можу",
          "button": "Далі →"
        }
      ],
