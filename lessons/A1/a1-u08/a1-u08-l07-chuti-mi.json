          "order": 1,
          "title": "Chutí mi",
          "text": "«Chutí mi polievka» — мені смакує суп (буквально: суп смакує мені). Множина: «Chutia mi halušky». Заперечення: «Nechutí mi».",
          "examples": [
            {
              "sk": "Chutí ti?",
              "uk": "Тобі смакує?"
            },
            {
              "sk": "Nechutia mi olivy.",
              "uk": "Мені не смакують оливки."
            }
          ],
          "shortRule": "chutí / chutia + mi",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mám rád / rada",
          "text": "«Mám rád» (чоловік) / «mám rada» (жінка) + знахідний — люблю: «Mám rada ryby». «Nemám rád cibuľu» — не люблю цибулю.",
          "examples": [
            {
              "sk": "Mám rád pizzu.",
              "uk": "Я люблю піцу."
            },
            {
              "sk": "Nemám rada cesnak.",
              "uk": "Я не люблю часник."
            }
          ],
          "shortRule": "mám rád / rada + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Смак",
          "text": "sladký (солодкий), slaný (солоний), kyslý (кислий), horký (гіркий), pikantný / štipľavý (гострий). «Je to príliš slané» — це занадто солоне.",
          "examples": [
            {
              "sk": "Polievka je trochu slaná.",
              "uk": "Суп трохи солоний."
            },
            {
              "sk": "Mám rád pikantné jedlá.",
              "uk": "Я люблю гостру їжу."
            }
          ],
          "shortRule": "sladký, slaný, pikantný",
          "button": "Далі →"
        }
