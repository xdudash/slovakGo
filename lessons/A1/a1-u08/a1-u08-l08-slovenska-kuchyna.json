      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Національні страви",
          "text": "bryndzové halušky (галушки з бриндзою й шкварками), kapustnica (капусняк, особливо на Різдво), rezeň (відбивна в паніровці), guláš, pirohy (вареники!), knedle (кнедлі).",
          "examples": [
            {
              "sk": "Bryndzové halušky so slaninou.",
              "uk": "Бриндзові галушки з беконом."
            },
            {
              "sk": "Na Vianoce varíme kapustnicu.",
              "uk": "На Різдво варимо капусняк."
            }
          ],
          "shortRule": "pirohy = вареники",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Схоже на українське",
          "text": "pirohy ≈ вареники, kapustnica ≈ капусняк, rezeň ≈ шніцель, lokše ≈ картопляні коржики. «Prívarok» — густа овочева страва.",
          "examples": [
            {
              "sk": "Pirohy s bryndzou.",
              "uk": "Вареники з бриндзою."
            },
            {
              "sk": "Rezeň so zemiakovým šalátom.",
              "uk": "Шніцель із картопляним салатом."
            }
          ],
          "shortRule": "pirohy = вареники",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "У ресторані",
          "text": "«Čo nám odporúčate?» — що порадите? «Je to typické slovenské jedlo?» — це типова словацька страва? «Domáce» — домашнє.",
          "examples": [
            {
              "sk": "Odporúčam domácu kapustnicu.",
              "uk": "Раджу домашній капусняк."
            },
            {
              "sk": "Je to typické?",
              "uk": "Це типово?"
            }
          ],
          "shortRule": "Čo odporúčate?",
          "button": "Далі →"
        }
      ],
