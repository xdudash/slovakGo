          "title": "Шкала частоти",
          "text": "vždy (завжди) → zvyčajne (зазвичай) → často (часто) → niekedy (іноді) → zriedka (рідко) → nikdy (ніколи + ne-).",
          "examples": [
            {
              "sk": "Vždy raňajkujem.",
              "uk": "Я завжди снідаю."
            },
            {
              "sk": "Zriedka chodím do kina.",
              "uk": "Я рідко ходжу в кіно."
            }
          ],
          "shortRule": "vždy → nikdy",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Кожен / раз на…",
          "text": "«Každý deň» — щодня, «každý týždeň» — щотижня, «každú sobotu» — щосуботи. «Raz týždenne» — раз на тиждень, «dvakrát mesačne» — двічі на місяць.",
          "examples": [
            {
              "sk": "Každé ráno pijem kávu.",
              "uk": "Щоранку я п’ю каву."
            },
            {
              "sk": "Upratujem raz týždenne.",
              "uk": "Я прибираю раз на тиждень."
            }
          ],
          "shortRule": "raz / dvakrát / trikrát + týždenne / mesačne",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Chodiť — регулярно",
          "text": "Для регулярних походів: «chodím» (ходжу), не «idem»: «Chodím do práce pešo», «Chodím na kurz každý utorok». «Idem» — зараз, один раз.",
          "examples": [
            {
              "sk": "Chodím plávať dvakrát týždenne.",
              "uk": "Я ходжу плавати двічі на тиждень."
            },
            {
              "sk": "Teraz idem do obchodu.",
              "uk": "Зараз я йду в магазин."
            }
          ],
          "shortRule": "chodím (регулярно) vs idem (зараз)",
          "button": "Далі →"
        }
