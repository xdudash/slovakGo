      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Схема -ám",
          "text": "volať: volám, voláš, volá, voláme, voláte, volajú. Так само: čakať, počúvať, čítať, pozerať, hrať, dávať, bývať, vstávať.",
          "examples": [
            {
              "sk": "Čakám na autobus.",
              "uk": "Я чекаю на автобус."
            },
            {
              "sk": "Večer čítame.",
              "uk": "Увечері ми читаємо."
            }
          ],
          "shortRule": "-ám / -áš / -á / -áme / -áte / -ajú",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ритмічне скорочення",
          "text": "Якщо склад у корені довгий, закінчення стає коротким: počúvať → počúvam, čítať → čítam (а не «čítám»). Це те саме ритмічне скорочення, що й у прикметниках.",
          "examples": [
            {
              "sk": "Počúvam rádio.",
              "uk": "Я слухаю радіо."
            },
            {
              "sk": "Čítam noviny.",
              "uk": "Я читаю газету."
            }
          ],
          "shortRule": "довгий корінь → коротке -am",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čakať na…",
          "text": "«Čakať na + знахідний» — чекати на когось: čakám na teba, čakáme na lekára. «Pozerať televíziu / film» — дивитися ТБ / фільм. «Hrať futbal» — грати у футбол, «hrať sa» — гратися (про дітей).",
          "examples": [
            {
              "sk": "Čakám na teba pred domom.",
              "uk": "Я чекаю на тебе перед будинком."
            },
            {
              "sk": "Deti sa hrajú vonku.",
              "uk": "Діти граються надворі."
            }
          ],
          "shortRule": "čakať na + знахідний",
          "button": "Далі →"
        }
      ],
