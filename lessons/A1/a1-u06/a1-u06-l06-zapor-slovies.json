        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Подвійне заперечення",
          "text": "Як і в українській: «Nikdy nefajčím» — я ніколи не палю. «Nikto neprišiel» — ніхто не прийшов. «Nikde to nie je» — цього ніде немає. «Vôbec» — зовсім: «Vôbec nerozumiem».",
          "examples": [
            {
              "sk": "Nikdy nepijem kávu.",
              "uk": "Я ніколи не п’ю каву."
            },
            {
              "sk": "Nikto nevie.",
              "uk": "Ніхто не знає."
            }
          ],
          "shortRule": "nikdy / nikto / nikde + ne-",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Už nie, ešte nie",
          "text": "«Už nie» — уже ні (більше не), «ešte nie» — ще ні. «Už tam nebývam» — я там уже не живу. «Ešte nie som hotový» — я ще не готовий.",
          "examples": [
            {
              "sk": "Už nefajčím.",
              "uk": "Я вже не палю."
            },
            {
