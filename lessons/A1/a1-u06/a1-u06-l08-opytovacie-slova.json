          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde чи kam?",
          "text": "«Kde?» — де (місце): Kde bývaš? «Kam?» — куди (напрямок): Kam ideš? «Odkiaľ?» — звідки.",
          "examples": [
            {
              "sk": "Kam ideš? — Do práce.",
              "uk": "Куди йдеш? — На роботу."
            },
            {
              "sk": "Kde pracuješ? — V sklade.",
              "uk": "Де працюєш? — На складі."
            }
          ],
          "shortRule": "kde — де, kam — куди",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як довго, як часто",
          "text": "«Ako dlho?» — як довго (тривалість): Ako dlho tu bývaš? «Ako často?» — як часто: Ako často cestuješ? «Odkedy?» — з якого часу.",
          "examples": [
            {
              "sk": "Ako dlho čakáte?",
              "uk": "Як довго ви чекаєте?"
            },
            {
              "sk": "Ako často chodíš do posilňovne?",
              "uk": "Як часто ходиш у спортзал?"
            }
          ],
          "shortRule": "ako dlho / ako často",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "З прийменниками",
          "text": "«S kým?» — з ким, «O čom?» — про що, «Na čo?» — для чого / на що, «Pre koho?» — для кого.",
          "examples": [
            {
              "sk": "S kým bývaš?",
              "uk": "З ким ти живеш?"
            },
            {
              "sk": "O čom je film?",
              "uk": "Про що фільм?"
            },
            {
              "sk": "Na čo to je?",
              "uk": "Для чого це?"
            }
          ],
          "shortRule": "s kým, o čom, na čo",
          "button": "Далі →"
        }
      ],
