      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Je — для всіх трьох",
          "text": "«On je» (він є), «ona je» (вона є), «ono je» (воно є). Форма одна — je. Займенник часто пропускають: «Je doma» — він/вона вдома.",
          "examples": [
            {
              "sk": "On je lekár.",
              "uk": "Він лікар."
            },
            {
              "sk": "Ona je z Košíc.",
              "uk": "Вона з Кошиць."
            }
          ],
          "shortRule": "on / ona / ono + je",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ono — середній рід",
          "text": "«Ono» — для іменників середнього роду: dieťa (дитина), auto, mesto. «Kde je dieťa? — Ono je v škôlke» (частіше просто «Je v škôlke»).",
          "examples": [
            {
              "sk": "Dieťa je choré.",
              "uk": "Дитина хвора."
            },
            {
              "sk": "Auto je nové.",
              "uk": "Машина нова."
            }
          ],
          "shortRule": "dieťa — ono (як «воно»)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Предмети теж «він» і «вона»",
          "text": "Як в українській: stôl (він) je veľký, taška (вона) je ťažká. Але рід не завжди збігається з українським: auto — ono (машина — вона), problém — on.",
          "examples": [
            {
              "sk": "Kde je taška? — Je tu.",
              "uk": "Де сумка? — Тут."
            },
            {
              "sk": "Auto je drahé.",
              "uk": "Машина дорога."
            }
          ],
          "shortRule": "Рід дивимося за словацьким словом.",
          "button": "Далі →"
        }
      ],
