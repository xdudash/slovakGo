      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Byť + де?",
          "text": "«Kde si?» — «Som v práci» (на роботі), «v škole» (у школі), «na úrade» (в установі), «v meste» (у місті), «u lekára» (у лікаря). Різниця v / na — як у попередніх уроках.",
          "examples": [
            {
              "sk": "Som ešte v práci.",
              "uk": "Я ще на роботі."
            },
            {
              "sk": "Mama je u lekára.",
              "uk": "Мама в лікаря."
            }
          ],
          "shortRule": "v práci, v škole, na úrade, u lekára",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Надворі й усередині",
          "text": "«Vonku» — надворі, «vnútri» — усередині. «Hore» — нагорі, «dole» — унизу. «Deti sú vonku» — діти надворі. «Čakám dole» — чекаю внизу.",
          "examples": [
            {
              "sk": "Je vonku zima?",
              "uk": "Надворі холодно?"
            },
            {
              "sk": "Sme hore, na treťom poschodí.",
              "uk": "Ми нагорі, на третьому поверсі."
            }
          ],
          "shortRule": "vonku / vnútri, hore / dole",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "U + хто?",
          "text": "«U lekára» (у лікаря), «u kamaráta» (у друга), «u nás» (у нас), «u babky» (у бабусі). «U» = у когось удома / в когось.",
          "examples": [
            {
              "sk": "Sme u kamaráta.",
              "uk": "Ми в друга."
            },
            {
              "sk": "U nás je to inak.",
              "uk": "У нас це інакше."
            }
          ],
          "shortRule": "u + людина",
          "button": "Далі →"
        }
      ],
