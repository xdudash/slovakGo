      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Byť — бути",
          "text": "В українській «бути» в теперішньому часі майже зникло («я — студент»). У словацькій byť обов’язкове: «Ja som študent» — я (є) студент. «Ty si doma» — ти (є) вдома.",
          "examples": [
            {
              "sk": "Ja som Petro.",
              "uk": "Я — Петро."
            },
            {
              "sk": "Ty si Anna?",
              "uk": "Ти — Анна?"
            }
          ],
          "shortRule": "ja som, ty si — обов’язково",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Займенник можна пропустити",
          "text": "Форма дієслова вже показує особу, тому «ja» і «ty» часто пропускають: «Som unavený» (я втомлений), «Si doma?» (ти вдома?). Займенник лишають для наголосу: «Ja som tu, ty si tam».",
          "examples": [
            {
              "sk": "Som v práci.",
              "uk": "Я на роботі."
            },
            {
              "sk": "Si Ukrajinec?",
              "uk": "Ти українець?"
            }
          ],
          "shortRule": "Som… / Si… без займенника — норма.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порядок слів",
          "text": "Som і si — «слабкі» слова, вони люблять друге місце в реченні: «Dnes som doma» (а не «Dnes doma som»). Почни з одного слова — і одразу som.",
          "examples": [
            {
              "sk": "Teraz som v obchode.",
              "uk": "Зараз я в магазині."
            },
            {
              "sk": "Kde si?",
              "uk": "Де ти?"
            }
          ],
          "shortRule": "som / si — на другому місці",
          "commonMistakes": [
            {
              "mistake": "Ja študent.",
              "correct": "Ja som študent."
            },
            {
              "mistake": "Dnes doma som.",
              "correct": "Dnes som doma."
            }
          ],
          "button": "Далі →"
        }
      ],
