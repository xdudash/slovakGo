      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nie + byť",
          "text": "Заперечення byť: nie som, nie si, nie je, nie sme, nie ste, nie sú. Увага: тут «nie» пишеться ОКРЕМО. З іншими дієсловами — разом: nemám, nechcem.",
          "examples": [
            {
              "sk": "Nie som doma.",
              "uk": "Я не вдома."
            },
            {
              "sk": "To nie je pravda.",
              "uk": "Це неправда."
            }
          ],
          "shortRule": "nie som — окремо; nemám — разом",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Виправляємо",
          "text": "«Nie som Rus, som Ukrajinec» — я не росіянин, я українець. «Nie je to ďaleko» — це недалеко. Корисне слово: «ale» — але.",
          "examples": [
            {
              "sk": "Nie som študent, som robotník.",
              "uk": "Я не студент, я робітник."
            },
            {
              "sk": "Nie je zima, je teplo.",
              "uk": "Не холодно, тепло."
            }
          ],
          "shortRule": "nie…, ale…",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Порядок слів",
          "text": "У запереченні «nie» стоїть перед формою byť: «Dnes nie som v práci». Але в коротких реченнях часто: «Nie, nie som».",
          "examples": [
            {
              "sk": "Dnes nie som v práci.",
              "uk": "Сьогодні я не на роботі."
            },
            {
              "sk": "Peter tu nie je.",
              "uk": "Петера тут немає."
            }
          ],
          "shortRule": "nie + som / je…",
          "commonMistakes": [
            {
              "mistake": "Nesom doma.",
              "correct": "Nie som doma."
            },
            {
              "mistake": "Ja nie mám čas.",
              "correct": "Ja nemám čas."
            }
          ],
          "button": "Далі →"
        }
      ],
