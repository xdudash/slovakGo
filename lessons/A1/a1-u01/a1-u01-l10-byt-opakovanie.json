            {
              "sk": "Sme z Ukrajiny, ale nie sme turisti.",
              "uk": "Ми з України, але ми не туристи."
            }
          ],
          "shortRule": "Шість форм — і ти говориш.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Схема опису людини",
          "text": "Kto je to? — To je… Odkiaľ je? — Je z… Čo robí? — Je… / Pracuje ako… Aký je? — Je milý, pokojný… Kde je teraz? — Je v práci.",
          "examples": [
            {
              "sk": "Toto je Ivan. Je z Rivne, je murár. Je milý a pokojný.",
              "uk": "Це Іван. Він із Рівного, муляр. Він милий і спокійний."
