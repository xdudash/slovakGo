      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Види спорту",
          "text": "«Šport» — спорт, «športovať» — займатися спортом. Ігри: «futbal», «hokej» (у Словаччині — спорт номер один!), «tenis», «basketbal», «volejbal». Їх «hráme»: «Hrám hokej».",
          "examples": [
            {
              "sk": "Slováci milujú hokej.",
              "uk": "Словаки обожнюють хокей."
            },
            {
              "sk": "Hráme volejbal na pláži.",
              "uk": "Ми граємо у волейбол на пляжі."
            }
          ],
          "shortRule": "hrať + гра (знахідний)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Chodím plávať",
          "text": "Плавання, біг, спортзал: «Plávam» — плаваю, «Behám» — бігаю, «Chodím plávať» — ходжу плавати, «Chodím do posilňovne» — ходжу в спортзал (posilňovňa — тренажерний зал). «Cvičím» — тренуюся, роблю вправи.",
          "examples": [
            {
              "sk": "Chodím do posilňovne trikrát týždenne.",
              "uk": "Я ходжу в спортзал тричі на тиждень."
            },
            {
              "sk": "Ráno behám v parku.",
              "uk": "Зранку бігаю в парку."
            }
          ],
          "shortRule": "chodiť + інфінітив / do + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як часто?",
          "text": "«Raz týždenne» — раз на тиждень, «dvakrát týždenne» — двічі на тиждень, «každý deň», «občas» — іноді, «vôbec» — зовсім. «Nešportujem vôbec» — я зовсім не займаюся спортом.",
          "examples": [
            {
              "sk": "Plávam dvakrát týždenne.",
              "uk": "Я плаваю двічі на тиждень."
            }
          ],
          "shortRule": "raz, dvakrát, trikrát",
          "button": "Далі →"
        }
      ],
