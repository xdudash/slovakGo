      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як запросити?",
          "text": "«Nechceš ísť s nami do kina?» — не хочеш піти з нами в кіно? «Máš chuť na kávu?» — маєш бажання на каву? «Poď s nami!» — ходи з нами! Офіційно: «Chcel by som vás pozvať na…» — хотів би вас запросити на…",
          "examples": [
            {
              "sk": "Máš chuť ísť na prechádzku?",
              "uk": "Хочеш піти погуляти?"
            },
            {
              "sk": "Pozývam ťa na obed.",
              "uk": "Запрошую тебе на обід (я пригощаю)."
            }
          ],
          "shortRule": "Nechceš…? Máš chuť…?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як прийняти?",
          "text": "«Áno, rád / rada!» — так, із радістю! «S radosťou!» — із задоволенням! «To je dobrý nápad!» — гарна ідея! «Pridám sa» — я приєднаюся.",
          "examples": [
            {
              "sk": "Rada sa pridám.",
              "uk": "Я (ж.) охоче приєднаюся."
            },
            {
              "sk": "Ďakujem za pozvanie!",
              "uk": "Дякую за запрошення!"
            }
          ],
          "shortRule": "S radosťou!",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Скільки коштує?",
          "text": "«Vstupné» — вхідний квиток, плата за вхід: «Aké je vstupné?» «Vstup je zadarmo» — вхід безкоштовний. «Pozývam ťa» часто означає «я плачу».",
          "examples": [
            {
              "sk": "Vstupné je päť eur.",
              "uk": "Вхід п’ять євро."
            },
            {
              "sk": "Koncert je zadarmo.",
              "uk": "Концерт безкоштовний."
            }
          ],
          "shortRule": "vstupné, zadarmo",
          "button": "Далі →"
        }
      ],
