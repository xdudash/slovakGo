      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Hrať + знахідний",
          "text": "Ігри й види спорту — без прийменника: «hrať futbal, tenis, šach (шахи), karty (карти)». Як в українській «грати у футбол», але без «у»!",
          "examples": [
            {
              "sk": "Večer hráme karty.",
              "uk": "Увечері граємо в карти."
            },
            {
              "sk": "Dedko hrá šach.",
              "uk": "Дідусь грає в шахи."
            }
          ],
          "shortRule": "hrať + знахідний (без прийменника)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Hrať na + місцевий",
          "text": "Музичні інструменти — «hrať na» + місцевий відмінок: «hrať na gitare, na klavíri, na husliach (скрипка), na bubnoch (барабани)». Тут схоже на українську: «грати на гітарі».",
          "examples": [
            {
              "sk": "Syn hrá na klavíri.",
              "uk": "Син грає на фортепіано."
            },
            {
              "sk": "Hráš na nejakom nástroji?",
              "uk": "Ти граєш на якомусь інструменті?"
            }
          ],
          "shortRule": "hrať na + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відмінкові форми",
          "text": "gitara → na gitare, klavír → na klavíri, husle (лише множина) → na husliach, bubny → na bubnoch. «Hudobný nástroj» — музичний інструмент.",
          "examples": [
            {
              "sk": "Učím sa hrať na gitare.",
              "uk": "Я вчуся грати на гітарі."
            }
          ],
          "shortRule": "-a → -e; -r → -i",
