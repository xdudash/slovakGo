          "order": 1,
          "title": "Kde a kedy?",
          "text": "«Kde sa stretneme?» — де зустрінемося? «Pred kinom» — перед кінотеатром, «pri fontáne» — біля фонтану, «na námestí». «O koľkej?» — о котрій? «O siedmej» — о сьомій.",
          "examples": [
            {
              "sk": "Stretneme sa o šiestej pred obchodným centrom.",
              "uk": "Зустрінемося о шостій перед торговим центром."
            }
          ],
          "shortRule": "pred + орудний, pri + місцевий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dohodnúť sa",
          "text": "«Dohodnúť sa» — домовитися: «Dohodneme sa na čase» — домовимося про час. «Zraz» — збір, місце зустрічі групи: «Zraz je o ôsmej na stanici». «Partia» — компанія друзів.",
          "examples": [
            {
              "sk": "Dohodli sme sa na sobotu.",
              "uk": "Ми домовилися на суботу."
            },
            {
              "sk": "Máme super partiu.",
              "uk": "У нас класна компанія."
            }
          ],
          "shortRule": "dohodnúť sa = домовитися",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Posedieť si",
          "text": "«Posedieť si» — посидіти (у кав’ярні, в барі): «Poďme si posedieť» — ходімо посидимо. «Zastaviť sa» — заскочити: «Zastavím sa u teba» — заскочу до тебе.",
          "examples": [
            {
              "sk": "Po práci si ideme posedieť.",
              "uk": "Після роботи йдемо посидіти."
            }
          ],
          "shortRule": "posedieť si, zastaviť sa",
          "button": "Далі →"
        }
