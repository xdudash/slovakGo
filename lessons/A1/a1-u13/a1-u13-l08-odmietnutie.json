      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як відмовити?",
          "text": "Відмова у трьох кроках: 1) подяка — «Ďakujem za pozvanie», 2) відмова з жалем — «Bohužiaľ nemôžem» / «Škoda, ale nemôžem», 3) причина — «Mám nočnú zmenu». Просто «Nie» звучить різко.",
          "examples": [
            {
              "sk": "Ďakujem, ale bohužiaľ nemôžem, mám prácu.",
              "uk": "Дякую, але, на жаль, не можу, маю роботу."
            }
          ],
          "shortRule": "подяка + жаль + причина",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mrzí ma to",
          "text": "«Mrzí ma to» — мені шкода, прикро. «Nestíham» — не встигаю: «Dnes to nestíham». «Škoda!» — шкода! (відповідь друга: «Škoda, tak inokedy»).",
          "examples": [
            {
              "sk": "Mrzí ma, že nemôžem prísť.",
              "uk": "Мені шкода, що не можу прийти."
            },
            {
              "sk": "Tento týždeň nestíham.",
              "uk": "Цього тижня не встигаю."
            }
          ],
          "shortRule": "mrzí ma = мені шкода",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Інший варіант",
          "text": "«Možno inokedy» — можливо, іншим разом. «Môžeme to presunúť na nedeľu?» — можемо перенести на неділю? «Dobrý návrh, ale…» — гарна пропозиція, але… «Ozvem sa» — я напишу / подзвоню.",
          "examples": [
            {
              "sk": "Čo tak budúci týždeň?",
              "uk": "Як щодо наступного тижня?"
            }
          ],
          "shortRule": "inokedy, presunúť, ozvem sa",
          "commonMistakes": [
            {
              "mistake": "Nie, nechcem.",
              "correct": "Ďakujem, ale bohužiaľ nemôžem."
            },
            {
              "mistake": "Mrzím ma.",
              "correct": "Mrzí ma to."
            },
            {
              "mistake": "Nestíhavam.",
              "correct": "Nestíham."
            }
          ],
          "button": "Далі →"
        }
      ],
