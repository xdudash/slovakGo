      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo robíš cez víkend?",
          "text": "Про найближчі плани словаки часто говорять у теперішньому часі: «V sobotu idem na turistiku» — у суботу йду в похід. «Cez víkend» — на вихідних. «Ešte neviem» — ще не знаю.",
          "examples": [
            {
              "sk": "Cez víkend ideme k babke.",
              "uk": "На вихідних їдемо до бабусі."
            },
            {
              "sk": "V nedeľu grilujeme.",
              "uk": "У неділю робимо гриль."
            }
          ],
          "shortRule": "теперішній час для планів",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Hory a turistika",
          "text": "«Turistika» — піші походи. Словаки люблять «hory» (гори): Tatry, Malá Fatra. «Ísť do hôr» — їхати в гори, «na túru» — у похід. Влітку — «kúpalisko» (відкритий басейн).",
          "examples": [
            {
              "sk": "V lete chodíme na kúpalisko.",
              "uk": "Улітку ходимо на відкритий басейн."
            },
            {
              "sk": "Ideme na túru do Malej Fatry.",
              "uk": "Їдемо в похід у Малу Фатру."
            }
          ],
          "shortRule": "do hôr, na túru",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Інші варіанти",
          "text": "«Grilovať» — смажити на грилі, «zápas» — матч: «Ideme na zápas Slovana». «Výstava» — виставка. «Oddychovať doma» — відпочивати вдома.",
          "examples": [
            {
              "sk": "V sobotu je zápas o tretej.",
              "uk": "У суботу матч о третій."
            }
          ],
          "shortRule": "zápas, výstava",
          "button": "Далі →"
        }
      ],
