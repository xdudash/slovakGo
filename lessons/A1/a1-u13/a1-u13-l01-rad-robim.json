      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Rád + дієслово",
          "text": "Словацькою «я люблю читати» — «Rád čítam» (чоловік) або «Rada čítam» (жінка). Rád — це не дієслово, а слово, що узгоджується з тим, хто говорить, а дієслово стоїть в особовій формі.",
          "examples": [
            {
              "sk": "Rád varím.",
              "uk": "Я (ч.) люблю готувати."
            },
            {
              "sk": "Rada tancujem.",
              "uk": "Я (ж.) люблю танцювати."
            },
            {
              "sk": "Radi spievame.",
              "uk": "Ми любимо співати."
            }
          ],
          "shortRule": "rád / rada / radi / rady + дієслово",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Radšej і najradšej",
          "text": "«Radšej» — охочіше, краще: «Radšej čítam, ako pozerám televízor» — я більше люблю читати, ніж дивитися телевізор. «Najradšej» — найбільше люблю: «Najradšej spievam». Заперечення — «nerád / nerada».",
          "examples": [
            {
              "sk": "Radšej plávam ako behám.",
              "uk": "Я більше люблю плавати, ніж бігати."
            },
            {
              "sk": "Nerada varím.",
              "uk": "Я (ж.) не люблю готувати."
            }
          ],
          "shortRule": "rád → radšej → najradšej",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Mám rád + іменник",
          "text": "З іменником: «Mám rád hudbu», «Mám rada knihy» — іменник у знахідному відмінку. «Záľuba» — хобі, захоплення: «Moja záľuba je spev». Питання: «Čo robíš rád vo voľnom čase?»",
          "examples": [
            {
              "sk": "Mám rád jazz.",
              "uk": "Я люблю джаз."
            },
            {
              "sk": "Aké máš záľuby?",
              "uk": "Які в тебе хобі?"
            }
          ],
          "shortRule": "mám rád + знахідний",
          "commonMistakes": [
            {
              "mistake": "Ja rád čítať.",
              "correct": "Rád čítam."
            },
            {
              "mistake": "Rád hudba.",
              "correct": "Mám rád hudbu."
            },
            {
              "mistake": "(жінка) Rád tancujem.",
              "correct": "Rada tancujem."
            }
          ],
          "button": "Далі →"
        }
      ],
