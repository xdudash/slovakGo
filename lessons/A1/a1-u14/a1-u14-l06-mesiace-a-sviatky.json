      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "V ktorom mesiaci?",
          "text": "Місяці з прийменником «v» + місцевий відмінок: «v januári, vo februári, v marci, v apríli, v máji, v júni, v júli, v auguste, v septembri, v októbri, v novembri, v decembri». Зверни увагу: «vo februári» — бо важко вимовити «v f…».",
          "examples": [
            {
              "sk": "Narodeniny mám v auguste.",
              "uk": "День народження в мене в серпні."
            },
            {
              "sk": "Vianoce sú v decembri.",
              "uk": "Різдво в грудні."
            }
          ],
          "shortRule": "v + місяць; vo februári",
          "commonMistakes": [
            {
              "mistake": "v februári",
              "correct": "vo februári"
            },
            {
              "mistake": "Vianoce je v decembri.",
              "correct": "Vianoce sú v decembri."
            },
            {
              "mistake": "na Vianocy",
              "correct": "na Vianoce"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Sviatky",
          "text": "«Sviatok» — свято (часто це вихідний день). «Vianoce» — Різдво (завжди множина: «Vianoce sú»), «Štedrý večer» — Святвечір, 24 грудня. «Veľká noc» — Великдень. «Silvester» — 31 грудня, «Nový rok» — 1 січня. Коли? «Na Vianoce, na Veľkú noc, na Silvestra, na Nový rok».",
          "examples": [
            {
              "sk": "Na Vianoce sme doma.",
              "uk": "На Різдво ми вдома."
            },
            {
              "sk": "Na Silvestra je na námestí ohňostroj.",
              "uk": "У новорічну ніч на площі феєрверк."
            }
          ],
          "shortRule": "na Vianoce, na Veľkú noc, na Silvestra",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Meniny a priania",
          "text": "«Meniny» — іменини: кожен день у словацькому календарі має ім’я, і людей у цей день вітають майже як на день народження. Побажання: «Veselé Vianoce!», «Šťastný nový rok!», «Všetko najlepšie k meninám!», «Všetko najlepšie k narodeninám!». Відповідь: «Ďakujem, aj tebe / aj vám!»",
          "examples": [
            {
              "sk": "Dnes má meniny Jana.",
              "uk": "Сьогодні в Яни іменини."
            },
            {
              "sk": "Všetko najlepšie k narodeninám!",
              "uk": "Усього найкращого з днем народження!"
            }
          ],
          "shortRule": "Všetko najlepšie k…",
          "button": "Далі →"
        }
      ],
