      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Je + прислівник",
          "text": "Погоду описуємо безособово: «Je jasno» — ясно, «Je slnečno» — сонячно, «Je oblačno» — хмарно, «Je zamračené» — похмуро. Підмета немає, як в українському «Сьогодні хмарно». У минулому — «bolo»: «Ráno bolo oblačno».",
          "examples": [
            {
              "sk": "Dnes je slnečno.",
              "uk": "Сьогодні сонячно."
            },
            {
              "sk": "Ráno bolo oblačno.",
              "uk": "Зранку було хмарно."
            }
          ],
          "shortRule": "je / bolo + jasno, oblačno, slnečno",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Дієслова погоди",
          "text": "«Svieti slnko» — світить сонце, «fúka vietor» — дме вітер, «prší» — іде дощ, «sneží» — іде сніг. Зверни увагу: українське «іде дощ» — словацькою одне слово «prší», без «ide».",
          "examples": [
            {
              "sk": "Fúka studený vietor.",
              "uk": "Дме холодний вітер."
            },
            {
              "sk": "Svieti slnko.",
              "uk": "Світить сонце."
            }
          ],
          "shortRule": "svieti, fúka, prší, sneží",
          "commonMistakes": [
            {
              "mistake": "Je slnko.",
              "correct": "Svieti slnko."
            },
            {
              "mistake": "Dnes je oblačný.",
              "correct": "Dnes je oblačno."
            },
            {
              "mistake": "Ide dážď.",
              "correct": "Prší."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Hmla a búrka",
          "text": "«Hmla» — туман: «Ráno je hmla». «Búrka» — гроза: «Blíži sa búrka» — наближається гроза. Загальна оцінка: «pekné počasie» — гарна погода, «škaredé počasie» — погана погода.",
          "examples": [
            {
              "sk": "V noci bola búrka.",
              "uk": "Уночі була гроза."
            },
            {
              "sk": "Na diaľnici je hustá hmla.",
              "uk": "На автостраді густий туман."
            }
          ],
          "shortRule": "hmla, búrka",
          "button": "Далі →"
        }
