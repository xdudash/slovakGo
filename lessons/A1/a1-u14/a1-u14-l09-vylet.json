      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ideme na výlet",
          "text": "«Výlet» — поїздка за місто, «túra» — піший похід. «Ísť na výlet / na túru». Майбутнє від ísť — «pôjdem, pôjdeme» (піду, підемо). «Vyjsť na vrchol» — піднятися на вершину. Хто не хоче йти пішки, їде «lanovkou» (канатною дорогою).",
          "examples": [
            {
              "sk": "V sobotu pôjdeme na túru do Tatier.",
              "uk": "У суботу підемо в похід у Татри."
            },
            {
              "sk": "Na Lomnický štít ide lanovka.",
              "uk": "На Ломницький штит веде канатна дорога."
            }
          ],
          "shortRule": "ísť na výlet / na túru",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Čo si zbalíme?",
          "text": "«Zbaliť si batoh» — зібрати рюкзак. Беремо: «termosku s čajom» (термос із чаєм), «vodu», «desiatu» (перекус), «pláštenku», «mapu». «Piknik» — пікнік: «Urobíme si piknik na lúke».",
          "examples": [
            {
              "sk": "Zbaľ si batoh, ráno ideme.",
              "uk": "Збери рюкзак, зранку їдемо."
            },
            {
              "sk": "Do batohu dám termosku.",
              "uk": "У рюкзак покладу термос."
            }
          ],
          "shortRule": "zbaliť si batoh",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ak bude pršať…",
          "text": "Умова, що залежить від погоди: «Ak bude pekne, pôjdeme na túru» — якщо буде гарна погода, підемо в похід. «Ak bude pršať, zostaneme doma» — якщо йтиме дощ, залишимося вдома. Після «ak» про майбутнє — «bude».",
          "examples": [
            {
              "sk": "Ak bude hmla, nepôjdeme na vrchol.",
              "uk": "Якщо буде туман, не підемо на вершину."
            }
          ],
          "shortRule": "ak bude…, pôjdeme…",
          "commonMistakes": [
            {
              "mistake": "Pôjdeme lanovku.",
              "correct": "Pôjdeme lanovkou."
            },
            {
              "mistake": "Ak bude prší…",
              "correct": "Ak bude pršať…"
            },
            {
              "mistake": "Ideme na túra.",
              "correct": "Ideme na túru."
            }
          ],
          "button": "Далі →"
        }
      ],
