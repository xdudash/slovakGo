      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Koľko je stupňov?",
          "text": "«Teplota» — температура. Питаємо: «Koľko je vonku stupňov?» — скільки надворі градусів? Відповідь: «Je dvadsať stupňov». Слово «stupeň» змінюється після числа, як українське «градус — градуси — градусів».",
          "examples": [
            {
              "sk": "Vonku je osemnásť stupňov.",
              "uk": "Надворі вісімнадцять градусів."
            }
          ],
          "shortRule": "Koľko je stupňov?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "1 — 2–4 — 5+",
          "text": "«Jeden stupeň» (je), «dva / tri / štyri stupne» (sú), «päť, desať, dvadsať… stupňov» (je). Тобто: «Je jeden stupeň», «Sú tri stupne», «Je osem stupňov». Нуль — «nula stupňov».",
          "examples": [
            {
              "sk": "Vonku sú tri stupne.",
              "uk": "Надворі три градуси."
            },
            {
              "sk": "Je päť stupňov.",
              "uk": "П’ять градусів."
            }
          ],
          "shortRule": "1 stupeň, 2–4 stupne, 5+ stupňov",
          "commonMistakes": [
            {
              "mistake": "Je päť stupne.",
              "correct": "Je päť stupňov."
            },
            {
              "mistake": "Je dva stupňov.",
              "correct": "Sú dva stupne."
            },
            {
              "mistake": "Koľko je gradusov?",
              "correct": "Koľko je stupňov?"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pod nulou",
          "text": "Нижче нуля: «mínus päť» або «päť stupňov pod nulou». Вище нуля — «nad nulou». «Mráz» — мороз, «mrzne» — морозить. Про себе: «Mrznem!» або «Je mi zima» — мені холодно. «Chladno» — прохолодно.",
          "examples": [
            {
              "sk": "V noci mrzne.",
              "uk": "Уночі морозить."
            },
            {
              "sk": "Teplomer ukazuje mínus osem.",
              "uk": "Термометр показує мінус вісім."
            }
          ],
          "shortRule": "pod nulou / nad nulou",
          "button": "Далі →"
        }
      ],
