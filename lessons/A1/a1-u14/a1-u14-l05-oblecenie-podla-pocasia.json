      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Zimné a letné oblečenie",
          "text": "Узимку: «kabát» (пальто), «čiapka» (шапка), «šál» (шарф), «sveter» (светр), «čižmy» (чоботи), «rukavice». Улітку: «tričko» (футболка), «šortky» (шорти), «sandále». «Nosiť» — носити: «V zime nosím kabát».",
          "examples": [
            {
              "sk": "V zime nosím kabát a čiapku.",
              "uk": "Узимку я ношу пальто й шапку."
            },
            {
              "sk": "V lete chodím v šortkách.",
              "uk": "Улітку я ходжу в шортах."
            }
          ],
          "shortRule": "nosiť + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Obleč si, obuj si",
          "text": "«Obliecť si» — вдягнути (одяг): «Obleč si sveter!» «Obuť si» — взути (взуття): «Obuj si čižmy!» Шапку й шарф розмовно «dáme si»: «Daj si čiapku». Протилежне — «vyzliecť si» (зняти одяг).",
          "examples": [
            {
              "sk": "Obleč si kabát, vonku mrzne.",
              "uk": "Вдягни пальто, надворі морозить."
            },
            {
              "sk": "Obuj si teplé čižmy.",
              "uk": "Взуй теплі чоботи."
