      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "V prírode",
          "text": "«Príroda» — природа, «v prírode» — на природі. «Les» — ліс, «rieka» — річка, «jazero» — озеро, «lúka» — луг, «kopec» — пагорб. Словаччина дуже зелена: ліси вкривають приблизно 40 % країни.",
          "examples": [
            {
              "sk": "Bývame blízko lesa.",
              "uk": "Ми живемо біля лісу."
            },
            {
              "sk": "Váh je najdlhšia slovenská rieka.",
              "uk": "Ваг — найдовша словацька річка."
            }
          ],
          "shortRule": "príroda — v prírode",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Kde? Kam?",
          "text": "Де? — місцевий відмінок: «v lese», «na lúke», «na kopci», «pri rieke», «pri jazere». Куди? — «do lesa», «na lúku», «na kopec», «k rieke», «k jazeru».",
          "examples": [
            {
              "sk": "Deti sa hrajú na lúke.",
              "uk": "Діти граються на лузі."
            },
            {
              "sk": "Ideme k jazeru.",
              "uk": "Ідемо до озера."
            }
          ],
          "shortRule": "kde: v lese / kam: do lesa",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Čo robíme v prírode?",
          "text": "«Vták» — птах, «zviera» — тварина, «kvet» — квітка, «huby» — гриби. «Ísť na huby» або «zbierať huby» — іти по гриби, збирати гриби (улюблене заняття словаків восени!). «Chrániť prírodu» — берегти природу.",
          "examples": [
            {
              "sk": "Na jeseň zbierame huby v lese.",
              "uk": "Восени збираємо гриби в лісі."
            }
          ],
          "shortRule": "ísť na huby, zbierať huby",
          "button": "Далі →"
        }
      ],
