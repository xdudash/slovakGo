      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kedy?",
          "text": "Пам’ятай прийменники: «na jar» (навесні), «v lete» (улітку), «na jeseň» (восени), «v zime» (узимку). Українською це одне слово, а словацькою — прийменник + іменник. Прийменники треба просто запам’ятати: na — для весни й осені, v — для літа й зими.",
          "examples": [
            {
              "sk": "Na jar všetko kvitne.",
              "uk": "Навесні все цвіте."
            },
            {
              "sk": "V zime chodíme lyžovať.",
              "uk": "Узимку ми їздимо кататися на лижах."
            }
          ],
          "shortRule": "na jar, v lete, na jeseň, v zime",
          "commonMistakes": [
            {
              "mistake": "V jar je teplo.",
              "correct": "Na jar je teplo."
            },
            {
              "mistake": "V jeseň padá lístie.",
              "correct": "Na jeseň padá lístie."
            },
            {
              "mistake": "Na zime je sneh.",
              "correct": "V zime je sneh."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Jarný, letný…",
          "text": "Від назв пір року утворюються прикметники: jar → «jarný», leto → «letný», jeseň → «jesenný», zima → «zimný». «Letná dovolenka» — літня відпустка, «zimná bunda» — зимова куртка. Ще два корисні прикметники: «teplý» — теплий, «studený» — холодний.",
          "examples": [
            {
              "sk": "Mám novú zimnú bundu.",
              "uk": "У мене нова зимова куртка."
            },
            {
              "sk": "Jesenné ráno je studené.",
              "uk": "Осінній ранок холодний."
            }
          ],
          "shortRule": "jarný, letný, jesenný, zimný",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Príroda počas roka",
          "text": "Навесні «stromy kvitnú» (дерева цвітуть), улітку ми «opaľujeme sa» (засмагаємо), восени «padá lístie» (опадає листя), узимку лежить сніг. Питання для розмови: «Ktoré ročné obdobie máš najradšej?» — яку пору року ти любиш найбільше?",
          "examples": [
            {
              "sk": "Na jeseň padá lístie.",
              "uk": "Восени опадає листя."
            },
            {
              "sk": "V lete sa opaľujem pri vode.",
              "uk": "Улітку я засмагаю біля води."
            }
          ],
          "shortRule": "ročné obdobie = пора року",
          "button": "Далі →"
        }
      ],
