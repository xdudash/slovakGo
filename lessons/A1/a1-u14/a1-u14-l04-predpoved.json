      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Bude…",
          "text": "Про майбутню погоду кажемо «bude»: «Zajtra bude slnečno» — завтра буде сонячно, «Bude teplo». З дієсловами — bude + інфінітив: «bude pršať», «bude snežiť», «bude fúkať». Питання: «Aké bude zajtra počasie?»",
          "examples": [
            {
              "sk": "Zajtra bude pršať.",
              "uk": "Завтра йтиме дощ."
            },
            {
              "sk": "V noci bude snežiť.",
              "uk": "Уночі йтиме сніг."
            }
          ],
          "shortRule": "bude + slnečno / pršať",
          "commonMistakes": [
            {
              "mistake": "Zajtra je pršať.",
              "correct": "Zajtra bude pršať."
            },
            {
              "mistake": "Zajtra bude prší.",
              "correct": "Zajtra bude pršať."
            },
            {
              "mistake": "Bude slnečný.",
              "correct": "Bude slnečno."
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Мова прогнозу",
          "text": "«Predpoveď počasia» — прогноз погоди. «Polojasno» — мінлива хмарність (і сонце, і хмари), «zrážky» — опади, «bez zrážok» — без опадів. «Cez deň» — удень, «v noci» — уночі. «Najvyššia denná teplota» — максимальна денна температура.",
          "examples": [
            {
              "sk": "Cez deň polojasno, bez zrážok.",
              "uk": "Удень мінлива хмарність, без опадів."
            }
          ],
          "shortRule": "predpoveď, polojasno, zrážky",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Oteplenie a ochladenie",
          "text": "«Oteplenie» — потепління, «ochladenie» — похолодання. «Teploty stúpnu» — температура підніметься, «klesnú» — знизиться. «Podľa predpovede…» — за прогнозом… «Čaká sa…» — очікується…",
          "examples": [
            {
              "sk": "Podľa predpovede príde ochladenie.",
              "uk": "За прогнозом прийде похолодання."
            },
            {
              "sk": "Na víkend sa čaká oteplenie.",
              "uk": "На вихідні очікують потепління."
            }
          ],
          "shortRule": "oteplenie ↔ ochladenie",
          "button": "Далі →"
        }
      ],
