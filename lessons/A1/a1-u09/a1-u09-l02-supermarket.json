          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відділи",
          "text": "«Oddelenie» — відділ: ovocie a zelenina, mäso a údeniny (м’ясо й ковбаси), mliečne výrobky, pečivo, nápoje, drogéria (побутова хімія), mrazené výrobky (заморожені). «Regál» — стелаж, «uličky» — ряди.",
          "examples": [
            {
              "sk": "Mlieko je na oddelení mliečnych výrobkov.",
              "uk": "Молоко у відділі молочних продуктів."
            }
          ],
          "shortRule": "oddelenie, regál",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Персонал",
          "text": "«Prepáčte, kde nájdem…?» — вибачте, де знайти…? Відповіді: «V treťom regáli», «Na konci uličky», «Pri pokladniach».",
          "examples": [
            {
              "sk": "Kde nájdem múku? — V uličke číslo päť.",
              "uk": "Де знайти борошно? — У ряду номер п’ять."
            }
          ],
          "shortRule": "Kde nájdem…?",
          "button": "Далі →"
        }
