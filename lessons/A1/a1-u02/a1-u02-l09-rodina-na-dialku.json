      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Chýba mi…",
          "text": "«Chýba mi mama» — я сумую за мамою (буквально: мені бракує мами). Множина: «Chýbajú mi rodičia». Хто сумує — у давальному: mi (мені), ti (тобі), mu (йому), jej (їй).",
          "examples": [
            {
              "sk": "Chýba mi domov.",
              "uk": "Я сумую за домом."
            },
            {
              "sk": "Chýbajú mi deti.",
              "uk": "Я сумую за дітьми."
            }
          ],
          "shortRule": "Chýba mi + хто / що",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Зв’язок",
          "text": "«Volám s mamou každý deň» — я щодня говорю з мамою по телефону. «Máme videohovor» — у нас відеодзвінок. «Píšeme si správy» — ми переписуємося.",
          "examples": [
            {
              "sk": "Večer mám videohovor s rodičmi.",
              "uk": "Увечері в мене відеодзвінок із батьками."
            },
            {
              "sk": "Píšeme si každý deň.",
              "uk": "Ми пишемо одне одному щодня."
            }
          ],
          "shortRule": "volať s…, písať si",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Зустріч",
          "text": "«Navštíviť» — відвідати, «prísť na návštevu» — приїхати в гості, «stretnúť sa» — зустрітися. «V lete ma navštívi mama» — улітку мене відвідає мама.",
          "examples": [
            {
              "sk": "Na Vianoce idem domov.",
              "uk": "На Різдво я їду додому."
            },
            {
              "sk": "Tešíme sa na stretnutie.",
              "uk": "Ми чекаємо на зустріч."
            }
          ],
          "shortRule": "tešiť sa na… = чекати з радістю",
          "button": "Далі →"
        }
      ],
