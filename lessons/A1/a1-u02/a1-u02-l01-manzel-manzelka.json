      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Manžel і manželka",
          "text": "«Manžel» — чоловік (у шлюбі), «manželka» — дружина. Розмовно: «muž» і «žena» теж означають чоловік і дружина: «môj muž», «moja žena». «Priateľ / priateľka» — хлопець / дівчина (у стосунках) або просто друг / подруга.",
          "examples": [
            {
              "sk": "Môj manžel je Slovák.",
              "uk": "Мій чоловік — словак."
            },
            {
              "sk": "Moja žena pracuje v nemocnici.",
              "uk": "Моя дружина працює в лікарні."
            }
          ],
          "shortRule": "manžel / manželka; muž / žena",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Mám + знахідний",
          "text": "Після mám — знахідний відмінок. Живі істоти чоловічого роду: -a (manžel → manžela, priateľ → priateľa). Жіночий рід: -a → -u (manželka → manželku).",
          "examples": [
            {
              "sk": "Mám manžela a dve deti.",
              "uk": "У мене чоловік і двоє дітей."
            },
            {
              "sk": "Mám priateľku zo Slovenska.",
              "uk": "У мене дівчина зі Словаччини."
            }
          ],
          "shortRule": "manžel → manžela; manželka → manželku",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Брати й сестри",
          "text": "«Súrodenec» — брат або сестра (рідний), «súrodenci» — брати й сестри. «Jedináčik» — єдина дитина в сім’ї. «Máš súrodencov?» — у тебе є брати чи сестри?",
          "examples": [
            {
              "sk": "Mám troch súrodencov.",
              "uk": "У мене троє братів і сестер."
            },
            {
              "sk": "Som jedináčik.",
              "uk": "Я єдина дитина."
            }
          ],
          "shortRule": "súrodenci = брати й сестри",
          "button": "Далі →"
        }
      ],
