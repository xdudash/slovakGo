      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від знайомства до весілля",
          "text": "«Chodiť s niekým» — зустрічатися з кимось, «zasnúbiť sa» — заручитися, «vziať sa» — побратися, «svadba» — весілля. «Sme zasnúbení» — ми заручені.",
          "examples": [
            {
              "sk": "Chodíme spolu dva roky.",
              "uk": "Ми зустрічаємося два роки."
            },
            {
              "sk": "Svadba bude v júni.",
              "uk": "Весілля буде в червні."
            }
          ],
          "shortRule": "chodiť s… → zasnúbiť sa → svadba",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Partner і vzťah",
          "text": "«Partner / partnerka» — нейтральне слово для пари (і в шлюбі, і без). «Vzťah» — стосунки. «Rozísť sa» — розійтися.",
          "examples": [
            {
              "sk": "Môj partner je z Bratislavy.",
              "uk": "Мій партнер із Братислави."
            },
            {
              "sk": "Sme vo vzťahu.",
              "uk": "Ми у стосунках."
            }
          ],
          "shortRule": "partner — нейтрально",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Почуття і делікатність",
          "text": "«Ľúbim ťa» — я тебе кохаю (романтично), «mám ťa rád / rada» — ти мені дорогий. Про особисте словаки питають обережно: «Ak to nie je tajomstvo…» — якщо це не секрет…",
          "examples": [
            {
              "sk": "Ľúbim ťa.",
              "uk": "Я тебе кохаю."
            },
            {
              "sk": "Ak to nie je tajomstvo, ste ženatý?",
              "uk": "Якщо не секрет, ви одружені?"
            }
          ],
