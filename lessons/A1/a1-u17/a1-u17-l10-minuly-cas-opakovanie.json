      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Схема",
          "text": "ja — robil / robila som; ty — robil / robila si; on / ona / ono — robil / robila / robilo; my — robili sme; vy — robili ste; oni — robili. Неправильні: išiel, jedol, mohol, prišiel, stretol.",
          "examples": [
            {
              "sk": "Ja som pracovala, ale manžel nepracoval.",
              "uk": "Я працювала, а чоловік не працював."
            }
          ],
          "shortRule": "som / si / — / sme / ste / —",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Порядок слів",
          "text": "1) som / si / sme / ste — на другому місці: «Včera som bol doma». 2) Спершу som, потім sa / si: «Narodil som sa», «Oddýchli sme si». 3) ne- разом із формою на -l: «Nebol som», «Neučil som sa».",
          "examples": [
            {
              "sk": "Kedy si sa vrátila?",
              "uk": "Коли ти повернулася?"
            },
            {
              "sk": "Nič sa nestalo.",
              "uk": "Нічого не сталося."
            }
          ],
          "shortRule": "som → sa; ne- + -l",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Розповідь про минуле",
          "text": "«Spomienka» — спогад, «pamätať si» — пам’ятати, «zažiť» — пережити, відчути, «prvýkrát» — уперше. «Pamätám si, ako sme prvýkrát prišli do Bratislavy» — я пам’ятаю, як ми вперше приїхали до Братислави.",
          "examples": [
            {
              "sk": "Na Slovensku sme zažili veľa nového.",
              "uk": "У Словаччині ми пережили багато нового."
            }
          ],
          "shortRule": "kedysi, vlani, minulý týždeň, včera",
          "button": "Далі →"
        }
