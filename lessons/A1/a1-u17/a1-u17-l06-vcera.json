      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Учора по порядку",
          "text": "«Včera ráno», «včera večer», «predvčerom» — позавчора. Порядок подій: «najprv… potom… nakoniec». «Celý deň» — увесь день.",
          "examples": [
            {
              "sk": "Včera ráno som vstal o šiestej.",
              "uk": "Учора вранці я встав о шостій."
            },
            {
              "sk": "Predvčerom som bola u mamy.",
              "uk": "Позавчора я була в мами."
            }
          ],
          "shortRule": "včera, predvčerom, celý deň",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Som і sa",
          "text": "У минулому часі спершу йде som / si / sme / ste, а потім sa / si: «Umyl som sa», «Včera som sa učila», «Oddýchli sme si». У 3-й особі лише sa: «Peter sa umyl». Ніколи не «Umyl sa som»!",
          "examples": [
            {
              "sk": "Ráno som sa osprchovala.",
              "uk": "Уранці я прийняла душ."
            },
            {
              "sk": "Večer sme si oddýchli.",
              "uk": "Увечері ми відпочили."
            }
          ],
          "shortRule": "som / sme + sa / si",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ty + sa / si",
          "text": "Для «ty»: «Kedy si sa vrátil?» — коли ти повернувся? «Oddýchol si si?» — ти відпочив? Тут перше si — це «ти», друге si — частина дієслова oddýchnuť si.",
          "examples": [
            {
              "sk": "Kedy si sa zobudil?",
              "uk": "Коли ти прокинувся?"
            },
            {
              "sk": "Oddýchla si si?",
              "uk": "Ти (ж.) відпочила?"
            }
          ],
          "shortRule": "si sa / si si",
