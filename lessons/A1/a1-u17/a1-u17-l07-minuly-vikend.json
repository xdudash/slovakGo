      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як минули вихідні?",
          "text": "«Aký bol víkend?» — які були вихідні? «Ako si strávil víkend?» — як ти провів вихідні? Зверни увагу: «víkend» — однина, тому «bol». «Minulý víkend» — минулих вихідних, «minulý týždeň» — минулого тижня.",
          "examples": [
            {
              "sk": "Ako ste strávili víkend?",
              "uk": "Як ви провели вихідні?"
            },
            {
              "sk": "Minulý víkend sme boli na chate.",
              "uk": "Минулих вихідних ми були на дачі."
            }
          ],
          "shortRule": "minulý víkend = минулих вихідних",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Розповідь",
          "text": "Розповідь з’єднуємо словами «najprv… potom… nakoniec» або «v sobotu… a v nedeľu…». «Pozrel som si film» — я подивився фільм, «Stretli sme sa s kamarátmi» — ми зустрілися з друзями.",
          "examples": [
            {
              "sk": "V sobotu sme upratovali a v nedeľu sme išli na výlet.",
              "uk": "У суботу ми прибирали, а в неділю поїхали на прогулянку."
            },
            {
              "sk": "Pozrela som si nový seriál.",
              "uk": "Я подивилася новий серіал."
            }
          ],
          "shortRule": "najprv → potom → nakoniec",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Реакції",
          "text": "«To znie dobre!» — звучить добре! «Bolo to skvelé!» — це було чудово! «Bola nuda» — було нудно. «Škoda!» — шкода! «A ty?» — а ти?",
          "examples": [
            {
              "sk": "Celý víkend pršalo, bola nuda.",
              "uk": "Усі вихідні йшов дощ, було нудно."
            },
            {
              "sk": "Mali sme skvelý víkend.",
              "uk": "У нас були чудові вихідні."
            }
          ],
          "shortRule": "Bolo to skvelé! / Bola nuda.",
          "button": "Далі →"
        }
      ],
