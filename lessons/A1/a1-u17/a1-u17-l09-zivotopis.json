      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що таке životopis",
          "text": "«Životopis» — резюме (CV), документ для пошуку роботи. Частини: «osobné údaje» (особисті дані), «vzdelanie» (освіта), «pracovné skúsenosti» (досвід роботи), «jazykové znalosti» (знання мов). Про себе розповідаємо минулим часом.",
          "examples": [
            {
              "sk": "Narodil som sa v roku 1990 v Charkove.",
              "uk": "Я народився в 1990 році в Харкові."
            },
            {
              "sk": "Narodila som sa v Odese.",
              "uk": "Я народилася в Одесі."
            }
          ],
          "shortRule": "narodil som sa / narodila som sa",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vzdelanie",
          "text": "«Vyštudoval som ekonómiu» — я здобув економічну освіту (закінчив виш). «Stredná škola» — середня школа (часто професійна): «Skončila som strednú školu v roku 2008». «Vyučil som sa za murára» — я вивчився на муляра.",
          "examples": [
            {
              "sk": "Vyštudovala som pedagogiku v Kyjeve.",
              "uk": "Я здобула педагогічну освіту в Києві."
            }
          ],
          "shortRule": "vyštudovať, skončiť školu",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pracovné skúsenosti",
          "text": "«Pracoval som ako vodič» — я працював водієм (після ako — називний відмінок). «V rokoch 2015 – 2022» — у 2015–2022 роках. «Zamestnanie» — робота, місце праці. На співбесіді питають: «Kde ste pracovali predtým?»",
          "examples": [
            {
              "sk": "V rokoch 2015 – 2022 som pracoval ako vodič.",
              "uk": "У 2015–2022 роках я працював водієм."
            }
          ],
          "shortRule": "pracoval som ako + називний",
          "commonMistakes": [
            {
              "mistake": "Narodil sa som.",
              "correct": "Narodil som sa."
            },
            {
              "mistake": "Pracoval som ako vodiča.",
              "correct": "Pracoval som ako vodič."
            },
            {
              "mistake": "(жінка) Narodil som sa.",
              "correct": "Narodila som sa."
            }
          ],
          "button": "Далі →"
        }
      ],
