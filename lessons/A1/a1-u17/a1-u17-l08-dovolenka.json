      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde ste boli?",
          "text": "«Dovolenka» — відпустка: «ísť na dovolenku», «byť na dovolenke». «Boli sme pri mori» — ми були на морі. «Bývali sme v hoteli» — ми жили в готелі. «Ubytovanie» — житло, проживання.",
          "examples": [
            {
              "sk": "Na dovolenke sme boli v Taliansku.",
              "uk": "У відпустці ми були в Італії."
            },
            {
              "sk": "Ubytovanie bolo blízko pláže.",
              "uk": "Житло було близько до пляжу."
            }
          ],
          "shortRule": "byť na dovolenke, pri mori",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Що робили?",
          "text": "«Kúpali sme sa v mori» — купалися в морі, «opaľovali sme sa na pláži» — засмагали на пляжі, «chodili sme na výlety» — їздили на екскурсії. Пам’ятай: sme стоїть перед sa.",
          "examples": [
            {
              "sk": "Deti sa celý deň kúpali.",
              "uk": "Діти цілий день купалися."
            },
            {
              "sk": "Opaľovala som sa na pláži.",
              "uk": "Я засмагала на пляжі."
            }
          ],
          "shortRule": "kúpať sa, opaľovať sa",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Враження",
          "text": "«Páčilo sa mi more» — мені сподобалося море (more — середній рід → -lo). «Páčil sa mi hotel», «Páčila sa mi pláž», «Páčili sa mi hory» — форма узгоджується з тим, що сподобалося. «Zážitok» — враження, пригода.",
          "examples": [
            {
              "sk": "Najviac sa nám páčilo more.",
              "uk": "Найбільше нам сподобалося море."
            },
            {
              "sk": "Bol to skvelý zážitok.",
              "uk": "Це була чудова пригода."
            }
          ],
          "shortRule": "páčil / páčila / páčilo / páčili sa mi",
          "commonMistakes": [
            {
              "mistake": "Páčilo sa mi hory.",
              "correct": "Páčili sa mi hory."
            },
            {
              "mistake": "Kúpali sa sme.",
              "correct": "Kúpali sme sa."
            },
            {
              "mistake": "Boli sme v mori.",
              "correct": "Boli sme pri mori."
            }
          ],
          "button": "Далі →"
        }
      ],
