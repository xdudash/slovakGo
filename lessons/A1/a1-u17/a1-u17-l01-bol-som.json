      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Bol som — я був",
          "text": "В українській «я був» — одне слово. У словацькій минулий час має дві частини: форму на -l і допоміжне слово «som / si / sme / ste». «Bol som doma» — я (ч.) був удома, «Bola som v práci» — я (ж.) була на роботі. Займенник «ja» зазвичай не вживаємо.",
          "examples": [
            {
              "sk": "Včera som bol u lekára.",
              "uk": "Учора я (ч.) був у лікаря."
            },
            {
              "sk": "Bola som na pošte.",
              "uk": "Я (ж.) була на пошті."
            }
          ],
          "shortRule": "bol / bola + som",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Усі особи",
          "text": "ja — bol som / bola som; ty — bol si / bola si; on — bol, ona — bola, ono — bolo; my — boli sme; vy — boli ste; oni / ony — boli. У 3-й особі допоміжного слова НЕМАЄ: «Peter bol v Košiciach». Множина завжди «boli» — і для чоловіків, і для жінок.",
          "examples": [
            {
              "sk": "Mama bola doma.",
              "uk": "Мама була вдома."
            },
            {
              "sk": "Boli sme v Tatrách.",
              "uk": "Ми були в Татрах."
            }
          ],
          "shortRule": "3-я особа — без som / si",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Де стоїть som?",
          "text": "«Som / si / sme / ste» стоїть на другому місці в реченні: «Bol som doma», але «Včera som bol doma», «Kde si bol?». На початку речення — ніколи: не «Som bol doma». Ввічливо (на «ви») — завжди «boli ste», навіть до однієї людини: «Kde ste boli, pani Nováková?»",
          "examples": [
            {
              "sk": "Kde ste boli cez víkend?",
              "uk": "Де ви були на вихідних?"
            },
            {
              "sk": "Vlani som bol na Slovensku prvýkrát.",
              "uk": "Торік я вперше був у Словаччині."
            }
          ],
          "shortRule": "som — на другому місці",
          "commonMistakes": [
            {
              "mistake": "Som bol doma.",
              "correct": "Bol som doma."
            },
            {
              "mistake": "Peter je bol v práci.",
              "correct": "Peter bol v práci."
            },
            {
              "mistake": "(жінка) Bol som v obchode.",
              "correct": "Bola som v obchode."
            }
          ],
          "button": "Далі →"
        }
      ],
