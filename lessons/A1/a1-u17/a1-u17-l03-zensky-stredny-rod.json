      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Жінка говорить",
          "text": "Жінка додає -la: robila som, pracovala som, kúpila som. Неправильні форми: išla, jedla, mohla, prišla, stretla. Як в українській: «я робила».",
          "examples": [
            {
              "sk": "Včera som pracovala do noci.",
              "uk": "Учора я працювала до ночі."
            },
            {
              "sk": "Išla som do mesta.",
              "uk": "Я пішла в місто."
            }
          ],
          "shortRule": "жінка → -la som",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Середній рід: -lo",
          "text": "Для середнього роду — -lo: «Dieťa spalo», «Auto stálo pred domom». Дуже часті фрази: «Čo sa stalo?» — що сталося? «Bolo to super» — це було супер. «Bolo mi zle» — мені було погано. «Páčilo sa mi to» — мені це сподобалося.",
          "examples": [
            {
              "sk": "Dieťa celú noc plakalo.",
              "uk": "Дитина плакала всю ніч."
            },
            {
              "sk": "Čo sa stalo?",
              "uk": "Що сталося?"
            }
          ],
          "shortRule": "-lo для ono і безособових фраз",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Узгодження",
          "text": "Форма на -l залежить від роду підмета: «Otec napísal», «Mama napísala», «Auto sa pokazilo». Коли питаєш подругу: «Kde si bola?» — де ти була?",
          "examples": [
            {
              "sk": "Sestra mi napísala správu.",
              "uk": "Сестра написала мені повідомлення."
            },
            {
              "sk": "Auto sa pokazilo.",
              "uk": "Машина зламалася."
            }
          ],
          "shortRule": "рід підмета → -l / -la / -lo",
          "commonMistakes": [
            {
              "mistake": "(жінка) Pracoval som v hoteli.",
              "correct": "Pracovala som v hoteli."
