      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як утворити",
          "text": "Від інфінітива відкидаємо -ť і додаємо -l: robiť → robil, pracovať → pracoval, kúpiť → kúpil, čítať → čítal, hrať → hral. Потім додаємо som / si / sme / ste, як у bol som.",
          "examples": [
            {
              "sk": "Včera som pracoval do šiestej.",
              "uk": "Учора я працював до шостої."
            },
            {
              "sk": "Kúpil som chlieb.",
              "uk": "Я купив хліб."
            }
          ],
          "shortRule": "-ť → -l",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Хто це зробив?",
          "text": "ja — robil som; ty — robil si; on — robil; my — robili sme; vy — robili ste; oni — robili. Як і з bol: у 3-й особі без допоміжного слова. Питання: «Čo si robil?» — що ти робив? «Kúpil si mlieko?» — ти купив молоко?",
          "examples": [
            {
              "sk": "Brat kúpil nové auto.",
              "uk": "Брат купив нову машину."
            },
            {
              "sk": "Čo si robil včera večer?",
              "uk": "Що ти робив учора ввечері?"
            }
          ],
          "shortRule": "som / si / — / sme / ste / —",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Неправильні форми",
          "text": "Кілька частих дієслів мають особливу форму: ísť → išiel, jesť → jedol, môcť → mohol, prísť → prišiel, stretnúť → stretol, zabudnúť → zabudol. Їх треба просто запам’ятати.",
          "examples": [
            {
              "sk": "Išiel som domov.",
              "uk": "Я пішов додому."
            },
            {
              "sk": "Stretol som suseda.",
              "uk": "Я зустрів сусіда."
            }
          ],
          "shortRule": "išiel, jedol, mohol, prišiel",
          "commonMistakes": [
            {
              "mistake": "Ja kúpiť chlieb včera.",
              "correct": "Včera som kúpil chlieb."
            },
            {
              "mistake": "Brat som kúpil auto.",
              "correct": "Brat kúpil auto."
            },
            {
              "mistake": "Jesol som.",
              "correct": "Jedol som."
            }
          ],
          "button": "Далі →"
        }
      ],
