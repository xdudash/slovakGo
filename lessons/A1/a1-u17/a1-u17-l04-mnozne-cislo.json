      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Множина -li",
          "text": "my — robili sme, vy — robili ste, oni / ony — robili. Одна форма -li для всіх родів: «Chlapci hrali», «Dievčatá hrali», «Deti hrali».",
          "examples": [
            {
              "sk": "Boli sme v kine.",
              "uk": "Ми були в кіно."
            },
            {
              "sk": "Deti hrali futbal.",
              "uk": "Діти грали у футбол."
            }
          ],
          "shortRule": "-li — для всіх родів",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vy — ввічливо",
          "text": "«Vy» — це і кілька людей, і ввічлива форма до однієї людини: «Kedy ste prišli na Slovensko?» — коли ви приїхали до Словаччини? Навіть до жінки кажемо «boli ste», «prišli ste».",
          "examples": [
            {
              "sk": "Pani doktorka, kde ste pracovali predtým?",
              "uk": "Пані лікарко, де ви працювали раніше?"
            },
            {
              "sk": "Kedy ste prišli?",
              "uk": "Коли ви прийшли (приїхали)?"
            }
          ],
          "shortRule": "vy + -li + ste",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Переїзд і свято",
          "text": "«Presťahovali sme sa» — ми переїхали (в інше житло, місто, країну). «Oslava» — свято, вечірка; «oslavovať» — святкувати. «Zabavili sme sa» — ми добре розважилися. Зверни увагу: sme стоїть перед sa.",
          "examples": [
            {
              "sk": "Presťahovali sme sa na Slovensko v roku 2022.",
              "uk": "Ми переїхали до Словаччини у 2022 році."
            },
            {
              "sk": "Na oslave sme sa výborne zabavili.",
              "uk": "На святі ми чудово розважилися."
            }
          ],
          "shortRule": "sme + sa",
          "commonMistakes": [
            {
              "mistake": "My sme bol doma.",
              "correct": "Boli sme doma."
            },
            {
              "mistake": "Deti hrala.",
              "correct": "Deti hrali."
            },
            {
              "mistake": "Presťahovali sa sme.",
              "correct": "Presťahovali sme sa."
            }
          ],
          "button": "Далі →"
        }
      ],
