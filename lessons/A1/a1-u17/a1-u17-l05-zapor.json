      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ne- разом із дієсловом",
          "text": "Заперечне «ne-» пишемо разом із формою на -l: nebol som, nerobila som, nekúpili sme. Порівняй: «Nie som doma» (зараз), але «Nebol som doma» (учора).",
          "examples": [
            {
              "sk": "Včera som nebol v práci.",
              "uk": "Учора я не був на роботі."
            },
            {
              "sk": "Nekúpila som chlieb.",
              "uk": "Я не купила хліба."
            }
          ],
          "shortRule": "ne + форма на -l",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Порядок слів",
          "text": "Заперечена форма стоїть там, де звичайна: «Nebol som doma», «Včera som nebol doma». «Som» ніколи не отримує ne-: не «Nesom bol». Із sa: «Neučil som sa» / «Včera som sa neučil». Подвійне заперечення, як в українській: «Nikto neprišiel» — ніхто не прийшов, «Nič som nekúpil» — я нічого не купив.",
          "examples": [
            {
              "sk": "Nikto mi nevolal.",
              "uk": "Ніхто мені не дзвонив."
            }
          ],
          "shortRule": "nikto / nič + ne-",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Чому ні?",
          "text": "«Nestihol som» — не встиг, «Zabudol som» — забув, «Stratila som kľúče» — я загубила ключі, «Nepochopil som» — не зрозумів. «Prepáčte, nestihla som to» — вибачте, я не встигла.",
          "examples": [
            {
              "sk": "Prepáčte, nestihol som autobus.",
              "uk": "Вибачте, я не встиг на автобус."
            }
          ],
          "shortRule": "nestihol som, nepochopil som",
          "commonMistakes": [
            {
              "mistake": "Nie som bol doma.",
              "correct": "Nebol som doma."
            },
            {
              "mistake": "Nesom robil.",
              "correct": "Nerobil som."
            },
            {
              "mistake": "Nikto prišiel.",
              "correct": "Nikto neprišiel."
            }
          ],
          "button": "Далі →"
        }
      ],
