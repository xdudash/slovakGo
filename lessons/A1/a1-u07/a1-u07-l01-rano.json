          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Прокинутися й встати",
          "text": "«Zobudiť sa» — прокинутися, «vstávať / vstať» — вставати. «Budík» — будильник: «Budík zvoní o šiestej».",
          "examples": [
            {
              "sk": "Zobudím sa o šiestej, ale vstávam o pol siedmej.",
              "uk": "Прокидаюся о шостій, а встаю о пів на сьому."
            }
          ],
          "shortRule": "zobudiť sa ≠ vstávať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Сніданок",
          "text": "«Raňajky» — сніданок (лише множина!), «raňajkovať» — снідати. «Na raňajky mám…» — на сніданок у мене…",
          "examples": [
            {
              "sk": "Raňajkujem o siedmej.",
              "uk": "Я снідаю о сьомій."
            },
            {
              "sk": "Na raňajky mám chlieb s maslom.",
              "uk": "На сніданок у мене хліб із маслом."
            }
          ],
          "shortRule": "raňajky — множина",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Одягнутися",
          "text": "«Obliecť sa» — одягнутися (oblečiem sa), «obliekať sa» — одягатися (oblieka sa). Порядок: Najprv… potom… (спочатку… потім…).",
          "examples": [
            {
              "sk": "Najprv sa umyjem, potom sa oblečiem.",
              "uk": "Спочатку вмиюся, потім одягнуся."
            }
          ],
          "shortRule": "najprv → potom",
          "button": "Далі →"
        }
      ],
