      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Najprv — potom — nakoniec",
          "text": "«Najprv» — спочатку, «potom» — потім, «nakoniec» — нарешті, наприкінці. Ще: «najskôr» (найперше), «neskôr» (пізніше).",
          "examples": [
            {
              "sk": "Najprv raňajkujem, potom idem do práce a nakoniec sa vrátim domov.",
              "uk": "Спочатку снідаю, потім іду на роботу, а наприкінці повертаюся додому."
            }
          ],
          "shortRule": "najprv → potom → nakoniec",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Keď — коли",
          "text": "«Keď prídem domov, navarím večeru» — коли прийду додому, приготую вечерю. Кома перед другою частиною обов’язкова.",
          "examples": [
            {
              "sk": "Keď prší, zostávam doma.",
              "uk": "Коли йде дощ, я лишаюся вдома."
            }
          ],
          "shortRule": "Keď…, … (кома!)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Predtým, kým",
          "text": "«Predtým» — перед тим, раніше, «kým» — поки: «Kým varím, deti sa hrajú» — поки я готую, діти граються.",
          "examples": [
            {
              "sk": "Predtým som pracoval v Poľsku.",
              "uk": "Раніше я працював у Польщі."
            },
            {
              "sk": "Kým čakám, čítam.",
              "uk": "Поки чекаю, читаю."
            }
          ],
          "shortRule": "kým = поки",
          "button": "Далі →"
        }
      ],
