          "order": 1,
          "title": "Prestávka",
          "text": "«Prestávka» — перерва: «Mám polhodinovú prestávku». «Ísť na obed» — піти на обід. «Pauza» — розмовно теж перерва.",
          "examples": [
            {
              "sk": "O dvanástej mám prestávku.",
              "uk": "О дванадцятій у мене перерва."
            },
            {
              "sk": "Idem na obed.",
              "uk": "Іду на обід."
            }
          ],
          "shortRule": "prestávka = перерва",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Обід",
          "text": "«Obedovať» — обідати. «Jedáleň» — їдальня (на роботі, у школі), «závodná jedáleň» — заводська їдальня. «Desiata» — другий сніданок (близько 10:00), типовий для шкіл.",
          "examples": [
            {
              "sk": "Obedujeme v jedálni.",
              "uk": "Ми обідаємо в їдальні."
            },
            {
              "sk": "Dieťa si berie desiatu do školy.",
              "uk": "Дитина бере другий сніданок у школу."
            }
          ],
          "shortRule": "desiata — о 10:00",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Stravné lístky",
          "text": "Багато фірм дають «stravné lístky» або «stravné» — талони / гроші на харчування. Ними можна платити в ресторанах і магазинах.",
          "examples": [
            {
              "sk": "Platím stravnými lístkami.",
              "uk": "Я плачу талонами на харчування."
            },
            {
              "sk": "Dostávam stravné na kartu.",
              "uk": "Я отримую харчові на картку."
            }
          ],
          "shortRule": "stravné = харчові",
          "button": "Далі →"
        }
