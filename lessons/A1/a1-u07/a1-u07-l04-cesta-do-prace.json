          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Виходжу з дому",
          "text": "«Odchádzať» — виходити, від’їжджати: «Odchádzam z domu o siedmej». «Cesta trvá…» — дорога займає… «Trvá mi to pol hodiny» — у мене на це йде пів години.",
          "examples": [
            {
              "sk": "Cesta do práce trvá štyridsať minút.",
              "uk": "Дорога на роботу займає 40 хвилин."
            }
          ],
          "shortRule": "odchádzam z domu",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Meškám",
          "text": "«Meškať» — запізнюватися: «Meškám desať minút». «Včas» — вчасно. «Autobus mešká» — автобус запізнюється. Повідомлення шефу: «Prepáčte, meškám kvôli dopravnej zápche».",
          "examples": [
            {
              "sk": "Vlak mešká.",
              "uk": "Поїзд запізнюється."
            },
            {
              "sk": "Prídem včas.",
              "uk": "Я прийду вчасно."
            }
          ],
          "shortRule": "meškať ≠ prísť včas",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Зміни",
          "text": "«Zmena» — зміна: ranná (ранкова), poobedná (післяобідня), nočná (нічна). «Robím na tri zmeny» — працюю в три зміни. «Začínam o šiestej, končím o druhej».",
          "examples": [
            {
              "sk": "Tento týždeň mám nočnú zmenu.",
              "uk": "Цього тижня в мене нічна зміна."
            },
            {
              "sk": "Končím o desiatej večer.",
              "uk": "Закінчую о 22:00."
            }
          ],
          "shortRule": "ranná / poobedná / nočná zmena",
          "button": "Далі →"
        }
