          "order": 1,
          "title": "Cez víkend",
          "text": "«Cez víkend» — на вихідних. «Mám voľno» — я вільний / маю вихідний. «Konečne víkend!» — нарешті вихідні!",
          "examples": [
            {
              "sk": "Cez víkend nepracujem.",
              "uk": "На вихідних я не працюю."
            },
            {
              "sk": "V sobotu mám voľno.",
              "uk": "У суботу я вихідний."
            }
          ],
          "shortRule": "cez víkend = на вихідних",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відпочинок",
          "text": "«Vyspať sa» — виспатися, «ísť na výlet» — поїхати на прогулянку / екскурсію, «ísť na prechádzku» — піти погуляти.",
          "examples": [
            {
              "sk": "V sobotu sa vyspím.",
              "uk": "У суботу я висплюся."
            },
            {
              "sk": "Ideme na výlet do Tatier.",
              "uk": "Їдемо на прогулянку в Татри."
            }
          ],
          "shortRule": "vyspať sa, výlet, prechádzka",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Плани і пропозиції",
          "text": "«Aké máš plány na víkend?» — які плани на вихідні? «Poďme…» — давай(те)…: «Poďme na prechádzku». «Máš chuť…?» — маєш бажання…?",
          "examples": [
            {
              "sk": "Poďme v nedeľu na výlet!",
              "uk": "Поїхали в неділю на прогулянку!"
            },
            {
              "sk": "Máš chuť ísť do kina?",
              "uk": "Хочеш піти в кіно?"
            }
          ],
          "shortRule": "Poďme… = Давайте…",
          "button": "Далі →"
        }
      ],
