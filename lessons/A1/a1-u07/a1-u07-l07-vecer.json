      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Вечеря",
          "text": "«Večera» — вечеря, «večerať» — вечеряти. «Na večeru máme…» — на вечерю в нас… «Kto varí večeru?»",
          "examples": [
            {
              "sk": "Večeriame o siedmej.",
              "uk": "Ми вечеряємо о сьомій."
            },
            {
              "sk": "Na večeru je polievka.",
              "uk": "На вечерю суп."
            }
          ],
          "shortRule": "večera / večerať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відпочинок",
          "text": "«Relaxovať» — відпочивати, розслаблятися, «pozerať seriál» — дивитися серіал, «čítať», «ísť von» — вийти кудись.",
          "examples": [
            {
              "sk": "Večer relaxujem pri seriáli.",
              "uk": "Увечері відпочиваю за серіалом."
            }
          ],
          "shortRule": "relaxovať, seriál",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Сон",
          "text": "«Ísť spať» — іти спати, «zaspať» — заснути (а також «проспати»!). «Nemôžem zaspať» — не можу заснути. «Zaspal som» — я проспав / заснув.",
          "examples": [
            {
              "sk": "Chodím spať o jedenástej.",
              "uk": "Я лягаю спати об одинадцятій."
            },
            {
              "sk": "Rýchlo zaspím.",
              "uk": "Я швидко засинаю."
            }
          ],
          "shortRule": "zaspať = заснути / проспати",
          "button": "Далі →"
        }
      ],
