      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Objednať sa",
          "text": "«Objednať» — замовити (піцу), а «objednať sa» — записатися (до лікаря, до перукаря): «Chcel by som sa objednať k pani doktorke Novákovej». «Máte voľný termín?» — у вас є вільний час? «Najbližší termín je v stredu o deviatej» — найближчий вільний запис у середу о дев’ятій.",
          "examples": [
            {
              "sk": "Chcela by som sa objednať na vyšetrenie.",
              "uk": "Я хотіла б записатися на огляд."
            },
            {
              "sk": "Máte voľný termín tento týždeň?",
              "uk": "У вас є вільний запис цього тижня?"
            }
          ],
          "shortRule": "objednať sa = записатися",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ordinačné hodiny",
          "text": "«Ordinačné hodiny» — години прийому. Часто бачиш: «7:00 – 10:00 akútni pacienti» — пацієнти з гострими станами (без запису), «10:00 – 13:00 objednaní pacienti» — пацієнти за записом. «Ordinovať» — приймати пацієнтів.",
          "examples": [
            {
              "sk": "Pani doktorka ordinuje v pondelok od siedmej.",
              "uk": "Лікарка приймає в понеділок із сьомої."
            },
            {
              "sk": "S akútnymi ťažkosťami príďte ráno.",
              "uk": "З гострими проблемами приходьте зранку."
            }
          ],
          "shortRule": "ordinačné hodiny = години прийому",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Odber krvi a zrušenie",
          "text": "«Odber krvi» — забір крові (аналіз). «Príďte nalačno» — приходьте натщесерце (зранку нічого не їжте). Якщо не можете прийти: «Musím zrušiť termín» — мушу скасувати запис, «Môžem sa preobjednať?» — можу перезаписатися?",
          "examples": [
            {
              "sk": "Na odber krvi príďte nalačno.",
              "uk": "На забір крові приходьте натщесерце."
            },
            {
              "sk": "Prepáčte, musím zrušiť zajtrajší termín.",
              "uk": "Вибачте, мушу скасувати завтрашній запис."
            }
          ],
          "shortRule": "nalačno = натщесерце",
