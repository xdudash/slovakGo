      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ako užívať?",
          "text": "«Užívať» — приймати (ліки). Ти вже знаєш «dvakrát denne, po jedle». Ще: «každých osem hodín» — кожні вісім годин, «pred spaním» — перед сном, «zapiť vodou» — запити водою, «prehltnúť celú» — проковтнути цілою.",
          "examples": [
            {
              "sk": "Užívajte jednu tabletku každých osem hodín.",
              "uk": "Приймайте одну таблетку кожні вісім годин."
            },
            {
              "sk": "Tabletku zapite pohárom vody.",
              "uk": "Запийте таблетку склянкою води."
            }
          ],
          "shortRule": "každých päť / osem / dvanásť hodín",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dávka a antibiotiká",
          "text": "«Dávka» — доза. «Neprekračujte dávku» — не перевищуйте дозу. Антибіотики приймають до кінця: «Užívajte celé balenie» — навіть коли вже краще. З антибіотиками — без алкоголю.",
          "examples": [
            {
              "sk": "Antibiotikum užívajte sedem dní.",
              "uk": "Антибіотик приймайте сім днів."
            },
            {
              "sk": "Neprekračujte odporúčanú dávku.",
              "uk": "Не перевищуйте рекомендовану дозу."
            }
          ],
          "shortRule": "celé balenie = до кінця упаковки",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Alergia",
          "text": "«Som alergický / alergická na…» + знахідний: «na penicilín», «na peľ» (пилок). Лікар питає: «Máte nejaké alergie?» «Vedľajší účinok» — побічна дія: «Ak máte vedľajšie účinky, prestaňte liek užívať a zavolajte lekára».",
          "examples": [
            {
              "sk": "Som alergická na penicilín.",
              "uk": "У мене алергія на пеніцилін."
            },
            {
              "sk": "Máte nejaké alergie?",
              "uk": "У вас є якась алергія?"
            }
          ],
          "shortRule": "alergický na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Užívajte každé osem hodín.",
              "correct": "Užívajte každých osem hodín."
            },
            {
              "mistake": "Som alergický od penicilínu.",
              "correct": "Som alergický na penicilín."
            }
          ],
          "button": "Далі →"
        }
      ],
