      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Rozkazovací spôsob",
          "text": "Лікар говорить із пацієнтом на «vy»: форма на -te. «Pite veľa tekutín» — пийте багато рідини, «Ležte» — лежіть, «Oddychujte» — відпочивайте, «Jedzte ľahké jedlá» — їжте легку їжу. Заперечення — ne- разом: «Nefajčite», «Nechoďte do práce».",
          "examples": [
            {
              "sk": "Pite čaj s citrónom.",
              "uk": "Пийте чай із лимоном."
            },
            {
              "sk": "Nechoďte von, kým máte teplotu.",
              "uk": "Не виходьте надвір, поки маєте температуру."
            }
          ],
          "shortRule": "pite, ležte / nepite, nechoďte",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Musíte, nesmiete, mali by ste",
          "text": "«Musíte ležať» — ви мусите лежати. «Nesmiete fajčiť» — вам не можна палити. «Mali by ste sa šetriť» — вам варто берегти себе (м’яка порада). Увага: «nemusíte» — не обов’язково, а «nesmiete» — заборонено!",
          "examples": [
            {
              "sk": "Nesmiete dvíhať ťažké veci.",
              "uk": "Вам не можна піднімати важкі речі."
            },
            {
              "sk": "Nemusíte prísť zajtra.",
              "uk": "Вам не обов’язково приходити завтра."
            }
          ],
          "shortRule": "nemusíte ≠ nesmiete",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Kontrola",
          "text": "«Kontrola» — повторний огляд: «Príďte na kontrolu o týždeň». «Ak sa to nezlepší, príďte znova» — якщо не покращиться, приходьте знову. «Pokoj na lôžku» — постільний режим.",
          "examples": [
            {
              "sk": "Odporúčam vám pokoj na lôžku.",
              "uk": "Раджу вам постільний режим."
            },
            {
              "sk": "Na kontrolu príďte v piatok.",
              "uk": "На контроль приходьте в п’ятницю."
            }
          ],
          "shortRule": "kontrola = повторний огляд",
          "commonMistakes": [
