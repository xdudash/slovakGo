      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Від голови до ніг",
          "text": "Ти вже знаєш hlava, ruka, noha, brucho, chrbát. Тепер детальніше: «tvár» — обличчя, «hrdlo» — горло, «plece» — плече, «lakeť» — лікоть, «hrudník» — грудна клітка, «žalúdok» — шлунок, «členok» — щиколотка, «koža» — шкіра. Увага: «krk» — це шия, а горло всередині — «hrdlo».",
          "examples": [
            {
              "sk": "Bolí ma hrdlo.",
              "uk": "Болить горло."
            },
            {
              "sk": "Mám suchú kožu.",
              "uk": "У мене суха шкіра."
            }
          ],
          "shortRule": "krk = шия, hrdlo = горло",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Двоє очей, двоє вух",
          "text": "Деякі слова мають неправильну множину: oko → «oči», ucho → «uši». Інші — регулярно: ruka → ruky, noha → nohy, zub → zuby. «Pľúca» (легені) мають лише множину: «Pľúca sú zdravé».",
          "examples": [
            {
              "sk": "Mám modré oči.",
              "uk": "У мене блакитні очі."
            },
            {
              "sk": "Bolia ma uši.",
              "uk": "Болять вуха."
            }
          ],
          "shortRule": "oko → oči, ucho → uši",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ľavý alebo pravý?",
          "text": "«Ľavý» — лівий, «pravý» — правий. Вони узгоджуються з родом: «ľavý lakeť» (ч.), «ľavá ruka» (ж.), «ľavé koleno» (с.). У знахідному відмінку: «Udrel som si pravú ruku» — я вдарив праву руку.",
          "examples": [
            {
              "sk": "Bolí ma pravé koleno.",
              "uk": "Болить праве коліно."
            },
            {
              "sk": "Ľavé oko je červené.",
              "uk": "Ліве око червоне."
            }
          ],
          "shortRule": "ľavý / ľavá / ľavé",
          "commonMistakes": [
            {
              "mistake": "Bolia ma oká.",
              "correct": "Bolia ma oči."
            },
            {
              "mistake": "Bolí ma ľavý ruka.",
              "correct": "Bolí ma ľavá ruka."
            },
            {
              "mistake": "Pľúca je zdravá.",
              "correct": "Pľúca sú zdravé."
            }
          ],
          "button": "Далі →"
        }
      ],
