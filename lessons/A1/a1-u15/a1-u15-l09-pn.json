      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo je PN?",
          "text": "«PN» — práceneschopnosť, лікарняний (розмовно — «péenka»). Його дає лікар: «Dám vám PN na týždeň». Тепер лікар оформлює «ePN» — електронно, паперового бланка вже немає. Але роботодавцю треба повідомити самому й одразу. Кажуть: «Som na PN» — я на лікарняному.",
          "examples": [
            {
              "sk": "Lekár mi dal PN na týždeň.",
              "uk": "Лікар дав мені лікарняний на тиждень."
            },
            {
              "sk": "Som na PN do piatku.",
              "uk": "Я на лікарняному до п’ятниці."
            }
          ],
          "shortRule": "byť na PN",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Oznámiť zamestnávateľovi",
          "text": "«Oznámiť» — повідомити (кому? — давальний). Подзвони або напиши керівникові ще зранку: «Musím vám oznámiť, že som chorý». Якщо ти лише пропустив кілька годин через лікаря, потрібне «potvrdenie o návšteve lekára» — довідка про відвідування лікаря.",
          "examples": [
            {
              "sk": "Musím vám oznámiť, že som chorá.",
              "uk": "Мушу вам повідомити, що я хвора."
            },
            {
              "sk": "Potrebujem potvrdenie o návšteve lekára.",
              "uk": "Мені потрібна довідка про відвідування лікаря."
            }
          ],
          "shortRule": "oznámiť + давальний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Nemocenské a OČR",
          "text": "Перші 10 днів лікарняного платить роботодавець, далі «Sociálna poisťovňa» виплачує «nemocenské». Коли хворіє дитина і ти доглядаєш її вдома — «OČR» (ošetrovanie člena rodiny), виплата — «ošetrovné».",
          "examples": [
            {
              "sk": "Syn je chorý, som na OČR.",
              "uk": "Син хворий, я вдома на догляді (OČR)."
            },
            {
              "sk": "Od jedenásteho dňa platí nemocenské Sociálna poisťovňa.",
              "uk": "З одинадцятого дня лікарняні платить Соціальна страхова."
            }
          ],
          "shortRule": "PN — хворий ти, OČR — хворий член родини",
          "commonMistakes": [
            {
              "mistake": "Som v PN.",
              "correct": "Som na PN."
            },
            {
              "mistake": "Musím oznámiť šéf.",
              "correct": "Musím to oznámiť šéfovi."
            }
          ],
          "button": "Далі →"
        }
