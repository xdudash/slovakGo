      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Prechladnutie a chrípka",
          "text": "«Prechladnutie» — застуда: «Som prechladnutý / prechladnutá». «Chrípka» — грип (висока температура, болить усе тіло). «Nádcha» — нежить, «angína» — ангіна. Конструкція «mať + знахідний»: «Mám chrípku», «Mám nádchu».",
          "examples": [
            {
              "sk": "Syn má angínu.",
              "uk": "У сина ангіна."
            },
            {
              "sk": "Som trochu prechladnutá.",
              "uk": "Я (ж.) трохи застуджена."
            }
          ],
          "shortRule": "mať chrípku, byť prechladnutý",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Dlhodobé choroby",
          "text": "Тривалі (хронічні) хвороби: «vysoký tlak» — високий тиск, «cukrovka» — цукровий діабет, «astma» — астма. Лікареві кажуть: «Mám vysoký tlak», «Liečim sa na cukrovku» — лікуюся від діабету.",
          "examples": [
            {
              "sk": "Otec má vysoký tlak.",
              "uk": "У тата високий тиск."
            },
            {
              "sk": "Mama sa lieči na cukrovku.",
              "uk": "Мама лікується від діабету."
            }
          ],
          "shortRule": "liečiť sa na + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ochorieť",
          "text": "«Ochorieť» — захворіти: «Ochorel som» (ч.), «Ochorela som» (ж.). «Je to nákazlivé?» — це заразно? Хворому бажають: «Rýchlo sa uzdrav!» — швидше одужуй!",
          "examples": [
            {
              "sk": "Celá rodina ochorela na chrípku.",
              "uk": "Уся родина захворіла на грип."
            },
            {
              "sk": "Je to nákazlivé?",
              "uk": "Це заразно?"
            }
          ],
          "shortRule": "ochorieť na + знахідний",
          "commonMistakes": [
            {
              "mistake": "Mám chrípka.",
              "correct": "Mám chrípku."
            },
            {
