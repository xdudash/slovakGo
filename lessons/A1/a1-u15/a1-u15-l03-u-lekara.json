      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "K lekárovi, u lekára",
          "text": "Рух до людини — «k» + давальний: «Idem k lekárovi» (до лікаря), «k zubárovi», «k doktorke». Місце — «u» + родовий: «Som u lekára» (у лікаря). «Všeobecný lekár» — сімейний лікар: спершу йдуть до нього, а до спеціаліста — з направленням («výmenný lístok»).",
          "examples": [
            {
              "sk": "Zajtra idem k lekárovi.",
              "uk": "Завтра я йду до лікаря."
            },
            {
              "sk": "Bola som u zubára.",
              "uk": "Я була в стоматолога."
            }
          ],
          "shortRule": "k + давальний / u + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "V ambulancii",
          "text": "«Ambulancia» — кабінет лікаря, амбулаторія. Медсестра просить «preukaz poistenca» — картку медичного страхування, її показують при кожному візиті. Лікар питає: «Čo vás trápi?» — що вас турбує? «Odkedy máte ťažkosti?» — відколи у вас проблеми?",
          "examples": [
            {
              "sk": "Váš preukaz poistenca, prosím.",
              "uk": "Вашу картку страхування, будь ласка."
            },
            {
              "sk": "Čo vás trápi?",
              "uk": "Що вас турбує?"
            }
          ],
          "shortRule": "preukaz poistenca = картка медичного страхування",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pokyny lekára",
          "text": "Лікар говорить наказовим способом на «vy»: «Vyzlečte sa do pása» — роздягніться до пояса. «Dýchajte zhlboka» — дихайте глибоко. «Nedýchajte» — не дихайте. «Otvorte ústa» — відкрийте рот. «Ľahnite si» — ляжте. «Oblečte sa» — одягніться.",
          "examples": [
            {
              "sk": "Otvorte ústa a povedzte „á“.",
              "uk": "Відкрийте рот і скажіть «а»."
            }
          ],
          "shortRule": "vyzlečte sa, dýchajte, ľahnite si",
          "commonMistakes": [
            {
              "mistake": "Idem u lekára.",
              "correct": "Idem k lekárovi."
            },
            {
              "mistake": "Som k lekárovi.",
              "correct": "Som u lekára."
            }
          ],
          "button": "Далі →"
        }
      ],
