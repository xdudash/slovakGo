      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Koho to bolí?",
          "text": "«Bolí ma» — мене болить. Інші особи: ťa (тебе), ho (його), ju (її), nás, vás, ich. З іменем — знахідний відмінок: «Syna bolí ucho», «Mamu bolí hlava». Питання: «Čo ťa bolí?» — що в тебе болить?",
          "examples": [
            {
              "sk": "Bolí ho zub.",
              "uk": "У нього болить зуб."
            },
            {
              "sk": "Dcéru bolí brucho.",
              "uk": "У доньки болить живіт."
            }
          ],
          "shortRule": "ma, ťa, ho, ju, nás, vás, ich",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Odkedy a ako veľmi?",
          "text": "Відколи: «od včera» — з учора, «od rána» — із ранку, «už tri dni» — уже три дні. Як сильно: «trochu» — трохи, «veľmi» — дуже, «strašne» — страшенно. Іменник «bolesť» — біль: «Mám silné bolesti» — у мене сильний біль.",
          "examples": [
            {
              "sk": "Bolí ma to od rána.",
              "uk": "Болить із ранку."
            },
            {
              "sk": "Hlava ma bolí už dva dni.",
              "uk": "Голова болить уже два дні."
            }
          ],
          "shortRule": "od včera, už … dni",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Iné pocity",
          "text": "«Pichá ma v boku» — колить у боці. «Svrbí ma ruka» — свербить рука. «Točí sa mi hlava» — паморочиться в голові. «Mám opuchnutú nohu» — у мене набрякла нога. «Závrat» — запаморочення.",
          "examples": [
            {
              "sk": "Svrbí ma koža.",
              "uk": "Свербить шкіра."
            },
            {
              "sk": "Točí sa mi hlava.",
              "uk": "У мене паморочиться в голові."
            }
          ],
          "shortRule": "pichá ma, svrbí ma, točí sa mi",
          "commonMistakes": [
            {
              "mistake": "Syn bolí ucho.",
              "correct": "Syna bolí ucho."
            },
            {
              "mistake": "Bolí mi hlava.",
              "correct": "Bolí ma hlava."
            },
            {
              "mistake": "Točí ma hlava.",
              "correct": "Točí sa mi hlava."
            }
          ],
          "button": "Далі →"
        }
      ],
