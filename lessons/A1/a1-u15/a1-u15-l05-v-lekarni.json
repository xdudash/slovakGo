      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Forma lieku",
          "text": "Ти вже знаєш tabletka, sirup, náplasť. Ще: «masť» — мазь, «kvapky» — краплі («kvapky do nosa / do očí / do uší»), «sprej» — спрей, «pastilky» — льодяники (від горла).",
          "examples": [
            {
              "sk": "Potrebujem kvapky do nosa.",
              "uk": "Мені потрібні краплі в ніс."
            },
            {
              "sk": "Máte masť na bolesť chrbta?",
              "uk": "У вас є мазь від болю в спині?"
            }
          ],
          "shortRule": "kvapky do + родовий",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Recept a doplatok",
          "text": "«Voľnopredajný liek» — ліки без рецепта, а «na predpis» — за рецептом. Лікар зазвичай виписує «eRecept» — в аптеці достатньо показати картку страхування. Частину ціни платить страхова, а ти платиш «doplatok» — доплату.",
          "examples": [
            {
              "sk": "Máte eRecept?",
              "uk": "У вас е-рецепт?"
            },
            {
              "sk": "Doplatok je dve eurá.",
              "uk": "Доплата — два євро."
            }
          ],
          "shortRule": "na predpis / voľnopredajný",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Poradiť sa",
          "text": "Фармацевт — «lekárnik / lekárnička». Можна спитати: «Čo mi odporúčate na…?» — що порадите від…? «Je to vhodné pre deti?» — це підходить дітям? «Príbalový leták» — інструкція в упаковці.",
          "examples": [
            {
              "sk": "Čo mi odporúčate na nádchu?",
              "uk": "Що порадите від нежиті?"
            },
            {
              "sk": "Prečítajte si príbalový leták.",
              "uk": "Прочитайте інструкцію."
            }
          ],
          "shortRule": "Čo mi odporúčate na…?",
          "button": "Далі →"
        }
      ],
