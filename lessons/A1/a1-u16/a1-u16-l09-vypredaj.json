      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Percentá",
          "text": "«Výpredaj» і «zľava» ти вже знаєш. Знижку дають у відсотках — «percento». 1 — percento, 2–4 — percentá, 5 і більше — percent: «zľava dvadsať percent» (–20 %). «O 30 % lacnejšie» — на 30 % дешевше.",
          "examples": [
            {
              "sk": "Všetko je so zľavou 50 %.",
              "uk": "Усе зі знижкою 50 %."
            },
            {
              "sk": "Kabáty sú o 30 % lacnejšie.",
              "uk": "Пальта на 30 % дешевші."
            }
          ],
          "shortRule": "1 percento, 3 percentá, 20 percent",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pôvodná a znížená cena",
          "text": "На цінниках: «pôvodná cena» — початкова ціна (часто закреслена), «znížená cena» — знижена ціна. «Za polovicu ceny» — за півціни. «Druhý kus za polovicu ceny» — друга річ за півціни.",
          "examples": [
            {
              "sk": "Pôvodná cena: 60 €, teraz: 42 €.",
              "uk": "Початкова ціна 60 €, тепер 42 €."
            }
          ],
          "shortRule": "pôvodná → znížená",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Posledné kusy",
          "text": "«Posledné kusy!» — останні речі, залишилося мало. «Platí zľava aj na…?» — знижка діє і на…? «Zľava sa odpočíta pri pokladni» — знижку віднімуть на касі.",
          "examples": [
            {
              "sk": "Platí zľava aj na obuv?",
              "uk": "Знижка діє і на взуття?"
            },
            {
              "sk": "Zľava sa odpočíta pri pokladni.",
              "uk": "Знижку віднімуть на касі."
            }
