      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Akú veľkosť nosíte?",
          "text": "«Veľkosť» — розмір. Літерні розміри: S, M, L, XL. Числові: 38, 40, 42 — «Nosím štyridsaťdva». Продавець питає: «Akú veľkosť nosíte?» — який розмір ви носите?",
          "examples": [
            {
              "sk": "Nosím veľkosť M.",
              "uk": "Я ношу розмір M."
            },
            {
              "sk": "Máte to vo veľkosti L?",
              "uk": "У вас є це в розмірі L?"
            }
          ],
          "shortRule": "veľkosť S, M, L, XL",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Je mi to malé",
          "text": "Як сидить річ: «Je mi to malé / veľké» — мені це мале / велике. «Tesný» — тісний, «voľný» — вільний, «široký» — широкий, «úzky» — вузький. Прикметник узгоджується з річчю: «Košeľa je mi tesná», «Nohavice sú mi úzke».",
          "examples": [
            {
              "sk": "Sveter je mi veľký.",
              "uk": "Светр мені великий."
            },
            {
              "sk": "Tie nohavice sú mi široké.",
              "uk": "Ці штани мені широкі."
            }
          ],
          "shortRule": "mi = мені",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Väčšia alebo menšia?",
          "text": "«Väčší» — більший, «menší» — менший: «Potrebujem väčšiu veľkosť» — мені потрібен більший розмір. Дуже часто кажуть: «Máte to o číslo väčšie?» — у вас є це на розмір більше?",
          "examples": [
            {
              "sk": "Máte menšiu veľkosť?",
              "uk": "У вас є менший розмір?"
            },
            {
              "sk": "Dajte mi o číslo menšie.",
              "uk": "Дайте мені на розмір менше."
            }
          ],
          "shortRule": "väčší / menší",
