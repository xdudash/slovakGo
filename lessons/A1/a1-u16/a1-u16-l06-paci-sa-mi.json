      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Páči sa mi",
          "text": "«Páčiť sa» — подобатися. Як в українській: те, що подобається, — підмет, а той, кому подобається, — у давальному. «Páči sa mi tá sukňa» — мені подобається ця спідниця. Множина: «Páčia sa mi tie nohavice». Заперечення: «Nepáči sa mi».",
          "examples": [
            {
              "sk": "Páči sa mi tvoja košeľa.",
              "uk": "Мені подобається твоя сорочка."
            },
            {
              "sk": "Tie šaty sa mi nepáčia.",
              "uk": "Ця сукня мені не подобається."
            }
          ],
          "shortRule": "páči sa (одне) / páčia sa (множина)",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Komu?",
          "text": "mi — мені, ti — тобі, mu — йому, jej — їй, nám — нам, vám — вам, im — їм. Питання: «Páči sa ti to?» — тобі подобається? «Ako sa ti páči…?» — як тобі…? З наголосом: «Mne sa to páči» — а мені подобається.",
          "examples": [
            {
              "sk": "Páči sa jej tá farba.",
              "uk": "Їй подобається цей колір."
            },
            {
              "sk": "Ako sa vám páči tento kabát?",
              "uk": "Як вам це пальто?"
            }
          ],
          "shortRule": "mi, ti, mu, jej, nám, vám, im",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Чому подобається?",
          "text": "«Pohodlný» — зручний, «elegantný» — елегантний, «módny» — модний, «štýl» — стиль, «vkus» — смак: «Máš dobrý vkus!» — у тебе гарний смак! Páčiť sa — враження від конкретної речі, mať rád — любити загалом: «Mám rád pohodlné oblečenie».",
          "examples": [
            {
              "sk": "Tieto nohavice sú veľmi pohodlné.",
              "uk": "Ці штани дуже зручні."
            },
            {
              "sk": "Máš pekný štýl.",
              "uk": "У тебе гарний стиль."
            }
          ],
          "shortRule": "pohodlný, elegantný, módny",
          "commonMistakes": [
            {
              "mistake": "Ja páčim tá sukňa.",
              "correct": "Páči sa mi tá sukňa."
            },
            {
              "mistake": "Páči sa mi tie nohavice.",
              "correct": "Páčia sa mi tie nohavice."
            },
            {
              "mistake": "Páči sa ma to.",
              "correct": "Páči sa mi to."
            }
          ],
          "button": "Далі →"
        }
      ],
