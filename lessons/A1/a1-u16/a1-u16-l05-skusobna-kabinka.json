      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Môžem si to vyskúšať?",
          "text": "«Vyskúšať si» — приміряти: «Môžem si vyskúšať tieto nohavice?» «Si» стоїть одразу після першого слова: «Môžem si…». «Skúšobná kabínka» (або просто «kabínka») — примірювальна кабінка. Часто є правило: «Maximálne tri kusy» — максимум три речі.",
          "examples": [
            {
              "sk": "Kde sú skúšobné kabínky?",
              "uk": "Де примірювальні кабінки?"
            },
            {
              "sk": "Môžem si to vyskúšať?",
              "uk": "Можна це приміряти?"
            }
          ],
          "shortRule": "Môžem si + vyskúšať",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Sedí? Pristane?",
          "text": "«Sedí mi to» — мені це добре сидить. «Nesedí mi to» — погано сидить. Про кілька речей — «sedia». «Pristane ti to» — тобі це личить: «Tá farba ti pristane». Продавчиня може спитати: «Ako vám to sedí?»",
          "examples": [
            {
              "sk": "Sveter mi sedí perfektne.",
              "uk": "Светр сидить на мені ідеально."
            },
            {
              "sk": "Tá košeľa ti veľmi pristane.",
              "uk": "Ця сорочка тобі дуже личить."
            }
          ],
          "shortRule": "sedí / sedia / pristane + mi, ti, vám",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Деталі",
          "text": "«Rukáv» — рукав: «Rukávy sú dlhé». «Zips» — блискавка (застібка), «gombík» — ґудзик: «Chýba tu gombík» — тут бракує ґудзика. «Zips nejde» — блискавка не застібається.",
          "examples": [
            {
              "sk": "Rukávy sú mi krátke.",
              "uk": "Рукави мені короткі."
            },
            {
              "sk": "Na kabáte chýba gombík.",
              "uk": "На пальті бракує ґудзика."
            }
          ],
          "shortRule": "rukáv, zips, gombík",
          "commonMistakes": [
            {
              "mistake": "Môžem vyskúšať si?",
              "correct": "Môžem si to vyskúšať?"
            },
            {
              "mistake": "Sedí ma to.",
              "correct": "Sedí mi to."
            },
            {
              "mistake": "Tá farba ti pristaneš.",
              "correct": "Tá farba ti pristane."
            }
          ],
          "button": "Далі →"
        }
