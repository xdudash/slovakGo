      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ще кольори",
          "text": "Ти вже знаєш biely, čierny, červený, modrý, zelený, žltý. Нові: «sivý» — сірий, «hnedý» — коричневий, «ružový» — рожевий, «béžový» — бежевий. Колір — прикметник, тому узгоджується з річчю: hnedý kabát, hnedá sukňa, hnedé tričko, hnedé nohavice.",
          "examples": [
            {
              "sk": "Mám sivý sveter.",
              "uk": "У мене сірий светр."
            },
            {
              "sk": "Kúpila som ružové šaty.",
              "uk": "Я купила рожеву сукню."
            }
          ],
          "shortRule": "-ý / -á / -é",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Tmavo- і svetlo-",
          "text": "«Tmavomodrý» — темно-синій, «svetlomodrý» — блакитний, світло-синій. Пишеться разом: «tmavosivá bunda», «svetlohnedé nohavice». Питання: «Akú farbu hľadáte?» — якого кольору шукаєте?",
          "examples": [
            {
              "sk": "Hľadám tmavomodrú košeľu.",
              "uk": "Я шукаю темно-синю сорочку."
            }
          ],
          "shortRule": "tmavo- / svetlo- + колір (разом)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Z čoho je to?",
          "text": "Матеріал: «bavlna» (бавовна) → «bavlnený», «vlna» (вовна) → «vlnený», «koža» (шкіра) → «kožený». Можна й так: «Sveter je z vlny» — светр із вовни (z + родовий). На етикетці: «100 % bavlna».",
          "examples": [
            {
              "sk": "Vlnený sveter je teplý.",
              "uk": "Вовняний светр теплий."
            },
            {
              "sk": "Bunda je z kože.",
              "uk": "Куртка зі шкіри."
            }
          ],
          "shortRule": "bavlna → bavlnený; z + родовий",
          "commonMistakes": [
            {
              "mistake": "hnedý sukňa",
              "correct": "hnedá sukňa"
            },
            {
              "mistake": "tmavo modrý",
              "correct": "tmavomodrý"
            },
            {
              "mistake": "sveter z vlna",
              "correct": "sveter z vlny"
            }
          ],
          "button": "Далі →"
        }
      ],
