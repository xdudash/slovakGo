      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Môžem vám pomôcť?",
          "text": "Продавець часто питає: «Môžem vám nejako pomôcť?» — можу вам якось допомогти? Відповіді: «Áno, hľadám…» — так, шукаю… або «Ďakujem, len sa pozerám» — дякую, я тільки дивлюся. «Predajňa» — магазин (трохи офіційніше, ніж obchod).",
          "examples": [
            {
              "sk": "Hľadám čiernu sukňu.",
              "uk": "Я шукаю чорну спідницю."
            },
            {
              "sk": "Ďakujem, len sa pozerám.",
              "uk": "Дякую, я просто дивлюся."
            }
          ],
          "shortRule": "Hľadám + знахідний",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Відділи й поверхи",
          "text": "«Dámske oblečenie» — жіночий одяг, «pánske» — чоловічий, «detské» — дитячий. «Kde je pánske oddelenie?» — де чоловічий відділ? «Na prízemí» — на першому поверсі, «na prvom poschodí» — на другому (за українським рахунком).",
          "examples": [
            {
              "sk": "Dámske oddelenie je na prvom poschodí.",
              "uk": "Жіночий відділ на другому поверсі."
            }
          ],
          "shortRule": "prízemie = 1-й поверх, 1. poschodie = 2-й поверх",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Máte to aj…?",
          "text": "«Máte to aj v inej farbe?» — у вас це є і в іншому кольорі? «…aj vo veľkosti M?» — і в розмірі M? «Tento model» — ця модель. «Môžete mi poradiť?» — можете мені порадити?",
          "examples": [
            {
              "sk": "Tento model máme aj v čiernej.",
              "uk": "Ця модель у нас є і в чорному."
            },
            {
              "sk": "Poradíte mi?",
              "uk": "Порадите мені?"
            }
          ],
          "shortRule": "v inej farbe, vo veľkosti…",
          "button": "Далі →"
        }
      ],
