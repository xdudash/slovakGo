      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Що ми носимо?",
          "text": "«Oblečenie» — одяг. Верх: «tričko» (футболка), «košeľa» (сорочка), «sveter» (светр), «kabát» (пальто). Низ: «nohavice» (штани), «sukňa» (спідниця). Увага: «sukňa» звучить як українська «сукня», але це спідниця! Сукня — «šaty». Куртку «bunda» ти вже знаєш.",
          "examples": [
            {
              "sk": "Na leto potrebujem nové tričko.",
              "uk": "На літо мені потрібна нова футболка."
            },
            {
              "sk": "Sveter je v skrini.",
              "uk": "Светр у шафі."
            }
          ],
          "shortRule": "sukňa = спідниця, šaty = сукня",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Лише множина",
          "text": "«Nohavice» і «šaty» — тільки множина, навіть коли це одна річ: «Tie nohavice sú nové» — ці штани нові. «Tie šaty sú krásne» — ця сукня гарна. Так само «rifle» — джинси.",
          "examples": [
            {
              "sk": "Kde sú moje šaty?",
              "uk": "Де моя сукня?"
            },
            {
              "sk": "Nohavice sú krátke.",
              "uk": "Штани короткі."
            }
          ],
          "shortRule": "nohavice, šaty, rifle + sú",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Mám na sebe…",
          "text": "«Mám na sebe sveter» — на мені светр. «Obliecť si» — вдягнути щось: «Oblečiem si kabát». «Vyzliecť si» — зняти: «Vyzlečte si kabát». Річ стоїть у знахідному відмінку: sukňa → sukňu, košeľa → košeľu.",
          "examples": [
            {
              "sk": "Dnes mám na sebe modrú košeľu.",
              "uk": "Сьогодні на мені синя сорочка."
            },
            {
              "sk": "Obleč si sveter, je zima.",
              "uk": "Вдягни светр, холодно."
            }
          ],
          "shortRule": "mám na sebe + знахідний",
          "commonMistakes": [
            {
              "mistake": "Nohavice je nová.",
              "correct": "Nohavice sú nové."
            },
            {
              "mistake": "Mám na sebe košeľa.",
              "correct": "Mám na sebe košeľu."
            },
            {
              "mistake": "Moje šaty je pekná.",
              "correct": "Moje šaty sú pekné."
            }
          ],
          "button": "Далі →"
        }
