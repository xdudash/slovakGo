      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Obuv",
          "text": "«Obuv» — взуття (загальне слово, як на вивісці магазину). «Topánky» — черевики, туфлі, «tenisky» — кросівки, «čižmy» — чоботи, «sandále» — сандалі, «papuče» — капці. Зазвичай вони в множині: «Tie tenisky sú nové».",
          "examples": [
            {
              "sk": "Potrebujem nové čižmy na zimu.",
              "uk": "Мені потрібні нові чоботи на зиму."
            },
            {
              "sk": "Tenisky sú v akcii.",
              "uk": "Кросівки за акцією."
            }
          ],
          "shortRule": "obuv — загальне слово; topánky — множина",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Aké číslo?",
          "text": "Розмір взуття — «číslo»: «Aké číslo nosíte?» — який розмір взуття ви носите? «Nosím tridsaťosem» — ношу 38. Якщо тисне: «Tlačia ma» — мені тиснуть.",
          "examples": [
            {
              "sk": "Máte tieto tenisky v čísle 42?",
              "uk": "У вас є ці кросівки 42-го розміру?"
            },
            {
              "sk": "Topánky ma tlačia.",
              "uk": "Черевики мені тиснуть."
            }
          ],
          "shortRule": "číslo (взуття), veľkosť (одяг)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Vyzujte sa!",
          "text": "У словацьких домівках узуття знімають у передпокої: «Vyzujte sa, prosím» — роззуйтеся, будь ласка. Господарі часто дають «papuče». Протилежне — «obuť sa» / «obuť si»: «Obuj si čižmy» — взуй чоботи.",
          "examples": [
            {
              "sk": "Mám sa vyzuť?",
              "uk": "Мені роззутися?"
            },
            {
              "sk": "Tu máš papuče.",
              "uk": "Ось тобі капці."
            }
          ],
          "shortRule": "vyzuť sa ↔ obuť sa",
