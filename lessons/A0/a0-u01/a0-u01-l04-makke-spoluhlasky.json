      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Чотири м’які звуки",
          "text": "Mäkčeň над d, t, n, l робить їх м’якими: ď = «дь», ť = «ть», ň = «нь», ľ = «ль». Над малими ď, ť, ľ гачок виглядає як апостроф — це та сама позначка.",
          "examples": [
            {
              "sk": "deň",
              "uk": "день"
            },
            {
              "sk": "kôň",
              "uk": "кінь"
            },
            {
              "sk": "ľudia",
              "uk": "люди"
            }
          ],
          "shortRule": "ď = дь, ť = ть, ň = нь, ľ = ль",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Правило м’якості",
          "text": "Перед e та i приголосні d, t, n, l читаються м’яко, хоча гачка немає: de = «дє», te = «тє», ne = «нє», le = «лє», di = «ді», ti = «ті», ni = «ні», li = «лі». Перед y — тверді: ty — це тверде «т» + «і».",
          "examples": [
            {
              "sk": "deti",
              "uk": "діти"
            },
            {
              "sk": "teplo",
              "uk": "тепло"
            },
            {
              "sk": "leto",
              "uk": "літо"
            },
            {
              "sk": "nie",
              "uk": "ні"
            }
          ],
          "shortRule": "de, te, ne, le, di, ti, ni, li — м’яко; dy, ty, ny, ly — твердо.",
          "commonMistakes": [
            {
              "mistake": "deti як «деті» (твердо)",
              "correct": "deti = «дєті» (м’яко)"
            },
            {
              "mistake": "leto як «лето» (твердо)",
              "correct": "leto = «лєто» (м’яко)"
            }
          ],
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Винятки, які варто знати",
          "text": "Кілька частих слів — винятки й читаються твердо: ten, jeden, teda, vtedy. А в запозиченнях теж твердо: telefón, diéta, moderný. Спочатку просто запам’ятай ten і jeden.",
          "examples": [
            {
              "sk": "ten muž",
              "uk": "той чоловік"
            },
            {
              "sk": "jeden deň",
              "uk": "один день"
            },
            {
              "sk": "telefón",
              "uk": "телефон"
            }
          ],
          "shortRule": "Винятки: ten, jeden, telefón — твердо.",
          "button": "Далі →"
        }
      ],
