      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Tykanie і vykanie",
          "text": "Як і в українській, у словацькій є «ти» (ty) і ввічливе «ви» (vy). Tykanie — звертання на «ти», vykanie — на «ви». До незнайомих дорослих, у магазині, в офісі — завжди «vy».",
          "examples": [
            {
              "sk": "Ako sa máš?",
              "uk": "Як справи? (ти)"
            },
            {
              "sk": "Ako sa máte?",
              "uk": "Як справи? (ви)"
            }
          ],
          "shortRule": "Незнайомий дорослий = vykanie.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Pán, pani, slečna",
          "text": "Звертання: pán + прізвище (pán Novák), pani + прізвище (pani Nováková). До лікаря: pán doktor / pani doktorka. «Slečna» (панночка) звучить застаріло — краще «pani». Ім’я без pán/pani — лише на «ти».",
          "examples": [
            {
              "sk": "Dobrý deň, pán Horváth.",
              "uk": "Добрий день, пане Горвате."
            },
            {
              "sk": "Pani doktorka, mám otázku.",
              "uk": "Пані лікарко, у мене питання."
            }
          ],
          "shortRule": "pán / pani + прізвище або посада.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Перехід на «ти»",
          "text": "Перейти на «ти» пропонує старший або жінка: «Môžeme si tykať?» (Можемо на «ти»?). Відповідь: «Jasné, som Jana» / «Samozrejme». Колеги часто одразу на «ти».",
          "examples": [
            {
              "sk": "Môžeme si tykať?",
              "uk": "Можемо на «ти»?"
            },
            {
              "sk": "Kľudne mi tykaj.",
              "uk": "Можеш звертатися до мене на «ти»."
            }
          ],
          "shortRule": "Пропонує старший — не ти.",
          "commonMistakes": [
            {
              "mistake": "Dobrý deň, Nováková!",
              "correct": "Dobrý deň, pani Nováková!"
            },
            {
              "mistake": "Pán Peter, ako sa máte?",
              "correct": "Pán Novák, ako sa máte?"
            }
          ],
          "button": "Далі →"
        }
      ],
