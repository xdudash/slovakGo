      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Dobrý deň — універсальне ввічливе привітання",
          "text": "«Dobrý deň» кажуть у магазині, в офісі, лікарю, сусідам старшого віку, будь-кому незнайомому. Воно підходить із ранку до вечора. У розмові часто звучить скорочено: «Dobrý» або «Dobrý deň prajem».",
          "examples": [
            {
              "sk": "Dobrý deň!",
              "uk": "Добрий день!"
            },
            {
              "sk": "Dobrý deň prajem.",
              "uk": "Бажаю доброго дня (дуже ввічливо)."
            }
          ],
          "shortRule": "З незнайомими — завжди Dobrý deň.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Ahoj і Čau — для своїх",
          "text": "«Ahoj» — привітання з друзями, родиною, дітьми, колегами, з якими ви на «ти». Цікаво: ahoj означає і «привіт», і «бувай»! «Čau» — ще неформальніше. Групі людей кажуть «Ahojte» або «Čaute».",
          "examples": [
            {
              "sk": "Ahoj, Peter!",
              "uk": "Привіт, Петре!"
            },
            {
              "sk": "Čau!",
              "uk": "Привіт! / Бувай!"
            },
            {
              "sk": "Ahojte!",
              "uk": "Привіт усім!"
            }
          ],
          "shortRule": "Ahoj = привіт і бувай.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Не помились із реєстром",
          "text": "Сказати «Ahoj» продавчині чи лікарю — нечемно. А «Dobrý deň» близькому другові — дивно й холодно. Якщо сумніваєшся — обирай «Dobrý deň».",
          "examples": [
            {
              "sk": "Pani predavačka: Dobrý deň.",
              "uk": "Продавчині: Добрий день."
            },
            {
              "sk": "Kamarátovi: Ahoj!",
              "uk": "Другові: Привіт!"
            }
          ],
          "shortRule": "Сумнів → Dobrý deň.",
          "commonMistakes": [
            {
              "mistake": "Ahoj! (до лікаря)",
              "correct": "Dobrý deň!"
            },
            {
              "mistake": "Dobrý deň! (до найкращого друга)",
              "correct": "Ahoj!"
            }
          ],
          "button": "Далі →"
        }
      ],
