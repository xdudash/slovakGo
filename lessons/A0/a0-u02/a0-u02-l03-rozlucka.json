      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Dovidenia — офіційне прощання",
          "text": "«Dovidenia» (до побачення) — пара до «Dobrý deň». Його кажуть у магазині, на пошті, у лікаря. Дуже часто звучить скоро: «Dovi». По телефону іноді кажуть «Dopočutia» (до почуття).",
          "examples": [
            {
              "sk": "Dovidenia!",
              "uk": "До побачення!"
            },
            {
              "sk": "Ďakujem, dovidenia.",
              "uk": "Дякую, до побачення."
            },
            {
              "sk": "Dopočutia!",
              "uk": "До почуття (по телефону)."
            }
          ],
          "shortRule": "Dobrý deň → Dovidenia.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Прощання з друзями",
          "text": "З друзями кажуть «Ahoj», «Čau» або «Maj sa» (бувай, щасти). Кільком людям — «Majte sa». «Zatiaľ» — поки! «Vidíme sa» — побачимось.",
          "examples": [
            {
              "sk": "Maj sa!",
              "uk": "Бувай!"
            },
            {
              "sk": "Majte sa!",
              "uk": "Бувайте!"
            },
            {
              "sk": "Zatiaľ!",
              "uk": "Поки!"
            },
            {
              "sk": "Vidíme sa zajtra.",
              "uk": "Побачимось завтра."
            }
          ],
          "shortRule": "Maj sa (ти) — Majte sa (ви, кілька людей).",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як відповісти",
          "text": "На «Maj sa» відповідають «Aj ty» (і ти). На «Majte sa» — «Aj vy». На «Dovidenia» — «Dovidenia».",
          "examples": [
            {
              "sk": "Maj sa! — Aj ty!",
              "uk": "Бувай! — І ти!"
            },
            {
              "sk": "Dovidenia! — Dovidenia!",
              "uk": "До побачення! — До побачення!"
            }
          ],
          "shortRule": "Maj sa — Aj ty; Majte sa — Aj vy.",
          "button": "Далі →"
        }
      ],
