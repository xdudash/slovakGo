      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Nerozumiem",
          "text": "«Nerozumiem» — я не розумію. «Rozumiete?» — ви розумієте? Чоловік може сказати «Nerozumel som», жінка — «Nerozumela som» (я не зрозумів / не зрозуміла).",
          "examples": [
            {
              "sk": "Prepáčte, nerozumiem.",
              "uk": "Вибачте, я не розумію."
            },
            {
              "sk": "Rozumiete po slovensky?",
              "uk": "Ви розумієте словацькою?"
            }
          ],
          "shortRule": "Чесно кажи Nerozumiem — це нормально.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Повільніше, ще раз",
          "text": "«Pomalšie, prosím» — повільніше, будь ласка. «Ešte raz, prosím» — ще раз, будь ласка. «Môžete to zopakovať?» — можете повторити?",
          "examples": [
            {
              "sk": "Hovorte pomalšie, prosím.",
              "uk": "Говоріть повільніше, будь ласка."
            },
            {
              "sk": "Môžete to zopakovať?",
              "uk": "Можете повторити?"
            }
          ],
          "shortRule": "Pomalšie / Ešte raz / Zopakovať.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Значення і переклад",
          "text": "«Čo to znamená?» — що це означає? «Ako sa povie po slovensky…?» — як сказати словацькою…? «Hovoríte po anglicky / po ukrajinsky?» — ви говорите англійською / українською?",
          "examples": [
            {
              "sk": "Čo znamená „pokladňa“?",
              "uk": "Що означає «pokladňa»?"
            },
            {
              "sk": "Ako sa povie po slovensky „ліки“?",
              "uk": "Як словацькою «ліки»?"
            }
          ],
          "shortRule": "Čo to znamená? / Ako sa povie…?",
          "button": "Далі →"
        }
      ],
