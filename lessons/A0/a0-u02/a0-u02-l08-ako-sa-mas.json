      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Як запитати",
          "text": "«Ako sa máš?» (ти) / «Ako sa máte?» (ви). Розмовно: «Ako sa darí?» (як ведеться?), «Čo nové?» (що нового?). Це не завжди справжнє запитання — часто просто частина привітання.",
          "examples": [
            {
              "sk": "Ako sa darí?",
              "uk": "Як ведеться?"
            },
            {
              "sk": "Čo nové?",
              "uk": "Що нового?"
            }
          ],
          "shortRule": "Ako sa máš? — частина привітання.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як відповісти",
          "text": "Шкала: výborne (чудово) → dobre (добре) → ujde to (так собі, нормально) → nič moc (не дуже) → zle (погано). Потім поверни питання: «A ty?» / «A vy?».",
          "examples": [
            {
              "sk": "Mám sa dobre, ďakujem. A vy?",
              "uk": "Добре, дякую. А ви?"
            },
            {
              "sk": "Ujde to.",
              "uk": "Так собі."
            },
            {
              "sk": "Nič moc, som unavený.",
              "uk": "Не дуже, я втомлений."
            }
          ],
          "shortRule": "Відповідь + ďakujem + A ty / A vy?",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Співчуття і радість",
          "text": "Якщо людина каже «zle», ввічливо відповісти «To ma mrzí» (мені шкода). Якщо «výborne» — «To som rád / rada» (я радий / рада). Rád — каже чоловік, rada — жінка.",
          "examples": [
            {
              "sk": "To ma mrzí.",
              "uk": "Мені шкода."
            },
            {
              "sk": "To som rada!",
              "uk": "Я рада!"
            }
          ],
          "shortRule": "rád (чол.) / rada (жін.)",
          "button": "Далі →"
        }
      ],
