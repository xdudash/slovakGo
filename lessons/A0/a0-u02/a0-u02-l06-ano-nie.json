      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Áno, nie, hej",
          "text": "«Áno» — так, «nie» — ні. У розмовній мові дуже часто кажуть «hej» (так). Увага: «nie» читається як «ніє», а не «не»!",
          "examples": [
            {
              "sk": "Áno, som tu.",
              "uk": "Так, я тут."
            },
            {
              "sk": "Nie, nemám čas.",
              "uk": "Ні, я не маю часу."
            },
            {
              "sk": "Hej, jasné.",
              "uk": "Так, звісно."
            }
          ],
          "shortRule": "áno = hej (розмовно).",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Погодитися",
          "text": "«Dobre» — добре, гаразд. «V poriadku» — у порядку, гаразд. «Samozrejme» — звичайно. «Jasné» — зрозуміло, звісно (розмовне).",
          "examples": [
            {
              "sk": "Príďte o desiatej. — Dobre.",
              "uk": "Приходьте о десятій. — Гаразд."
            },
            {
              "sk": "Môžem? — Samozrejme.",
              "uk": "Можна? — Звичайно."
            }
          ],
          "shortRule": "dobre / v poriadku / samozrejme",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Відмовитися ввічливо",
          "text": "Відмова без подяки звучить різко. Кажи «Nie, ďakujem» (ні, дякую). Якщо не впевнений — «Možno» (можливо) або «Neviem» (не знаю).",
          "examples": [
            {
              "sk": "Dáte si kávu? — Nie, ďakujem.",
              "uk": "Будете каву? — Ні, дякую."
            },
            {
              "sk": "Prídeš? — Možno.",
              "uk": "Прийдеш? — Можливо."
            }
          ],
          "shortRule": "Nie, ďakujem — ввічлива відмова.",
          "button": "Далі →"
        }
      ],
