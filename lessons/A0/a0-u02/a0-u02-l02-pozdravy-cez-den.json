      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Ранок, день, вечір",
          "text": "Зранку (приблизно до 9–10 години) кажуть «Dobré ráno». Удень — «Dobrý deň». Увечері (приблизно після 18:00) — «Dobrý večer». Зверни увагу на закінчення: dobré ráno, dobrý deň, dobrý večer — прикметник змінюється за родом.",
          "examples": [
            {
              "sk": "Dobré ráno!",
              "uk": "Доброго ранку!"
            },
            {
              "sk": "Dobrý večer!",
              "uk": "Добрий вечір!"
            }
          ],
          "shortRule": "ráno — dobré, deň/večer — dobrý.",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Побажання, а не привітання",
          "text": "«Dobrú noc» — на добраніч (коли йдуть спати, не для зустрічі!). «Dobrú chuť» — смачного. «Pekný deň» — гарного дня. У цих побажаннях знахідний відмінок: dobrú, pekný.",
          "examples": [
            {
              "sk": "Dobrú noc!",
              "uk": "На добраніч!"
            },
            {
              "sk": "Dobrú chuť!",
              "uk": "Смачного!"
            },
            {
              "sk": "Pekný deň!",
              "uk": "Гарного дня!"
            }
          ],
          "shortRule": "Dobrú noc — лише прощання перед сном.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Як відповідати",
          "text": "На «Dobrú chuť» відповідають «Ďakujem, aj vám / aj tebe» (дякую, і вам). На «Pekný deň» — «Aj vám» або «Ďakujem, podobne» (дякую, навзаєм).",
          "examples": [
            {
              "sk": "Dobrú chuť! — Ďakujem, aj vám.",
              "uk": "Смачного! — Дякую, і вам."
            },
            {
              "sk": "Pekný deň! — Podobne.",
              "uk": "Гарного дня! — Навзаєм."
            }
          ],
          "shortRule": "Aj vám / aj tebe / podobne = і вам, навзаєм.",
          "button": "Далі →"
        }
      ],
