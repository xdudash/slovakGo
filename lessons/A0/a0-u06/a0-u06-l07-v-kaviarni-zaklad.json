          "order": 1,
          "title": "Замовлення",
          "text": "Офіціант: «Čo si dáte?» (що будете?). Ти: «Dám si kávu» або «Prosím si čaj». Ввічливіше: «Chcel(a) by som…».",
          "examples": [
            {
              "sk": "Dám si cappuccino.",
              "uk": "Я візьму капучино."
            },
            {
              "sk": "Prosím si koláč.",
              "uk": "Мені пиріжне, будь ласка."
            }
          ],
          "shortRule": "Dám si… / Prosím si…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Напої",
          "text": "minerálka — мінеральна вода: «perlivá» (з газом) чи «neperlivá» (без газу). džús — сік, čaj — чай, káva — кава (espresso, cappuccino, latte).",
          "examples": [
            {
              "sk": "Minerálku neperlivú, prosím.",
              "uk": "Мінералку без газу, будь ласка."
            },
            {
              "sk": "Pomarančový džús.",
              "uk": "Апельсиновий сік."
            }
          ],
          "shortRule": "perlivá — з газом",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Рахунок",
          "text": "«Účet, prosím» або «Zaplatím, prosím» — рахунок, будь ласка. «Spolu alebo zvlášť?» — разом чи окремо? Чайові зазвичай 5–10 %.",
          "examples": [
            {
              "sk": "Platíme spolu.",
              "uk": "Платимо разом."
            },
            {
              "sk": "Zvlášť, prosím.",
              "uk": "Окремо, будь ласка."
            }
          ],
          "shortRule": "spolu / zvlášť",
          "button": "Далі →"
        }
