      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Môcť — могти (мати змогу, дозвіл)",
          "text": "môžem, môžeš, môže, môžeme, môžete, môžu. «Môžem tu sedieť?» — можна тут сісти? «Nemôžem prísť» — не можу прийти.",
          "examples": [
            {
              "sk": "Môžem platiť kartou?",
              "uk": "Можна оплатити карткою?"
            },
            {
              "sk": "Môžete mi pomôcť?",
              "uk": "Можете мені допомогти?"
            }
          ],
          "shortRule": "Môžem…? = Можна…?",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Vedieť — знати, вміти",
          "text": "viem, vieš, vie, vieme, viete, vedia. «Viem, kde je pošta» — я знаю, де пошта. «Viem plávať» — я вмію плавати. Не плутай: môžem (мені дозволено / є можливість), viem (умію).",
          "examples": [
            {
              "sk": "Neviem po slovensky dobre.",
              "uk": "Я не дуже добре знаю словацьку."
            },
            {
              "sk": "Vieš šoférovať?",
              "uk": "Ти вмієш водити?"
            }
          ],
          "shortRule": "viem = знаю / вмію",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Rozumieť, robiť, ísť, vidieť",
          "text": "rozumiem (розумію), robím (роблю), idem (іду), vidím (бачу). «Čo robíš?» — що робиш? «Kam ideš?» — куди йдеш?",
          "examples": [
            {
              "sk": "Rozumiete? — Áno, rozumiem.",
              "uk": "Розумієте? — Так, розумію."
            },
            {
              "sk": "Vidíš ten autobus?",
              "uk": "Бачиш той автобус?"
            }
          ],
          "shortRule": "idem — іду (зараз)",
          "button": "Далі →"
        }
      ],
