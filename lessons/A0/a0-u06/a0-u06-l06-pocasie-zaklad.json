      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Яка погода?",
          "text": "«Aké je dnes počasie?» — яка сьогодні погода? «Prší» — іде дощ, «sneží» — іде сніг, «svieti slnko» — світить сонце, «je zamračené» — хмарно, «fúka vietor» — дме вітер.",
          "examples": [
            {
              "sk": "Dnes prší.",
              "uk": "Сьогодні йде дощ."
            },
            {
              "sk": "Svieti slnko.",
              "uk": "Світить сонце."
            }
          ],
          "shortRule": "prší, sneží — одне дієслово",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Холодно чи жарко",
          "text": "«Je zima» — холодно (так, zima — і зима, і холод!), «je chladno» — прохолодно, «je teplo» — тепло, «je horúco» — спекотно. Про себе: «Je mi zima» — мені холодно.",
          "examples": [
            {
              "sk": "Vonku je zima.",
              "uk": "Надворі холодно."
            },
            {
              "sk": "Je mi horúco.",
              "uk": "Мені спекотно."
            }
          ],
          "shortRule": "je zima = холодно",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Температура",
          "text": "«Koľko je stupňov?» — скільки градусів? «Je dvadsať stupňov» — двадцять градусів. «Mínus päť» — мінус п’ять.",
          "examples": [
            {
              "sk": "Zajtra bude tridsať stupňov.",
              "uk": "Завтра буде тридцять градусів."
            },
            {
              "sk": "V noci mínus dva.",
              "uk": "Уночі мінус два."
            }
          ],
          "shortRule": "stupeň = градус",
          "button": "Далі →"
        }
      ],
