            },
            {
              "sk": "Niečo na bolesť zubov.",
              "uk": "Щось від зубного болю."
            }
          ],
          "shortRule": "niečo na… = щось від…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Рецепт",
          "text": "«Recept» — рецепт лікаря. «Na predpis» — за рецептом, «bez predpisu» — без рецепта. Антибіотики продають лише за рецептом.",
          "examples": [
            {
              "sk": "Tento liek je len na predpis.",
              "uk": "Ці ліки лише за рецептом."
            },
            {
              "sk": "Mám recept od lekára.",
              "uk": "У мене є рецепт від лікаря."
            }
          ],
          "shortRule": "recept = рецепт лікаря",
          "button": "Далі →"
        },
