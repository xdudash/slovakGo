            },
            {
              "sk": "dvanásť",
              "uk": "дванадцять"
            },
            {
              "sk": "pätnásť",
              "uk": "п’ятнадцять"
            }
          ],
          "shortRule": "-násť = -надцять",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Особливі форми",
          "text": "Зверни увагу: štrnásť (14) — без «y» з štyri; pätnásť (15), devätnásť (19) — з ä. 20 — dvadsať.",
          "examples": [
            {
              "sk": "štrnásť",
              "uk": "чотирнадцять"
            },
            {
              "sk": "devätnásť",
