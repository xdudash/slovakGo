            {
              "sk": "Choďte rovno.",
              "uk": "Ідіть прямо."
            },
            {
              "sk": "Potom odbočte doprava.",
              "uk": "Потім поверніть праворуч."
            }
          ],
          "shortRule": "vľavo / vpravo — де; doľava / doprava — куди",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Біля чого?",
          "text": "«Oproti» — навпроти, «vedľa» — поруч, «za» — за, «pred» — перед. «Oproti banke» — навпроти банку, «vedľa pošty» — поруч із поштою.",
          "examples": [
            {
              "sk": "Lekáreň je oproti banke.",
              "uk": "Аптека навпроти банку."
            },
            {
              "sk": "Obchod je vedľa pošty.",
              "uk": "Магазин поруч із поштою."
            }
