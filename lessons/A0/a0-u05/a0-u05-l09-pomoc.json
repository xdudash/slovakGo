            },
            {
              "sk": "Zavolajte záchranku!",
              "uk": "Викличте швидку!"
            }
          ],
          "shortRule": "Zavolajte… = Викличте…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Номери",
          "text": "112 — єдиний екстрений номер (оператори часто говорять англійською). 155 — záchranka (швидка), 158 — polícia, 150 — hasiči (пожежники). Дзвінок безкоштовний.",
          "examples": [
            {
              "sk": "Volám 112.",
              "uk": "Я телефоную на 112."
            },
            {
              "sk": "Hasiči, horí!",
              "uk": "Пожежники, горить!"
            }
          ],
          "shortRule": "112 — завжди працює",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Що сказати оператору",
          "text": "Головне: що сталося, де (adresa), хто ти. «Stala sa nehoda» — сталася аварія. «Je zranený» — він поранений. «Adresa je…» — адреса…",
          "examples": [
            {
              "sk": "Stala sa nehoda na Hlavnej ulici.",
              "uk": "Сталася аварія на вулиці Головній."
            },
            {
              "sk": "Nedýcha.",
              "uk": "Він не дихає."
            }
          ],
          "shortRule": "Що? Де? Хто?",
          "button": "Далі →"
        }
