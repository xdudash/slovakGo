      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Kde je…?",
          "text": "Найпростіше питання: «Prepáčte, kde je lekáreň?» Множина: «Kde sú toalety?» (де туалети?). Почни з «Prepáčte» — так ввічливо.",
          "examples": [
            {
              "sk": "Prepáčte, kde je pošta?",
              "uk": "Вибачте, де пошта?"
            },
            {
              "sk": "Kde sú obchody?",
              "uk": "Де магазини?"
            }
          ],
          "shortRule": "Kde je + однина / Kde sú + множина",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Tu і tam",
          "text": "«Tu» — тут, «tam» — там (часто з жестом). «Hneď tu» — одразу тут. «Tamto» — он те.",
          "examples": [
            {
              "sk": "Pošta je tu.",
              "uk": "Пошта тут."
            },
            {
              "sk": "Banka je tam.",
              "uk": "Банк там."
            }
          ],
          "shortRule": "tu — тут, tam — там",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Blízko і ďaleko",
          "text": "«Je to blízko?» — це близько? «Nie je to ďaleko» — це недалеко. «Päť minút pešo» — п’ять хвилин пішки. «Za rohom» — за рогом.",
          "examples": [
            {
              "sk": "Je to ďaleko?",
              "uk": "Це далеко?"
            },
            {
              "sk": "Je to za rohom.",
              "uk": "Це за рогом."
            },
            {
              "sk": "Desať minút pešo.",
              "uk": "Десять хвилин пішки."
            }
          ],
          "shortRule": "blízko ≠ ďaleko",
          "button": "Далі →"
        }
      ],
