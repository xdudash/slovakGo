      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Mať — мати",
          "text": "ja mám, ty máš, on/ona má, my máme, vy máte, oni majú. «Máte doklad?» — у вас є документ? Відповідь: «Áno, mám» / «Nie, nemám».",
          "examples": [
            {
              "sk": "Mám otázku.",
              "uk": "У мене є питання."
            },
            {
              "sk": "Máte čas?",
              "uk": "У вас є час?"
            }
          ],
          "shortRule": "mám, máš, má, máme, máte, majú",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Заперечення",
          "text": "Заперечення пишеться разом: nemám, nemáš, nemá… «Nemám čas» — не маю часу. «Nemám doklad pri sebe» — не маю документа при собі.",
          "examples": [
            {
              "sk": "Nemám drobné.",
              "uk": "У мене немає дрібних."
            },
            {
              "sk": "Nemáme auto.",
              "uk": "У нас немає машини."
            }
          ],
          "shortRule": "ne- + дієслово разом",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Речі при собі",
          "text": "doklad (документ), mobil (мобільний), taška (сумка), dáždnik (парасолька). «Mám pri sebe» — маю при собі. «Zabudol som doma…» — я забув удома.",
          "examples": [
            {
              "sk": "Mám pri sebe pas.",
              "uk": "У мене при собі паспорт."
            },
            {
              "sk": "Nemám dáždnik.",
              "uk": "У мене немає парасольки."
            }
          ],
          "shortRule": "pri sebe = при собі",
          "button": "Далі →"
        }
      ],
