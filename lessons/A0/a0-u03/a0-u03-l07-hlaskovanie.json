      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Назви літер",
          "text": "Голосні звучать як є: A, E, I, O, U. Приголосні мають «е»: B = bé, C = cé, D = dé, P = pé, T = té, V = vé. Інші: F = ef, L = el, M = em, N = en, R = er, S = es.",
          "examples": [
            {
              "sk": "B",
              "uk": "bé"
            },
            {
              "sk": "M",
              "uk": "em"
            },
            {
              "sk": "R",
              "uk": "er"
            }
          ],
          "shortRule": "bé, cé, dé… / ef, el, em…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Складні літери",
          "text": "H = há, CH = chá, J = jé, K = ká, G = gé, Y = ypsilon, Z = zet, W = dvojité vé, X = iks, Q = kvé. Для українських імен важливі J (jé) і Y (ypsilon).",
          "examples": [
            {
              "sk": "J",
              "uk": "jé"
            },
            {
              "sk": "Y",
              "uk": "ypsilon"
            },
            {
              "sk": "W",
              "uk": "dvojité vé"
            }
          ],
          "shortRule": "J = jé, Y = ypsilon",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Знаки при диктуванні",
          "text": "Знаки називають так: Č = cé s mäkčeňom, Á = á s dĺžňom (dlhé á). «Ako sa to píše?» — як це пишеться? «Hláskujte, prosím» — продиктуйте по літерах, будь ласка.",
          "examples": [
            {
              "sk": "Š",
              "uk": "es s mäkčeňom"
            },
            {
              "sk": "Á",
              "uk": "dlhé á"
            },
            {
              "sk": "Ako sa píše vaše priezvisko?",
              "uk": "Як пишеться ваше прізвище?"
            }
          ],
          "shortRule": "s mäkčeňom = з гачком; dlhé = довге",
          "button": "Далі →"
        }
      ],
