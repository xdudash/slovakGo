      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Odkiaľ?",
          "text": "«Odkiaľ si?» (звідки ти?) / «Odkiaľ ste?» (звідки ви?). Відповідь: «Som z…» + країна або місто. Після z назва змінюється (родовий відмінок): Ukrajina → z Ukrajiny.",
          "examples": [
            {
              "sk": "Odkiaľ ste?",
              "uk": "Звідки ви?"
            },
            {
              "sk": "Som z Ukrajiny.",
              "uk": "Я з України."
            }
          ],
          "shortRule": "Odkiaľ…? — Som z…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Країни після z",
          "text": "Ukrajina → z Ukrajiny, Slovensko → zo Slovenska, Poľsko → z Poľska, Česko → z Česka, Nemecko → z Nemecka. Перед s, z, ž, š пишуть «zo».",
          "examples": [
            {
              "sk": "Som zo Slovenska.",
              "uk": "Я зі Словаччини."
            },
            {
              "sk": "Je z Poľska.",
              "uk": "Він з Польщі."
            }
          ],
          "shortRule": "-a → -y; -o → -a; zo перед s, z.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Міста",
          "text": "Kyjev → z Kyjeva, Ľvov → zo Ľvova, Charkov → z Charkova, Odesa → z Odesy, Dnipro → z Dnipra. Bratislava → z Bratislavy, Košice → z Košíc.",
          "examples": [
            {
              "sk": "Som z Charkova.",
              "uk": "Я з Харкова."
            },
            {
              "sk": "Bývam v Bratislave, ale som z Odesy.",
              "uk": "Я живу в Братиславі, але я з Одеси."
            }
          ],
          "shortRule": "Міста теж змінюються після z.",
          "button": "Далі →"
        }
      ],
