      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Bývať — жити (де саме)",
          "text": "«Bývam v Košiciach» — я живу в Кошицях. «Kde bývate?» — де ви живете? «Bývať» — про конкретне місце: місто, квартиру, вулицю.",
          "examples": [
            {
              "sk": "Bývam v Nitre.",
              "uk": "Я живу в Нітрі."
            },
            {
              "sk": "Kde bývaš?",
              "uk": "Де ти живеш?"
            }
          ],
          "shortRule": "Kde bývaš? — Bývam v…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "V чи na?",
          "text": "Більшість міст і країн — «v»: v Bratislave, v Žiline, v Poľsku. Але «na Slovensku», «na Ukrajine» (так говорять словаки), «na ulici», «na sídlisku» (у спальному районі).",
          "examples": [
            {
              "sk": "Bývam na Slovensku.",
              "uk": "Я живу в Словаччині."
            },
            {
              "sk": "Bývam na Hlavnej ulici.",
              "uk": "Я живу на Головній вулиці."
            }
          ],
          "shortRule": "na Slovensku, na ulici; v + місто.",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Žiť — жити (взагалі)",
          "text": "«Žiť» — жити як існувати, проводити життя: «Žijem na Slovensku dva roky» (живу в Словаччині два роки). Для адреси краще «bývať».",
          "examples": [
            {
              "sk": "Žijem tu rok.",
              "uk": "Я живу тут рік."
            },
            {
              "sk": "Bývam na Mierovej ulici 5.",
              "uk": "Я живу на вулиці Мірова, 5."
            }
          ],
          "shortRule": "adresa → bývať",
          "button": "Далі →"
        }
      ],
