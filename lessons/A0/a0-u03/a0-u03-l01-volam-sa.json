      "theoryScreens": [
        {
          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Volám sa…",
          "text": "Найприродніше представитися: «Volám sa Olena» (мене звати Олена) або просто «Som Olena» (я Олена). Формально: «Moje meno je Olena Kovalenko».",
          "examples": [
            {
              "sk": "Volám sa Taras.",
              "uk": "Мене звати Тарас."
            },
            {
              "sk": "Som Iryna.",
              "uk": "Я Ірина."
            },
            {
              "sk": "Moje meno je Petro Bondar.",
              "uk": "Моє ім’я — Петро Бондар."
            }
          ],
          "shortRule": "Volám sa… / Som…",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Як запитати ім’я",
          "text": "На «ти»: «Ako sa voláš?» На «ви»: «Ako sa voláte?» У офіційних ситуаціях: «Vaše meno, prosím?» (Ваше ім’я, будь ласка?).",
          "examples": [
            {
              "sk": "Ako sa voláš?",
              "uk": "Як тебе звати?"
            },
            {
              "sk": "Ako sa voláte?",
              "uk": "Як вас звати?"
            },
            {
              "sk": "Vaše meno, prosím?",
              "uk": "Ваше ім’я, будь ласка?"
            }
          ],
          "shortRule": "voláš (ти) — voláte (ви)",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Ім’я та прізвище",
          "text": "«Meno» — ім’я (іноді повне ім’я), «krstné meno» — власне ім’я, «priezvisko» — прізвище. Словацькі жіночі прізвища мають -ová: Novák → Nováková. Українські прізвища зазвичай не змінюють.",
          "examples": [
            {
              "sk": "krstné meno: Olena",
              "uk": "ім’я: Олена"
            },
            {
              "sk": "priezvisko: Kovalenko",
              "uk": "прізвище: Коваленко"
            },
            {
              "sk": "pán Novák – pani Nováková",
              "uk": "пан Новак – пані Новакова"
            }
          ],
          "shortRule": "priezvisko = прізвище (не плутай із «прізвиськом»!)",
          "button": "Далі →"
        }
      ],
