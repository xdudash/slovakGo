          "title": "Національність",
          "text": "Чоловік — Ukrajinec, жінка — Ukrajinka. Slovák — Slovenka, Poliak — Poľka, Čech — Češka. Національності пишуться з великої літери.",
          "examples": [
            {
              "sk": "Som Ukrajinec.",
              "uk": "Я українець."
            },
            {
              "sk": "Som Ukrajinka.",
              "uk": "Я українка."
            },
            {
              "sk": "Moja priateľka je Slovenka.",
              "uk": "Моя подруга — словачка."
            }
          ],
          "shortRule": "Ukrajinec / Ukrajinka",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Мови",
          "text": "«Hovorím po slovensky / po ukrajinsky / po anglicky / po rusky / po nemecky» — я говорю словацькою / українською... Назва мови — з малої літери: slovenčina, ukrajinčina, angličtina.",
          "examples": [
            {
              "sk": "Hovorím po ukrajinsky a po anglicky.",
              "uk": "Я говорю українською та англійською."
            },
            {
              "sk": "Učím sa slovenčinu.",
              "uk": "Я вчу словацьку."
            }
          ],
          "shortRule": "po + -sky/-cky = «якою мовою»",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Наскільки добре",
          "text": "trochu (трохи), dobre (добре), plynule (вільно), len trochu (лише трохи). «Ešte nehovorím dobre po slovensky» — я ще не говорю добре словацькою.",
          "examples": [
            {
              "sk": "Hovorím trochu po slovensky.",
              "uk": "Я трохи говорю словацькою."
            },
            {
              "sk": "Hovorí plynule po anglicky.",
              "uk": "Він вільно говорить англійською."
            }
          ],
          "shortRule": "trochu → dobre → plynule",
          "button": "Далі →"
        }
