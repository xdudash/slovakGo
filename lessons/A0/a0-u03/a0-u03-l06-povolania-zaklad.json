          "id": "theory-1",
          "screenType": "theory",
          "order": 1,
          "title": "Čo robíš?",
          "text": "Про роботу питають: «Čo robíš?» / «Čo robíte?» (що робиш? = ким працюєш?) або «Kde pracuješ?» (де працюєш?). Відповідь: «Som…» + професія.",
          "examples": [
            {
              "sk": "Čo robíte? — Som vodič.",
              "uk": "Ким працюєте? — Я водій."
            },
            {
              "sk": "Kde pracuješ? — V hoteli.",
              "uk": "Де працюєш? — У готелі."
            }
          ],
          "shortRule": "Čo robíš? = ким працюєш",
          "button": "Далі →"
        },
        {
          "id": "theory-2",
          "screenType": "theory",
          "order": 2,
          "title": "Жінка і чоловік",
          "text": "Більшість професій мають жіночу форму: kuchár — kuchárka, predavač — predavačka, učiteľ — učiteľka, lekár — lekárka, upratovač — upratovačka.",
          "examples": [
            {
              "sk": "Som predavačka.",
              "uk": "Я продавчиня."
            },
            {
              "sk": "Môj manžel je kuchár.",
              "uk": "Мій чоловік — кухар."
            }
          ],
          "shortRule": "-ár → -árka, -teľ → -teľka",
          "button": "Далі →"
        },
        {
          "id": "theory-3",
          "screenType": "theory",
          "order": 3,
          "title": "Pracujem v… / na…",
          "text": "«Pracujem v obchode» (у магазині), «v nemocnici» (у лікарні), «v sklade» (на складі), «na stavbe» (на будові), «v kancelárii» (в офісі).",
          "examples": [
            {
              "sk": "Pracujem v sklade.",
              "uk": "Я працюю на складі."
            },
            {
              "sk": "Pracujem na stavbe.",
              "uk": "Я працюю на будові."
            }
          ],
          "shortRule": "Pracujem v / na + місце",
          "button": "Далі →"
        }
